{
  "name": "ListModuleVersion",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/modules/[moduleId]/versions",
  "parameters": [
    {
      "name": "keyword",
      "description": "搜索关键词，支持对版本名称的模糊搜索",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "moduleId",
      "description": "模板ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageNumber",
      "description": "页码，默认1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页返回的结果数量。默认值：20，最小值：1，最大值：100。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun iacservice list-module-version --module-id mod-433aead756057fff39b2f7ac8b798 --keyword key --page-size 20 --page-number 1 --api-version 2021-08-06 --region cn-hangzhou",
    "legacyCli": "aliyun iacservice GET /modules/mod-433aead756057fff39b2f7ac8b798/versions --region cn-hangzhou --pageNumber 1 --pageSize 20 --keyword key --header \"Content-Type=application/json\""
  }
}
