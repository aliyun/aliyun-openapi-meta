{
  "name": "ListModules",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/modules",
  "parameters": [
    {
      "name": "groupId",
      "description": "分组ID",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "keyword",
      "description": "搜索关键词，支持对模板名称的模糊搜索。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "moduleName",
      "description": "",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码，默认1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页返回的结果数量。默认值：20，最小值：1，最大值：100。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "projectId",
      "description": "项目ID",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "tag",
      "description": "模板标签列表。",
      "position": "Query",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "tagKey",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "tagValue",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ],
  "example": {
    "unifiedCli": "aliyun iacservice list-modules --keyword key --page-size 20 --page-number 1 --project-id p-al1c58tb2lu9oej36kclvf --group-id g-kw1a50tj8rk7cki2q8bbat --tag tagValue=TestValue tagKey=TestKey --module-name example-string --api-version 2021-08-06 --region cn-hangzhou",
    "legacyCli": "aliyun iacservice GET /modules --region cn-hangzhou --pageNumber 1 --groupId 'g-kw1a50tj8rk7cki2q8bbat' --moduleName 'example-string' --pageSize 20 --tag '[{\"tagValue\":\"TestValue\",\"tagKey\":\"TestKey\"}]' --keyword key --projectId 'p-al1c58tb2lu9oej36kclvf' --header \"Content-Type=application/json\""
  }
}
