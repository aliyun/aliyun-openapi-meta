{
  "name": "ListInstanceAcl",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/instances/[instanceId]/acl",
  "parameters": [
    {
      "name": "filter",
      "description": "查询的过滤条件，若不输入则查询所有权限。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "instanceId",
      "description": "实例ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageNumber",
      "description": "当前页码，从1开始。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "分页大小，每页最多显示的返回结果数量。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun rocketmq list-instance-acl --instance-id rmq-cn-7e22ody0000 --page-number 1 --page-size 10 --filter CID-TEST --region cn-hangzhou",
    "legacyCli": "aliyun rocketmq GET /instances/rmq-cn-7e22ody0000/acl --region cn-hangzhou --filter 'CID-TEST' --pageNumber 1 --pageSize 10 --header \"Content-Type=application/json\""
  }
}
