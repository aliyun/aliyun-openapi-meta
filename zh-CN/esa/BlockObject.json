      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun esa block-object --site-id 1234560000 --type block --content http://a.com/1.jpg --maxage 864000 --region cn-hangzhou",
    "legacyCli": "aliyun esa BlockObject --region cn-hangzhou --SiteId 1234560000 --Type block --Content '[\"http://a.com/1.jpg\"]' --Maxage 864000"
