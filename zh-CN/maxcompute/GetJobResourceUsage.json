{
  "name": "GetJobResourceUsage",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/jobs/resourceUsage",
  "parameters": [
    {
      "name": "date",
      "description": "查询的日期，以天为级别，时间参数填写必须为yyyy-MM-dd",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "jobOwnerList",
      "description": "作业的执行者列表",
      "position": "Query",
      "type": "RepeatList",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页返回数目，默认为10，最大为100",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "quotaNicknameList",
      "description": "作业使用的配额昵称列表",
      "position": "Query",
      "type": "RepeatList",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun maxcompute get-job-resource-usage --date 2023-05-15 --job-owner-list ALIYUN_xxx@test.aliyunid.com --quota-nickname-list my_quota --page-number 1 --page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun maxcompute GET /api/v1/jobs/resourceUsage --region cn-hangzhou --date '2023-05-15' --pageNumber 1 --jobOwnerList 'ALIYUN_xxx@test.aliyunid.com' --quotaNicknameList my_quota --pageSize 10 --header \"Content-Type=application/json\""
  }
}
