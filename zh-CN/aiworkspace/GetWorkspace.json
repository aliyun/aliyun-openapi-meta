{
  "name": "GetWorkspace",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/workspaces/[WorkspaceId]",
  "parameters": [
    {
      "name": "Verbose",
      "description": "是否显示工作空间Owner等补充信息。取值如下：\n- false（默认值）：不显示补充信息。\n- true：显示补充信息。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "WorkspaceId",
      "description": "工作空间ID。如何获取工作空间ID，请参见 [ListWorkspaces](~~449124~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace get-workspace --workspace-id 12345 --verbose true --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace GET /api/v1/workspaces/12345 --region cn-hangzhou --Verbose true --header \"Content-Type=application/json\""
  }
}
