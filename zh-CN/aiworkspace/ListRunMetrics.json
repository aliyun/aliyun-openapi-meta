    },
    {
      "name": "RunId",
      "description": "运行ID",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace list-run-metrics --run-id run-1qJhzJ2YXgX0000 --key loss --page-token 0 --max-results 100 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace GET /api/v1/runs/run-1qJhzJ2YXgX0000/metrics --region cn-hangzhou --MaxResults 100 --PageToken 0 --Key loss --header \"Content-Type=application/json\""
