{
  "name": "RollbackApplication",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "FromAppVersion",
      "description": "待回滚的版本号",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Timeout",
      "description": "回滚的异步操作超时时间。单位：秒。默认值：300。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "ToAppVersion",
      "description": "目标版本号。默认自动回滚到上一版本。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun ens rollback-application --app-id 474bdef0-d149-4695-abfb-52912d910000 --from-app-version v2-1 --to-app-version v2 --timeout 1800 --region cn-hangzhou",
    "legacyCli": "aliyun ens RollbackApplication --region cn-hangzhou --AppId '474bdef0-d149-4695-abfb-52912d910000' --Timeout 1800 --ToAppVersion v2 --FromAppVersion 'v2-1'"
  }
}
