{
  "name": "AddBackendServers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "BackendServers",
      "description": "添加的后端服务器列表，每次调用最多可添加20个后端服务器。\n\n> 后端服务器（ENS实例）必须是运行中才可以加入负载均衡实例。",
      "position": "Query",
      "type": "Json",
      "required": true,
      "sub_parameters": [
        {
          "name": "Ip",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Port",
          "position": "Query",
          "type": "Integer",
          "required": false
        },
        {
          "name": "ServerId",
          "position": "Query",
          "type": "String",
          "required": true
        },
        {
          "name": "Type",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Weight",
          "position": "Query",
          "type": "Integer",
          "required": false
        }
      ]
    },
    {
      "name": "LoadBalancerId",
      "description": "负载均衡实例前端使用的端口。取值：**1**~**65535**。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun ens add-backend-servers --load-balancer-id lb-5qzdmxefgrpxd7oz2mefonvtx --backend-servers Type=ens ServerId=i-5uf6dwyzch3wly7900000 Ip=192.168.XXX Port=3309 Weight=100 --region cn-hangzhou",
    "legacyCli": "aliyun ens AddBackendServers --region cn-hangzhou --LoadBalancerId 'lb-5qzdmxefgrpxd7oz2mefonvtx' --BackendServers '[{\"Type\":\"ens\",\"ServerId\":\"i-5uf6dwyzch3wly7900000\",\"Ip\":\"192.168.XXX\",\"Port\":3309,\"Weight\":100}]'"
  }
}
