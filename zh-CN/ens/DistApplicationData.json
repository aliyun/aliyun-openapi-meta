{
  "name": "DistApplicationData",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID。获取AppId，请参见ListApplications。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Data",
      "description": "分发的数据文件列表，Json数组的字符串格式。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "DistStrategy",
      "description": "灰度分发策略，Json格式的字符串，支持多种分发策略，默认全量分发。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun ens dist-application-data --app-id e76f8985-7965-41fc-925b-9648bb6bf650 --data name_:_app01_,_version_:_1.0_,_destPath_:_/root/installed_,_decompress_:true,_targetDirName_:_target01_,_fileMode_:755,_timeout_:1000_,_name_:_app02_,_version_:_1.1_,_destPath_:_/tmp/test.txt_,_decompress_:false --dist-strategy name_:_ScheduleToAllByMatchExpressions_,_parameters_:_match_expressions_:_key_:_region_id_,_operator_:_In_,_values_:_cn-wuhan-telecom_unicom_cmcc-2 --region cn-hangzhou",
    "legacyCli": "aliyun ens DistApplicationData --region cn-hangzhou --AppId 'e76f8985-7965-41fc-925b-9648bb6bf650' --Data 'name_:_app01_,_version_:_1.0_,_destPath_:_/root/installed_,_decompress_:true,_targetDirName_:_target01_,_fileMode_:755,_timeout_:1000_,_name_:_app02_,_version_:_1.1_,_destPath_:_/tmp/test.txt_,_decompress_:false' --DistStrategy 'name_:_ScheduleToAllByMatchExpressions_,_parameters_:_match_expressions_:_key_:_region_id_,_operator_:_In_,_values_:_cn-wuhan-telecom_unicom_cmcc-2'"
  }
}
