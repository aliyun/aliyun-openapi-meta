    "legacyCli": "aliyun elasticsearch POST /openapi/instances/es-cn-nif1q9o8r00080000/validate-transfer-nodes --region cn-hangzhou --nodeType WORKER --header \"Content-Type=application/json\" --body [{\"port\":9200,\"host\":\"172.16.xx.xx\",\"zoneId\":\"cn-shanghai-c\"}]"
