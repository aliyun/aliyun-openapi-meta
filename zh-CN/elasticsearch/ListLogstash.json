    "legacyCli": "aliyun elasticsearch GET /openapi/logstashes --region cn-hangzhou --instanceId 'ls-cn-n6w1o5jq0000' --size 10 --description 'ls-cn-abc' --resourceGroupId 'rg-acfm2h5vbzd0000' --page 1 --version '5.5.3_with_X-Pack' --tags 'tagKey_:_key1_,_tagValue_:_value1' --header \"Content-Type=application/json\""
