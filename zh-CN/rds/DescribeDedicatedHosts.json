{
  "name": "DescribeDedicatedHosts",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AllocationStatus",
      "description": "主机当前是否允许分配实例。取值：\n* **0**：不允许分配。\n* **1**：允许分配。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "DedicatedHostGroupId",
      "description": "专属集群ID。可调用DescribeDedicatedHostGroups获取。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "DedicatedHostId",
      "description": "专属集群主机ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "HostStatus",
      "description": "主机状态。取值：\n * **0**：创建中\n * **1**：使用中\n * **2**：宕机\n * **3**：宕机下线（替换主机中）\n * **4**：下线\n * **5**：删除\n * **6**：重启中",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "HostType",
      "description": "主机存储类型。取值：\n* **dhg_cloud_ssd**：ESSD云盘。\n* **dhg_local_ssd**：SSD本地盘。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "OrderId",
      "description": "订单ID。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "RegionId",
      "description": "地域ID。可以通过接口DescribeRegions查看地域ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ZoneId",
      "description": "可用区ID。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun rds describe-dedicated-hosts --biz-region-id cn-hangzhou --dedicated-host-group-id dhg-7a9xxxxxxxx --order-id 102565235 --host-type dhg_cloud_ssd --host-status 1 --allocation-status 1 --zone-id cn-hangzhou-i --dedicated-host-id ch-t4nn100ddxxxxxxxx --region cn-hangzhou",
    "legacyCli": "aliyun rds DescribeDedicatedHosts --region cn-hangzhou --HostType dhg_cloud_ssd --DedicatedHostId 'ch-t4nn100ddxxxxxxxx' --AllocationStatus 1 --ZoneId 'cn-hangzhou-i' --DedicatedHostGroupId 'dhg-7a9xxxxxxxx' --HostStatus 1 --RegionId 'cn-hangzhou' --OrderId 102565235"
