{
  "name": "GetSession",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/sessions/[sessionId]",
  "parameters": [
    {
      "name": "functionName",
      "description": "会话所属函数名称",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "qualifier",
      "description": "查询的会话ID关联的函数别名或版本信息",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "sessionId",
      "description": "查询的会话ID值",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc get-session --function-name myFunction --session-id test-sessionid-index1 --qualifier aliasName1 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/myFunction/sessions/test-sessionid-index1 --region cn-hangzhou --qualifier aliasName1 --header \"Content-Type=application/json\""
  }
}
