{
  "name": "ListLayerVersions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/layers/[layerName]/versions",
  "parameters": [
    {
      "name": "layerName",
      "description": "层名称",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "limit",
      "description": "返回的版本数量",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "startVersion",
      "description": "起始版本",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc list-layer-versions --layer-name my-layer --start-version 1 --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/layers/my-layer/versions --region cn-hangzhou --startVersion 1 --limit 10 --header \"Content-Type=application/json\""
  }
}
