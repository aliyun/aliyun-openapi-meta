{
  "name": "ListAsyncInvokeConfigs",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/async-invoke-configs",
  "parameters": [
    {
      "name": "functionName",
      "description": "函数名称，若不指定则列出所有函数的异步调用配置",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "limit",
      "description": "返回的数量限制",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "description": "分页起始标记",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc list-async-invoke-configs --function-name my-func --next-token MTIzNCNhYmM= --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/async-invoke-configs --region cn-hangzhou --functionName 'my-func' --nextToken 'MTIzNCNhYmM=' --limit 10 --header \"Content-Type=application/json\""
  }
}
