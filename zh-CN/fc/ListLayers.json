{
  "name": "ListLayers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/layers",
  "parameters": [
    {
      "name": "limit",
      "description": "返回的层数量",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "description": "分页起始标记",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "official",
      "description": "是否官方层。true或者false。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "prefix",
      "description": "层名称前缀",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "public",
      "description": "是否公开层。true或者false。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc list-layers --prefix my-layer --next-token MTIzNCNhYmM= --limit 10 --public true --official true --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/layers --region cn-hangzhou --public true --prefix 'my-layer' --nextToken 'MTIzNCNhYmM=' --limit 10 --official true --header \"Content-Type=application/json\""
  }
}
