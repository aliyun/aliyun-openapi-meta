    "legacyCli": "aliyun mts SubmitImageCopyright --region cn-hangzhou --Message 'T-Head_Semiconductor' --Output 'Bucket_:_abc-test_,_Location_:_oss-cn-shanghai_,_Object_:_out.jpeg' --Params 'width_:2999,_height_:2999,_afa_:_3,_type_:1,_version_:0'"
