{
  "name": "GetContainerConfiguration",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/pop/v5/app/container_config",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "GroupId",
      "description": "分组ID。\n- 如果ID不为空，则获取应用分组的Tomcat配置。\n- 如果ID为“”，则获取应用的Tomcat配置。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas get-container-configuration --app-id 3616cdca-4f92-00000000000000 --group-id 8123db90-880f-00000000000000 --region cn-hangzhou",
    "legacyCli": "aliyun edas GET /pop/v5/app/container_config --region cn-hangzhou --AppId '3616cdca-4f92-00000000000000' --GroupId '8123db90-880f-00000000000000' --header \"Content-Type=application/json\""
  }
}
