{
  "name": "ScaleInApplication",
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/v5/changeorder/co_scale_in",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID，您可通过查询[ListApplication](~~149390~~)接口获取。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "EccInfo",
      "description": "应用下需要缩容的机器的eccid，多个用“,”分开，您可以通过调用[QueryApplicationStatus](~~149394~~)接口获取eccid。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ForceStatus",
      "description": "是否要强制下线，一般只有ECS过期了才会设为true，正常情况不用填写。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas scale-in-application --app-id 3616cdca-4f92-4400000000000000000000000 --ecc-info 7040f221-42df-48e8-90000000000000000000 --force-status false --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/changeorder/co_scale_in --region cn-hangzhou --EccInfo '7040f221-42df-48e8-90000000000000000000' --AppId '3616cdca-4f92-4400000000000000000000000' --ForceStatus false --header \"Content-Type=application/json\""
  }
}
