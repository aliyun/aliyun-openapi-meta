{
  "name": "SwitchAdvancedMonitoring",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "/pop/v5/monitor/advancedMonitorInfo",
  "parameters": [
    {
      "name": "AppId",
      "description": "需要查询或者修改应用高级监控功能的应用ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "EnableAdvancedMonitoring",
      "description": "应用高级监控的开关，可选参数如下：\n\n- true：打开。\n- false：关闭。\n\n在查询应用高级监控状态时，此参数不必填写。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas switch-advanced-monitoring --app-id 9e224bc6-a646-4484-0000-e617b7e70000 --enable-advanced-monitoring true --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/monitor/advancedMonitorInfo --region cn-hangzhou --AppId '9e224bc6-a646-4484-0000-e617b7e70000' --EnableAdvancedMonitoring true --header \"Content-Type=application/json\""
  }
}
