{
  "name": "BindSlb",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/app/bind_slb_json",
  "parameters": [
    {
      "name": "AppId",
      "description": "EDAS应用ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ListenerPort",
      "description": "监听端口。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "SlbId",
      "description": "SLB实例ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SlbIp",
      "description": "SLB IP地址。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Type",
      "description": "SLB网络类型，取值如下：\n* internet：外网实例。\n* intranet：内网实例。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "VServerGroupId",
      "description": "内网 SLB 虚拟服务器组 ID",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas bind-slb --app-id 3616cdca-000000000 --slb-id lb-wz96ph63r000000000000 --slb-ip 192.160.0.0 --type intranet --listener-port 80 --vserver-group-id rsp-cige6000000 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/app/bind_slb_json --region cn-hangzhou --SlbId 'lb-wz96ph63r000000000000' --ListenerPort 80 --VServerGroupId 'rsp-cige6000000' --Type intranet --AppId '3616cdca-000000000' --SlbIp '192.160.0.0' --header \"Content-Type=application/json\""
  }
}
