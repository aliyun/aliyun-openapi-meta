{
  "name": "InsertRole",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/v5/account/create_role",
  "parameters": [
    {
      "name": "ActionData",
      "description": "操作权限集合，格式：`权限组ID1:权限码1;...;权限组IDn:权限码n`，例如`1:1;1:2;2:1;2:2`。详细权限组及权限码含义请参见[ListAuthority](~~149409~~)。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "RoleName",
      "description": "角色名称",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas insert-role --role-name testrole --action-data 15:1_14:2 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/account/create_role --region cn-hangzhou --RoleName testrole --ActionData '15:1_14:2' --header \"Content-Type=application/json\""
  }
}
