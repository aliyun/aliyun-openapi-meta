{
  "name": "ScaleOutApplication",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/v5/changeorder/co_scale_out",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID。获取应用ID，请参见[ListApplication](~~149390~~)。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "DeployGroup",
      "description": "需要扩容的应用实例分组。获取应用实例分组，请参见[QueryApplicationStatus](~~149394~~)。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "EcuInfo",
      "description": "指定ECU进行扩容。获取ecuid，请参见[ListScaleOutEcu](~~149371~~)。多个ECU，用半角逗号（,）分开。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas scale-out-application --app-id 3616cdca-4f92-441300000000000000000 --ecu-info 8123db90-880f-486f-b000000000000000 --deploy-group 4f1fb6f5-6769-4bd6000000000000000000 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/changeorder/co_scale_out --region cn-hangzhou --AppId '3616cdca-4f92-441300000000000000000' --EcuInfo '8123db90-880f-486f-b000000000000000' --DeployGroup '4f1fb6f5-6769-4bd6000000000000000000' --header \"Content-Type=application/json\""
  }
}
