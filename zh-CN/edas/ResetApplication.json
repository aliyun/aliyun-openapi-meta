{
  "name": "ResetApplication",
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/pop/v5/changeorder/co_reset",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID，可通过[ListApplication](~~149390~~)获取。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "EccInfo",
      "description": "应用下需要重置机器的eccid，多个用半角逗号（,）分隔，可通过调用[QueryApplicationStatus](~~149394~~)接口获取eccid。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas reset-application --app-id 3616cdca-4f92000000000 --ecc-info 0cf49a6c-00000000000 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/changeorder/co_reset --region cn-hangzhou --EccInfo '0cf49a6c-00000000000' --AppId '3616cdca-4f92000000000' --header \"Content-Type=application/json\""
  }
}
