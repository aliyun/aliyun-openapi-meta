{
  "name": "ListClusterMembers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/pop/v5/resource/cluster_member_list",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群ID。可以调用ListCluster来获取，具体操作，请参见[ListCluster](~~154995~~)。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "CurrentPage",
      "description": "分页查询时，当前显示的页面数，不设置的情况下默认显示第1页。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "EcsList",
      "description": "ECS列表实例数。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "分页查询时，若不设置，则显示该集群的所有ECS列表；若设置，则按照设置的pagesize来分页显示ECS列表。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas list-cluster-members --cluster-id 52984524-6d48-4bbd-85f2-a34b0e5b0000 --current-page 1 --page-size 50 --ecs-list 1 --region cn-hangzhou",
    "legacyCli": "aliyun edas GET /pop/v5/resource/cluster_member_list --region cn-hangzhou --PageSize 50 --ClusterId '52984524-6d48-4bbd-85f2-a34b0e5b0000' --CurrentPage 1 --EcsList 1 --header \"Content-Type=application/json\""
  }
}
