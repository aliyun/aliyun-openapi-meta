{
  "name": "ScaleK8sApplication",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v5/k8s/acs/k8s_apps",
  "parameters": [
    {
      "name": "AppId",
      "description": "应用ID，可调用[ListApplication](~~149390~~)接口获取。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Replicas",
      "description": "需要扩容或保留的应用实例数量，最小为 0。",
      "position": "Query",
      "type": "Integer",
      "required": true
    },
    {
      "name": "Timeout",
      "description": "变更流程超时时间，单位：秒。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas scale-k8s-application --app-id 23bf94d9-0000-4994-0000-616a827aa777 --replicas 2 --timeout 60 --region cn-hangzhou",
    "legacyCli": "aliyun edas PUT /pop/v5/k8s/acs/k8s_apps --region cn-hangzhou --AppId '23bf94d9-0000-4994-0000-616a827aa777' --Timeout 60 --Replicas 2 --header \"Content-Type=application/json\""
  }
}
