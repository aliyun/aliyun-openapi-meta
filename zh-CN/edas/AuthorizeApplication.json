{
  "name": "AuthorizeApplication",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE|POST|PUT",
  "pathPattern": "/pop/v5/account/authorize_app",
  "parameters": [
    {
      "name": "AppIds",
      "description": "应用ID。用半角分号（;）分割，null表示取消授权。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "TargetUserId",
      "description": "待授权子账号或 RAM 用户的 USER ID，格式为子账号名称@主账号 UID。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas authorize-application --target-user-id test@1334344340000 --app-ids 5fdf50e8-00000_696-000000 --region cn-hangzhou",
    "legacyCli": "aliyun edas POST /pop/v5/account/authorize_app --region cn-hangzhou --AppIds '5fdf50e8-00000_696-000000' --TargetUserId 'test@1334344340000' --header \"Content-Type=application/json\""
  }
}
