{
  "name": "ContinuePipeline",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/pop/v5/changeorder/pipeline_batch_confirm",
  "parameters": [
    {
      "name": "Confirm",
      "description": "是否执行下一批发布。\n- true：执行下一批发布。\n- false：不执行下一批发布。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "PipelineId",
      "description": "流程ID。可通过GetChangeOrderInfo接口获取1次变更的相关批次的流程ID，请参见[GetChangeOrderInfo](~~62072~~)。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas continue-pipeline --pipeline-id 5648dbd7-df1300000000000000000000 --confirm true --region cn-hangzhou",
    "legacyCli": "aliyun edas GET /pop/v5/changeorder/pipeline_batch_confirm --region cn-hangzhou --PipelineId '5648dbd7-df1300000000000000000000' --Confirm true --header \"Content-Type=application/json\""
  }
}
