{
  "name": "StartService",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/start",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "服务所在地域ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "description": "服务名称。如何查看服务名称，请参见[ListServices ](~~412109~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas start-service --cluster-id cn-shanghai --service-name foo --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/foo/start --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
