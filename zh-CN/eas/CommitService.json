{
  "name": "CommitService",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/commit",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "服务所在地域ID。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ServiceName",
      "description": "服务名称。如何查看服务名称，请参见[ListServices ](~~412109~~)。",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas commit-service --cluster-id cn-beijing --service-name foo --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-beijing/foo/commit --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
