{
  "name": "ListServiceVersions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/versions",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "服务所在地域ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "PageNumber",
      "description": "请求的页码，默认为1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "分页查询时设置的每页显示的版本数量，默认为100。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "ServiceName",
      "description": "服务名称。如何获取服务名称，请参见[ListServices ](~~412109~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas list-service-versions --cluster-id cn-hangzhou --service-name test_oss --page-number 1 --page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun eas GET /api/v2/services/cn-hangzhou/test_oss/versions --region cn-hangzhou --PageSize 10 --PageNumber 1 --header \"Content-Type=application/json\""
  }
}
