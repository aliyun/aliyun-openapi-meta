{
  "name": "UpdateServiceCronScaler",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/cronscaler",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "服务所在地域ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "description": "服务名字。如何查看服务名称，请参见[ListServices ](~~412109~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "请求Body。",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas update-service-cron-scaler --cluster-id cn-shanghai --service-name foo --scale-jobs TargetSize=2 TimeZone=Asia/Shanghai Schedule=0_18_0_0_0_0 Name=scale-job-1 --exclude-dates 0_0_0_0_0_0,6 --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/foo/cronscaler --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"ExcludeDates\":[\"0_0_0_0_0_0,6\"],\"ScaleJobs\":[{\"TargetSize\":2,\"TimeZone\":\"Asia/Shanghai\",\"Schedule\":\"0_18_0_0_0_0\",\"Name\":\"scale-job-1\"}]}"
  }
}
