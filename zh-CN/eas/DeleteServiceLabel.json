{
  "name": "DeleteServiceLabel",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/label",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "服务所在区域。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "Keys",
      "description": "要删除的服务标签。（废弃，请使用 LabelKeys）",
      "position": "Query",
      "type": "RepeatList",
      "required": false
    },
    {
      "name": "LabelKeys",
      "description": "要删除的服务标签。",
      "position": "Query",
      "type": "Json",
      "required": false
    },
    {
      "name": "ServiceName",
      "description": "服务名称。如何查看服务名称，请参见[ListServices](~~412109~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas delete-service-label --cluster-id cn-shanghai --service-name foo --keys key1,key2 --label-keys key1 --region cn-hangzhou",
    "legacyCli": "aliyun eas DELETE /api/v2/services/cn-shanghai/foo/label --region cn-hangzhou --Keys 'key1,key2' --LabelKeys '[\"key1\"]' --header \"Content-Type=application/json\""
  }
}
