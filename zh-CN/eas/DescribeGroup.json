{
  "name": "DescribeGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/groups/[ClusterId]/[GroupName]",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "所属所在地域ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "GroupName",
      "description": "服务群组名称。如何获取群组名称，请参见[ListServices ](~~412109~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas describe-group --cluster-id cn-shanghai --group-name foo --region cn-hangzhou",
    "legacyCli": "aliyun eas GET /api/v2/groups/cn-shanghai/foo --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
