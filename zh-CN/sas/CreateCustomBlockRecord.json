{
  "name": "CreateCustomBlockRecord",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "BlockIp",
      "description": "指定需要进行阻断的单个IP地址，为服务器阻断该IP上面的流量访问。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Bound",
      "description": "自定义IP与服务器的流量禁用方向。\n取值：\n- **in**：入流量 \n- **out**：出流量",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ExpireTime",
      "description": "该策略的到期时间。",
      "position": "Query",
      "type": "Long",
      "required": true
    },
    {
      "name": "Uuids",
      "description": "资产实例的UUID列表。多个UUID之间使用半角逗号（,）分隔。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sas create-custom-block-record --uuids 71c846d6-5c84-4714-acfc-58265bc30000,5013b5e8-1613-43a8-b4de-651db3180000,df53f0ad-b3ba-4fe0-9ec7-f42a2ae20000 --block-ip 192.168.xx.xx --bound in --expire-time 1859094550000 --api-version 2018-12-03 --region cn-hangzhou",
    "legacyCli": "aliyun sas CreateCustomBlockRecord --region cn-hangzhou --BlockIp '192.168.xx.xx' --Bound in --Uuids '71c846d6-5c84-4714-acfc-58265bc30000,5013b5e8-1613-43a8-b4de-651db3180000,df53f0ad-b3ba-4fe0-9ec7-f42a2ae20000' --ExpireTime 1859094550000"
  }
}
