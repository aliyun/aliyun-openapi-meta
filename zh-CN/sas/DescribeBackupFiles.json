      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Path",
      "description": "备份策略文件的路径。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SnapshotHash",
      "description": "备份文件版本的HASH值。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Uuid",
      "description": "防勒索策略防护服务器的UUID。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sas describe-backup-files --uuid 6d5b361f-958d-48a8-a9d2-d6e82c1a0000 --path '“”' --snapshot-hash a7f26223ef3974c6fac324cd37713ab65ab618859d20b4039192a5da44d77b63 --current-page 1 --page-size 10 --api-version 2018-12-03 --region cn-hangzhou",
    "legacyCli": "aliyun sas DescribeBackupFiles --region cn-hangzhou --Path '“”' --Uuid '6d5b361f-958d-48a8-a9d2-d6e82c1a0000' --PageSize 10 --CurrentPage 1 --SnapshotHash a7f26223ef3974c6fac324cd37713ab65ab618859d20b4039192a5da44d77b63"
  }
}
