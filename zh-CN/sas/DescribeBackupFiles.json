{
  "name": "DescribeBackupFiles",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CurrentPage",
      "description": "设置从返回结果的第几页开始显示查询结果。默认值为**1**，表示从第1页开始显示。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "PageSize",
