{
  "name": "ModifySecurityCheckScheduleConfig",
  "deprecated": true,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DaysOfWeek",
      "description": "设置检测周期。支持设置多天，多天之间使用英文逗号隔开。取值：\n\n- **1**：周一\n- **2**：周二\n- **3**：周三\n- **4**：周四\n- **5**：周五\n- **6**：周六\n- **7**：周日",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "EndTime",
      "description": "设置检测结束时间。取值：\n\n- **0**：在00:00~6:00结束检测\n- **6**：在6:00~12:00结束检测\n- **12**：在12:00~18:00结束检测\n- **18**：在18:00~24:00结束检测",
      "position": "Query",
      "type": "Integer",
      "required": true
    },
    {
      "name": "Lang",
      "description": "设置请求和接收消息的语言类型，默认为**zh**。取值：\n\n- **zh**：中文\n- **en**：英文",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SourceIp",
      "description": "访问源IP地址。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StartTime",
      "description": "设置检测开始时间。取值：\n\n- **0**：在00:00~6:00开始检测\n- **6**：在6:00~12:00开始检测\n- **12**：在12:00~18:00开始检测\n- **18**：在18:00~24:00开始检测",
      "position": "Query",
      "type": "Integer",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sas modify-security-check-schedule-config --source-ip 192.168.XX.XX --lang zh --days-of-week 4,5,6 --start-time 6 --end-time 12 --api-version 2018-12-03 --region cn-hangzhou",
    "legacyCli": "aliyun sas ModifySecurityCheckScheduleConfig --region cn-hangzhou --DaysOfWeek '4,5,6' --SourceIp '192.168.XX.XX' --EndTime 12 --StartTime 6 --Lang zh"
  }
}
