{
  "name": "CreateFileDetect",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Decompress",
      "description": "是否识别压缩包并解压。取值：\n- **true**：是。\n- **false**：否。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "DecompressMaxFileCount",
      "description": "解压的最大文件数。最大取值为1000。\n\nDecompress设置为true时，此参数不可为空。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "DecompressMaxLayer",
      "description": "当压缩包内，存在多个层级的压缩包嵌套时，解压的最大解压层数。最大取值为5。\n\nDecompress设置为true时，此参数不可为空。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "DownloadUrl",
      "description": "文件下载链接。支持传入文件下载链接（公网URL）直接触发文件检测，不需要提前上传文件。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "HashKey",
      "description": "文件唯一标识。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "OssKey",
      "description": "文件在OSS Bucket中的存储key。如果通过DownloadUrl推送文件检测，此参数可不填。此参数通过[CreateFileDetectUploadUrl](~~CreateFileDetectUploadUrl~~)接口获取。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SourceIp",
      "description": "访问源的IP地址。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Type",
      "description": "需要检测的文件类型。取值：\n\n-  **0**：不确定的文件类型",
      "position": "Query",
      "type": "Integer",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sas create-file-detect --source-ip 115.213.XX.XX --type 0 --hash-key 0a212417e65c26ff133cfff28f6c0000 --oss-key 1/2022/06/23/15/41/16559701077444693a0c6-33b2-4cc2-a99f-9f38b8b80000 --download-url https://xxxxxxxx.oss-cn-hangzhou-1.aliyuncs.com/xxxxx/xxxxxxxxxxxxxx0Expires=1671448125_OSSAccessKeyId=xxx --decompress false --decompress-max-layer 1 --decompress-max-file-count 100 --api-version 2018-12-03 --region cn-hangzhou",
    "legacyCli": "aliyun sas CreateFileDetect --region cn-hangzhou --Type 0 --SourceIp '115.213.XX.XX' --OssKey '1/2022/06/23/15/41/16559701077444693a0c6-33b2-4cc2-a99f-9f38b8b80000' --DecompressMaxFileCount 100 --HashKey 0a212417e65c26ff133cfff28f6c0000 --Decompress false --DecompressMaxLayer 1 --DownloadUrl 'https://xxxxxxxx.oss-cn-hangzhou-1.aliyuncs.com/xxxxx/xxxxxxxxxxxxxx0Expires=1671448125_OSSAccessKeyId=xxx'"
  }
}
