{
  "name": "UpdateWebCustomDomain",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v2/api/web/custom-domains/[DomainName]",
  "parameters": [
    {
      "name": "DomainName",
      "description": "自定义域名名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "NamespaceId",
      "description": "命名空间ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "自定义域名信息。",
      "position": "Body",
      "type": "Json",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sae update-web-custom-domain --namespace-id cn-hangzhou --domain-name www.99zuowen.com --region cn-hangzhou",
    "legacyCli": "aliyun sae PUT /pop/v2/api/web/custom-domains/www.99zuowen.com --region cn-hangzhou --NamespaceId 'cn-hangzhou' --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
