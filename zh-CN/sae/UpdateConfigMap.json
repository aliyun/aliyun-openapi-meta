{
  "name": "UpdateConfigMap",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v1/sam/configmap/configMap",
  "parameters": [
    {
      "name": "ConfigMapId",
      "description": "需要更新的ConfigMap实例ID。需要调用[ListNamespacedConfigMaps](~~176917~~)接口查看。",
      "position": "Query",
      "type": "Long",
      "required": true
    },
    {
      "name": "Data",
      "description": "ConfigMap数据。",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "Description",
      "description": "描述信息。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sae update-config-map --config-map-id 1 --data '{env.home=/root, env.shell=/bin/sh}' --description test-desc --region cn-hangzhou",
    "legacyCli": "aliyun sae PUT /pop/v1/sam/configmap/configMap --region cn-hangzhou --Description 'test-desc' --ConfigMapId 1 --header \"Content-Type=application/json\" --body {\"env.home\":\"/root\",\"env.shell\":\"/bin/sh\"}"
  }
}
