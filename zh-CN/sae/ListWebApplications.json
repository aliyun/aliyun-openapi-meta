{
  "name": "ListWebApplications",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/pop/v2/api/web/applications",
  "parameters": [
    {
      "name": "Limit",
      "description": "返回的应用数量。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "NamespaceId",
      "description": "命名空间ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "NextToken",
      "description": "分页起始标记。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Prefix",
      "description": "应用名前缀。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sae list-web-applications --namespace-id cn-beijing:test --prefix my-application --next-token MTIzNCNhYmM --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun sae GET /pop/v2/api/web/applications --region cn-hangzhou --NextToken MTIzNCNhYmM --NamespaceId 'cn-beijing:test' --Prefix 'my-application' --Limit 10 --header \"Content-Type=application/json\""
  }
}
