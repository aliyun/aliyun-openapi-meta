    "legacyCli": "aliyun cdn DescribeDomainRealTimeByteHitRateData --region cn-hangzhou --EndTime '2020-05-15T09:15:00Z' --DomainName 'example.com' --StartTime '2020-05-15T09:13:00Z'"
