{
  "name": "DescribeDomainsUsageByDay",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DomainName",
      "description": "加速域名，只支持填写一个域名。\n\n默认查询当前用户下所有域名。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "EndTime",
      "description": "获取数据结束时间点。\n\n日期格式按照ISO8601表示法，并使用UTC时间，格式为yyyy-MM-ddTHH:mm:ssZ。\n\n> 结束时间需大于起始时间。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StartTime",
      "description": "获取数据起始时间点。\n\n日期格式按照ISO8601表示法，并使用UTC时间，格式为yyyy-MM-ddTHH:mm:ssZ。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun cdn describe-domains-usage-by-day --domain-name example.com --start-time 2019-12-22T08:00:00Z --end-time 2019-12-23T09:00:00Z --region cn-hangzhou",
    "legacyCli": "aliyun cdn DescribeDomainsUsageByDay --region cn-hangzhou --EndTime '2019-12-23T09:00:00Z' --DomainName 'example.com' --StartTime '2019-12-22T08:00:00Z'"
  }
}
