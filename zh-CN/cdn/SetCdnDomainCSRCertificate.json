{
  "name": "SetCdnDomainCSRCertificate",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DomainName",
      "description": "要设置的加速域名，需属于HTTPS加速类型。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ServerCertificate",
      "description": "证书内容。该证书必须是通过[CreateCdnCertificateSigningRequest](~~144478~~)接口创建的CSR对应的签名证书，内部必须是PEM格式的证书，Base64编码后再通过encodeURIComponent。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun cdn set-cdn-domain-csr-certificate --server-certificate ----BEGIN_CERTIFICATE-----_MIIFz0000-----END_CERTIFICATE----- --domain-name example.com --region cn-hangzhou",
    "legacyCli": "aliyun cdn SetCdnDomainCSRCertificate --region cn-hangzhou --ServerCertificate '----BEGIN_CERTIFICATE-----_MIIFz0000-----END_CERTIFICATE-----' --DomainName 'example.com'"
  }
}
