      "type": "String",
      "required": false
    },
    {
      "name": "LocalLogRetentionSpace",
      "description": "本地日志最大空间使用率。 取值为0~50，此为循环空间，默认为30。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun drds set-backup-local --drds-instance-id drdshbgag23d13fds --local-log-retention-hours 12 --local-log-retention-space 30 --high-space-usage-protection 80 --api-version 2019-01-23 --region cn-hangzhou",
    "legacyCli": "aliyun drds SetBackupLocal --region cn-hangzhou --DrdsInstanceId drdshbgag23d13fds --LocalLogRetentionHours 12 --LocalLogRetentionSpace 30 --HighSpaceUsageProtection 80"
