{
  "name": "SetBackupLocal",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DrdsInstanceId",
      "description": "DRDS 实例ID",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "HighSpaceUsageProtection",
      "description": "实例使用空间>= 90%，或者剩余空间小于5GB时，是否无条件清理Binlog：1: 开启 0：不开启",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "LocalLogRetentionHours",
      "description": "日志备份本地保留小时数。取值为0~7*24，0表示不保留，默认为18",
