      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StartTime",
      "description": "获取数据起始时间点。日期格式按照ISO8601表示法，并使用UTC时间，格式为YYYY-MM-DDThh:mm:ssZ。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun dcdn describe-dcdn-domain-isp-data --domain-name example.com --start-time 2019-12-05T12:00:00Z --end-time 2019-12-06T12:00:00Z --region cn-hangzhou",
    "legacyCli": "aliyun dcdn DescribeDcdnDomainIspData --region cn-hangzhou --EndTime '2019-12-06T12:00:00Z' --DomainName 'example.com' --StartTime '2019-12-05T12:00:00Z'"
