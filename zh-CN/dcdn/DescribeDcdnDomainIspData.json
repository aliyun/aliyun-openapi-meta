{
  "name": "DescribeDcdnDomainIspData",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DomainName",
      "description": "加速域名，仅支持查询单个域名。\n\n默认查询当前用户下所有域名。",
