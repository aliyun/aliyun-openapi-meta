{
  "name": "ListLogs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/ha3/instances/[instanceId]/logs",
  "parameters": [
    {
      "name": "endTime",
      "description": "查询结束时间戳。单位：秒。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "instanceId",
      "description": "实例ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageNum",
      "description": "页码，默认值 1。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "指定每页展示条数，默认为10。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "query",
      "description": "查询语句。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "startTime",
      "description": "查询开始时间戳。单位：秒。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "type",
      "description": "select: 查询日志, push: 写入日志",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun searchengine list-logs --instance-id ha-cn-i7m2roiy504 --type push --page-num 1 --page-size 10 --start-time 1706340600 --end-time 1710432000 --query status:_200_AND_totalTime_0.01 --region cn-hangzhou",
    "legacyCli": "aliyun searchengine GET /openapi/ha3/instances/ha-cn-i7m2roiy504/logs --region cn-hangzhou --query 'status:_200_AND_totalTime_0.01' --pageSize 10 --startTime 1706340600 --endTime 1710432000 --type push --pageNum 1 --header \"Content-Type=application/json\""
  }
}
