{
  "name": "ListTaskLogs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/instances/[InstanceId]/tasks/[TaskId]/logs",
  "parameters": [
    {
      "name": "InstanceId",
      "description": "实例ID，可从接口ListInstances获取。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "PageNumber",
      "description": "页码，起始值为1，默认值为10。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "页大小，默认值为10。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "TaskId",
      "description": "任务ID，可从接口ListTasks获取。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun paifeaturestore list-task-logs --instance-id fs-cn-00000000 --task-id 4 --page-number 1 --page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore GET /api/v1/instances/fs-cn-00000000/tasks/4/logs --region cn-hangzhou --PageSize 10 --PageNumber 1 --header \"Content-Type=application/json\""
  }
}
