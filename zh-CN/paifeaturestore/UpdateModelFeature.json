      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun paifeaturestore update-model-feature --instance-id fs-cn-00000000 --model-feature-id 4 --label-table-id 4 --features Type=STRING FeatureViewId=5 PrefixName=cand_seq AliasName=sex Name=gender --sequence-feature-view-ids example-string --label-priority-level 0 --region cn-hangzhou",
    "legacyCli": "aliyun paifeaturestore PUT /api/v1/instances/fs-cn-00000000/modelfeatures/4 --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"LabelPriorityLevel\":0,\"SequenceFeatureViewIds\":[\"example-string\"],\"Features\":[{\"Type\":\"STRING\",\"FeatureViewId\":\"5\",\"PrefixName\":\"cand_seq\",\"AliasName\":\"sex\",\"Name\":\"gender\"}],\"LabelTableId\":\"4\"}"
