{
  "name": "DescribeSubaccountK8sClusterUserConfig",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/k8s/[ClusterId]/users/[Uid]/user_config",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "PrivateIpAddress",
      "description": "是否获取内网连接配置。取值：\n- `true`：仅获取内网连接的KubeConfig凭证。\n- `false`：仅获取公网连接的KubeConfig凭证。\n\n默认值：`false`。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "TemporaryDurationMinutes",
      "description": "临时KubeConfig有效期，单位：分钟。\n\n取值范围：[15, 4320]，即最长3天。\n> 当不设置该参数时，将由系统自动确定一个更长的有效期，具体过期时间通过返回的expiration字段的值确定。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "Uid",
      "description": "阿里云账号内指定的RAM用户或RAM角色ID。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun cs describe-subaccount-k8s-cluster-user-config --cluster-id c5b5e80b0b64a4bf6939d2d8f0000 --uid 265624438516500000 --private-ip-address false --temporary-duration-minutes 15 --region cn-hangzhou",
    "legacyCli": "aliyun cs GET /k8s/c5b5e80b0b64a4bf6939d2d8f0000/users/265624438516500000/user_config --region cn-hangzhou --PrivateIpAddress false --TemporaryDurationMinutes 15 --header \"Content-Type=application/json\""
  }
}
