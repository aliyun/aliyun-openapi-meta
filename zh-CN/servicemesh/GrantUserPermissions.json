{
  "name": "GrantUserPermissions",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Permissions",
      "description": "权限列表，内容格式为JSON数组字符串。该列表要求传递全量权限信息，新增权限则在列表中新增项，删除则移除项。示例值字段释义：\n\n- `IsCustom`：系统规定参数。固定取值为`true`。\n\n- `Cluster`：网格实例ID。\n\n- `RoleName`：权限名称，取值为`istio-admin`、`istio-ops`、`istio-readonly`，分别对应管理员、网格资源管理员、只读权限。\n\n- `IsRamRole`：目标权限授予实体，如果是RAM角色，则为`true`，否则为`false`。",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "SubAccountUserId",
      "description": "RAM用户或RAM角色ID。",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "SubAccountUserIds",
      "description": "RAM用户或RAM角色ID列表，支持一次为多个用户授权",
      "position": "Body",
      "type": "Json",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun servicemesh grant-user-permissions --sub-account-user-id 278525736094800000 --permissions IsCustom_:true,_RoleName_:_istio-ops_,_Cluster_:_c57b848115458460583a4260cb7130000_,_RoleType_:_custom_,_IsRamRole_:false_,_IsCustom_:true,_RoleName_:_istio-ops_,_Cluster_:_c4ec191f4e12145c09286ea3e2b8f0000_,_RoleType_:_custom_,_IsRamRole_:false --sub-account-user-ids 278525736094800000 --region cn-hangzhou",
    "legacyCli": "aliyun servicemesh GrantUserPermissions --region cn-hangzhou --SubAccountUserId 278525736094800000 --Permissions 'IsCustom_:true,_RoleName_:_istio-ops_,_Cluster_:_c57b848115458460583a4260cb7130000_,_RoleType_:_custom_,_IsRamRole_:false_,_IsCustom_:true,_RoleName_:_istio-ops_,_Cluster_:_c4ec191f4e12145c09286ea3e2b8f0000_,_RoleType_:_custom_,_IsRamRole_:false' --SubAccountUserIds '[\"278525736094800000\"]'"
  }
