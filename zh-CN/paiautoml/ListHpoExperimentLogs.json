{
  "name": "ListHpoExperimentLogs",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/automl/v1/hpo/experiment/[ExperimentId]/logs",
  "parameters": [
    {
      "name": "ExperimentId",
      "description": "HPO实验id",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "LogName",
      "description": "log名称。目前支持‘nnimanager.log'和'dispatcher.log'",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "页码。起始值：1。不填则返回log文件里所有内容。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "每页包含的日志行数。不填则返回log文件里所有内容。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun paiautoml list-hpo-experiment-logs --experiment-id abcde --log-name nnimanager.log --page-number 1 --page-size 40 --region cn-hangzhou",
    "legacyCli": "aliyun paiautoml GET /api/automl/v1/hpo/experiment/abcde/logs --region cn-hangzhou --PageSize 40 --PageNumber 1 --LogName 'nnimanager.log' --header \"Content-Type=application/json\""
  }
}
