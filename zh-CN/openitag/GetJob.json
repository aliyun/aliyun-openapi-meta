{
  "name": "GetJob",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/api/v1/tenants/[TenantId]/jobs/[JobId]",
  "parameters": [
    {
      "name": "JobId",
      "description": "任务id，可在iTAG的任务中心中获取。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "JobType",
      "description": "任务类型，暂时只开放：DOWNLOWD_MARKRESULT_FLOW。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TenantId",
      "description": "租户id，可以通过ListTenantId租户列表查询的API来查询。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun openitag get-job --tenant-id GA000W134 --job-id 147000441221943296 --job-type DOWNLOWD_MARKRESULT_FLOW --region cn-hangzhou",
    "legacyCli": "aliyun openitag GET /openapi/api/v1/tenants/GA000W134/jobs/147000441221943296 --region cn-hangzhou --JobType DOWNLOWD_MARKRESULT_FLOW --header \"Content-Type=application/json\""
  }
}
