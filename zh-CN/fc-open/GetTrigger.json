{
  "name": "GetTrigger",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2021-04-06/services/[serviceName]/functions/[functionName]/triggers/[triggerName]",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "description": "您的阿里云账号（主账号）ID。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Date",
      "description": "客户端发起请求的时间。格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Trace-Id",
      "description": "自定义请求ID。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "functionName",
      "description": "函数的名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "serviceName",
      "description": "服务的名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "triggerName",
      "description": "触发器的名称。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc-open get-trigger --service-name demoService --function-name demoFunction --trigger-name demoTrigger --x-fc-account-id 1880770869020000 --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id my-test-trace-id --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open GET /2021-04-06/services/demoService/functions/demoFunction/triggers/demoTrigger --region cn-hangzhou --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Trace-Id=my-test-trace-id\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
  }
}
