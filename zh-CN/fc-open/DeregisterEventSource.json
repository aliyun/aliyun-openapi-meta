    "legacyCli": "aliyun fc-open DELETE /2021-04-06/services/demo-service/functions/demo-function/event-sources/acs:eventbridge:cn-shanghai:123456:eventbus/mns-test/rule/fc-test1/target/abc --region cn-hangzhou --qualifier LATEST --header \"X-Fc-Date=Sat,_14_Jul_2017_07:02:38_GMT\" --header \"X-Fc-Trace-Id=asdf0000\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
