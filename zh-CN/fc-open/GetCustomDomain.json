{
  "name": "GetCustomDomain",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2021-04-06/custom-domains/[domainName]",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "description": "您的阿里云账号（主账号）ID。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Date",
      "description": "API调用时间，格式为**EEE,d MMM yyyy HH:mm:ss GMT**。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Trace-Id",
      "description": "自定义请求ID。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "domainName",
      "description": "域名。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc-open get-custom-domain --domain-name example.com --x-fc-account-id 1880770869020000 --x-fc-date Wed,_11_May_2022_09:00:00_GMT --x-fc-trace-id r4isu4sls0000 --api-version 2021-04-06 --region cn-hangzhou",
    "legacyCli": "aliyun fc-open GET /2021-04-06/custom-domains/example.com --region cn-hangzhou --header \"X-Fc-Date=Wed,_11_May_2022_09:00:00_GMT\" --header \"X-Fc-Trace-Id=r4isu4sls0000\" --header \"X-Fc-Account-Id=1880770869020000\" --header \"Content-Type=application/json\""
  }
}
