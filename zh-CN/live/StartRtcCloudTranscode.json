{
  "name": "StartRtcCloudTranscode",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AppId",
      "description": "频道所属的应用 ID。由大小写字母、数字、下划线、短划线（-）组成，最大 64 字符。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ChannelId",
      "description": "待转码用户所属的频道 ID。由大小写字母、数字、下划线、短划线（-）组成，最大 64 字符。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "InputParam",
      "description": "订阅输入相关参数。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "MaxIdleTime",
      "description": "空闲超时时间，当任务处于空闲状态（订阅不到指定主播流）的时长超过一定时间会自动停止。\n单位为秒，范围须在[10,14400]内，即最大 4 小时，默认为 300 秒。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "OutputParams",
      "description": "转码输出相关参数。",
      "position": "Query",
      "type": "Json",
      "required": true,
      "sub_parameters": [
        {
          "name": "ChannelId",
          "position": "Query",
          "type": "String",
          "required": true
        },
        {
          "name": "TranscodeTemplate",
          "position": "Query",
          "type": "String",
          "required": true
        },
        {
          "name": "UserId",
          "position": "Query",
          "type": "String",
          "required": true
        },
        {
          "name": "UserToken",
          "position": "Query",
          "type": "String",
          "required": true
        }
      ]
    }
  ],
  "example": {
    "unifiedCli": "aliyun live start-rtc-cloud-transcode --app-id 00000000-7074-0000-9ef5-85c19a400000 --channel-id myChannel --input-param '{\"SingleSubUserParam\":{\"StreamType\":0,\"UserId\":\"userA\",\"SourceType\":0}}' --output-params TranscodeTemplate=lhd UserId=userA_360p ChannelId=myChannel UserToken=eyJhcHBpZCI00000000 --max-idle-time 600 --region cn-hangzhou",
    "legacyCli": "aliyun live StartRtcCloudTranscode --region cn-hangzhou --AppId '00000000-7074-0000-9ef5-85c19a400000' --ChannelId myChannel --OutputParams '[{\"TranscodeTemplate\":\"lhd\",\"UserId\":\"userA_360p\",\"ChannelId\":\"myChannel\",\"UserToken\":\"eyJhcHBpZCI00000000\"}]' --MaxIdleTime 600 --InputParam '{\"SingleSubUserParam\":{\"StreamType\":0,\"UserId\":\"userA\",\"SourceType\":0}}'"
  }
}
