{
  "name": "GetEvents",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/events",
  "parameters": [
    {
      "name": "deploymentId",
      "description": "已部署作业ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "deploymentName",
      "description": "已部署作业名称",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageIndex",
      "description": "分页参数，页码索引，表示所请求页码，默认值为1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "分页参数，所请求页码的元素数量，默认值为10，最大值100。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "workspace",
