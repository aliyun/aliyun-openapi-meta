      "position": "Header",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun ververica get-events --workspace a14bd5d90a0000 --namespace default-namespace --page-size 10 --page-index 1 --deployment-id 58718c99-3b29-4c5e-93bb-c9fc4ec60000 --deployment-name example-string --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/events --region cn-hangzhou --pageIndex 1 --deploymentId '58718c99-3b29-4c5e-93bb-c9fc4ec60000' --pageSize 10 --deploymentName 'example-string' --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
  }
}
