{
  "name": "GetUdfArtifacts",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/udfartifacts",
  "parameters": [
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "udfArtifactName",
      "description": "UDF对应的Jar或者Python文件的名称。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "description": "工作空间ID。",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun ververica get-udf-artifacts --workspace 710d6a64d8c34d --namespace default-namespace --udf-artifact-name test-udf --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/udfartifacts --region cn-hangzhou --udfArtifactName 'test-udf' --header \"workspace=710d6a64d8c34d\" --header \"Content-Type=application/json\""
  }
}
