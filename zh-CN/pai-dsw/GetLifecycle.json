{
  "name": "GetLifecycle",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/instances/[InstanceId]/lifecycle",
  "parameters": [
    {
      "name": "EndTime",
      "description": "查询的结束时间。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "InstanceId",
      "description": "实例ID。如何获取实例ID，请参见[ListInstances](~~470439~~)。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "Limit",
      "description": "查询获取的Session数量限制。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Order",
      "description": "结果的排序方式，取值如下：\n- ASC：按时间升序。\n- DESC：按时间降序。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SessionNumber",
      "description": "一个Session为实例从启动到失败或停止的过程，sessionNumber表示实例Session的序号偏移值。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "StartTime",
      "description": "查询的起始时间。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Token",
      "description": "用于分享url",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun pai-dsw get-lifecycle --instance-id dsw-9698d842b6000 --session-number 1 --start-time 2020-11-08T15:00:00Z --end-time 2020-11-08T15:00:00Z --limit 1 --order DESC --token example-string --api-version 2022-01-01 --region cn-hangzhou",
    "legacyCli": "aliyun pai-dsw GET /api/v2/instances/dsw-9698d842b6000/lifecycle --region cn-hangzhou --Order DESC --EndTime '2020-11-08T15:00:00Z' --SessionNumber 1 --StartTime '2020-11-08T15:00:00Z' --Token 'example-string' --Limit 1 --header \"Content-Type=application/json\""
  }
}
