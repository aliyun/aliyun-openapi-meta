{
  "name": "ListSavedSearch",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/savedsearches",
  "parameters": [
    {
      "name": "offset",
      "description": "查询开始行。默认值为0。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "size",
      "description": "分页查询时，设置的每页行数。最大值为500。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls list-saved-search --project aliyun-test-project --offset 0 --size 10 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /savedsearches --project aliyun-test-project --region cn-hangzhou --offset 0 --size 10 --header \"Content-Type=application/json\""
  }
}
