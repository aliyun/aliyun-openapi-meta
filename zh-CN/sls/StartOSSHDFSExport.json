{
  "name": "StartOSSHDFSExport",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/osshdfsexports/[ossExportName]?action=START",
  "parameters": [
    {
      "name": "ossExportName",
      "description": "已存在的唯一任务名称",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls start-oss-hdfs-export --project my-project --oss-export-name export-osshdfs-1234567890-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /osshdfsexports/export-osshdfs-1234567890-123456?action=START --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
