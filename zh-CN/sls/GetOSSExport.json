{
  "name": "GetOSSExport",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/ossexports/[ossExportName]",
  "parameters": [
    {
      "name": "ossExportName",
      "description": "已存在的唯一任务名称",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-oss-export --project my-project --oss-export-name export-oss-123456789-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ossexports/export-oss-123456789-123456 --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
