{
  "name": "UpdateETL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/etls/[etlName]",
  "parameters": [
    {
      "name": "body",
      "description": "更新的数据加工配置",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "etlName",
      "description": "数据加工名称",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-etl --project ali-test-project --etl-name etl-123456 --display-name this_is_update --description this_is_description --configuration example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /etls/etl-123456 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"configuration\":\"example-string\",\"displayName\":\"this_is_update\",\"description\":\"this_is_description\"}"
  }
}
