{
  "name": "UpdateConfig",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/configs/[configName]",
  "parameters": [
    {
      "name": "body",
      "description": "请求消息体。",
      "position": "Body",
      "type": "Json",
      "required": false
    },
    {
      "name": "configName",
      "description": "Logtail配置的名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-config --project ali-test-project --config-name test-sample --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /configs/test-sample --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
