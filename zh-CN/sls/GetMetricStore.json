{
  "name": "GetMetricStore",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/metricstores/[name]",
  "parameters": [
    {
      "name": "name",
      "description": "时序库名称",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "日志项目名称",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-metric-store --project my-project --name my_metric_store --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /metricstores/my_metric_store --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
