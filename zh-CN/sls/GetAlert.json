      "description": "Project名称",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-alert --project ali-test-project --alert-name alert-0123456789-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /alerts/alert-0123456789-123456 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
