    "legacyCli": "aliyun sls PUT /maxcomputeexports/export-mc-1234567890-123456 --project my-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"configuration\":\"example-string\",\"displayName\":\"my-mc-job\",\"description\":\"Update_MaxCompute_delivery_task\"}"
