{
  "name": "UpdateSavedSearch",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/savedsearches/[savedsearchName]",
  "parameters": [
    {
      "name": "body",
      "description": "快速查询结构体。",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "savedsearchName",
      "description": "要更新的快速查询的名称。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-saved-search --project my-project --savedsearch-name savedsearch-name --search-query 0_select_date_format_time_-_time_%60,_%H:%i:%s_as_time,_COUNT_0_as_pv_group_by_time --logstore aliyun-test-logstore --topic theme --display-name displayname --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /savedsearches/savedsearch-name --project my-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"savedsearchName\":\"savedsearch-name\",\"displayName\":\"displayname\",\"searchQuery\":\"0_select_date_format_time_-_time_%60,_%H:%i:%s_as_time,_COUNT_0_as_pv_group_by_time\",\"topic\":\"theme\",\"logstore\":\"aliyun-test-logstore\"}"
  }
}
