{
  "name": "UpdateAlert",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/alerts/[alertName]",
  "parameters": [
    {
      "name": "alertName",
      "description": "告警规则ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "更新告警规则的配置",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "project",
      "description": "Project名称",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-alert --project ali-test-project --alert-name alert-0123456789-123456 --display-name this_is_alert --description this_is_description --configuration example-string --schedule example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /alerts/alert-0123456789-123456 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"schedule\":\"example-string\",\"configuration\":\"example-string\",\"displayName\":\"this_is_alert\",\"description\":\"this_is_description\"}"
  }
}
