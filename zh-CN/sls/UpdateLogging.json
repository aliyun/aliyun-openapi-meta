{
  "name": "UpdateLogging",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/logging",
  "parameters": [
    {
      "name": "body",
      "description": "请求结构体。",
      "position": "Body",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project 名称。",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-logging --project ali-test-project --logging-project my-project --logging-details type=consumergroup_log logstore=my-logstore --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /logging --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"loggingDetails\":[{\"type\":\"consumergroup_log\",\"logstore\":\"my-logstore\"}],\"loggingProject\":\"my-project\"}"
  }
}
