{
  "name": "GetAsyncSql",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/asyncsql/[queryId]",
  "parameters": [
    {
      "name": "line",
      "description": "分页结果的page大小，最大支持1000",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "offset",
      "description": "分页结果的offset",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "description": "sls的project名称",
      "position": "Host",
      "type": "String",
      "required": false
    },
    {
      "name": "queryId",
      "description": "异步SQL对应的ID（整个SQL生命周期内固定）",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-async-sql --project sls-demo-project --query-id 690C4F2A16FBD65C40000484_14 --offset 0 --line 100 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /asyncsql/690C4F2A16FBD65C40000484_14 --project sls-demo-project --region cn-hangzhou --offset 0 --line 100 --header \"Content-Type=application/json\""
  }
}
