{
  "name": "ListConfig",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/configs",
  "parameters": [
    {
      "name": "configName",
      "description": "Logtail配置名称，用于模糊搜索。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "logstoreName",
      "description": "Logstore名称。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "offset",
      "description": "查询开始行。默认值为0。",
      "position": "Query",
      "type": "Long",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "size",
      "description": "分页查询时，设置的每页行数。最大值为500。",
      "position": "Query",
      "type": "Long",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls list-config --project ali-test-project --logstore-name ali-test-logstore --offset 0 --size 10 --config-name logtail-config-sample --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /configs --project ali-test-project --region cn-hangzhou --configName 'logtail-config-sample' --offset 0 --size 10 --logstoreName 'ali-test-logstore' --header \"Content-Type=application/json\""
  }
}
