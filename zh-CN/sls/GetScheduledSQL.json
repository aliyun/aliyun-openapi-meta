{
  "name": "GetScheduledSQL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/scheduledsqls/[scheduledSQLName]",
  "parameters": [
    {
      "name": "project",
      "description": "Project名称",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "scheduledSQLName",
      "description": "已存在的唯一任务名称",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-scheduled-sql --project ali-test-project --scheduled-sql-name sql-123456789-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /scheduledsqls/sql-123456789-123456 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
