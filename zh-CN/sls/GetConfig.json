{
  "name": "GetConfig",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/configs/[configName]",
  "parameters": [
    {
      "name": "configName",
      "description": "Logtail配置名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-config --project ali-test-project --config-name logtail-config-sample --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /configs/logtail-config-sample --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
