{
  "name": "GetCursorTime",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/logstores/[logstore]/shards/[shardId]?type=cursor_time",
  "parameters": [
    {
      "name": "cursor",
      "description": "希望获取时间戳的Cursor。接口[GetCursor](~~2771314~~)可以获取Cursor。\n\n> 如果Cursor取值小于Begin Cursor或者Cursor取值大于End Cursor，返回InvalidCursor；当Shard中无数据时，返回当前时间。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "logstore",
      "description": "Logstore名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "shardId",
      "description": "Shard ID。",
      "position": "Path",
      "type": "Integer",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-cursor-time --project ali-test-project --logstore ali-test-logstore --shard-id 0 --cursor MTU0NzQ3MDY4MjM3NjUxMzQ0Ng== --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /logstores/ali-test-logstore/shards/0?type=cursor_time --project ali-test-project --region cn-hangzhou --cursor 'MTU0NzQ3MDY4MjM3NjUxMzQ0Ng==' --header \"Content-Type=application/json\""
  }
}
