{
  "name": "ListMachineGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/machinegroups",
  "parameters": [
    {
      "name": "groupName",
      "description": "机器组名称。用于过滤机器组，支持部分匹配。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "offset",
      "description": "查询开始行。默认值为0。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "size",
      "description": "分页查询时，设置的每页行数。最大值为500。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls list-machine-group --project ali-test-project --offset 1 --size 10 --group-name test-machine-group --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /machinegroups --project ali-test-project --region cn-hangzhou --groupName 'test-machine-group' --offset 1 --size 10 --header \"Content-Type=application/json\""
  }
}
