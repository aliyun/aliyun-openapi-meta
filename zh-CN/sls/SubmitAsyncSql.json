{
  "name": "SubmitAsyncSql",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/asyncsql",
  "parameters": [
    {
      "name": "Accept",
      "description": "accept的数据格式，固定为：application/x-protobuf",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "Accept-Encoding",
      "description": "accept的压缩格式，可以固定为: lz4",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "body",
      "description": "返回的参数格式（对应protobuf格式）",
      "position": "Body",
      "type": "Json",
      "required": false
    },
    {
      "name": "project",
      "description": "幂等参数",
      "position": "Host",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls submit-async-sql --project sls-demo-project --biz-accept application/x-protobuf --accept-encoding lz4 --region cn-hangzhou",
    "legacyCli": "aliyun sls POST /asyncsql --project sls-demo-project --region cn-hangzhou --header \"Accept=application/x-protobuf\" --header \"Accept-Encoding=lz4\" --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
