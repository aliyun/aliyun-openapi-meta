    "legacyCli": "aliyun eas POST /api/v2/services/cn-hangzhou/foo/clone --region cn-hangzhou --Labels '{\"key\":\"example-string\"}' --header \"Content-Type=application/json\" --body \"name_:_foo_,_model_path_:_http://path/to/model.tar.gz_,_processor_:_tensorflow_cpu_,_metadata_:_instance_:_2,_memory_:_7000,_cpu_:_4\""
