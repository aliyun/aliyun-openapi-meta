{
  "name": "ScaleService",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/scale",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas scale-service --cluster-id cn-shanghai --service-name foo --instance 2 --instances-to-delete foo-adsx-xxxx --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/foo/scale --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"Instance\":2,\"InstancesToDelete\":[\"foo-adsx-xxxx\"]}"
  }
}
