{
  "name": "StopService",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/stop",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas stop-service --cluster-id cn-shanghai --service-name foo --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/foo/stop --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
