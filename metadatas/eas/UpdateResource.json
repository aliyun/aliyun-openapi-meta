{
  "name": "UpdateResource",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/resources/[ClusterId]/[ResourceId]",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ResourceId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas update-resource --cluster-id cn-shanghai --resource-id eas-r-asdasdasd0000 --resource-name iot --self-managed-resource-options '{\"NodeTolerations\":[{\"effect\":\"NoSchedule\",\"value\":\"value1\",\"key\":\"key1\",\"operator\":\"Equal\"}],\"NodeMatchLabels\":{\"key\":\"example-string\"}}' --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/resources/cn-shanghai/eas-r-asdasdasd0000 --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"ResourceName\":\"iot\",\"SelfManagedResourceOptions\":{\"NodeTolerations\":[{\"effect\":\"NoSchedule\",\"value\":\"value1\",\"key\":\"key1\",\"operator\":\"Equal\"}],\"NodeMatchLabels\":{\"key\":\"example-string\"}}}"
  }
}
