{
  "name": "UpdateServiceMirror",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/mirror",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas update-service-mirror --cluster-id cn-shanghai --service-name foo --ratio 30 --target foo-xxxx --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/foo/mirror --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"Target\":[\"foo-xxxx\"],\"Ratio\":30}"
  }
}
