{
  "name": "DevelopService",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/develop",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "Exit",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas develop-service --cluster-id cn-shanghai --service-name echo --exit true --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/echo/develop --region cn-hangzhou --Exit true --header \"Content-Type=application/json\""
  }
}
