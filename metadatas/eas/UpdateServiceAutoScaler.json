{
  "name": "UpdateServiceAutoScaler",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/autoscaler",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun eas update-service-auto-scaler --cluster-id cn-shanghai --service-name foo --min 2 --max 8 --scale-strategies metricName=qps service=demo_svc threshold=100.0 --behavior '{\"scaleUp\":{\"stabilizationWindowSeconds\":0},\"scaleDown\":{\"stabilizationWindowSeconds\":300},\"onZero\":{\"scaleDownGracePeriodSeconds\":600,\"scaleUpActivationReplicas\":1}}' --region cn-hangzhou",
    "legacyCli": "aliyun eas PUT /api/v2/services/cn-shanghai/foo/autoscaler --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"min\":2,\"max\":8,\"scaleStrategies\":[{\"metricName\":\"qps\",\"service\":\"demo_svc\",\"threshold\":100.0}],\"behavior\":{\"scaleUp\":{\"stabilizationWindowSeconds\":0},\"scaleDown\":{\"stabilizationWindowSeconds\":300},\"onZero\":{\"scaleDownGracePeriodSeconds\":600,\"scaleUpActivationReplicas\":1}}}"
  }
}
