{
  "name": "UpdateWhiteIps",
  "protocol": "HTTP|HTTPS",
  "method": "PATCH|POST",
  "pathPattern": "/openapi/instances/[InstanceId]/white-ips",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "clientToken",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "modifyMode",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun elasticsearch update-white-ips --instance-id es-cn-npk2154oi000b0000 --client-token 5A2CFF0E-5718-45B5-9D4D-70B3FF0000 --modify-mode Cover --es-ip-whitelist 10.61.xx.xx --white-ip-group '{\"groupName\":\"test_group\",\"whiteIpType\":\"PRIVATE_ES\",\"ips\":[\"10.2.xx.xx\"]}' --api-version 2017-06-13 --region cn-hangzhou",
    "legacyCli": "aliyun elasticsearch POST /openapi/instances/es-cn-npk2154oi000b0000/white-ips --region cn-hangzhou --clientToken '5A2CFF0E-5718-45B5-9D4D-70B3FF0000' --modifyMode Cover --header \"Content-Type=application/json\" --body {\"esIPWhitelist\":[\"10.61.xx.xx\"],\"whiteIpGroup\":{\"groupName\":\"test_group\",\"whiteIpType\":\"PRIVATE_ES\",\"ips\":[\"10.2.xx.xx\"]}}"
  }
}
