{
  "name": "UpdateKibanaWhiteIps",
  "protocol": "HTTP|HTTPS",
  "method": "PATCH|POST",
  "pathPattern": "/openapi/instances/[InstanceId]/kibana-white-ips",
  "parameters": [
    {
      "name": "InstanceId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "clientToken",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "modifyMode",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun elasticsearch update-kibana-white-ips --instance-id es-cn-tl329rbpc00010000 --client-token 5A2CFF0E-5718-45B5-9D4D-70B3FF0000 --modify-mode Cover --kibana-ip-whitelist 110.0.XX.XX/8 --white-ip-group '{\"groupName\":\"test_group_name\",\"whiteIpType\":\"PUBLIC_KIBANA\",\"ips\":[\"0.0.0.0\"]}' --api-version 2017-06-13 --region cn-hangzhou",
    "legacyCli": "aliyun elasticsearch POST /openapi/instances/es-cn-tl329rbpc00010000/kibana-white-ips --region cn-hangzhou --clientToken '5A2CFF0E-5718-45B5-9D4D-70B3FF0000' --modifyMode Cover --header \"Content-Type=application/json\" --body {\"kibanaIPWhitelist\":[\"110.0.XX.XX/8\"],\"whiteIpGroup\":{\"groupName\":\"test_group_name\",\"whiteIpType\":\"PUBLIC_KIBANA\",\"ips\":[\"0.0.0.0\"]}}"
  }
}
