{
  "name": "ListOSSExports",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/ossexports",
  "parameters": [
    {
      "name": "logstore",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls list-oss-exports --project my-project --offset 0 --size 10 --logstore example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ossexports --project my-project --region cn-hangzhou --offset 0 --size 10 --logstore 'example-string' --header \"Content-Type=application/json\""
  }
}
