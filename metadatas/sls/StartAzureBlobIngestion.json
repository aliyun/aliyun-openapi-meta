  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/azureblobingestions/[azureBlobIngestionName]?action=START",
  "parameters": [
    {
      "name": "azureBlobIngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls start-azure-blob-ingestion --project example-string --azure-blob-ingestion-name example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /azureblobingestions/example-string?action=START --project example-string --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
