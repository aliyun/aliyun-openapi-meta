{
  "name": "GetAppliedMachineGroups",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/configs/[configName]/machinegroups",
  "parameters": [
    {
      "name": "configName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-applied-machine-groups --project ali-test-project --config-name logtail-config-sample --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /configs/logtail-config-sample/machinegroups --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
