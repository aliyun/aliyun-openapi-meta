{
  "name": "StopElasticsearchIngestion",
  "protocol": "HTTP|HTTPS|SSE",
  "method": "PUT",
  "pathPattern": "/elasticsearchingestions/[elasticsearchIngestionName]?action=STOP",
  "parameters": [
    {
      "name": "elasticsearchIngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls stop-elasticsearch-ingestion --project ali-test-project --elasticsearch-ingestion-name ingest-elasticsearch-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /elasticsearchingestions/ingest-elasticsearch-123456?action=STOP --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
