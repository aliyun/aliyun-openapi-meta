{
  "name": "UpdateLogStoreMeteringMode",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/logstores/[logstore]/meteringmode",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "logstore",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-log-store-metering-mode --project projectName --logstore logstoreName --metering-mode ChargeByFunction --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /logstores/logstoreName/meteringmode --project projectName --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"meteringMode\":\"ChargeByFunction\"}"
  }
}
