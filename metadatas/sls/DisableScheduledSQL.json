{
  "name": "DisableScheduledSQL",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/scheduledsqls/[scheduledSQLName]?action=disable",
  "parameters": [
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "scheduledSQLName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls disable-scheduled-sql --project ali-test-project --scheduled-sql-name sql-123456789-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /scheduledsqls/sql-123456789-123456?action=disable --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
