{
  "name": "StopOSSHDFSExport",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/osshdfsexports/[ossExportName]?action=STOP",
  "parameters": [
    {
      "name": "ossExportName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls stop-oss-hdfs-export --project my-project --oss-export-name export-osshdfs-123456789-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /osshdfsexports/export-osshdfs-123456789-123456?action=STOP --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
