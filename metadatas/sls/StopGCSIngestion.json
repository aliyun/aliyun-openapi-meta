{
  "name": "StopGCSIngestion",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/gcsingestions/[gcsIngestionName]?action=STOP",
  "parameters": [
    {
      "name": "gcsIngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls stop-gcs-ingestion --project ali-test-project --gcs-ingestion-name ingest-gcs-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /gcsingestions/ingest-gcs-123456?action=STOP --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
