{
  "name": "MergeShard",
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/logstores/[logstore]/shards/[shard]?action=merge",
  "parameters": [
    {
      "name": "logstore",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "shard",
      "position": "Path",
      "type": "Integer",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls merge-shard --project ali-test-project --logstore ali-test-logstore --shard 3 --region cn-hangzhou",
    "legacyCli": "aliyun sls POST /logstores/ali-test-logstore/shards/3?action=merge --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
