{
  "name": "UpdateMetricStore",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/metricstores/[name]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "name",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-metric-store --project my-project --name my_metric_store --ttl 7 --auto-split true --max-split-shard 64 --biz-mode standard --hot-ttl 1 --infrequent-access-ttl 1 --append-meta true --sharding-policy example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /metricstores/my_metric_store --project my-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"mode\":\"standard\",\"autoSplit\":true,\"infrequentAccessTTL\":1,\"maxSplitShard\":64,\"appendMeta\":true,\"hot_ttl\":1,\"shardingPolicy\":\"example-string\",\"ttl\":7}"
  }
}
