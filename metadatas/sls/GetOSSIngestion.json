{
  "name": "GetOSSIngestion",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/ossingestions/[ossIngestionName]",
  "parameters": [
    {
      "name": "ossIngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-oss-ingestion --project ali-test-project --oss-ingestion-name ingest-oss-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ossingestions/ingest-oss-123456 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
