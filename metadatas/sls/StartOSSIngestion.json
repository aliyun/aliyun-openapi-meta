{
  "name": "StartOSSIngestion",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/ossingestions/[ossIngestionName]?action=START",
  "parameters": [
    {
      "name": "ossIngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls start-oss-ingestion --project ali-test-project --oss-ingestion-name ingest-oss-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /ossingestions/ingest-oss-123456?action=START --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
