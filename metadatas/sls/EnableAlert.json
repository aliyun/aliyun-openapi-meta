{
  "name": "EnableAlert",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/alerts/[alertName]?action=enable",
  "parameters": [
    {
      "name": "alertName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls enable-alert --project ali-test-project --alert-name alert-0123456789-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /alerts/alert-0123456789-123456?action=enable --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
