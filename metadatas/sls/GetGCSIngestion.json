{
  "name": "GetGCSIngestion",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/gcsingestions/[gcsIngestionName]",
  "parameters": [
    {
      "name": "gcsIngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-gcs-ingestion --project test --gcs-ingestion-name ingest-gcs-12345 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /gcsingestions/ingest-gcs-12345 --project test --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
