{
  "name": "StopMaxComputeExport",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/maxcomputeexports/[mcExportName]?action=STOP",
  "parameters": [
    {
      "name": "mcExportName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls stop-max-compute-export --project my-project --mc-export-name export-mc-1234567890-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /maxcomputeexports/export-mc-1234567890-123456?action=STOP --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
