{
  "name": "PutLogs",
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/logstores/[logstore]/shards/lb",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": false
    },
    {
      "name": "logstore",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "x-log-compresstype",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls put-logs --project ali-test-project --logstore ali-test-logstore --x-log-compresstype lz4 --region cn-hangzhou",
    "legacyCli": "aliyun sls POST /logstores/ali-test-logstore/shards/lb --project ali-test-project --region cn-hangzhou --header \"x-log-compresstype=lz4\" --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
