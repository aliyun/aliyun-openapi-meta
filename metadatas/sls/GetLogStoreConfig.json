{
  "name": "GetLogStoreConfig",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/logstores/[logstore]/config",
  "parameters": [
    {
      "name": "logstore",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-log-store-config --project ali-test-project --logstore ali-test-logstore --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /logstores/ali-test-logstore/config --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
