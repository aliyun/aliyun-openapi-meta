{
  "name": "GetS3Ingestion",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/s3ingestions/[s3IngestionName]",
  "parameters": [
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "s3IngestionName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-s3-ingestion --project test --s3-ingestion-name test --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /s3ingestions/test --project test --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
