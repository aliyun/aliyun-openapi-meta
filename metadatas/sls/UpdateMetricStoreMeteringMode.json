{
  "name": "UpdateMetricStoreMeteringMode",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/metricstores/[metricStore]/meteringmode",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "metricStore",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-metric-store-metering-mode --project projectName --metric-store metricStoreName --metering-mode ChargeByFunction --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /metricstores/metricStoreName/meteringmode --project projectName --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"meteringMode\":\"ChargeByFunction\"}"
  }
}
