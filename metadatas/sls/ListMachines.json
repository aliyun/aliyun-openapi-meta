{
  "name": "ListMachines",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/machinegroups/[machineGroup]/machines",
  "parameters": [
    {
      "name": "machineGroup",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls list-machines --project ali-test-project --machine-group test-group --offset 0 --size 10 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /machinegroups/test-group/machines --project ali-test-project --region cn-hangzhou --offset 0 --size 10 --header \"Content-Type=application/json\""
  }
}
