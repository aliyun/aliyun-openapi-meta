      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "offset",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "position": "Host",
      "type": "String",
      "required": true
    },
    {
      "name": "size",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls list-domains --project ali-test-project --offset 0 --size 10 --domain-name example.com --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /domains --project ali-test-project --region cn-hangzhou --offset 0 --size 10 --domainName 'example.com' --header \"Content-Type=application/json\""
  }
