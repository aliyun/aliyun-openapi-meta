      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "databaseName",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun ververica get-databases --workspace a14bd5d90a0000 --namespace default-namespace --catalog-name paimon --database-name paimon-ods --api-version 2022-07-18 --region cn-hangzhou",
    "legacyCli": "aliyun ververica GET /api/v2/namespaces/default-namespace/catalogs/paimon/databases --region cn-hangzhou --databaseName 'paimon-ods' --header \"workspace=a14bd5d90a0000\" --header \"Content-Type=application/json\""
