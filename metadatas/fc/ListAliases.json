{
  "name": "ListAliases",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/aliases",
  "parameters": [
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "limit",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "prefix",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc list-aliases --function-name my-func --prefix my-alias --next-token MTIzNCNhYmM= --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/my-func/aliases --region cn-hangzhou --prefix 'my-alias' --nextToken 'MTIzNCNhYmM=' --limit 10 --header \"Content-Type=application/json\""
  }
}
