{
  "name": "PublishFunctionVersion",
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/2023-03-30/functions/[functionName]/versions",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": true
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc publish-function-version --function-name my-func --region cn-hangzhou",
    "legacyCli": "aliyun fc POST /2023-03-30/functions/my-func/versions --region cn-hangzhou --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
