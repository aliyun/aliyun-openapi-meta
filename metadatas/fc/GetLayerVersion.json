{
  "name": "GetLayerVersion",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/layers/[layerName]/versions/[version]",
  "parameters": [
    {
      "name": "layerName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "version",
      "position": "Path",
      "type": "Integer",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc get-layer-version --layer-name my-layer --biz-version 1 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/layers/my-layer/versions/1 --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
