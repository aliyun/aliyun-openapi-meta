{
  "name": "InvokeFunction",
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/2023-03-30/functions/[functionName]/invocations",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "qualifier",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "x-fc-async-task-id",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "x-fc-invocation-type",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "x-fc-log-type",
      "position": "Header",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc invoke-function --function-name my-func --qualifier LATEST --x-fc-invocation-type Sync --x-fc-log-type Tail --biz-body event --x-fc-async-task-id test-id --region cn-hangzhou",
    "legacyCli": "aliyun fc POST /2023-03-30/functions/my-func/invocations --region cn-hangzhou --qualifier LATEST --header \"x-fc-async-task-id=test-id\" --header \"x-fc-log-type=Tail\" --header \"x-fc-invocation-type=Sync\" --header \"Content-Type=application/json\" --body \"event\""
  }
}
