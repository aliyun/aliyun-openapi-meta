{
  "name": "UpdateFunction",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/functions/[functionName]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": true
    },
    {
      "name": "functionName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc update-function --function-name my-func --region cn-hangzhou",
    "legacyCli": "aliyun fc PUT /2023-03-30/functions/my-func --region cn-hangzhou --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
