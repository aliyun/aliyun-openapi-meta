{
  "name": "PutLayerACL",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/layers/[layerName]/acl",
  "parameters": [
    {
      "name": "acl",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "layerName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "public",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc put-layer-acl --layer-name my-layer --public true --acl 1 --region cn-hangzhou",
    "legacyCli": "aliyun fc PUT /2023-03-30/layers/my-layer/acl --region cn-hangzhou --public true --acl 1 --header \"Content-Type=application/json\""
  }
}
