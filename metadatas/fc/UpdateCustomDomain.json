{
  "name": "UpdateCustomDomain",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/custom-domains/[domainName]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": true
    },
    {
      "name": "domainName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc update-custom-domain --domain-name foo.bar.com --region cn-hangzhou",
    "legacyCli": "aliyun fc PUT /2023-03-30/custom-domains/foo.bar.com --region cn-hangzhou --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
