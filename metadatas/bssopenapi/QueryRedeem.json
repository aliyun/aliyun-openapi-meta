    "legacyCli": "aliyun bssopenapi QueryRedeem --region cn-hangzhou --EffectiveOrNot true --ExpiryTimeStart '2018-08-01T00:00:00Z' --PageNum 1 --PageSize 10 --ExpiryTimeEnd '2018-08-01T00:00:00Z'"
