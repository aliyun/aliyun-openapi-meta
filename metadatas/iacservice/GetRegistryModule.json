{
  "name": "GetRegistryModule",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/registryModule/[namespaceName]/[moduleName]",
  "parameters": [
    {
      "name": "moduleName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "namespaceName",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun iacservice get-registry-module --namespace-name NamespaceName --module-name ModuleName --api-version 2021-08-06 --region cn-hangzhou",
    "legacyCli": "aliyun iacservice GET /registryModule/NamespaceName/ModuleName --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
