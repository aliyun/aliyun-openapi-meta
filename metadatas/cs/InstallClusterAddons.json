{
  "name": "InstallClusterAddons",
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/clusters/[ClusterId]/components/install",
  "parameters": [
    {
      "name": "ClusterId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "config",
          "position": "Body",
          "type": "String",
          "required": false
        },
        {
          "name": "name",
          "position": "Body",
          "type": "String",
          "required": true
        },
        {
          "name": "version",
          "position": "Body",
          "type": "String",
          "required": true
        }
      ]
    }
  ],
  "example": {
    "unifiedCli": "aliyun cs install-cluster-addons --cluster-id c82e6987e2961451182edacd74faf0000 --biz-body name=storage-operato version=v1.32.9 config=IngressDashboardEnabled_:_true_,_sls_project_name_:_your_sls_project_name --region cn-hangzhou",
    "legacyCli": "aliyun cs POST /clusters/c82e6987e2961451182edacd74faf0000/components/install --region cn-hangzhou --header \"Content-Type=application/json\" --body [{\"name\":\"storage-operato\",\"version\":\"v1.32.9\",\"config\":\"IngressDashboardEnabled_:_true_,_sls_project_name_:_your_sls_project_name\"}]"
  }
}
