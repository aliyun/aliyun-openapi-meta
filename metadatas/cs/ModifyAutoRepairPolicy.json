{
  "name": "ModifyAutoRepairPolicy",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/clusters/[cluster_id]/auto_repair_policies/[policy_id]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "cluster_id",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "policy_id",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun cs modify-auto-repair-policy --cluster-id c68deb844dc6d480eb775be611fdf0000 --policy-id r-xxxxxx --name test --rules '[{\"repair_procedure\":[{\"name\":\"QuarantineGPU\",\"intervention\":{\"enable\":true,\"inquiring_label\":{\"value\":\"inquiring\",\"key\":\"k8s.aliyun.com/incident\"},\"type\":\"label\",\"approved_label\":{\"value\":\"approved\",\"key\":\"k8s.aliyun.com/incident\"}},\"config\":{\"key\":\"example-string\"}}],\"incidents\":[{\"name\":\"Node.FaultNeedReboot.HOST\",\"type\":\"system\"}]}]' --region cn-hangzhou",
    "legacyCli": "aliyun cs PUT /clusters/c68deb844dc6d480eb775be611fdf0000/auto_repair_policies/r-xxxxxx --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"name\":\"test\",\"rules\":[{\"repair_procedure\":[{\"name\":\"QuarantineGPU\",\"intervention\":{\"enable\":true,\"inquiring_label\":{\"value\":\"inquiring\",\"key\":\"k8s.aliyun.com/incident\"},\"type\":\"label\",\"approved_label\":{\"value\":\"approved\",\"key\":\"k8s.aliyun.com/incident\"}},\"config\":{\"key\":\"example-string\"}}],\"incidents\":[{\"name\":\"Node.FaultNeedReboot.HOST\",\"type\":\"system\"}]}]}"
  }
}
