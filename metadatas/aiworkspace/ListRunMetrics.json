{
  "name": "ListRunMetrics",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/runs/[RunId]/metrics",
  "parameters": [
    {
      "name": "Key",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "运行的指标的Key",
        "en": "The metric key of the run."
      }
    },
    {
      "name": "MaxResults",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "请求的最大结果数，默认为10。",
        "en": "The maximum number of entries in the request. Default value: 10."
      }
    },
    {
      "name": "PageToken",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "分页token，从0开始，默认为0。",
        "en": "The pagination token, which starts from 0. Default value: 0."
      }
    },
    {
      "name": "RunId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "运行ID",
        "en": "The run ID."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace list-run-metrics --run-id run-1qJhzJ2YXgX0000 --key loss --page-token 0 --max-results 100 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace GET /api/v1/runs/run-1qJhzJ2YXgX0000/metrics --region cn-hangzhou --MaxResults 100 --PageToken 0 --Key loss --header \"Content-Type=application/json\""
  }
}
