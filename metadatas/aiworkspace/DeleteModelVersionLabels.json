{
  "name": "DeleteModelVersionLabels",
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/api/v1/models/[ModelId]/versions/[VersionName]/labels",
  "parameters": [
    {
      "name": "LabelKeys",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "需要删除的标签键。多项之间使用半角逗号（,）分隔。",
        "en": "The key of the tag to be deleted. Separate multiple tag keys with commas (,)."
      }
    },
    {
      "name": "ModelId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模型ID。如何获取模型ID，请参见[ListModels](~~461944~~)。",
        "en": "The model ID. You can call [ListModels](~~461944~~) to obtain the model ID."
      }
    },
    {
      "name": "VersionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "模型版本。",
        "en": "The version of the model."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace delete-model-version-labels --model-id model-d8dfd0000sjfd --version-name 0.1.1 --label-keys key1,key2 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace DELETE /api/v1/models/model-d8dfd0000sjfd/versions/0.1.1/labels --region cn-hangzhou --LabelKeys 'key1,key2' --header \"Content-Type=application/json\""
  }
}
