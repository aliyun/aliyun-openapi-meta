{
  "name": "GetDatasetVersion",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/datasets/[DatasetId]/versions/[VersionName]",
  "parameters": [
    {
      "name": "DatasetId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据集ID。如何获取数据集ID，详情请参见[ListDatasets](~~457222~~)。",
        "en": "The dataset ID. You can call [ListDatasets](~~457222~~) to obtain the dataset ID."
      }
    },
    {
      "name": "VersionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "软件版本名称。",
        "en": "The version name."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace get-dataset-version --dataset-id d-lfd60v0p0000ujtsdx --version-name v1 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace GET /api/v1/datasets/d-lfd60v0p0000ujtsdx/versions/v1 --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
