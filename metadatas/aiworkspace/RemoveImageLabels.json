{
  "name": "RemoveImageLabels",
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/api/v1/images/[ImageId]/labels/[LabelKey]",
  "parameters": [
    {
      "name": "ImageId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "镜像ID。如何获取镜像ID，请参见[ListImages](~~449118~~)  。",
        "en": "The image ID. You can call [ListImages](~~449118~~) to obtain the image ID."
      }
    },
    {
      "name": "LabelKey",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "label 的 key",
        "en": "The tag key."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace remove-image-labels --image-id image-d8df000000dsjfd --label-key key1 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace DELETE /api/v1/images/image-d8df000000dsjfd/labels/key1 --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
