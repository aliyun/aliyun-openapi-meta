    {
      "name": "RunId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "运行ID",
        "en": "The run ID."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace delete-run-label --run-id run-1qJhzJ2YXgX0000 --key is_evaluate --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace DELETE /api/v1/runs/run-1qJhzJ2YXgX0000/labels/is_evaluate --region cn-hangzhou --header \"Content-Type=application/json\""
