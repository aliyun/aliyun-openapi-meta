{
  "name": "PublishCodeSource",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v1/codesources/[CodeSourceId]/publish",
  "parameters": [
    {
      "name": "CodeSourceId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待发布的代码源配置ID。如何获取代码配置ID，请参见[ListCodeSources](~~459922~~)。",
        "en": "The ID of the code source to be published. You can call [ListCodeSources](~~459922~~) to query the code source ID."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace publish-code-source --code-source-id code-a7970000000 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace PUT /api/v1/codesources/code-a7970000000/publish --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
