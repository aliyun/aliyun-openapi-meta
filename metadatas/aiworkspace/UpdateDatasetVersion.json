{
  "name": "UpdateDatasetVersion",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v1/datasets/[DatasetId]/versions/[VersionName]",
  "parameters": [
    {
      "name": "DatasetId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据集ID。如何获取数据集ID，详情请参见[ListDatasets](~~457222~~)。"
      }
    },
    {
      "name": "VersionName",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "数据集版本名称。"
      }
    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求体。"
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace update-dataset-version --dataset-id d-rbvg50000jhc9ks92 --version-name v1 --options mountPath_:_/mnt/data/ --description This_is_a_description_of_a_dataset_version. --data-size 100000 --data-count 100 --region cn-hangzhou",
    "legacyCli": "aliyun aiworkspace PUT /api/v1/datasets/d-rbvg50000jhc9ks92/versions/v1 --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"Options\":\"mountPath_:_/mnt/data/\",\"Description\":\"This_is_a_description_of_a_dataset_version.\",\"DataSize\":100000,\"DataCount\":100}"
  }
}
