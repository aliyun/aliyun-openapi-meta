    },
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun aiworkspace log-run-metrics --run-id run-1qJhzJ2YXgX0000 --metrics example-string --region cn-hangzhou",
