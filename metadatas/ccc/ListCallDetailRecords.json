{
  "name": "ListCallDetailRecords",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ContactDisposition",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按挂断类型筛选。\n\n取值：Success(正常)，NoAnswer(未接通)，AbandonedInContactFlow(IVR中放弃)，AbandonedInQueue(排队放弃)，AbandonedRing(振铃放弃)，QueueOverflow(排队超时)，OneStepTransfer(转外线)，多个条件以逗号隔开。"
      }
    },
    {
      "name": "ContactId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "通过指定的contactId来查询某一通电话的记录，contactId可以通过软电话SDK发生通话时获取到。"
      }
    },
    {
      "name": "ContactType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按呼叫类型筛选。\n\n取值：Inbound（呼入），Outbound（呼出），Back2Back（双呼），PredictiveDial（预测试外呼），PrivacyDial（虚拟号码外呼） 多个条件以逗号隔开。"
      }
    },
    {
      "name": "Criteria",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "搜索条件。\n\n可以根据客户电话、坐席姓名、技能组名称来搜索。"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "呼叫中心实例ID"
      }
    },
    {
      "name": "OrderBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "按时间升降序排列。默认升序，取值: ASC/DESC。"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页序号"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页大小，最大数量为100"
      }
    },
    {
      "name": "PhoneNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "待获取数据的呼叫中心的电话号码"
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "获取的历史数据的起始时间。缺省为0，代表从当天的0时开始。"
      }
    },
    {
      "name": "StopTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "获取的历史数据的终止时间。缺省为0，代表截止到目前的时间。"
      }
    },
    {
      "name": "WithRecording",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否需要录音。默认需要，显式的指明不需要可以加快查询速度。"
      }
    }
  ]
}
