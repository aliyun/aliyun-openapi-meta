{
  "name": "ListAgentStates",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentIds",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "坐席ID列表。\n\n坐席ID等同于该座席的RAM子账户ID，最多50个坐席；不传则查询全部。"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "呼叫中心实例ID"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页序号，默认值为1"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小，默认值为10，最大是100。"
      }
    },
    {
      "name": "SkillGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "技能组ID"
      }
    },
    {
      "name": "State",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "坐席状态列表。\n\n不传查询全部。枚举值：ACW:话后处理中,Break:小休,Dialing:拨号,Ringing:振铃,Ready:等待,Talking:通话。"
      }
    }
  ]
}
