{
  "name": "StartBack2BackCall",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CallCenterNumber",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "背靠背代理所用电话号码。\n\n该电话号码需要归属于**instanceId**指定的呼叫中心实例，若不指定，则会随机选一个指定实例下可用于外呼的号码。"
      }
    },
    {
      "name": "Callee",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "被叫号码。"
      }
    },
    {
      "name": "Caller",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "主叫号码。"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "呼叫中心实例ID。\n\n背靠背代理所用电话号码需要归属于该呼叫中心实例。"
      }
    },
    {
      "name": "WorkflowId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "联系流ID。\n\n此联系流用来辅助建立双方通话，该字段是扩展用，请留空。"
      }
    }
  ]
}
