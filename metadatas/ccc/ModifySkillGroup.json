{
  "name": "ModifySkillGroup",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AllowPrivateOutboundNumber",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否允许使用个人外呼号码"
      }
    },
    {
      "name": "Description",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "技能组的新的简单描述"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待编辑技能组所属呼叫中心实例ID"
      }
    },
    {
      "name": "Name",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "技能组的新名称"
      }
    },
    {
      "name": "OutboundPhoneNumberId",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "需要绑定到技能组的外呼号码的号码ID。\n\n\n参数名称**OutboundPhoneNumberId.1**意为只绑定一个外呼号码，如果绑定多个号码，则需要传多个，例如 OutboundPhoneNumberId.1、OutboundPhoneNumberId.2、OutboundPhoneNumberId.3，以此类推。"
      }
    },
    {
      "name": "RoutingStrategy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "匹配方式"
      }
    },
    {
      "name": "SkillGroupId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待修改的技能组ID"
      }
    },
    {
      "name": "SkillLevel",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "技能级别。\n\n**SkillLevel.1**代表为**UserId.1**设置技能组等级，如果userId为多个，则SkillLevel也需要多个，并且数量需要保持一致。"
      }
    },
    {
      "name": "UserId",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "需要加入到技能组中的坐席ID。\n\n**UserId.1**意为只绑定一个坐席，如果绑定多个，则需要传多个，例如 UserId.1、UserId.2、UserId.3，以此类推。注意UserId指RAM子账号在呼叫中心实例的唯一标识UserId，并非RAM子账号的RamId。"
      }
    }
  ]
}
