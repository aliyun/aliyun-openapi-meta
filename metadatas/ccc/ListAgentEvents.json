{
  "name": "ListAgentEvents",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Event",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "description": {
        "zh": "事件。\n\n包括：”签入”,”签出”,”小休”,”等待”,”振铃”,”通话”,”放弃”,”结束”,”处理”,”发起求助”,”求助成功”,”会议建立”,”会议结束”,”拨号”。"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "待获取用户的呼叫中心实例ID。"
      }
    },
    {
      "name": "RamId",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "description": {
        "zh": "坐席的RAM ID。"
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "开始时间。\n\n默认是当前时间前一小时，注意查询时间范围小于1小时，否则会报错。"
      }
    },
    {
      "name": "StopTime",
      "position": "Query",
      "type": "Long",
      "required": false,
      "description": {
        "zh": "结束时间，默认是当前时间。"
      }
    }
  ]
}
