{
  "name": "ListAgentSummaryReports",
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AgentIds",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "坐席ID列表(使用“,”隔开)，坐席ID等同于该座席的RAM子账户ID，最多50个坐席；不传查询全部。"
      }
    },
    {
      "name": "EndTime",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "终止日期，格式：yyyy-MM-dd HH:mm:ss；需要注意目前仅支持按天维度的查询，参数设置请参考案例。"
      }
    },
    {
      "name": "InstanceId",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "呼叫中心实例ID"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页序号，默认值为1。"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小，默认值为10，最大是100。"
      }
    },
    {
      "name": "SkillGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "技能组ID"
      }
    },
    {
      "name": "StartTime",
      "position": "Query",
      "type": "String",
      "required": true,
      "description": {
        "zh": "起始日期，格式yyyy-MM-dd HH:mm:ss；需要注意目前仅支持按天维度的查询，参数设置请参考案例。同时时间设置不得早于6个月前的时间点"
      }
    }
  ]
}
