{
  "name": "UninstallPlugin",
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/v1/plugins/[pluginId]",
  "parameters": [
    {
      "name": "pluginId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "插件ID",
        "en": "The plug-in ID."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig uninstall-plugin --plugin-id pl-cvd2b36m1hkhdosfhar0 --region cn-hangzhou",
    "legacyCli": "aliyun apig DELETE /v1/plugins/pl-cvd2b36m1hkhdosfhar0 --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
