{
  "name": "UpdateServiceVersion",
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/v1/services/[serviceId]/versions/[name]",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "name",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "serviceId",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig update-service-version --service-id svc-xxx --name v1 --labels value=cn-hangzhou-k key=topology.kubernetes.io/zone --region cn-hangzhou",
    "legacyCli": "aliyun apig PUT /v1/services/svc-xxx/versions/v1 --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"labels\":[{\"value\":\"cn-hangzhou-k\",\"key\":\"topology.kubernetes.io/zone\"}]}"
  }
}
