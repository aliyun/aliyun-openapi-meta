{
  "name": "ListEnvironments",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/environments",
  "parameters": [
    {
      "name": "aliasLike",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "环境别名，模糊搜索。",
        "en": "Environment alias, fuzzy search."
      }
    },
    {
      "name": "gatewayId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关id，精确搜索。",
        "en": "Gateway ID, exact search."
      }
    },
    {
      "name": "gatewayNameLike",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关名称，模糊搜索。",
        "en": "Gateway name, fuzzy search."
      }
    },
    {
      "name": "gatewayType",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关类型",
        "en": "The gateway type"
      }
    },
    {
      "name": "nameLike",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "环境名称，模糊搜索。",
        "en": "Environment name, fuzzy search."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认1",
        "en": "Page number, default is 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小，默认10",
        "en": "Page size, default is 10."
      }
    },
    {
      "name": "resourceGroupId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "资源组ID。",
        "en": "Resource group ID."
      }
    }
