  "example": {
    "unifiedCli": "aliyun apig list-environments --name-like test --alias-like '测试' --gateway-id gw-cptv6ktlhtgnqr73h8d1 --gateway-name-like test-gw --page-number 1 --page-size 10 --resource-group-id rg-aek2nqpppkzplmq --gateway-type APIGateway --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/environments --region cn-hangzhou --nameLike test --pageNumber 1 --gatewayType APIGateway --pageSize 10 --resourceGroupId 'rg-aek2nqpppkzplmq' --gatewayNameLike 'test-gw' --aliasLike '测试' --gatewayId 'gw-cptv6ktlhtgnqr73h8d1' --header \"Content-Type=application/json\""
  }
