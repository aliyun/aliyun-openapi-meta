    }
  ],
  "example": {
    "unifiedCli": "aliyun apig create-http-api-operation --http-api-id api-xxx --operations '[\"example-string\"]' --region cn-hangzhou",
    "legacyCli": "aliyun apig POST /v1/http-apis/api-xxx/operations --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"operations\":[\"example-string\"]}"
