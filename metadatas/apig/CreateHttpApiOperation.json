{
  "name": "CreateHttpApiOperation",
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/v1/http-apis/[httpApiId]/operations",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false,
      "description": {
        "zh": "请求参数。",
        "en": "The request parameters."
      }
    },
    {
      "name": "httpApiId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "创建接口所属的HTTP API ID。",
        "en": "The ID of the HTTP API to which the operation belongs."
