{
  "name": "ListSslCerts",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/ssl/certs",
  "parameters": [
    {
      "name": "certNameLike",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "名称匹配关键词。",
        "en": "The name keyword for matching."
      }
    },
    {
      "name": "domainName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "域名名称。",
        "en": "The domain name."
      }
    },
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "页码，默认1",
        "en": "The page number of the page to return. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "每页大小，默认10",
        "en": "The number of entries per page. Default value: 10."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig list-ssl-certs --cert-name-like ali --domain-name fun.iot.evideocloud.com.cn --page-number 1 --page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/ssl/certs --region cn-hangzhou --pageNumber 1 --domainName 'fun.iot.evideocloud.com.cn' --certNameLike ali --pageSize 10 --header \"Content-Type=application/json\""
  }
}
