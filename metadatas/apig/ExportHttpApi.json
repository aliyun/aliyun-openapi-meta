{
  "name": "ExportHttpApi",
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/v1/http-apis/[httpApiId]/export",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "httpApiId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "HTTP API ID。",
        "en": "The HTTP API ID."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig export-http-api --http-api-id api-xxx --gateway-id gw-xxx --operation-ids op-xxxx --extension-config withPolicy=true withPlugin=true withService=true withAuthConsumer=true withAuthConfig=true --region cn-hangzhou",
    "legacyCli": "aliyun apig POST /v1/http-apis/api-xxx/export --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"extensionConfig\":{\"withPolicy\":true,\"withPlugin\":true,\"withService\":true,\"withAuthConsumer\":true,\"withAuthConfig\":true},\"operationIds\":[\"op-xxxx\"],\"gatewayId\":\"gw-xxx\"}"
  }
}
