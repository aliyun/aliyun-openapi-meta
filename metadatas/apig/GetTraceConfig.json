{
  "name": "GetTraceConfig",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/gateways/[gatewayId]/trace",
  "parameters": [
    {
      "name": "acceptLanguage",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "语言类型：\nzh：中文\nen：英文",
        "en": "The language in which you want results to be returned. Valid values: zh: Chinese. en: English."
      }
    },
    {
      "name": "gatewayId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "网关实例ID",
        "en": "The instance ID."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig get-trace-config --gateway-id gw-xxx --accept-language zh --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/gateways/gw-xxx/trace --region cn-hangzhou --acceptLanguage zh --header \"Content-Type=application/json\""
  }
}
