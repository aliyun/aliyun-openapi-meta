{
  "name": "ListSecretReferences",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/secrets/[secretId]/references",
  "parameters": [
    {
      "name": "pageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页页码。从1开始，不填默认1。",
        "en": "The page number. The value starts from 1. Default value: 1."
      }
    },
    {
      "name": "pageSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页大小。",
        "en": "The number of entries per page."
      }
    },
    {
      "name": "secretId",
      "position": "Path",
      "type": "String",
      "required": false,
      "description": {
        "zh": "密钥ID。",
        "en": "The ID of the key."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig list-secret-references --page-number 1 --page-size 10 --secret-id sec-d5e6shmm1hkoxxxxxxxx --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/secrets/sec-d5e6shmm1hkoxxxxxxxx/references --region cn-hangzhou --pageNumber 1 --pageSize 10 --header \"Content-Type=application/json\""
  }
}
