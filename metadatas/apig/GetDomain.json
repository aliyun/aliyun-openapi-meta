{
  "name": "GetDomain",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/domains/[domainId]",
  "parameters": [
    {
      "name": "domainId",
      "position": "Path",
      "type": "String",
      "required": true,
      "description": {
        "zh": "域名id。",
        "en": "The ID of the domain name."
      }
    },
    {
      "name": "withStatistics",
      "position": "Query",
      "type": "Boolean",
      "required": false,
      "description": {
        "zh": "是否返回线上资源信息。",
        "en": "Specifies whether to return online resource information."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun apig get-domain --domain-id d-cpqnfn5lhtgqbga95sv1 --with-statistics true --region cn-hangzhou",
    "legacyCli": "aliyun apig GET /v1/domains/d-cpqnfn5lhtgqbga95sv1 --region cn-hangzhou --withStatistics true --header \"Content-Type=application/json\""
  }
}
