{
  "name": "ListCloudAccess",
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CloudName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "云服务供应商。目前仅支持腾讯云（**Tencent**）",
        "en": "The cloud service provider. Set the value to **Tencent**, which indicates Tencent Cloud."
      }
    },
    {
      "name": "CurrentPage",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页，当前页，默认1。",
        "en": "The page number. Default value: 1."
      }
    },
    {
      "name": "SecretId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "云资源集访问的密钥ID。",
        "en": "The AccessKey ID that is used to access cloud resources."
      }
    },
    {
      "name": "ShowSize",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分页查询时，设置每页显示证书的数量。可选**10**、**20**、**50**。",
        "en": "The number of entries per page. Valid values: **10**, **20**, and **50**."
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun cas list-cloud-access --secret-id 276 --cloud-name Tencent --current-page 1 --show-size 20 --api-version 2020-04-07 --region cn-hangzhou",
    "legacyCli": "aliyun cas ListCloudAccess --region cn-hangzhou --CurrentPage 1 --SecretId 276 --CloudName Tencent --ShowSize 20"
  }
}
