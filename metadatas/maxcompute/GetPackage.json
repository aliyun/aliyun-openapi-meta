{
  "name": "GetPackage",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/projects/[projectName]/packages/[packageName]",
  "parameters": [
    {
      "name": "packageName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "projectName",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "sourceProject",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun maxcompute get-package --project-name projectA --package-name test_package --source-project projectB --region cn-hangzhou",
    "legacyCli": "aliyun maxcompute GET /api/v1/projects/projectA/packages/test_package --region cn-hangzhou --sourceProject projectB --header \"Content-Type=application/json\""
  }
}
