{
  "name": "UpdateSecret",
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/pop/v1/sam/secret/secret",
  "parameters": [
    {
      "name": "NamespaceId",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SecretData",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SecretId",
      "position": "Query",
      "type": "Long",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sae update-secret --namespace-id cn-beijing:test --secret-id 16 --secret-data SecretData=.dockerconfigjson_:_ --region cn-hangzhou",
    "legacyCli": "aliyun sae PUT /pop/v1/sam/secret/secret --region cn-hangzhou --SecretId 16 --NamespaceId 'cn-beijing:test' --SecretData '{\"SecretData\":\".dockerconfigjson_:_\"}' --header \"Content-Type=application/json\""
  }
}
