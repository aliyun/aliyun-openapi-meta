{
  "name": "CloneSqlInstance",
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/openapi/ha3/instances/[instanceId]/sql-studio/databases/[database]/sql-instances/[sqlInstanceId]/actions/clone",
  "parameters": [
    {
      "name": "body",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "database",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "instanceId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "sqlInstanceId",
      "position": "Path",
      "type": "Long",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun searchengine clone-sql-instance --instance-id ha-cn-pl32rf00000 --database general --sql-instance-id 1 --target-folder-id 1 --name test --region cn-hangzhou",
    "legacyCli": "aliyun searchengine POST /openapi/ha3/instances/ha-cn-pl32rf00000/sql-studio/databases/general/sql-instances/1/actions/clone --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"targetFolderId\":1,\"name\":\"test\"}"
  }
}
