{
  "name": "ListHpoTrialLogs",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/automl/v1/hpo/experiment/[ExperimentId]/trial/[TrialId]/logs",
  "parameters": [
    {
      "name": "ExperimentId",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "LogName",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "TrialId",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun paiautoml list-hpo-trial-logs --experiment-id abcde --trial-id asdf --log-name trial.log --page-number 1 --page-size 10 --region cn-hangzhou",
    "legacyCli": "aliyun paiautoml GET /api/automl/v1/hpo/experiment/abcde/trial/asdf/logs --region cn-hangzhou --PageSize 10 --PageNumber 1 --LogName 'trial.log' --header \"Content-Type=application/json\""
  }
}
