{
  "name": "ListHpoTrialLogNames",
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/automl/v1/hpo/experiment/[ExperimentId]/trial/[TrialId]/lognames",
  "parameters": [
    {
      "name": "ExperimentId",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "TrialId",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun paiautoml list-hpo-trial-log-names --experiment-id abcde --trial-id zUEapH --region cn-hangzhou",
    "legacyCli": "aliyun paiautoml GET /api/automl/v1/hpo/experiment/abcde/trial/zUEapH/lognames --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
