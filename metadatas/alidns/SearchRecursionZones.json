{
  "name": "SearchRecursionZones",
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Direction",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方向\nasc:升序\ndesc:降序"
      }
    },
    {
      "name": "EffectiveScopes",
      "position": "Query",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "EffectiveType",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Scope",
          "position": "Query",
          "type": "RepeatList",
          "required": false
        }
      ],
      "description": {
        "zh": "生效范围列表"
      }
    },
    {
      "name": "MaxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "分批次查询时每次显示的条目数。取值范围：**1**~**100**，默认值为**20**。"
      }
    },
    {
      "name": "NextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "下一个查询开始Token。"
      }
    },
    {
      "name": "OrderBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序字段，结果按哪个字段进行排序\nUpdateTime：修改时间\nRecordCount：解析记录条数"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "当前页数，起始值为**1**，默认为**1**。"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页查询时设置的每页行数，最大值100，默认为20。"
      }
    },
    {
      "name": "Remark",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "地址池备注，支持对输入的备注进行模糊搜索。"
      }
    },
    {
      "name": "ZoneName",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "域名（Zone）名称。"
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun alidns search-recursion-zones --zone-name cheng.suow.cc --remark test --page-number 1 --page-size 5 --effective-scopes '[{\"EffectiveType\":\"account\",\"Scope\":[\"20003\"]}]' --order-by default --direction asc --max-results 50 --next-token 4698691 --region cn-hangzhou",
    "legacyCli": "aliyun alidns SearchRecursionZones --region cn-hangzhou --OrderBy default --ZoneName 'cheng.suow.cc' --PageSize 5 --NextToken 4698691 --PageNumber 1 --EffectiveScopes '[{\"EffectiveType\":\"account\",\"Scope\":[\"20003\"]}]' --MaxResults 50 --Direction asc --Remark test"
  }
}
