{
  "name": "UpdateRecursionZoneProxyPattern",
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ClientToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "客户端Token，用于保证请求的幂等性。由客户端生成该参数值，要保证在不同请求间唯一，最大值不超过64个ASCII字符。"
      }
    },
    {
      "name": "ProxyPattern",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "是否开启子域名递归代理。取值：\n\nzone: 关闭（当解析本域名下不存在的子域名时，直接返回NXDOMAIN，表示子域名不存在）\nrecord: 开启（当解析本域名下不存在的子域名时，会依次查询“转发”和“递归”模块，并以最终查询到的解析结果来应答解析请求）"
      }
    },
    {
      "name": "ZoneId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "Zone ID，Zone的唯一识别码。"
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun alidns update-recursion-zone-proxy-pattern --client-token 21079fa016944979537637959d09bc --zone-id 173671468000011 --proxy-pattern record --region cn-hangzhou",
    "legacyCli": "aliyun alidns UpdateRecursionZoneProxyPattern --region cn-hangzhou --ZoneId 173671468000011 --ProxyPattern record --ClientToken 21079fa016944979537637959d09bc"
  }
}
