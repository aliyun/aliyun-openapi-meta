{
  "name": "SearchRecursionRecords",
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Direction",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方向，asc为生序，dsc为降序。"
      }
    },
    {
      "name": "EnableStatus",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "解析记录启用状态，**enable:启用，disable:禁用**"
      }
    },
    {
      "name": "MaxResults",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "本次请求所返回的最大记录条数。"
      }
    },
    {
      "name": "NextToken",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "下一个查询开始Token。"
      }
    },
    {
      "name": "OrderBy",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "排序方式：\n支持rr/type/value/requestSource/weight/ttl/enableStatus"
      }
    },
    {
      "name": "PageNumber",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "当前页数，起始值为1，默认为1。"
      }
    },
    {
      "name": "PageSize",
      "position": "Query",
      "type": "Integer",
      "required": true,
      "description": {
        "zh": "分页查询时设置的每页行数，最大值100，默认为20。"
      }
    },
    {
      "name": "Remark",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "备注。"
      }
    },
    {
      "name": "RequestSource",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "解析线路，默认为**default**。参见：\n\n<props=\"china\">[解析线路枚举](https://help.aliyun.com/document_detail/29807.html)</props>\n\n<props=\"intl\">[解析线路枚举](https://www.alibabacloud.com/help/zh/doc-detail/29807.htm)</props>"
      }
    },
    {
      "name": "Rr",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "主机记录"
      }
    },
    {
      "name": "Ttl",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "本地缓存时间。目前取值仅支持5、30、60、3600（1小时）、43200（12小时）、86400（一天），单位秒（s），默认60。"
      }
    },
    {
      "name": "Type",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "解析记录类型，目前支持如下： A:IPV4记录，支持将域名映射到IPv4地址使用 AAAA:IPV6记录，支持将域名映射到IPv6地址使用 CNAME:别名记录，支持将域名指向另外一个域名 MX:电邮交互记录，支持将域名指向邮件服务器地址 TXT:文本记录，是任意可读的文本DNS记录 SRV:服务器资源记录，用来标识某台服务器使用了某个服务，常见于微软系统的目录管理"
      }
    },
    {
      "name": "Value",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "记录值"
      }
    },
    {
      "name": "Weight",
      "position": "Query",
      "type": "Integer",
      "required": false,
      "description": {
        "zh": "解析记录权重 0-100"
      }
    },
    {
      "name": "ZoneId",
      "position": "Query",
      "type": "String",
      "required": false,
      "description": {
        "zh": "解析记录对应的ZoneId"
      }
    }
  ],
  "example": {
    "unifiedCli": "aliyun alidns search-recursion-records --zone-id 169438909000011 --rr www --type A --weight 2 --request-source default --enable-status enable --ttl 60 --remark test --value 1.1.XX.XX --order-by rr --direction asc --page-number 1 --page-size 1 --max-results 100 --next-token 4698691 --region cn-hangzhou",
    "legacyCli": "aliyun alidns SearchRecursionRecords --region cn-hangzhou --Rr www --OrderBy rr --ZoneId 169438909000011 --PageSize 1 --NextToken 4698691 --EnableStatus enable --MaxResults 100 --RequestSource default --Ttl 60 --Direction asc --Weight 2 --Remark test --Type A --PageNumber 1 --Value '1.1.XX.XX'"
  }
}
