{
  "camel_example": "aliyun smqproxy POST /queues/MyQueue/messages --region cn-hangzhou --header \"Content-Type=application/json\" --body '{\"Messages\":[{\"UserProperties\":{\"key\":{\"DataType\":\"example-string\",\"BinaryValue\":\"example-string\",\"StringValue\":\"example-value\"}},\"DelaySeconds\":60,\"Priority\":1,\"MessageGroupId\":\"group1\",\"MessageBody\":\"...\"}]}' --version 2026-04-09 --force",
