{
  "camel_example": "aliyun smqproxy POST /queues/MyQueue/messages --region cn-hangzhou --header \"Content-Type=application/json\" --body '{\"UserProperties\":{\"key1\":{\"DataType\":\"example-string\",\"BinaryValue\":\"example-string\",\"StringValue\":\"example-value\"},\"key2\":{\"DataType\":\"example-string\",\"BinaryValue\":\"example-string\",\"StringValue\":\"example-value\"}},\"DelaySeconds\":60,\"Priority\":1,\"MessageGroupId\":\"group-123\",\"MessageBody\":\"Hello MNS\"}' --version 2026-04-09 --force",
  "cmd_full_name": "smqproxy send-message",
  "cmd_name": "send-message",
  "deprecated": false,
  "description_en": "Sends a message to a specified queue with configurable delay and priority",
  "description_zh": "向指定的队列发送一条消息，支持设置延迟和优先级",
  "kebab_example": "aliyun smqproxy send-message --queue-name MyQueue --message-body 'Hello MNS' --delay-seconds 60 --priority 1 --message-group-id group-123 --user-properties '{\"key1\":{\"DataType\":\"example-string\",\"BinaryValue\":\"example-string\",\"StringValue\":\"example-value\"},\"key2\":{\"DataType\":\"example-string\",\"BinaryValue\":\"example-string\",\"StringValue\":\"example-value\"}}' --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "SendMessage",
  "operation": {
    "action": "SendMessage",
    "api_style": "ROA",
    "api_version": "2026-04-09",
    "body_mapping": {
      "delay_seconds": "DelaySeconds",
      "message_body": "MessageBody",
      "message_group_id": "MessageGroupId",
      "priority": "Priority",
      "user_properties": "UserProperties"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "create",
    "url": "/queues/{queueName}/messages"
  },
  "parameters": [
    {
      "example": "MyQueue",
      "help_en": "The queue name",
      "help_zh": "队列名称",
      "location": "path",
      "name": "queue_name",
      "options": [
        "--queue-name"
      ],
      "raw_name": "queueName",
      "required": true,
      "type": "string"
    },
    {
      "example": "0",
      "help_en": "The delay period before the message can be consumed after it is sent, in seconds. The maximum value is 7 days",
      "help_zh": "消息发送后延迟可被消费的时间，单位：秒。最大 7 天",
      "location": "body",
      "name": "delay_seconds",
      "options": [
        "--delay-seconds"
      ],
      "param_style": "json",
      "raw_name": "DelaySeconds",
      "required": false,
      "type": "int"
    },
    {
      "example": "\"Hello MNS\"",
      "help_en": "The message body. Base64-encode the message body in advance to avoid issues with special characters",
      "help_zh": "消息正文。建议事先进行 Base64 编码以避免特殊字符问题",
      "location": "body",
      "name": "message_body",
      "options": [
        "--message-body"
      ],
      "param_style": "json",
      "raw_name": "MessageBody",
      "required": false,
      "type": "string"
    },
    {
      "example": "group-123",
