      "location": "body",
      "name": "message_group_id",
      "options": [
        "--message-group-id"
      ],
      "param_style": "json",
      "raw_name": "MessageGroupId",
      "required": false,
      "type": "string"
    },
    {
      "example": "2",
      "help_en": "The message priority. A smaller value indicates a higher priority, where 1 is the highest priority",
      "help_zh": "消息优先级。数值越小优先级越高，1 为最高优先级",
      "location": "body",
      "name": "priority",
      "options": [
        "--priority"
      ],
      "param_style": "json",
      "raw_name": "Priority",
      "required": false,
      "type": "int"
