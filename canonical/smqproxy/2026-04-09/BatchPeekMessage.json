{
  "camel_example": "",
  "cmd_full_name": "smqproxy batch-peek-message",
  "cmd_name": "batch-peek-message",
  "deprecated": false,
  "description_en": "Batch peeks at messages in a queue without changing the message status",
  "description_zh": "批量查看队列中的消息，不改变消息状态",
  "kebab_example": "aliyun smqproxy batch-peek-message --queue-name test-queue --peekonly true --num-of-messages 16 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "BatchPeekMessage",
  "operation": {
    "action": "BatchPeekMessage",
    "api_style": "ROA",
    "api_version": "2026-04-09",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/queues/{queueName}/messages"
  },
  "parameters": [
    {
      "example": "test-queue",
      "help_en": "The queue name",
      "help_zh": "队列名称",
      "location": "path",
      "name": "queue_name",
      "options": [
        "--queue-name"
      ],
      "raw_name": "queueName",
      "required": true,
      "type": "string"
    },
    {
      "help_en": "Indicates that this request only peeks at messages at the top of the queue without changing the message status. Fixed value: true",
      "help_zh": "表示这次请求只是去查看队列顶部的消息并不会引起消息的状态改变。取值固定为true",
      "location": "query",
      "name": "peekonly",
      "options": [
        "--peekonly"
      ],
      "raw_name": "peekonly",
      "required": false,
      "type": "bool"
    },
    {
      "example": "16",
      "help_en": "The maximum number of messages to peek at in this BatchPeekMessage request",
      "help_zh": "本次BatchPeekMessage最多查看消息条数",
      "location": "query",
      "name": "num_of_messages",
      "options": [
        "--num-of-messages"
      ],
      "raw_name": "numOfMessages",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "/queues/[queueName]/messages",
  "product_code": "SMQProxy",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Messages": {
            "backendName": "Messages",
            "description_en": "The message list",
            "description_zh": "消息列表",
            "items": {
              "properties": {
                "DequeueCount": {
                  "backendName": "DequeueCount",
                  "description_en": "The total number of times the message has been consumed",
                  "description_zh": "总共被消费的次数",
                  "example": "5",
                  "format": "int64",
                  "type": "integer"
                },
                "EnqueueTime": {
                  "backendName": "EnqueueTime",
                  "description_en": "The time when the message was sent to the queue. The value is a UNIX timestamp that starts from 1970-01-01 00:00:00.000",
                  "description_zh": "消息发送到队列的时间，取值为从1970年01月01日00:00:00 000开始的时间",
                  "example": "1250700979248",
                  "format": "int64",
                  "type": "integer"
                },
                "FirstDequeueTime": {
                  "backendName": "FirstDequeueTime",
                  "description_en": "The time when the message was first consumed. The value is a UNIX timestamp in milliseconds that starts from 1970-01-01 00:00:00.000. If DequeueCount is 0, this value is the same as EnqueueTime",
                  "description_zh": "消息第一次被消费的时间，取值为从1970年01月01日00:00:00 000开始的毫秒数，如果DequeueCount为0，则与消息的EnqueueTime相同",
                  "example": "1250700979348",
                  "format": "int64",
                  "type": "integer"
                },
                "MessageBody": {
                  "backendName": "MessageBody",
                  "description_en": "The message body",
                  "description_zh": "消息体",
                  "example": "This is a test message",
                  "type": "string"
                },
                "MessageBodyMD5": {
                  "backendName": "MessageBodyMD5",
                  "description_en": "The MD5 hash of the message body",
                  "description_zh": "消息正文的MD5值",
                  "example": "F9360F391579E71CA77BC5D50242****",
                  "type": "string"
                },
                "MessageGroupId": {
                  "backendName": "MessageGroupId",
                  "description_en": "The message group ID (FIFO queues only)",
                  "description_zh": "消息分组 ID（仅 FIFO 队列）",
                  "example": "test-group",
                  "type": "string"
                },
                "MessageId": {
                  "backendName": "MessageId",
                  "description_en": "The message ID",
                  "description_zh": "消息ID",
                  "example": "C0A80255D7D1163042EA3F2814D055F1",
                  "type": "string"
                },
                "Priority": {
                  "backendName": "Priority",
                  "description_en": "The priority. Valid values: 1 to 16. Default value: 8. A value of 1 indicates the highest priority",
                  "description_zh": "优先级，取值[1, 16]，默认 8，1为 最高优先",
                  "example": "1",
                  "format": "int64",
                  "type": "integer"
                },
                "UserProperties": {
                  "additionalProperties": {
                    "properties": {
                      "BinaryValue": {
                        "backendName": "BinaryValue",
                        "type": "string"
                      },
                      "DataType": {
                        "backendName": "DataType",
                        "type": "string"
                      },
                      "StringValue": {
                        "backendName": "StringValue",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "backendName": "UserProperties",
                  "description_en": "The user-defined properties (JSON-formatted string)",
                  "description_zh": "用户自定义属性（JSON 格式字符串）",
                  "example": "{\"properties1\":\"value\"}",
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "v1_parameters": [
    {
      "help_en": "The maximum number of messages to peek at in this BatchPeekMessage request",
      "help_zh": "本次BatchPeekMessage最多查看消息条数",
      "name": "numOfMessages",
      "position": "query",
      "required": false,
      "type": "int"
    },
    {
      "help_en": "Indicates that this request only peeks at messages at the top of the queue without changing the message status. Fixed value: true",
      "help_zh": "表示这次请求只是去查看队列顶部的消息并不会引起消息的状态改变。取值固定为true",
      "name": "peekonly",
      "position": "query",
      "required": false,
      "type": "bool"
    },
    {
      "help_en": "The queue name",
      "help_zh": "队列名称",
      "name": "queueName",
      "position": "path",
      "required": false,
      "type": "string"
    }
  ]
}
