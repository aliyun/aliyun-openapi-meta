    {
      "fields": [
        {
          "enum": [
            "asr",
            "paraformer"
          ],
          "example": "asr",
          "help_en": "Speech-to-text model. Valid values: asr (small model) or paraformer (LLM)",
          "help_zh": "语音转写模型，取值  asr （小模型），paraformer（大模型）",
          "name": "asr_model_code",
          "options": [
            "--asr-model-code"
          ],
          "raw_name": "asrModelCode",
          "required": false,
          "type": "string"
        },
        {
          "example": "1",
          "help_en": "Enables automatic speaker separation for single-channel audio. Set to 0 to enable Auto detection, or 1 to disable it. Default value: 1. Note: This applies only to audio files with a sample rate of 8 kHz",
          "help_zh": "单轨音频自动区分通话人，取值：0 为自动识别，取值：1 为不自动识别；默认：1；备注：只适用于8k采样率音频文件",
          "name": "auto_split",
          "options": [
            "--auto-split"
          ],
          "raw_name": "autoSplit",
          "required": false,
          "type": "int"
        },
        {
          "example": "1",
          "help_en": "Applies to dual-channel recordings. Specifies the track number for the Customer role. Valid values: 0 or 1. Default value: 1, meaning track 1 is assigned to the Customer. Audio tracks are typically numbered starting from 0, so a two-track file uses tracks 0 and 1. You must confirm whether track 0 corresponds to the agent or the customer in your specific case. If you use this parameter, you must also set the autoSplit parameter to 0. This parameter is ignored for single-channel files",
          "help_zh": "适用于双轨录音，指定客户角色的轨道编号，取值：0、1，默认 1，即第 1 轨为客户；通常音轨都是从 0 开始编号，2 个轨就是 0，1；具体 0 是客服还是客户，需要您自行确认。若使用此参数，请务必传入 autoSplit 参数，值为 0。单轨文件忽略此参数",
          "name": "client_channel",
          "options": [
            "--client-channel"
          ],
          "raw_name": "clientChannel",
          "required": false,
          "type": "int"
        },
        {
          "example": "sss.mp3",
          "help_en": "File name",
          "help_zh": "文件名",
          "name": "file_name",
          "options": [
            "--file-name"
          ],
          "raw_name": "fileName",
          "required": true,
          "type": "string"
        },
        {
          "example": "zh",
          "help_en": "Language for detection. The default value is Mandarin Chinese. For other supported languages and dialects, contact customer support.  ",
          "help_zh": "识别语言，默认值为中文普通话，其他支持的语种和方言请联系客服",
          "name": "language_hints",
          "options": [
            "--language-hints"
          ],
          "raw_name": "languageHints",
          "required": false,
          "type": "string"
        },
        {
          "enum": [
            "low",
            "middle",
            "high"
          ],
          "example": "low",
          "help_en": "Priority for speech transcription",
          "help_zh": "语音转写优先级",
          "name": "level",
          "options": [
            "--level"
          ],
          "raw_name": "level",
          "required": false,
          "type": "string"
        },
        {
          "example": "true",
          "help_en": "Automatically detect speaker roles. Set to true to enable auto detection; set to false to disable it. Default: false  ",
          "help_zh": "自动识别通话角色，true 为自动识别，false为不自动识别。默认：false",
          "name": "role_identification",
          "options": [
            "--role-identification"
          ],
          "raw_name": "roleIdentification",
          "required": false,
          "type": "bool"
        },
        {
          "example": "1",
          "help_en": "Applies to dual-channel recordings. Specifies the track number for the service agent role. Valid values: 0 or 1. Default value: 0, meaning track 0 is assigned to the agent. Audio tracks are typically numbered starting from 0, so a two-track file uses tracks 0 and 1. You must confirm whether track 0 corresponds to the agent or the customer in your specific case. If you use this parameter, you must also set the autoSplit parameter to 0. This parameter is ignored for single-channel files",
          "help_zh": "适用于双轨录音，指定客服角色的轨道编号，取值：0、1，默认 0，即第 0 轨为客服；通常音轨都是从 0 开始编号，2 个轨就是 0，1；具体 0 是客服还是客户，需要您自行确认。若使用此参数，请务必传入 autoSplit 参数，值为 0。若单轨文件忽略此参数",
          "name": "service_channel",
          "options": [
            "--service-channel"
          ],
          "raw_name": "serviceChannel",
          "required": false,
          "type": "int"
        },
        {
          "element": {
            "type": "string"
          },
          "help_en": "Mostly applicable to single-track recordings. Specify a list of keywords that the customer service representative might say (ensure the selected keywords are highly distinctive). The system analyzes the transcription line by line from top to bottom. When a sentence hits any of the specified keywords, that sentence is classified as spoken by the customer service representative, and the other role is identified as the customer.  ",
          "help_zh": "多数情况下适用于单轨录音，设置一组客服可能说的关键词列表（请确保选择那些区别性比较高的关键词），通过对转写文本从上到下逐句分析，当一句话命中某一个关键词时，则判定该句的角色为客服，则另一个角色就是客户",
          "name": "service_channel_keywords",
          "options": [
            "--service-channel-keywords"
          ],
          "raw_name": "serviceChannelKeywords",
          "required": false,
          "type": "array"
        },
        {
          "example": "esnvknv*****skdnvjksd",
          "help_en": "ID of the speech hotword vocabulary",
          "help_zh": "语音热词id",
          "name": "vocabulary_id",
          "options": [
            "--vocabulary-id"
          ],
          "raw_name": "vocabularyId",
          "required": false,
          "type": "string"
        },
        {
          "example": "http://1111.com/sss.mp3",
          "help_en": "File URL  ",
          "help_zh": "文件地址",
          "name": "voice_file_url",
