      "name": "slow_rt_ms",
      "options": [
        "--slow-rt-ms"
      ],
      "raw_name": "SlowRtMs",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The minimum number of requests required to trigger circuit breaking. If the number of requests in the current statistical window is less than this value, the circuit breaking rule is not triggered even if the circuit breaking condition is met. Default value: 5",
      "help_zh": "触发熔断的最小请求数目，若当前统计窗口请求数小于此值，即使达到熔断条件规则也不会触发。默认值为5",
      "location": "query",
      "name": "min_request_amount",
