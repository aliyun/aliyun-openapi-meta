      "name": "rule_id",
      "options": [
        "--rule-id"
      ],
      "raw_name": "RuleId",
      "required": true,
      "type": "int"
    },
    {
      "example": "2000",
      "help_en": "The circuit breaking duration. During this period, all requests to the API fail immediately. Unit: milliseconds",
      "help_zh": "熔断时长。在该时间段内，该接口的请求都会快速失败，单位毫秒",
      "location": "query",
      "name": "recovery_timeout_ms",
      "options": [
        "--recovery-timeout-ms"
      ],
      "raw_name": "RecoveryTimeoutMs",
      "required": false,
      "type": "int"
    },
    {
      "example": "2000",
      "help_en": "The statistical window duration. Unit: milliseconds. Default value: 1000",
      "help_zh": "统计窗口时长，单位MS。默认值为1000",
      "location": "query",
      "name": "stat_duration_ms",
      "options": [
        "--stat-duration-ms"
      ],
      "raw_name": "StatDurationMs",
      "required": false,
      "type": "int"
    },
    {
      "example": "3000",
