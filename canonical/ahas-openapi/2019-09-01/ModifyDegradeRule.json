      "raw_name": "HalfOpenBaseAmountPerStep",
      "required": false,
      "type": "int"
    },
    {
      "example": "2",
      "help_en": "The number of recovery steps during circuit breaking recovery. Default value: 1",
      "help_zh": "熔断恢复阶段数，默认值为1",
      "location": "query",
      "name": "half_open_recovery_step_num",
      "options": [
        "--half-open-recovery-step-num"
      ],
      "raw_name": "HalfOpenRecoveryStepNum",
      "required": false,
      "type": "int"
    },
    {
