    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "0",
      "help_en": "The threshold type, which specifies the circuit breaking strategy. A value of 0 indicates circuit breaking based on the slow request ratio. A value of 1 indicates circuit breaking based on the exception ratio",
      "help_zh": "阈值类型，即降级的策略，取值为0时表示按慢调用比例降级，取值为1时表示按异常比例降级",
      "location": "query",
      "name": "strategy",
      "options": [
        "--strategy"
      ],
      "raw_name": "Strategy",
      "required": false,
      "type": "int"
    },
    {
      "example": "0.5",
      "help_en": "The circuit breaking threshold corresponding to the threshold type. Circuit breaking is triggered for the API when this value is exceeded",
      "help_zh": "阈值类型所对应的降级阈值，超过该值时会触发接口的降级",
      "location": "query",
      "name": "threshold",
      "options": [
        "--threshold"
      ],
      "raw_name": "Threshold",
      "required": false,
      "type": "float"
    },
    {
      "doc_required": true,
