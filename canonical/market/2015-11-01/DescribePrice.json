{
  "camel_example": "",
  "cmd_full_name": "market describe-price",
  "cmd_name": "describe-price",
  "deprecated": false,
  "description_en": "Calls DescribePrice to query the price information of the corresponding product",
  "description_zh": "调用 DescribePrice 查询对应商品的价格信息",
  "kebab_example": "aliyun market describe-price --order-type INSTANCE_BUY --commodity components_:_package_version_:_yuncode12928000016_,_duration_:1,_pricingCycle_:_YEAR_,_productCode_:_cmgj010028_,_quantity_:1,_skuCode_:_prepay --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribePrice",
  "operation": {
    "action": "DescribePrice",
    "api_style": "RPC",
    "api_version": "2015-11-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "INSTANCE_BUY",
      "help_en": "Order type. Valid values:\n\nINSTANCE_BUY: Product purchase\nINSTANCE_RENEW: Instance renewal\nINSTANCE_UPGRADE: Instance upgrade\nNote: For renewal-type price inquiries, you must pass InstanceId in the Commodity parameter",
      "help_zh": "订单类型。取值：\n\nINSTANCE_BUY：商品购买\nINSTANCE_RENEW：实例续费\nINSTANCE_UPGRADE：实例升级\n说明：对于续费类型的询价，需要在 Commodity 中传入 InstanceId",
      "location": "query",
      "name": "order_type",
      "options": [
        "--order-type"
      ],
      "raw_name": "OrderType",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "{\"components\":{\"package_version\":\"yuncode12928000016\"},\"duration\":1,\"pricingCycle\":\"YEAR\",\"productCode\":\"cmgj01**28\",\"quantity\":1,\"skuCode\":\"prepay\"}",
      "help_en": "Serialized commodity information based on the specified OrderType. The CommodityType corresponding to each OrderType is as follows:\n\nINSTANCE_BUY: InstanceBuyCommodity\nINSTANCE_RENEW: InstanceRenewCommodity\nINSTANCE_UPGRADE: InstanceUpgradeCommodity\nThe parameters in the example are described as follows:\n\nproductCode: The product code.\nskuCode: The product specification code. For non-image products: prepay for subscription, postpay for pay-as-you-go. For image products: ECS for pay-as-you-go, Package for subscription.\ncomponents: Specification modules. The version package_version is required, and other modules depend on the product settings.\nduration: Number of cycles, such as 1, 2, 3...\npricingCycle: Cycle unit. Day, Month, or Year",
      "help_zh": "根据指定的 OrderType，使用对应的配件并序列化。 不同 OrderType 分别对应的 CommodityType 如下所示：\n\nINSTANCE_BUY：InstanceBuyCommodity\nINSTANCE_RENEW：InstanceRenewCommodity\nINSTANCE_UPGRADE：InstanceUpgradeCommodity\n示例中的参数说明如下：\n\nproductCode：商品 Code。\nskuCode：商品规格 Code。非镜像商品：预付费固定为 prepay，后付费固定为 postpay；镜像商品：按量为ECS，包年包月为Package\ncomponents：规格模块。其中版本 package_version 必传，其他模块根据商品的设置来传。\nduration：周期数量 1,2,3...。\npricingCycle: 周期单位。Day（日），Month（月），Year（年）",
      "location": "query",
      "name": "commodity",
      "options": [
        "--commodity"
      ],
      "raw_name": "Commodity",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Market",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Coupons": {
            "backendName": "result.coupons",
            "itemName": "Coupon",
            "items": {
              "properties": {
                "CanPromFee": {
                  "backendName": "canPromFee",
                  "format": "float",
                  "type": "number",
                  "visibility": "Public"
                },
                "CouponDesc": {
                  "backendName": "promotionDesc",
                  "type": "string",
                  "visibility": "Public"
                },
                "CouponName": {
                  "backendName": "promotionName",
                  "type": "string",
                  "visibility": "Public"
                },
                "CouponOptionCode": {
                  "backendName": "promotionOptionCode",
                  "type": "string",
                  "visibility": "Public"
                },
                "CouponOptionNo": {
                  "backendName": "promotionOptionNo",
                  "type": "string",
                  "visibility": "Public"
                },
                "IsSelected": {
                  "backendName": "selected",
                  "type": "boolean",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": false,
            "type": "array",
            "visibility": "Public"
          },
          "Currency": {
            "backendName": "result.currency",
            "description_en": "Currency\n\nCNY: Chinese Yuan\nUSD: US Dollar\nJPY: Japanese Yen",
            "description_zh": "币种\n\nCNY： 人民币\nUSD： 美元\nJPY：日元",
            "example": "CNY",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Cuxiao": {
            "backendName": "result.cuxiao",
            "description_en": "Indicates whether a promotion is available",
            "description_zh": "是否有促销",
            "example": "true",
            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          },
          "Cycle": {
            "backendName": "result.cycle",
            "description_en": "Cycle unit\n\nDAY: Day\nMONTH: Month\nYEAR: Year",
            "description_zh": "周期单位\n\nDAY：日\nMONTH：月\nYEAR：年",
            "example": "MONTH",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "DiscountPrice": {
            "backendName": "result.discountPrice",
            "description_en": "Discount amount (original price minus trade price), in CNY",
            "description_zh": "优惠的价格（原价-实际价格），单位：元",
            "example": "178.20",
            "format": "float",
            "type": "number",
            "visibility": "Public"
          },
          "Duration": {
            "backendName": "result.duration",
            "description_en": "Number of cycles, such as 1, 2, 3",
            "description_zh": "周期数， 1，2，3",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "ExpressionCode": {
            "backendName": "result.expressionCode",
            "description_en": "Purchase restriction code",
            "description_zh": "限购编码",
            "example": "ORDER.NO_REAL_NAME_AUTHENTICATION",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "ExpressionMessage": {
            "backendName": "result.expressionMessage",
            "description_en": "Purchase restriction description",
            "description_zh": "限购描述",
            "example": "企业用户才能购买",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "InfoTitle": {
            "backendName": "result.infoTitle",
            "description_en": "Promotion name",
            "description_zh": "活动名称",
            "example": "新年特惠",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "OriginalPrice": {
            "backendName": "result.originalPrice",
            "description_en": "Original price, in CNY",
            "description_zh": "原价，单位：元",
            "example": "198.00",
            "format": "float",
            "type": "number",
            "visibility": "Public"
          },
          "ProductCode": {
            "backendName": "result.productCode",
            "description_en": "Product code",
            "description_zh": "商品 Code",
            "example": "cmgj01****",
            "type": "string",
            "visibility": "Public"
          },
          "PromotionRules": {
            "backendName": "result.promotionRules",
            "itemName": "PromotionRule",
            "items": {
              "properties": {
                "Name": {
                  "backendName": "name",
                  "type": "string",
                  "visibility": "Public"
                },
                "RuleId": {
                  "backendName": "ruleId",
                  "type": "string",
                  "visibility": "Public"
                },
                "Title": {
                  "backendName": "title",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "TradePrice": {
            "backendName": "result.tradePrice",
            "description_en": "Trade price (actual price), in CNY",
            "description_zh": "实际价格，单位：元",
            "example": "19.80",
            "format": "float",
            "type": "number",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
