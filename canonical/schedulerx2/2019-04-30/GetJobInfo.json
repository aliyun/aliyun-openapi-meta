{
  "camel_example": "aliyun schedulerx2 GetJobInfo --region cn-hangzhou --RegionId 'cn-hangzhou' --JobId 92583 --Namespace 'adcfc35d-e2fe-4fe9-bbaa-20e90ffc0000' --GroupId 'testSchedulerx.defaultGroup'",
  "cmd_full_name": "schedulerx2 get-job-info",
  "cmd_name": "get-job-info",
  "deprecated": false,
  "description_en": "Queries the details of a job based on the job ID. In most cases, the obtained information is used to update jobs",
  "description_zh": "获取指定Jobid任务详情，通常用来更新任务",
  "kebab_example": "aliyun schedulerx2 get-job-info --job-id 92583 --group-id testSchedulerx.defaultGroup --namespace adcfc35d-e2fe-4fe9-bbaa-20e90ffc0000 --biz-region-id cn-hangzhou --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetJobInfo",
  "operation": {
    "action": "GetJobInfo",
    "api_style": "RPC",
    "api_version": "2019-04-30",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
