      "name": "namespace_source",
      "options": [
        "--namespace-source"
      ],
      "raw_name": "NamespaceSource",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "cn-hangzhou",
      "help_en": "The region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "simpleJob",
      "help_en": "The job name",
      "help_zh": "任务名称",
      "location": "query",
      "name": "job_name",
      "options": [
        "--job-name"
      ],
      "raw_name": "JobName",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "schedulerx2",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The HTTP status code",
            "description_zh": "返回码",
            "example": "200",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The details of the job",
            "description_zh": "指定任务信息",
            "nullToEmpty": false,
            "properties": {
              "JobConfigInfo": {
                "backendName": "jobConfigInfo",
                "description_en": "The configurations of the job",
                "description_zh": "任务配置信息",
                "nullToEmpty": false,
                "properties": {
                  "AttemptInterval": {
                    "backendName": "attemptInterval",
                    "description_en": "The interval at which the system retried to run the job after a job failure. Default value: 30. Unit: seconds",
                    "description_zh": "错误重试间隔时间，单位s，默认值为30",
                    "example": "30",
                    "format": "int32",
                    "nullToEmpty": false,
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "ClassName": {
                    "backendName": "className",
                    "description_en": "The full path of the job interface class. This parameter is returned only for jobs whose job type is Java",
                    "description_zh": "任务接口类完整路径，仅是Java类型任务时有该字段",
                    "example": "com.alibaba.test.helloword",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Content": {
                    "backendName": "content",
                    "description_en": "The script of a script job",
                    "description_zh": "脚本类型任务的脚本",
                    "example": "echo \"clear\" > /home/admin/edas-container/logs/catalina.out ",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Description": {
                    "backendName": "description",
                    "description_en": "The description of the job",
                    "description_zh": "任务描述",
                    "example": "test",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "ExecuteMode": {
                    "backendName": "executeMode",
                    "description_en": "The execution mode of the job. Valid values:\n\nStand-alone operation: standalone\n\nBroadcast run: broadcast\n\nVisual MapReduce: parallel\n\nMapReduce: batch\n\nShard run: sharding",
                    "description_zh": "任务执行模式，目前包含以下几种任务执行模式：\n\n单机运行：standalone\n广播运行：broadcatst\n并行计算：parallel\n内存网格：grid\n网格计算：batch\n分片运行：shard",
                    "example": "standalone",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "JarUrl": {
                    "backendName": "jarUrl",
                    "description_en": "The full path used to upload files to Object Storage Service (OSS).\n\nIf you use a JAR package, you can upload the JAR package to this OSS path",
                    "description_zh": "上传到OSS的完整路径。\n\n如果选择JAR包运行，可以将相应JAR包上传到OSS的该路径下",
                    "example": "https://test.oss-cn-hangzhou.aliyuncs.com/schedulerX/test.jar",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "JobId": {
                    "backendName": "jobId",
                    "description_en": "The job ID",
                    "description_zh": "任务ID",
                    "example": "538039",
                    "format": "int64",
                    "type": "integer"
                  },
                  "JobMonitorInfo": {
                    "backendName": "jobMonitorInfo",
                    "description_en": "The monitoring information of the job",
                    "description_zh": "任务监控信息",
                    "nullToEmpty": false,
                    "properties": {
                      "ContactInfo": {
                        "backendName": "contactInfo",
                        "description_en": "The alert contact Information",
                        "description_zh": "联系人信息",
