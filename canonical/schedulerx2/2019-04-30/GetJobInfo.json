                    "description_zh": "高级配置，仅限于并行计算、内存网格和网格计算使用",
                    "nullToEmpty": false,
                    "properties": {
                      "ConsumerSize": {
                        "backendName": "consumerSize",
                        "description_en": "The number of threads that were triggered by a single worker at a time. Default value: 5",
