                        "example": "5",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "DispatcherSize": {
                        "backendName": "dispatcherSize",
                        "description_en": "The number of task distribution threads. Default value: 5",
                        "description_zh": "子任务分发线程数，默认值为5",
                        "example": "5",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "PageSize": {
                        "backendName": "pageSize",
                        "description_en": "The number of tasks that were pulled by a parallel job at a time. Default value: 100",
                        "description_zh": "并行任务单次拉取子任务数，默认值为100",
                        "example": "100",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "QueueSize": {
                        "backendName": "queueSize",
                        "description_en": "The maximum number of tasks that can be queued. Default value: 10000",
                        "description_zh": "子任务队列缓存上限，默认值为10000",
                        "example": "10000",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "TaskAttemptInterval": {
                        "backendName": "taskAttemptInterval",
                        "description_en": "The interval at which the system retried to run the task after a task failure",
                        "description_zh": "子任务失败重试间隔",
                        "example": "0",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "TaskMaxAttempt": {
                        "backendName": "taskMaxAttempt",
                        "description_en": "The number of retries after a task failure",
                        "description_zh": "子任务失败重试次数",
                        "example": "0",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      }
                    },
                    "type": "object",
                    "visibility": "Public"
                  },
                  "MaxAttempt": {
                    "backendName": "maxAttempt",
                    "description_en": "The maximum number of retries after a job failure. This parameter was specified based on your business requirements. Default value: 0",
                    "description_zh": "错误最大重试次数，根据业务需求填写，默认值为0",
                    "example": "0",
                    "format": "int32",
                    "nullToEmpty": false,
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "MaxConcurrency": {
                    "backendName": "maxConcurrency",
                    "description_en": "The maximum number of concurrent instances. Default value: 1. The default value indicates that if the last triggered instance is running, the next instance is not triggered even if the scheduled point in time for running the next instance is reached",
                    "description_zh": "最大同时运行实例数量，默认值为1， 即上次触发没有运行结束，即使到了运行时刻也不会进行下次触发",
                    "example": "1",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Name": {
                    "backendName": "name",
                    "description_en": "The job name",
                    "description_zh": "任务名称",
                    "example": "helloworld",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Parameters": {
                    "backendName": "parameters",
                    "description_en": "The user-defined parameters that you can obtain when the job is running",
                    "description_zh": "用户自定义参数，运行时可以获取",
                    "example": "test",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Status": {
                    "backendName": "status",
                    "description_en": "Indicates whether the job was enabled. Valid values:\n\n1: The job was enabled and could be triggered.\n\n0: The job was disabled and could not be triggered",
                    "description_zh": "任务状态。取值如下：\n\n1：启用，可以被正常触发。\n0：禁用，不会被触发",
                    "example": "1",
                    "format": "int32",
                    "nullToEmpty": false,
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "TimeConfig": {
                    "backendName": "timeConfig",
                    "description_en": "The time configurations",
                    "description_zh": "时间配置信息",
                    "nullToEmpty": false,
                    "properties": {
                      "Calendar": {
                        "backendName": "calendar",
                        "description_en": "Custom calendar days specified if TimeType is set to 1 (cron)",
                        "description_zh": "cron类型可以选择填写自定义日历",
                        "example": "workday",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "DataOffset": {
                        "backendName": "dataOffset",
                        "description_en": "The time offset specified if TimeType is set to 1 (cron). Unit: seconds",
                        "description_zh": "cron类型可以选择时间偏移，单位为秒（s）",
                        "example": "0",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "TimeExpression": {
                        "backendName": "timeExpression",
                        "description_en": "The time expression specified based on the value of TimeType:\n\nIf TimeType is set to 100 (api), no time expression is required.\n\nIf TimeType is set to 3 (fix_rate), this parameter value indicates the specific and fixed frequency. For example, if the value is 30, the system triggers a job every 30 seconds.\n\nIf TimeType is set to 1 (cron), this parameter value indicates the standard CRON expression used to specify the time when to schedule the job.\n\nIf TimeType is set to 4 (second_delay), this parameter value indicates the fixed delay after which the job is triggered. Valid values: 1 to 60. Unit: seconds",
                        "description_zh": "时间表达式，目前支持以下几种时间表达类型：\n\napi：无时间表达式。\nfix_rate：具体固定频率值，如30表示每隔30s触发一次。\ncron：标准的cron表达式。\nsecond_delay：固定延迟多少秒执行一次（1s~60s可选）",
                        "example": "0 0/10 * * * ?",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "TimeType": {
                        "backendName": "timeType",
                        "description_en": "The time type. Valid values:\n\n1: cron\n\n3: fix_rate\n\n4: second_delay\n\n5: one_time\n\n100: api",
                        "description_zh": "时间配置类型，目前支持以下几种时间类型：\n\ncron：1\nfix_rate：3\nsecond_delay：4\none_time ：5\napi：100",
                        "example": "1",
                        "format": "int32",
                        "nullToEmpty": false,
                        "type": "integer",
                        "visibility": "Public"
                      }
                    },
                    "type": "object",
                    "visibility": "Public"
                  },
                  "XAttrs": {
                    "backendName": "xAttrs",
                    "description_en": "The extended fields",
                    "description_zh": "任务扩展字段",
                    "example": "{\"pageSize\":5,\"queueSize\":10,\"consumerSize\":5,\"dispatcherSize\":5,\"taskMaxAttempt\":0,\"taskAttemptInterval\":0,\"globalConsumerSize\":1000,\"taskDispatchMode\":\"push\"}",
                    "type": "string"
                  }
                },
                "type": "object",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The error message returned only if an error occurs",
