      "help_en": "The application ID. You can obtain the application ID on the Application Management page in the SchedulerX console",
      "help_zh": "应用ID，在控制台的应用管理页面中获取",
      "location": "query",
      "name": "group_id",
      "options": [
        "--group-id"
      ],
      "raw_name": "GroupId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "adcfc35d-e2fe-4fe9-bbaa-20e90ffc****",
      "help_en": "The namespace ID. You can obtain the namespace ID on the Namespace page in the SchedulerX console",
      "help_zh": "命名空间ID，在控制台的命名空间页面中获取",
      "location": "query",
      "name": "namespace",
      "options": [
        "--namespace"
      ],
      "raw_name": "Namespace",
      "required": true,
      "type": "string"
    },
    {
      "example": "schedulerx",
