                              "example": "https://oapi.dingtalk.com/robot/send?access_token=XXXXXX",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            },
                            "UserMail": {
                              "backendName": "userMail",
                              "description_en": "The email address of the alert contact",
                              "description_zh": "用户邮件地址",
                              "example": "user@demo.com",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            },
                            "UserName": {
                              "backendName": "userName",
                              "description_en": "The name of the alert contact",
                              "description_zh": "用户名",
                              "example": "userA",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            },
                            "UserPhone": {
                              "backendName": "userPhone",
                              "description_en": "The mobile phone number of the alert contact",
                              "description_zh": "用户手机号",
                              "example": "1381111****",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            }
                          },
                          "type": "object"
                        },
                        "nullToEmpty": false,
                        "type": "array",
                        "visibility": "Public"
                      },
                      "MonitorConfig": {
                        "backendName": "monitorConfig",
                        "description_en": "The configurations of the alerting features and the alert thresholds",
                        "description_zh": "报警开关以及阈值配置",
                        "nullToEmpty": false,
                        "properties": {
                          "FailEnable": {
                            "backendName": "failEnable",
                            "description_en": "Indicates whether the Failure alarm switch was turned on. Valid values:\n\ntrue\n\nfalse",
                            "description_zh": "失败报警开关。取值如下：\n\ntrue：开启失败报警开关。\nfalse：关闭失败报警开关",
                            "example": "true",
                            "nullToEmpty": false,
                            "type": "boolean",
                            "visibility": "Public"
                          },
                          "MissWorkerEnable": {
                            "backendName": "missWorkerEnable",
                            "description_en": "Indicates whether the No machine alarm available switch was turned on",
                            "description_zh": "是否开启无可用机器报警",
                            "example": "true",
                            "nullToEmpty": false,
                            "type": "boolean",
                            "visibility": "Public"
                          },
                          "SendChannel": {
                            "backendName": "sendChannel",
                            "description_en": "The method used to send alerts. Only Short Message Service (SMS) is supported",
                            "description_zh": "报警发送形式，目前只支持sms",
                            "example": "sms",
                            "nullToEmpty": false,
                            "type": "string",
                            "visibility": "Public"
                          },
                          "Timeout": {
                            "backendName": "timeout",
                            "description_en": "The timeout threshold. Default value: 7200. Unit: seconds",
                            "description_zh": "超时阈值，单位为秒（s），默认值为7200",
                            "example": "12300",
                            "format": "int64",
                            "nullToEmpty": false,
                            "type": "integer",
                            "visibility": "Public"
                          },
                          "TimeoutEnable": {
                            "backendName": "timeoutEnable",
                            "description_en": "Indicates whether the Timeout alarm switch was turned on. Valid values:\n\ntrue\n\nfalse",
                            "description_zh": "超时报警开关。取值如下：\n\ntrue：开启超时报警开关。\nfalse：关闭超时报警开关",
                            "example": "true",
                            "nullToEmpty": false,
                            "type": "boolean",
                            "visibility": "Public"
                          },
                          "TimeoutKillEnable": {
                            "backendName": "timeoutKillEnable",
                            "description_en": "Indicates whether the Timeout termination switch was turned on. The switch is turned off by default",
                            "description_zh": "超时终止本次触发开关，默认关闭",
                            "example": "true",
                            "nullToEmpty": false,
                            "type": "boolean",
                            "visibility": "Public"
                          }
                        },
                        "type": "object",
                        "visibility": "Public"
                      }
                    },
                    "type": "object",
                    "visibility": "Public"
                  },
                  "JobType": {
                    "backendName": "jobType",
                    "description_en": "The job type",
                    "description_zh": "任务类型",
