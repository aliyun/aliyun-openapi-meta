            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求唯一ID",
            "example": "4F68ABED-AC31-4412-9297-D9A8F0401108",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the job details were obtained. Valid values:\n\ntrue\n\nfalse",
            "description_zh": "获取任务详情是否成功。取值如下：\n\ntrue：获取任务详情成功。\nfalse：获取任务详情失败",
            "example": "true",
            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
