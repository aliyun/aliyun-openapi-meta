{
  "camel_example": "aliyun r-kvstore DescribePrice --region cn-hangzhou --OrderType BUY --RegionId 'cn-hangzhou'",
  "cmd_full_name": "r-kvstore describe-price",
  "cmd_name": "describe-price",
  "deprecated": false,
  "description_en": "Queries the fees generated by operations such as creating a Tair (Redis® OSS-Compatible) database instance, upgrading the instance configuration, or renewing the instance",
  "description_zh": "查询创建、升级配置或续费云数据库 Tair（兼容 Redis）实例等操作产生的费用",
  "kebab_example": "aliyun r-kvstore describe-price --biz-region-id cn-hangzhou --order-type BUY --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribePrice",
  "operation": {
    "action": "DescribePrice",
    "api_style": "RPC",
    "api_version": "2015-01-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cn-hangzhou",
      "help_en": "The region ID. You can call https://help.aliyun.com/document_detail/473763.html to query available regions",
      "help_zh": "地域ID，可调用https://help.aliyun.com/document_detail/473763.html查询",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "1024",
      "help_en": "The storage capacity used to specify the instance type, in MB. This parameter is used only to query Redis Community Edition instances in classic deployment mode. We recommend that you use the InstanceClass parameter to specify an exact instance type.\nAfter you specify the InstanceClass parameter, you do not need to specify this parameter",
      "help_zh": "使用实例的存储容量指定规格，单位为MB。本参数仅查询Redis开源版经典部署模式的实例，推荐您使用InstanceClass参数精确地指定一个规格。\n指定InstanceClass参数后，无需再指定本参数",
      "location": "query",
      "name": "capacity",
      "options": [
        "--capacity"
      ],
      "raw_name": "Capacity",
      "required": false,
      "type": "int"
    },
    {
      "example": "redis.master.small.default",
      "help_en": "The instance type specified by using the InstanceClass code. To find the InstanceClass code:\nIn the https://help.aliyun.com/document_detail/26350.html, select the desired instance type and click the value in the Architecture column to open the specification document.\nIn the instance type table of the specification document, find the desired instance type and locate the code in the InstanceClass column.\n\nThe following example describes the parameters required for querying the price of a new instance. In addition to other key parameters, specify at least the following parameters:\nClassic Edition instance: specify this parameter.\nCloud-native Edition standard architecture instance: specify this parameter.\nCloud-native Edition cluster architecture instance: specify this parameter and the ShardCount parameter.\nCloud-native Edition read/write splitting architecture instance: specify this parameter and the Instances parameter.\nMultiple instances of different types, or Tair ESSD-based instances (custom storage type and storage capacity): specify the Instances parameter (this parameter is not required)",
      "help_zh": "使用InstanceClass编码指定实例规格。InstanceClass查询步骤：\n在https://help.aliyun.com/document_detail/26350.html中，根据需要选择实例类型，点击其**架构类型**列以打开规格文档。\n在规格文档的实例规格表中，选择需要的实例规格，并找到其InstanceClass列的编码。\n\n以查询新购场景为例，除其他关键参数以外，您至少需要传入如下参数：\n查询经典版实例：请传入本参数。\n查询云原生版标准架构实例：请传入本参数。\n查询云原生版集群架构实例：请传入本参数与ShardCount参数。\n查询云原生版读写分离架构实例：请传入本参数，并传入Instances参数。\n查询多个不同规格的实例，或需查询Tair ESSD型实例（自定义存储类型和存储空间）：请传入Instances参数（无需传入本参数）",
      "location": "query",
      "name": "instance_class",
      "options": [
        "--instance-class"
      ],
      "raw_name": "InstanceClass",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "enum": [
        "BUY",
        "UPGRADE",
        "DOWNGRADE",
        "RENEW",
        "CONVERT"
      ],
      "example": "BUY",
      "help_en": "The order type. Valid values:\nBUY: new purchase.\nUPGRADE: configuration change.\nRENEW: renewal.\nCONVERT: billing method conversion",
      "help_zh": "订单类型，取值：\nBUY：新购。\nUPGRADE：变更配置。\nRENEW：续费。\nCONVERT：转换付费类型",
      "location": "query",
      "name": "order_type",
      "options": [
        "--order-type"
      ],
      "raw_name": "OrderType",
      "required": true,
      "type": "string"
    },
    {
      "example": "cn-hangzhou-e",
      "help_en": "The zone ID. You can call https://help.aliyun.com/document_detail/473764.html to query available zones",
      "help_zh": "可用区ID，可调用https://help.aliyun.com/document_detail/473764.html查询",
      "location": "query",
      "name": "zone_id",
      "options": [
        "--zone-id"
      ],
      "raw_name": "ZoneId",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-hangzhou-g",
      "help_en": "The secondary zone ID. You can call https://help.aliyun.com/document_detail/473764.html to query available zones.\nThe value of this parameter must be different from the value of the ZoneId parameter",
      "help_zh": "备可用区ID，可调用https://help.aliyun.com/document_detail/473764.html接口查询。\n本参数和ZoneId参数传入的值不能相同",
      "location": "query",
      "name": "secondary_zone_id",
      "options": [
        "--secondary-zone-id"
      ],
      "raw_name": "SecondaryZoneId",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "PrePaid",
        "PostPaid"
      ],
      "example": "PostPaid",
      "help_en": "The billing method. Valid values:\nPostPaid (default): pay-as-you-go.\nPrePaid: subscription",
      "help_zh": "付费类型，取值：\nPostPaid（默认）：按量付费。\nPrePaid：包年包月",
      "location": "query",
      "name": "charge_type",
      "options": [
        "--charge-type"
      ],
      "raw_name": "ChargeType",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "STAND_ALONE",
        "MASTER_SLAVE"
      ],
      "example": "MASTER_SLAVE",
      "help_en": "The node type. Valid values:\nSTAND_ALONE: standalone (single replica).\nMASTER_SLAVE (default): high availability (dual replicas)",
      "help_zh": "节点类型，取值：\nSTAND_ALONE：单副本。\nMASTER_SLAVE（默认）：高可用（双副本）",
      "location": "query",
      "name": "node_type",
      "options": [
        "--node-type"
      ],
      "raw_name": "NodeType",
      "required": false,
      "type": "string"
    },
    {
      "example": "3",
      "help_en": "The subscription duration, in months. Valid values: 1 to 9, 12, 24, and 36",
      "help_zh": "包年包月时长，单位为月。取值范围：1~9、12、24、36",
      "location": "query",
      "name": "period",
      "options": [
        "--period"
      ],
      "raw_name": "Period",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The number of instances to purchase. Valid values: 1 to 30. Default value: 1",
      "help_zh": "购买实例的数量，取值范围：1~30，默认值为1",
      "location": "query",
      "name": "quantity",
      "options": [
        "--quantity"
      ],
      "raw_name": "Quantity",
      "required": false,
      "type": "int"
    },
    {
      "example": "r-bp1zxszhcgatnx****",
      "help_en": "The instance ID.\nThis parameter is required when OrderType is set to UPGRADE or RENEW",
      "help_zh": "实例ID。\n当OrderType为UPGRADE或RENEW时必传",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "[{\"RegionId\": \"cn-hangzhou\",\"ZoneId\": \"cn-hangzhou-b\",\"ShardClass\": \"tair.scm.with.proxy.standard.2m.8d\",\"ShardCount\": \"3\",\"Period\": \"1\",\"Quantity\": \"1\"}]",
      "help_en": "If you want to query the price of cloud-native read/write splitting architecture instances, Tair ESSD-based instances, or multiple instances of different types, specify this parameter. The value is a JSON-formatted string. For more information, see Additional description of the Instances parameter below",
      "help_zh": "当您需要查询云原生版读写分离架构、Tair ESSD型实例或多个不同规格的实例时，需要传入本参数，为JSON格式字符串，更多信息请参见下方的Instances参数补充说明",
      "location": "query",
      "name": "instances",
      "options": [
        "--instances"
      ],
      "raw_name": "Instances",
      "required": false,
      "type": "string"
    },
    {
      "example": "000000000000",
      "help_en": "The extended information such as the promotional event ID and business information",
      "help_zh": "活动ID、业务信息等扩展信息",
      "location": "query",
      "name": "business_info",
      "options": [
        "--business-info"
      ],
      "raw_name": "BusinessInfo",
      "required": false,
      "type": "string"
    },
    {
      "example": "youhuiquan_promotion_option_id_for_blank",
      "help_en": "The coupon code. Default value: youhuiquan_promotion_option_id_for_blank, which indicates that no coupon code is used",
      "help_zh": "优惠码，默认值：youhuiquan_promotion_option_id_for_blank，表示无优惠码",
      "location": "query",
      "name": "coupon_no",
      "options": [
        "--coupon-no"
      ],
      "raw_name": "CouponNo",
      "required": false,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to forcibly change the configuration. Valid values:\nfalse: yes.\ntrue (default): no",
      "help_zh": "是否强制变配，取值：\nfalse：是。\ntrue（默认）：否",
      "location": "query",
      "name": "force_upgrade",
      "options": [
        "--force-upgrade"
      ],
      "raw_name": "ForceUpgrade",
      "required": false,
      "type": "bool"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to return order parameters. Valid values:\nfalse (default): does not return order parameters.\ntrue: returns order parameters",
      "help_zh": "是否返回订单参数，可选值：\nfalse（默认）：不返回。\ntrue：返回",
      "location": "query",
      "name": "order_param_out",
      "options": [
        "--order-param-out"
      ],
      "raw_name": "OrderParamOut",
      "required": false,
      "type": "string"
    },
    {
      "example": "2",
      "help_en": "The number of data shard nodes in a cloud-native cluster instance",
      "help_zh": "云原生集群实例中的数据分片节点的数量",
      "location": "query",
      "name": "shard_count",
      "options": [
        "--shard-count"
      ],
      "raw_name": "ShardCount",
      "required": false,
      "type": "int"
    },
    {
      "example": "5.0",
      "help_en": "<props=\"china\">Database engine version of the Redis instance. Valid values: 2.8, 4.0, 5.0, and 6.0.</props>\n\n<props=\"intl\">Database engine version of the Redis instance. Valid values: 2.8, 4.0, and 5.0.</props>\n\n<props=\"partner\">Database engine version of the Redis instance. Valid values: 2.8, 4.0, and 5.0.</props>",
      "help_zh": "<props=\"china\">Redis实例的引擎版本，取值：2.8、4.0、5.0或6.0。</props>\n\n<props=\"intl\">Redis实例的引擎版本，取值：2.8、4.0或5.0。</props>\n\n<props=\"partner\">Redis实例的引擎版本，取值：2.8、4.0或5.0。</props>",
      "location": "query",
      "name": "engine_version",
      "options": [
        "--engine-version"
      ],
      "raw_name": "EngineVersion",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "R-kvstore",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
