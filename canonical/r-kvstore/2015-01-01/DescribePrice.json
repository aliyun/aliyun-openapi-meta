      "help_zh": "备可用区ID，可调用https://help.aliyun.com/document_detail/473764.html接口查询。\n本参数和ZoneId参数传入的值不能相同",
      "location": "query",
      "name": "secondary_zone_id",
      "options": [
        "--secondary-zone-id"
      ],
      "raw_name": "SecondaryZoneId",
      "required": false,
