      "raw_name": "CouponNo",
      "required": false,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to forcefully change the configurations of the instance. Valid values:\n\nfalse: forcefully changes the configurations.\ntrue (default): does not forcefully change the configurations",
      "help_zh": "是否强制变配，取值：\nfalse：是。\ntrue（默认）：否",
