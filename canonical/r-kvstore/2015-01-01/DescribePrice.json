      "name": "node_type",
      "options": [
        "--node-type"
      ],
      "raw_name": "NodeType",
      "required": false,
      "type": "string"
    },
    {
      "example": "3",
      "help_en": "The subscription duration. Unit: month. Valid values: 1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 24, and 36",
      "help_zh": "包年包月时长，单位为月。取值范围：1~9、12、24、36",
