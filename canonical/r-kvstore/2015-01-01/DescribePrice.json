{
  "camel_example": "aliyun r-kvstore DescribePrice --region cn-hangzhou --OrderType BUY --RegionId 'cn-hangzhou'",
  "cmd_full_name": "r-kvstore describe-price",
  "cmd_name": "describe-price",
  "deprecated": false,
  "description_en": "Query the fees incurred by operations such as creation, configuration upgrade, or renewal of ApsaraDB for Tair (Redis OSS-compatible) instances",
