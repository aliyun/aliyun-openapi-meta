                  "example": "Manual",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Automated",
                        "value": "0"
                      },
                      {
                        "targetValue": "Manual",
                        "value": "1"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
