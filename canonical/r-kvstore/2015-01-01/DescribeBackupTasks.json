{
  "camel_example": "aliyun r-kvstore DescribeBackupTasks --region cn-hangzhou --InstanceId 'r-bp1zxszhcgatnx0000'",
  "cmd_full_name": "r-kvstore describe-backup-tasks",
  "cmd_name": "describe-backup-tasks",
  "deprecated": false,
  "description_en": "Queries the execution status of backup tasks for a Tair (Redis OSS-compatible) instance",
  "description_zh": "查询云数据库 Tair（兼容 Redis）实例的备份任务执行情况",
  "kebab_example": "aliyun r-kvstore describe-backup-tasks --instance-id r-bp1zxszhcgatnx0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeBackupTasks",
  "operation": {
    "action": "DescribeBackupTasks",
    "api_style": "RPC",
    "api_version": "2015-01-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "r-bp1zxszhcgatnx****",
      "help_en": "The instance ID. You can call the https://help.aliyun.com/document_detail/473778.html operation to query instance IDs",
      "help_zh": "实例ID，可调用https://help.aliyun.com/document_detail/473778.html接口获取",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "1162****",
      "help_en": "The ID of the backup task.\n\nIf you call the https://help.aliyun.com/document_detail/473819.html operation to perform a manual backup task, you can set this parameter to the returned backup ID to query the backup progress of the task",
      "help_zh": "备份任务ID。\n如果您调用https://help.aliyun.com/document_detail/473819.html执行了手动备份，您可以将返回的备份ID传入，用以查询备份的进度",
      "location": "query",
      "name": "backup_job_id",
      "options": [
        "--backup-job-id"
      ],
      "pattern": "^\\d+$",
      "raw_name": "BackupJobId",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "Manual",
        "Automated"
      ],
      "example": "Manual",
      "help_en": "The backup mode. Valid values:\n\nAutomated: automatic backup. You can call the https://help.aliyun.com/document_detail/473822.html operation to query the automatic backup policy.\nManual: manual backup.\n\nBy default, the information about backup tasks in both modes is returned",
      "help_zh": "备份模式，取值：\nAutomated：系统自动备份，您可以调用https://help.aliyun.com/document_detail/473822.html查询自动备份策略。\nManual：手动备份\n\n默认返回所有备份模式的任务信息",
      "location": "query",
      "name": "job_mode",
      "options": [
        "--job-mode"
      ],
      "raw_name": "JobMode",
      "required": false,
      "type": "string"
    }
  ],
