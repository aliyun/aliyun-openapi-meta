      "name": "node_id",
      "options": [
        "--node-id"
      ],
      "raw_name": "NodeId",
      "required": false,
      "type": "string"
    },
    {
      "example": "demo",
      "help_en": "The name of the account. If you do not specify this parameter, the audit logs of all accounts are queried",
