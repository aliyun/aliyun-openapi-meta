{
  "camel_example": "aliyun r-kvstore DescribeAuditRecords --region cn-hangzhou --EndTime '2019-03-25T12:10:00Z' --InstanceId 'r-bp1zxszhcgatnx0000' --StartTime '2019-03-24T12:10:00Z'",
  "cmd_full_name": "r-kvstore describe-audit-records",
