            "example": "02260F96-913E-4655-9BA5-A3651CAF****",
            "type": "string",
            "visibility": "Public"
          },
          "SSLEnabled": {
            "backendName": "data.sslEnabled",
            "description_en": "The status of the TLS (SSL) encryption feature. Valid values:\n\nEnable: SSL encryption is enabled.\nDisable: SSL encryption is disabled",
            "description_zh": "TLS（SSL）加密功能的状态：\nEnable：已开启。\nDisable：未开启",
