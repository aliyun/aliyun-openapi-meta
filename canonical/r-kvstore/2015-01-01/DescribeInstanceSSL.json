  "kebab_example": "aliyun r-kvstore describe-instance-ssl --instance-id r-bp1zxszhcgatnx0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeInstanceSSL",
  "operation": {
    "action": "DescribeInstanceSSL",
    "api_style": "RPC",
    "api_version": "2015-01-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "r-bp1zxszhcgatnx****",
      "help_en": "The ID of the instance",
      "help_zh": "实例 ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    }
