      "schema": {
        "properties": {
          "CertCommonName": {
            "backendName": "data.certCommonName",
            "description_en": "The common name of the CA certificate. The default value is the internal endpoint of the instance",
            "description_zh": "CA证书的公共名，默认值为实例的内网连接地址",
            "example": "r-bp1zxszhcgatnx****.redis.rds.aliyuncs.com",
            "type": "string",
            "visibility": "Public"
          },
          "CertDownloadURL": {
            "backendName": "data.certDownloadUrl",
            "description_en": "The download URL of the CA certificate",
            "description_zh": "CA证书的下载链接",
            "example": "https://apsaradb-public.oss-ap-sout****-1.aliy****.com/ApsaraDB-CA-Chain.zip",
            "type": "string"
          },
          "InstanceId": {
            "backendName": "data.dbInstanceId",
            "description_en": "The ID of the instance",
