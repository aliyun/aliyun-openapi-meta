            "help_zh": "企业实体ID",
            "name": "ec_id",
            "options": [
              "--ec-id"
            ],
            "raw_name": "EcId",
            "required": false,
            "type": "string"
          }
        ],
        "type": "object"
      },
      "help_en": "The list of enterprises and accounts. If this parameter is left empty, the current account is queried",
      "help_zh": "企业与账号列表，为空表示查询当前账号自身",
      "location": "query",
      "name": "ec_id_account_ids",
      "options": [
        "--ec-id-account-ids"
      ],
      "param_style": "json",
      "raw_name": "EcIdAccountIds",
      "required": false,
      "type": "array"
    },
    {
      "example": "2684201000001",
      "help_en": "The level-1 marketplace ID. If this parameter is left empty, the marketplace ID of the current user is used by default",
      "help_zh": "一级售卖场ID，如果为空，默认使用当前用户所属的场ID填充",
      "location": "query",
      "name": "nbid",
      "options": [
        "--nbid"
      ],
      "raw_name": "Nbid",
      "required": false,
      "type": "string"
    }
  ],
