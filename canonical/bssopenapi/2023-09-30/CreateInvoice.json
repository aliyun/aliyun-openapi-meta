{
  "cmd_full_name": "bssopenapi create-invoice",
  "cmd_name": "create-invoice",
  "deprecated": false,
  "description_en": "Apply for Invoice",
  "description_zh": "申请发票",
  "kebab_example": "aliyun bssopenapi create-invoice --invoice-title-id 12345 --recipient-emails 1@1.com --invoice-candidate-ids 12345 --invoice-type 0 --invoice-mode 0 --api-version 2023-09-30 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "CreateInvoice",
  "operation": {
    "action": "CreateInvoice",
    "api_style": "RPC",
    "api_version": "2023-09-30",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "0.01",
      "help_en": "Specifies the invoice amount. Supports up to two decimal places.\nIf not specified, the invoice will be issued for the total invoiceable amount of all invoiceCandidateIds.\nIf specified, the invoice will be issued for the specified amount. The specified amount cannot exceed the total invoiceable amount of all invoiceCandidateIds",
      "help_zh": "指定开票金额。支持两位小数。\n若不填，则按照invoiceCandidateIds的全部总可开票金额开票。\n若填写，则按照填写的金额开票。填写金额不可超过invoiceCandidateIds的全部总可开票金额",
      "location": "query",
      "name": "amount",
      "options": [
        "--amount"
      ],
      "pattern": "^[\\d._-]+$",
      "raw_name": "Amount",
      "required": false,
      "type": "string"
    },
    {
      "example": "12345",
      "help_en": "Invoice title ID.\n\nThe ID parameter returned by the ListInvoiceTitle API for the current logged-in account",
      "help_zh": "发票抬头ID。\n\n当前登录账号通过 ListInvoiceTitle 接口返回的 ID 参数",
      "location": "query",
      "name": "invoice_title_id",
      "options": [
        "--invoice-title-id"
      ],
      "pattern": "^\\d+$",
      "raw_name": "InvoiceTitleId",
      "required": true,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "List of email addresses to receive the invoice. A maximum of 3 can be specified",
      "help_zh": "发票接收邮箱列表。最多可传入3个",
      "location": "query",
      "name": "recipient_emails",
      "options": [
        "--recipient-emails"
      ],
      "param_style": "json",
      "raw_name": "RecipientEmails",
      "required": true,
      "type": "array"
    },
    {
      "example": "备注信息",
      "help_en": "Invoice remark",
      "help_zh": "发票备注",
      "location": "query",
      "max_length": "200",
      "name": "invoice_remark",
      "options": [
        "--invoice-remark"
      ],
      "raw_name": "InvoiceRemark",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "List of invoice candidate IDs",
      "help_zh": "开票对象ID列表",
      "location": "query",
      "name": "invoice_candidate_ids",
      "options": [
        "--invoice-candidate-ids"
      ],
      "param_style": "json",
      "pattern": "^\\d+$",
      "raw_name": "InvoiceCandidateIds",
      "required": true,
      "type": "array"
    },
    {
      "enum": [
        "0",
        "1"
      ],
      "example": "0",
      "help_en": "Invoice type",
      "help_zh": "开票类型",
      "location": "query",
      "name": "invoice_type",
      "options": [
        "--invoice-type"
      ],
      "raw_name": "InvoiceType",
      "required": true,
      "type": "int"
    },
    {
      "enum": [
        "0",
        "1"
      ],
      "example": "0",
      "help_en": "Invoice mode.\n0: Independent invoicing. Expenses of multiple accounts under the enterprise are invoiced separately for each account.\n1: Consolidated invoicing. Expenses of multiple accounts under the enterprise are consolidated and invoiced under the invoicing entity.\nIf only one account is passed in the AccountIds parameter, independent invoicing is applied",
      "help_zh": "开票方式\n0：独立开票，企业下多个账号的消费按照各自账号分别独立开具\n1：合并开票，企业下多个账号的消费按照开票主体合并开具\n如果AccountIds入参仅传入一个账号，则按照独立开票开具",
      "location": "query",
      "name": "invoice_mode",
      "options": [
        "--invoice-mode"
      ],
      "raw_name": "InvoiceMode",
      "required": true,
      "type": "int"
    },
    {
      "element": {
        "fields": [
          {
            "element": {
              "type": "int"
            },
            "help_en": "List of accounts to access. If empty, all accounts under the current entity ID are selected",
            "help_zh": "访问的账号列表，为空代表全选当前实体ID下所有账号",
            "name": "account_ids",
            "options": [
              "--account-ids"
            ],
            "raw_name": "AccountIds",
            "required": false,
            "type": "array"
          },
          {
            "example": "12345",
            "help_en": "Enterprise entity ID",
            "help_zh": "企业实体ID",
            "name": "ec_id",
            "options": [
              "--ec-id"
            ],
            "raw_name": "EcId",
            "required": false,
            "type": "string"
          }
        ],
        "type": "object"
      },
      "help_en": "Enterprise and account list. If empty, the current account is queried",
      "help_zh": "企业与账号列表，为空表示查询当前账号自身",
      "location": "query",
      "name": "ec_id_account_ids",
      "options": [
        "--ec-id-account-ids"
      ],
      "param_style": "json",
      "raw_name": "EcIdAccountIds",
      "required": false,
      "type": "array"
    },
    {
      "example": "2684201000001",
      "help_en": "Primary marketplace ID. If empty, the marketplace ID of the current user is used by default",
      "help_zh": "一级售卖场ID，如果为空，默认使用当前用户所属的场ID填充",
      "location": "query",
      "name": "nbid",
      "options": [
        "--nbid"
      ],
      "raw_name": "Nbid",
      "required": false,
      "type": "string"
    }
  ],
