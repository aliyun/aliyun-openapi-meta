  "deprecated": false,
  "description_en": "Applies for an invoice",
  "description_zh": "申请发票",
  "kebab_example": "aliyun bssopenapi create-invoice --invoice-title-id 12345 --recipient-emails 1@1.com --invoice-candidate-ids 12345 --invoice-type 0 --invoice-mode 0 --api-version 2023-09-30 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "CreateInvoice",
  "operation": {
    "action": "CreateInvoice",
    "api_style": "RPC",
    "api_version": "2023-09-30",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "0.01",
      "help_en": "Specifies the invoice amount. Two decimal places are supported.\nIf left empty, the invoice is issued for the total invoiceable amount of all invoice candidate IDs.\nIf specified, the invoice is issued for the specified amount. The specified amount cannot exceed the total invoiceable amount of all invoice candidate IDs",
      "help_zh": "指定开票金额。支持两位小数。\n若不填，则按照invoiceCandidateIds的全部总可开票金额开票。\n若填写，则按照填写的金额开票。填写金额不可超过invoiceCandidateIds的全部总可开票金额",
      "location": "query",
      "name": "amount",
      "options": [
        "--amount"
      ],
      "pattern": "^[\\d._-]+$",
      "raw_name": "Amount",
      "required": false,
      "type": "string"
    },
    {
      "example": "12345",
      "help_en": "The invoice title ID.\n\nThe ID returned by the ListInvoiceTitle operation for the current logon account",
      "help_zh": "发票抬头ID。\n\n当前登录账号通过 ListInvoiceTitle 接口返回的 ID 参数",
      "location": "query",
      "name": "invoice_title_id",
      "options": [
        "--invoice-title-id"
      ],
      "pattern": "^\\d+$",
      "raw_name": "InvoiceTitleId",
      "required": true,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The list of email addresses that receive the invoice. You can specify up to three email addresses",
      "help_zh": "发票接收邮箱列表。最多可传入3个",
      "location": "query",
      "name": "recipient_emails",
      "options": [
        "--recipient-emails"
      ],
      "param_style": "json",
      "raw_name": "RecipientEmails",
      "required": true,
      "type": "array"
    },
    {
      "example": "备注信息",
      "help_en": "The invoice remark",
      "help_zh": "发票备注",
      "location": "query",
      "max_length": "200",
      "name": "invoice_remark",
      "options": [
        "--invoice-remark"
      ],
      "raw_name": "InvoiceRemark",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The list of invoice candidate IDs",
      "help_zh": "开票对象ID列表",
      "location": "query",
      "name": "invoice_candidate_ids",
      "options": [
        "--invoice-candidate-ids"
      ],
      "param_style": "json",
      "pattern": "^\\d+$",
      "raw_name": "InvoiceCandidateIds",
      "required": true,
      "type": "array"
    },
    {
      "enum": [
        "0",
        "1"
      ],
      "example": "0",
      "help_en": "The invoice type",
      "help_zh": "开票类型",
      "location": "query",
      "name": "invoice_type",
      "options": [
        "--invoice-type"
      ],
      "raw_name": "InvoiceType",
      "required": true,
      "type": "int"
    },
    {
      "enum": [
        "0",
        "1"
      ],
      "example": "0",
      "help_en": "The invoicing mode. Valid values:\n0: Independent invoicing. The consumption of multiple accounts under an enterprise is invoiced independently for each account.\n1: Consolidated invoicing. The consumption of multiple accounts under an enterprise is consolidated and invoiced based on the invoicing entity.\nIf only one account is specified in the AccountIds request parameter, independent invoicing is applied",
      "help_zh": "开票方式\n0：独立开票，企业下多个账号的消费按照各自账号分别独立开具\n1：合并开票，企业下多个账号的消费按照开票主体合并开具\n如果AccountIds入参仅传入一个账号，则按照独立开票开具",
      "location": "query",
      "name": "invoice_mode",
      "options": [
        "--invoice-mode"
      ],
      "raw_name": "InvoiceMode",
      "required": true,
      "type": "int"
    },
    {
      "element": {
        "fields": [
          {
            "element": {
              "type": "int"
            },
            "help_en": "The list of accounts to access. If this parameter is left empty, all accounts under the current entity ID are selected",
            "help_zh": "访问的账号列表，为空代表全选当前实体ID下所有账号",
            "name": "account_ids",
            "options": [
              "--account-ids"
            ],
            "raw_name": "AccountIds",
            "required": false,
            "type": "array"
          },
          {
            "example": "12345",
