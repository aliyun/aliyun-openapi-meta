{
  "camel_example": "aliyun oos ListActions --region cn-hangzhou --OOSActionName MyTemplate --NextToken 'example-string' --MaxResults 50 --RegionId 'cn-hangzhou'",
  "cmd_full_name": "oos list-actions",
  "cmd_name": "list-actions",
  "deprecated": false,
  "description_en": "Queries available actions, including atomic actions and cloud product actions",
  "description_zh": "查询可用动作，包括原子动作和云产品动作",
  "kebab_example": "aliyun oos list-actions --biz-region-id cn-hangzhou --oos-action-name MyTemplate --max-results 50 --next-token example-string --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ListActions",
  "operation": {
    "action": "ListActions",
    "api_style": "RPC",
    "api_version": "2019-06-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "MyTemplate",
      "help_en": "The action name. The name does not need to be an exact match. All actions whose names contain the specified value are returned",
      "help_zh": "动作名称。名称未包含关系，最终列出包含所填动作名称的所有动作",
      "location": "query",
      "name": "oos_action_name",
      "options": [
        "--oos-action-name"
      ],
      "raw_name": "OOSActionName",
      "required": false,
      "type": "string"
    },
    {
      "example": "50",
      "help_en": "The number of entries per page. Valid values: 10 to 100. Default value: 50",
      "help_zh": "分页大小。取值范围：10-100。默认为50",
      "location": "query",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "MaxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "-",
      "help_en": "The pagination token",
      "help_zh": "翻页标记的Token",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "NextToken",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "oos",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Actions": {
            "backendName": "Actions",
            "description_en": "The list of actions",
            "description_zh": "动作列表",
            "itemName": "Action",
            "items": {
              "properties": {
                "ActionType": {
                  "backendName": "ActionType",
                  "description_en": "The action type.\n\nAtomic actions\n    - Atomic.API\n    - Atomic.Trigger\n    - Atomic.Control\n    - Atomic.Embedded\nCloud product actions\n    - Product.ECS\n    - Product.RDS\n    - Product.VPC\n    - Product.FC\n    - …",
                  "description_zh": "动作类型。\n\n原子动作\n    - Atomic.API\n    - Atomic.Trigger\n    - Atomic.Control\n    - Atomic.Embedded\n云产品动作\n    - Product.ECS\n    - Product.RDS\n    - Product.VPC\n    - Product.FC\n    - …",
                  "example": "ACS::Template",
                  "type": "string",
                  "visibility": "Public"
                },
                "CreatedDate": {
                  "backendName": "CreatedDate",
                  "description_en": "The time when the action was created",
                  "description_zh": "动作创建时间",
                  "example": "2019-05-16T10:26:14Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "Description": {
                  "backendName": "Description",
                  "description_en": "The description of the action",
                  "description_zh": "动作说明",
                  "example": "ReplaceSystemDisk",
                  "type": "string",
                  "visibility": "Public"
                },
                "OOSActionName": {
                  "backendName": "ActionName",
                  "description_en": "The action name",
                  "description_zh": "动作名称",
                  "example": "ACS::ECS::ReplaceSystemDisk",
                  "type": "string",
                  "visibility": "Public"
                },
                "Popularity": {
                  "backendName": "Popularity",
                  "description_en": "The popularity of the action",
                  "description_zh": "使用热度",
                  "example": "5",
                  "format": "int32",
                  "type": "integer",
                  "visibility": "Public"
                },
                "Properties": {
                  "backendName": "Properties",
                  "description_en": "The action parameters",
                  "description_zh": "动作参数",
                  "example": "{ \"ImageId\": { \"Description\": \"The mirror ID you will use when resetting the system\", \"Type\": \"String\" }, \"InstanceId\": { \"Description\": \"the instance id that you will handle .\", \"Type\": \"String\" } }",
                  "type": "string",
                  "visibility": "Public"
                },
                "TemplateVersion": {
                  "backendName": "TemplateVersion",
                  "description_en": "The template version that corresponds to the action.\n\nThis field is not returned for atomic actions",
                  "description_zh": "动作所对应的模板版本。\n\n对于原子动作，该字段不返回",
                  "example": "v1",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "MaxResults": {
            "backendName": "MaxResults",
            "description_en": "The number of entries per page",
            "description_zh": "分页大小",
            "example": "50",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "NextToken": {
            "backendName": "NextToken",
            "description_en": "The pagination token",
            "description_zh": "翻页标记的Token",
            "example": "xxx",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "F9154C02-F847-4563-BB6A-6DD01A4F0",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
