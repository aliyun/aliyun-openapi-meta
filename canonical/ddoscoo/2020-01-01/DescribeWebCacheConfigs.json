  "kebab_example": "aliyun ddoscoo describe-web-cache-configs --domains www.aliyundoc.com --api-version 2020-01-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribeWebCacheConfigs",
  "operation": {
    "action": "DescribeWebCacheConfigs",
    "api_style": "RPC",
    "api_version": "2020-01-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "rg-acfm2pz25js****",
      "help_en": "The ID of the resource group to which the instance belongs in Resource Management.\n\nIf you do not configure this parameter, the instance belongs to the default resource group",
      "help_zh": "DDoS高防实例在资源管理服务中所属的资源组ID。\n\n不设置该参数表示默认资源组",
      "location": "query",
      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "example": "www.aliyun.com",
      "help_en": "An array consisting of domain names for which you want to query the Static Page Caching configurations",
      "help_zh": "要查询静态页面缓配置的域名列表",
      "location": "query",
      "name": "domains",
      "options": [
        "--domains"
      ],
      "param_style": "repeatList",
      "raw_name": "Domains",
      "required": true,
      "type": "array"
    }
  ],
  "pathPattern": "",
  "product_code": "ddoscoo",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "DomainCacheConfigs": {
            "backendName": "data",
            "description_en": "An array that consists of Static Page Caching configurations",
            "description_zh": "静态页面缓存的配置信息",
            "itemName": "CacheConfig",
            "items": {
              "properties": {
                "CustomRules": {
                  "backendName": "rules",
                  "description_en": "An array that consists of custom caching rules",
                  "description_zh": "自定义缓存规则配置",
                  "itemName": "CustomRule",
                  "items": {
                    "properties": {
                      "CacheTtl": {
                        "backendName": "cache_ttl",
                        "description_en": "The expiration time of the page cache. Unit: seconds",
                        "description_zh": "页面缓存的过期时间。单位：秒",
                        "example": "86400",
                        "format": "int64",
                        "type": "integer"
                      },
                      "Mode": {
                        "backendName": "mode",
                        "description_en": "The cache mode. Valid values:\n\nstandard: The standard cache mode is used.\naggressive: The enhanced cache mode is used.\nbypass: No data is cached",
                        "description_zh": "缓存模式。取值：\nstandard：表示标准模式。\naggressive：表示强力模式。\nbypass：表示不缓存",
                        "example": "standard",
                        "type": "string"
                      },
                      "Name": {
                        "backendName": "name",
                        "description_en": "The name of the rule",
                        "description_zh": "规则名称",
                        "example": "c1",
                        "type": "string"
                      },
                      "Uri": {
                        "backendName": "uri",
                        "description_en": "The path to the cached page",
                        "description_zh": "缓存页面的路径",
                        "example": "/blog/",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array"
                },
                "Domain": {
                  "backendName": "domain",
                  "description_en": "The domain name of the website",
                  "description_zh": "网站域名",
                  "example": "www.aliyundoc.com",
                  "type": "string"
                },
                "Enable": {
                  "backendName": "enable",
                  "description_en": "The status of the Static Page Caching policy. Valid values:\n\n1: enabled\n0: disabled",
                  "description_zh": "开关状态。取值：\n1：表示开启。\n0：表示关闭",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "Mode": {
                  "backendName": "mode",
                  "description_en": "The cache mode. Valid values:\n\nstandard: The standard cache mode is used.\naggressive: The enhanced cache mode is used.\nbypass: No data is cached",
                  "description_zh": "缓存模式。取值：\nstandard：表示标准模式。\naggressive：表示强力模式。\nbypass：表示不缓存",
                  "example": "bypass",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "本次请求的ID",
            "example": "6623EA1F-30FB-5BC8-BEC9-74D55F6F08F1",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
