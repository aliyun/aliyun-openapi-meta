{
  "camel_example": "aliyun ddoscoo DescribeWebCacheConfigs --region cn-hangzhou --Domains.1 'www.aliyundoc.com'",
  "cmd_full_name": "ddoscoo describe-web-cache-configs",
  "cmd_name": "describe-web-cache-configs",
  "deprecated": false,
