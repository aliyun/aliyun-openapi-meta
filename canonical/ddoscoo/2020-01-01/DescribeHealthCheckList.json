{
  "camel_example": "aliyun ddoscoo DescribeHealthCheckList --region cn-hangzhou --NetworkRules 'InstanceId_:_ddoscoo-cn-mp91j1ao0000_,_Protocol_:_tcp_,_FrontendPort_:8080'",
  "cmd_full_name": "ddoscoo describe-health-check-list",
  "cmd_name": "describe-health-check-list",
  "deprecated": false,
  "description_en": "Queries the Layer 4 or Layer 7 health check configurations of a port forwarding rule",
  "description_zh": "查询端口转发规则的健康检查配置（四层或七层）",
  "kebab_example": "aliyun ddoscoo describe-health-check-list --network-rules InstanceId_:_ddoscoo-cn-mp91j1ao0000_,_Protocol_:_tcp_,_FrontendPort_:8080 --api-version 2020-01-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribeHealthCheckList",
  "operation": {
    "action": "DescribeHealthCheckList",
    "api_style": "RPC",
    "api_version": "2020-01-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "[{\"InstanceId\":\"ddoscoo-cn-mp91j1ao****\",\"Protocol\":\"tcp\",\"FrontendPort\":8080}]",
      "help_en": "The information about the port forwarding rule. This parameter is a JSON string. The string contains the following fields:\n\nInstanceId: the ID of the instance. This field is required and must be of the STRING type.\n\nProtocol: the forwarding protocol. This field is required and must be of the STRING type. Valid values: tcp and udp.\n\nFrontendPort: the forwarding port. This field is required and must be of the INTEGER type",
      "help_zh": "要查询的端口转发规则，使用JSON格式的字符串表述，具体结构如下。\nInstanceId：String类型，必选，DDoS高防实例ID。\nProtocol：String类型，必选，转发协议类型。取值：tcp、udp。\nFrontendPort：Integer类型，必选，转发端口",
      "location": "query",
      "name": "network_rules",
      "options": [
        "--network-rules"
      ],
      "raw_name": "NetworkRules",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ddoscoo",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "HealthCheckList": {
            "backendName": "data",
            "description_en": "An array that consists of information about the health check configuration",
            "description_zh": "健康检查配置列表",
            "itemName": "HealthCheckItem",
            "items": {
              "properties": {
                "FrontendPort": {
                  "backendName": "frontend_port",
                  "description_en": "The forwarding port",
                  "description_zh": "转发端口",
                  "example": "8080",
                  "format": "int32",
                  "type": "integer"
                },
                "HealthCheck": {
                  "backendName": "health_check",
                  "description_en": "The health check configuration",
                  "description_zh": "健康检查配置信息",
                  "properties": {
                    "Domain": {
                      "backendName": "domain",
                      "description_en": "The domain name.\n\nThis parameter is returned only when the Layer 7 health check configuration is queried",
                      "description_zh": "域名。\n\n仅适用于七层健康检查",
                      "example": "www.aliyun.com",
                      "type": "string"
                    },
                    "Down": {
                      "backendName": "down",
                      "description_en": "The number of consecutive failed health checks that must occur before a port is declared unhealthy. Valid values: 1 to 10",
                      "description_zh": "不健康阈值。取值范围：1~10",
                      "example": "3",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Interval": {
                      "backendName": "interval",
                      "description_en": "The interval at which checks are performed. Valid values: 1 to 30. Unit: seconds",
                      "description_zh": "检查间隔。取值范围：1~30，单位：秒",
                      "example": "15",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Port": {
                      "backendName": "port",
                      "description_en": "The port that was checked",
                      "description_zh": "检查端口",
                      "example": "8080",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Timeout": {
                      "backendName": "timeout",
                      "description_en": "The response timeout period. Valid values: 1 to 30. Unit: seconds",
                      "description_zh": "响应超时时间。取值范围：1~30，单位：秒",
                      "example": "5",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Type": {
                      "backendName": "type",
                      "description_en": "The type of the protocol. Valid values:\n\ntcp: The Layer 4 health check configuration was queried.\n\nhttp: The Layer 7 health check configuration was queried",
                      "description_zh": "协议类型。取值：\ntcp：四层\nhttp：七层",
                      "example": "tcp",
                      "type": "string"
                    },
                    "Up": {
                      "backendName": "up",
                      "description_en": "The number of consecutive successful health checks that must occur before a port is declared healthy. Valid values: 1 to 10",
                      "description_zh": "健康阈值。取值范围：1~10",
                      "example": "3",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Uri": {
                      "backendName": "uri",
                      "description_en": "The check path.\n\nThis parameter is returned only when the Layer 7 health check configuration is queried",
                      "description_zh": "检查路径。\n\n仅适用于七层健康检查",
                      "example": "/abc",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "InstanceId": {
                  "backendName": "instanceId",
                  "description_en": "The ID of the instance",
                  "description_zh": "DDoS高防实例ID",
                  "example": "ddoscoo-cn-mp91j1ao****",
                  "type": "string"
                },
                "Protocol": {
                  "backendName": "protocol",
                  "description_en": "The forwarding protocol. Valid values:\n\ntcp\n\nudp",
                  "description_zh": "转发协议。取值：\ntcp\nudp",
                  "example": "tcp",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "本次请求的ID",
            "example": "83B4AF42-E8EE-4DC9-BD73-87B7733A36F9",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
