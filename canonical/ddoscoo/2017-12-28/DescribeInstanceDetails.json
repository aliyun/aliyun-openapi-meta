{
  "cmd_full_name": "ddoscoo describe-instance-details",
  "cmd_name": "describe-instance-details",
  "deprecated": false,
  "description_en": "Queries the details of a specified Anti-DDoS Pro or Anti-DDoS Premium instance",
  "description_zh": "调用DescribeInstanceDetails查询指定实例的详情信息",
  "kebab_example": "aliyun ddoscoo describe-instance-details --instance-ids ddoscoo-cn-XXXX1_,_ddoscoo-cn-XXXX2 --api-version 2017-12-28 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribeInstanceDetails",
  "operation": {
    "action": "DescribeInstanceDetails",
    "api_style": "RPC",
    "api_version": "2017-12-28",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "1.1.1.1",
      "help_en": "The source IP address of the request. You do not need to specify this parameter. The system automatically obtains the value",
      "help_zh": "请求源IP。无需填写，系统自动获取",
      "location": "query",
      "name": "source_ip",
      "options": [
        "--source-ip"
      ],
      "raw_name": "SourceIp",
      "required": false,
      "type": "string"
    },
    {
      "example": "[\"ddoscoo-cn-XXXX1\", \"ddoscoo-cn-XXXX2\"]",
      "help_en": "The IDs of the instances to query. Specify a JSON array of instance IDs. Exact match is supported. Example: `[\"ddoscoo-cn-XXXX1\", \"ddoscoo-cn-XXXX2\"]`",
      "help_zh": "通过实例Id查询实例信息，传入要查询的实例Id数组（JSON字符串）。支持精确匹配。例如，`[\"ddoscoo-cn-XXXX1\", \"ddoscoo-cn-XXXX2\"]`",
      "location": "query",
      "name": "instance_ids",
      "options": [
        "--instance-ids"
      ],
      "raw_name": "InstanceIds",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ddoscoo",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "InstanceDetails": {
            "backendName": "data",
            "description_en": "The details of the instances",
            "description_zh": "实例详情列表",
            "itemName": "InstanceDetail",
            "items": {
              "properties": {
                "EipInfoList": {
                  "backendName": "eips_status",
                  "description_en": "The information about the elastic IP addresses (EIPs) associated with the instance",
                  "description_zh": "与该实例绑定的EIP信息列表",
                  "itemName": "EipInfo",
                  "items": {
                    "properties": {
                      "Eip": {
                        "backendName": "eip",
                        "description_en": "The EIP address",
                        "description_zh": "EIP值",
                        "example": "1.1.1.1",
                        "type": "string"
                      },
                      "Status": {
                        "backendName": "status",
                        "description_en": "The status of the EIP. Valid values:\n\nnormal: Normal.\ncleaning: Cleaning.\nblackhole: Black Hole Activated",
                        "description_zh": "EIP状态，取值：\n\nnormal：正常\ncleaning：清洗中\nblackhole：黑洞中",
                        "example": "normal",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array"
                },
                "InstanceId": {
                  "backendName": "instanceId",
                  "description_en": "The instance ID",
                  "description_zh": "实例ID",
                  "example": "ddoscoo-cn-XXXXX",
                  "type": "string"
                },
                "Line": {
                  "backendName": "line",
                  "description_en": "The line of the instance. Example: coop-line-001",
                  "description_zh": "实例线路。例如，coop-line-001。 ",
                  "example": "coop-line-001",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "本次请求的ID",
            "example": "CF33B4C3-196E-4015-AADD-5CAD00057B80",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
