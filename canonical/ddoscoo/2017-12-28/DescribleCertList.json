                  "type": "string"
                },
                "DomainRelated": {
                  "backendName": "domainRelated",
                  "description_en": "Indicates whether the certificate is associated with a domain name configuration",
                  "description_zh": "是否已绑定域名配置",
                  "example": "false",
                  "type": "boolean"
                },
                "EndDate": {
                  "backendName": "endDate",
                  "description_en": "The expiration date of the certificate",
                  "description_zh": "证书到期日期",
                  "example": "2020-09-23",
                  "type": "string"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "The certificate ID",
                  "description_zh": "证书ID",
                  "example": "123",
