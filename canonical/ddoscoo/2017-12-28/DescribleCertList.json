      "options": [
        "--domain"
      ],
      "raw_name": "Domain",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The list of domain names",
      "help_zh": "域名列表",
      "location": "query",
      "name": "domain_list",
      "options": [
        "--domain-list"
      ],
      "param_style": "repeatList",
      "raw_name": "DomainList",
