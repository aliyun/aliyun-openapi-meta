                  "description_en": "The certificate name",
                  "description_zh": "证书名称",
                  "example": "testCertName",
                  "type": "string"
                },
                "StartDate": {
                  "backendName": "startDate",
                  "description_en": "The start date of the certificate",
                  "description_zh": "证书开始日期",
                  "example": "2019-09-24",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "本次请求的ID",
            "example": "CF33B4C3-196E-4015-AADD-5CAD00057B80",
            "type": "string"
          }
        },
        "type": "object"
