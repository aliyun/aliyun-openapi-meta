{
  "camel_example": "aliyun aiworkspace GET /api/v1/workspaces/123/members --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "aiworkspace list-members",
  "cmd_name": "list-members",
  "deprecated": false,
  "description_en": "Lists members in a workspace",
  "description_zh": "获取工作空间的成员列表",
  "kebab_example": "aliyun aiworkspace list-members --workspace-id 123 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListMembers",
  "operation": {
    "action": "ListMembers",
    "api_style": "ROA",
    "api_version": "2021-02-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/api/v1/workspaces/{WorkspaceId}/members"
  },
  "parameters": [
    {
      "example": "123",
      "help_en": "Workspace ID. You can call https://help.aliyun.com/document_detail/449124.html to obtain the workspace ID",
      "help_zh": "工作空间ID。如何获取工作空间ID，请参见https://help.aliyun.com/document_detail/449124.html",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "WorkspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "Page number. Pages start at 1. Default value: 1",
      "help_zh": "工作空间列表的页码。起始值为1，默认为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "20",
      "help_en": "Number of entries per page. Default value: 20",
      "help_zh": "分页查询时设置的每页行数。默认为20",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "PAI.AlgoDeveloper",
      "help_en": "Roles used to filter members. Separate multiple roles with commas (,). Valid values:\n\nPAI.AlgoDeveloper: Algorithm developer\n\nPAI.AlgoOperator: Algorithm O\\&M engineer\n\nPAI.LabelManager: Annotation administrator\n\nPAI.MaxComputeDeveloper: MaxCompute developer\n\nPAI.WorkspaceAdmin: Workspace administrator\n\nPAI.WorkspaceGuest: Guest\n\nPAI.WorkspaceOwner: Workspace owner",
      "help_zh": "使用角色过滤成员，多个角色以半角逗号（,）分隔。\n支持以下角色名：\nPAI.AlgoDeveloper：算法开发。\nPAI.AlgoOperator：算法运维。\nPAI.LabelManager：标注管理员。\nPAI.MaxComputeDeveloper：MaxCompute开发。\nPAI.WorkspaceAdmin：管理员。\nPAI.WorkspaceGuest：访客。\nPAI.WorkspaceOwner：负责人",
      "location": "query",
      "name": "roles",
      "options": [
        "--roles"
      ],
      "raw_name": "Roles",
      "required": false,
      "type": "string"
    },
    {
      "example": "zhangsan",
      "help_en": "Username. Fuzzy match is supported",
      "help_zh": "成员名，支持模糊匹配",
      "location": "query",
      "name": "member_name",
      "options": [
        "--member-name"
      ],
      "raw_name": "MemberName",
      "required": false,
      "type": "string"
    },
    {
      "example": "2788******129",
      "help_en": "要查找的用户ID",
      "help_zh": "要查找的用户ID",
      "location": "query",
      "name": "user_id",
      "options": [
        "--user-id"
      ],
      "raw_name": "UserId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/workspaces/[WorkspaceId]/members",
  "product_code": "AIWorkSpace",
  "protocol": "HTTP|HTTPS",
