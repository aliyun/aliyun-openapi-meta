                  "title_zh": "成员账户名称",
                  "type": "string"
                },
                "AccountType": {
                  "description_en": "Account type. Valid values:\n\n1: Alibaba Cloud account\n\n5: RAM user\n\n6: RAM role",
                  "description_zh": "成员账户类型，1为主账户，5为子账户，6为角色账户",
                  "example": "5",
                  "title_en": "成员账户类型，1为主账户，5为子账户，6为角色账户",
                  "title_zh": "成员账户类型，1为主账户，5为子账户，6为角色账户",
                  "type": "string"
                },
                "DisplayName": {
                  "description_en": "Display name of the member",
                  "description_zh": "成员显示名",
                  "example": "myDisplayName",
                  "mappingResourcePropertyName": "$.DisplayName",
                  "title_en": "成员显示名",
                  "title_zh": "成员显示名",
                  "type": "string"
                },
                "GmtCreateTime": {
                  "description_en": "Time when the member was added, in UTC. Format: ISO 8601",
                  "description_zh": "创建UTC时间，时间格式为ISO8601",
                  "example": "2021-01-21T17:12:35.232Z",
                  "mappingResourcePropertyName": "$.CreateTime",
                  "title_en": "创建 UTC 时间，日期格式 iso8601",
                  "title_zh": "创建 UTC 时间，日期格式 iso8601",
                  "type": "string"
                },
                "MemberId": {
                  "description_en": "Member ID",
                  "description_zh": "成员ID",
                  "example": "14588*****51688039",
                  "mappingResourcePropertyName": "$.MemberId",
                  "title_en": "成员 id",
                  "title_zh": "成员 id",
                  "type": "string"
                },
                "MemberName": {
                  "description_en": "Username of the member",
                  "description_zh": "用户名",
                  "example": "user1",
                  "mappingResourcePropertyName": "$.MemberName",
                  "title_en": "云账号用户名",
                  "title_zh": "云账号用户名",
                  "type": "string"
                },
                "Roles": {
                  "description_en": "Roles assigned to the member",
                  "description_zh": "角色列表",
                  "itemName": "Roles",
                  "items": {
                    "description_en": "Role name. For the mapping between roles and permissions, see [Appendix: Roles and permissions]（https://help.aliyun.com/document_detail/2840449.html）.\n\nValid values:\n\nPAI.AlgoDeveloper: Algorithm developer\n\nPAI.AlgoOperator: Algorithm O\\&M engineer\n\nPAI.LabelManager: Annotation administrator\n\nPAI.MaxComputeDeveloper: MaxCompute developer\n\nPAI.WorkspaceAdmin: Workspace administrator\n\nPAI.WorkspaceGuest: Guest\n\nPAI.WorkspaceOwner: Workspace owner",
                    "description_zh": "角色名。角色名和权限的对应关系，请参见[附录：角色及权限列表]（https://help.aliyun.com/document_detail/2840449.html）。\n\n角色名可能值：\n\nPAI.AlgoDeveloper：算法开发。\nPAI.AlgoOperator：算法运维。\nPAI.LabelManager：标注管理员。\nPAI.MaxComputeDeveloper：MaxCompute开发。\nPAI.WorkspaceAdmin：管理员。\nPAI.WorkspaceGuest：访客。\nPAI.WorkspaceOwner：负责人",
                    "example": "PAI.AlgoDeveloper",
                    "mappingResourcePropertyName": "$.Roles[*]",
                    "title_en": "成员角色列表中的角色",
                    "title_zh": "成员角色列表中的角色",
                    "type": "string"
                  },
                  "title_en": "角色列表",
                  "title_zh": "角色列表",
                  "type": "array"
                },
                "UserId": {
                  "description_en": "Alibaba Cloud account ID of the member",
                  "description_zh": "用户ID",
                  "example": "215139******88039",
                  "mappingResourcePropertyName": "$.UserId",
                  "title_en": "用户 id",
                  "title_zh": "用户 id",
                  "type": "string"
                }
              },
              "title_en": "根成员列表中的第一个元素",
              "title_zh": "根成员列表中的第一个元素",
              "type": "object"
            },
            "title_en": "成员列表",
            "title_zh": "成员列表",
            "type": "array"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E",
            "title_en": "请求 id",
            "title_zh": "请求 id",
            "type": "string"
          },
          "TotalCount": {
            "description_en": "Total number of members that match the filter criteria",
            "description_zh": "符合过滤条件的成员数量",
            "example": "1",
            "format": "int64",
            "title_en": "符合过滤条件的数量",
            "title_zh": "符合过滤条件的数量",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
