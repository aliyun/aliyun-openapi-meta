            "mappingResourcePropertyName": "$.ModifyTime",
            "type": "string"
          },
          "PromptName": {
            "description_en": "The prompt name",
            "description_zh": "提示词名称",
            "example": "自动驾驶提示词",
            "mappingResourcePropertyName": "$.PromptName",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "5A14FA81-DD4E-******-6343FE44B941",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
