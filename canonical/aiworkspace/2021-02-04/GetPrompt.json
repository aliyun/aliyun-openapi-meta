            "type": "string"
          },
          "CreateTime": {
            "description_en": "The creation time",
            "description_zh": "创建时间",
            "example": "2024-10-16T01:44:10Z",
            "mappingResourcePropertyName": "$.CreateTime",
            "type": "string"
          },
          "Description": {
            "description_en": "The prompt description",
            "description_zh": "提示词描述",
            "example": "这个是一个自动驾驶高速场景的信息提取提示词，重点提取车道，天气等。\n",
            "mappingResourcePropertyName": "$.Description",
            "type": "string"
          },
          "FrameworkContent": {
            "description_en": "The prompt content",
            "description_zh": "提示词内容",
            "example": "{\n  \"context\":\"你是一个拥有十年驾龄的老司机，请你针对以下图片场景做出你的分析判断。\",\n  \"inputData\":\"{\n    \\\"反光贴条\\\": \\\" 通常为黄色，或者黄黑间隔，贴在墙角等永久的突出障碍物上，用于提示车主避让。为条带状，不是锥筒，不是地锁，不是水马！\\\",\n    \\\"地锁\\\": \\\"也叫车位锁，升起时可以阻止车位被占用。存在地锁时，务必输出地锁为升起还是降下状态。有升起架子时为升起状态,否则为降下状态。\\\",\n  }\"\n}",
            "mappingResourcePropertyName": "$.FrameworkContent",
            "type": "string"
          },
          "FrameworkType": {
            "description_en": "The prompt template framework type",
            "description_zh": "提示词模版框架类型",
