            "description_zh": "是否匹配",
            "example": "true",
            "title": "是否匹配",
            "type": "boolean"
          },
          "Name": {
            "backendName": "name",
            "description_zh": "全名匹配规则",
            "example": "testBucket/folder1/file1",
            "title": "全名",
            "type": "string"
          },
          "Prefix": {
            "backendName": "prefix",
            "description_zh": "前缀匹配规则",
            "example": "testBucket/prefix1xxx",
            "title": "前缀",
            "type": "string"
          },
          "Suffix": {
            "backendName": "suffix",
            "description_zh": "后缀匹配规则",
            "example": "suffix/xxxx.test",
            "title": "后缀",
            "type": "string"
          }
        },
        "title": "事件匹配规则对象",
        "type": "object"
      }
    }
