  "pathPattern": "",
  "product_code": "Mns-open",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The response code",
            "description_zh": "响应code",
            "example": "200",
            "format": "int64",
            "type": "integer"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The response data",
            "description_zh": "响应数据",
            "properties": {
              "ActiveMessages": {
                "backendName": "activeMessages",
                "description_en": "The approximate total number of messages in the Active state in the queue.\n\n<warning>This field will be deprecated and defaults to 0. Use the CloudMonitor API to retrieve this metric instead.</warning>",
                "description_zh": "在该Queue中处于Active状态的消息总数，为近似值。\n\n<warning>后续会下线，默认为0，不推荐使用，请使用云监控api获取指标。</warning>",
                "example": "0",
                "format": "int64",
                "mappingResourcePropertyName": "$.ActiveMessages",
                "type": "integer"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The time when the queue was created",
                "description_zh": "Queue的创建时间",
                "example": "1250700999",
                "format": "int64",
                "mappingResourcePropertyName": "$.CreateTime",
                "type": "integer"
              },
              "DelayMessages": {
                "backendName": "delayMessages",
                "description_en": "The approximate total number of messages in the Delayed state in the queue.\n\n<warning>This field will be deprecated and defaults to 0. Use the CloudMonitor API to retrieve this metric instead.</warning>",
                "description_zh": "在该Queue中处于Delayed状态的消息总数，为近似值。\n\n<warning>后续会下线，默认为0，不推荐使用，请使用云监控api获取指标。</warning>",
                "example": "0",
                "format": "int64",
                "mappingResourcePropertyName": "$.DelayMessages",
                "type": "integer"
              },
              "DelaySeconds": {
                "backendName": "delaySeconds",
                "description_en": "The delay period for all messages sent to the queue. Messages sent to the queue can be consumed only after the delay period specified by this parameter elapses. Unit: seconds",
                "description_zh": "发送到该Queue的所有消息的延迟时间，发送到队列的消息经过此参数设定的延时时间后，才能被消费，单位为秒",
                "example": "30",
                "format": "int64",
                "mappingResourcePropertyName": "$.DelaySeconds",
                "type": "integer"
              },
              "DlqPolicy": {
                "backendName": "dlqPolicy",
                "description_en": "The dead-letter queue policy",
                "description_zh": "死信队列策略",
                "properties": {
                  "DeadLetterTargetQueue": {
                    "backendName": "deadLetterTargetQueue",
                    "description_en": "The target queue for dead-letter message delivery",
                    "description_zh": "死信消息投递目标队列",
                    "example": "deadLetterTargetQueue",
                    "mappingResourcePropertyName": "$.DlqPolicy.DeadLetterTargetQueue",
                    "type": "string"
                  },
                  "Enabled": {
                    "backendName": "enabled",
                    "description_en": "Indicates whether dead-letter message delivery is enabled",
                    "description_zh": "是否开启死信消息投递",
                    "example": "true",
                    "mappingResourcePropertyName": "$.DlqPolicy.Enabled",
                    "type": "boolean"
                  },
                  "MaxReceiveCount": {
                    "backendName": "maxReceiveCount",
                    "description_en": "The maximum number of times a message can be delivered",
                    "description_zh": "消息最大投递次数",
                    "example": "3",
                    "mappingResourcePropertyName": "$.DlqPolicy.MaxReceiveCount",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "EnableSSE": {
                "backendName": "enableSSE",
                "type": "boolean"
              },
              "EncryptionEnabled": {
                "backendName": "encryptionEnabled",
                "type": "boolean"
              },
              "InactiveMessages": {
                "backendName": "inactiveMessages",
                "description_en": "The approximate total number of messages in the Inactive state in the queue.\n\n<warning>This field will be deprecated and defaults to 0. Use the CloudMonitor API to retrieve this metric instead.</warning>",
                "description_zh": "在该Queue中处于Inactive状态的消息总数，为近似值。\n\n<warning>后续会下线，默认为0，不推荐使用，请使用云监控api获取指标。</warning>",
                "example": "0",
                "format": "int64",
                "mappingResourcePropertyName": "$.InactiveMessages",
                "type": "integer"
              },
              "KmsKeyId": {
                "backendName": "kmsKeyId",
                "type": "string"
              },
              "LastModifyTime": {
                "backendName": "lastModifyTime",
                "description_en": "The most recent time when the queue attributes were modified. The value is a UNIX timestamp representing the number of seconds elapsed since 1970-01-01 00:00:00",
                "description_zh": "修改Queue属性信息最近时间，从1970-01-01 00:00:00到现在的时间",
                "example": "1250700999",
                "format": "int64",
                "mappingResourcePropertyName": "$.LastModifyTime",
                "type": "integer"
              },
              "LoggingEnabled": {
                "backendName": "loggingEnabled",
                "description_en": "Indicates whether the log management feature is enabled.\n\nTrue: Enabled.\n\nFalse: Disabled",
                "description_zh": "是否开启日志管理功能。\n\nTrue：启用。\n\nFalse：停用",
                "example": "True",
                "mappingResourcePropertyName": "$.LoggingEnabled",
                "type": "boolean"
              },
              "MaximumMessageSize": {
                "backendName": "maximumMessageSize",
                "description_en": "The maximum length of the message body sent to the queue. Unit: bytes",
                "description_zh": "发送到该Queue的消息体的最大长度，单位为Byte",
                "example": "65536",
                "format": "int64",
                "mappingResourcePropertyName": "$.MaximumMessageSize",
                "type": "integer"
              },
              "MessageRetentionPeriod": {
                "backendName": "messageRetentionPeriod",
                "description_en": "The maximum duration for which a message is retained in the queue. After the period specified by this parameter elapses since the message is sent to the queue, the message is deleted regardless of whether it has been consumed. Unit: seconds",
                "description_zh": "消息在该Queue中最长的存活时间，从发送到该队列开始经过此参数指定的时间后，不论消息是否被取出过都将被删除，单位为秒",
                "example": "65536",
                "format": "int64",
                "mappingResourcePropertyName": "$.MessageRetentionPeriod",
                "type": "integer"
              },
              "PollingWaitSeconds": {
                "backendName": "pollingWaitSeconds",
                "description_en": "The maximum wait time for a ReceiveMessage request on the queue when the queue has no messages. Unit: seconds",
                "description_zh": "当Queue消息量为空时，针对该Queue的ReceiveMessage请求最长的等待时间，单位为秒",
                "example": "0",
                "format": "int64",
                "mappingResourcePropertyName": "$.PollingWaitSeconds",
                "type": "integer"
              },
              "QueueName": {
                "backendName": "queueName",
                "description_en": "The name of the queue",
                "description_zh": "Queue的名称",
                "example": "demo-queue",
                "mappingResourcePropertyName": "$.QueueName",
                "type": "string"
              },
              "QueueType": {
                "backendName": "queueType",
                "description_en": "The type of the queue. Valid values:\nnormal: standard queue\nfifo: FIFO queue",
                "description_zh": "队列类型。可取值如下：\nnormal: 普通队列\nfifo: FIFO队列",
                "example": "normal",
                "type": "string"
              },
              "SseAlgorithm": {
                "backendName": "sseAlgorithm",
                "type": "string"
              },
              "SseType": {
                "backendName": "sseType",
                "type": "string"
              },
              "Tags": {
                "backendName": "tags",
                "description_en": "The list of resource tags",
                "description_zh": "资源标签列表",
                "itemName": "Tags",
                "items": {
                  "description_en": "The tag value that corresponds to the tag key",
                  "description_zh": "标签键对应的标签值",
                  "mappingResourcePropertyName": "$.Tags[*]",
                  "properties": {
                    "TagKey": {
                      "backendName": "tagKey",
                      "description_en": "The key of the tag",
                      "description_zh": "标签的key",
                      "example": "tag1",
                      "mappingResourcePropertyName": "$.Tags[*].TagKey",
                      "type": "string"
                    },
                    "TagValue": {
                      "backendName": "tagValue",
                      "description_en": "The value of the tag",
                      "description_zh": "标签值",
                      "example": "test",
                      "mappingResourcePropertyName": "$.Tags[*].TagValue",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "TenantRateLimitPolicy": {
                "backendName": "tenantRateLimitPolicy",
                "description_en": "The rate limiting policy",
                "description_zh": "限流策略",
                "properties": {
                  "Enabled": {
                    "backendName": "enabled",
                    "description_en": "Specifies whether rate limiting is enabled. Valid values:\ntrue\nfalse",
                    "description_zh": "是否启用限流。取值范围：\ntrue\nfalse",
                    "example": "true",
                    "type": "boolean"
                  },
                  "MaxReceivesPerSecond": {
                    "backendName": "maxReceivesPerSecond",
                    "description_en": "The maximum number of receives per second",
                    "description_zh": "每秒最大接收次数",
                    "example": "1000",
                    "format": "int32",
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "VisibilityTimeout": {
                "backendName": "visibilityTimeout",
                "description_en": "The duration for which a message stays in the Inactive state after it is consumed from the queue and changes from the Active state to the Inactive state.\nValid values: 1 to 43200. Unit: seconds.\nDefault value: 30",
                "description_zh": "消息从该Queue中取出后从Active状态变成Inactive状态后的持续时间。\n取值范围：1~43200，单位为秒。\n默认值：30",
                "example": "60",
                "format": "int64",
                "mappingResourcePropertyName": "$.VisibilityTimeout",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The response message",
            "description_zh": "响应信息",
            "example": "operation success",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求的ID",
            "example": "06273500-249F-5863-121D-74D51123****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Status": {
            "backendName": "status",
            "description_en": "The status of the response",
            "description_zh": "响应的状态",
            "example": "Success",
            "type": "string"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "example": "true",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
