{
  "camel_example": "",
  "cmd_full_name": "mns-open list-queue",
  "cmd_name": "list-queue",
  "deprecated": false,
  "description_en": "Lists all queues under a specified Alibaba Cloud account with pagination support",
  "description_zh": "调用ListQueue接口，列出指定阿里云账号下的所有队列，可分页获取数据",
  "kebab_example": "aliyun mns-open list-queue --page-num 1 --page-size 20 --queue-name demo-queue --tag Value=test Key=tag1 --queue-type normal --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ListQueue",
  "operation": {
    "action": "ListQueue",
    "api_style": "RPC",
    "api_version": "2022-01-19",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "1",
      "help_en": "The page number of the results to return.\n\nValid values: 1 to 100000000.\n\nIf you set this parameter to a value less than 1, the system uses 1 by default. If you set this parameter to a value greater than 100000000, the system uses 100000000 by default",
      "help_zh": "分页页码，查询第几页的返回结果。\n取值范围：1~100000000。\n若您设置的参数值小于1，则系统默认按照参数值为1处理；若您设置的参数值大于100000000，则系统默认按照参数值为100000000处理",
      "location": "query",
      "name": "page_num",
      "options": [
        "--page-num"
      ],
      "raw_name": "PageNum",
      "required": false,
      "type": "int"
    },
    {
      "example": "20",
      "help_en": "The number of entries to return on each page.\n\nValid values: 10 to 50.\n\nIf you set this parameter to a value less than 10, the system uses 10 by default. If you set this parameter to a value greater than 50, the system uses 50 by default",
      "help_zh": "分页大小，每页最多显示的返回结果数量。\n取值范围：10~50。\n若您设置的参数值小于10，则系统默认按照参数值为10处理；若您设置的参数值大于50，则系统默认按照参数值为50处理",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "demo-queue",
      "help_en": "The name of the queue",
      "help_zh": "Queue名称",
      "location": "query",
      "name": "queue_name",
      "options": [
        "--queue-name"
      ],
      "raw_name": "QueueName",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "fields": [
          {
            "example": "tag1",
            "help_en": "The key of the tag",
            "help_zh": "标签的key",
            "name": "key",
            "options": [
              "--key"
            ],
            "raw_name": "Key",
            "required": false,
            "type": "string"
          },
          {
            "example": "test",
            "help_en": "The value of the tag",
            "help_zh": "标签值",
            "name": "value",
            "options": [
              "--value"
            ],
            "raw_name": "Value",
            "required": false,
            "type": "string"
          }
        ],
        "type": "object"
      },
      "help_en": "The list of resource tags",
      "help_zh": "资源标签列表",
      "location": "query",
      "name": "tag",
      "options": [
        "--tag"
      ],
      "param_style": "repeatList",
      "raw_name": "Tag",
      "required": false,
      "type": "array"
    },
    {
      "example": "normal",
      "help_en": "The type of the queue. Valid values:\nnormal: standard queue\nfifo: FIFO queue",
      "help_zh": "队列类型。可取值如下：\nnormal: 普通队列\nfifo: FIFO队列",
      "location": "query",
      "name": "queue_type",
      "options": [
        "--queue-type"
      ],
      "raw_name": "QueueType",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Mns-open",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The response code",
            "description_zh": "响应code",
            "example": "200",
            "format": "int64",
            "type": "integer"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The response data",
            "description_zh": "响应数据",
            "properties": {
              "PageData": {
                "backendName": "pageData",
                "description_en": "The results returned on the current page",
                "description_zh": "当前页返回结果",
                "itemName": "pageData",
                "items": {
                  "description_en": "The data entry",
                  "description_zh": "数据项",
                  "properties": {
                    "ActiveMessages": {
                      "backendName": "activeMessages",
                      "description_en": "The approximate total number of messages in the Active state in this queue.\n\nThis field will default to 0 in the future and is not recommended. Use CloudMonitor API to retrieve this metric instead",
                      "description_zh": "在该Queue中处于Active状态的消息总数，为近似值。\n后续会默认为0，不推荐使用，辛苦用云监控api获取指标",
                      "example": "0",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.ActiveMessages",
                      "type": "integer"
                    },
                    "CreateTime": {
                      "backendName": "createTime",
                      "description_en": "The time when the queue was created. The value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                      "description_zh": "Queue的创建事件，从1970-01-01 00:00:00到现在的时间",
                      "example": "1250700999",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.CreateTime",
                      "type": "integer"
                    },
                    "DelayMessages": {
                      "backendName": "delayMessages",
                      "description_en": "The approximate total number of messages in the Delayed state in this queue.\n\nThis field will default to 0 in the future and is not recommended. Use CloudMonitor API to retrieve this metric instead",
                      "description_zh": "在该Queue中处于Delayed状态的消息总数，为近似值。\n后续会默认为0，不推荐使用，辛苦用云监控api获取指标",
                      "example": "0",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.DelayMessages",
                      "type": "integer"
                    },
                    "DelaySeconds": {
                      "backendName": "delaySeconds",
                      "description_en": "The delay period after which all messages sent to this queue become consumable. Unit: seconds",
                      "description_zh": "发送到该Queue的所有消息的延迟时间，发送到队列的消息经过此参数设定的延时时间后，才能被消费，单位为秒",
                      "example": "30",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.DelaySeconds",
                      "type": "integer"
                    },
                    "DlqPolicy": {
                      "backendName": "dlqPolicy",
                      "description_en": "The dead-letter queue policy",
                      "description_zh": "死信队列策略",
                      "properties": {
                        "DeadLetterTargetQueue": {
                          "backendName": "deadLetterTargetQueue",
                          "description_en": "The target queue for dead-letter message delivery",
                          "description_zh": "死信消息投递目标队列",
                          "example": "deadLetterTargetQueue",
                          "type": "string"
                        },
                        "Enabled": {
                          "backendName": "enabled",
                          "description_en": "Indicates whether dead-letter message delivery is enabled",
                          "description_zh": "是否开启死信消息投递",
                          "example": "true",
                          "type": "boolean"
                        },
                        "MaxReceiveCount": {
                          "backendName": "maxReceiveCount",
                          "description_en": "The maximum number of times a message can be delivered",
                          "description_zh": "消息最大投递次数",
                          "example": "3",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "EnableSSE": {
                      "backendName": "enableSSE",
                      "type": "boolean"
                    },
                    "EncryptionEnabled": {
                      "backendName": "encryptionEnabled",
                      "type": "boolean"
                    },
                    "InactiveMessages": {
                      "backendName": "inactiveMessages",
                      "description_en": "The approximate total number of messages in the Inactive state in this queue.\n\nThis field will default to 0 in the future and is not recommended. Use CloudMonitor API to retrieve this metric instead",
                      "description_zh": "在该Queue中处于Inactive状态的消息总数，为近似值。\n后续会默认为0，不推荐使用，辛苦用云监控api获取指标",
                      "example": "0",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.InactiveMessages",
                      "type": "integer"
                    },
                    "KmsKeyId": {
                      "backendName": "kmsKeyId",
                      "type": "string"
                    },
                    "LastModifyTime": {
                      "backendName": "lastModifyTime",
                      "description_en": "The most recent time when the queue attributes were modified. The value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                      "description_zh": "修改Queue属性信息最近时间，从1970-01-01 00:00:00到现在的时间",
                      "example": "1250700999",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.LastModifyTime",
                      "type": "integer"
                    },
                    "LoggingEnabled": {
                      "backendName": "loggingEnabled",
                      "description_en": "Indicates whether the log management feature is enabled.\n\nTrue: Enabled.\n\nFalse: Disabled",
                      "description_zh": "是否开启日志管理功能。\n\nTrue：启用。\n\nFalse：停用",
                      "example": "True",
                      "mappingResourcePropertyName": "$.LoggingEnabled",
                      "type": "boolean"
                    },
                    "MaximumMessageSize": {
                      "backendName": "maximumMessageSize",
                      "description_en": "The maximum size of a message body that can be sent to this queue. Unit: bytes",
                      "description_zh": "发送到该Queue的消息体的最大长度，单位为Byte",
                      "example": "65536",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.MaximumMessageSize",
                      "type": "integer"
                    },
                    "MessageRetentionPeriod": {
                      "backendName": "messageRetentionPeriod",
                      "description_en": "The maximum period for which a message can be retained in this queue. After the specified period elapses since a message is sent to the queue, the message is deleted regardless of whether it has been consumed. Unit: seconds",
                      "description_zh": "消息在该Queue中最长的存活时间，从发送到该队列开始经过此参数指定的时间后，不论消息是否被取出过都将被删除，单位为秒",
                      "example": "65536",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.MessageRetentionPeriod",
                      "type": "integer"
                    },
                    "PollingWaitSeconds": {
                      "backendName": "pollingWaitSeconds",
                      "description_en": "The maximum wait time for a ReceiveMessage request when the queue is empty. Unit: seconds",
                      "description_zh": "当Queue消息量为空时，针对该Queue的ReceiveMessage请求最长的等待时间，单位为秒",
                      "example": "0",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.PollingWaitSeconds",
                      "type": "integer"
                    },
                    "QueueName": {
                      "backendName": "queueName",
                      "description_en": "The name of the queue",
                      "description_zh": "队列名称",
                      "example": "demo-queue",
                      "mappingResourcePropertyName": "$.QueueName",
                      "type": "string"
                    },
                    "QueueType": {
                      "backendName": "queueType",
                      "description_en": "The type of the queue. Valid values:\nnormal: standard queue\nfifo: FIFO queue",
                      "description_zh": "队列类型。可取值如下：\nnormal: 普通队列\nfifo: FIFO队列",
                      "example": "normal",
                      "type": "string"
                    },
                    "SseAlgorithm": {
                      "backendName": "sseAlgorithm",
                      "type": "string"
                    },
                    "SseType": {
                      "backendName": "sseType",
                      "type": "string"
                    },
                    "Tags": {
                      "backendName": "tags",
                      "description_en": "The list of resource tags",
                      "description_zh": "资源标签列表",
                      "itemName": "Tags",
                      "items": {
                        "description_en": "The tag value that corresponds to the tag key",
                        "description_zh": "标签键对应的标签值",
                        "mappingResourcePropertyName": "$.Tags[*]",
                        "properties": {
                          "TagKey": {
                            "backendName": "tagKey",
                            "description_en": "The key of the tag",
                            "description_zh": "标签的key",
                            "example": "tag1",
                            "mappingResourcePropertyName": "$.Tags[*].TagKey",
                            "type": "string"
                          },
                          "TagValue": {
                            "backendName": "tagValue",
                            "description_en": "The value of the tag",
                            "description_zh": "标签值",
                            "example": "test",
                            "mappingResourcePropertyName": "$.Tags[*].TagValue",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "VisibilityTimeout": {
                      "backendName": "visibilityTimeout",
                      "description_en": "The duration for which a message stays in the Inactive state after it is consumed from the queue.\n\nValid values: 1 to 43200. Unit: seconds.\n\nDefault value: 30",
                      "description_zh": "消息从该Queue中取出后从Active状态变成Inactive状态后的持续时间。\n取值范围：1~43200，单位为秒。\n默认值：30",
                      "example": "60",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.VisibilityTimeout",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "PageNum": {
                "backendName": "pageNum",
                "description_en": "The page number of the returned results",
                "description_zh": "分页页码，查询第几页的返回结果",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "PageSize": {
                "backendName": "pageSize",
                "description_en": "The maximum number of entries returned per page",
                "description_zh": "分页大小，每页最多显示的返回结果数量",
                "example": "50",
                "format": "int64",
                "type": "integer"
              },
              "Pages": {
                "backendName": "pages",
                "description_en": "The total number of pages",
                "description_zh": "总页数",
                "example": "3",
                "format": "int64",
                "type": "integer"
              },
              "Size": {
                "backendName": "size",
                "description_en": "The number of entries returned on the current page",
                "description_zh": "当前页结果数量",
                "example": "20",
                "format": "int64",
                "type": "integer"
              },
              "Total": {
                "backendName": "total",
                "description_en": "The total number of entries",
                "description_zh": "总结果数",
                "example": "130",
                "format": "int64",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The response message",
            "description_zh": "响应信息",
            "example": "operation success",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求的ID",
            "example": "06273500-249F-5863-121D-74D51123****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Status": {
            "backendName": "status",
            "description_en": "The status of the response",
            "description_zh": "响应的状态",
            "example": "Success",
            "type": "string"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "example": "true",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
