                    "LastModifyTime": {
                      "backendName": "lastModifyTime",
                      "description_en": "The time when the topic attributes were last modified. The value is a UTC UNIX timestamp in seconds",
                      "description_zh": "主题属性最近一次修改时间，为 UTC Unix 秒级时间戳",
                      "example": "1449554962",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.LastModifyTime",
                      "type": "integer"
                    },
