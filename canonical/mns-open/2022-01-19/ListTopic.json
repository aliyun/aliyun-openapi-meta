                      "backendName": "loggingEnabled",
                      "description_en": "Indicates whether the log management feature is enabled. Valid values:\nTrue: enabled\nFalse: disabled",
                      "description_zh": "是否开启日志管理功能。\n\nTrue：启用。\n\nFalse：停用",
                      "example": "True",
                      "mappingResourcePropertyName": "$.EnableLogging",
                      "type": "boolean"
                    },
                    "MaxMessageSize": {
                      "backendName": "maxMessageSize",
                      "description_en": "The maximum length of the message body that can be sent to the topic. Unit: bytes",
                      "description_zh": "发送到该主题的消息体最大长度，单位为Byte",
                      "example": "65536",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.MaxMessageSize",
                      "type": "integer"
                    },
                    "MessageCount": {
                      "backendName": "messageCount",
                      "description_en": "The number of messages in the topic",
                      "description_zh": "当前该主题中消息数目",
                      "example": "0",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.MessageCount",
                      "type": "integer"
                    },
                    "MessageRetentionPeriod": {
                      "backendName": "messageRetentionPeriod",
                      "description_en": "The maximum retention period of messages in the topic. After the specified period elapses from the time a message is sent to the topic, the message is deleted regardless of whether it is successfully pushed to users. Unit: seconds",
                      "description_zh": "消息在主题中最长存活时间，从发送到该主题开始经过此参数指定的时间后，不论消息是否被成功推送给用户都将被删除，单位为秒",
                      "example": "86400",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.MessageRetentionPeriod",
                      "type": "integer"
                    },
                    "SseAlgorithm": {
                      "backendName": "sseAlgorithm",
                      "description_en": "The server-side encryption algorithm. Currently, AES-256-GCM is supported. If this parameter is not specified, the default algorithm is used",
