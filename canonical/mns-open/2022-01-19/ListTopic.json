{
  "camel_example": "aliyun mns-open ListTopic --region cn-hangzhou --TopicType normal --Tag.1.Key tag1 --PageNum 1 --PageSize 20 --Tag.1.Value test --TopicName test --version 2022-01-19 --method POST --force",
