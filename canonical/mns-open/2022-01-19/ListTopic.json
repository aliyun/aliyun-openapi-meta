                      "example": "demo-topic",
                      "mappingResourcePropertyName": "$.TopicName",
                      "type": "string"
                    },
                    "TopicType": {
                      "backendName": "topicType",
                      "description_en": "The type of the topic. Valid values:\nnormal: normal topic\nfifo: FIFO topic",
                      "description_zh": "主题类型。可取值如下：\nnormal: 普通主题\nfifo: FIFO主题",
                      "example": "normal",
                      "type": "string"
                    },
                    "TopicUrl": {
                      "backendName": "topicUrl",
                      "description_en": "The URL of the topic",
                      "description_zh": "消息Topic URL",
                      "example": "http:// 111111111****.mns.us-west-1.aliyuncs.com/topics/testTopic",
                      "mappingResourcePropertyName": "$.TopicUrl",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "PageNum": {
                "backendName": "pageNum",
                "description_en": "The page number of the returned results",
