                      "description_zh": "主题的创建时间，为 UTC Unix 秒级时间戳",
                      "example": "1449554962",
                      "format": "int64",
                      "mappingResourcePropertyName": "$.CreateTime",
                      "type": "integer"
                    },
                    "EnableSSE": {
                      "backendName": "enableSSE",
                      "description_en": "Specifies whether server-side encryption is enabled. Valid values: true and false",
                      "description_zh": "是否开启存储加密。取值：true 或 false",
                      "example": "true",
                      "type": "boolean"
                    },
                    "EncryptionEnabled": {
                      "backendName": "encryptionEnabled",
                      "description_en": "Indicates whether server-side encryption is enabled",
                      "description_zh": "是否已启用存储加密",
                      "example": "true",
                      "type": "boolean"
                    },
                    "KmsKeyId": {
                      "backendName": "kmsKeyId",
                      "description_en": "The KMS key ID",
                      "description_zh": "KMS 密钥 ID",
                      "example": "key-xxx",
                      "type": "string"
