                            "description_zh": "标签的key",
                            "example": "tag1",
                            "mappingResourcePropertyName": "$.Tags[*].TagKey",
                            "type": "string"
                          },
                          "TagValue": {
                            "backendName": "tagValue",
                            "description_en": "The value of the tag",
                            "description_zh": "标签值",
                            "example": "test",
                            "mappingResourcePropertyName": "$.Tags[*].TagValue",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "TopicInnerUrl": {
                      "backendName": "topicInnerUrl",
                      "description_en": "The internal URL of the topic",
                      "description_zh": "消息Topic URL（内网访问）",
                      "example": "http:// 111111111****.mns.us-west-1-internal.aliyuncs.com/topics/testTopic",
                      "mappingResourcePropertyName": "$.TopicInnerUrl",
                      "type": "string"
                    },
                    "TopicName": {
                      "backendName": "topicName",
                      "description_en": "The name of the topic",
