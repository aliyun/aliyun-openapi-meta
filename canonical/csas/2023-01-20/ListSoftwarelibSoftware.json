            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Id of the request",
            "description_zh": "Id of the request",
            "example": "BE4FB974-11BC-5453-9BE1-1606A73EACA6",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.totalNum",
            "description_en": "The total number of software entries that match the query conditions",
