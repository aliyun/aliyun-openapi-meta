                },
                "CheckBundleId": {
                  "backendName": "checkBundleId",
                  "description_en": "The software BundleId used for verification",
                  "description_zh": "用于校验的软件BundleId",
                  "example": "test software",
                  "type": "string"
                },
                "CheckSoftwareName": {
                  "backendName": "checkSoftwareName",
                  "description_en": "The software name used for verification",
                  "description_zh": "用于校验的软件名称",
