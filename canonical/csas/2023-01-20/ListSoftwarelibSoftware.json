                      },
                      "SoftwarePkgSize": {
                        "backendName": "softwarePkgSize",
                        "description_en": "The size of the software package",
                        "description_zh": "软件包大小",
                        "example": "100",
                        "format": "int64",
                        "type": "integer"
                      },
                      "SoftwareUrl": {
                        "backendName": "softwareUrl",
                        "description_en": "The download URL of the software package",
                        "description_zh": "软件包下载地址",
                        "example": "https://****.com/****",
                        "type": "string"
                      },
                      "Status": {
                        "backendName": "status",
                        "description_en": "The version publish status. Valid values:\npublished: published.\nunpublished: not published",
                        "description_zh": "版本发布状态。取值：\npublished：已发布。\nunpublished：未发布",
                        "example": "published",
                        "type": "string"
                      },
                      "Version": {
                        "backendName": "version",
                        "description_en": "The software version number",
                        "description_zh": "软件版本号",
                        "example": "1.0.0",
                        "type": "string"
                      },
                      "VersionId": {
                        "backendName": "versionId",
                        "description_en": "The software version ID",
                        "description_zh": "软件版本ID",
                        "example": "softwarelib-version-21ae186e2ac9****",
                        "type": "string"
