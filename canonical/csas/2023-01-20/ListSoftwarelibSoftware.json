                "SoftwareId": {
                  "backendName": "softwareId",
                  "description_en": "The software ID",
                  "description_zh": "软件ID",
                  "example": "softwarelib-software-1da844a39729****",
                  "type": "string"
                },
                "SoftwareName": {
                  "backendName": "softwareName",
