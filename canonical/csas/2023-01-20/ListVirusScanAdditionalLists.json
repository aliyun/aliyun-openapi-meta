  "deprecated": false,
  "description_en": "查询病毒扫描额外名单",
  "description_zh": "查询指定操作系统下的病毒扫描黑白名单，按匹配维度与名单类型分组返回。黑白名单是阿里云账号与操作系统维度的全局名单，对该账号下的即时扫描、定时扫描与实时防御全部生效",
  "kebab_example": "aliyun csas list-virus-scan-additional-lists --dev-type windows --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListVirusScanAdditionalLists",
  "operation": {
    "action": "ListVirusScanAdditionalLists",
    "api_style": "RPC",
    "api_version": "2023-01-20",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "windows",
      "help_en": "The DevType",
      "help_zh": "名单生效的操作系统类型。取值：\nwindows：Windows系统。\nmacOS：macOS系统",
      "location": "query",
      "name": "dev_type",
      "options": [
        "--dev-type"
      ],
      "raw_name": "DevType",
      "required": true,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The AdditionalTypes",
      "help_zh": "按匹配维度过滤，不允许重复。不传则返回全部匹配维度",
      "location": "query",
      "name": "additional_types",
      "options": [
        "--additional-types"
      ],
      "param_style": "flat",
      "raw_name": "AdditionalTypes",
      "required": false,
      "type": "array"
    },
    {
      "example": "Whitelist",
      "help_en": "The ListType",
      "help_zh": "按名单类型过滤。不传则黑名单与白名单都返回。取值：\nBlacklist：黑名单，命中的文件直接判定为病毒文件。\nWhitelist：白名单，命中的文件不参与病毒检测",
      "location": "query",
      "name": "list_type",
      "options": [
        "--list-type"
      ],
      "raw_name": "ListType",
