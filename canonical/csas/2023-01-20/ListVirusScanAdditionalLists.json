      "location": "query",
      "name": "list_ids",
      "options": [
        "--list-ids"
      ],
      "param_style": "flat",
      "raw_name": "ListIds",
      "required": false,
      "type": "array"
    },
    {
      "example": ".tmp",
      "help_en": "The ListDetail",
      "help_zh": "名单条目内容，精确匹配。用于按内容定位某一条名单，不支持模糊查询",
      "location": "query",
      "name": "list_detail",
      "options": [
        "--list-detail"
      ],
      "raw_name": "ListDetail",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
