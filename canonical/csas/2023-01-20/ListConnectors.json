{
  "camel_example": "aliyun csas ListConnectors --region cn-hangzhou --PageSize 10 --CurrentPage 1",
  "cmd_full_name": "csas list-connectors",
  "cmd_name": "list-connectors",
  "deprecated": false,
  "description_en": "Queries the details of connectors under the current Alibaba Cloud account",
  "description_zh": "批量查询当前阿里云账号下的Connector信息",
  "kebab_example": "aliyun csas list-connectors --current-page 1 --page-size 10 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListConnectors",
  "operation": {
    "action": "ListConnectors",
    "api_style": "RPC",
    "api_version": "2023-01-20",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "1",
      "help_en": "The page number of the current page for paging in a paged query. Valid values: 1 to 10000",
      "help_zh": "分页查询时显示的当前页的页码。取值：1~10000",
      "location": "query",
      "name": "current_page",
      "options": [
        "--current-page"
      ],
      "raw_name": "CurrentPage",
      "required": true,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The Settings for the number of entries per page for paging in a paged query. Valid values: 1 to 1000",
      "help_zh": "分页查询时设置的每页数量。取值：1~1000",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": true,
      "type": "int"
    },
    {
      "example": "connector_name",
      "help_en": "The name of the connector. The name must be 1 to 128 characters in length, and can contain Chinese characters, uppercase and lowercase letters, digits, periods (.), underscores (_), and hyphens (-)",
      "help_zh": "Connector名称。长度为1~128个字符，支持中文和大小写英文字母，可包含数字、半角句号（.）、下划线（_）和短划线（-）",
      "location": "query",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": false,
      "type": "string"
    },
    {
      "example": "Online",
      "help_en": "The connection status of the connector. Valid values:\nOnline: online.\nOffline: offline",
      "help_zh": "Connector连接状态。取值：\nOnline：在线。\nOffline：离线",
      "location": "query",
      "name": "status",
      "options": [
        "--status"
      ],
      "raw_name": "Status",
      "required": false,
      "type": "string"
    },
    {
      "example": "Enabled",
      "help_en": "The instance status of the connector. Valid values:\nEnabled: enabled.\nDisabled: shutdown",
      "help_zh": "Connector实例状态。取值：\nEnabled：开启。\nDisabled：关闭",
      "location": "query",
      "name": "switch_status",
      "options": [
        "--switch-status"
      ],
      "raw_name": "SwitchStatus",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The IDs of the connectors. You can enter up to 100 connector IDs",
      "help_zh": "ConnectorID集合。最多可输入100个ConnectorID",
      "location": "query",
      "name": "connector_ids",
      "options": [
        "--connector-ids"
      ],
      "param_style": "flat",
      "raw_name": "ConnectorIds",
      "required": false,
      "type": "array"
    }
  ],
  "pathPattern": "",
  "product_code": "csas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Connectors": {
            "backendName": "data.connectors",
            "description_en": "The list of connectors",
            "description_zh": "Connector列表",
            "itemName": "connector",
            "items": {
              "description_en": "The connector information",
              "description_zh": "Connector信息",
              "properties": {
                "AccelerateStatus": {
                  "backendName": "accelerateStatus",
                  "description_en": "Specifies whether global acceleration is enabled. Valid values:\nEnabled: enabled.\nDisabled: disabled",
                  "description_zh": "是否启用全球加速。取值：\nEnabled：开启。\nDisabled：关闭",
                  "example": "Enabled",
                  "type": "string"
                },
                "Applications": {
                  "backendName": "applications",
                  "description_en": "The internal access applications associated with the connector",
                  "description_zh": "关联的内网访问应用集合",
                  "itemName": "application",
                  "items": {
                    "description_en": "The internal access application associated with the connector",
                    "description_zh": "关联的内网访问应用",
                    "properties": {
                      "ApplicationId": {
                        "backendName": "applicationId",
                        "description_en": "The ID of the internal access application",
                        "description_zh": "内网访问应用ID",
                        "example": "pa-application-e12860ef6c48****\n",
                        "type": "string"
                      },
                      "ApplicationName": {
                        "backendName": "applicationName",
                        "description_en": "The name of the internal access application",
                        "description_zh": "内网访问应用名称",
                        "example": "application_name",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array"
                },
                "ClusterIP": {
                  "backendName": "clusterIP",
                  "description_en": "The cluster IP address",
                  "description_zh": "集群IP",
                  "example": "1.1.1.1",
                  "type": "string"
                },
                "ClusterPort": {
                  "backendName": "clusterPort",
                  "description_en": "The cluster port",
                  "description_zh": "集群端口",
                  "example": "8000",
                  "type": "string"
                },
                "ConnectorClients": {
                  "backendName": "connectorClients",
                  "description_en": "The deployed connector clients",
                  "description_zh": "部署的ConnectorClient集合",
                  "itemName": "connectorClient",
                  "items": {
                    "description_en": "The deployed connector client",
                    "description_zh": "部署的ConnectorClient",
                    "properties": {
                      "ConnectionStatus": {
                        "backendName": "connectionStatus",
                        "description_en": "The connection status between the connector client and the connector server",
                        "description_zh": "ConnectorClient和ConnectorServer的连接状态",
                        "example": "Disconnected",
                        "type": "string"
                      },
                      "DevTag": {
                        "backendName": "devTag",
                        "description_en": "The unique device identifier of the connector client",
                        "description_zh": "ConnectorClient的设备唯一标识",
                        "example": "C50A2386-F851-4F11-920B-DF7148DA0C22",
                        "type": "string"
                      },
                      "Hostname": {
                        "backendName": "hostname",
                        "description_en": "The hostname of the connector client",
                        "description_zh": "ConnectorClient主机名",
                        "example": "connector_client",
                        "type": "string"
                      },
                      "PublicIp": {
                        "backendName": "publicIp",
                        "description_en": "The public IP address of the connector client",
                        "description_zh": "ConnectorClient公网IP",
                        "example": "192.0.2.1",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array"
                },
                "ConnectorId": {
                  "backendName": "connectorId",
                  "description_en": "The unique ID of the connector",
                  "description_zh": "Connector的唯一标识ID",
                  "example": "connector-94db94e06b98****",
                  "type": "string"
                },
                "CreateTime": {
                  "backendName": "createTime",
                  "description_en": "The time when the connector was created. The time is in the YYYY-MM-DD HH:mm:ss format",
                  "description_zh": "Connector创建时间，格式为 YYYY-MM-DD HH:mm:ss",
                  "example": "2022-09-27 18:10:25",
                  "type": "string"
                },
                "Name": {
                  "backendName": "name",
                  "description_en": "The name of the connector",
                  "description_zh": "Connector名称",
                  "example": "connector_name",
                  "type": "string"
                },
                "RegionId": {
                  "backendName": "regionId",
                  "description_en": "The region ID",
                  "description_zh": "地域ID",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The connection status of the connector. Valid values:\nOnline: online.\nOffline: offline",
                  "description_zh": "Connector连接状态。取值：\nOnline：在线。\nOffline：离线",
                  "example": "Online",
                  "type": "string"
                },
                "SwitchStatus": {
                  "backendName": "switchStatus",
                  "description_en": "The instance status of the connector. Valid values:\nEnabled: enabled.\nDisabled: shutdown",
                  "description_zh": "Connector实例状态。取值：\nEnabled：开启。\nDisabled：关闭",
                  "example": "Enabled",
                  "type": "string"
                },
                "UpgradeTime": {
                  "backendName": "upgradeTime",
                  "description_en": "The upgrade time of the connector",
                  "description_zh": "Connector升级时间",
                  "properties": {
                    "End": {
                      "backendName": "end",
                      "description_en": "The end time",
                      "description_zh": "结束时间",
                      "example": "23:00",
                      "type": "string"
                    },
                    "Start": {
                      "backendName": "start",
                      "description_en": "The start time",
                      "description_zh": "开始时间",
                      "example": "20:00",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "VipCidr": {
                  "backendName": "vipCidr",
                  "description_en": "The CIDR block of the virtual IP address",
                  "description_zh": "虚拟 IP 的 CIDR 地址段",
                  "example": "10.0.0.0/24",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "本次请求的ID",
            "example": "58D6B23E-E5DA-5418-8F61-51A3B5A30049",
            "type": "string"
          },
          "TotalNum": {
            "backendName": "data.totalNum",
            "description_en": "The total number of connectors",
            "description_zh": "Connector总数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
