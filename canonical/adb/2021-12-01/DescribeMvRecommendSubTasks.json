  "components": {
    "schemas": {
      "open_struct_MvRecommendSubTaskModel": {
        "description_en": "Details of a recommendation task for a materialized view",
        "description_zh": "物化视图推荐任务执行详情",
        "properties": {
          "EndTime": {
            "backendName": "endTime",
            "description_en": "The end time of the task",
            "description_zh": "任务结束时间",
            "example": "2025-10-16 16:56\n",
            "type": "string"
          },
          "MinRewriteQueryCount": {
            "backendName": "minRewriteQueryCount",
            "description_en": "The minimum number of slow queries that match the pattern",
            "description_zh": "Pattern匹配的最少慢查询个数",
            "example": "3",
            "format": "int32",
            "type": "integer"
          },
          "MinRewriteQueryPattern": {
            "backendName": "minRewriteQueryPattern",
            "description_en": "The number of minimum acceleration patterns",
            "description_zh": "最小可加速的Pattern数量",
            "example": "5",
            "format": "int32",
            "type": "integer"
          },
          "ScanQueriesCount": {
            "backendName": "scanQueriesCount",
            "description_en": "The number of queries scanned",
            "description_zh": "扫描的查询数",
            "example": "55",
            "format": "int64",
            "type": "integer"
          },
          "SlowQueryThreshold": {
            "backendName": "slowQueryThreshold",
            "description_en": "The wait threshold for slow queries",
            "description_zh": "慢查询阈值",
            "example": "2",
            "format": "int32",
            "type": "integer"
          },
          "StartTime": {
            "backendName": "startTime",
            "description_en": "The start time of the task",
            "description_zh": "任务开始时间",
            "example": "2025-10-16 16:55\n",
            "type": "string"
          },
          "Status": {
            "backendName": "status",
            "description_en": "Current execution status",
            "description_zh": "当前运行的状态",
            "example": "RUNNING",
            "type": "string"
          },
          "SubQueriesCount": {
            "backendName": "subQueriesCount",
            "description_en": "The number of newly generated MV recommendations",
            "description_zh": "生成的新增MV建议数量",
            "example": "70",
            "format": "int64",
            "type": "integer"
          },
          "SubtaskId": {
            "backendName": "subtaskId",
            "description_en": "The record ID of the task execution",
            "description_zh": "任务执行的记录ID",
            "example": "123",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
