      "help_zh": "查询结果的页码。取值范围：正整数。 默认值：1",
      "location": "query",
      "maximum": "2147483647",
      "minimum": "1",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
