{
  "cmd_full_name": "adb describe-download-records",
  "cmd_name": "describe-download-records",
  "deprecated": false,
  "description_en": "Queries the five most recent download tasks for SQL query results in a specified AnalyticDB for MySQL Lakehouse Edition (3.0) cluster",
  "description_zh": "查看目标AnalyticDB MySQL湖仓版（3.0）集群中最近5次的SQL查询下载任务列表",
  "kebab_example": "aliyun adb describe-download-records --db-cluster-id amv-8vb6ha79k6e0000 --biz-region-id cn-hangzhou --api-version 2021-12-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribeDownloadRecords",
  "operation": {
    "action": "DescribeDownloadRecords",
    "api_style": "RPC",
    "api_version": "2021-12-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "amv-8vb6ha79k6e****",
      "help_en": "The cluster ID.\n\nYou can call the https://help.aliyun.com/document_detail/129857.html operation to query the details of all AnalyticDB for MySQL Lakehouse Edition (3.0) clusters in a specific region, including the cluster ID",
      "help_zh": "集群ID。\n您可以调用https://help.aliyun.com/document_detail/129857.html接口查看目标地域下所有AnalyticDB MySQL湖仓版（3.0）集群的详情，包括集群ID",
      "location": "query",
      "name": "db_cluster_id",
      "options": [
        "--db-cluster-id"
      ],
      "raw_name": "DBClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "zh",
      "help_en": "The language of the response. Valid values:\n\nzh: Simplified Chinese (default).\n\nen: English.\n\nja: Japanese.\n\nzh-tw: Traditional Chinese",
      "help_zh": "语言配置，取值说明：\nzh：简体中文（默认语言）。\nen：英文。\nja：日文。\nzh-tw：繁体中文",
      "location": "query",
      "name": "lang",
      "options": [
        "--lang"
      ],
      "raw_name": "Lang",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "adb",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "AccessDeniedDetail": {
            "backendName": "data.accessDeniedDetail",
            "description_en": "The authentication failure message",
            "description_zh": "鉴权失败信息",
            "example": "Authentication failed.",
            "type": "string"
          },
          "Records": {
            "backendName": "data.items",
            "description_en": "A list of download tasks",
            "description_zh": "详情",
            "itemName": "Items",
            "items": {
              "description_en": "The details of a download task",
              "description_zh": "下载列表详情",
              "properties": {
                "DownloadId": {
                  "backendName": "downloadId",
                  "description_en": "The ID of the download task",
                  "description_zh": "下载任务ID",
                  "example": "636890",
                  "format": "int64",
                  "nullToEmpty": true,
                  "type": "integer",
                  "visibility": "Public"
                },
                "ExceptionMsg": {
                  "backendName": "remark",
                  "description_en": "The exception message returned if the download task fails",
                  "description_zh": "下载任务失败时返回的异常信息",
                  "example": "The query result is empty.",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "FileName": {
                  "backendName": "fileName",
                  "description_en": "The name of the downloaded file",
                  "description_zh": "下载文件名",
                  "example": "20210806094635-20210806095135",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The task status. Valid values:\n\nrunning: The task is in progress.\n\nfinished: The task is complete.\n\nfailed: The task failed",
                  "description_zh": "任务状态，取值为：\nrunning：正在下载。\nfinished：已完成。\nfailed：下载失败",
                  "example": "finished",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "Url": {
                  "backendName": "fileUrl",
                  "description_en": "The download URL of the result file",
                  "description_zh": "文件下载地址",
                  "example": "https://perth-download-task.oss-cn-beijing.aliyuncs.com/adbmysql/query-sql-logs/amv-*********/20210805104301-20210805164302.xlsx?Expires=1943514161&OSSAccessKeyId=*********&Signature=******\"",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": false,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "data.requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "D761DA51-12F8-5457-AAA9-F52B9F436D2D",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
