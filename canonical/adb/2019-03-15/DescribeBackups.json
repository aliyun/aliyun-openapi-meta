                  "backendName": "backupSetId",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupMethod": {
                  "backendName": "backupMethod",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Logical",
                        "value": "L"
                      },
                      {
                        "targetValue": "Physical",
                        "value": "P"
                      },
                      {
                        "targetValue": "Snapshot",
                        "value": "S"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "BackupSize": {
                  "backendName": "backupSetSize",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "BackupStartTime": {
                  "backendName": "backupStartTime",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupStatus": {
                  "backendName": "status",
                  "type": "string"
                },
                "BackupType": {
                  "backendName": "backupType",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "FullBackup",
                        "value": "F"
                      },
                      {
                        "targetValue": "IncrementalBackup",
                        "value": "I"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "DBClusterId": {
                  "backendName": "dbInstanceId",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "data.pageNumbers",
