              "properties": {
                "BackupEndTime": {
                  "backendName": "backupEndTime",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupExpiredTime": {
                  "backendName": "backupExpiredTime",
                  "type": "string",
                  "visibility": "Public"
                },
