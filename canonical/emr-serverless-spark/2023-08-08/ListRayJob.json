            "backendName": "data.totalCount",
            "description_en": "The total number of entries",
            "description_zh": "总数量",
            "example": "200",
            "format": "int32",
            "title_en": "总数量",
            "title_zh": "总数量",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
