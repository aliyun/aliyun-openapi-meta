              "description_en": "The Ray Job struct",
              "description_zh": "Ray Job结构体",
              "properties": {
                "clusterState": {
                  "backendName": "clusterState",
                  "description_en": "The status of the corresponding Ray cluster. Valid values:\nDeleted: deleted.\nSubmitted: submitted but not yet being created.\nPending: being created.\nRunning: running",
                  "description_zh": "对应的 Ray 集群的状态。\nDeleted：已删除。\nSubmitted：已提交未开始创建。\nPending：创建中。\nRunning：运行中",
                  "enum": [
                    "Deleted",
                    "Running",
                    "Submitted",
                    "Pending"
                  ],
                  "example": "Running",
                  "type": "string"
                },
                "creatorName": {
                  "backendName": "creatorName",
                  "description_en": "The nickname of the creator",
                  "description_zh": "创建者昵称",
                  "example": "Alice",
                  "title_en": "创建者昵称。",
                  "title_zh": "创建者昵称。",
                  "type": "string"
                },
                "cuHours": {
                  "backendName": "cuHours",
                  "description_en": "The number of compute units (CUs) consumed during the job execution cycle. This value is an estimate. The actual value is subject to the bill",
                  "description_zh": "任务运行周期内所消耗的 CU 数量（该值为预估值，最终以账单为准）",
                  "example": "120",
                  "format": "double",
                  "type": "number"
                },
                "dashboardUrl": {
                  "backendName": "dashboardUrl",
                  "description_en": "The URL of the Ray cluster dashboard. When the Ray cluster is in the Running state, the URL points to the Runtime UI. After the cluster is in the Deleted state, the URL points to the History UI. The History UI is supported only in err-1.2.0 and later versions",
                  "description_zh": "Ray 集群 Dashboard 链接，Ray 集群状态为 Running 时为 Runtime UI，状态为 Deleted 后为 History UI，仅 err-1.2.0 及以上版本支持 History UI",
                  "example": "https://emr-ray-gateway.aliyuncs.com?token=xxxxxxxxx",
                  "title_en": "Ray集群Dashboard链接。",
                  "title_zh": "Ray集群Dashboard链接。",
                  "type": "string"
                },
                "duration": {
                  "backendName": "duration",
                  "description_en": "The execution duration of the job. Unit: seconds",
                  "description_zh": "任务执行时间，单位秒",
                  "example": "3564",
                  "format": "int64",
                  "type": "integer"
                },
                "endTime": {
                  "backendName": "endTime",
                  "description_en": "The time when the job ended",
                  "description_zh": "任务结束时间",
                  "example": "1776945509000",
                  "format": "int64",
                  "type": "integer"
                },
                "name": {
                  "backendName": "name",
                  "description_en": "The name of the Ray Job",
                  "description_zh": "Ray Job的名称",
                  "example": "testRayJob",
                  "title_en": "Ray集群名称。",
                  "title_zh": "Ray集群名称。",
                  "type": "string"
                },
                "resourceQueue": {
                  "backendName": "resourceQueue",
                  "description_en": "The Ray DPI engine version",
                  "description_zh": "Ray引擎版本",
                  "example": "err-1.2.0 (Ray 2.55.1, Python 3.12)",
                  "title_en": "Ray引擎版本。",
                  "title_zh": "Ray引擎版本。",
                  "type": "string"
                },
                "startTime": {
                  "backendName": "startTime",
                  "description_en": "The time when the job was started",
                  "description_zh": "任务启动时间",
                  "example": "1776945499000",
                  "format": "int64",
                  "type": "integer"
                },
                "status": {
                  "backendName": "status",
                  "description_en": "The job status. Valid values:\nSubmitted: submitted.\nPending: the cluster is being created.\nRunning: the job is running.\nSucceeded: the job succeeded.\nFailed: the job failed.\nCancelling: the job is being canceled.\nCancelled: the job is canceled.\nTimeout: the job timed out and was canceled",
                  "description_zh": "任务状态\nSubmitted 已提交。\nPending：集群创建中。\nRunning：任务运行中。\nSucceeded：任务已成功。\nFailed：任务已失败。\nCancelling：取消中。\nCancelled：已取消。\nTimeout：超时取消",
                  "enum": [
                    "Submitted",
                    "Pending",
                    "Running",
                    "Succeeded",
                    "Failed",
                    "Cancelling",
                    "Cancelled",
                    "Timeout"
                  ],
                  "example": "Running",
                  "title_en": "集群状态。\nStarting：启动中。\nRunning：运行中。\nStopping：正在停止。\nStopped：已停止。\nError：已失败。",
                  "title_zh": "集群状态。\nStarting：启动中。\nRunning：运行中。\nStopping：正在停止。\nStopped：已停止。\nError：已失败。",
                  "type": "string"
                },
                "submissionId": {
                  "backendName": "submissionId",
                  "description_en": "The ID of the Ray Job",
                  "description_zh": "Ray Job的id",
                  "example": "rj-uiulpgow9xljimm1",
                  "title_en": "集群ID。",
                  "title_zh": "集群ID。",
                  "type": "string"
                },
                "submitTime": {
                  "backendName": "submitTime",
                  "description_en": "The time when the job was submitted",
                  "description_zh": "任务提交时间",
                  "example": "1776945399000",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "title_en": "Ray集群结构体。",
              "title_zh": "Ray集群结构体。",
              "type": "object"
            },
            "title_en": "Ray集群列表。",
            "title_zh": "Ray集群列表。",
            "type": "array"
          },
