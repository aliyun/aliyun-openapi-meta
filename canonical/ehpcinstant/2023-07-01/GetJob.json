                                "description_zh": "当前支持的数据卷类型。\nalicloud/nas: 挂载 NAS。\nalicloud/oss: 挂载OSS",
                                "example": "alicloud/nas",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
