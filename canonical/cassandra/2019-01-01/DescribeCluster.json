{
  "camel_example": "",
  "cmd_full_name": "cassandra describe-cluster",
  "cmd_name": "describe-cluster",
  "deprecated": false,
  "description_en": "Queries the details of a Cassandra instance",
  "description_zh": "查询Cassandra实例的详细信息",
  "kebab_example": "aliyun cassandra describe-cluster --cluster-id cds-bp1b136j00005d58 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeCluster",
  "operation": {
    "action": "DescribeCluster",
    "api_style": "RPC",
    "api_version": "2019-01-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cds-bp1b136j****5d58",
      "help_en": "The cluster ID",
      "help_zh": "集群 ID",
      "location": "query",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Cassandra",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Cluster": {
            "backendName": "data",
            "description_en": "The cluster information",
            "description_zh": "集群信息列表",
            "nullToEmpty": false,
            "properties": {
              "AutoRenewPeriod": {
                "backendName": "renewalDuration",
                "description_en": "The Unified Auto Renewal Cycle.\n\nIf the cluster is purchased on a monthly basis, the auto-renewal epoch is 1 month.\nIf the cluster is purchased on a yearly basis, the auto-renewal epoch is 1 year (12 months).\n\nPay-as-you-go instances do not have an expiration time",
                "description_zh": "自动续费周期。\n\n按月购买：则自动续费周期为 1 个月。\n按年购买：则自动续费周期为 1 年（12个月）。\n\n按量付费实例无到期时间",
                "example": "12",
                "format": "int32",
                "mappingResourcePropertyName": "$.AutoRenewPeriod",
                "type": "integer",
                "visibility": "Public"
              },
              "AutoRenewal": {
                "backendName": "autoRenewal",
                "description_en": "Indicates whether auto-renewal is enabled. Valid values: true/false.\nPay-as-you-go instances do not have an expiration time",
                "description_zh": "是否自动续费，可取值：true/false\n按量付费实例无到期时间",
                "example": "true",
                "type": "boolean",
                "visibility": "Public"
              },
              "ClusterId": {
                "backendName": "id",
                "description_en": "The cluster ID",
                "description_zh": "集群ID",
                "example": "cds-bp1b136j****5d56",
                "mappingResourcePropertyName": "$.ClusterId",
                "type": "string",
                "visibility": "Public"
              },
              "ClusterName": {
                "backendName": "name",
                "description_en": "The cluster name.\n\nThe name must be 2 to 128 characters in length and must start with an uppercase letter, a lowercase letter, or a Chinese character. The name can contain digits, periods (.), underscores (_), or hyphens (-)",
                "description_zh": "集群名称。\n\n长度为2-128个字符，以大小写字母或中文开头，可包含数字，‘.’，‘_’或‘-’",
                "example": "Cassandra-test",
                "mappingResourcePropertyName": "$.ClusterName",
                "type": "string",
                "visibility": "Public"
              },
              "ConfirmProductOffline": {
                "backendName": "confirmProductOffline",
                "type": "boolean",
                "visibility": "Public"
              },
              "CreatedTime": {
                "backendName": "createdTime",
                "description_en": "The time when the cluster was created. Format: yyyy-MM-ddTHH:mm:ssZ (UTC)",
                "description_zh": "集群创建时间。格式：yyyy-MM-ddTHH:mm:ssZ（UTC 通用标准时，以Z来标识）",
                "example": "2019-09-20T16:02:34Z",
                "type": "string",
                "visibility": "Public"
              },
              "DataCenterCount": {
                "backendName": "dcCount",
                "description_en": "The number of data centers",
                "description_zh": "数据中心个数",
                "example": "1",
                "format": "int32",
                "mappingResourcePropertyName": "$.DataCenterCount",
                "type": "integer",
                "visibility": "Public"
              },
              "ExpireTime": {
                "backendName": "expireTime",
                "description_en": "The expiration time of the cluster. Format: yyyy-MM-ddTHH:mm:ssZ (UTC)",
                "description_zh": "集群到期时间。格式：yyyy-MM-ddTHH:mm:ssZ（UTC 通用标准时，以Z来标识）",
                "example": "2019-10-20T16:02:34Z",
                "mappingResourcePropertyName": "$.ExpireTime",
                "type": "string",
                "visibility": "Public"
              },
              "IsLatestVersion": {
                "backendName": "latestVersion",
                "description_en": "Indicates whether the current minor version is the latest version",
                "description_zh": "当前小版本是否为最新版本",
                "example": "true",
                "mappingResourcePropertyName": "$.IsLatestVersion",
                "type": "boolean",
                "visibility": "Public"
              },
              "LockMode": {
                "backendName": "lockMode",
                "description_en": "The lock mode. Valid values:\n\nNone: not locked.\nExpired: locked because the cluster subscription has expired.\nDiskFull: locked because the disk is full",
                "description_zh": "锁定模式：\n\nNone：未锁定\nExpired：集群订阅到期锁定\nDiskFull：磁盘已满锁定",
                "example": "None",
                "mappingResourcePropertyName": "$.LockMode",
                "type": "string",
                "visibility": "Public"
              },
              "MaintainEndTime": {
                "backendName": "maintainEndTime",
                "description_en": "The end time of the O&M window for the instance. Format: HH:mmZ (UTC)",
                "description_zh": "实例运维结束时间。格式：HH:mmZ（UTC 通用标准时，以Z来标识）",
                "example": "4:00Z",
                "mappingResourcePropertyName": "$.MaintainEndTime",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "MaintainStartTime": {
                "backendName": "maintainStartTime",
                "description_en": "The start time of the O&M window for the instance. Format: HH:mmZ (UTC)",
                "description_zh": "实例运维开始时间。格式：HH:mmZ（UTC 通用标准时，以Z来标识）",
                "example": "2:00Z",
                "mappingResourcePropertyName": "$.MaintainStartTime",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "MajorVersion": {
                "backendName": "majorVersion",
                "description_en": "The major version number of the cluster",
                "description_zh": "集群主版本号",
                "example": "3.11",
                "mappingResourcePropertyName": "$.MajorVersion",
                "type": "string",
                "visibility": "Public"
              },
              "MinorVersion": {
                "backendName": "minorVersion",
                "description_en": "The minor version number of the cluster",
                "description_zh": "集群小版本号",
                "example": "3.11.7",
                "mappingResourcePropertyName": "$.MinorVersion",
                "type": "string",
                "visibility": "Public"
              },
              "PayType": {
                "backendName": "payType",
                "description_en": "The billing method. Valid values:\n\nSubscription: subscription.\nPayAsYouGo: pay-as-you-go.\n\nPay-as-you-go instances do not have an expiration time",
                "description_zh": "付费类型，可取值：\n\nSubscription：包年包月\nPayAsYouGo：按量付费\n\n按量付费实例无到期时间",
                "example": "PayAsYouGo",
                "type": "string",
                "visibility": "Public"
              },
              "ResourceGroupId": {
                "backendName": "resourceGroupId",
                "description_en": "The ID of the resource group to which the resource belongs",
                "description_zh": "资源所在的资源组id",
                "example": "rg-xxxxxxxxxxx",
                "mappingResourcePropertyName": "$.ResourceGroupId",
                "type": "string",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The running status of the cluster. Valid values:\n\nCreating: being created\nCreateFailed: failed to be created\nRunning: running\nDeleting: being deleted\nDeleteFailed: failed to be deleted\nDeleted: deleted",
                "description_zh": "集群运行状态，可取值示例：\n\nCreating：创建中\nCreateFailed：创建失败\nRunning：运行中\nDeleting：删除中\nDeleteFailed：删除失败\nDeleted：已删除",
                "example": "Running",
                "mappingResourcePropertyName": "$.Status",
                "type": "string",
                "visibility": "Public"
              },
              "Tags": {
                "backendName": "tags",
                "itemName": "Tag",
                "items": {
                  "mappingResourcePropertyName": "$.Tags[*]",
                  "properties": {
                    "Key": {
                      "backendName": "key",
                      "mappingResourcePropertyName": "$.Tags[*].TagKey",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Value": {
                      "backendName": "value",
                      "mappingResourcePropertyName": "$.Tags[*].TagValue",
                      "type": "string",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "type": "array",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "17E2B462-5FD3-4A0C-AF13-225C66E47BD5",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
