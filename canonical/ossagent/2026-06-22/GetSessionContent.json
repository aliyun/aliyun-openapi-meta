{
  "camel_example": "",
  "cmd_full_name": "ossagent get-session-content",
  "cmd_name": "get-session-content",
  "deprecated": false,
  "description_en": "Retrieves the detailed content of a session. You can only query sessions generated by the current account",
  "description_zh": "获取会话详细内容，只能查本账号产生的会话",
  "kebab_example": "aliyun ossagent get-session-content --session-id UUID --env poc --api-version 2026-06-22 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "GetSessionContent",
  "operation": {
    "action": "GetSessionContent",
    "api_style": "ROA",
    "api_version": "2026-06-22",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": "/api/oss/agent/get_session_content.json"
  },
  "parameters": [
    {
      "example": "UUID",
      "help_en": "The session ID",
      "help_zh": "会话 id",
      "location": "query",
      "name": "session_id",
      "options": [
        "--session-id"
      ],
      "raw_name": "sessionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "poc",
      "help_en": "The dedicated environment name of the agent",
      "help_zh": "agent专属环境名",
      "location": "query",
      "name": "env",
      "options": [
        "--env"
      ],
      "raw_name": "env",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/oss/agent/get_session_content.json",
  "product_code": "OssAgent",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "content": {
            "description_en": "The text content of the conversation",
            "description_zh": "对话文本内容",
            "itemName": "content",
            "items": {
              "description_en": "The text content of the conversation",
              "description_zh": "对话文本内容",
              "properties": {
                "agentContents": {
                  "description_en": "The detailed conversation content",
                  "description_zh": "详细对话内容",
                  "itemName": "agentContents",
                  "items": {
                    "description_en": "The detailed conversation content",
                    "description_zh": "详细对话内容",
                    "properties": {
                      "agentContent": {
                        "description_en": "The detailed content of a conversation chunk. All chunks combine to form the complete response",
                        "description_zh": "详细对话chunk内容，所有chunk组成完成回复",
                        "example": "{\\\"id\\\":\\\"16aa7737-9e6a-4500-abd2-96c5f17d1188\\\",\\\"object\\\":\\\"chat.completion.chunk\\\",\\\"created\\\":1788408524,\\\"model\\\":\\\"oss-agent\\\",\\\"choices\\\":[{\\\"index\\\":0,\\\"delta\\\":{\\\"role\\\":\\\"assistant\\\",\\\"content\\\":\\\"，Hello， I am OSS Agent\\\"}}]}",
                        "type": "string"
                      },
                      "timestamp": {
                        "description_en": "The time when the content was generated, in the yyyy-MM-dd HH:mm:ss,SSS format",
                        "description_zh": "内容产生时间 yyyy-MM-dd HH:mm:ss,SSS 格式",
                        "example": "1774577589",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "timestamp": {
                  "description_en": "The time when the session occurred, in the yyyy-MM-dd HH:mm:ss,SSS format",
                  "description_zh": "会话发生时间 yyyy-MM-dd HH:mm:ss,SSS 格式",
                  "example": "2026-09-03 04:08:30,637",
                  "type": "string"
                },
                "toolConfirm": {
                  "description_en": "Indicates whether tool confirmation is required",
                  "description_zh": "是否工具确认",
                  "example": "false",
                  "type": "boolean"
                },
                "userContent": {
                  "description_en": "The user content in the first message of the session",
                  "description_zh": "会话首句用户内容",
                  "example": "[{\\\"role\\\":\\\"user\\\",\\\"content\\\":\\\"Hi OSS\\\"}]",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "contentSync": {
            "description_en": "The synchronization status of the session content. You can use this status to determine whether the content returned in the next round of the session is complete",
            "description_zh": "会话内容同步状态，用此状态判断次轮会话返回的内容是否完整",
            "example": "pending/ready/timed_out/unknow",
            "type": "string"
          },
          "requestId": {
            "description_en": "Id of the request",
            "description_zh": "Id of the request",
            "example": "UUID",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "sessionId": {
            "description_en": "The session ID",
            "description_zh": "会话 id",
            "example": "UUID",
            "type": "string"
          },
          "status": {
            "description_en": "The session status. Note that the idle status does not indicate that the session content has been fully returned",
            "description_zh": "会话状态，注意idle状态不代表会话内容已经完整返回",
            "example": "generating/waiting_confirm/idle/interrupted/error",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
