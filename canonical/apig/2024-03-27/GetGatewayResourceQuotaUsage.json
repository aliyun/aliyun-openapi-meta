  "responses": {
    "200": {
      "schema": {
        "description_en": "请求的响应对象。成功时返回 code=Ok 和 data；失败时返回错误码及错误信息，不返回伪造的零用量",
        "description_zh": "响应结果",
        "example": "{\"requestId\":\"D0A6A1A0-8793-4C10-AB1A-2C03E770A912\",\"code\":\"Ok\",\"data\":{\"gatewayId\":\"gw-d5be0s9q5z6f1234567g\",\"observedAt\":\"2026-09-17T08:00:00Z\",\"items\":[{\"quotaKey\":\"Route\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":12,\"limit\":800},{\"quotaKey\":\"ConsumerAuthorizationRule\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":20,\"limit\":1000},{\"quotaKey\":\"McpServer\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":false},{\"quotaKey\":\"Domain\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":2,\"limit\":100},{\"quotaKey\":\"Service\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":5,\"limit\":800},{\"quotaKey\":\"ConsumerQuotaRule\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":0,\"limit\":1000},{\"quotaKey\":\"K8sServiceSource\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":1,\"limit\":3},{\"quotaKey\":\"InstalledPlugin\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":2,\"limit\":5},{\"quotaKey\":\"CustomPlugin\",\"usedScope\":\"ACCOUNT_REGION\",\"limitScope\":\"ACCOUNT_GATEWAY_TYPE\",\"applicable\":false}]}}",
        "properties": {
          "code": {
            "description_en": "业务响应码。成功时为 Ok；失败时为具体错误码，应结合 HTTP 状态码处理",
            "description_zh": "响应码",
            "example": "Ok",
            "title_en": "响应码",
            "title_zh": "响应码",
            "type": "string"
          },
          "data": {
            "description_en": "目标网关及其九项资源配额观测结果。示例数值只说明格式，实际有效上限以本次响应为准",
            "description_zh": "配额查询结果",
            "example": "{\"gatewayId\":\"gw-d5be0s9q5z6f1234567g\",\"observedAt\":\"2026-09-17T08:00:00Z\",\"items\":[{\"quotaKey\":\"Route\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":12,\"limit\":800},{\"quotaKey\":\"ConsumerAuthorizationRule\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":20,\"limit\":1000},{\"quotaKey\":\"McpServer\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":false},{\"quotaKey\":\"Domain\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":2,\"limit\":100},{\"quotaKey\":\"Service\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":5,\"limit\":800},{\"quotaKey\":\"ConsumerQuotaRule\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":0,\"limit\":1000},{\"quotaKey\":\"K8sServiceSource\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":1,\"limit\":3},{\"quotaKey\":\"InstalledPlugin\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":2,\"limit\":5},{\"quotaKey\":\"CustomPlugin\",\"usedScope\":\"ACCOUNT_REGION\",\"limitScope\":\"ACCOUNT_GATEWAY_TYPE\",\"applicable\":false}]}",
            "properties": {
              "gatewayId": {
                "description_en": "本次查询的目标网关唯一标识，与请求路径 gatewayId 一致",
                "description_zh": "网关ID",
                "example": "gw-d5be0s9q5z6f1234567g",
                "title_en": "网关ID",
                "title_zh": "网关ID",
                "type": "string"
              },
              "items": {
                "description_en": "固定返回九项，每个 quotaKey 仅出现一次。不适用或暂不展示的项仍保留，applicable=false 且省略 used/limit。不返回剩余额度或百分比；示例数值不是固定默认上限",
                "description_zh": "资源配额项",
                "example": "[{\"quotaKey\":\"Route\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":12,\"limit\":800},{\"quotaKey\":\"ConsumerAuthorizationRule\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":20,\"limit\":1000},{\"quotaKey\":\"McpServer\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":false},{\"quotaKey\":\"Domain\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":2,\"limit\":100},{\"quotaKey\":\"Service\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":5,\"limit\":800},{\"quotaKey\":\"ConsumerQuotaRule\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":0,\"limit\":1000},{\"quotaKey\":\"K8sServiceSource\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":1,\"limit\":3},{\"quotaKey\":\"InstalledPlugin\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":2,\"limit\":5},{\"quotaKey\":\"CustomPlugin\",\"usedScope\":\"ACCOUNT_REGION\",\"limitScope\":\"ACCOUNT_GATEWAY_TYPE\",\"applicable\":false}]",
                "itemName": "items",
                "items": {
                  "description_en": "单项资源指标的统计范围、展示适用性，以及适用时的用量和有效上限",
                  "description_zh": "单项资源配额",
                  "example": "{\"quotaKey\":\"Route\",\"usedScope\":\"GATEWAY\",\"limitScope\":\"GATEWAY\",\"applicable\":true,\"used\":12,\"limit\":800}",
                  "properties": {
                    "applicable": {
                      "descriptionEn": "If true, used and limit are returned. If false, both are omitted. CustomPlugin is currently always false to hide quota values; plugin upload, installation, and existing quota checks are unchanged. Other items follow gateway capabilities and effective quotas. This field alone does not authorize writes.",
                      "description_en": "true 时返回 used 和 limit；false 时省略二者。CustomPlugin 当前固定为 false，仅表示暂时隐藏配额展示，不影响插件上传、安装或既有配额校验。其他项按网关能力及有效额度判定，不能仅凭本字段推断写入操作是否允许",
                      "description_zh": "是否提供配额数值",
                      "example": "true",
                      "title_en": "是否提供配额数值",
                      "title_zh": "是否提供配额数值",
                      "type": "boolean"
                    },
                    "limit": {
                      "descriptionEn": "The current non-negative integer quota limit, in the same unit as used, after existing configuration, overrides, and applicable purchased quota are applied. Returned only when applicable=true, including valid zero values. The example is not a fixed limit for every gateway.",
                      "description_en": "当前生效的非负整数配额上限，单位与 used 相同，已考虑现有配置、加白及适用的购买额度。仅 applicable=true 时返回，包括合法零值；示例不是所有网关的固定上限",
                      "description_zh": "有效上限",
                      "example": "800",
                      "format": "int64",
                      "title_en": "有效上限",
                      "title_zh": "有效上限",
                      "type": "integer"
                    },
                    "limitScope": {
                      "descriptionEn": "GATEWAY identifies the current gateway. ACCOUNT_GATEWAY_TYPE identifies the current account, region, and gateway type. Only CustomPlugin retains ACCOUNT_GATEWAY_TYPE; its limit is currently neither read nor returned.",
                      "description_en": "GATEWAY 表示当前网关；ACCOUNT_GATEWAY_TYPE 表示当前账号、地域及网关类型的范围。仅 CustomPlugin 保留 ACCOUNT_GATEWAY_TYPE 标识；该项当前不读取或返回上限",
                      "description_zh": "上限适用范围",
                      "example": "GATEWAY",
                      "title_en": "上限适用范围",
                      "title_zh": "上限适用范围",
                      "type": "string"
                    },
                    "quotaKey": {
                      "descriptionEn": "The metric: Route, ConsumerAuthorizationRule, McpServer, Domain, Service, ConsumerQuotaRule, K8sServiceSource, InstalledPlugin, or CustomPlugin.",
                      "description_en": "指标标识：Route（路由）、ConsumerAuthorizationRule（消费者授权规则）、McpServer（MCP Server）、Domain（域名）、Service（服务）、ConsumerQuotaRule（消费者配额规则）、K8sServiceSource（K8s 服务来源）、InstalledPlugin（已安装插件）、CustomPlugin（自定义插件）",
                      "description_zh": "配额指标",
                      "example": "Route",
                      "title_en": "配额指标",
                      "title_zh": "配额指标",
                      "type": "string"
                    },
                    "used": {
                      "descriptionEn": "The actual non-negative integer usage in the unit identified by quotaKey. Returned only when applicable=true. Zero represents zero usage; historical usage may exceed limit and is not truncated.",
                      "description_en": "实际占用数量，为非负整数，单位与 quotaKey 对应。仅 applicable=true 时返回；零值为真实零用量，历史超额可大于 limit，不截断",
                      "description_zh": "当前用量",
                      "example": "12",
                      "format": "int64",
                      "title_en": "当前用量",
                      "title_zh": "当前用量",
                      "type": "integer"
                    },
                    "usedScope": {
                      "descriptionEn": "GATEWAY identifies the current gateway. ACCOUNT_REGION identifies the current account and region. Only CustomPlugin retains ACCOUNT_REGION; its usage is currently neither read nor returned.",
                      "description_en": "GATEWAY 表示当前网关；ACCOUNT_REGION 表示当前账号在当前地域的共享范围。仅 CustomPlugin 保留 ACCOUNT_REGION 标识；该项当前不读取或返回用量",
                      "description_zh": "用量统计范围",
                      "example": "GATEWAY",
                      "title_en": "用量统计范围",
                      "title_zh": "用量统计范围",
                      "type": "string"
                    }
                  },
                  "title_en": "单项资源配额",
                  "title_zh": "单项资源配额",
                  "type": "object"
                },
                "title_en": "资源配额项",
                "title_zh": "资源配额项",
                "type": "array"
              },
              "observedAt": {
                "description_en": "服务端完成本次统计的 UTC 时间，格式为 RFC 3339，可包含小数秒。各来源独立读取，不保证跨来源瞬时原子快照",
                "description_zh": "统计完成时间",
                "example": "2026-09-17T08:00:00Z",
                "title_en": "统计完成时间",
                "title_zh": "统计完成时间",
                "type": "string"
              }
            },
            "title_en": "配额查询结果",
            "title_zh": "配额查询结果",
            "type": "object"
          },
          "message": {
            "description_en": "失败时返回的错误说明，成功响应通常省略本字段。示例为错误信息，不是成功响应",
            "description_zh": "错误信息",
            "example": "The specified gateway does not exist.",
            "title_en": "错误信息",
            "title_zh": "错误信息",
            "type": "string"
          },
          "requestId": {
            "description_en": "请求的唯一标识，用于排查问题",
            "description_zh": "请求ID",
            "example": "D0A6A1A0-8793-4C10-AB1A-2C03E770A912",
            "title_en": "请求ID",
            "title_zh": "请求ID",
            "type": "string"
          }
        },
        "title_en": "响应结果",
        "title_zh": "响应结果",
        "type": "object"
      }
    }
  }
}
