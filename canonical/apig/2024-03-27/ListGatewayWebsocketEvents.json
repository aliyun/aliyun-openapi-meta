  "cmd_full_name": "apig list-gateway-websocket-events",
  "cmd_name": "list-gateway-websocket-events",
  "deprecated": false,
  "description_en": "Queries historical WebSocket events delivered by a dedicated Professional AI gateway to the Simple Log Service (SLS) of the current user. Supports a time range of up to 31 days, conditional filtering, and cursor-based pagination. The results do not represent the online connection status",
  "description_zh": "查询专享 Professional AI 网关投递到当前用户 SLS 的历史 WebSocket 事件，支持最长31天时间范围、条件筛选和游标分页；结果不代表在线连接状态",
  "kebab_example": "",
  "method": "GET",
  "multi_version": false,
  "name": "ListGatewayWebsocketEvents",
  "operation": {
    "action": "ListGatewayWebsocketEvents",
    "api_style": "ROA",
    "api_version": "2024-03-27",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/v1/gateways/{gatewayId}/websocket-observability/events"
  },
