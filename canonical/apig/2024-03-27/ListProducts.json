  "pathPattern": "/himarket/v1/products",
  "product_code": "APIG",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "code": {
            "description_en": "The response status code",
            "description_zh": "响应状态码",
            "example": "Ok",
            "type": "string"
          },
          "data": {
            "description_en": "The response data",
            "description_zh": "响应数据",
            "properties": {
              "content": {
                "description_en": "The list of API products. The list element is named productInfo, and each element contains the information of an API product",
                "description_zh": "API 产品列表，列表元素名为 productInfo，每个元素为一个 API 产品的信息",
                "itemName": "productInfo",
                "items": {
                  "properties": {
                    "agentConfig": {
                      "$ref": "#/components/schemas/HiMarketAgentConfig",
                      "description_en": "The agent-related configurations of the API product. The agentAPIConfig member includes agentProtocols (the list of protocols supported by the agent) and routes (the list of routes)",
                      "description_zh": "API 产品的 Agent 相关配置。成员 agentAPIConfig 下包含 agentProtocols（代理支持的协议列表）与 routes（路由列表）"
                    },
                    "autoApprove": {
                      "description_en": "Indicates whether subscription requests for the API product are automatically approved. This corresponds to the AutoApprove property of the API product resource",
                      "description_zh": "是否自动审批该 API 产品的订阅请求，即 API 产品资源 Product 的 AutoApprove 属性",
                      "type": "boolean"
                    },
                    "categories": {
                      "description_en": "The list of product categories to which the API product belongs. The list element is named category",
                      "description_zh": "该 API 产品所属的产品类别列表，列表元素名为 category",
                      "itemName": "category",
                      "items": {
                        "$ref": "#/components/schemas/HiMarketProductCategory",
                        "description_en": "The information of a single product category, including categoryId (the category ID), name (the category name), description (the category description), and icon (the category icon)",
                        "description_zh": "单个产品类别信息，包含 categoryId（类别 ID）、name（类别名称）、description（类别描述）与 icon（类别图标）"
                      },
                      "type": "array"
                    },
                    "description": {
