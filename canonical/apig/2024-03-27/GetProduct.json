  "deprecated": false,
  "description_en": "Queries the details of a single API product by API product ID and returns information such as the name, description, status, type, documentation, icon, automatic subscription approval setting, MCP, Agent, and model configurations, product capability configurations, and region",
  "description_zh": "按 API 产品 ID 查询单个 API 产品的详情，返回名称、描述、状态、类型、说明文档、图标、是否自动审批订阅、MCP/Agent/模型配置、产品能力配置与所属地域等信息",
  "kebab_example": "aliyun apig get-product --product-id p-xxxxxxxx --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetProduct",
  "operation": {
    "action": "GetProduct",
    "api_style": "ROA",
    "api_version": "2024-03-27",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/himarket/v1/products/{productId}"
  },
  "parameters": [
    {
      "example": "p-xxxxxxxx",
      "help_en": "The API product ID, which is the primary ID of the API product resource and is used to specify the product to query",
      "help_zh": "API 产品 ID，即 API 产品资源的一级 ID，用于指定要查询的产品",
      "location": "path",
      "name": "product_id",
      "options": [
        "--product-id"
      ],
      "raw_name": "productId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/himarket/v1/products/[productId]",
  "product_code": "APIG",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "code": {
            "description_en": "The response status code",
            "description_zh": "响应状态码",
            "example": "Ok",
            "type": "string"
          },
          "data": {
            "description_en": "The response data",
            "description_zh": "响应数据",
            "properties": {
              "agentConfig": {
                "$ref": "#/components/schemas/HiMarketAgentConfig",
                "description_en": "The Agent-related configurations of the API product. The agentAPIConfig member includes agentProtocols, which is a list of protocols supported by the agent, and routes, which is a list of routes",
                "description_zh": "API 产品的 Agent 相关配置。成员 agentAPIConfig 下包含 agentProtocols（代理支持的协议列表）与 routes（路由列表）"
              },
              "autoApprove": {
                "description_en": "Indicates whether subscription requests for the product are automatically approved",
                "description_zh": "是否自动审批该产品的订阅请求",
                "type": "boolean"
              },
              "description": {
                "description_en": "The description of the API product",
                "description_zh": "API 产品描述",
                "example": "提供天气查询能力的 API 产品",
                "type": "string"
              },
              "document": {
                "description_en": "The documentation content of the API product",
                "description_zh": "API 产品的说明文档内容",
                "example": "本产品的调用方式、参数与计费说明。",
                "type": "string"
              },
              "feature": {
                "$ref": "#/components/schemas/HiMarketProductFeature",
                "description_en": "The capability configurations of the API product. Currently, this includes only the modelFeature member for model capabilities, which contains model, maxTokens, temperature, streaming, webSearch, enableThinking, and enableMultiModal",
                "description_zh": "API 产品能力配置。当前只包含 modelFeature（模型能力）成员，其下有 model、maxTokens、temperature、streaming、webSearch、enableThinking、enableMultiModal"
              },
              "icon": {
                "$ref": "#/components/schemas/HiMarketIcon",
                "description_en": "The icon configurations of the API product, which consist of two fields: type for the icon type and value for the icon information",
                "description_zh": "API 产品图标配置，由图标类型（type）与图标信息（value）两个字段组成"
              },
              "mcpConfig": {
                "$ref": "#/components/schemas/HiMarketMcpConfig",
                "description_en": "The MCP-related configurations of the API product. The members include mcpServerName for the MCP server name, tools, mcpServerConfig for the path and domains, and meta for the protocol",
                "description_zh": "API 产品的 MCP 相关配置。成员包含 mcpServerName（MCP Server 名称）、tools、mcpServerConfig（path 与 domains）与 meta（protocol）"
              },
              "modelConfig": {
                "$ref": "#/components/schemas/HiMarketModelConfig",
                "description_en": "The model API-related configurations of the API product. The modelAPIConfig member includes modelCategory for the AI model category, aiProtocols for the list of AI API protocols, and routes for the list of routes",
                "description_zh": "API 产品的模型 API 相关配置。成员 modelAPIConfig 下包含 modelCategory（AI 模型类别）、aiProtocols（AI API 协议列表）与 routes（路由列表）"
              },
              "name": {
                "description_en": "The name of the API product",
                "description_zh": "API 产品名称",
                "example": "weather-query-api",
                "type": "string"
              },
              "productId": {
                "description_en": "The ID of the API product, which is the primary ID of the API product resource. You can use this ID to locate the product in operations such as GetProduct, UpdateProduct, DeleteProduct, PublishProduct, SetProductCategories, and GetProductRef",
                "description_zh": "该 API 产品的 ID，即 API 产品资源的一级 ID。可用于 GetProduct、UpdateProduct、DeleteProduct、PublishProduct、SetProductCategories、GetProductRef 等接口定位该产品",
                "example": "p-xxxxxxxx",
                "type": "string"
              },
              "regionId": {
                "description_en": "The ID of the region to which the API product belongs",
                "description_zh": "该 API 产品所属地域的 ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "status": {
                "description_en": "The status of the API product. Valid values: Pending, Ready, and Published",
                "description_zh": "API 产品状态，取值：Pending、Ready、Published",
                "example": "Published",
                "type": "string"
              },
              "type": {
                "description_en": "The type of the API product. The set of valid values is not declared in the API definition. Refer to the types displayed in the console",
                "description_zh": "API 产品类型。取值集合未在接口定义中声明，请以控制台展示的类型为准",
                "example": "API",
                "type": "string"
              }
            },
            "type": "object"
          },
          "message": {
            "description_en": "The response message",
            "description_zh": "响应消息",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "393E2630-DBE7-5221-AB35-9E740675491A",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "timeout_ms": 32000
}
