  "camel_example": "aliyun hologram POST /api/v1/instances/hgprecn-cn-xxxxxxx/dropUser --region cn-hangzhou --header \"Content-Type=application/json\" --body '{\"userName\":\"p4_234253434\",\"superUser\":\"false\"}'",
