{
  "camel_example": "aliyun hologram POST /api/v1/instances/hgprecn-cn-xxxxxxx/scale --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "hologram scale-instance",
  "cmd_name": "scale-instance",
