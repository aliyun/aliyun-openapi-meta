      "cpu": "cpu",
      "enable_serverless_computing": "enableServerlessComputing",
      "gateway_count": "gatewayCount",
      "scale_type": "scaleType",
      "storage_size": "storageSize"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "update",
    "url": "/api/v1/instances/{instanceId}/scale"
  },
  "parameters": [
    {
