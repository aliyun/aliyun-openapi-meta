{
  "camel_example": "aliyun hologram GET /api/v1/backups --region cn-hangzhou --instanceId 'hgprecn-cn-wwoxxxxx' --backupType redundant --header \"Content-Type=application/json\"",
  "cmd_full_name": "hologram list-backup-data",
  "cmd_name": "list-backup-data",
  "deprecated": false,
  "description_en": "Retrieves a list of snapshots. Each snapshot represents a point-in-time backup that can be used to restore a new instance with its full data",
  "description_zh": "该接口用于查询备份数据列表。一份备份是对实例截止快照时间的全量数据快照，可以通过新购实例完全恢复原来的数据",
  "kebab_example": "aliyun hologram list-backup-data --instance-id hgprecn-cn-wwoxxxxx --backup-type redundant --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListBackupData",
  "operation": {
    "action": "ListBackupData",
    "api_style": "ROA",
    "api_version": "2022-06-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/api/v1/backups"
  },
  "parameters": [
    {
      "example": "hgprecn-cn-wwoxxxxx",
      "help_en": "The instance ID",
      "help_zh": "实例id",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "instanceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "redundant",
      "help_en": "The backup type, used to filter snapshots. If you leave this parameter empty, all snapshots are returned",
      "help_zh": "备份类型。根据类型过滤特定的备份数据，为空则返回所有备份数据",
      "location": "query",
      "name": "backup_type",
      "options": [
        "--backup-type"
      ],
      "raw_name": "backupType",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/backups",
  "product_code": "Hologram",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "BackupDataList": {
            "backendName": "data",
            "description_en": "The list of backups",
            "description_zh": "备份列表",
            "itemName": "data",
            "items": {
              "properties": {
                "BackupType": {
                  "backendName": "backupType",
                  "description_en": "The backup type.\n\nredundant: Stores instance snapshots across zones within the same region.\n\nredundant_remote: Stores instance snapshots across zones in a different region.\n\nfull: Stores an instance snapshot locally.\n\nfull_remote: Stores an instance snapshot remotely.\n\nlocal: It is a filter for local snapshots, not a backup type.\n\nremote: It is a filter for remote snapshots, not a backup type",
                  "description_zh": "备份类型。备份类型总体上分两种：1）本地备份，快照与实例属于相同Region；2）远程备份，快照与实例属于不同Region。\n\nredundant: 本地备份，同城跨可用区多副本存储。\n\nredundant_remote: 远程备份，同城跨可用区多副本存储，redundant类型在异地的拷贝。\n\nfull: 本地备份，单副本存储。\n\nfull_remote: 远程备份，单副本存储，full类型在异地的拷贝。\n\nlocal: 不代表具体备份类型，只用于过滤本地备份数据。\n\nremote: 不代表具体备份类型，只用于过滤远程备份数据",
                  "example": "redundant",
                  "type": "string"
                },
                "ColdDataSize": {
                  "backendName": "coldDataSize",
                  "description_en": "The size of the cold data, in bytes",
                  "description_zh": "冷存数据大小。单位：字节",
                  "example": "32413521",
                  "format": "int64",
                  "type": "integer"
                },
                "DataDesc": {
                  "backendName": "dataDesc",
                  "description_en": "The description of the snapshot. It can be updated",
                  "description_zh": "备份数据描述。可更新",
                  "example": "demo",
                  "type": "string"
                },
                "DataGran": {
                  "backendName": "dataGran",
                  "description_en": "The backup granularity",
                  "description_zh": "备份粒度",
                  "example": "instance",
                  "type": "string"
                },
                "DataSize": {
                  "backendName": "dataSize",
                  "description_en": "The size of the snapshot, in bytes",
                  "description_zh": "备份数据大小。单位：字节",
                  "example": "76085723136",
                  "format": "int64",
                  "type": "integer"
                },
                "DataTime": {
                  "backendName": "dataTime",
                  "description_en": "The time when the data snapshot was created. For the format, see StartTime",
                  "description_zh": "数据快照时间。格式参考StartTime",
                  "example": "2024-10-28T12:23:37.000+00:00",
                  "type": "string"
                },
                "EndTime": {
                  "backendName": "endTime",
                  "description_en": "The time when the backup was completed. For the format, see StartTime",
                  "description_zh": "备份结束时间。格式参考StartTime",
                  "example": "2024-10-28T12:27:34.000+00:00",
                  "type": "string"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "The unique snapshot ID",
                  "description_zh": "备份唯一Id",
                  "example": "1780805690994479105",
                  "format": "int64",
                  "type": "integer"
                },
                "InstanceId": {
                  "backendName": "instanceId",
                  "description_en": "The instance ID",
                  "description_zh": "实例id",
                  "example": "hgpostcn-cn-pe33jdxxxxx",
                  "type": "string"
                },
                "InstanceName": {
                  "backendName": "databaseName",
                  "description_en": "The instance name",
                  "description_zh": "实例名称",
                  "example": "my-hologres-dw",
                  "type": "string"
                },
                "InstanceRegion": {
                  "backendName": "instanceRegion",
                  "description_en": "The region where the instance resides",
                  "description_zh": "实例所在地域",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "InstanceType": {
                  "backendName": "instanceType",
                  "description_en": "The instance type",
                  "description_zh": "实例类型",
                  "example": "Warehouse",
                  "type": "string"
                },
                "InstanceZoneId": {
                  "backendName": "instanceZoneId",
                  "description_en": "The zone where the instance resides",
                  "description_zh": "实例所在可用区",
                  "example": "cn-hangzhou-j",
                  "type": "string"
                },
                "SnapshotRegion": {
                  "backendName": "snapshotRegion",
                  "description_en": "The region where the snapshot is stored",
                  "description_zh": "备份数据所在地域",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "SnapshotZoneId": {
                  "backendName": "snapshotZoneId",
                  "description_en": "The zone where backup snapshot(s). If you use zone-redundant storage, the data is stored across multiple zones. This parameter returns one of those zones",
                  "description_zh": "备份数据所在可用区。其中，同城冗余存储保存在多可用区，这里是其中一个",
                  "example": "cn-hangzhou-j",
                  "type": "string"
                },
                "StartTime": {
                  "backendName": "startTime",
                  "description_en": "The timestamp when the backup began. Format: `YYYY-MM-DDTHH:mm:ss.SSSTZ` (UTC+8). This format is used for all time-related parameters",
                  "description_zh": "备份开始时间。北京时间，格式YYYY-MM-DDTHH:mm:ss.SSSTZ。下同",
                  "example": "2024-10-28T11:19:56.000+00:00",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The backup status",
                  "description_zh": "备份状态",
                  "example": "completed",
                  "type": "string"
                },
                "TriggerType": {
                  "backendName": "triggerType",
                  "description_en": "The backup trigger type",
                  "description_zh": "触发类型",
                  "example": "scheduled",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求Id",
            "example": "4AA0C48F-B5BB-5FF9-A43B-6B91E0715D46",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
