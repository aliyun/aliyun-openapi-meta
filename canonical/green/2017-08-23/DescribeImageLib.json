                  "description_zh": "图库适用的服务模块。取值：\nopen_api：用于内容检测API\nwebsite：用于站点检测",
                  "example": "open_api",
                  "type": "string"
                },
                "Source": {
                  "backendName": "source",
                  "description_en": "The source of the image library. Valid values:\nmanual: manually created\nfeedback: automatic creation based on user feedback results",
                  "description_zh": "图库的来源。取值：-manual：手动创建-feedback：根据用户反馈的结果自动创建",
