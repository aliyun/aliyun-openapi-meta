            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求的ID",
            "example": "AAAAAA-BBBB-CCCCC-DDDD-EEEEEEEE****",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "totalCount",
            "description_en": "The total number of image libraries",
            "description_zh": "总数量",
            "example": "2",
            "format": "int32",
            "type": "integer"
          }
