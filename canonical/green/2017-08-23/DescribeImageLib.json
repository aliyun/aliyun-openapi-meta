                  "format": "int32",
                  "type": "integer"
                },
                "ModifiedTime": {
                  "backendName": "modifiedTime",
                  "description_en": "The modification time in the format of YYYY-MM-DD HH:mm:ss (default time zone: UTC+08:00)",
