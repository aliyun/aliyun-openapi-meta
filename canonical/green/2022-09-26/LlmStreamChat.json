{
  "cmd_full_name": "green llm-stream-chat",
  "cmd_name": "llm-stream-chat",
  "deprecated": false,
  "description_en": "Calls a large language model in streaming mode using the SSE interface",
  "description_zh": "使用SSE接口流式调用大模型",
  "kebab_example": "aliyun green llm-stream-chat --messages 'content_:_你好_,_role_:_user' --temperature 0.5 --topp 0.5 --type image --channel guardCustomTest --api-version 2022-09-26 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "LlmStreamChat",
  "operation": {
    "action": "LlmStreamChat",
    "api_style": "RPC",
    "api_version": "2022-09-26",
    "content_type": "application/x-www-form-urlencoded",
    "is_sse": true,
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": "/portal/llm/streamChat"
  },
  "parameters": [
    {
      "example": "[{\\\"content\\\":\\\"你好\\\",\\\"role\\\":\\\"user\\\"}]",
      "help_en": "The conversation messages",
      "help_zh": "对话信息",
      "location": "formData",
      "name": "messages",
      "options": [
        "--messages"
      ],
      "raw_name": "Messages",
      "required": false,
      "type": "any"
    },
    {
      "example": "0.5",
      "help_en": "The temperature value of the large language model",
      "help_zh": "大模型温度值",
      "location": "formData",
      "name": "temperature",
      "options": [
        "--temperature"
      ],
      "raw_name": "Temperature",
      "required": false,
      "type": "float"
    },
    {
      "example": "0.5",
      "help_en": "The top_p parameter that controls the randomness of the large language model output",
      "help_zh": "控制大模型输出随机性的top p参数",
      "location": "formData",
      "name": "topp",
      "options": [
        "--topp"
      ],
      "raw_name": "TopP",
      "required": false,
      "type": "float"
    },
    {
      "example": "image",
      "help_en": "The conversation type",
      "help_zh": "对话类型",
      "location": "formData",
      "name": "type",
      "options": [
        "--type"
      ],
      "raw_name": "Type",
      "required": false,
      "type": "string"
    },
    {
      "example": "guardCustomTest",
      "help_en": "channel",
      "help_zh": "channel",
      "location": "formData",
      "name": "channel",
      "options": [
        "--channel"
      ],
      "raw_name": "Channel",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/portal/llm/streamChat",
  "product_code": "Green",
  "protocol": "HTTPS|SSE",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Choices": {
            "backendName": "choices",
            "description_en": "The list of model generation results",
            "description_zh": "模型生成结果列表",
            "itemName": "Choice",
            "items": {
              "description_en": "The model generation result",
              "description_zh": "模型生成结果",
              "properties": {
                "Delta": {
                  "backendName": "delta",
                  "description_en": "The incremental content object",
                  "description_zh": "增量内容对象",
                  "properties": {
                    "Content": {
                      "backendName": "content",
                      "description_en": "The text content generated in real time",
                      "description_zh": "实时生成的文本内容",
                      "example": "我是Deepseek-V3，有什么可以帮你",
                      "type": "string"
                    },
                    "Role": {
                      "backendName": "role",
                      "description_en": "The role identifier",
                      "description_zh": "角色标识",
                      "example": "assistant",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "FinishReason": {
                  "backendName": "finish_reason",
                  "description_en": "During streaming output, this value is null while content is being generated. When generation is complete, the value is stop if the generation ended due to a stop token",
                  "description_zh": "如果是流式输出，正在生成时为null，生成结束时如果由于停止token导致则为stop",
                  "example": "stop",
                  "type": "string"
                },
                "Index": {
                  "backendName": "index",
                  "description_en": "The stream sequence number",
                  "description_zh": "流序号",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "Logprobs": {
                  "backendName": "logprobs",
                  "description_en": "The token probability information",
                  "description_zh": "Token概率信息",
                  "example": "null",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "Created": {
            "backendName": "created",
            "description_en": "The timestamp when the session was created",
            "description_zh": "会话创建时间戳",
            "example": "1750990728",
            "format": "int64",
            "type": "integer"
          },
          "Error": {
            "backendName": "error",
            "description_en": "The fault information content in the streaming response",
            "description_zh": "流式响应错误信息内容",
            "properties": {
              "Code": {
                "backendName": "code",
                "description_en": "The error code",
                "description_zh": "错误码",
                "example": "data_inspection_failed",
                "type": "string"
              },
              "Message": {
                "backendName": "message",
                "description_en": "The error message",
                "description_zh": "错误信息",
                "example": "Input data may contain inappropriate content.",
                "type": "string"
              },
              "Param": {
                "backendName": "param",
                "description_en": "The parameter that caused the error",
                "description_zh": "引发错误的参数",
                "example": "null",
                "type": "string"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The error type",
                "description_zh": "错误类型",
                "example": "data_inspection_failed",
                "type": "string"
              }
            },
            "type": "object"
          },
          "Id": {
            "backendName": "id",
            "description_en": "The unique ID of this session",
            "description_zh": "本次会话唯一ID",
            "example": "chatcmpl-777bce52-93d3-9f8c-89c3-e99884f4f57f",
            "type": "string"
          },
          "Model": {
            "backendName": "model",
            "description_en": "The model identifier",
            "description_zh": "模型标识",
            "example": "deepseek-v3",
            "type": "string"
          },
          "Object": {
            "backendName": "object",
            "description_en": "The response type",
            "description_zh": "响应类型",
            "example": "chat.completion.chunk",
            "type": "string"
          },
          "RequestId": {
            "backendName": "request_id",
            "description_en": "The unique request ID",
            "description_zh": "唯一请求ID",
            "example": "21d296d6-594e-97de-812f-925ec6e05673",
            "type": "string"
          },
          "SystemFingerprint": {
            "backendName": "system_fingerprint",
            "description_en": "The system fingerprint",
            "description_zh": "系统指纹",
            "example": "null",
            "type": "string"
          },
          "Usage": {
            "backendName": "usage",
            "description_en": "The token usage information",
            "description_zh": "Token使用情况",
            "example": "null",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
