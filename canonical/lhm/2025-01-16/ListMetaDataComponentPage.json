        "description_zh": "分页查询结果对象：totalCount 为符合条件的记录总数，pageIndex 与 pageSize 回显本次分页参数，data 为当前页数据源列表，success 表示调用是否成功，失败时由 errCode 与 errMessage 给出错误编码与错误信息，requestId 唯一标识本次调用，排查问题时请提供该值",
        "properties": {
          "data": {
            "backendName": "data",
            "description_zh": "接口返回的数据列表，元素结构参见下级子字段说明",
            "itemName": "data",
            "items": {
              "description_zh": "单个数据源对象，字段含义参见下级子字段说明",
              "properties": {
                "componentType": {
                  "backendName": "componentType",
                  "description_zh": "入口组件类型。部分接口中作为 1.1.0 向下兼容字段使用：0-源端，1-目标端",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "createTime": {
                  "backendName": "createTime",
                  "description_zh": "创建时间（表或分区的创建时间）",
                  "example": "2026-01-16T10:00:00Z",
                  "type": "string"
                },
                "dsConfig": {
                  "backendName": "dsConfig",
                  "description_zh": "数据源配置，JSON 字符串形式，结构由各 dsType 自行定义，使用时需先做 JSON 解析；token 等敏感字段在响应中会脱敏",
                  "example": "{\"endpoint\":\"...\",\"token\":\"******\"}",
                  "type": "string"
                },
                "dsDesc": {
                  "backendName": "dsDesc",
                  "description_zh": "数据源描述",
                  "example": "数据源描述",
                  "type": "string"
                },
                "dsId": {
                  "backendName": "dsId",
                  "description_zh": "数据源业务 ID（外部 ID，可能与主键 id 相同）",
                  "example": "290",
                  "type": "string"
                },
                "dsName": {
                  "backendName": "dsName",
                  "description_zh": "数据源名称，支持精确匹配或模糊匹配",
                  "example": "test_ds318_hangzhou_0428",
                  "type": "string"
                },
                "dsStatus": {
                  "backendName": "dsStatus",
                  "description_zh": "数据源连通状态：0-未测试，1-连通正常，2-连通失败，-1-不支持连通性测试",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "dsType": {
                  "backendName": "dsType",
                  "description_zh": "数据源类型，例如 Hive、MaxCompute 等",
                  "example": "Hive",
                  "type": "string"
                },
                "dsVersion": {
                  "backendName": "dsVersion",
                  "description_zh": "数据源版本号",
                  "example": "3.2.0",
                  "type": "string"
                },
                "expired": {
                  "backendName": "expired",
                  "description_zh": "数据源是否过期：true-已过期，false-未过期",
                  "example": "false",
                  "type": "boolean"
                },
                "id": {
                  "backendName": "id\n",
                  "description_zh": "主键 ID，唯一标识一条记录",
                  "example": "10001",
                  "format": "int64",
                  "type": "integer"
                },
                "profilingJob": {
                  "backendName": "profilingJob",
                  "description_zh": "数据探查任务信息，包含探查任务状态、调度 ID、探查规则与探查类型；数据源未关联探查任务时为空",
                  "properties": {
                    "componentId": {
                      "backendName": "componentId",
                      "description_zh": "组件 ID，即数据源组件的主键标识",
                      "example": "12345",
                      "format": "int64",
                      "type": "integer"
                    },
                    "createTime": {
                      "backendName": "createTime",
                      "description_zh": "创建时间（表或分区的创建时间）",
                      "example": "2026-01-16T10:00:00Z",
                      "type": "string"
                    },
                    "id": {
                      "backendName": "id",
                      "description_zh": "主键 ID，唯一标识一条记录",
                      "example": "10001",
                      "format": "int64",
                      "type": "integer"
                    },
                    "jobDesc": {
                      "backendName": "jobDesc",
                      "description_zh": "探查任务描述",
                      "example": "探查任务描述",
                      "type": "string"
                    },
                    "jobName": {
                      "backendName": "jobName",
                      "description_zh": "任务名称（探查任务名称）",
                      "example": "job_name",
                      "type": "string"
                    },
                    "lastBatchId": {
                      "backendName": "lastBatchId",
                      "description_zh": "最近一次批次号（最近一次探查任务批次号）",
                      "example": "20001",
                      "type": "string"
                    },
                    "profilingEnable": {
                      "backendName": "profilingEnable",
                      "description_zh": "探查任务状态：0-未开始，1-执行中，2-已停止",
                      "example": "1",
                      "format": "int32",
                      "type": "integer"
                    },
                    "profilingPermission": {
                      "backendName": "profilingPermission",
                      "description_zh": "探查权限：0-只读链接，1-client",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "profilingRule": {
                      "backendName": "profilingRule",
                      "description_zh": "定时探查的 cron 表达式，profilingType 为 CRON 时生效",
                      "example": "0 0 2 * * ?",
                      "type": "string"
                    },
                    "profilingType": {
                      "backendName": "profilingType",
                      "description_zh": "探查策略（定时类型）：0-每天，1-CRON",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "schedulerToken": {
                      "backendName": "schedulerToken",
                      "description_zh": "调度 ID，探查任务在调度侧的唯一标识",
                      "example": "12345",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "errCode": {
            "backendName": "errCode",
            "description_zh": "错误码，调用成功时为空字符串",
            "example": "Success",
            "type": "string"
          },
          "errMessage": {
            "backendName": "errMessage",
            "description_zh": "错误信息，调用成功时为空字符串",
            "example": "success",
            "type": "string"
          },
          "pageIndex": {
            "backendName": "pageIndex",
            "description_zh": "页码，从 1 开始",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "pageSize": {
            "backendName": "pageSize",
            "description_zh": "分页大小，即每页返回的记录数",
            "example": "20",
            "format": "int32",
            "type": "integer"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID，用于定位和排查本次调用问题",
            "example": "4C467B38-3910-4477-9B0B-6963D83B4E72",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "调用是否成功：true 表示成功，false 表示失败，失败时结合 errCode 与 errMessage 排查",
            "example": "true",
            "type": "boolean"
          },
          "totalCount": {
            "backendName": "totalCount",
            "description_zh": "满足查询条件的记录总数，用于分页",
            "example": "100",
            "format": "int32",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
