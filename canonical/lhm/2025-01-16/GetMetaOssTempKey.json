    "api_version": "2025-01-16",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": "/api/v2/meta/data-component/okss-services/file-job/sts"
  },
  "parameters": [],
  "pathPattern": "/api/v2/meta/data-component/okss-services/file-job/sts",
  "product_code": "LHM",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_zh": "Schema of Response",
        "properties": {
          "data": {
            "backendName": "data",
            "description_zh": "接口返回的数据主体，字段结构参见下级子字段说明",
            "properties": {
              "ak": {
                "backendName": "ak",
                "description_zh": "临时 AccessKey ID（STS Token），与 securityToken 配合完成 OSS 直传的身份认证。属敏感凭证，请勿硬编码或打印到日志",
                "example": "STS.NY6bbCNqNPpt5GcSTEzB6Lahn",
                "type": "string"
              },
              "bucket": {
                "backendName": "bucket",
                "description_zh": "OSS Bucket 名称",
                "example": "lhm-pre-cn-hangzhou",
                "type": "string"
              },
              "dir": {
                "backendName": "dir",
                "description_zh": "允许上传的 OSS 目录前缀，必须以 / 结尾；上传时对象 Key 必须以此为前缀，否则会被 OSS 拒绝",
                "example": "teleport/meta/1063934947625635/",
                "type": "string"
              },
              "endpoint": {
                "backendName": "endpoint",
                "description_zh": "OSS Bucket 所在区域的访问域名（Endpoint）",
                "example": "oss-cn-hangzhou.aliyuncs.com",
                "type": "string"
              },
              "expire": {
                "backendName": "expire",
                "description_zh": "凭证过期时间戳，Unix 秒级。使用前应校验当前时间是否已过期，过期需重新获取",
                "example": "1779966540",
                "format": "int64",
                "type": "integer"
              },
              "policy": {
                "backendName": "policy",
                "description_zh": "Base64 编码的上传策略，限定文件大小、路径前缀等约束，解码后为 JSON 字符串",
                "example": "eyJleHBpcmF0aW9uIjoiMjAyNi0wNS0yOFQxMToxMjo1OC43MzZaIiwiY29uZGl0aW9ucyI6W1siY29udGVudC1sZW5ndGgtcmFuZ2UiLDAsMTA0ODU3NjAwXSxbInN0YXJ0cy13aXRoIiwiJGtleSIsInRlbGVwb3J0L21ldGEvMTA2MzkzNDk0NzYyNTYzNS8iXV19",
                "type": "string"
              },
              "securityToken": {
                "backendName": "securityToken",
                "description_zh": "STS 临时安全令牌，与 ak 配合使用进行身份认证，仅在 STS 认证模式下返回。属敏感凭证，请勿硬编码或打印到日志",
                "example": "CAIS3QJ1q6Ft5B2yfSjIr5rsAOjugKcY9YqlSRPBlWEFZN1V3fD6gzz2IHhMfHFvA",
                "type": "string"
              },
              "signature": {
                "backendName": "signature",
                "description_zh": "基于 policy 计算的签名，OSS 服务端据此验证上传请求的合法性",
                "example": "ydDYrWUzfKNM6slVhjPhUx83qUo=",
                "type": "string"
              }
            },
            "type": "object"
          },
          "errCode": {
            "backendName": "errCode",
            "description_zh": "错误码，调用成功时为空字符串",
            "example": "Success",
            "type": "string"
          },
          "errMessage": {
            "backendName": "errMessage",
            "description_zh": "错误信息，调用成功时为空字符串",
            "example": "success",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "调用是否成功：true 表示成功，false 表示失败，失败时结合 errCode 与 errMessage 排查",
            "type": "boolean"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
