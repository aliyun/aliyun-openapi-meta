{
  "camel_example": "",
  "cmd_full_name": "accessanalyzer get-analyzer",
  "cmd_name": "get-analyzer",
  "deprecated": false,
  "description_en": "Queries the details of an analyzer with a specified name",
  "description_zh": "查询指定名称的Analyzer详细信息",
  "kebab_example": "aliyun accessanalyzer get-analyzer --analyzer-name analyzer1 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetAnalyzer",
  "operation": {
    "action": "GetAnalyzer",
    "api_style": "RPC",
    "api_version": "2024-02-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "analyzer1",
      "help_en": "The analyzer name",
      "help_zh": "分析器名称",
      "location": "query",
      "name": "analyzer_name",
      "options": [
        "--analyzer-name"
      ],
      "raw_name": "AnalyzerName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "AccessAnalyzer",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Analyzer": {
            "backendName": "analyzer",
            "description_en": "The analyzer information",
            "description_zh": "分析器信息",
            "properties": {
              "AnalyzerError": {
                "backendName": "analyzerError",
                "description_en": "The analyzer error message",
                "description_zh": "分析器错误信息",
                "properties": {
                  "Code": {
                    "backendName": "code",
                    "description_en": "The error code",
                    "description_zh": "错误码",
                    "example": "DELEGATED_ADMINISTRATOR_DEREGISTERED",
                    "type": "string"
                  },
                  "Message": {
                    "backendName": "message",
                    "description_en": "The error message",
                    "description_zh": "错误信息",
                    "example": "Access denied",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "Arn": {
                "backendName": "arn",
                "description_en": "The ARN of the analyzer",
                "description_zh": "分析器的ARN",
                "example": "acs:accessanalyzer:cn-hangzhou:123456789012:analyzer/analyser1",
                "mappingResourcePropertyName": "$.AnalyzerArn",
                "type": "string"
              },
              "Configuration": {
                "backendName": "analyzerConfiguration",
                "description_en": "The configuration of the analyzer instance",
                "description_zh": "Analyzer 实例的配置信息",
                "properties": {
                  "OverPrivilegedConfiguration": {
                    "backendName": "overPrivilegedConfiguration",
                    "description_en": "The configuration for the OverPrivileged type",
                    "description_zh": "OverPrivileged 类型的配置信息",
                    "properties": {
                      "UnusedAccessAge": {
                        "backendName": "unusedAccessAge",
                        "description_en": "The time period used to calculate unused access",
                        "description_zh": "计算闲置访问的时间周期",
                        "example": "90",
                        "format": "int32",
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "CreatedTime": {
                "backendName": "createdTime",
                "description_en": "The time when the analyzer was created",
                "description_zh": "创建时间",
                "example": "2026-05-18T08:07:24Z",
                "mappingResourcePropertyName": "$.CreateTime",
                "type": "string"
              },
              "LastAnalyzedResource": {
                "backendName": "lastAnalyzedResource",
                "description_en": "The most recently analyzed resource by the analyzer",
                "description_zh": "最近一个被Analyzer分析的资源",
                "properties": {
                  "AnalyzedTime": {
                    "backendName": "analyzedTime",
                    "description_en": "The time when the last analysis was performed",
                    "description_zh": "最后一次运行分析的时间",
                    "example": "2026-05-18T08:07:24Z",
                    "mappingResourcePropertyName": "$.LastResourceAnalyzedTime",
                    "type": "string"
                  },
                  "ResourceArn": {
                    "backendName": "resourceArn",
                    "description_en": "The ARN of the most recently analyzed resource by the analyzer",
                    "description_zh": "最近一个被Analyzer分析的资源Arn",
                    "example": "acs:ram::1944809621972557:role/testrole",
                    "mappingResourcePropertyName": "$.LastResourceAnalyzed",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The analyzer name",
                "description_zh": "分析器名称",
                "example": "analyzer1",
                "mappingResourcePropertyName": "$.AnalyzerName",
                "type": "string"
              },
              "Scope": {
                "backendName": "scope",
                "description_en": "The scan scope of the analyzer. Valid values:\nAccount: account.\nResourceDirectory: resource directory",
                "description_zh": "Analyzer的扫描范围，有效值：Account（账号）、ResourceDirectory（资源目录）",
                "example": "Account",
                "mappingResourcePropertyName": "$.Scope",
                "type": "string"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The status of the analyzer. Valid values:\nActive: The analyzer is running.\nCreating: The analyzer is being created.\nFailed: The analyzer failed.\nDisabled: The analyzer is disabled",
                "description_zh": "分析器的状态，有效值：Active（运行中），Creating（创建中），Failed（失败），Disabled（不可用）",
                "example": "Active",
                "mappingResourcePropertyName": "$.Status",
                "type": "string"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type of the analyzer. Valid values:\nExternalAccess: external access.\nOverPrivileged: over-privileged access",
                "description_zh": "Analyzer的类型，有效值：ExternalAccess（外部访问）、OverPrivileged（过度授权）",
                "example": "ExternalAccess",
                "mappingResourcePropertyName": "$.Type",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "29DC0726-CDA5-5D68-9723-5F3A044CB8ED",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
