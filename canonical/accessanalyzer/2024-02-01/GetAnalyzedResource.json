{
  "camel_example": "",
  "cmd_full_name": "accessanalyzer get-analyzed-resource",
  "cmd_name": "get-analyzed-resource",
  "deprecated": false,
  "description_en": "Queries the analysis details of a specified resource in the Analyzer",
  "description_zh": "查询指定资源在Analyzer中的分析详情",
  "kebab_example": "aliyun accessanalyzer get-analyzed-resource --resource-arn acs:ram::1944809621972557:role/testrole --analyzer-name MyAnalyzer --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetAnalyzedResource",
  "operation": {
    "action": "GetAnalyzedResource",
    "api_style": "RPC",
    "api_version": "2024-02-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": ""
  },
  "parameters": [
    {
      "example": "acs:ram::1944809621972557:role/testrole",
      "help_en": "The resource ARN",
      "help_zh": "资源ARN",
      "location": "query",
      "name": "resource_arn",
      "options": [
        "--resource-arn"
      ],
      "raw_name": "ResourceArn",
      "required": true,
      "type": "string"
    },
    {
      "example": "MyAnalyzer",
      "help_en": "The analyzer name",
      "help_zh": "分析器名称",
      "location": "query",
      "name": "analyzer_name",
      "options": [
        "--analyzer-name"
      ],
      "raw_name": "AnalyzerName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "AccessAnalyzer",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "E50DF194-4173-5ECF-A2C1-EB2BF7C54868",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Resource": {
            "backendName": "resource",
            "description_en": "The details of the analyzed resource",
            "description_zh": "被分析资源的详情",
            "properties": {
              "Actions": {
                "backendName": "actions",
                "description_en": "The list of actions that external principals are allowed to perform on the resource. This parameter is returned only when an external access finding exists for the resource",
                "description_zh": "外部主体被允许对该资源执行的操作列表。仅当资源存在外部访问 Finding 时返回",
                "itemName": "Actions",
                "items": {
                  "description_en": "The RAM permission action performed on the resource",
                  "description_zh": "对该资源执行的 RAM 权限动作",
                  "example": "oss:GetBucket",
                  "type": "string"
                },
                "type": "array"
              },
              "AnalyzedTime": {
                "backendName": "analyzedTime",
                "description_en": "The time when the resource was last analyzed",
                "description_zh": "资源最近一次被分析的时间",
                "example": "2026-05-19T08:02:36Z",
                "type": "string"
              },
              "CreatedTime": {
                "backendName": "createdTime",
                "description_en": "The time when the finding for the resource was created",
                "description_zh": "资源对应Finding创建的时间",
                "example": "2026-05-18T14:04:55Z",
                "type": "string"
              },
              "Error": {
                "backendName": "error",
                "description_en": "The reason for the error if the analysis fails",
                "description_zh": "如果分析报错，则为报错的原因",
                "example": "ACCESS_DENIED",
                "type": "string"
              },
              "IsPublic": {
                "backendName": "isPublic",
                "description_en": "Indicates whether all external access is allowed",
                "description_zh": "是否允许所有外部访问",
                "example": "true",
                "type": "boolean"
              },
              "ResourceArn": {
                "backendName": "resourceArn",
                "description_en": "The resource ARN",
                "description_zh": "资源Arn",
                "example": "acs:ram::1944809621972557:role/testrole",
                "type": "string"
              },
              "ResourceOwnerAccount": {
                "backendName": "resourceOwnerAccount",
                "description_en": "The ID of the account that owns the resource",
                "description_zh": "资源所属的账号 ID",
                "example": "1944809621972557",
                "type": "string"
              },
              "ResourceType": {
                "backendName": "resourceType",
                "description_en": "The resource type",
                "description_zh": "资源类型",
                "example": "ACS::RAM::Role",
                "type": "string"
              },
              "SourceTypes": {
                "backendName": "SourceTypes",
                "description_en": "The exposure paths. This parameter has a value only when the resource type is OSS Bucket",
                "description_zh": "暴露的途径，当资源类型是OSS Bucket时有值",
                "itemName": "SourceType",
                "items": {
                  "description_en": "The exposure path",
                  "description_zh": "暴露的途径",
                  "example": "BUCKET_ACL",
                  "type": "string"
                },
                "type": "array"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The current status of the finding generated from the analyzed resource",
                "description_zh": "从分析的资源生成的Finding的当前状态",
                "example": "Active",
                "type": "string"
              },
              "UpdatedTime": {
                "backendName": "updatedTime",
                "description_en": "The time when the finding for the resource was updated",
                "description_zh": "资源对应Finding更新的时间",
                "example": "2026-05-19T08:02:36Z",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
