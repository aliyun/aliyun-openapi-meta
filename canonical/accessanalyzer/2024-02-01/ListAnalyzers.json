                    "Code": {
                      "backendName": "code",
                      "description_en": "The error code",
                      "description_zh": "错误Code",
                      "example": "RESOURCE_DIRECTORY_DELETED",
                      "type": "string"
                    },
                    "Message": {
                      "backendName": "message",
                      "description_en": "The error message",
