                  "mappingResourcePropertyName": "$.Scope",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The current status of the analyzer",
                  "description_zh": "分析器的当前状态",
                  "example": "Active",
                  "mappingResourcePropertyName": "$.Status",
                  "type": "string"
                },
                "Type": {
                  "backendName": "type",
                  "description_en": "The type of the analyzer",
