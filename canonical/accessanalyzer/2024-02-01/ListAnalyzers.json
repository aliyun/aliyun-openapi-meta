              "title_en": "AnalyzerItemType",
              "title_zh": "AnalyzerItemType",
              "type": "object"
            },
            "title_en": "数组，返回示例目录。",
            "title_zh": "数组，返回示例目录。",
            "type": "array"
          },
          "NextToken": {
            "backendName": "nextToken",
            "description_en": "The pagination token",
            "description_zh": "分页 Token",
            "example": "eyJpbmRleCI6IjIifQ==",
            "format": "int32",
            "title_en": "当总结果个数大于MaxResults时，用于翻页的token。",
            "title_zh": "当总结果个数大于MaxResults时，用于翻页的token。",
            "type": "integer"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "A1B2C3D4-E5F6-7890-ABCD-EF1234567890",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
