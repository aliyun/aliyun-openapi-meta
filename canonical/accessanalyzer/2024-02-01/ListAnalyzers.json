                  "mappingResourcePropertyName": "$.AnalyzerName",
                  "type": "string"
                },
                "Scope": {
                  "backendName": "scope",
                  "description_en": "The scan scope of the analyzer",
                  "description_zh": "Analyzer的扫描范围",
