{
  "camel_example": "",
  "cmd_full_name": "accessanalyzer create-analyzer",
  "cmd_name": "create-analyzer",
  "deprecated": false,
  "description_en": "Creates an Analyzer to perform over-privilege or external access analysis on an account or resource directory",
  "description_zh": "创建一个新的Analyzer对账号或资源目录进行过度授权或外部访问分析",
  "kebab_example": "aliyun accessanalyzer create-analyzer --analyzer-name MyAnalyzer --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "CreateAnalyzer",
  "operation": {
    "action": "CreateAnalyzer",
    "api_style": "RPC",
    "api_version": "2024-02-01",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "MyAnalyzer",
      "help_en": "The name of the analyzer",
      "help_zh": "分析器名称",
      "location": "formData",
      "max_length": "255",
      "min_length": "1",
      "name": "analyzer_name",
      "options": [
        "--analyzer-name"
      ],
      "pattern": "^[0-9a-zA-Z_-]+$",
      "raw_name": "AnalyzerName",
      "required": true,
      "type": "string"
    },
    {
      "enum": [
        "ExternalAccess",
        "OverPrivileged"
      ],
      "example": "ExternalAccess",
      "help_en": "The type of the Analyzer. Valid values:\nExternalAccess: external access.\nOverPrivileged: over-privilege",
      "help_zh": "Analyzer类型，合法值：ExternalAccess（外部访问）、OverPrivileged（过度授权）",
      "location": "formData",
      "name": "type",
      "options": [
        "--type"
      ],
      "raw_name": "Type",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "Account",
        "ResourceDirectory"
      ],
      "example": "Account",
      "help_en": "The scan scope of the Analyzer. Valid values:\nAccount: account.\nResourceDirectory: resource directory",
      "help_zh": "Analyzer扫描范围，合法值：Account（账号）、ResourceDirectory（资源目录）",
      "location": "formData",
      "name": "scope",
      "options": [
        "--scope"
      ],
      "raw_name": "Scope",
      "required": false,
      "type": "string"
    },
    {
      "fields": [
        {
          "fields": [
            {
              "example": "90",
              "help_en": "The unused access period. Default value: 90. Valid values: 1 to 365. Unit: days",
              "help_zh": "闲置访问周期，默认90天，支持1到365天",
              "maximum": "365",
              "minimum": "1",
              "name": "unused_access_age",
              "options": [
                "--unused-access-age"
              ],
              "raw_name": "UnusedAccessAge",
              "required": false,
              "type": "int"
            }
          ],
          "help_en": "The configuration information for the OverPrivileged type",
          "help_zh": "OverPrivileged 类型的配置信息",
          "name": "over_privileged_configuration",
          "options": [
            "--over-privileged-configuration"
          ],
          "raw_name": "OverPrivilegedConfiguration",
          "required": false,
          "type": "object"
        }
      ],
      "help_en": "The configuration information of the Analyzer instance",
      "help_zh": "Analyzer 实例的配置信息",
      "location": "formData",
      "name": "configuration",
      "options": [
        "--configuration"
      ],
      "param_style": "flat",
      "raw_name": "Configuration",
      "required": false,
      "type": "object"
    }
  ],
  "pathPattern": "",
  "product_code": "AccessAnalyzer",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
