  "cmd_full_name": "accessanalyzer get-finding-recommendation",
  "cmd_name": "get-finding-recommendation",
  "deprecated": false,
  "description_en": "Queries the governance recommendations generated for a specified finding",
  "description_zh": "查询为指定Finding生成的治理建议方案",
  "kebab_example": "aliyun accessanalyzer get-finding-recommendation --analyzer-name analyzer-example --finding-id fffdab46-bf80-4d2e-a9c5-cbcfa091f44a --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetFindingRecommendation",
  "operation": {
    "action": "GetFindingRecommendation",
    "api_style": "RPC",
    "api_version": "2024-02-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": ""
  },
  "parameters": [
    {
      "example": "analyzer-example",
      "help_en": "The analyzer name",
      "help_zh": "分析器名称",
      "location": "query",
      "name": "analyzer_name",
      "options": [
        "--analyzer-name"
      ],
      "raw_name": "AnalyzerName",
      "required": true,
      "type": "string"
    },
    {
      "example": "fffdab46-bf80-4d2e-a9c5-cbcfa091f44a",
      "help_en": "The ID of the finding",
      "help_zh": "Finding 的 ID",
      "location": "query",
      "name": "finding_id",
      "options": [
        "--finding-id"
      ],
      "raw_name": "FindingId",
      "required": true,
      "type": "string"
    },
    {
      "example": "20",
      "help_en": "The maximum number of governance recommendations to return in a single request",
      "help_zh": "单次请求返回的最大治理建议数",
      "location": "query",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "MaxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "eyJpbmRleCI6IjIifQ==",
      "help_en": "The pagination token used to retrieve the next page of data. If this parameter is empty, the first page is returned",
      "help_zh": "分页标记，用于获取下一页的数据。如果为空，则表示是第一页",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "NextToken",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "AccessAnalyzer",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "CompletedTime": {
            "backendName": "completedTime",
            "description_en": "The time when the recommendation was completed",
            "description_zh": "建议方案完成时间",
            "example": "2024-03-01T10:00:05Z16Z",
            "type": "string"
          },
          "Error": {
            "backendName": "error",
            "description_en": "The fault error message of the recommendation",
            "description_zh": "建议方案错误信息",
            "properties": {
              "Code": {
                "backendName": "code",
                "description_en": "The error code",
                "description_zh": "错误的 Code",
                "example": "InternalError",
                "type": "string"
              },
              "Message": {
                "backendName": "message",
                "description_en": "The error message",
                "description_zh": "错误的 Message",
                "example": "The request processing has failed due to some unknown error.",
                "type": "string"
              }
            },
            "type": "object"
          },
          "NextToken": {
            "backendName": "nextToken",
            "description_en": "The pagination token. This value is returned when more steps are available and can be used in the next request",
            "description_zh": "分页标记，当还有更多步骤未返回时会返回此值，用于下一次请求",
            "example": "eyJpbmRleCI6IjIifQ==",
            "type": "string"
          },
          "RecommendationType": {
            "backendName": "recommendationType",
            "description_en": "The type of the recommendation",
            "description_zh": "处理建议的类型",
            "example": "OverPrivilegedRecommendation",
            "type": "string"
          },
          "RecommendedSteps": {
            "backendName": "recommendedSteps",
            "description_en": "The list of recommended steps",
            "description_zh": "推荐步骤列表",
            "itemName": "recommendedStep",
            "items": {
              "description_en": "The recommended step",
              "description_zh": "推荐步骤",
              "properties": {
                "OverPrivilegedRecommendedStep": {
                  "backendName": "overPrivilegedRecommendedStep",
                  "description_en": "The details of the recommended step for over-privileged access",
                  "description_zh": "闲置权限推荐步骤详情",
                  "properties": {
                    "PolicyArn": {
                      "backendName": "policyArn",
                      "description_en": "The ARN of the currently attached policy",
                      "description_zh": "当前已附加的策略 ARN",
                      "example": "acs:ram::system:policy/AliyunOSSFullAccess",
                      "type": "string"
                    },
                    "PolicyAttachedScopes": {
                      "backendName": "policyAttachedScopes",
                      "description_en": "The list of authorization scopes of the current policy",
                      "description_zh": "当前策略的授权范围列表",
                      "itemName": "policyAttachedScope",
                      "items": {
                        "description_en": "The authorization scope of the current policy",
                        "description_zh": "当前策略的授权范围",
                        "example": "1234567890",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "PolicyUpdateTime": {
                      "backendName": "policyUpdateTime",
                      "description_en": "The time when the policy was last modified",
                      "description_zh": "Policy 的最近修改时间",
                      "example": "2022-01-01T00:00:00Z",
                      "type": "string"
                    },
                    "RecommendedAction": {
                      "backendName": "recommendedAction",
                      "description_en": "The recommended action. Valid values:\nDETACH_POLICY\nATTACH_POLICY",
                      "description_zh": "建议的动作，当前有效值为：DETACH_POLICY、ATTACH_POLICY",
                      "example": "DETACH_POLICY",
                      "type": "string"
                    },
                    "RecommendedPolicyArn": {
                      "backendName": "recommendedPolicyArn",
                      "description_en": "The ARN of the recommended access policy to attach",
                      "description_zh": "建议授予的权限策略 ARN",
                      "example": "acs:ram::1234567890:policy/RecommendedPolicy",
                      "type": "string"
                    },
                    "RecommendedPolicyAttachedScopes": {
                      "backendName": "recommendedPolicyAttachedScopes",
                      "description_en": "The list of authorization scopes for the recommended new policy",
                      "description_zh": "推荐新策略的授权范围列表",
                      "itemName": "recommendedPolicyAttachedScopes",
                      "items": {
                        "description_en": "The authorization scope for the recommended new policy",
                        "description_zh": "推荐新策略的授权范围",
                        "example": "1234567890",
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "A1B2C3D4-E5F6-7890-ABCD-EF1234567890",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "ResourceArn": {
            "backendName": "resourceArn",
            "description_en": "The ARN of the resource analyzed in the finding",
            "description_zh": "Finding 中分析的资源的 Arn",
            "example": "acs:ram::1234567890:user/testuser",
            "type": "string"
          },
          "StartedTime": {
            "backendName": "startedTime",
            "description_en": "The time when the recommendation was generated",
            "description_zh": "建议方案生成时间",
            "example": "2024-03-01T10:00:00Z",
            "type": "string"
          },
          "Status": {
            "backendName": "status",
            "description_en": "The current status of the governance recommendation",
            "description_zh": "推荐的治理建议当前状态",
            "example": "SUCCEEDED",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
