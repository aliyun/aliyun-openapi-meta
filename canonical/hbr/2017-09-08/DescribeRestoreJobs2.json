{
  "camel_example": "aliyun hbr DescribeRestoreJobs2 --region cn-hangzhou --Filters.1.Key VaultId --PageSize 10 --PageNumber 1 --Filters.1.Operator IN --Filters.1.Values.1 'v-000000000000000000000' --RestoreType ECS_FILE --Edition STANDARD",
  "cmd_full_name": "hbr describe-restore-jobs-2",
  "cmd_name": "describe-restore-jobs-2",
  "deprecated": false,
  "description_en": "Queries restore jobs that match specified criteria",
  "description_zh": "查询一个或者多个符合条件的恢复任务",
  "kebab_example": "aliyun hbr describe-restore-jobs-2 --page-number 1 --page-size 10 --restore-type ECS_FILE --filters '[{\"Operator\":\"IN\",\"Values\":[\"v-000000000000000000000\"],\"Key\":\"VaultId\"}]' --edition STANDARD --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeRestoreJobs2",
