                  "format": "int64",
                  "type": "integer"
                },
                "PolicyBindingCount": {
                  "backendName": "policyBindingCount",
                  "description_en": "The number of data sources bound to the policy",
                  "description_zh": "策略已绑定的数据源数量",
                  "example": "5",
                  "format": "int64",
                  "type": "integer"
                },
                "PolicyDescription": {
                  "backendName": "policyDescription",
                  "description_en": "The policy description",
                  "description_zh": "策略描述",
                  "example": "每天早上十点备份，异地复制到上海。",
                  "type": "string"
                },
                "PolicyId": {
                  "backendName": "policyId",
                  "description_en": "The policy ID",
                  "description_zh": "策略ID",
                  "example": "po-000************bkz",
                  "type": "string"
                },
                "PolicyName": {
                  "backendName": "policyName",
                  "description_en": "The policy name",
                  "description_zh": "策略名称",
                  "example": "每天备份 + 异地备份",
                  "type": "string"
                },
                "PolicyType": {
                  "backendName": "policyType",
                  "description_en": "The policy type. Valid values:\nSTANDARD: general backup policy. Supports backing up data sources other than ECS instance backup.\nUDM_ECS_ONLY: ECS instance backup policy. Supports backing up only ECS instances",
                  "description_zh": "策略类型，支持：\nSTANDARD：通用备份策略，支持备份除ECS整机备份以外的数据源。\nUDM_ECS_ONLY：整机备份策略，仅支持备份ECS整机",
                  "example": "STANDARD",
                  "type": "string"
                },
                "Rules": {
                  "backendName": "rules",
                  "description_en": "The list of policy rules",
                  "description_zh": "策略规则列表",
                  "itemName": "Rule",
                  "items": {
                    "description_en": "The policy rule details",
                    "description_zh": "策略规则详情",
                    "properties": {
                      "ArchiveDays": {
                        "backendName": "archiveDays",
                        "description_en": "This parameter is required only when RuleType is set to TRANSITION. The number of days after which the backup is converted to archive storage. Unit: days",
                        "description_zh": "仅当RuleType取值为TRANSITION时，需要配置该参数。备份转为归档的时间，单位为天",
                        "example": "30",
                        "format": "int64",
                        "type": "integer",
                        "visibility": "Public"
                      },
                      "BackupType": {
                        "backendName": "backupType",
                        "description_en": "This parameter is required only when RuleType is set to BACKUP. The backup type. The value is COMPLETE, which indicates a full backup",
                        "description_zh": "仅当RuleType取值为BACKUP时，需要配置该参数。备份类型。取值为COMPLETE，表示全量备份",
                        "example": "COMPLETE",
                        "title_en": "COMPLETE, INCREMENTAL, DIFFERENTIAL, LOG",
                        "title_zh": "COMPLETE, INCREMENTAL, DIFFERENTIAL, LOG",
                        "type": "string"
                      },
                      "DataSourceFilters": {
                        "backendName": "dataSourceFilters",
                        "description_en": "This parameter is required only when RuleType is set to TAG. The data source filter rules",
                        "description_zh": "仅当RuleType取值为TAG时，需要配置该参数。数据源过滤规则",
                        "itemName": "DataSourceFilter",
                        "items": {
                          "properties": {
                            "AccountScope": {
                              "backendName": "accountScope",
                              "type": "string"
                            },
                            "Accounts": {
                              "backendName": "accounts",
                              "itemName": "Account",
                              "items": {
                                "properties": {
                                  "CrossAccountRoleName": {
                                    "backendName": "crossAccountRoleName",
                                    "type": "string"
                                  },
                                  "CrossAccountType": {
                                    "backendName": "crossAccountType",
                                    "type": "string"
                                  },
                                  "CrossAccountUserId": {
                                    "backendName": "crossAccountUserId",
                                    "format": "int64",
                                    "type": "integer"
                                  }
                                },
                                "type": "object"
                              },
                              "type": "array"
                            },
                            "DataSourceIds": {
                              "backendName": "dataSourceIds",
                              "deprecated": true,
                              "description_en": "Deprecated",
                              "description_zh": "已废弃",
                              "itemName": "DataSourceId",
                              "items": {
                                "deprecated": true,
                                "description_en": "Deprecated",
                                "description_zh": "已废弃",
                                "example": "已废弃。",
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "SourceType": {
                              "backendName": "sourceType",
                              "description_en": "The data source type. Valid values:\nUDM_ECS: ECS instance backup.\nOSS: OSS backup.\nNAS: Alibaba Cloud NAS backup.\nECS_FILE: ECS File Backup Essential Edition.\nOTS: Tablestore backup",
                              "description_zh": "数据源类型。取值范围：\nUDM_ECS：表示ECS整机备份。\nOSS：表示OSS备份。\nNAS：表示阿里云NAS备份。\nECS_FILE：表示ECS文件备份标准版。\nOTS：表示Tablestore备份",
                              "example": "UDM_ECS",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "Immutable": {
                        "backendName": "immutable",
                        "description_en": "This parameter is valid only when PolicyType is set to UDM_ECS_ONLY. Specifies whether to enable backup locking",
                        "description_zh": "仅当PolicyType为UDM_ECS_ONLY时，该字段有效。表示是否开启备份锁定",
                        "example": "true",
                        "type": "boolean",
                        "visibility": "Public"
                      },
                      "KeepLatestSnapshots": {
                        "backendName": "keepLatestSnapshots",
                        "description_en": "Specifies whether to retain at least one backup version. Valid values:\n0: Do not retain.\n1: Retain",
                        "description_zh": "是否开启保留至少一个备份版本。\n0：不保留。\n1：保留",
                        "example": "1",
                        "format": "int64",
                        "type": "integer"
                      },
                      "ReplicationRegionId": {
                        "backendName": "replicationRegionId",
                        "description_en": "This parameter is required only when RuleType is set to REPLICATION. The destination region ID for replication",
                        "description_zh": "仅当RuleType取值为REPLICATION时，需要配置该参数。复制的目标地域ID",
                        "example": "cn-shanghai",
                        "type": "string"
                      },
                      "Retention": {
                        "backendName": "retention",
                        "description_en": "This parameter is required only when RuleType is set to TRANSITION or REPLICATION.\nRuleType is set to TRANSITION: the retention period of the backup. Minimum value: 1. Unit: days.\nRuleType is set to REPLICATION: the retention period of the geo-redundancy backup. Minimum value: 1. Unit: days",
                        "description_zh": "仅当RuleType取值为TRANSITION或REPLICATION时，需要配置该参数。\nRuleType取值为TRANSITION：备份保留时间，最小值为1，单位为天。\nRuleType取值为REPLICATION：异地备份保留时间，最小值为1，单位为天",
                        "example": "7",
                        "format": "int64",
                        "type": "integer"
                      },
                      "RetentionRules": {
                        "backendName": "retentionRules",
                        "description_en": "This parameter is required only when RuleType is set to TRANSITION. The list of special retention rules",
                        "description_zh": "仅当RuleType取值为TRANSITION时，需要配置该参数。特殊保留规则列表",
                        "itemName": "RetentionRule",
                        "items": {
                          "description_en": "The special retention rule",
                          "description_zh": "特殊保留规则",
                          "properties": {
                            "AdvancedRetentionType": {
                              "backendName": "advancedRetentionType",
                              "description_en": "The type of the special retention rule. Valid values:\nWEEKLY: weekly backup.\nMONTHLY: monthly backup.\nYEARLY: yearly backup",
                              "description_zh": "特殊保留规则类型：\nWEEKLY：每周的备份\nMONTHLY：每月的备份\nYEARLY：每年的备份",
                              "example": "YEARLY",
                              "title_en": "DAILY, WEEKLY, MONTHLY, YEARLY",
                              "title_zh": "DAILY, WEEKLY, MONTHLY, YEARLY",
                              "type": "string"
                            },
                            "Retention": {
                              "backendName": "retention",
                              "description_en": "The special retention period of the backup. Minimum value: 1. Unit: days",
                              "description_zh": "备份的特殊保留时间，最小值为1，单位为天",
                              "example": "730",
                              "format": "int64",
                              "type": "integer"
                            },
                            "WhichSnapshot": {
                              "backendName": "whichSnapshot",
                              "description_en": "The backup to which the rule applies. Currently, only the first backup is supported. The value is 1",
                              "description_zh": "针对第几个备份生效，当前仅支持第1个备份，值为1",
                              "example": "1",
                              "format": "int64",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "RuleId": {
                        "backendName": "ruleId",
                        "description_en": "The rule ID",
                        "description_zh": "规则ID",
                        "example": "rule-000************f1e",
                        "type": "string"
                      },
                      "RuleType": {
                        "backendName": "ruleType",
                        "description_en": "The rule type. Each policy must have at least one BACKUP rule and exactly one TRANSITION rule. Valid values:\nBACKUP: backup rule.\nTRANSITION: lifecycle rule.\nREPLICATION: replication rule",
                        "description_zh": "规则类型，每一个策略需要至少有一个BACKUP类型规则，有且仅有一个TRANSITION类型规则：\nBACKUP：备份规则。\nTRANSITION：生命周期规则。\nREPLICATION：复制规则",
                        "example": "BACKUP",
                        "title_en": "TRANSITION, BACKUP, REPLICATION",
                        "title_zh": "TRANSITION, BACKUP, REPLICATION",
                        "type": "string"
                      },
                      "Schedule": {
                        "backendName": "schedule",
                        "description_en": "This parameter is required only when RuleType is set to BACKUP. The backup schedule. Optional format: `I|{startTime}|{interval}`. This indicates that a backup job is executed at every {interval} starting from {startTime}. Backup jobs for past time periods are not compensated. If the previous backup job is not completed, the next backup job is not triggered. For example, `I|1631685600|P1D` indicates that a backup is performed once a day starting from 2021-09-15 14:00:00.\n\nstartTime: the start time of the backup. UNIX timestamp, in seconds.\ninterval: the ISO 8601 time interval. For example, PT1H indicates an interval of one hour. P1D indicates an interval of one day",
                        "description_zh": "仅当RuleType取值为BACKUP时，需要配置该参数。备份定时设置。可选格式：`I|{startTime}|{interval}`。表示从{startTime}开始每隔{interval}的时间执行一次备份任务。不会补偿已过去时间的备份任务。如果上一次备份任务没有完成，不会触发下一次备份任务。例如`I|1631685600|P1D`表示从2021-09-15 14:00:00开始每隔一天备份一次。\n\nstartTime：备份起始时间，UNIX时间，单位为秒。\ninterval： ISO8601时间间隔。例如：PT1H表示间隔一小时。P1D表示间隔一天",
                        "example": "I|1648647166|P1D",
                        "type": "string"
                      },
                      "TagFilters": {
                        "backendName": "tagFilters",
                        "description_en": "This parameter is required only when RuleType is set to TAG. The resource tag filter rules",
                        "description_zh": "仅当RuleType取值为TAG时，需要配置该参数。资源标签过滤规则",
                        "itemName": "TagFilter",
                        "items": {
                          "properties": {
                            "Key": {
                              "backendName": "key",
                              "description_en": "The tag key",
                              "description_zh": "标签键",
                              "example": "env",
                              "type": "string"
                            },
                            "Operator": {
                              "backendName": "operator",
                              "description_en": "The tag matching rule. Valid values:\nEQUAL: matches both the tag key and the tag value.\nNOT: matches the tag key but not the tag value",
                              "description_zh": "标签匹配规则，支持\nEQUAL：匹配标签键和标签值。\nNOT：匹配标签键，不匹配标签值",
                              "example": "EQUAL",
                              "type": "string"
                            },
                            "Value": {
                              "backendName": "value",
                              "description_en": "The tag value. An empty value indicates any value",
                              "description_zh": "标签值，为空时表示任意值",
                              "example": "prod",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "VaultId": {
                        "backendName": "vaultId",
                        "description_en": "This parameter is required only when RuleType is set to BACKUP. The backup vault ID",
                        "description_zh": "仅当RuleType取值为BACKUP时，需要配置该参数。备份库ID",
                        "example": "v-000**************kgm",
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "UpdatedTime": {
                  "backendName": "updatedTime",
                  "description_en": "The update time. UNIX timestamp, in seconds",
                  "description_zh": "更新时间。UNIX时间，单位为秒",
                  "example": "1662080404",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E",
            "type": "string"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful. Valid values:\n\ntrue: Successful.\nfalse: Failed",
            "description_zh": "请求是否成功。\n\ntrue：成功\nfalse：失败",
            "example": "true",
            "type": "boolean"
          },
          "TotalCount": {
            "backendName": "totalCount",
            "description_en": "The total number of records",
            "description_zh": "总记录数",
            "example": "12",
            "format": "int64",
            "type": "integer"
          }
        },
        "title_en": "DescribePoliciesResponse",
