            "backendName": "policies",
            "description_en": "The list of policies",
            "description_zh": "策略列表",
            "itemName": "Policy",
            "items": {
              "description_en": "The policy details",
              "description_zh": "策略详情",
              "properties": {
                "BusinessStatus": {
                  "backendName": "businessStatus",
                  "description_en": "The user business status",
                  "description_zh": "用户业务状态",
