                  "example": "[\n      \"/home/alice/log\"\n]",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Include": {
                  "backendName": "include",
                  "description_en": "The paths included in the analysis. Archiving feature only",
