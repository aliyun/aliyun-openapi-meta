{
  "camel_example": "aliyun hbr DescribeDataSources --region cn-hangzhou --PageSize 10 --PageNumber 1 --ClusterId 'cl-0003jyv000000fsku5m' --DataSourceName MyLocalNas --DataSourceType COMMON_NAS --DataSourceId 'ds-0000000002nqeo'",
