{
  "camel_example": "aliyun hbr SearchHistoricalSnapshots --region cn-hangzhou --Query '[\"field\"]'",
  "cmd_full_name": "hbr search-historical-snapshots",
  "cmd_name": "search-historical-snapshots",
  "deprecated": false,
  "description_en": "Retrieves one or more historical backup snapshots that meet the specified conditions",
  "description_zh": "获取一个或者多个符合条件的历史备份快照",
  "kebab_example": "aliyun hbr search-historical-snapshots --query '[\"field\"]' --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "SearchHistoricalSnapshots",
  "operation": {
    "action": "SearchHistoricalSnapshots",
    "api_style": "RPC",
    "api_version": "2017-09-08",
