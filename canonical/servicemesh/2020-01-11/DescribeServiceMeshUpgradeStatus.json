        "description_zh": "升级状态",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "11fd0027-c27e-41bb-a565-75583054****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "UpgradeDetail": {
            "backendName": "upgradeDetail",
            "description_en": "The details of the upgrade status",
            "description_zh": "升级状态结果",
            "properties": {
              "FinishedGatewaysNum": {
                "backendName": "finishedNum",
                "description_en": "The number of gateways that are upgraded",
                "description_zh": "升级完成的网关数目",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "GatewayStatusRecord": {
                "additionalProperties": {
                  "description_en": "The status of an ASM gateway",
                  "description_zh": "ASM网关状态",
                  "properties": {
                    "Message": {
                      "backendName": "message",
                      "description_en": "The additional status information about the ASM gateway",
                      "description_zh": "ASM网关实例的额外状态信息",
                      "example": "success",
                      "type": "string"
                    },
                    "Status": {
                      "backendName": "status",
                      "description_en": "The upgrade status of the ASM gateway. Valid values:\n\n`upgrading`: The gateway is being upgraded.\n\n`pending`: The upgrade is pending.\n\n`finished`: The upgrade is complete.\n\n`notStart`: The upgrade has not started.\n\n`failed`: The upgrade failed.\n\n`unknown`: The status is unknown",
                      "description_zh": "ASM网关升级状态。取值：\n\n`upgrading`：升级中\n\n`pending`：升级等待中\n\n`finished`：升级已完成\n\n`notStart`：升级未开始\n\n`failed`：升级失败\n\n`unknown`：其他状态",
                      "example": "upgrading",
                      "type": "string"
                    },
                    "Version": {
                      "backendName": "version",
                      "description_en": "The version of the ASM gateway",
                      "description_zh": "ASM网关版本",
                      "example": "1.9.7",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "backendName": "gatewayStatusRecord",
                "description_en": "The status records of the ASM gateways",
                "description_zh": "ASM网关状态记录",
                "type": "object"
              },
              "MeshStatus": {
                "backendName": "meshState",
                "description_en": "The status of the ASM instance. Valid values:\n\nrunning: The instance is running.\n\n`upgrading`: The instance is being upgraded.\n\n`upgrading_failed`: The upgrade failed",
                "description_zh": "ASM实例状态，取值：\n\n\nrunning：运行中\n\n`upgrading`：升级中\n\n`upgrading_failed`：升级失败",
                "example": "running",
                "type": "string"
              },
              "TotalGatewaysNum": {
                "backendName": "totalGatewayPodNum",
                "description_en": "The total number of gateways",
                "description_zh": "所有的网关数目",
