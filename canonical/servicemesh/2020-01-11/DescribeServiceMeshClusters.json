{
  "camel_example": "aliyun servicemesh DescribeServiceMeshClusters --region cn-hangzhou --ServiceMeshId cb8963379255149cb98c8686f274x0000 --Limit 30 --Offset 20",
  "cmd_full_name": "servicemesh describe-service-mesh-clusters",
  "cmd_name": "describe-service-mesh-clusters",
  "deprecated": false,
  "description_en": "Queries the available clusters in a service mesh",
  "description_zh": "调用DescribeServiceMeshClusters获取服务网格的可用集群",
  "kebab_example": "aliyun servicemesh describe-service-mesh-clusters --service-mesh-id cb8963379255149cb98c8686f274x0000 --offset 20 --limit 30 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeServiceMeshClusters",
  "operation": {
    "action": "DescribeServiceMeshClusters",
    "api_style": "RPC",
    "api_version": "2020-01-11",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cb8963379255149cb98c8686f274x****",
      "help_en": "The service mesh ID",
      "help_zh": "服务网格ID",
      "location": "query",
      "name": "service_mesh_id",
      "options": [
        "--service-mesh-id"
      ],
      "raw_name": "ServiceMeshId",
      "required": false,
      "type": "string"
    },
    {
      "example": "20",
