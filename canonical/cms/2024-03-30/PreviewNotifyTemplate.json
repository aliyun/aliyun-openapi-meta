{
  "cmd_full_name": "cms preview-notify-template",
  "cmd_name": "preview-notify-template",
  "deprecated": false,
  "description_en": "预览通知模板渲染结果",
  "description_zh": "传入 Go template 语法的模板内容和渲染上下文数据，返回各模板的渲染结果。支持同时预览多个模板（如 title 和 content），用于前端模板编辑器的实时预览能力",
  "kebab_example": "aliyun cms preview-notify-template --templates '[{\"template\":\"云监控报警: {{.incident.title}}\",\"key\":\"title\"},{\"template\":\">- 级别: {{.incident.severity}}\",\"key\":\"content\"}]' --api-version 2024-03-30 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "PreviewNotifyTemplate",
  "operation": {
    "action": "PreviewNotifyTemplate",
    "api_style": "ROA",
    "api_version": "2024-03-30",
    "body_mapping": {
      "data": "data",
      "templates": "templates"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "create",
    "url": "/v1/template/batchRender"
  },
  "parameters": [
    {
      "example": "{\"incident\":{\"title\":\"CPU使用率过高\",\"severity\":\"P1\"}}",
      "help_en": "The data",
      "help_zh": "渲染上下文数据，为键值对结构。用于填充模板中 Go template 占位符（如 {{.incident.title}}）的数据源",
      "location": "body",
      "name": "data",
      "options": [
        "--data"
      ],
      "param_style": "json",
      "raw_name": "data",
      "required": false,
      "type": "any"
    },
    {
      "element": {
        "fields": [
          {
            "example": "title",
            "help_en": "模板标识，前端自定义，原样返回。建议使用 title / content 等语义名称",
            "help_zh": "模板标识，前端自定义，原样返回。建议使用 title / content 等语义名称",
            "name": "key",
            "options": [
              "--key"
            ],
            "raw_name": "key",
            "required": true,
            "type": "string"
          },
          {
            "example": "云监控报警: {{.incident.title}}",
            "help_en": "Go template 语法的模板内容字符串",
            "help_zh": "Go template 语法的模板内容字符串",
            "name": "template",
            "options": [
              "--template"
            ],
            "raw_name": "template",
            "required": true,
            "type": "string"
          }
        ],
        "type": "object"
      },
      "example": "[{\"key\":\"title\",\"template\":\"云监控报警: {{.incident.title}}\"},{\"key\":\"content\",\"template\":\">- 级别: {{.incident.severity}}\"}]",
      "help_en": "待渲染的模板列表，每项包含模板标识和模板内容",
      "help_zh": "待渲染的模板列表，每项包含模板标识和模板内容",
      "location": "body",
      "name": "templates",
      "options": [
        "--templates"
      ],
      "param_style": "json",
      "raw_name": "templates",
      "required": true,
      "type": "array"
    }
  ],
  "pathPattern": "/v1/template/batchRender",
  "product_code": "Cms",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_zh": "Schema of Response",
        "properties": {
          "data": {
            "backendName": "data",
            "description_zh": "渲染结果对象，包含 success（渲染成功项）和 failed（渲染失败项）两个映射",
            "properties": {
              "failed": {
                "backendName": "failed",
                "description_zh": "渲染失败的结果映射。key 为模板标识，value 为失败原因（如模板语法错误、引用了未定义变量等）",
                "type": "object"
              },
              "success": {
                "backendName": "success",
                "description_zh": "渲染成功的结果映射。key 为模板标识（对应请求中的 templates[].key），value 为渲染后的字符串内容",
                "type": "object"
              }
            },
            "type": "object"
          },
          "msg": {
            "backendName": "msg",
            "description_zh": "处理结果消息。成功时为 success，失败时为错误信息",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "请求ID",
            "description_zh": "请求ID",
            "example": "452faed9-ab3b-4340-8a92-bc7d9b98f17a",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "请求是否成功。取值：true（成功）、false（失败）",
            "type": "boolean"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
