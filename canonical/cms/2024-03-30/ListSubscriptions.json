                },
                "enabledSubChannels": {
                  "backendName": "enabledSubChannels",
                  "description_en": "The list of enabled subchannels",
                  "description_zh": "已启用的子渠道列表",
                  "items": {
                    "description_en": "The enabled notification subchannel type. This parameter is required only when channelType is set to CONTACT, GROUP, or DUTY",
                    "description_zh": "已启用的通知子渠道类型，仅当 channelType 为 CONTACT/GROUP/DUTY 时需要指定",
                    "example": "SMS",
                    "type": "string"
                  },
                  "title": "已启用的子渠道列表",
                  "type": "array"
                },
                "receivers": {
                  "backendName": "receivers",
                  "description_en": "The list of receivers",
                  "description_zh": "接收者列表",
                  "items": {
                    "description_en": "The receiver identifier, such as a webhook UUID, robot UUID, or contact ID",
                    "description_zh": "接收方标识，如 webhook uuid、robot uuid 或联系人 ID",
                    "example": "my-contact",
                    "type": "string"
                  },
                  "title": "接收者列表",
                  "type": "array"
                }
              },
              "type": "object"
            },
            "title": "通知渠道列表",
            "type": "array"
          },
          "effectTimeRange": {
            "backendName": "effectTimeRange",
            "description_en": "The effective period configuration",
            "description_zh": "生效时间段配置",
            "properties": {
              "dayInWeek": {
                "backendName": "dayInWeek",
                "description_en": "The effective days of the week (0 = Sunday, 1 = Monday, ..., 6 = Saturday)",
                "description_zh": "一周中的有效天数（0=周日，1=周一，...，6=周六）",
                "items": {
                  "description_en": "The effective day. Valid values: 0 to 6 (0 = Sunday, 6 = Saturday)",
                  "description_zh": "生效天，取值 0-6（0=周日，6=周六）",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "title": "一周中的有效天数（0=周日，1=周一，...，6=周六）",
                "type": "array"
