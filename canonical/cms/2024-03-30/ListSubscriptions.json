{
  "cmd_full_name": "cms list-subscriptions",
  "cmd_name": "list-subscriptions",
  "components": {
    "schemas": {
      "FilterSetting": {
        "description_en": "The filter configuration",
        "description_zh": "过滤配置",
        "properties": {
          "conditions": {
            "backendName": "conditions",
            "description_en": "The subscription conditions",
            "description_zh": "订阅条件",
            "items": {
              "description_en": "The individual condition",
              "description_zh": "单个条件",
              "properties": {
                "field": {
                  "backendName": "field",
                  "description_en": "The JSON path of the event field. Dot-notation nesting is supported",
                  "description_zh": "事件字段的 JSON 路径，支持点号嵌套",
                  "example": "labels.alertname\t",
                  "title": "字段",
                  "type": "string"
                },
                "op": {
                  "backendName": "op",
                  "description_en": "The comparison operator",
                  "description_zh": "比较符",
                  "example": "EQ",
                  "title": "比较符",
                  "type": "string"
                },
                "value": {
                  "backendName": "value",
                  "description_en": "The matching value. Separate multiple values with commas when using IN or NOT_IN",
                  "description_zh": "匹配值，IN/NOT_IN 时逗号分隔多个值",
                  "example": "CRITICAL",
                  "title": "值",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "maxItems": 10,
            "title": "订阅条件",
            "type": "array"
          },
          "expression": {
            "backendName": "expression",
            "description_en": "Use either expression or relation. If expression is not empty, it takes precedence and relation is ignored. If expression is empty or not specified, relation (AND or OR) is used to perform a simple AND/OR operation on all conditions. Condition numbers correspond to the indexes of the conditions array (starting from 1). Each condition evaluates whether a single event field matches by using field (the event field path, which supports dot-notation nesting such as resource.tags.pod), op (the operator, such as CONTAIN, EQ, or IN), and value (the matching value)",
            "description_zh": "expression 和 relation 二选一使用。如果 expression 非空，它优先生效，relation 被忽略；如果 expression 为空或不传，则用 relation（AND 或 OR）对所有条件做简单全量与/或运算。条件编号对应 conditions 数组的下标（从 1 开始），每个条件通过 field（事件字段路径，支持点号嵌套如 resource.tags.pod）、op（操作符，如 CONTAIN、EQ、IN 等）、value（匹配值）来评估单个事件字段是否匹配",
            "example": "1 and 2 or 3",
            "title": "表达式",
            "type": "string"
          },
          "relation": {
            "backendName": "relation",
            "description_en": "The logical relationship between conditions. This parameter takes effect when expression is empty",
            "description_zh": "条件间逻辑关系。expression 为空时生效",
            "example": "AND",
            "title": "条件间关系",
            "type": "string"
          }
        },
        "type": "object"
      },
      "NotifyRouteForSubscription": {
        "description_en": "The notification routing configuration at the subscription level",
        "description_zh": "通知路由配置（订阅级别）",
        "properties": {
