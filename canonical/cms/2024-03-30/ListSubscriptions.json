              "endTimeInMinute": {
                "backendName": "endTimeInMinute",
                "description_en": "The end time of the day, in minutes from 0:00",
                "description_zh": "当天结束时间（分钟数，从 0:00 起算）",
                "example": "1",
                "format": "int32",
                "title": "当天结束时间（分钟数，从 0:00 起算）",
                "type": "integer"
              },
              "startTimeInMinute": {
                "backendName": "startTimeInMinute",
                "description_en": "The start time of the day, in minutes from 0:00",
                "description_zh": "当天开始时间（分钟数，从 0:00 起算）",
                "example": "1",
                "format": "int32",
                "title": "当天开始时间（分钟数，从 0:00 起算）",
                "type": "integer"
              },
              "timeZone": {
                "backendName": "timeZone",
                "description_en": "The time zone",
                "description_zh": "时区",
                "example": "1700000000",
                "title": "时区",
                "type": "string"
              }
            },
            "title": "生效时间段配置",
            "type": "object"
          }
        },
        "title": "通知路由配置（订阅级别）",
        "type": "object"
      },
