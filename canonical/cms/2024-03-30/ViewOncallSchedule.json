{
  "cmd_full_name": "cms view-oncall-schedule",
  "cmd_name": "view-oncall-schedule",
  "deprecated": false,
  "description_en": "Queries the on-call calendar of a specified on-call schedule within a given date range, and returns the contacts and start and end times of each on-call shift grouped by shift name",
  "description_zh": "查看指定值班表在给定日期范围内的排班日历，按班次名称分组返回各值班时段的联系人与起止时间",
  "kebab_example": "aliyun cms view-oncall-schedule --start-date 2024-04-04 --end-date 2024-07-05 --oncall-schedule-id testId --api-version 2024-03-30 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "ViewOncallSchedule",
  "operation": {
    "action": "ViewOncallSchedule",
    "api_style": "ROA",
    "api_version": "2024-03-30",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/oncallSchedule/{oncallScheduleId}/calendar"
  },
  "parameters": [
    {
      "example": "2024-04-04",
      "help_en": "The start date of the query. Format: yyyy-MM-dd. This parameter must be specified together with endDate",
      "help_zh": "查询开始日期。格式：yyyy-MM-dd。调用时需与 endDate 一同传入",
      "location": "query",
      "name": "start_date",
      "options": [
        "--start-date"
      ],
      "raw_name": "startDate",
      "required": false,
      "type": "string"
    },
    {
      "example": "2024-07-05",
      "help_en": "The end date of the query. Format: yyyy-MM-dd. This parameter must be specified together with startDate",
      "help_zh": "查询结束日期。格式：yyyy-MM-dd。调用时需与 startDate 一同传入",
      "location": "query",
      "name": "end_date",
      "options": [
        "--end-date"
      ],
      "raw_name": "endDate",
      "required": false,
      "type": "string"
    },
    {
      "example": "testId",
      "help_en": "The unique identifier of the on-call schedule",
      "help_zh": "值班表唯一标识",
      "location": "path",
      "name": "oncall_schedule_id",
      "options": [
        "--oncall-schedule-id"
      ],
      "raw_name": "oncallScheduleId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/oncallSchedule/[oncallScheduleId]/calendar",
  "product_code": "Cms",
  "protocol": "HTTPS",
  "responses": {
