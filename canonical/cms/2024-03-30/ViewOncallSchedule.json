        "description_zh": "查看值班日历的响应",
        "example": "{\"requestId\":\"8FDE2569-626B-5176-9844-28877A*****\",\"schedule\":{\"testName\":[{\"contactId\":\"testId\",\"contactName\":\"张三\",\"start\":\"2024-10-10 09:00\",\"end\":\"2024-10-15 18:00\"}]}}",
        "properties": {
          "requestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "8FDE2569-626B-5176-9844-28877A*****",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "schedule": {
            "additionalProperties": {
              "description_en": "The list of on-call shifts for the shift",
              "description_zh": "该班次下的值班时段列表",
              "itemName": "item",
              "items": {
                "description_en": "The on-call shift. Includes the on-call contact and the start and end times",
                "description_zh": "值班时段。包含值班联系人和起止时间",
                "properties": {
                  "contactId": {
                    "backendName": "contactId",
                    "description_en": "The ID of the on-call contact",
                    "description_zh": "值班人ID",
                    "example": "testId",
                    "type": "string"
                  },
                  "contactName": {
                    "backendName": "contactName",
                    "description_en": "The name of the on-call contact",
                    "description_zh": "值班人名称",
                    "example": "testName",
                    "type": "string"
                  },
                  "end": {
                    "backendName": "end",
                    "description_en": "The end time. Format: yyyy-MM-dd HH:mm:ss",
                    "description_zh": "结束时间。格式：yyyy-MM-dd HH:mm:ss",
                    "example": "2024-10-01 02:00:00",
                    "type": "string"
                  },
                  "start": {
                    "backendName": "start",
                    "description_en": "The start time. Format: yyyy-MM-dd HH:mm:ss",
                    "description_zh": "开始时间。格式：yyyy-MM-dd HH:mm:ss",
                    "example": "2024-10-01 22:00:00",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "type": "array"
            },
            "backendName": "data",
            "description_en": "The on-call calendar. The key is the shift name, and the value is a list of on-call shifts for the shift within the queried date range",
            "description_zh": "排班日历。键为班次名称，值为该班次在查询日期范围内的值班时段列表",
            "example": "{\"testName\":[{\"contactId\":\"testId\",\"contactName\":\"张三\",\"start\":\"2024-10-10 09:00\",\"end\":\"2024-10-15 18:00\"}]}",
            "type": "object"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
