              },
              "taskId": {
                "description_en": "The delivery task ID",
                "description_zh": "投递任务 ID",
                "example": "8b07eeac8249866d",
                "type": "string"
              },
              "taskName": {
                "description_en": "The task name",
                "description_zh": "任务名称",
                "example": "test-task",
                "type": "string"
