            "type": "object"
          },
          "requestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "0CEC5375-C554-562B-A65F-9A629907C1F0",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
