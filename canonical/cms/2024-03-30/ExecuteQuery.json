        "description_zh": "响应数据",
        "properties": {
          "data": {
            "description_en": "An array of log entries. Each object in the array represents a log entry",
            "description_zh": "日志数据数组，每条日志对应一个元素",
            "itemName": "data",
            "items": {
              "additionalProperties": {
                "description_en": "The log entry, returned as a JSON-formatted string",
                "description_zh": "返回的日志",
                "example": "{'remote_addr': '198.51.XXX.XXX', 'pv': '1', '__source__': '', '__time__': '1649902984'}",
                "title_en": "返回的日志。",
                "title_zh": "返回的日志。",
                "type": "string"
              },
              "description_en": "An object that represents a single log entry",
              "description_zh": "日志数据数组",
              "type": "object"
            },
            "title_en": "日志数据数组，每条日志对应一个元素",
            "title_zh": "日志数据数组，每条日志对应一个元素",
            "type": "array"
          },
          "meta": {
            "description_en": "Metadata about the query execution",
            "description_zh": "元数据",
            "properties": {
              "affectedRows": {
                "description_en": "The number of scanned or processed log entries",
                "description_zh": "扫描/处理的日志行数",
                "example": "1",
                "format": "int32",
                "type": "integer"
              },
              "count": {
                "description_en": "The number of log entries returned",
                "description_zh": "本次查询请求返回的日志行数",
                "example": "1",
                "format": "int32",
                "title_en": "本次查询请求返回的日志行数。",
                "title_zh": "本次查询请求返回的日志行数。",
                "type": "integer"
              },
              "elapsedMillisecond": {
                "description_en": "The query execution time in milliseconds",
                "description_zh": "本次执行消耗的毫秒时间",
                "example": "1231243",
                "format": "int64",
                "type": "integer"
              },
              "progress": {
                "description_en": "The query completion status. A value of `Complete` indicates that the query has finished",
                "description_zh": "查询的结果是否完整",
                "example": "Complete",
                "title_en": "查询的结果是否完整",
                "title_zh": "查询的结果是否完整",
                "type": "string"
              }
            },
            "type": "object"
          },
          "requestId": {
            "description_en": "The unique request ID",
            "description_zh": "请求 ID",
            "example": "3B311FD9-A60B-55E0-A896-A0C73*********",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
