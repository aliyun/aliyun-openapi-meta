{
  "camel_example": "aliyun cloudapi DescribeInstanceClusterInfo --region cn-hangzhou --InstanceClusterName testvpc",
  "cmd_full_name": "cloudapi describe-instance-cluster-info",
  "cmd_name": "describe-instance-cluster-info",
  "deprecated": false,
  "description_en": "Queries the information about a dedicated instance cluster",
  "description_zh": "查询专享实例集群信息",
  "kebab_example": "aliyun cloudapi describe-instance-cluster-info --instance-cluster-name testvpc --api-version 2016-07-14 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeInstanceClusterInfo",
  "operation": {
    "action": "DescribeInstanceClusterInfo",
    "api_style": "RPC",
    "api_version": "2016-07-14",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "testvpc",
      "help_en": "The name of the dedicated instance cluster",
      "help_zh": "专享实例集群名称",
      "location": "query",
      "name": "instance_cluster_name",
      "options": [
        "--instance-cluster-name"
      ],
      "raw_name": "InstanceClusterName",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CloudAPI",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "CreatedTime": {
            "backendName": "data.gmtCreate",
            "description_en": "The time when the cluster was created",
            "description_zh": "创建时间",
            "example": "2022-10-10T18:29:27",
            "type": "string"
          },
          "Description": {
            "backendName": "data.description",
            "description_en": "The cluster description, which can be up to 200 characters in length",
            "description_zh": "描述，不超过200个字符",
            "example": "v0.0.4",
            "type": "string"
          },
          "InstanceClusterAttribute": {
            "backendName": "data.extensions",
            "description_en": "The cluster details",
            "description_zh": "专享实例集群的详细信息",
            "properties": {
              "ConnectCidrBlocks": {
                "backendName": "connectCidrBlocks",
                "description_en": "The internal CIDR block of the user VPC that can be accessed by the cluster if the cluster consists of VPC integration instances",
                "description_zh": "VPC融合类型实例集群可以访问到的用户VPC的内网网段",
                "example": "[\"192.168.1.0/24\",\"192.168.0.0/24\"]",
                "type": "string"
              },
              "ConnectVpcId": {
                "backendName": "connectVpcId",
                "description_en": "The ID of the user VPC that is connected to the cluster if the cluster consists of VPC integration instances",
                "description_zh": "VPC融合类型实例集群联通的用户VPC ID",
                "example": "vpc-p0w3kxxxxxxxxxxxxxxxx",
                "type": "string"
              },
              "EgressIpv6Enable": {
                "backendName": "egressIpv6Enable",
                "description_en": "Indicates whether outbound IPv6 traffic is supported",
                "description_zh": "IPV6出访能力是否支持",
                "example": "true",
                "type": "boolean"
              },
              "HttpsPolicies": {
                "backendName": "httpsPolicies",
                "description_en": "The HTTPS security policy",
                "description_zh": "https安全策略",
                "example": "HTTPS2_TLS1_0",
                "type": "string"
              },
              "IPV4AclId": {
                "backendName": "ipv4AclId",
                "description_en": "The ID of the IPv4 access control list (ACL)",
                "description_zh": "IPV4访问控制策略ID",
                "example": "acl-t4n8i4rvvp70kcyuoXXXX",
                "type": "string"
              },
              "IPV4AclName": {
                "backendName": "ipv4AclName",
                "description_en": "The name of the IPv4 ACL",
                "description_zh": "IPV4访问控制策略名称",
                "example": "test-black",
                "type": "string"
              },
              "IPV4AclStatus": {
                "backendName": "ipv4AclStatus",
                "description_en": "Indicates whether IPv4 access control is enabled. Valid values:\n\non\noff",
                "description_zh": "是否开启IPV4访问控制功能。取值：\n\non：开启访问控制\noff：关闭访问控制",
                "example": "on",
                "type": "string"
              },
              "IPV4AclType": {
                "backendName": "ipv4AclType",
                "description_en": "The type of the IPv4 ACL.\n\nblack: blacklist\nwhite: whitelist",
                "description_zh": "IPV4访问控制策略类型\n\nblack：黑名单\n\nwhite：白名单",
                "example": "black",
                "type": "string"
              },
              "IPV6AclId": {
                "backendName": "ipv6AclId",
                "description_en": "The ID of the IPv6 ACL",
                "description_zh": "IPV6访问控制策略ID",
                "example": "acl-t4nevzhwbpe7cup18XXXX",
                "type": "string"
              },
              "IPV6AclName": {
                "backendName": "ipv6AclName",
                "description_en": "The name of the IPv6 ACL",
                "description_zh": "IPV6访问控制策略名称",
                "example": "test",
                "type": "string"
              },
              "IPV6AclStatus": {
                "backendName": "ipv6AclStatus",
                "description_en": "Indicates whether IPv6 access control is enabled. Valid values:\n\non\noff",
                "description_zh": "是否开启IPV6访问控制功能。取值：\n\non：开启访问控制\n\noff：关闭访问控制",
                "example": "on",
                "type": "string"
              },
              "IPV6AclType": {
                "backendName": "ipv6AclType",
                "description_en": "The type of the IPv6 ACL. Valid values:\n\nblack: blacklist\nwhite: whitelist",
                "description_zh": "IPV6访问控制策略类型\nblack：黑名单                                 \nwhite：白名单",
                "example": "white",
                "type": "string"
              },
              "InternetEgressAddress": {
                "backendName": "internetEgressAddress",
                "description_en": "The outbound public IP address",
                "description_zh": "公网出口地址",
                "example": "39.106.XX.XX",
                "type": "string"
              },
              "IntranetEgressAddress": {
                "backendName": "intranetEgressAddress",
                "description_en": "The outbound private IP address",
                "description_zh": "内网出口地址",
                "example": "100.104.XX.XX/26",
                "type": "string"
              },
              "IntranetSegments": {
                "backendName": "intranetSegments",
                "description_en": "The custom CIDR block. The configured CIDR block is considered as a private block",
                "description_zh": "自定义网段，所配置的网段将被视为私网地址",
                "example": "123.0.0.1",
                "type": "string"
              },
              "SupportIpv6": {
                "backendName": "supportIpv6",
                "description_en": "Indicates whether IPv6 traffic is supported",
                "description_zh": "是否支持ipv6",
                "example": "true",
                "type": "boolean"
              },
              "UserVpcId": {
                "backendName": "userVpcId",
                "description_en": "The ID of the client VPC",
                "description_zh": "客户端vpcid",
                "example": "vpc-2zew2v4vcg78mXXXX",
                "type": "string"
              },
              "UserVswitchId": {
                "backendName": "userVSwitchId",
                "description_en": "The vSwitch of the client VPC",
                "description_zh": "客户端vpc的交换机",
                "example": "vsw-2zecr5r7ao44tslsXXXX",
                "type": "string"
              },
              "VipTypeList": {
                "backendName": "vipTypeList",
                "description_en": "The VIPs of the cluster",
                "description_zh": "实例集群已开通的VIP列表",
                "example": "VPC_INTERNET_IPV6",
                "type": "string"
              },
              "VpcIntranetEnable": {
                "backendName": "vpcIntranetEnable",
                "description_en": "Indicates whether a virtual private cloud (VPC) domain name is enabled",
                "description_zh": "是否开启内网VPC域名",
                "type": "boolean"
              },
              "VpcOwnerId": {
                "backendName": "vpcOwnerId",
                "description_en": "The ID of the account to which the VPC belongs",
                "description_zh": "VPC实例所属账号ID",
                "example": "165438596694XXXX",
                "format": "int64",
                "type": "integer"
              },
              "VpcSlbIntranetEnable": {
                "backendName": "vpcSlbIntranetEnable",
                "description_en": "Indicates whether self-calling is enabled",
                "description_zh": "是否开启API网关自调用域名",
                "example": "false",
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "InstanceClusterId": {
            "backendName": "data.instanceClusterId",
            "description_en": "The cluster ID",
            "description_zh": "纳管该专享实例的专享实例集群的ID",
            "example": "apigateway-ht-04e41d95e9c1\n",
            "type": "string"
          },
          "InstanceClusterName": {
            "backendName": "data.instanceClusterName",
            "description_en": "The cluster name",
            "description_zh": "专享实例集群名称",
            "example": "test",
            "type": "string"
          },
          "InstanceClusterStatus": {
            "backendName": "data.instanceClusterStatus",
            "description_en": "The cluster status",
            "description_zh": "专享实例集群状态",
            "example": "RUNNING",
            "type": "string"
          },
          "InstanceClusterType": {
            "backendName": "data.instanceClusterType",
            "description_en": "The cluster type",
            "description_zh": "专享实例集群类型",
            "example": "normal",
            "type": "string"
          },
          "InstanceClusterVersion": {
            "backendName": "data.instanceClusterVersion",
            "description_en": "The cluster version",
            "description_zh": "专享实例集群版本",
            "example": "3.5.3.856",
            "type": "string"
          },
          "InstanceList": {
            "backendName": "data.instanceList",
            "itemName": "Instance",
            "items": {
              "properties": {
                "ErrorMessage": {
                  "backendName": "errorMessage",
                  "type": "string"
                },
                "InstanceId": {
                  "backendName": "instanceId",
                  "type": "string"
                },
                "InstanceName": {
                  "backendName": "instanceName",
                  "type": "string"
                },
                "Status": {
                  "backendName": "instanceStatus",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "ModifiedTime": {
            "backendName": "data.gmtModified",
            "description_en": "The time when the cluster was last modified",
            "description_zh": "修改时间",
            "example": "2023-06-19 10:40:29 +0800",
            "type": "string"
          },
          "RegionId": {
            "backendName": "data.regionId",
            "description_en": "The region ID of the cluster",
            "description_zh": "实例所属地域的ID",
            "example": "cn-hangzhou",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "本次请求的ID",
            "example": "CEF72CEB-54B6-4AE8-B225-F876FF7BZ015",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
