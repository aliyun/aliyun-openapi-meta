      "help_zh": "查询数量。取值范围[1,1000]",
      "location": "query",
      "maximum": "1000",
      "minimum": "1",
      "name": "limit",
      "options": [
        "--limit"
      ],
      "raw_name": "Limit",
      "required": false,
      "type": "int"
    }
  ],
