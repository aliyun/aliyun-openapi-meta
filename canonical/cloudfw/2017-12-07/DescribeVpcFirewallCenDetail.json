{
  "camel_example": "aliyun cloudfw DescribeVpcFirewallCenDetail --region cn-hangzhou --VpcFirewallId 'vfw-m5e7dbc4y0000'",
  "cmd_full_name": "cloudfw describe-vpc-firewall-cen-detail",
  "cmd_name": "describe-vpc-firewall-cen-detail",
  "deprecated": false,
  "description_en": "Queries the details of a virtual private cloud (VPC) firewall that protects traffic between network instances in a Cloud Enterprise Network (CEN) instance and a specified VPC",
