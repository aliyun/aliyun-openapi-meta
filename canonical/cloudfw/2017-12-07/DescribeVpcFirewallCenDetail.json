              "VswitchZoneId": {
                "backendName": "vswitchZoneId",
                "description_en": "The zone ID of the vSwitch",
                "description_zh": "虚拟交换机的可用区ID",
                "example": "cn-hangzhou-i",
                "type": "string"
              },
              "ZoneId": {
                "backendName": "zoneId",
