  "kebab_example": "aliyun cloudfw describe-vpc-firewall-cen-detail --vpc-firewall-id vfw-m5e7dbc4y0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeVpcFirewallCenDetail",
  "operation": {
    "action": "DescribeVpcFirewallCenDetail",
    "api_style": "RPC",
