{
  "cmd_full_name": "dbs describe-download-task",
  "cmd_name": "describe-download-task",
  "deprecated": false,
  "description_en": "Queries a list of advanced download tasks for RDS for MySQL, RDS for PostgreSQL, and PolarDB for MySQL instances",
  "description_zh": "查询RDS MySQL、RDS PostgreSQL、PolarDB MySQL版实例的高级下载任务列表",
  "kebab_example": "aliyun dbs describe-download-task --region-code cn-hangzhou --api-version 2021-01-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribeDownloadTask",
  "operation": {
    "action": "DescribeDownloadTask",
    "api_style": "RPC",
    "api_version": "2021-01-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The ID of the region where the instance resides. To obtain the region ID, call https://help.aliyun.com/document_detail/26231.html",
      "help_zh": "实例所在地域ID，您可以调用https://help.aliyun.com/document_detail/26231.html查询",
      "location": "query",
      "name": "region_code",
      "options": [
        "--region-code"
      ],
      "raw_name": "RegionCode",
      "required": true,
      "type": "string"
    },
    {
      "example": "rm-bp1imnmcjxdz7****",
      "help_en": "The instance ID.\n\nThis parameter is required",
      "help_zh": "实例ID。\n\n该参数为必填项",
      "location": "query",
      "name": "instance_name",
      "options": [
        "--instance-name"
      ],
      "raw_name": "InstanceName",
      "required": false,
      "type": "string"
    },
    {
      "example": "ds-rm-2ze8g2am97624****_cn-hangzhou",
      "help_en": "The ID of the data source in DBS. The format is: ds-${Instance ID}_${Region ID}",
      "help_zh": "数据源DBS标记ID，传入格式为：ds-${实例ID}_${regionId}",
      "location": "query",
      "name": "datasource_id",
      "options": [
        "--datasource-id"
      ],
      "raw_name": "DatasourceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "216****",
      "help_en": "The ID of the backup set. To obtain the backup set ID, call https://help.aliyun.com/document_detail/26273.html",
      "help_zh": "创建下载任务时生成的备份集ID，您可调用https://help.aliyun.com/document_detail/26273.html接口查询",
      "location": "query",
      "name": "backup_set_id",
      "options": [
        "--backup-set-id"
      ],
      "raw_name": "BackupSetId",
      "required": false,
      "type": "string"
    },
    {
      "example": "queueing",
      "help_en": "The state of the download task. Valid values:\n\ninitializing: The task is being initialized.\n\nqueueing: The task is in a queue.\n\nrunning: The task is running.\n\nfailed: The task failed.\n\nfinished: The task is successful.\n\nexpired: The download has expired",
      "help_zh": "下载任务的状态，取值如下：\n\ninitializing：初始化。\nqueueing：排队中。\nrunning：下载中。\nfailed：下载失败。\nfinished：下载成功。\nexpired：下载过期",
      "location": "query",
      "name": "state",
      "options": [
        "--state"
      ],
      "raw_name": "State",
      "required": false,
      "type": "string"
    },
    {
      "example": "full",
      "help_en": "The type of the download task. Valid values:\n\nfull: full backup set download.\n\npitr: point-in-time recovery download",
      "help_zh": "下载任务类型，取值如下：\n\nfull：全量备份集下载。\npitr：任意时间点下载",
      "location": "query",
      "name": "task_type",
      "options": [
        "--task-type"
      ],
      "raw_name": "TaskType",
      "required": false,
      "type": "string"
    },
    {
      "example": "1661941554000",
      "help_en": "The start of the time range to query tasks based on their creation time. This is a UNIX timestamp in milliseconds (ms)",
      "help_zh": "按创建时间区间的起始点查询，Long类型时间戳形式，单位为毫秒（ms）",
      "location": "query",
      "name": "start_time",
      "options": [
        "--start-time"
      ],
      "raw_name": "StartTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "1661941556000",
      "help_en": "The end of the time range to query tasks based on their creation time. This is a UNIX timestamp in milliseconds (ms)",
      "help_zh": "按创建时间区间的终止点查询，Long类型时间戳形式，单位为毫秒（ms）",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "50",
      "help_en": "The number of entries to return on each page",
      "help_zh": "每页的记录数",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number",
      "help_zh": "当前页码",
      "location": "query",
      "name": "current_page",
      "options": [
        "--current-page"
      ],
      "raw_name": "CurrentPage",
      "required": false,
      "type": "string"
    },
    {
      "example": "desc",
      "help_en": "The sorting direction. Valid values:\n\nasc: ascending order.\n\ndesc: descending order. This is the default value",
      "help_zh": "排序方向，取值如下：\n\nasc：正序。\ndesc：倒序，为默认值",
      "location": "query",
      "name": "order_direct",
      "options": [
        "--order-direct"
      ],
      "raw_name": "OrderDirect",
      "required": false,
      "type": "string"
    },
    {
      "example": "gmt_create",
      "help_en": "The field used for sorting. The default value is gmt_create, which indicates the creation time",
      "help_zh": "默认按创建时间排序，取值：gmt_create",
      "location": "query",
      "name": "order_column",
      "options": [
        "--order-column"
      ],
      "raw_name": "OrderColumn",
      "required": false,
      "type": "string"
    },
    {
      "example": "dds-example",
      "help_en": "The name of the sharded cluster. This parameter is required only for MongoDB instances",
      "help_zh": "仅MongoDB依赖，分片集群的集群名",
      "location": "query",
      "name": "cluster_name",
      "options": [
        "--cluster-name"
      ],
      "raw_name": "ClusterName",
      "required": false,
      "type": "string"
    }
  ],
