      "name": "token_vault_name",
      "options": [
        "--token-vault-name"
      ],
      "raw_name": "TokenVaultName",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "AgentIdentity",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "OAuth2CredentialProvider": {
            "backendName": "oauth2CredentialProvider",
            "description_en": "The credential provider",
            "description_zh": "凭证提供商",
            "properties": {
              "CallbackURL": {
                "backendName": "callbackURL",
                "description_en": "The unique callback URL assigned to the provider. You must configure this URL in the list of allowed callback URLs of the identity provider.\nFormat: https://agentidentitydata.{{region}}.aliyuncs.com/oauth2/callback/{{UUID}}\nIf you specify this value, the specified value is used.\nIf you do not specify this value, the server automatically generates one",
                "description_zh": "分配给该提供商的唯一回调地址，需配置到身份提供商允许的回调地址列表。\n格式：https://agentidentitydata.{{region}}.aliyuncs.com/oauth2/callback/{{UUID}}\n若传入该值，则使用传入的值。\n若不传入该值，则服务端自动生成",
                "example": "https://agentidentitydata.cn-beijing.aliyuncs.com/oauth2/callback/d51171bc-0dae-3219-8e65-6b4cdafa3beb",
                "type": "string"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The creation time",
                "description_zh": "创建时间",
                "example": "2025-12-18T06:19:17Z",
                "type": "string"
              },
              "CredentialProviderArn": {
                "backendName": "credentialProviderArn",
                "description_en": "The ARN of the credential provider",
                "description_zh": "凭证提供商的 ARN",
                "example": "acs:agentidentity:cn-beijing:123456:tokenvault/default/oauth2credentialprovider/oauth-provider-aliyun",
                "type": "string"
              },
              "CredentialProviderVendor": {
                "backendName": "credentialProviderVendor",
                "description_en": "The vendor of the provider, such as AliyunOAuth2, AlibabaCloudOAuth2, DingTalkOAuth2, FeiShuOAuth2, or CustomOAuth2",
                "description_zh": "提供商的厂商，如AliyunOAuth2,AlibabaCloudOAuth2,DingTalkOAuth2,FeiShuOAuth2,CustomOAuth2 等",
                "example": "AliyunOAuth2",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the OAuth 2.0 credential provider",
                "description_zh": "对该 OAuth2 凭证提供商的描述",
                "example": "example provider",
                "type": "string"
              },
              "IDaaSInstanceId": {
                "backendName": "idaasInstanceId",
                "description_en": "The IDaaS instance ID",
                "description_zh": "IDaaS实例ID",
                "example": "idaas_xxxx",
                "title_en": "IDaaS实例ID",
                "title_zh": "IDaaS实例ID",
                "type": "string"
              },
              "OAuth2CredentialProviderName": {
                "backendName": "oauth2CredentialProviderName",
                "description_en": "The name of the credential provider",
                "description_zh": "凭证提供商的名称",
                "example": "oauth2-provider-aliyun",
                "type": "string"
              },
              "OAuth2ProviderConfig": {
                "$ref": "#/components/schemas/OAuth2ProviderConfig",
                "backendName": "oauth2ProviderConfig",
                "description_en": "The object that contains provider-specific configurations, such as clientId and clientSecret",
                "description_zh": "包含提供商特定配置的对象，如 clientId, clientSecret 等",
                "example": "{\\\"includedOAuth2ProviderConfig\\\":{\\\"clientId\\\":\\\"client-id-demo\\\",\\\"tokenEndpoint\\\":\\\"https://oauth.example.com/token\\\",\\\"authorizationEndpoint\\\":\\\"https://oauth.example.com/authorize\\\"}}"
              },
              "OAuthType": {
                "backendName": "oauthType",
                "description_en": "The OAuth 2.0 authorization flow type. Valid values:\nUSER_FEDERATION: User federation identity. This is the default value.\nM2M: Machine-to-machine.\nON_BEHALF_OF: Access on behalf of a user. This value is used only in IDaaS outbound scenarios",
                "description_zh": "OAuth 2.0 授权流程类型。取值：USER_FEDERATION（用户联合身份，默认值）、M2M（机器对机器）、ON_BEHALF_OF（代表用户访问，仅 IDaaS 出站场景使用）",
                "example": "USER_FEDERATION",
                "type": "string"
              },
              "OutboundApplicationId": {
                "backendName": "outboundApplicationId",
                "description_en": "The ID of the outbound application",
                "description_zh": "出站应用ID",
                "example": "app_xxxxx",
                "title_en": "出站应用ID",
                "title_zh": "出站应用ID",
                "type": "string"
              },
              "OutboundAudience": {
                "backendName": "outboundAudience",
                "description_en": "The outbound audience",
                "description_zh": "出站受众",
                "example": "agent-xxxx",
                "title_en": "出站受众",
                "title_zh": "出站受众",
                "type": "string"
              },
              "OutboundClientId": {
                "backendName": "outboundClientId",
                "description_en": "The client ID of the outbound application",
                "description_zh": "出站应用ClientId",
                "example": "client_xxxx",
                "title_en": "出站应用ClientId",
                "title_zh": "出站应用ClientId",
                "type": "string"
              },
              "SourcePlatform": {
                "backendName": "sourcePlatform",
                "description_en": "The creation source of the credential provider. Valid values:\nManual: The provider is manually created.\nSLR: The provider is created by a service-linked role",
                "description_zh": "凭证提供商的创建来源。取值：Manual（手工创建）、SLR（服务关联角色代为创建）",
                "example": "Manual",
                "type": "string"
              },
              "TokenVaultName": {
                "backendName": "tokenVaultName",
                "description_en": "The name of the credential vault",
                "description_zh": "凭证库名称",
                "example": "default",
                "title_en": "TokenVault名称",
                "title_zh": "TokenVault名称",
                "type": "string"
              },
              "UpdateTime": {
                "backendName": "updateTime",
                "description_en": "The update time",
                "description_zh": "更新时间",
                "example": "2025-12-18T06:19:17Z",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique identifier of the request",
            "description_zh": "请求的唯一标识符",
            "example": "D9A9DC39-61BB-53FD-9ADC-B14884F21038",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
