        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "LoginPreference": {
            "backendName": "loginPreference",
            "description_en": "The logon preference configuration",
            "description_zh": "登录偏好配置",
            "properties": {
              "EnablePasswordLogin": {
                "backendName": "enablePasswordLogin",
                "description_en": "Indicates whether password logon is enabled",
                "description_zh": "是否开启密码登录",
                "example": "true",
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "PasswordPolicy": {
            "backendName": "passwordPolicy",
            "description_en": "The password policy configuration",
            "description_zh": "密码策略配置",
            "properties": {
              "HardExpire": {
                "backendName": "hardExpire",
                "description_en": "Indicates whether logon is prohibited after a password expires. A value of true indicates that the password must be reset by an administrator before the user can log on",
                "description_zh": "密码过期后是否禁止登录。true 表示密码过期后必须由管理员重置密码才能登录",
                "example": "false",
                "type": "boolean"
              },
              "MaxLoginAttempts": {
                "backendName": "maxLoginAttempts",
                "description_en": "The maximum number of consecutive logon failures. Default value: 5. This value cannot be modified",
                "description_zh": "最大连续登录失败次数。默认值：5，暂不支持修改",
                "example": "5",
                "format": "int64",
                "type": "integer"
              },
              "MaxPasswordAge": {
                "backendName": "maxPasswordAge",
                "description_en": "The maximum validity period of a password in days. Default value: 7. This value cannot be modified",
                "description_zh": "密码最大有效期（天）。默认值：7，暂不支持修改",
                "example": "7",
                "format": "int64",
                "type": "integer"
              },
              "MaxPasswordLength": {
                "backendName": "maxPasswordLength",
                "description_en": "The maximum length of the password. Fixed value: 32",
                "description_zh": "密码最大长度。固定值：32",
                "example": "32",
                "format": "int32",
                "type": "integer"
              },
              "MinPasswordLength": {
                "backendName": "minPasswordLength",
                "description_en": "The minimum length of the password. Fixed value: 8",
                "description_zh": "密码最小长度。固定值：8",
                "example": "8",
                "format": "int32",
                "type": "integer"
              },
              "PasswordNotContainUserName": {
                "backendName": "passwordNotContainUserName",
                "description_en": "Indicates whether the password must not contain the username",
                "description_zh": "密码是否不能包含用户名",
                "example": "true",
                "type": "boolean"
              },
              "RequireLowerCaseChars": {
                "backendName": "requireLowerCaseChars",
                "description_en": "Indicates whether lowercase letters are required",
                "description_zh": "是否要求包含小写字母",
                "example": "true",
                "type": "boolean"
              },
              "RequireNumbers": {
                "backendName": "requireNumbers",
                "description_en": "Indicates whether numbers are required",
                "description_zh": "是否要求包含数字",
                "example": "true",
                "type": "boolean"
              },
              "RequireSymbols": {
                "backendName": "requireSymbols",
                "description_en": "Indicates whether special characters are required",
                "description_zh": "是否要求包含特殊字符",
                "example": "true",
                "type": "boolean"
              },
              "RequireUpperCaseChars": {
                "backendName": "requireUpperCaseChars",
                "description_en": "Indicates whether uppercase letters are required",
                "description_zh": "是否要求包含大写字母",
                "example": "true",
                "type": "boolean"
              }
