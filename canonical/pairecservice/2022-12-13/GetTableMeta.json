{
  "camel_example": "",
  "cmd_full_name": "pairecservice get-table-meta",
  "cmd_name": "get-table-meta",
  "deprecated": false,
  "description_en": "Returns the details of a table",
  "description_zh": "获取数据表详细信息",
  "kebab_example": "aliyun pairecservice get-table-meta --table-meta-id 2 --instance-id '实例ID_pairec-cn-test1' --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetTableMeta",
  "operation": {
    "action": "GetTableMeta",
    "api_style": "ROA",
    "api_version": "2022-12-13",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/tablemetas/{TableMetaId}"
  },
  "parameters": [
    {
      "example": "2",
      "help_en": "The table ID",
      "help_zh": "数据表ID",
      "location": "path",
      "name": "table_meta_id",
      "options": [
        "--table-meta-id"
      ],
      "raw_name": "TableMetaId",
      "required": true,
      "type": "string"
    },
    {
      "example": "实例ID\tpairec-cn-test1",
      "help_en": "The ID of the instance. Call the https://help.aliyun.com/document_detail/2411819.html API to obtain it",
      "help_zh": "实例ID，可通过接口https://help.aliyun.com/document_detail/2411819.html获取",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/tablemetas/[TableMetaId]",
  "product_code": "PaiRecService",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The data returned",
        "description_zh": "Schema of Response",
        "properties": {
          "CanDelete": {
            "description_en": "Indicates whether the table can be deleted. The value is `false` if other resources reference the table",
            "description_zh": "是否可以删除，如果表在其他地方正在被引用，则返回 false",
            "example": "false",
            "type": "boolean"
          },
          "Config": {
            "description_en": "Additional configurations for the table, provided as a JSON string",
            "description_zh": "数据表的一些额外的配置",
            "example": "{\"table_type\":\"item\"}",
            "type": "string"
          },
          "Description": {
            "description_en": "The table description",
            "description_zh": "数据表描述",
            "example": "this is a test table",
            "type": "string"
          },
          "Fields": {
            "description_en": "The fields in the table",
            "description_zh": "表的字段列表",
            "itemName": "Fields",
            "items": {
              "description_en": "Information about a field",
              "description_zh": "字段信息",
              "properties": {
                "IsDimensionField": {
                  "description_en": "Whether the field is a dimension field",
                  "description_zh": "是否是维度字段",
                  "example": "false",
                  "type": "boolean"
                },
                "Meaning": {
                  "description_en": "The field meaning",
                  "description_zh": "字段含义",
                  "example": "the gender of people",
                  "type": "string"
                },
                "Name": {
                  "description_en": "The field name",
                  "description_zh": "字段名称",
                  "example": "gender",
                  "type": "string"
                },
                "Type": {
                  "description_en": "The field type",
                  "description_zh": "字段类型",
                  "example": "BIGINT",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "GmtCreateTime": {
            "description_en": "The creation time",
            "description_zh": "创建时间",
            "example": "2021-12-15:24:33",
            "type": "string"
          },
          "GmtImportedTime": {
            "description_en": "The import time",
            "description_zh": "字段导入时间",
            "example": "2021-12-15T23:24:33.132+08:00",
            "type": "string"
          },
          "GmtModifiedTime": {
            "description_en": "The modification time",
            "description_zh": "更新时间",
            "example": "2021-12-15:24:33",
            "type": "string"
          },
          "Module": {
            "description_en": "The table module. Valid values:\n\n`ABTest`: An A/B testing data table.\n\n`ExperimentTool`: An experiment tool table.\n\n`DataDiagnosis`: A table for data diagnosis",
            "description_zh": "数据表模块。\n\nABTest-实验数据表。\n\nExperimentTool-实验工具表。\n\nDataDiagnosis-数据诊断",
            "example": "ABTest",
            "type": "string"
          },
          "Name": {
            "description_en": "The table name",
            "description_zh": "数据表名称",
            "example": "test_table",
            "type": "string"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "28C5E01-ABF6-5AA8-B9FC-B3BA05DECC77",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "ResourceId": {
            "description_en": "The resource ID",
            "description_zh": "资源ID",
            "example": "reso-wkgo***",
            "type": "string"
          },
          "ResourceType": {
            "example": "Maxcompute",
            "title_en": "资源类型",
            "title_zh": "资源类型",
            "type": "string"
          },
          "ResourceUri": {
            "example": "test",
            "title_en": "资源地址",
            "title_zh": "资源地址",
            "type": "string"
          },
          "TableMetaId": {
            "description_en": "The table ID",
            "description_zh": "数据表ID",
            "example": "3",
            "type": "string"
          },
          "TableName": {
            "description_en": "The name of the table in the database",
            "description_zh": "数据库中的表名",
            "example": "table_mysql",
            "type": "string"
          },
          "Type": {
            "description_en": "The table type. Valid values:\n\n`MaxCompute`\n\n`Hologres`",
            "description_zh": "数据表类型。\n\nMaxCompute\n\nHologres",
            "example": "MaxCompute",
            "type": "string"
          },
          "Url": {
            "description_en": "The URL of the table in Data Map. This parameter is returned only for MaxCompute tables",
            "description_zh": "如果是MaxCompute表，此字段为数据地图的表的链接，否则为空",
            "example": "https://dmc-xxx.com/dm/table/xxx\n",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
