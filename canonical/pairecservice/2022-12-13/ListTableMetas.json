  "responses": {
    "200": {
      "schema": {
        "description_en": "The data returned",
        "description_zh": "Schema of Response",
        "properties": {
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "728C5E01-ABF6-5AA8-B9FC-B3BA05DECC77",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "TableMetas": {
            "description_en": "The list of data tables",
            "description_zh": "数据表列表",
            "itemName": "TableMetas",
            "items": {
              "description_en": "The metadata of a data table",
              "description_zh": "数据表信息",
              "properties": {
                "CanDelete": {
                  "description_en": "Indicates whether the data table can be deleted. A value of `false` indicates that the table is in use by other resources",
                  "description_zh": "是否可以删除，如果表在其他地方正在被引用，则返回false",
                  "example": "true",
                  "type": "boolean"
                },
                "Config": {
                  "description_en": "The additional configurations for the data table",
                  "description_zh": "数据表的一些额外的配置",
                  "example": "{\"table_type\":\"item\"}",
                  "type": "string"
                },
                "Description": {
                  "description_en": "The description of the data table",
                  "description_zh": "数据表描述",
                  "example": "this is a test table",
                  "type": "string"
                },
                "Fields": {
                  "description_en": "The fields in the data table",
                  "description_zh": "表的字段列表",
                  "itemName": "Fields",
                  "items": {
                    "description_en": "The details of a field",
                    "description_zh": "字段信息",
                    "properties": {
                      "IsDimensionField": {
                        "description_en": "Indicates whether the field is a dimension field",
                        "description_zh": "是否是维度字段",
                        "example": "false",
                        "type": "boolean"
                      },
                      "Meaning": {
                        "description_en": "The business meaning of the field",
                        "description_zh": "字段含义",
                        "example": "the gender of people",
                        "type": "string"
                      },
                      "Name": {
                        "description_en": "The name of the field",
                        "description_zh": "字段名称",
                        "example": "gender",
                        "type": "string"
                      },
                      "Type": {
                        "description_en": "The data type of the field",
                        "description_zh": "字段类型",
                        "example": "BIGINT",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "GmtCreateTime": {
                  "description_en": "The time when the data table was created",
                  "description_zh": "创建时间",
                  "example": "2021-12-12 12:24:33",
                  "type": "string"
                },
                "GmtImportedTime": {
                  "description_en": "The time when the fields were imported",
                  "description_zh": "字段导入时间",
                  "example": "imprecation",
                  "type": "string"
                },
                "GmtModifiedTime": {
                  "description_en": "The time when the data table was last modified",
                  "description_zh": "更新时间",
                  "example": "2021-12-12 12:24:33",
                  "type": "string"
                },
                "Module": {
                  "description_en": "The module of the data table. Valid values:\n\nABTest: A/B testing\n\nExperimentTool: Experiment tool\n\nDataDiagnosis: data diagnosis",
                  "description_zh": "数据表模块\n\nABTest：实验数据表\n\nExperimentTool：实验工具表\n\nDataDiagnosis：数据诊断",
                  "example": "ABTest",
                  "type": "string"
                },
                "Name": {
                  "description_en": "The name of the data table",
                  "description_zh": "数据表名称",
                  "example": "test_table",
                  "type": "string"
                },
                "ResourceId": {
                  "description_en": "The resource ID",
                  "description_zh": "资源ID",
                  "example": "reso-2s416t***",
                  "type": "string"
                },
                "ResourceType": {
                  "example": "Maxcompute",
                  "title_en": "资源类型",
                  "title_zh": "资源类型",
                  "type": "string"
                },
                "ResourceUri": {
                  "example": "test",
                  "title_en": "资源地址",
                  "title_zh": "资源地址",
                  "type": "string"
                },
                "TableMetaId": {
                  "description_en": "The ID of the data table",
                  "description_zh": "数据表ID",
                  "example": "3",
                  "type": "string"
                },
                "TableName": {
                  "description_en": "The name of the table in the database",
                  "description_zh": "数据库中的表名",
                  "example": "table_mysql",
                  "type": "string"
                },
                "Type": {
                  "description_en": "The type of the data table. Valid values:\n\nMaxCompute\n\nHologres",
                  "description_zh": "数据表类型。\n\nMaxCompute\n\nHologres",
                  "example": "MaxCompute",
                  "type": "string"
                },
                "Url": {
                  "description_en": "The URL of the table in Data Map. This parameter is returned only for MaxCompute data tables",
                  "description_zh": "如果是MaxCompute表，此处为数据地图的表的链接",
                  "example": "https://dmc-xxx.com/dm/table/xxx",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "TotalCount": {
            "description_en": "The total number of data tables",
            "description_zh": "总个数",
            "example": "20",
            "format": "int64",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
