            "example": "3",
            "title_en": "实验室ID。",
            "title_zh": "实验室ID。",
            "type": "string"
          },
          "LayerId": {
            "description_en": "The layer ID",
            "description_zh": "层ID",
            "example": "3",
            "title_en": "层ID。",
            "title_zh": "层ID。",
            "type": "string"
          },
          "Name": {
            "description_en": "The experiment name",
            "description_zh": "实验名称",
            "example": "experiment_test1",
            "title_en": "实验名称。",
            "title_zh": "实验名称。",
            "type": "string"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "Id of the request",
            "example": "74D958EF-3598-56FA-8296-FF1575CE43DF",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "SceneId": {
            "description_en": "The scene ID",
            "description_zh": "场景ID",
            "example": "3",
            "title_en": "场景ID。",
            "title_zh": "场景ID。",
            "type": "string"
          },
          "Status": {
            "description_en": "The status of the experiment. Valid values:<br>● Offline<br>● Online<br><br>",
            "description_zh": "状态过滤。\n● Offline-未上线\n● Online-已上线",
            "example": "Offline",
            "title_en": "状态过滤。\n● Offline-未上线\n● Online-已上线",
            "title_zh": "状态过滤。\n● Offline-未上线\n● Online-已上线",
            "type": "string"
          },
          "Type": {
            "description_en": "The type of the experiment. Valid values:<br>● Baseline: a baseline experiment.<br>● Normal: a normal experiment.<br><br>",
            "description_zh": "实验类型。\n● Baseline-基准实验。\n● Normal-普通实验",
            "example": "Baseline",
            "title_en": "实验类型。\n● Baseline-基准实验。\n● Normal-普通实验。",
            "title_zh": "实验类型。\n● Baseline-基准实验。\n● Normal-普通实验。",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
