{
  "camel_example": "",
  "cmd_full_name": "pairecservice get-experiment",
  "cmd_name": "get-experiment",
  "deprecated": false,
  "description_en": "Retrieves the details of a specified experiment",
  "description_zh": "获取指定实验的详细信息",
  "kebab_example": "aliyun pairecservice get-experiment --experiment-id 3 --instance-id pairec-cn-abcdefg1234 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetExperiment",
  "operation": {
    "action": "GetExperiment",
    "api_style": "ROA",
    "api_version": "2022-12-13",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/experiments/{ExperimentId}"
  },
  "parameters": [
    {
      "example": "3",
      "help_en": "The experiment ID. You can obtain this ID by calling the ListExperiments operation",
      "help_zh": "实验ID，可通过接口ListExperiments获取",
      "location": "path",
      "name": "experiment_id",
      "options": [
        "--experiment-id"
      ],
      "raw_name": "ExperimentId",
      "required": true,
      "type": "string"
    },
    {
      "example": "pairec-cn-abcdefg1234",
      "help_en": "The instance ID. You can obtain this ID by calling the ListInstances operation",
      "help_zh": "实例ID，可通过接口ListInstances获取",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/experiments/[ExperimentId]",
  "product_code": "PaiRecService",
  "protocol": "HTTP|HTTPS",
  "responses": {
