      "schema": {
        "description_en": "The response parameters",
        "description_zh": "Schema of Response",
        "properties": {
          "AliasExperimentId": {
            "description_en": "The alias of the experiment",
            "description_zh": "实验ID别名",
            "example": "L1#EG1#E1",
            "title_en": "实验ID别名。",
            "title_zh": "实验ID别名。",
            "type": "string"
          },
          "Buckets": {
            "description_en": "A comma-separated list of bucket numbers",
            "description_zh": "分配桶号",
            "example": "1,2,3",
            "title_en": "分配桶号。",
            "title_zh": "分配桶号。",
            "type": "string"
          },
          "Config": {
            "description_en": "The experiment configuration, in JSON format",
            "description_zh": "实验配置",
            "example": "{\"RankBy\": \"Score\"}",
            "title_en": "实验配置。",
            "title_zh": "实验配置。",
            "type": "string"
          },
          "DebugCrowdId": {
            "description_en": "The debug crowd ID",
