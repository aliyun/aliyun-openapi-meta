{
  "camel_example": "",
  "cmd_full_name": "pairecservice get-service",
  "cmd_name": "get-service",
  "deprecated": false,
  "description_en": "Retrieves the details of a service",
  "description_zh": "获取服务详情",
  "kebab_example": "aliyun pairecservice get-service --service-id 1 --instance-id pairec-test-xxx --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetService",
  "operation": {
    "action": "GetService",
    "api_style": "ROA",
    "api_version": "2022-12-13",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/services/{ServiceId}"
  },
  "parameters": [
    {
      "example": "1",
      "help_en": "The service ID",
      "help_zh": "服务ID",
      "location": "path",
      "name": "service_id",
      "options": [
        "--service-id"
      ],
      "raw_name": "ServiceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "pairec-test-xxx",
      "help_en": "The instance ID. You can call https://help.aliyun.com/document_detail/2411819.html to obtain the instance ID",
      "help_zh": "实例ID，可通过接口https://help.aliyun.com/document_detail/2411819.html获取",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/services/[ServiceId]",
  "product_code": "PaiRecService",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "CrInstanceId": {
            "description_en": "The Container Registry Enterprise instance ID selected by the user when a non-official image is used",
            "description_zh": "当选择非官方镜像时，用户选择的容器镜像企业版实例ID",
            "example": "cri-xxx",
            "title_en": "当选择非官方镜像时，用户选择的容器镜像企业版实例ID。",
            "title_zh": "当选择非官方镜像时，用户选择的容器镜像企业版实例ID。",
            "type": "string"
          },
          "Description": {
            "backendName": "Remark",
            "description_en": "The service description",
            "description_zh": "服务描述",
            "example": "this is a test rec engine",
            "type": "string"
          },
          "EngineConfigId": {
            "backendName": "EngineConfigId",
            "description_en": "The engine configuration ID",
            "description_zh": "引擎配置ID",
            "example": "3",
            "type": "string"
          },
          "GmtReleasedTime": {
            "backendName": "GmtReleasedTime",
            "description_en": "The time of the most recent production release",
            "description_zh": "最近一次（生产）发布时间",
            "example": "2021-12-15T23:24:33.132+08:00",
            "type": "string"
          },
          "ImageAuth": {
            "backendName": "ImageAuth",
            "description_en": "The image secret",
            "description_zh": "镜像密钥",
            "example": "********",
            "type": "string"
          },
          "ImageName": {
            "backendName": "ImageName",
            "description_en": "The image name",
            "description_zh": "镜像名称",
            "example": "registry-vpc.cn-beijing.aliyuncs.com/***/***",
            "type": "string"
          },
          "LatestProdReleaseOrder": {
            "backendName": "LatestProdReleaseOrder",
            "description_en": "The most recent production release record",
            "description_zh": "最近一次生产发布记录",
            "properties": {
              "Content": {
                "backendName": "Content",
                "description_en": "The release content",
                "description_zh": "发布内容",
                "example": "update golang version to 1.22",
                "type": "string"
              },
              "ImageVersion": {
                "backendName": "ImageVersion",
                "description_en": "The image version",
                "description_zh": "镜像版本",
                "example": "2.0.0",
                "type": "string"
              },
              "ReleaseInfo": {
                "backendName": "ReleaseInfo",
                "description_en": "The release information",
                "description_zh": "发布信息",
                "example": "{\n\t\"Pre\": {\n    \"Status\": \"Released\",\n    \"GmtReleasedTime\" : \"2021-12-15T23:24:33.132+08:00\",\n  },\n  \"Prod\": {\n    \"Status\": \"Released\",\n    \"GmtReleasedTime\" : \"2021-12-15T23:24:33.132+08:00\",\n  }\n}",
                "type": "string"
              },
              "ReleaseOrderId": {
                "backendName": "ReleaseOrderId",
                "description_en": "The release order ID",
                "description_zh": "发布单ID",
                "example": "3",
                "type": "string"
              },
              "Releaser": {
                "backendName": "Releaser",
                "description_en": "The publisher, including the name and UID of the Resource Access Management (RAM) users",
                "description_zh": "发布人（包含RAM账号的名称、uid）",
                "example": "E-xxx.xxx-@xxx.onaliyun.com",
                "type": "string"
              },
              "Topic": {
                "backendName": "Topic",
                "description_en": "The release title",
                "description_zh": "发布标题",
                "example": "update version",
                "type": "string"
              }
            },
            "type": "object"
          },
          "Name": {
            "backendName": "Name",
            "description_en": "The service name",
            "description_zh": "服务名称",
            "example": "test_rec",
            "type": "string"
          },
          "Region": {
            "backendName": "Region",
            "description_en": "The region where the service is deployed",
            "description_zh": "服务部署的Region",
            "example": "cn-beijing",
            "type": "string"
          },
          "RepositoryId": {
            "description_en": "The Container Registry Enterprise Edition repository ID selected by the user when a non-official image is used",
            "description_zh": "当选择非官方镜像时，用户选择的容器镜像企业版仓库ID",
            "example": "crr-xxx",
            "title_en": "当选择非官方镜像时，用户选择的容器镜像企业版仓库ID。",
            "title_zh": "当选择非官方镜像时，用户选择的容器镜像企业版仓库ID。",
            "type": "string"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "D75C43DC-3D3A-5CC8-9AAC-8C77306C433B",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "ServiceConfig": {
            "backendName": "ServiceConfig",
            "description_en": "The configuration used to publish the service, such as the service configuration in EAS",
            "description_zh": "发布服务所用的配置（如EAS的服务配置）",
            "example": "{\"Port\":8080}",
            "type": "string"
          },
          "ServiceResourceUri": {
            "backendName": "ServiceResourceUri",
            "description_en": "The resource address used to publish the service, such as the resource group name in Elastic Algorithm Service (EAS)",
            "description_zh": "发布服务所使用的资源地址（如EAS的资源组名）",
            "example": "eas-resource-xxx",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "v1_parameters": [
    {
      "help_en": "The instance ID. You can call https://help.aliyun.com/document_detail/2411819.html to obtain the instance ID",
      "help_zh": "实例ID，可通过接口https://help.aliyun.com/document_detail/2411819.html获取",
      "name": "InstanceId",
      "position": "query",
      "required": false,
      "type": "string"
    },
    {
      "help_en": "The service ID",
      "help_zh": "服务ID",
      "name": "ServiceId",
      "position": "path",
      "required": false,
      "type": "string"
    }
  ]
}
