{
  "cmd_full_name": "ccc create-user",
  "cmd_name": "create-user",
  "deprecated": false,
  "description_en": "Call the CreateUser operation to create a new agent in a specified instance",
  "description_zh": "调用CreateUser在指定实例下创建一个新的坐席",
  "kebab_example": "aliyun ccc create-user --instance-id ccc-test --login-name agent --display-name '坐席小王' --email username@example.com --role-id Agent@ccc-test --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "CreateUser",
  "operation": {
    "action": "CreateUser",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ccc-test",
      "help_en": "The instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "agent",
      "help_en": "The logon name of the agent. It must be 4 to 64 characters in length and can contain uppercase letters, lowercase letters, digits, periods (.), underscores (_), and hyphens (-)",
      "help_zh": "坐席登录名，长度为4-64个字符，可包含英文大小写字母、数字、英文句点“.”、下划线“_”或短划线“-”",
      "location": "query",
      "name": "login_name",
      "options": [
        "--login-name"
      ],
      "raw_name": "LoginName",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "坐席小王",
      "help_en": "The display name of the agent. It must be 1 to 128 characters in length",
      "help_zh": "坐席展示名，长度为1-128个字符",
      "location": "query",
      "max_length": "500",
      "min_length": "0",
      "name": "display_name",
      "options": [
        "--display-name"
      ],
      "raw_name": "DisplayName",
      "required": true,
      "type": "string"
    },
    {
      "example": "1382114****",
      "help_en": "The personal phone number of the agent. This number is used in OFF_SITE mode. The agent can use this number to answer calls in OFF_SITE mode",
      "help_zh": "坐席的个人电话号码，该号码在场外模式下会用到，坐席可以使用该号码进行场外模式接听",
      "location": "query",
      "name": "mobile",
      "options": [
        "--mobile"
      ],
      "raw_name": "Mobile",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "username@example.com",
      "help_en": "The email address of the agent. After the agent is created, an email is sent to this address. The email contains the logon URL for Cloud Contact Center, and the username and password for the RAM account. Keep this information secure",
      "help_zh": "坐席邮箱地址，坐席创建成功后会发送邮件到该邮箱，邮件中包含云联络中心登录地址，以及RAM账户的用户名和密码，请妥善保管",
      "location": "query",
      "name": "email",
      "options": [
        "--email"
      ],
      "raw_name": "Email",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "ON_SITE",
      "help_en": "The work mode",
      "help_zh": "工作模式",
      "location": "query",
      "name": "work_mode",
      "options": [
        "--work-mode"
      ],
      "raw_name": "WorkMode",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "Agent@ccc-test",
      "help_en": "The role ID. The format is Role\\@InstanceID. The following roles are supported: Admin (administrator), Manager (skill group leader), and Agent (agent)",
      "help_zh": "角色ID，格式为：角色@实例ID，包含三种角色：Admin（管理员）、Manager（技能组组长）、Agent（坐席）",
      "location": "query",
      "name": "role_id",
      "options": [
        "--role-id"
      ],
      "raw_name": "RoleId",
      "required": true,
      "type": "string"
    },
    {
      "example": "[{\"skillGroupId\":\"skillgroup1@ccc-test\",\"skillLevel\":1},{\"skillGroupId\":\"skillgroup2@ccc-test\",\"skillLevel\":10}]",
      "help_en": "A list of skill levels for skill groups. This is a string in the format of a JSON array. The array can contain up to 100 elements. Each element is an object that contains two fields: skillGroupId and skillLevel. For skillGroupId, enter the ID of the skill group to add. For skillLevel, enter the skill level to add. The value can range from 1 to 10. A smaller value indicates a higher skill level, meaning the agent can handle more calls per unit of time",
      "help_zh": "技能组的技能等级列表，格式为JSON数组的字符串，数组元素最大为100个，数组元素是一个对象，包含两个字段：skillGroupId和skillLevel，skillGroupId填写要添加的技能组ID，skillLevel填写要添加的技能等级，取值范围1-10，值越小，业务能力越强，单位时间内能处理更多的通话",
      "location": "query",
      "name": "skill_level_list",
      "options": [
        "--skill-level-list"
      ],
      "raw_name": "SkillLevelList",
      "required": false,
      "type": "string"
    },
    {
      "example": "false",
      "help_en": "Specifies whether the agent must reset the password upon the first logon. If set to true, the agent is prompted to reset the password when they first log on to the RAM account. Otherwise, they are not prompted. The default value is false",
      "help_zh": "首次登录时是否需要重置密码，如果为true，则在首次登录RAM账户时会提示重置密码，否则不提示。默认为false",
      "location": "query",
      "name": "reset_password",
      "options": [
        "--reset-password"
      ],
      "raw_name": "ResetPassword",
      "required": false,
      "type": "bool"
    },
    {
      "example": "1001",
      "help_en": "The agent's ID number. Set this as needed",
      "help_zh": "坐席的工号，客户可根据需要自行设置",
      "location": "query",
      "name": "display_id",
      "options": [
        "--display-id"
      ],
      "raw_name": "DisplayId",
      "required": false,
      "type": "string"
    },
    {
      "example": "http://abc.com/sam.jpg",
      "help_en": "The URL of the agent's profile picture",
      "help_zh": "坐席头像地址",
      "location": "query",
      "name": "avatar_url",
      "options": [
        "--avatar-url"
      ],
      "raw_name": "AvatarUrl",
      "required": false,
      "type": "string"
    },
    {
      "example": "老王",
      "help_en": "The agent's nickname",
      "help_zh": "座席昵称",
      "location": "query",
      "name": "nickname",
      "options": [
        "--nickname"
      ],
      "raw_name": "Nickname",
      "required": false,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to send an email notification.\n\ntrue: Send\n\nfalse: Do not send",
      "help_zh": "是否需要邮件通知。\ntrue: 发送\nfalse: 不发送",
      "location": "query",
      "name": "need_email_notification",
      "options": [
        "--need-email-notification"
      ],
      "raw_name": "NeedEmailNotification",
      "required": false,
      "type": "string"
    }
  ],
