{
  "cmd_full_name": "ccc list-realtime-agent-states",
  "cmd_name": "list-realtime-agent-states",
  "deprecated": false,
  "description_en": "You can invoke ListRealtimeAgentStates to obtain a real-time status data report for one or more specified agents in a specified instance",
  "description_zh": "调用ListRealtimeAgentStates获取指定实例下一个或多个指定坐席的实时状态数据报表",
  "kebab_example": "aliyun ccc list-realtime-agent-states --page-number 1 --page-size 10 --instance-id ccc-test --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "ListRealtimeAgentStates",
  "operation": {
    "action": "ListRealtimeAgentStates",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "list",
    "url": ""
  },
