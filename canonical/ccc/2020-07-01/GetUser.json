{
  "cmd_full_name": "ccc get-user",
  "cmd_name": "get-user",
  "deprecated": false,
  "description_en": "You can invoke GetUser to obtain the agent information corresponding to a specified agent ID under a specified instance",
  "description_zh": "调用GetUser获取指定实例下指定坐席ID对应的坐席信息",
  "kebab_example": "aliyun ccc get-user --instance-id ccc-test --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetUser",
  "operation": {
    "action": "GetUser",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ccc-test",
      "help_en": "Instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "agent@ccc-test",
      "help_en": "Agent ID. This parameter is optional. You must specify either UserId or Extension",
