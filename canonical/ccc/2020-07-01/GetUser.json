      "help_zh": "坐席分机号，选填，UserId和Extension任选一个填写即可",
      "location": "query",
      "name": "extension",
      "options": [
        "--extension"
      ],
      "raw_name": "Extension",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
