      "options": [
        "--coached-user-id"
      ],
      "raw_name": "CoachedUserId",
      "required": true,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "Coaching timeout. If the coaching session is not established within the specified time, the coaching operation is canceled. This field is optional and defaults to 30 seconds",
      "help_zh": "辅导超时时间，超过指定时间辅导没有建立，则取消辅导操作，此字段选填，默认30，单位秒",
      "location": "query",
      "maximum": "3600",
