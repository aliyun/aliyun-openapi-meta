{
  "cmd_full_name": "ccc start-conference",
  "cmd_name": "start-conference",
  "deprecated": false,
  "description_en": "You can invoke StartConference to initiate a conference",
  "description_zh": "调用StartConference发起一个会议",
  "kebab_example": "aliyun ccc start-conference --instance-id ccc-test --participant-list-json 80450000_,_13175110000 --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "StartConference",
  "operation": {
    "action": "StartConference",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ccc-test",
      "help_en": "The instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "agent@ccc-test",
      "help_en": "The agent ID initiating the conference call. This parameter is optional. If not specified, the agent mapped to the current RAM account is used by default",
      "help_zh": "发起会议的坐席ID，非必填，不填则默认使用当前RAM账户映射的坐席",
      "location": "query",
      "name": "user_id",
      "options": [
        "--user-id"
      ],
      "raw_name": "UserId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "[\"8045****\",\"1317511****\"]",
      "help_en": "A JSON-formatted string representing an array of participants. Each array element represents a participant. For internal calls to agents, the participant is the target agent's extension number. For external calls to customers, the participant is the customer's phone number",
      "help_zh": "参会方列表，格式为JSON数组的字符串，数组元素是参会方，如果是内呼坐席，参会方是目标的坐席分机号，如果是外呼客户，参会方是客户号码",
      "location": "query",
      "name": "participant_list_json",
      "options": [
        "--participant-list-json"
      ],
      "raw_name": "ParticipantListJson",
      "required": true,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "Timeout period. If the call is not answered within the time specified by this parameter, it will be automatically disconnected. This parameter is optional. The default value is 30 seconds",
      "help_zh": "超时时间，呼叫在经过该参数指定的时间仍然未接通的情况下，则主动挂断，非必填，默认30，单位秒",
      "location": "query",
      "maximum": "3600",
      "minimum": "0",
      "name": "timeout_seconds",
      "options": [
        "--timeout-seconds"
      ],
      "raw_name": "TimeoutSeconds",
      "required": false,
      "type": "int"
    },
    {
      "example": "无",
      "help_en": "Ingest endpoint data. It cannot exceed 128 bytes and is primarily used for extension requirements. Ordinary customers do not need to concern themselves with it",
      "help_zh": "随路数据，不能超过128字节，主要用于扩展需求，普通客户无需关心",
      "location": "query",
      "name": "tags",
      "options": [
        "--tags"
      ],
      "raw_name": "Tags",
      "required": false,
      "type": "string"
    }
  ],
