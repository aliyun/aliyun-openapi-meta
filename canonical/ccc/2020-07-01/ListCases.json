{
  "cmd_full_name": "ccc list-cases",
  "cmd_name": "list-cases",
  "deprecated": false,
  "description_en": "Invoke ListCases to obtain the execution details list of the outbound contact list for the predictive dialing Activity corresponding to the specified ID under the specified instance",
  "description_zh": "调用ListCases获取指定实例下指定ID对应的预测式外呼活动的外呼名单执行详情列表",
  "kebab_example": "aliyun ccc list-cases --instance-id ccc-test --campaign-id 6badb397-a8b5-40b6-21019d382a09 --page-number 1 --page-size 100 --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "ListCases",
  "operation": {
    "action": "ListCases",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "ccc-test",
      "help_en": "Instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "6badb397-a8b5-40b6-21019d382a09",
      "help_en": "Predictive outbound dialing activity ID",
      "help_zh": "预测式外呼活动ID",
      "location": "query",
      "name": "campaign_id",
      "options": [
        "--campaign-id"
      ],
      "raw_name": "CampaignId",
      "required": true,
      "type": "string"
    },
    {
      "example": "无",
      "help_en": "Filters by phone number. Fuzzy Matching is not supported. This parameter is not Required and defaults to empty",
      "help_zh": "按电话号码过滤，不支持模糊匹配，非必填，默认为空",
      "location": "query",
      "name": "phone_number",
      "options": [
        "--phone-number"
      ],
      "raw_name": "PhoneNumber",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The paging ordinal number, ranging from 1 to 100",
      "help_zh": "分页序号，范围1-100",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": true,
      "type": "int"
    },
    {
      "example": "100",
      "help_en": "Page size, ranging from 1 to 100",
      "help_zh": "分页大小，范围1-100",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": true,
      "type": "int"
    },
    {
      "example": "Pending",
      "help_en": "Pending (to be dialed)<br>\nExecuting (dialing in progress)<br>\nConnected (contact succeeded)<br>\nFailed (contact failed)<br>\nAborted (call stopped or canceled)<br>\nForbidden (call prohibited by rule, such as blacklist)",
      "help_zh": "Pending（待拨打）  \nExecuting（拨打中）   \nConnected（联系成功）  \nFailed（联系失败）  \nAborted（止呼, 取消呼叫）  \nForbidden（规则禁止呼叫，比如黑名单）",
      "location": "query",
      "name": "state",
      "options": [
        "--state"
      ],
      "raw_name": "State",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CCC",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "Response code",
            "description_zh": "响应码",
            "example": "OK",
            "type": "string"
          },
          "Data": {
            "backendName": "data",
            "description_en": "Data",
            "description_zh": "数据",
            "properties": {
              "List": {
                "backendName": "list",
                "description_en": "List of contact list execution details",
                "description_zh": "联系人名单执行详情列表",
                "itemName": "list",
                "items": {
                  "description_en": "Contact list execution details",
                  "description_zh": "联系人名单执行详情",
                  "properties": {
                    "AbandonPhase": {
                      "backendName": "abandonType",
                      "description_en": "Phase at which the call was abandoned.\n\nIVR (IVR interaction phase)\n\nQueuing (queuing phase)\n\nRinging (agent ringing phase)",
                      "description_zh": "通话被放弃的阶段。  \nIVR（IVR交互阶段）  \nQueuing（排队阶段）  \nRinging（坐席振铃阶段）",
                      "example": "Ringing",
                      "type": "string"
                    },
                    "AbandonType": {
                      "backendName": "abandonType",
                      "description_en": "The type of call abandonment, that is, the reason why the call was not successfully connected",
                      "description_zh": "通话被放弃的类型，即未成功接通的原因",
                      "example": "NA",
                      "type": "string"
                    },
                    "AttemptCount": {
                      "backendName": "attemptCount",
                      "description_en": "Number of attempts, which is the total number of calls made to this contact",
                      "description_zh": "已尝试次数，对该联系人的总呼叫次数",
                      "example": "1",
                      "format": "int64",
                      "type": "integer"
                    },
                    "CaseId": {
                      "backendName": "caseId",
                      "description_en": "System-generated contact ID. Customers do not need to concern themselves with this",
                      "description_zh": "系统生成的联系人ID，客户无需关心",
                      "example": "60ecb1a2-4480-4d01-bede-c5b7655bfadf",
                      "type": "string"
                    },
                    "CustomVariables": {
                      "backendName": "customVariables",
                      "description_en": "Custom variables defined by the customer, formatted as a JSON object. The object can contain up to 10 properties, each with a name and value defined by the customer. These can be configured when creating a predictive outbound dialing activity",
                      "description_zh": "客户自定义变量，格式为JSON对象，对象最多包含10个属性，每个属性的名称和值均由客户自定义，客户在创建预测式外呼活动时可以设置",
                      "example": "{\"name\":\"yy\",\"客戶标签\":\"tag-yy\"}",
                      "type": "string"
                    },
                    "FailureReason": {
                      "backendName": "failureReason",
                      "description_en": "Reason for outbound call failure",
                      "description_zh": "外呼失败原因",
                      "example": "无",
                      "type": "string"
                    },
                    "PhoneNumber": {
                      "backendName": "phoneNumber",
                      "description_en": "Phone number",
                      "description_zh": "电话号码",
                      "example": "1888888****",
                      "type": "string"
                    },
                    "State": {
                      "backendName": "state",
                      "description_en": "Status",
                      "description_zh": "状态",
                      "example": "Connected",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "PageNumber": {
                "backendName": "pageNumber",
                "description_en": "Page number, ranging from 1 to 100",
                "description_zh": "分页序号，范围1-100",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "PageSize": {
                "backendName": "pageSize",
                "description_en": "Page size, ranging from 1 to 100",
                "description_zh": "分页大小，范围1-100",
                "example": "100",
                "format": "int64",
                "type": "integer"
              },
              "TotalCount": {
                "backendName": "totalCount",
                "description_en": "Total count",
                "description_zh": "总数",
                "example": "1",
                "format": "int64",
                "type": "integer"
              }
            },
            "title_en": "data",
            "title_zh": "data",
            "type": "object"
          },
          "HttpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "HTTP status code",
            "description_zh": "HTTP状态码",
            "example": "200",
            "format": "int64",
            "type": "integer"
          },
          "Message": {
            "backendName": "message",
            "description_en": "Response message",
            "description_zh": "响应信息",
            "example": "无",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "7CC6523B-0E51-1B62-8DA5-6A9831CAE316",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
