{
  "cmd_full_name": "ccc get-campaign",
  "cmd_name": "get-campaign",
  "deprecated": false,
  "description_en": "Gets a predictive outbound campaign by its ID from a specified instance",
  "description_zh": "调用GetCampaign获取指定实例下指定ID对应的预测式外呼活动",
  "kebab_example": "aliyun ccc get-campaign --instance-id ccc-test --campaign-id 6badb397-a8b5-40b6-21019d382a09 --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetCampaign",
  "operation": {
    "action": "GetCampaign",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "ccc-test",
      "help_en": "The ID of the instance",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "6badb397-a8b5-40b6-21019d382a09",
      "help_en": "The ID of the campaign",
      "help_zh": "预测式外呼活动ID",
      "location": "query",
      "name": "campaign_id",
      "options": [
        "--campaign-id"
      ],
      "raw_name": "CampaignId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CCC",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The response code",
            "description_zh": "响应码",
            "example": "OK",
            "type": "string"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The data returned",
            "description_zh": "数据",
            "properties": {
              "ActualEndTime": {
                "backendName": "actualEndTime",
                "description_en": "The actual end time of the predictive outbound campaign. This is a Unix timestamp in milliseconds",
                "description_zh": "预测式外呼活动实际结束时间，格式为Unix时间戳，单位毫秒",
                "example": "1634008800000",
                "format": "int64",
                "type": "integer"
              },
              "ActualStartTime": {
                "backendName": "actualStartTime",
                "description_en": "The actual start time of the predictive outbound campaign. This is a Unix timestamp in milliseconds",
                "description_zh": "预测式外呼活动实际开始时间，格式为Unix时间戳，单位毫秒",
                "example": "1634000460000",
                "format": "int64",
                "type": "integer"
              },
              "CampaignId": {
                "backendName": "campaignId",
                "description_en": "The ID of the predictive outbound campaign",
                "description_zh": "预测式外呼活动ID",
                "example": "6badb397-a8b5-40b6-21019d382a09",
                "title_en": "id",
                "title_zh": "id",
                "type": "string"
              },
              "CasesAborted": {
                "backendName": "casesAborted",
                "description_en": "The number of aborted contacts",
                "description_zh": "取消呼叫的联系人数量",
                "example": "0",
                "format": "int64",
                "type": "integer"
              },
              "CasesConnected": {
                "backendName": "casesConnected",
                "description_en": "The number of connected contacts",
                "description_zh": "已接通的联系人数量",
                "example": "40",
                "format": "int64",
                "type": "integer"
              },
              "CasesUncompleted": {
                "backendName": "casesUncompleted",
                "description_en": "The number of uncompleted contacts",
                "description_zh": "未完呼叫的联系人数量",
                "example": "0",
                "format": "int64",
                "type": "integer"
              },
              "CasesUncompletedAfterAttempt": {
                "backendName": "casesUncompletedAfterAttempted",
                "type": "string"
              },
              "CasesUncompletedAfterAttempted": {
                "backendName": "casesUncompletedAfterAttempted",
                "description_en": "The number of attempted but unconnected contacts that are still eligible for redial",
                "description_zh": "尝试呼叫过但未接通，且未达到最大尝试次数的联系人数量。即经过重试后呼叫成功的联系人",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "CompletionRate": {
                "backendName": "completedRate",
                "format": "float",
                "type": "number"
              },
              "ContactFlowId": {
                "backendName": "contactFlowId",
                "type": "string"
              },
              "MaxAttemptCount": {
                "backendName": "maxAttemptCount",
                "description_en": "The maximum number of call attempts for each contact. If an attempt fails, the contact is redialed until this limit is reached",
                "description_zh": "预测式外呼活动的最大尝试次数，表示当活动的号码呼叫失败时，最多重呼几次",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "MinAttemptInterval": {
                "backendName": "minAttemptInterval",
                "description_en": "The minimum interval, in seconds, to wait before redialing a failed call",
                "description_zh": "预测式外呼活动的最小重呼间隔，表示失败重呼时的最小间隔，单位秒",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the predictive outbound campaign",
                "description_zh": "预测式外呼活动名称",
                "example": "test-campaign",
                "type": "string"
              },
              "PlanedEndTime": {
                "backendName": "planedEndTime",
                "description_en": "The planned end time of the predictive outbound campaign. This is a Unix timestamp in milliseconds",
                "description_zh": "预测式外呼活动计划结束时间，格式为Unix时间戳，单位毫秒",
                "example": "1634054400000",
                "format": "int64",
                "type": "integer"
              },
              "PlanedStartTime": {
                "backendName": "planedStartTime",
                "description_en": "The planned start time of the predictive outbound campaign. This is a Unix timestamp in milliseconds",
                "description_zh": "预测式外呼活动计划开始时间，格式为Unix时间戳，单位毫秒",
                "example": "1633968000000",
                "format": "int64",
                "type": "integer"
              },
              "QueueId": {
                "backendName": "queueId",
                "description_en": "The ID of the associated skill group",
                "description_zh": "关联的技能组ID",
                "example": "skillgroup@ccc-test",
                "type": "string"
              },
              "QueueName": {
                "backendName": "queueName",
                "description_en": "The name of the associated skill group",
                "description_zh": "关联的技能组名称",
                "example": "测试技能组",
                "type": "string"
              },
              "Simulation": {
                "backendName": "simulation",
                "description_en": "Indicates whether the campaign is a test simulation. This parameter is not intended for production use",
                "description_zh": "是否为模拟活动，用于测试，普通客户无需关心",
                "example": "false",
                "type": "boolean"
              },
              "SimulationParameters": {
                "backendName": "simulationParameters",
                "description_en": "The parameters for a test simulation. This parameter is not intended for production use",
                "description_zh": "模拟活动参数，用于测试，普通客户无需关心",
                "example": "无",
                "type": "string"
              },
              "State": {
                "backendName": "state",
                "description_en": "The state of the predictive outbound campaign",
                "description_zh": "预测式外呼活动状态",
                "example": "Completed",
                "type": "string"
              },
              "StrategyParameters": {
                "backendName": "strategyParameters",
                "description_en": "The strategy parameters for the predictive outbound campaign, in JSON format. For a `PID` strategy, the format is `{\"abandonRate\":\"5\",\"historicalConnectedRate\":\"35\"}`. For a `PACING` strategy, the format is `{\"ratio\":1}`. `abandonRate` specifies the target abandon rate, `historicalConnectedRate` specifies the historical connection rate for reference, and `ratio` specifies the fixed dialing ratio",
                "description_zh": "预测式外呼活动的策略参数，PID策略下的格式参数示例：{\"abandonRate\":\"5\",\"historicalConnectedRate\":\"35\"}，PACING策略下的格式参数示例：{\"ratio\":1}。abandonRate表示期望呼损率，historicalConnectedRate表示历史参考接通率，ratio表示固定外呼比例",
                "example": "{\"ratio\":1}",
                "type": "string"
              },
              "StrategyType": {
                "backendName": "strategyType",
                "description_en": "The dialing strategy for the predictive outbound campaign",
                "description_zh": "预测式外呼活动的策略模式",
                "example": "PACING",
                "type": "string"
              },
              "TotalCases": {
                "backendName": "totalCases",
                "description_en": "The total number of contacts",
                "description_zh": "联系人总数",
                "example": "100",
                "format": "int64",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "HttpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code",
            "description_zh": "HTTP状态码",
            "example": "200",
            "format": "int64",
            "type": "integer"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "6CCEF32F-8614-535F-A1D9-D85B8C0DC4F0",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
