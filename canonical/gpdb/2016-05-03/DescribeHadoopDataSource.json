{
  "camel_example": "aliyun gpdb DescribeHadoopDataSource --region cn-hangzhou --DBInstanceId 'gp-xxx' --RegionId 'cn-hangzhou'",
  "cmd_full_name": "gpdb describe-hadoop-data-source",
  "cmd_name": "describe-hadoop-data-source",
  "deprecated": false,
  "description_en": "Obtains the configurations of a Hadoop data source",
  "description_zh": "获取hadoop数据源配置信息",
  "kebab_example": "aliyun gpdb describe-hadoop-data-source --db-instance-id gp-xxx --biz-region-id cn-hangzhou --region cn-hangzhou",
  "method": "GET|POST|PUT",
  "multi_version": false,
  "name": "DescribeHadoopDataSource",
  "operation": {
    "action": "DescribeHadoopDataSource",
    "api_style": "RPC",
    "api_version": "2016-05-03",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "gp-xxx",
      "help_en": "The instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "db_instance_id",
      "options": [
        "--db-instance-id"
      ],
      "raw_name": "DBInstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "123",
      "help_en": "The data source ID",
      "help_zh": "服务ID",
      "location": "query",
      "name": "data_source_id",
      "options": [
        "--data-source-id"
      ],
      "raw_name": "DataSourceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID of the instance.\n\nYou can call the https://help.aliyun.com/document_detail/2361846.html operation to query the most recent region list",
      "help_zh": "地域ID。\n\n您可以调用https://help.aliyun.com/document_detail/2361846.html接口查看可用的地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "gpdb",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "CreateTime": {
            "backendName": "data.createTime",
            "description_en": "The time when the service was created",
            "description_zh": "创建时间",
            "example": "2019-09-08T16:00:00Z",
            "type": "string"
          },
          "DataSourceDescription": {
            "backendName": "data.dataSourceDescription",
            "description_en": "The description of the service. The description can be up to 256 characters in length",
            "description_zh": "服务描述，最大长度为256字符",
            "example": "pxf for hdfs data source",
            "type": "string",
            "visibility": "Public"
          },
          "DataSourceDir": {
            "backendName": "data.dataSourceDir",
            "description_en": "The service directory in which Hadoop-related configuration files are stored",
            "description_zh": "服务目录，在该目录下保留有Hadoop相关的配置文件",
            "example": "HadoopDir",
            "type": "string",
            "visibility": "Public"
          },
          "DataSourceId": {
            "backendName": "data.dataSourceId",
            "description_en": "The data source ID",
            "description_zh": "数据源ID",
            "example": "123",
            "type": "string",
            "visibility": "Public"
          },
          "DataSourceName": {
            "backendName": "data.dataSourceName",
            "description_en": "The name of the service",
            "description_zh": "服务名称",
            "example": "hdfs_pxf",
            "type": "string",
            "visibility": "Public"
          },
          "DataSourceStatus": {
            "backendName": "data.dataSourceStatus",
            "description_en": "The status of the service. Valid values:\n\nInit\nRunning\nException",
            "description_zh": "服务状态位，取值：\n\n初始化中 Init\n\n运行中 Running\n\n异常 Exception",
            "example": "Running",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "DataSourceType": {
            "backendName": "data.dataSourceType",
            "description_en": "The type of the data source",
            "description_zh": "数据源类型",
            "example": "hive",
            "type": "string"
          },
          "EmrInstanceId": {
            "backendName": "data.emrInstanceId",
            "description_en": "The E-MapReduce (EMR) Hadoop cluster ID",
            "description_zh": "emr实例id",
            "example": "c-1234567",
            "type": "string"
          },
          "ExternalDataServiceId": {
            "backendName": "data.externalDataServiceId",
            "description_en": "The ID of the external data service",
            "description_zh": "外部数据服务id",
            "example": "2952",
            "type": "string"
          },
          "HDFSConf": {
            "backendName": "data.hdfsConf",
            "description_en": "The content of the Hadoop hdfs-site.xml file",
            "description_zh": "Hadoop hdfs-site.xml文件内容",
            "example": "<?xml version=\"1.0\" ?>\n<!-- Created at 2023-08-15 13:52:43.945 -->\n<configuration>\n    <property>\n        <name>dfs.datanode.cache.revocation.timeout.ms</name>\n        <value>900000</value>\n    </property>\n    <property>\n        <name>dfs.namenode.resource.check.interval</name>\n        <value>5000</value>\n    </property>\n</configuration>",
            "type": "string"
          },
          "HadoopCoreConf": {
            "backendName": "data.hadoopCoreConf",
            "description_en": "The content of the Hadoop core-site.xml file",
            "description_zh": "Hadoop core-site.xml文件内容",
            "example": "<?xml version=\"1.0\" ?>\n<!-- Created at 2023-08-15 13:52:39.527 -->\n<configuration>\n    <property>\n        <name>hadoop.http.authentication.kerberos.keytab</name>\n        <value>/etc/emr/hadoop-conf/http.keytab</value>\n    </property>\n    <property>\n        <name>fs.oss.idle.timeout.millisecond</name>\n        <value>30000</value>\n    </property>\n    <property>\n        <name>fs.oss.download.thread.concurrency</name>\n        <value>32</value>\n    </property>\n</configuration>",
            "type": "string"
          },
          "HadoopCreateType": {
            "backendName": "data.hadoopCreateType",
            "description_en": "The type of the external service. Valid values:\n\nemr\nselfCreate",
            "description_zh": "外部服务创建类型：\n\nemr\n\nselfCreate",
            "example": "emr",
            "type": "string"
          },
          "HadoopHostsAddress": {
            "backendName": "data.hadoopHostsAddress",
            "description_en": "The IP address and hostname of the Hadoop cluster (data source) in the /etc/hosts file",
            "description_zh": "Hadoop集群源节点在/etc/hosts文件中的地址和hostname",
            "example": "127.0.0.1 localhost",
            "type": "string"
          },
          "HiveConf": {
            "backendName": "data.hiveConf",
            "description_en": "The content of the Hadoop hive-site.xml file",
            "description_zh": "Hadoop hive-site.xml文件内容",
            "example": "<?xml version=\"1.0\" ?>\n<!-- Created at 2023-08-15 13:52:50.646 -->\n<configuration>\n    <property>\n        <name>hive.exec.reducers.bytes.per.reducer</name>\n        <value>256000000</value>\n    </property>\n    <property>\n        <name>hive.stats.column.autogather</name>\n        <value>false</value>\n    </property>\n</configuration>",
            "type": "string"
          },
          "MapReduceConf": {
            "backendName": "data.mapReduceConf",
            "description_en": "The content of the Hadoop mapred-site.xml file",
            "description_zh": "hadoop mapred-site.xml文件内容",
            "example": "<?xml version=\"1.0\" ?>\n<!-- Created at 2023-08-15 13:53:28.962 -->\n<configuration>\n    <property>\n        <name>mapreduce.map.speculative</name>\n        <value>true</value>\n    </property>\n    <property>\n        <name>mapreduce.jobhistory.keytab</name>\n        <value></value>\n    </property>\n</configuration>",
            "type": "string"
          },
          "ModifyTime": {
            "backendName": "data.modifyTime",
            "description_en": "The time when the data source was last modified",
            "description_zh": "最后修改时间",
            "example": "2024-09-28T02:18:39Z",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "B4CAF581-2AC7-41AD-8940-D56DF7AADF5B",
            "type": "string",
            "visibility": "Public"
          },
          "StatusMessage": {
            "backendName": "data.statusMessage",
            "description_en": "The information about the service status. For example, if the service is in the exception state, the cause of the exception is displayed. If the service is in the running state, this parameter is left empty",
            "description_zh": "服务状态信息，例如异常情况，则显示异常原因。正常Running状态下空值",
            "example": "\"\"",
            "type": "string"
          },
          "YarnConf": {
            "backendName": "data.yarnConf",
            "description_en": "The content of the Hadoop yarn-site.xml file",
            "description_zh": "Hadoop yarn-site.xml文件内容",
            "example": "<?xml version=\"1.0\" ?>\n<!-- Created at 2023-08-15 13:53:29.021 -->\n<configuration>\n    <property>\n        <name>yarn.nodemanager.linux-container-executor.nonsecure-mode.local-user</name>\n        <value>hadoop</value>\n    </property>\n    <property>\n        <name>yarn.scheduler.fair.dynamic.max.assign</name>\n        <value>true</value>\n    </property>\n</configuration>",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
