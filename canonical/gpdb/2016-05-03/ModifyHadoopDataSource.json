{
  "camel_example": "aliyun gpdb ModifyHadoopDataSource --region cn-hangzhou --DBInstanceId 'gp-xxxxxxx' --RegionId 'cn-hangzhou'",
  "cmd_full_name": "gpdb modify-hadoop-data-source",
