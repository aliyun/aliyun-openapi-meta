                  "type": "integer",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "data.pageNumbers",
            "description_en": "The page number",
            "description_zh": "查询结果页数",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "PageRecordCount": {
            "backendName": "data.pageRecordCount",
