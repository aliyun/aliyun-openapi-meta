                  "type": "string",
                  "visibility": "Public"
                },
                "ScanRowCounts": {
                  "backendName": "scanRowCounts",
                  "description_en": "The number of entries scanned",
                  "description_zh": "扫描行数",
                  "example": "1",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "SourceIP": {
                  "backendName": "sourceIp",
