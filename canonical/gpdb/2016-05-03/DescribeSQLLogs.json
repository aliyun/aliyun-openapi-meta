{
  "camel_example": "aliyun gpdb DescribeSQLLogs --region cn-hangzhou --EndTime '2021-03-17T06:30Z' --DBInstanceId 'gp-xxxxxxxx' --StartTime '2021-03-10T06:30Z'",
  "cmd_full_name": "gpdb describe-sql-logs",
