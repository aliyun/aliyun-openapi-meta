{
  "camel_example": "aliyun elasticsearch POST /openapi/instances/es-cn-npk2154oi000b0000/white-ips --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "elasticsearch update-white-ips",
  "cmd_name": "update-white-ips",
  "deprecated": false,
  "description_en": "Modifies the VPC private network access whitelist of an Elasticsearch instance",
  "description_zh": "修改ES实例的VPC私网访问白名单",
  "kebab_example": "aliyun elasticsearch update-white-ips --instance-id es-cn-npk2154oi000b0000 --api-version 2017-06-13 --region cn-hangzhou",
  "method": "PATCH|POST",
  "multi_version": true,
  "name": "UpdateWhiteIps",
  "operation": {
    "action": "UpdateWhiteIps",
    "api_style": "ROA",
    "api_version": "2017-06-13",
    "body_mapping": {
      "es_ip_whitelist": "esIPWhitelist",
      "white_ip_group": "whiteIpGroup"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "update",
    "url": "/openapi/instances/{InstanceId}/white-ips"
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "es-cn-npk2154oi000b****",
      "help_en": "The instance ID",
      "help_zh": "实例ID",
      "location": "path",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "5A2CFF0E-5718-45B5-9D4D-70B3FF****",
      "help_en": "A unique token generated by the client to guarantee the idempotency of the request. The maximum length is 64 ASCII characters",
      "help_zh": "用于保证请求的幂等性。由客户端生成该参数值，要保证在不同请求间唯一，最大不超过64个ASCII字符",
      "location": "query",
      "name": "client_token",
      "options": [
        "--client-token"
      ],
      "raw_name": "clientToken",
      "required": false,
      "type": "string"
    },
    {
      "example": "Cover",
      "help_en": "The modification mode. Valid values:\n\nCover (default): overwrites the IP addresses in the original whitelist with the values specified in the ips parameter.\n\nAppend: adds the IP addresses specified in the ips parameter to the original whitelist.\n\nDelete: removes the IP addresses specified in the ips parameter from the original whitelist. At least one IP address must be retained",
      "help_zh": "修改方式，可选值：\n\nCover（默认）：使用ips参数的值覆盖原白名单的IP地址。\n\nAppend：在原白名单的IP地址中增加ips参数中输入的IP地址。\n\nDelete：在原白名单的IP地址中删除ips参数中输入的IP地址，至少需要保留一个IP地址",
      "location": "query",
      "name": "modify_mode",
      "options": [
        "--modify-mode"
      ],
      "raw_name": "modifyMode",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The IP address information in the whitelist",
      "help_zh": "白名单中的IP地址信息",
      "location": "body",
      "name": "es_ip_whitelist",
      "options": [
        "--es-ip-whitelist"
      ],
      "param_style": "json",
      "raw_name": "esIPWhitelist",
      "required": false,
      "type": "array"
    },
    {
      "fields": [
        {
          "example": "test_group",
          "help_en": "The name of the whitelist group. This parameter is required if the whiteIpGroup parameter is specified",
          "help_zh": "白名单组的组名。如果选填了whiteIpGroup参数，则该参数必填",
          "name": "group_name",
          "options": [
            "--group-name"
          ],
          "raw_name": "groupName",
          "required": false,
          "type": "string"
        },
        {
          "element": {
            "type": "string"
          },
          "help_en": "The list of IP addresses in the whitelist group",
          "help_zh": "白名单组中的IP地址列表",
          "name": "ips",
          "options": [
            "--ips"
          ],
          "raw_name": "ips",
          "required": false,
          "type": "array"
        },
        {
          "example": "PRIVATE_ES",
          "help_en": "The type of the IP whitelist. The value is fixed as PRIVATE_ES, which indicates the private network access whitelist",
          "help_zh": "IP白名单的类型。固定为PRIVATE_ES，即私网访问白名单",
          "name": "white_ip_type",
          "options": [
            "--white-ip-type"
          ],
          "raw_name": "whiteIpType",
          "required": false,
          "type": "string"
        }
      ],
      "help_en": "Updates the instance whitelist configuration by whitelist group. Only one whitelist group can be updated at a time.\n<notice> You cannot configure esIPWhitelist and whiteIpGroup at the same time.\n</notice>",
      "help_zh": "以白名单组方式更新实例白名单配置，仅支持更新一个白名单组。\n<notice> 不支持同时配置esIPWhitelist和whiteIpGroup。\n</notice>",
      "location": "body",
      "name": "white_ip_group",
      "options": [
        "--white-ip-group"
      ],
      "param_style": "json",
      "raw_name": "whiteIpGroup",
      "required": false,
      "type": "object"
    }
  ],
