      "param_style": "json",
      "raw_name": "plugins",
      "required": false,
      "type": "array"
    },
    {
      "enum": [
        "engineVersion",
        "aliVersion"
      ],
      "example": "engineVersion",
      "help_en": "The upgrade type. Valid values:\n\nengineVersion (default): major engine version upgrade.\naliVersion: kernel version upgrade",
      "help_zh": "升级类型，可选值：\n\nengineVersion（默认）：大版本升级\naliVersion：内核版本升级",
      "location": "body",
      "name": "type",
      "options": [
        "--type"
      ],
      "param_style": "json",
      "raw_name": "type",
      "required": false,
      "type": "string"
    },
    {
      "example": "6.7",
      "help_en": "The version after the upgrade. If type is set to engineVersion, the value is the instance version, such as 6.7. If type is set to aliVersion, the value is the kernel version, such as ali1.2.0",
      "help_zh": "升级后的版本。当type为engineVersion时，取值为实例版本，例如6.7；当type为aliVersion时，取值为内核版本，例如ali1.2.0",
      "location": "body",
      "name": "version",
      "options": [
        "--biz-version"
      ],
      "param_style": "json",
      "raw_name": "version",
      "required": false,
      "type": "string"
    },
    {
      "help_en": "The update strategy. Valid values:\n\nblue_green: blue-green deployment.\nnormal: in-place update.\nintelligent: intelligent update",
      "help_zh": "blue_green: 蓝绿变更\nnormal： 原地变更\nintelligent： 智能变更",
      "location": "query",
      "name": "update_strategy",
      "options": [
        "--update-strategy"
      ],
      "raw_name": "updateStrategy",
      "required": false,
      "type": "string"
    }
