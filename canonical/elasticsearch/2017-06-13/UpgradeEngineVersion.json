{
  "camel_example": "aliyun elasticsearch POST /openapi/instances/es-cn-n6w1o1x0w001c0000/actions/upgrade-version --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "elasticsearch upgrade-engine-version",
  "cmd_name": "upgrade-engine-version",
  "deprecated": false,
  "description_en": "Upgrades the version of an Elasticsearch instance. This operation supports major version upgrades and kernel version upgrades",
  "description_zh": "升级Elasticsearch实例版本，支持版本升级和内核版本升级",
  "kebab_example": "aliyun elasticsearch upgrade-engine-version --instance-id es-cn-n6w1o1x0w001c0000 --api-version 2017-06-13 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "UpgradeEngineVersion",
  "operation": {
    "action": "UpgradeEngineVersion",
    "api_style": "ROA",
    "api_version": "2017-06-13",
    "body_mapping": {
      "plugins": "plugins",
      "type": "type",
      "version": "version"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
