{
  "camel_example": "aliyun elasticsearch POST /openapi/instances/es-cn-6ja1ro4jt000c0000/plugins/actions/analysis --region cn-hangzhou --dryRun false --header \"Content-Type=application/json\" --body \"name_:_plugin_name.zip_,//_plugin_name_ossObject_:_bucketName_:_bucketName_,//_oss_bucket_name_key_:_my_plugin_dir/plugin_name.zip_//_oss_file_name\"",
  "cmd_full_name": "elasticsearch plugin-analysis",
