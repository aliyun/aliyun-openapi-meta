{
  "camel_example": "aliyun elasticsearch POST /openapi/instances/es-cn-tl329rbpc00010000/kibana-white-ips --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "elasticsearch update-kibana-white-ips",
  "cmd_name": "update-kibana-white-ips",
  "deprecated": false,
  "description_en": "Updates the Kibana access whitelist of a specified Alibaba Cloud Elasticsearch instance",
  "description_zh": "更新指定阿里云Elasticsearch实例的Kibana访问白名单",
  "kebab_example": "aliyun elasticsearch update-kibana-white-ips --instance-id es-cn-tl329rbpc00010000 --api-version 2017-06-13 --region cn-hangzhou",
  "method": "PATCH|POST",
  "multi_version": true,
  "name": "UpdateKibanaWhiteIps",
  "operation": {
    "action": "UpdateKibanaWhiteIps",
    "api_style": "ROA",
    "api_version": "2017-06-13",
    "body_mapping": {
      "kibana_ip_whitelist": "kibanaIPWhitelist",
      "white_ip_group": "whiteIpGroup"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "update",
    "url": "/openapi/instances/{InstanceId}/kibana-white-ips"
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "es-cn-tl329rbpc0001****",
      "help_en": "The instance ID",
      "help_zh": "实例ID",
      "location": "path",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "5A2CFF0E-5718-45B5-9D4D-70B3FF****",
      "help_en": "A unique token generated by the client to ensure the idempotence of the request. The value must be unique across different requests and can be up to 64 ASCII characters in length",
      "help_zh": "用于保证请求的幂等性。由客户端生成该参数值，要保证在不同请求间唯一，最大不值过64个ASCII字符",
      "location": "query",
      "name": "client_token",
      "options": [
        "--client-token"
      ],
      "raw_name": "clientToken",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "Cover",
        "Append",
        "Delete"
      ],
      "example": "Cover",
      "help_en": "The modification mode. Valid values:\n\nCover (default): Overwrites the original IP whitelist with the value of the ips parameter.\n\nAppend: Adds the IP addresses specified in the ips parameter to the original IP whitelist.\n\nDelete: Removes the IP addresses specified in the ips parameter from the original IP whitelist. At least one IP address must be retained",
      "help_zh": "修改方式，取值含义如下：\n\nCover（默认值）：使用ips参数的值覆盖原IP白名单。\n\nAppend：在原IP白名单中增加ips参数中输入的IP地址。\n\nDelete：在原IP白名单中删除ips参数中输入的IP地址，至少需要保留一个IP地址",
      "location": "query",
      "name": "modify_mode",
      "options": [
        "--modify-mode"
      ],
      "raw_name": "modifyMode",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The IP access whitelist for the Kibana node. Cannot be set together with the whitelist group",
      "help_zh": "Kibana节点IP访问白名单。不可与分组同时设置",
      "location": "body",
      "name": "kibana_ip_whitelist",
      "options": [
        "--kibana-ip-whitelist"
      ],
      "param_style": "json",
      "raw_name": "kibanaIPWhitelist",
      "required": false,
      "type": "array"
    },
    {
      "fields": [
        {
          "example": "test_group_name",
          "help_en": "The name of the whitelist group. This parameter is required if the whiteIpGroup parameter is specified",
          "help_zh": "白名单组的组名。如果选填了whiteIpGroup参数，则该参数必填",
          "name": "group_name",
          "options": [
            "--group-name"
          ],
          "raw_name": "groupName",
          "required": false,
          "type": "string"
        },
        {
          "element": {
            "type": "string"
          },
          "help_en": "The list of IP addresses in the whitelist group",
          "help_zh": "白名单组中的IP列表",
          "name": "ips",
          "options": [
            "--ips"
          ],
          "raw_name": "ips",
          "required": false,
          "type": "array"
        },
        {
          "example": "PUBLIC_KIBANA",
          "help_en": "The whitelist type. Only PUBLIC_KIBANA (public access whitelist) is supported",
          "help_zh": "白名单类型，仅支持PUBLIC_KIBANA（公网访问白名单）",
          "name": "white_ip_type",
          "options": [
            "--white-ip-type"
          ],
          "raw_name": "whiteIpType",
          "required": false,
          "type": "string"
        }
      ],
      "help_en": "Updates the Kibana access whitelist configuration by whitelist group. Only one whitelist group can be updated at a time.\n\nYou cannot configure kibanaIPWhitelist and whiteIpGroup at the same time",
      "help_zh": "以白名单组方式更新Kibana访问白名单配置，仅支持更新一个白名单组。\n\n不支持同时配置kibanaIPWhitelist和whiteIpGroup",
      "location": "body",
      "name": "white_ip_group",
      "options": [
        "--white-ip-group"
      ],
      "param_style": "json",
      "raw_name": "whiteIpGroup",
      "required": false,
      "type": "object"
    }
  ],
