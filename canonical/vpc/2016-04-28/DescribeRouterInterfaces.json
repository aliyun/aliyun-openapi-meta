{
  "camel_example": "aliyun vpc DescribeRouterInterfaces --region cn-hangzhou --Tags.1.Value FinanceJoshua --PageSize 10 --ResourceGroupId 'rg-acfmxazb4ph6aiy0000' --PageNumber 1 --Filter.1.Value.1 test --Tags.1.Key FinanceDept --RegionId 'cn-hangzhou' --IncludeReservationData false --Filter.1.Key 'Filter.1.Status'",
