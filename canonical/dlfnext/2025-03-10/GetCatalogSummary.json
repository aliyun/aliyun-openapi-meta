        "description_en": "The storage overview for the data catalog",
        "description_zh": "数据目录存储概览",
        "properties": {
          "apiVisitCountMonthly": {
            "backendName": "apiVisitCountMonthly",
            "description_en": "The total number of metadata requests in the current month",
            "description_zh": "本月元数据请求总次数",
            "example": "1000",
            "format": "int64",
            "type": "integer"
          },
          "databaseCount": {
            "$ref": "#/components/schemas/MoMValues",
            "backendName": "databaseCount",
            "description_en": "The month-over-month data on the total number of databases",
            "description_zh": "库总数量环比数据"
          },
          "fileAccessCountMonthly": {
            "backendName": "fileAccessCountMonthly",
            "description_en": "The total number of file requests for the current month",
            "description_zh": "本月文件请求总次数",
            "example": "10000",
            "format": "int64",
            "type": "integer"
          },
          "generatedDate": {
            "backendName": "generatedDate",
            "description_en": "The date when the storage overview data was updated",
            "description_zh": "存储概览数据更新日期",
