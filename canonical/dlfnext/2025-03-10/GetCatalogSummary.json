            "example": "1024",
            "format": "int64",
            "type": "integer"
          },
          "totalFileCount": {
            "$ref": "#/components/schemas/MoMValues",
            "backendName": "totalFileCount",
            "description_en": "The month-over-month data on the total number of files",
            "description_zh": "文件总数环比数据"
          },
          "totalFileSizeInBytes": {
            "$ref": "#/components/schemas/MoMValues",
