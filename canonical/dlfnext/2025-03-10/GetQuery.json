{
  "camel_example": "",
  "cmd_full_name": "dlfnext get-query",
  "cmd_name": "get-query",
  "components": {
    "schemas": {
      "StatementResult": {
        "description_en": "The query result",
        "description_zh": "查询结果",
        "properties": {
          "downloadUrl": {
            "backendName": "downloadUrl",
            "description_en": "The presigned URL of the Arrow IPC file. This parameter is returned when a result set exists. The URL is valid for 1 hour and contains full data. The value is null for an empty result set (rowCount == 0)",
            "description_zh": "Arrow IPC 文件 presigned URL（有结果集时返回，1h 有效期，包含全量数据）；空结果集 (rowCount == 0) 时为 null",
            "example": "https://xxx.oss-cn-hangzhou.aliyuncs.com/xxxx",
            "type": "string"
          },
          "error": {
            "backendName": "error",
            "description_en": "The error message. This parameter is returned only when the status is FAILED",
            "description_zh": "错误信息（仅 FAILED）",
            "example": "SQL_ERROR",
            "type": "string"
          },
          "errorCode": {
            "backendName": "errorCode",
            "description_en": "The error code. This parameter is returned only when the status is FAILED",
            "description_zh": "错误码（仅 FAILED）",
            "example": "\t\nThis feature is not implemented: xxx",
            "type": "string"
          },
          "executionTime": {
            "backendName": "executionTime",
            "description_en": "The execution duration of the statement, in milliseconds",
            "description_zh": "该语句执行耗时（毫秒）",
            "example": "100",
            "format": "int64",
            "type": "integer"
          },
          "index": {
            "backendName": "index",
            "description_en": "The statement sequence number (0-based)",
            "description_zh": "语句序号（0-based）",
            "example": "0",
            "format": "int32",
            "type": "integer"
          },
          "rowCount": {
            "backendName": "rowCount",
            "description_en": "The total number of rows in the result. The value is 0 for statements that do not return a result set",
            "description_zh": "全量结果行数（无结果集的语句为 0）",
            "example": "1000",
            "format": "int32",
            "type": "integer"
          },
          "schema": {
            "backendName": "schema",
            "description_en": "The result column information. This parameter is returned when a result set exists",
            "description_zh": "结果列信息（有结果集时返回）",
            "items": {
              "description_en": "The result column information",
              "description_zh": "结果列信息",
              "properties": {
                "name": {
                  "backendName": "name",
                  "description_en": "The column name",
                  "description_zh": "列名",
                  "example": "name",
                  "type": "string"
                },
                "type": {
                  "backendName": "type",
                  "description_en": "The data type",
                  "description_zh": "数据类型",
                  "example": "string",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "sql": {
            "backendName": "sql",
            "description_en": "The SQL text of the statement",
            "description_zh": "该语句的 SQL 文本",
            "example": "select * from table_name;",
            "type": "string"
          },
          "status": {
            "backendName": "status",
            "description_en": "The status of the statement. Valid values: COMPLETED and FAILED",
            "description_zh": "该语句状态：COMPLETED / FAILED",
            "example": "COMPLETED",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "deprecated": false,
  "description_en": "Retrieves a query",
  "description_zh": "获取查询",
  "kebab_example": "aliyun dlfnext get-query --query-id d7b21d1ec4f441e79d5ba917c3283200 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetQuery",
  "operation": {
    "action": "GetQuery",
    "api_style": "ROA",
    "api_version": "2025-03-10",
    "method": "GET",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": "/dlf/v1/query/{queryId}"
  },
  "parameters": [
    {
      "example": "d7b21d1ec4f441e79d5ba917c3283200\n",
      "help_en": "The query ID",
      "help_zh": "查询 ID",
      "location": "path",
      "name": "query_id",
      "options": [
        "--query-id"
      ],
      "raw_name": "queryId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/dlf/v1/query/[queryId]",
  "product_code": "DlfNext",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response struct",
        "description_zh": "返回结构体",
        "parseType": "struct",
        "properties": {
          "completedAt": {
            "description_en": "The completion time of the task",
            "description_zh": "任务的完成时间",
            "example": "1744970111419",
            "format": "int64",
            "type": "integer"
          },
          "createdAt": {
            "description_en": "The creation time of the task",
            "description_zh": "任务的创建时间",
            "example": "1744970111419",
            "format": "int64",
            "type": "integer"
          },
          "queryId": {
            "description_en": "The query ID, used for subsequent polling of results",
            "description_zh": "查询 ID，用于后续轮询结果",
            "example": "d7b21d1ec4f441e79d5ba917c3283200",
            "type": "string"
          },
          "results": {
            "description_en": "The result list",
            "description_zh": "结果列表",
            "itemName": "results",
            "items": {
              "$ref": "#/components/schemas/StatementResult",
              "description_en": "The result list",
              "description_zh": "结果列表"
            },
            "type": "array"
          },
          "sql": {
            "description_en": "The SQL text. Multiple statements separated by semicolons are supported and executed sequentially within the same session",
            "description_zh": "SQL 文本，支持多条语句（分号分隔），在同一 session 内顺序执行",
            "example": "select * from table_name;\n",
            "type": "string"
          },
          "status": {
            "description_en": "The task running status",
            "description_zh": "任务运行状态",
            "example": "COMPLETED",
            "type": "string"
          },
          "tier": {
            "description_en": "The execution specifications. Default value: standard",
            "description_zh": "执行规格，默认 standard",
            "example": "standard\n\n",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "v1_parameters": [
    {
      "help_en": "The query ID",
      "help_zh": "查询 ID",
      "name": "queryId",
      "position": "path",
      "required": false,
      "type": "string"
    }
  ]
}
