{
  "camel_example": "aliyun dlfnext GET /dlf/v1/clg-paimon-xxxx/databases/database_name/tables/table_name/snapshots --region cn-hangzhou --header \"Content-Type=application/json\" --version 2025-03-10 --force",
  "cmd_full_name": "dlfnext list-snapshots",
  "cmd_name": "list-snapshots",
  "components": {
    "schemas": {
      "Snapshot": {
        "description_en": "The snapshot details",
        "description_zh": "快照详情",
        "properties": {
          "baseManifestList": {
            "backendName": "baseManifestList",
            "description_en": "The file name of the base manifest list",
            "description_zh": "基础 Manifest 列表文件名",
            "example": "manifest-list-0c6fcaa1-b6bc-413d-9634-6471cce4f37e-2",
            "type": "string"
          },
          "changelogManifestList": {
            "backendName": "changelogManifestList",
            "description_en": "The file name of the manifest list that records all changelogs generated for the snapshot",
            "description_zh": "记录该快照生成的全部变更日志的 Manifest 列表文件名",
            "example": "manifest-list-0c6fcaa1-b6bc-413d-9634-6471cce4f37e-4",
            "nullable": true,
            "title": "本次提交产生的变更日志",
            "type": "string"
          },
          "changelogRecordCount": {
            "backendName": "changelogRecordCount",
            "description_en": "The number of changelog records generated for the snapshot",
            "description_zh": "该快照生成的变更日志记录数",
            "example": "100",
            "format": "int64",
            "type": "integer"
          },
          "commitIdentifier": {
            "backendName": "commitIdentifier",
            "description_en": "The transaction ID of the streaming write",
            "description_zh": "流式写入的事务 ID",
            "example": "9223372036854775807",
            "format": "int64",
            "type": "integer"
          },
          "commitKind": {
            "backendName": "commitKind",
            "description_en": "The streaming write type. Valid values: APPEND, COMPACT, OVERWRITE, and ANALYZE",
            "description_zh": "流式写入类型。取值：APPEND、COMPACT、OVERWRITE、ANALYZE",
            "enum": [
              "APPEND",
              "COMPACT",
              "OVERWRITE",
              "ANALYZE"
            ],
            "example": "COMPACT",
            "title": "提交类型：APPEND,COMPACT,OVERWRITE,ANALYZE",
            "type": "string"
          },
          "commitUser": {
            "backendName": "commitUser",
            "description_en": "The commit user, which is typically a UUID used to resume streaming writes",
            "description_zh": "提交用户，通常为 UUID，用于恢复流式写入",
            "example": "446aac61-bd5c-4fa0-8b14-846fa8810651",
            "type": "string"
          },
          "deltaManifestList": {
            "backendName": "deltaManifestList",
            "description_en": "The file name of the manifest list that records all new changes in the snapshot",
            "description_zh": "记录该快照全部新增变更的 Manifest 列表文件名",
            "example": "manifest-list-0c6fcaa1-b6bc-413d-9634-6471cce4f37e-3",
            "title": "记录本次提交新增的文件",
            "type": "string"
          },
          "deltaRecordCount": {
            "backendName": "deltaRecordCount",
            "description_en": "The number of new change records in the snapshot",
            "description_zh": "该快照新增变更的记录数",
            "example": "10",
            "format": "int64",
            "title": "本次提交新增记录行数",
            "type": "integer"
          },
          "id": {
            "backendName": "id",
            "description_en": "The snapshot ID",
            "description_zh": "快照 ID",
            "example": "6",
            "format": "int64",
            "title": "快照ID",
            "type": "integer"
          },
          "idString": {
            "backendName": "idString",
            "description_en": "The string representation of the snapshot ID",
            "description_zh": "快照 ID 的字符串表示",
            "example": "6",
            "type": "string"
          },
          "indexManifest": {
            "backendName": "indexManifest",
            "description_en": "The file name of the manifest that records all index files of the table",
            "description_zh": "记录该表全部索引文件的 Manifest 文件名",
            "example": "index-manifest-7cbdaa47-9578-43ac-ae6e-a7ec0486bba8-0",
            "type": "string"
          },
          "logOffsets": {
            "additionalProperties": {
              "description_en": "The offset of the log partition",
              "description_zh": "日志分区的偏移量",
              "example": "1",
              "format": "int64",
              "type": "integer"
            },
            "backendName": "logOffsets",
            "description_en": "The log offsets at the time of the commit",
            "description_zh": "本次提交时的日志偏移量",
            "type": "object"
          },
          "parentIdString": {
            "backendName": "parentIdString",
            "description_en": "The string representation of the parent snapshot ID",
            "description_zh": "父快照 ID 的字符串表示",
            "example": "0",
            "type": "string"
          },
          "schemaId": {
            "backendName": "schemaId",
            "description_en": "The schema ID of the table when the snapshot was generated",
            "description_zh": "生成该快照时的表 Schema ID",
            "example": "0",
            "format": "int64",
            "title": "schema id",
            "type": "integer"
          },
          "sequenceNumber": {
            "backendName": "sequenceNumber",
            "description_en": "The snapshot sequence number",
            "description_zh": "快照序列号",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "statistics": {
            "backendName": "statistics",
            "description_en": "The file name of the table statistics information",
            "description_zh": "表统计信息文件名",
            "example": "stat-82c50592-2179-447b-906b-6fdb10ef32c6-0",
            "type": "string"
          },
          "summary": {
            "additionalProperties": {
              "description_en": "The property values of the snapshot summary",
              "description_zh": "快照摘要属性值",
              "example": "APPEND",
              "type": "string"
            },
            "backendName": "summary",
            "description_en": "The summary",
            "description_zh": "概况",
            "type": "object"
          },
          "timeMillis": {
            "backendName": "timeMillis",
            "description_en": "The commit time, which is a UNIX timestamp in milliseconds",
            "description_zh": "提交时间，Unix 时间戳，单位为毫秒",
            "example": "1741701564261",
            "format": "int64",
            "title": "提交时间",
            "type": "integer"
          },
          "totalRecordCount": {
            "backendName": "totalRecordCount",
            "description_en": "The total number of records for all changes in the snapshot",
            "description_zh": "该快照全部变更的总记录数",
            "example": "1024",
            "format": "int64",
            "title": "表总行数",
            "type": "integer"
          },
          "version": {
            "backendName": "version",
            "description_en": "The file format version of the snapshot. The current version is 3",
            "description_zh": "快照文件格式版本。当前版本为 3",
            "example": "3",
            "format": "int32",
            "nullable": true,
            "type": "integer"
          },
          "watermark": {
            "backendName": "watermark",
            "description_en": "The watermark value",
            "description_zh": "水位线值",
            "example": "-9223372036854775808",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
