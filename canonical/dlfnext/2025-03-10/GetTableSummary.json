{
  "camel_example": "",
  "cmd_full_name": "dlfnext get-table-summary",
  "cmd_name": "get-table-summary",
  "components": {
    "schemas": {
      "TableSummary": {
        "description_en": "A summary of the table's storage metrics",
        "description_zh": "表存储概览",
        "properties": {
          "createdAt": {
            "backendName": "createdAt",
            "description_en": "The timestamp, in milliseconds, indicating when the table was created",
            "description_zh": "表创建时间",
            "example": "1744970111419",
            "format": "int64",
            "type": "integer"
          },
          "databaseName": {
            "backendName": "databaseName",
            "description_en": "The name of the database",
            "description_zh": "库名",
            "example": "default",
            "type": "string"
          },
          "generatedDate": {
            "backendName": "generatedDate",
            "description_en": "The generation date of the storage summary",
            "description_zh": "存储概览数据更新日期",
            "example": "2025-06-01",
            "type": "string"
          },
          "lastAccessTime": {
            "backendName": "lastAccessTime",
            "description_en": "The timestamp, in milliseconds, indicating when the table data was last accessed",
            "description_zh": "表最近数据访问时间",
            "example": "1744970111419",
            "format": "int64",
            "type": "integer"
          },
          "lastRequester": {
            "backendName": "lastRequester",
            "type": "string"
          },
          "objTypeArchiveSize": {
            "backendName": "objTypeArchiveSize",
            "description_en": "The total size of data files in the Archive storage class, in bytes",
            "description_zh": "归档数据文件存储量",
            "example": "10240",
            "format": "int64",
            "type": "integer"
          },
          "objTypeColdArchiveSize": {
            "backendName": "objTypeColdArchiveSize",
            "description_en": "The total size of data files in the Cold Archive storage class, in bytes",
            "description_zh": "冷归档数据文件存储量",
            "example": "10240",
            "format": "int64",
            "type": "integer"
          },
          "objTypeIaSize": {
            "backendName": "objTypeIaSize",
            "description_en": "The total size of data files in the Infrequent Access storage class, in bytes",
            "description_zh": "低频数据文件存储量",
            "example": "10240",
            "format": "int64",
            "type": "integer"
          },
          "objTypeStandardSize": {
            "backendName": "objTypeStandardSize",
            "description_en": "The total size of data files in the Standard storage class, in bytes",
            "description_zh": "标准数据文件存储量",
            "example": "10240",
            "format": "int64",
            "type": "integer"
          },
          "partitionCount": {
            "backendName": "partitionCount",
            "description_en": "The total number of partitions in the table",
            "description_zh": "分区总数量",
            "example": "10",
            "format": "int64",
            "type": "integer"
          },
          "path": {
            "backendName": "path",
            "description_en": "The storage location of the table",
            "description_zh": "存储位置",
            "example": "oss://clg-xxxx/db-xxxx/tbl-xxxx",
            "type": "string"
          },
          "storageActionParams": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "storageActionTimestamp": {
            "backendName": "storageActionTimestamp",
            "format": "int64",
            "type": "integer"
          },
          "storageClass": {
            "backendName": "storageClass",
            "type": "string"
          },
          "tableName": {
            "backendName": "tableName",
            "description_en": "The name of the table",
            "description_zh": "表名",
            "example": "table1",
            "type": "string"
          },
          "topRequester": {
            "backendName": "topRequester",
            "type": "string"
          },
          "totalFileAccessNum": {
            "backendName": "totalFileAccessNum",
            "format": "int64",
            "type": "integer"
          },
          "totalFileAccessNum30d": {
            "backendName": "totalFileAccessNum30d",
            "format": "int64",
            "type": "integer"
          },
          "totalFileAccessNum7d": {
            "backendName": "totalFileAccessNum7d",
            "format": "int64",
            "type": "integer"
          },
          "totalFileCount": {
            "backendName": "totalFileCount",
            "description_en": "The total number of files in the table",
            "description_zh": "表文件总数量",
            "example": "100",
            "format": "int64",
            "type": "integer"
          },
          "totalFileSizeInBytes": {
            "backendName": "totalFileSizeInBytes",
            "description_en": "The total storage capacity of the table, in bytes",
            "description_zh": "表存储容量（单位为Byte）",
            "example": "1024",
            "format": "int64",
            "type": "integer"
          },
          "totalMetaFileCount": {
            "backendName": "totalMetaFileCount",
            "description_en": "The total number of metadata files",
            "description_zh": "元数据文件数量",
            "example": "10",
            "format": "int64",
            "type": "integer"
          },
          "totalMetaSizeInBytes": {
            "backendName": "totalMetaSizeInBytes",
            "description_en": "The total size of metadata files, in bytes",
            "description_zh": "元数据文件存储量",
            "example": "10240",
            "format": "int64",
            "type": "integer"
          },
          "unaccessedStdIaPartitionCount180d": {
            "backendName": "unaccessedStdIaPartitionCount180d",
            "description_en": "The number of Standard or Infrequent Access partitions unaccessed in the last 180 days",
            "description_zh": "近180天未访问的标准或低频分区数量",
            "example": "0",
            "format": "int64",
            "type": "integer"
          },
          "unaccessedStdPartitionCount30d": {
            "backendName": "unaccessedStdPartitionCount30d",
            "description_en": "The number of Standard partitions unaccessed in the last 30 days",
            "description_zh": "近30天未访问的标准存储分区数量",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "updatedAt": {
            "backendName": "updatedAt",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
