                  "type": "string"
                },
                "MaxImageCount": {
                  "backendName": "maxImageCount",
                  "description_en": "The number of images",
                  "description_zh": "镜像数量",
                  "example": "3",
                  "type": "string"
                },
                "Name": {
                  "backendName": "name",
                  "description_en": "The name of the backup",
                  "description_zh": "备份名称",
                  "example": "backup-te****",
                  "type": "string"
                },
                "NextImageCreateTime": {
                  "backendName": "nextImageCreateTime",
                  "description_en": "The time when the next image will be created. This is a timestamp in milliseconds",
                  "description_zh": "镜像下一次创建时间，精确到毫秒。时间戳格式",
                  "example": "1682417553781\n",
                  "format": "int64",
                  "type": "integer"
                },
                "OwnerInstanceId": {
                  "backendName": "ownerInstanceId",
                  "description_en": "The ID of the HSM instance that owns the backup. This parameter is returned only for backups of HSM instances outside the Chinese mainland. Its value is the same as InstanceId",
                  "description_zh": "备份所属的密码机实例ID。仅非中国内地密码机备份有此属性，且与InstanceId一致",
                  "example": "hsm-cn-vj30bil8****",
                  "type": "string"
                },
                "RegionId": {
                  "backendName": "regionNo",
                  "description_en": "The region ID",
                  "description_zh": "区域ID",
                  "example": "ap-southeast-1",
                  "type": "string"
                },
                "ReleaseTime": {
                  "backendName": "releaseTime",
                  "description_en": "The time when the backup was released. This is a timestamp in milliseconds",
                  "description_zh": "备份释放时间，精确到毫秒。时间戳格式",
                  "example": "1641275680000",
                  "format": "int64",
                  "type": "integer"
                },
                "Remark": {
                  "backendName": "remark",
                  "description_en": "The remarks of the backup",
                  "description_zh": "备份备注",
                  "example": "normal backup",
                  "type": "string"
                },
                "SpInstanceId": {
                  "backendName": "spInstanceId",
                  "description_en": "The ID of the backup in the sales domain. This parameter is returned only for backups of HSM instances in the Chinese mainland",
                  "description_zh": "售卖域备份ID。\n仅中国内地密码机备份有此属性",
                  "example": "backup-fdb897sdfg534-****",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the backup.\n\nNEW: Not enabled\n\nEXPIRED: Expired\n\nENABLED: Enabled",
                  "description_zh": "备份状态。\nNEW：未启用\nEXPIRED：已过期\nENABLED：已启用",
                  "enum": [
                    "NEW",
                    "ENABLED",
                    "EXPIRED"
                  ],
                  "example": "ENABLED",
                  "type": "string"
                },
                "Type": {
                  "backendName": "type",
                  "description_en": "The type of the backup.\n\nDEFAULT: Default backup\n\nNORMAL: Normal backup",
                  "description_zh": "备份类型。\nDEFAULT：默认备份\nNORMAL：普通备份",
                  "enum": [
                    "NORMAL",
                    "DEFAULT"
                  ],
                  "example": "NORMAL",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "CurrentPage": {
            "backendName": "currentPage",
            "description_en": "The current page number",
            "description_zh": "当前分页",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageSize": {
            "backendName": "pageSize",
            "description_en": "The number of backups returned on each page",
            "description_zh": "每页显示的备份个数",
            "example": "20",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "本次调用请求的ID，是由阿里云为该请求生成的唯一标识符，可用于排查和定位问题",
            "example": "4C467B38-3910-447D-87BC-AC049166F216",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "total",
            "description_en": "The total number of entries returned",
            "description_zh": "查询结果总数",
            "example": "30",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
