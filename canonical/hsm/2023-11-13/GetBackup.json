  "kebab_example": "aliyun hsm get-backup --backup-id backup-fdb897sdf0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetBackup",
  "operation": {
    "action": "GetBackup",
    "api_style": "RPC",
    "api_version": "2023-11-13",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "backup-fdb897sdf****",
      "help_en": "The backup ID",
      "help_zh": "备份ID",
      "location": "query",
      "name": "backup_id",
      "options": [
        "--backup-id"
      ],
      "raw_name": "BackupId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "hsm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "响应信息",
        "properties": {
          "Backup": {
            "backendName": "data",
            "description_en": "The backup information",
            "description_zh": "返回的备份信息",
            "properties": {
              "AutoImageCount": {
                "backendName": "autoImageCount",
                "description_en": "The number of automatic backup images",
                "description_zh": "自动备份镜像数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "BackupHourInDay": {
                "backendName": "backupHourInDay",
                "description_en": "The backup time. This is an integer on the hour in a 24-hour format",
                "description_zh": "备份时间，24小时制整点时间",
                "example": "10",
                "type": "string"
              },
              "BackupId": {
                "backendName": "backupId",
                "description_en": "The backup ID",
                "description_zh": "备份ID",
                "example": "backup-fdb897sdf****",
                "type": "string"
              },
              "BackupPeriod": {
                "backendName": "backupPeriod",
                "description_en": "The automatic backup cycle in days",
                "description_zh": "自动备份周期，单位天数",
                "example": "3",
                "format": "int64",
                "type": "integer"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The time when the backup was created. This is a UNIX timestamp. Unit: milliseconds",
                "description_zh": "备份创建时间，精确到毫秒。时间戳格式",
                "example": "1682417553781",
                "format": "int64",
                "type": "integer"
              },
              "ExpireTime": {
                "backendName": "expireTime",
                "description_en": "The time when the backup expires. This is a UNIX timestamp. Unit: milliseconds",
                "description_zh": "备份过期时间，精确到毫秒。时间戳格式",
                "example": "1682417553781",
                "format": "int64",
                "type": "integer"
              },
              "InstanceId": {
                "backendName": "instanceId",
                "description_en": "The ID of the HSM instance that is associated with the backup",
                "description_zh": "备份关联的密码机实例ID",
                "example": "hsm-cn-5yd35431****",
                "type": "string"
              },
              "MaxImageCount": {
                "backendName": "maxImageCount",
                "description_en": "The maximum number of images",
                "description_zh": "最大镜像数量",
                "example": "3",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The backup name",
                "description_zh": "备份名称",
                "example": "backup-te****",
                "type": "string"
              },
              "NextImageCreateTime": {
                "backendName": "nextImageCreateTime",
                "description_en": "The time when the next image will be created. This is a UNIX timestamp. Unit: milliseconds",
                "description_zh": "镜像下一次创建时间，精确到毫秒。时间戳格式",
                "example": "1682417553781",
                "format": "int64",
                "type": "integer"
              },
              "OwnerInstanceId": {
                "backendName": "ownerInstanceId",
                "description_en": "The ID of the HSM instance to which the backup belongs. This property is available only for backups of HSM instances outside the Chinese mainland and has the same value as InstanceId",
                "description_zh": "备份所属的密码机实例ID。仅非中国内地密码机备份有此属性，且与InstanceId一致",
                "example": "hsm-cn-huoahd****",
                "type": "string"
              },
              "RegionId": {
                "backendName": "regionId",
                "description_en": "The region ID",
                "description_zh": "地域ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "ReleaseTime": {
                "backendName": "releaseTime",
                "description_en": "The time when the backup was released. This is a UNIX timestamp. Unit: milliseconds",
                "description_zh": "备份释放时间，精确到毫秒。时间戳格式",
                "example": "1641275680000",
                "format": "int64",
                "type": "integer"
              },
              "Remark": {
                "backendName": "remark",
                "description_en": "The backup remarks",
                "description_zh": "备份备注",
                "example": "test",
                "type": "string"
              },
              "SpInstanceId": {
                "backendName": "spInstanceId",
                "description_en": "The backup ID in the sales domain. This property is available only for backups of HSM instances in the Chinese mainland",
                "description_zh": "售卖域备份ID。 仅中国内地密码机备份有此属性",
                "example": "backup-fdb897sdfg53****",
                "type": "string"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The backup status.\n\nNEW: The backup is not enabled.\n\nEXPIRED: The backup has expired.\n\nENABLED: The backup is enabled",
                "description_zh": "备份状态。\n\nNEW：未启用\n\nEXPIRED：已过期\n\nENABLED：已启用",
                "enum": [
                  "EXPIRED",
                  "ENABLED",
                  "NEW"
                ],
                "example": "NEW",
                "type": "string"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The backup type.\n\nDEFAULT: The default backup.\n\nNORMAL: The normal backup",
                "description_zh": "备份类型。\n\nDEFAULT：默认备份\n\nNORMAL：普通备份",
                "enum": [
                  "DEFAULT",
                  "NORMAL"
                ],
                "example": "DEFAULT",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request. This ID is a unique identifier generated by Alibaba Cloud for the request. You can use this ID to troubleshoot issues",
            "description_zh": "本次调用请求的ID，是由阿里云为该请求生成的唯一标识符，可用于排查和定位问题",
            "example": "4C467B38-3910-447D-87BC-AC049166F216",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
