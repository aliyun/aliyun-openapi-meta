            "example": "klafhjas-asdasd-asd-as-d-asd-asd-asdasd",
            "title": "临时权限，用于登录成功后设置密码",
            "type": "string"
          },
          "status": {
            "description_en": "User status",
            "description_zh": "用户状态",
            "example": "enabled",
            "title": "用户状态",
            "type": "string"
