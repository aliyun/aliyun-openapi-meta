              "Bearer": "Bearer"
            },
            "example": "Bearer",
            "title": "凭证类型",
            "type": "string"
          },
          "user_data": {
            "additionalProperties": {
              "description_en": "",
              "description_zh": "",
              "type": "string"
            },
            "description_en": "User-defined data",
            "description_zh": "用户自定义数据",
            "title": "用户自定义数据，格式为json，可用于配置项、少量临时数据等存储，不超过1K",
            "type": "object"
          },
          "user_id": {
            "description_en": "User ID",
            "description_zh": "用户ID",
            "example": "DING-xxxxx",
            "title": "用户ID",
            "type": "string"
          },
          "user_name": {
            "description_en": "Username",
            "description_zh": "用户名",
            "example": "pdsuser",
            "title": "用户名",
            "type": "string"
          }
        },
        "title": "A short description of struct",
        "type": "object"
      }
    }
