            "type": "string"
          },
          "avatar": {
            "description_en": "Profile picture",
            "description_zh": "用户头像",
            "example": "aliyunpds.com/a.jpg",
            "title": "用户头像",
            "type": "string"
          },
          "default_drive_id": {
            "description_en": "User default drive ID",
            "description_zh": "用户默认空间ID",
