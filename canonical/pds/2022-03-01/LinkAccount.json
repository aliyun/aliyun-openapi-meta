            "title": "凭证过期时间",
            "type": "string"
          },
          "expires_in": {
            "description_en": "Credential validity period",
            "description_zh": "凭证有效期",
            "example": "3600",
            "format": "int64",
            "title": "凭证有效期",
            "type": "integer"
          },
          "is_first_login": {
