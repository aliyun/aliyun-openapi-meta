{
  "camel_example": "",
  "cmd_full_name": "pds move-file",
  "cmd_name": "move-file",
  "deprecated": false,
  "description_en": "Moves a file or folder",
  "description_zh": "移动文件或文件夹",
  "kebab_example": "aliyun pds move-file --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "MoveFile",
  "operation": {
    "action": "MoveFile",
    "api_style": "ROA",
    "api_version": "2022-03-01",
    "body_mapping": {
      "check_name_mode": "check_name_mode",
      "drive_id": "drive_id",
      "file_id": "file_id",
      "to_parent_file_id": "to_parent_file_id"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "update",
    "url": "/v2/file/move"
  },
  "parameters": [
    {
      "enum": [
        "ignore",
        "auto_rename",
        "refuse"
      ],
      "example": "ignore",
      "help_en": "The processing mode for files with the same name. Valid values:\n\nignore: allows files with the same name.\n\nauto_rename: automatically renames the file in the cloud when a file with the same name is found. By default, the current timestamp is appended, such as xxx_20060102_150405.\n\nrefuse: rejects the creation of a new file when a file with the same name already exists in the cloud, and returns the details of the existing file to the client.\n\nDefault value: ignore",
      "help_zh": "同名文件处理模式，可选值如下：\n\nignore：允许同名文件；\n\nauto_rename：当发现同名文件时，云端自动重命名，默认为追加当前时间点，如 xxx_20060102_150405；\n\nrefuse：当云端存在同名文件时，拒绝创建新文件，返回客户端已存在同名文件的详细信息。\n\n默认为 ignore",
      "location": "body",
      "name": "check_name_mode",
      "options": [
        "--check-name-mode"
      ],
      "param_style": "json",
      "raw_name": "check_name_mode",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The drive ID",
      "help_zh": "空间 id",
      "location": "body",
      "name": "drive_id",
      "options": [
        "--drive-id"
      ],
      "param_style": "json",
      "raw_name": "drive_id",
      "required": true,
      "type": "string"
    },
    {
      "example": "9520943DC264",
      "help_en": "The file ID",
      "help_zh": "文件 id",
      "location": "body",
      "name": "file_id",
      "options": [
        "--file-id"
      ],
      "param_style": "json",
      "raw_name": "file_id",
      "required": true,
      "type": "string"
    },
    {
      "example": "6520943DC261",
      "help_en": "The ID of the destination parent folder. Set this parameter to root if you want to move the file or folder to the root directory",
      "help_zh": "目的父文件夹 id，当移入根目录时，填 root",
      "location": "body",
      "name": "to_parent_file_id",
      "options": [
        "--to-parent-file-id"
      ],
      "param_style": "json",
      "raw_name": "to_parent_file_id",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/v2/file/move",
  "product_code": "pds",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "async_task_id": {
            "description_en": "The asynchronous task ID.\n\nIf an empty string is returned, the file or folder is moved directly.\n\nIf a non-empty string is returned, the move requires asynchronous processing. Call GetAsyncTask and pass the asynchronous task ID to retrieve the task information",
            "description_zh": "异步任务id。\n\n如果返回为空字符串，表示直接移动成功。\n\n如果返回非空字符串，表示需要经过异步处理。调用GetAsyncTask，传递异步任务id，获取任务信息",
            "example": "23ebd1a24dba4166b1527add476ef2866051b4d5del106",
            "type": "string"
          },
          "domain_id": {
            "description_en": "The domain ID",
            "description_zh": "域id",
            "example": "bj1",
            "title_en": "",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "drive_id": {
            "description_en": "The drive ID",
            "description_zh": "空间id",
            "example": "1",
            "type": "string"
          },
          "exist": {
            "description_en": "Indicates whether the file already exists",
            "description_zh": "文件是否已存在",
            "example": "false",
            "type": "boolean"
          },
          "file_id": {
            "description_en": "The file ID",
            "description_zh": "文件id",
            "example": "fileid1",
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "revision_id": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "title_en": "",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
