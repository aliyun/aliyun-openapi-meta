  "cmd_full_name": "pds get-download-url",
  "cmd_name": "get-download-url",
  "deprecated": false,
  "description_en": "Retrieves the download URL for a file",
  "description_zh": "获取文件下载地址",
  "kebab_example": "aliyun pds get-download-url --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "GetDownloadUrl",
  "operation": {
    "action": "GetDownloadUrl",
    "api_style": "ROA",
    "api_version": "2022-03-01",
    "body_mapping": {
      "drive_id": "drive_id",
      "expire_sec": "expire_sec",
      "file_id": "file_id",
      "file_name": "file_name",
      "response_content_type": "response_content_type",
      "share_id": "share_id"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "get",
    "url": "/v2/file/get_download_url"
  },
  "parameters": [
