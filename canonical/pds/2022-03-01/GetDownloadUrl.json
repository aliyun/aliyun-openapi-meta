      "example": "1",
      "help_en": "The drive ID",
      "help_zh": "空间 id",
      "location": "body",
      "name": "drive_id",
      "options": [
        "--drive-id"
      ],
      "param_style": "json",
      "raw_name": "drive_id",
      "required": false,
      "type": "string"
    },
    {
      "example": "100",
      "help_en": "The time-to-live (TTL) of the download URL, in seconds. The maximum value is 115200. The default value is 900",
      "help_zh": "下载地址过期时间，单位为秒，最长115200秒，默认为900秒",
      "location": "body",
      "maximum": "115200",
      "minimum": "1",
      "name": "expire_sec",
      "options": [
        "--expire-sec"
      ],
      "param_style": "json",
      "raw_name": "expire_sec",
      "required": false,
      "type": "int"
    },
    {
      "example": "9520943DC264",
      "help_en": "The file ID",
      "help_zh": "文件 id",
      "location": "body",
      "name": "file_id",
      "options": [
        "--file-id"
      ],
      "param_style": "json",
      "raw_name": "file_id",
      "required": true,
      "type": "string"
    },
    {
      "example": "1.txt",
      "help_en": "The file name. The maximum length is 1,024 characters",
      "help_zh": "文件名，最长 1024 字符",
      "location": "body",
      "max_length": "1024",
      "min_length": "1",
      "name": "file_name",
      "options": [
        "--file-name"
      ],
      "param_style": "json",
      "raw_name": "file_name",
      "required": false,
      "type": "string"
    },
    {
      "example": "video/mp4",
      "help_en": "The response_content_type",
      "help_zh": "The response_content_type",
      "location": "body",
      "name": "response_content_type",
      "options": [
        "--response-content-type"
      ],
      "param_style": "json",
      "raw_name": "response_content_type",
      "required": false,
      "type": "string"
    },
    {
      "example": "7JQX1FswpQ8",
      "help_en": "The share ID.\nIf you access the file through a share, include the `x-share-token` header for authentication and provide this field. In that case, the `drive_id` field is ignored. Otherwise, use an AccessKey pair or an access token for authentication and provide the `drive_id` field.\nYou must specify either `share_id` or `drive_id`",
      "help_zh": "分享id。\n如果通过分享操作文件，请携带`x-share-token` header鉴权并传递此字段，此时`drive_id`无效。否则请使用`aksk`或者`access_token`方式鉴权，并传递`drive_id`字段。\n`share_id`和`drive_id`两者必须有一个字段赋值",
      "location": "body",
      "name": "share_id",
      "options": [
        "--share-id"
      ],
      "param_style": "json",
      "raw_name": "share_id",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/v2/file/get_download_url",
  "product_code": "pds",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response schema",
        "description_zh": "Schema of Response",
        "properties": {
          "cdn_url": {
            "description_en": "The Content Delivery Network (CDN) download URL. This field is not used if you enable intelligent data endpoints. In that case, the system automatically returns the appropriate URL in the url field. To use this field, contact PDS technical support",
            "description_zh": "cdn下载地址\n（开启智能数据域名后不使用该字段，根据请求该参数会自适应返回在URL字段值内，如需使用该字段请联系PDS技术支持）",
            "example": "https://data-cdn.aliyunpds.com/hz22%2F5d79219b0aa9a7c995a94a96993ba3205cd91c5a%2F5d79219bf3261a5d38744da0834ed489b677a27a?Expires=xxxOSSAccessKeyId=xxx&Signature=xxx&response-content-disposition=attachment%3Bfilename%3DtBiZAoJPC2c8b13450eda4292b7f5f8010618e078.txt",
            "type": "string"
          },
          "content_hash": {
            "description_en": "The hash of the file content",
            "description_zh": "文件内容hash",
            "example": "EA4942AA8761213890A5C386F88E6464D2C31CA1",
            "type": "string"
          },
          "content_hash_name": {
            "description_en": "The name of the hash algorithm for the file content",
            "description_zh": "文件内容hash算法名",
            "example": "sha1",
            "type": "string"
          },
          "crc64_hash": {
            "description_en": "The CRC-64 value",
            "description_zh": "crc64值",
            "example": "5498595269368962671",
            "type": "string"
          },
          "expiration": {
            "description_en": "The expiration time of the download URL",
            "description_zh": "下载链接的过期时间",
            "example": "2022-01-02T15:04:05.999Z07:00",
            "type": "string"
          },
          "internal_url": {
            "description_en": "The download URL for use within a Virtual Private Cloud (VPC). This field is not used if you enable intelligent data endpoints. In that case, the system automatically returns the appropriate URL in the url field. To use this field, contact PDS technical support",
            "description_zh": "vpc内下载地址\n（开启智能数据域名后将不使用该字段，根据请求该参数会自适应返回在URL字段值内，如需使用该字段请联系PDS技术支持）",
            "example": "https://data-vpc.aliyunpds.com/hz22%2F5d79219b0aa9a7c995a94a96993ba3205cd91c5a%2F5d79219bf3261a5d38744da0834ed489b677a27a?Expires=xxxOSSAccessKeyId=xxx&Signature=xxx&response-content-disposition=attachment%3Bfilename%3DtBiZAoJPC2c8b13450eda4292b7f5f8010618e078.txt",
            "type": "string"
          },
          "size": {
            "description_en": "The file size, in bytes",
            "description_zh": "文件大小，单位：byte",
            "example": "10",
            "format": "int64",
            "type": "integer"
          },
          "url": {
            "description_en": "The public download URL. If you enable intelligent data endpoints, the system selects the best network line for the customer and returns a download URL with the corresponding domain name",
            "description_zh": "公网下载地址\n（开启智能数据域名后，根据客户网络情况选取最优线路，返回对应域名下载地址）",
            "example": "https://data.aliyunpds.com/hz22%2F5d79219b0aa9a7c995a94a96993ba3205cd91c5a%2F5d79219bf3261a5d38744da0834ed489b677a27a?Expires=xxxOSSAccessKeyId=xxx&Signature=xxx&response-content-disposition=attachment%3Bfilename%3DtBiZAoJPC2c8b13450eda4292b7f5f8010618e078.txt",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
