{
  "camel_example": "",
  "cmd_full_name": "pds get-upload-url",
  "cmd_name": "get-upload-url",
  "components": {
    "schemas": {
      "UploadFormInfo": {
        "description_en": "The required information for a form upload",
        "description_zh": "表单上传信息",
        "properties": {
          "endpoint": {
            "description_en": "The request endpoint for the upload",
            "description_zh": "数据存储地址",
            "title": "数据存储地址",
            "type": "string"
          },
          "form_data": {
            "additionalProperties": {
              "description_en": "The key-value pairs for the form fields. The value for each key must be a string",
              "description_zh": "",
              "type": "string"
            },
            "description_en": "The form fields for the upload",
            "description_zh": "表单上传信息",
            "title": "表单上传信息",
            "type": "object"
          }
        },
        "title": "A short description of struct",
        "type": "object"
      },
      "UploadPartInfo": {
        "description_en": "Part information",
        "description_zh": "分段信息",
        "properties": {
          "etag": {
            "description_en": "This field is deprecated. Do not use it",
            "description_zh": "此字段已废弃，请勿使用",
            "example": "\"0CC175B9C0F1B6A831C399E269772661\"",
            "title": "etag",
            "type": "string"
          },
          "internal_upload_url": {
            "description_en": "The internal upload URL, which is used for access from within a VPC network. After you enable the intelligent data domain feature, this field is no longer used. The value of this parameter is adaptively returned in the upload_url field based on the request. If you need to use this field, contact PDS technical support",
            "description_zh": "内网上传地址，用于VPC网络内部访问\n（开启智能数据域名后将不再使用该字段，根据请求该参数会自适应返回在upload_url字段值内，如需使用该字段请联系PDS技术支持）",
            "example": "https://data-vpc.aliyunpds.com/xxx/xxx?Expires=xxx&OSSAccessKeyId=xxx&Signature=xxx&partNumber=1&uploadId=0CC175B9C0F1B6A831C399E269772661\n",
            "title": "内网上传地址",
            "type": "string"
          },
          "parallel_sha1_ctx": {
            "description_en": "The SHA-1 context of the previous part. This field is valid only for parallel upload of multiple parts",
            "description_zh": "上一个分段的sha1上下文，该字段只在多分片并发上传的模式下有效",
            "properties": {
              "h": {
                "description_en": "The first five 32-bit variables of the SHA-1 hash of the previous data block. This field is valid only for parallel upload of multiple parts",
                "description_zh": "上一个数据块SHA1的第1-5个32位变量，该字段只在多分片并发上传的模式下有效",
                "items": {
                  "description_en": "",
                  "description_zh": "",
                  "format": "int64",
                  "type": "integer"
                },
                "title": "上一个数据块SHA1的第1-5个32位变量",
                "type": "array"
              },
              "part_offset": {
                "description_en": "The total length of data up to the previous data block, in bytes. The value must be a multiple of 64. This field is valid only for parallel upload of multiple parts",
                "description_zh": "到上一个数据块为止的总长度，字节，需要为64的倍数，该字段只在多分片并发上传的模式下有效",
                "example": "10240",
                "format": "int64",
                "title": "到上一个数据块为止的总长度，字节，需要为64的倍数",
                "type": "integer"
              }
            },
            "title": "上一个分段的sha1上下文",
            "type": "object"
          },
          "parallel_sha256_ctx": {
            "description_en": "The SHA-256 context of the previous part",
            "description_zh": "上一个分段的sha256上下文",
            "properties": {
              "h": {
                "description_en": "The first eight 32-bit variables of the SHA-256 hash of the previous data block",
                "description_zh": "上一个数据块SHA256的第1-8个32位变量",
                "items": {
                  "description_en": "",
                  "description_zh": "",
                  "format": "int64",
                  "type": "integer"
                },
                "title": "上一个数据块SHA256的第1-8个32位变量",
                "type": "array"
              },
              "part_offset": {
                "description_en": "The total length of data up to the previous data block, in bytes. The value must be a multiple of 64",
                "description_zh": "到上一个数据块为止的总长度，字节，需要为64的倍数",
                "format": "int64",
                "title": "到上一个数据块为止的总长度，字节，需要为64的倍数",
                "type": "integer"
              }
            },
            "title": "上一个分段的sha256上下文",
            "type": "object"
          },
          "part_number": {
            "description_en": "The part number",
            "description_zh": "段编号",
            "example": "1",
            "format": "int32",
            "required": true,
            "title": "段编号",
            "type": "integer"
          },
          "part_size": {
            "description_en": "This field is deprecated. Do not use it",
            "description_zh": "此字段已废弃，请勿使用",
            "example": "1024",
            "format": "int64",
            "title": "分段大小",
            "type": "integer"
          },
          "upload_form_info": {
            "$ref": "#/components/schemas/UploadFormInfo",
            "description_en": "The form upload information",
            "description_zh": "表单上传信息",
            "title": "表单上传信息"
          },
          "upload_url": {
            "description_en": "The upload URL. The URL is valid for 15 minutes by default. If the URL expires, you must call the GetUploadUrl operation again to obtain a new one. If you enable the intelligent data domain feature, the value of internal_upload_url is adaptively returned in this field based on the request",
            "description_zh": "上传地址，默认有效时间15分钟，如果链接超时，需要重新调用GetUploadUrl进行获取\n（开启智能数据域名后，根据请求会自适应返回internal_upload_url值在该字段内）",
            "example": "https://data.aliyunpds.com/xxx/xxx?Expires=xxx&OSSAccessKeyId=xxx&Signature=xxx&partNumber=1&uploadId=0CC175B9C0F1B6A831C399E269772661",
            "required": true,
            "title": "上传地址",
            "type": "string"
          }
        },
        "title": "分段信息",
        "type": "object"
      }
    }
  },
