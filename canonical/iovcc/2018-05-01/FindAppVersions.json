{
  "camel_example": "",
  "cmd_full_name": "iovcc find-app-versions",
  "cmd_name": "find-app-versions",
  "deprecated": false,
  "description_en": "Queries a paginated list of application versions by calling FindAppVersions",
  "description_zh": "调用FindAppVersions分页获取应用版本列表",
  "kebab_example": "aliyun iovcc find-app-versions --project-id P0VFCREU --page-size 20 --page-index 1 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "FindAppVersions",
  "operation": {
    "action": "FindAppVersions",
    "api_style": "RPC",
    "api_version": "2018-05-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "PUBLISHED",
      "help_en": "The version status, such as TESTING, TEST_PASSED, PREPUBLISH, or PUBLISHED",
      "help_zh": "版本状态，如TESTING，TEST_PASSED，PREPUBLISH，PUBLISHED",
      "location": "query",
      "name": "status",
      "options": [
        "--status"
      ],
      "raw_name": "Status",
      "required": false,
      "type": "string"
    },
    {
      "example": "P0VFCREU",
      "help_en": "The project ID",
      "help_zh": "项目ID",
      "location": "query",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": true,
      "type": "string"
    },
    {
      "example": "20",
      "help_en": "The number of entries per page. Valid values: 20 and 50",
      "help_zh": "每页大小，支持20，50",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": true,
      "type": "int"
    },
    {
      "example": "12345",
      "help_en": "The version ID",
      "help_zh": "版本ID",
      "location": "query",
      "name": "version_id",
      "options": [
        "--version-id"
      ],
      "raw_name": "VersionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "1230",
      "help_en": "The device model ID",
      "help_zh": "设备型号ID",
      "location": "query",
      "name": "device_model_id",
      "options": [
        "--device-model-id"
      ],
      "raw_name": "DeviceModelId",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. Pages start from page 1",
      "help_zh": "分页索引，从1开始",
      "location": "query",
      "name": "page_index",
      "options": [
        "--page-index"
      ],
      "raw_name": "PageIndex",
      "required": true,
      "type": "int"
    },
    {
      "example": "123",
      "help_en": "The application ID",
      "help_zh": "应用ID",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": false,
      "type": "string"
    },
    {
      "example": "sample remark",
      "help_en": "The remarks",
      "help_zh": "备注",
      "location": "query",
      "name": "remark",
      "options": [
        "--remark"
      ],
      "raw_name": "Remark",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "iovcc",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "AppVersionList": {
            "backendName": "data",
            "description_en": "The version list information, including the versions on the current page and the total number of versions that match the specified conditions",
            "description_zh": "版本列表信息，包括当前页的版本列表以及总共符合条件的版本个数",
            "nullToEmpty": true,
            "properties": {
              "Items": {
                "backendName": "items",
                "description_en": "The list of versions on the current page that match the specified conditions",
                "description_zh": "符合条件的当前页的版本列表",
                "itemName": "Items",
                "items": {
                  "properties": {
                    "AppId": {
                      "backendName": "appId",
                      "description_en": "The application ID",
                      "description_zh": "应用ID",
                      "example": "20",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "AppName": {
                      "backendName": "appName",
                      "description_en": "The application name",
                      "description_zh": "应用名",
                      "example": "iovcc-ota",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "AppPackageName": {
                      "backendName": "appPackageName",
                      "description_en": "The application package name",
                      "description_zh": "应用包名",
                      "example": "com.aliyun.iovcc.ota",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "AppVersion": {
                      "backendName": "version",
                      "description_en": "The application version number",
                      "description_zh": "应用版本号",
                      "example": "2.0.2",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "GmtCreate": {
                      "backendName": "gmtCreate",
                      "description_en": "The time when the version was created",
                      "description_zh": "版本创建时间",
                      "example": "2018-04-24 12:23:45",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "GmtCreateTimestamp": {
                      "backendName": "gmtCreateTimestamp",
                      "description_en": "The timestamp when the version was created",
                      "description_zh": "版本创建时间戳",
                      "example": "12432500000",
                      "format": "int64",
                      "nullToEmpty": false,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "GmtModify": {
                      "backendName": "gmtModify",
                      "description_en": "The time when the version was last modified",
                      "description_zh": "版本更新时间",
                      "example": "2018-04-24 12:23:45",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "GmtModifyTimestamp": {
                      "backendName": "gmtModifyTimestamp",
                      "description_en": "The timestamp when the version was last modified",
                      "description_zh": "版本更新时间戳",
                      "example": "12432500000",
                      "format": "int64",
                      "nullToEmpty": false,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Id": {
                      "backendName": "id",
                      "description_en": "The version ID",
                      "description_zh": "版本ID",
                      "example": "12345",
                      "format": "int64",
                      "nullToEmpty": false,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "InstallType": {
                      "backendName": "installType",
                      "description_en": "The client installation type for the version upgrade package. Valid values:\n\nauto: automatic installation.\ncustomize: custom installation",
                      "description_zh": "版本升级包客户端安装类型。取值：\n\nauto：表示自动安装\ncustomize：表示自定义安装",
                      "example": "auto",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "IsAllowNewInstall": {
                      "backendName": "isAllowNewInstall",
                      "description_en": "Indicates whether the application can be newly installed when it does not exist on the client. This is equivalent to post-installation",
                      "description_zh": "表示当客户端不存在此应用时，是否允许新安装此应用，相当于后装",
                      "example": "Y",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "IsForceUpgrade": {
                      "backendName": "isForceUpgrade",
                      "description_en": "Specifies whether a forced upgrade is required. Valid values: Y and N",
                      "description_zh": "是否强制升级，Y或N",
                      "example": "N",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "IsNeedRestart": {
                      "backendName": "isNeedRestart",
                      "description_en": "Specifies whether a restart is required. Valid values: Y and N",
                      "description_zh": "是否需要重启，Y或N",
                      "example": "N",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "IsSilentUpgrade": {
                      "backendName": "isSilentUpgrade",
                      "description_en": "Specifies whether silent installation is enabled. Valid values: Y and N",
                      "description_zh": "是否静默升级，Y或N",
                      "example": "N",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "RestartAppParam": {
                      "backendName": "restartAppParam",
                      "description_en": "The application restart parameter. Valid values: Y and N",
                      "description_zh": "应用重启参数，Y或N",
                      "example": "N",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "RestartAppType": {
                      "backendName": "restartAppType",
                      "description_en": "The application restart type when restartType is set to application restart. Valid values:\n\nservice: Service restart.\nactivity: Activity restart",
                      "description_zh": "如果restartType为应用重启，则这个字段表示应用重启的类型。取值：\n\nservice：表示Service重启\nactivity：表示Activity重启",
                      "example": "service",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "RestartType": {
                      "backendName": "restartType",
                      "description_en": "The restart type after the application is installed. Valid values:\n\nsystem: system restart.\napp: application restart",
                      "description_zh": "应用安装完成后的重启类型，取值：\n\nsystem：表示系统重启\napp：表示应用重启",
                      "example": "app",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Status": {
                      "backendName": "status",
                      "description_en": "The version status. The status definitions are the same as those for system version upgrades",
                      "description_zh": "版本状态，状态定义和系统版本升级一致",
                      "example": "PUBLISHED",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "StatusName": {
                      "backendName": "statusName",
                      "description_en": "The status name",
                      "description_zh": "状态名",
                      "example": "已发布",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "VersionCode": {
                      "backendName": "versionCode",
                      "description_en": "The application version code, which is used to compare version numbers during application upgrades",
                      "description_zh": "应用版本versioncode，是用于应用升级版本比较大小的字段",
                      "example": "201",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": false,
                "type": "array",
                "visibility": "Public"
              },
              "TotalCount": {
                "backendName": "totalCount",
                "description_en": "The total number of records that match the specified conditions. You can use this value to calculate the total number of pages",
                "description_zh": "符合条件的总记录数，方便调用方计算总页数",
                "example": "1000",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "6F25F67C-F411-499F-BCE2-67CA563CB064",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
