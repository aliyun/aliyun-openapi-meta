{
  "camel_example": "",
  "cmd_full_name": "iovcc describe-message",
  "cmd_name": "describe-message",
  "deprecated": false,
  "description_en": "Queries the details of a message by message ID. The details include the message body and message delivery status",
  "description_zh": "根据消息ID查询消息详情。详情包括消息体内容、消息到达情况",
  "kebab_example": "aliyun iovcc describe-message --project-id fsgtd5y5r --message-id 455888 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeMessage",
  "operation": {
    "action": "DescribeMessage",
    "api_style": "RPC",
    "api_version": "2018-05-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "fsgtd5y5r",
      "help_en": "The ID of the IoVCC project",
      "help_zh": "iovcc项目工程ID",
      "location": "query",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": true,
      "type": "string"
    },
    {
      "example": "455888",
      "help_en": "The message ID",
      "help_zh": "消息ID",
      "location": "query",
      "name": "message_id",
      "options": [
        "--message-id"
      ],
      "raw_name": "MessageId",
      "required": true,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "iovcc",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Message": {
            "backendName": "data",
            "description_en": "The message details",
            "description_zh": "消息详情",
            "nullToEmpty": false,
            "properties": {
              "AckCnt": {
                "backendName": "ackCnt",
                "description_en": "The number of devices that received the message",
                "description_zh": "消息到达设备数量",
                "example": "1",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "Action": {
                "backendName": "action",
                "description_en": "The message listener channel",
                "description_zh": "消息侦听通道",
                "example": "com.aliyun.iovcc.test",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "AppKey": {
                "backendName": "appKey",
                "description_en": "The identifier of the client application. This is the custom application AppKey under the project",
                "description_zh": "客户端应用标识，项目工程下自定义应用appKey",
                "example": "wTiRKC9m",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "AppName": {
                "backendName": "appName",
                "description_en": "The name of the client application",
                "description_zh": "客户端应用名称",
                "example": "pushdemo",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Audit": {
                "backendName": "audit",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "AuditMsg": {
                "backendName": "auditMsg",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Desc": {
                "backendName": "desc",
                "description_en": "The description of the notification content",
                "description_zh": "通知内容描述",
                "example": "this is desc test",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "ExipiredTime": {
                "backendName": "exipiredTime",
                "description_en": "The expiration time, in milliseconds",
                "description_zh": "失效时间，精确到毫秒",
                "example": "1525684245000",
                "format": "int64",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "GmtCreateTime": {
                "backendName": "gmtCreateTime",
                "description_en": "The time when the message was created, in milliseconds",
                "description_zh": "消息创建时间，精确到毫秒",
                "example": "1525681245000",
                "format": "int64",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "Id": {
                "backendName": "id",
                "description_en": "The message ID",
                "description_zh": "消息ID",
                "example": "2231942",
                "format": "int64",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "Parameter": {
                "backendName": "parameter",
                "description_en": "The message parameters.\n\nThe value is a JSON string that combines pkgContent and customCent",
                "description_zh": "消息参数。\n\n为pkgContent与customCent合并后的json字符串",
                "example": "{\\\"package\\\":\\\"com.aliyun.iovcc.test\\\",\\\"key1\\\":\\\"value1\\\"}\"",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "PredictSendCnt": {
                "backendName": "predictSendCnt",
                "description_en": "The expected number of devices to which the message is delivered",
                "description_zh": "预期消息到达设备数",
                "example": "3",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "ProjectId": {
                "backendName": "projectId",
                "description_en": "The ID of the IoVCC project",
                "description_zh": "iovcc项目工程ID",
                "example": "ssgdghww",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "SendStatus": {
                "backendName": "sendStatus",
                "description_en": "The message status.\n\n0: sending. 1: message sent. 2: message expired",
                "description_zh": "消息状态。\n\n0表示发送中；1表示消息发送完成；2表示消息已失效",
                "example": "0",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "Title": {
                "backendName": "title",
                "description_en": "The notification title",
                "description_zh": "通知标题",
                "example": "this is a title test",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The message type.\n\n1: pass-through. 2: notification",
                "description_zh": "消息类型。\n\n1表示透传；2表示通知",
                "example": "2",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "Uri": {
                "backendName": "uri",
                "description_en": "The URI specific to AliOS, used to locate the application that receives the message",
                "description_zh": "alios系统专用，用于定位接收消息应用",
                "example": "page://broadcast.alios.com",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "sfsgghdhh56666",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
