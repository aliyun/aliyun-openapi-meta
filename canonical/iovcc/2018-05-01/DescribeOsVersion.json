{
  "camel_example": "",
  "cmd_full_name": "iovcc describe-os-version",
  "cmd_name": "describe-os-version",
  "deprecated": false,
  "description_en": "Calls DescribeOsVersion to retrieve the details of a specific OS version",
  "description_zh": "调用DescribeOsVersion获取单个系统版本的详细信息",
  "kebab_example": "aliyun iovcc describe-os-version --project-id P0VFCREU --version-id 12345 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeOsVersion",
  "operation": {
    "action": "DescribeOsVersion",
    "api_style": "RPC",
    "api_version": "2018-05-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "P0VFCREU",
      "help_en": "The project ID",
      "help_zh": "项目ID",
      "location": "query",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": true,
      "type": "string"
    },
    {
      "example": "12345",
      "help_en": "The version ID",
      "help_zh": "版本ID",
      "location": "query",
      "name": "version_id",
      "options": [
        "--version-id"
      ],
      "raw_name": "VersionId",
      "required": true,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "iovcc",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "OsVersion": {
            "backendName": "data",
            "description_en": "The basic information about the version",
            "description_zh": "版本基本信息",
            "nullToEmpty": true,
            "properties": {
              "BlackVersionList": {
                "backendName": "blackVersionList",
                "description_en": "The blacklist of OS versions, separated by commas",
                "description_zh": "系统版本黑名单列表，英文逗号隔开",
                "example": "2.0.1,3.0.1",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "DeviceModelId": {
                "backendName": "deviceModelId",
                "description_en": "The device model ID",
                "description_zh": "设备型号ID",
                "example": "123",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "DeviceModelName": {
                "backendName": "deviceModelName",
                "description_en": "The device model name",
                "description_zh": "机型名",
                "example": "DM1",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "EnableMobileDownload": {
                "backendName": "enableMobileDownload",
                "description_en": "Indicates whether upgrade packages can be downloaded over a mobile network",
                "description_zh": "是否允许移动网络下载升级包",
                "example": "Y",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "GmtCreate": {
                "backendName": "gmtCreate",
                "description_en": "The time when the version was created, in the `yyyy-MM-dd HH:mm:ss` format",
                "description_zh": "版本创建时间，格式：`yyyy-MM-dd HH:mm:ss`",
                "example": "2018-04-24 12:23:45",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "GmtModify": {
                "backendName": "gmtModify",
                "description_en": "The time when the version was created, in the `yyyy-MM-dd HH:mm:ss` format",
                "description_zh": "版本创建时间，格式：`yyyy-MM-dd HH:mm:ss`",
                "example": "2018-04-24 12:23:45",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Id": {
                "backendName": "id",
                "description_en": "The version ID",
                "description_zh": "版本ID",
                "example": "12345",
                "format": "int64",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "IsForceNightUpgrade": {
                "backendName": "isForceNightUpgrade",
                "description_en": "Indicates whether a forced night upgrade is enabled. Valid values: Y or N. This value and the forced upgrade option cannot both be set to Y",
                "description_zh": "是否强制夜间升级，Y或N；不允许和是否强制升级同时设置为Y",
                "example": "N",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "IsForceUpgrade": {
                "backendName": "isForceUpgrade",
                "description_en": "Indicates whether a forced upgrade is enabled. Valid values: Y or N",
                "description_zh": "是否强制升级，Y或N",
                "example": "N",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "IsMilestone": {
                "backendName": "isMilestone",
                "description_en": "Indicates whether this is a milestone version. Valid values: Y or N",
                "description_zh": "是否里程碑，Y或N",
                "example": "Y",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "MaxClientVersion": {
                "backendName": "maxClientVersion",
                "description_en": "The maximum version code of the OTA SDK that is allowed",
                "description_zh": "允许的OTA SDK的最大版本versioncode",
                "example": "200",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "MinClientVersion": {
                "backendName": "minClientVersion",
                "description_en": "The minimum version code of the OTA SDK that is allowed",
                "description_zh": "允许的OTA SDK的最小版本versioncode",
                "example": "100",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "MobileDownloadMaxSize": {
                "backendName": "mobileDownloadMaxSize",
                "description_en": "The maximum size of packages that can be downloaded over a mobile network, in MB. Packages that exceed this limit are not automatically downloaded even if mobile network download is enabled",
                "description_zh": "允许移动网络下载的包的最大限制，单位为M，在允许移动网络下载包的情况下，大于该限制的包也不会自动下载",
                "example": "10",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "NightUpgradeOption": {
                "backendName": "nightUpgradeOption",
                "description_en": "The night upgrade options",
                "description_zh": "夜间升级选项",
                "nullToEmpty": false,
                "properties": {
                  "DownloadType": {
                    "backendName": "downloadType",
                    "description_en": "The download type for night upgrades. Valid values:\n\n1: download over Wi-Fi only.\n2: download over any network",
                    "description_zh": "夜间升级下载类型。\n\n1表示WIFI下下载。\n2表示任全网下载",
                    "example": "1",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "IsAllowedCancel": {
                    "backendName": "isAllowedCancel",
                    "description_en": "Indicates whether the night upgrade can be canceled. Valid values: Y or N",
                    "description_zh": "夜间升级是否允许取消，取值：Y或N",
                    "example": "N",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "IsShowTip": {
                    "backendName": "isShowTip",
                    "description_en": "Indicates whether a prompt is displayed during the night upgrade. Valid values: Y or N",
                    "description_zh": "夜间升级时是否给出提示框，取值：Y或N",
                    "example": "N",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "ReleaseNote": {
                "backendName": "releaseNote",
                "description_en": "The release note of the version",
                "description_zh": "版本发布说明",
                "example": "改用UI用户体验，提升系统稳定性",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Remark": {
                "backendName": "remark",
                "description_en": "The remarks",
                "description_zh": "备注",
                "example": "版本备注信息，终端设备不可见",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "RomList": {
                "backendName": "romList",
                "description_en": "The list of upgrade packages",
                "description_zh": "升级包列表",
                "itemName": "RomList",
                "items": {
                  "properties": {
                    "BaseVersion": {
                      "backendName": "baseVersion",
                      "description_en": "The baseline OS version. This value is empty if the package is a full package",
                      "description_zh": "基准系统版本，如果是全量包，则为空",
                      "example": "2.0.1-R-20180502.1205",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "DownloadUrl": {
                      "backendName": "downloadUrl",
                      "description_en": "The download URL of the upgrade package",
                      "description_zh": "升级包下载地址",
                      "example": "https://www.cdn-server.com/file.zip",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "GmtCreate": {
                      "backendName": "gmtCreate",
                      "description_en": "The time when the upgrade package was created, in the `yyyy-MM-dd HH:mm:ss` format",
                      "description_zh": "升级包创建时间，格式：`yyyy-MM-dd HH:mm:ss`",
                      "example": "2018-04-24 12:23:45",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "GmtModify": {
                      "backendName": "gmtModify",
                      "description_en": "The time when the upgrade package was last modified, in the `yyyy-MM-dd HH:mm:ss` format",
                      "description_zh": "升级包修改时间，格式：`yyyy-MM-dd HH:mm:ss`",
                      "example": "2018-04-24 12:23:45",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Id": {
                      "backendName": "id",
                      "description_en": "The upgrade package ID",
                      "description_zh": "升级包ID",
                      "example": "100",
                      "format": "int64",
                      "nullToEmpty": false,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Md5": {
                      "backendName": "md5",
                      "description_en": "The MD5 hash of the upgrade package",
                      "description_zh": "升级包MD5",
                      "example": "we3utrw4esdfgkhsdlfha",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "OriginalUrl": {
                      "backendName": "originalUrl",
                      "description_en": "The original URL of the upgrade package",
                      "description_zh": "升级包原始地址",
                      "example": "http://www.oss-server.com/file.zip",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Size": {
                      "backendName": "size",
                      "description_en": "The size of the upgrade package, in bytes",
                      "description_zh": "升级包大小，单位字节",
                      "example": "10000",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "SplitNum": {
                      "backendName": "splitNum",
                      "description_en": "The number of shards of the upgrade package. Each shard is 10 MB",
                      "description_zh": "升级包分片数，10MB一个分片",
                      "example": "10",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "VersionId": {
                      "backendName": "versionId",
                      "description_en": "The version ID to which the upgrade package belongs",
                      "description_zh": "升级包所属的版本ID",
                      "example": "12345",
                      "format": "int64",
                      "nullToEmpty": false,
                      "type": "integer",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": false,
                "type": "array",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The version status. Valid values:\n\nINITIAL: initial state\nCREATING: being created\nCREATE_FAILED: creation failed\nCREATE_COMPLETED: creation completed\nTESTING: being tested\nTEST_PASSED: test passed\nPREPUBLISHED: pre-released\nPUBLISHED: published\nUNUSED: deprecated\nFROZEN: frozen\nDOWN: delisted",
                "description_zh": "版本状态，所有的状态有：\n\nINITIAL：初始状态\nCREATING：创建中\nCREATE_FAILED：创建失败\nCREATE_COMPLETED：创建完成\nTESTING：测试中\nTEST_PASSED：测试已通过\nPREPUBLISHED：预发布\nPUBLISHED：已发布\nUNUSED：已废弃\nFROZEN：已冻结\nDOWN：已下架",
                "example": "PUBLISHED",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "StatusName": {
                "backendName": "statusName",
                "description_en": "The Chinese name of the version status",
                "description_zh": "版本状态的中文名",
                "example": "已发布",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "SystemVersion": {
                "backendName": "systemVersion",
                "description_en": "The OS version number",
                "description_zh": "系统版本号",
                "example": "2.0.1-R-20180506.0824",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "WhiteVersionList": {
                "backendName": "whiteVersionList",
                "description_en": "The whitelist of OS versions",
                "description_zh": "系统版本白名单列表",
                "example": "2.0.1,3.0.1",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "6F25F67C-F411-499F-BCE2-67CA563CB064",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
