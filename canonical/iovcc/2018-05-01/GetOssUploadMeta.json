  "kebab_example": "aliyun iovcc get-oss-upload-meta --project-id P0VFCREU --ext zip --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetOssUploadMeta",
  "operation": {
    "action": "GetOssUploadMeta",
    "api_style": "RPC",
    "api_version": "2018-05-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "P0VFCREU",
      "help_en": "The ID of the project",
      "help_zh": "所属项目ID",
      "location": "query",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": true,
      "type": "string"
    },
    {
      "example": "zip",
      "help_en": "The file name extension",
      "help_zh": "文件后缀",
      "location": "query",
      "name": "ext",
      "options": [
        "--ext"
      ],
      "raw_name": "Ext",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
