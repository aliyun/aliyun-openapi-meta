                "description_zh": "STS token",
                "example": "xxxxxxxxxxxxxx",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Signature": {
                "backendName": "signature",
                "description_en": "The signature",
                "description_zh": "签名",
                "example": "xxxxxxxxxxxx=",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
