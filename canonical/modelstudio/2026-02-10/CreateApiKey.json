          "options": [
            "--model-access-scope"
          ],
          "raw_name": "modelAccessScope",
          "required": false,
          "type": "object"
        },
        {
          "enum": [
            "All",
            "Custom"
          ],
          "example": "Custom",
          "help_en": "Valid values:\n\nAll: all permissions.\nCustom: custom permissions",
          "help_zh": "All：全部权限；Custom：自定义权限",
          "name": "type",
          "options": [
            "--type"
