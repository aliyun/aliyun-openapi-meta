          "fields": [
            {
              "element": {
                "type": "string"
              },
              "help_en": "The list of accessible models.\n<notice>This parameter takes effect only when allowAllModels is set to false.></notice>",
              "help_zh": "可访问的模型列表。\n<notice>仅在allowAllModels为false时，填写内容才会生效。></notice>",
