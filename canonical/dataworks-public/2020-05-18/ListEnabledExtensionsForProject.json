{
  "cmd_full_name": "dataworks-public list-enabled-extensions-for-project",
  "cmd_name": "list-enabled-extensions-for-project",
  "deprecated": false,
  "description_en": "Queries a list of built-in and custom extensions that are enabled in a workspace",
  "description_zh": "调用ListEnabledExtensionsForProject来获取项目空间下已经开启的扩展程序列表，包含系统扩展程序和自定义扩展程序",
  "kebab_example": "aliyun dataworks-public list-enabled-extensions-for-project --event-code commit-file --project-id 10000 --api-version 2020-05-18 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "ListEnabledExtensionsForProject",
  "operation": {
    "action": "ListEnabledExtensionsForProject",
    "api_style": "RPC",
    "api_version": "2020-05-18",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "commit-file",
      "help_en": "The code of the extension point event",
      "help_zh": "扩展点事件编码",
      "location": "formData",
      "name": "event_code",
      "options": [
        "--event-code"
      ],
      "raw_name": "EventCode",
      "required": true,
      "type": "string"
    },
    {
      "example": "10000",
      "help_en": "The DataWorks workspace ID. You can log on to the DataWorks console (https://workbench.data.aliyun.com/console?spm=a2c4g.11186623.0.0.6b4d4941azHd2k) and go to the Workspace page to obtain the workspace ID",
      "help_zh": "DataWorks工作空间的ID。您可以登录DataWorks控制台 (https://workbench.data.aliyun.com/console?spm=a2c4g.11186623.0.0.6b4d4941azHd2k)，进入工作空间配置页面获取工作空间ID",
      "location": "formData",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": true,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The type of the code for the file.\n\nValid values: 6 (Shell), 10 (ODPS SQL), 11 (ODPS MR), 24 (ODPS Script), 99 (zero load), 221 (PyODPS 2), 225 (ODPS Spark), 227 (EMR Hive), 228 (EMR Spark), 229 (EMR Spark SQL), 230 (EMR MR), 239 (OSS object inspection), 257 (EMR Shell), 258 (EMR Spark Shell), 259 (EMR Presto), 260 (EMR Impala), 900 (real-time synchronization), 1089 (cross-tenant collaboration), 1091 (Hologres development), 1093 (Hologres SQL), 1100 (assignment), and 1221 (PyODPS 3).\n\nYou can call the https://help.aliyun.com/document_detail/212428.html operation to query the type of the code for the file",
      "help_zh": "文件的代码类型。\n\n不同文件类型其代码不同，详情请参见https://help.aliyun.com/document_detail/600169.html。\n您也可以调用https://help.aliyun.com/document_detail/212428.html接口，查询文件的代码类型",
      "location": "formData",
      "name": "file_type",
      "options": [
        "--file-type"
      ],
      "raw_name": "FileType",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "dataworks-public",
  "protocol": "HTTP|HTTPS",
