                "type": "integer",
                "visibility": "Public"
              },
              "BusinessId": {
                "backendName": "bizId",
                "description_en": "The ID of the workflow",
                "description_zh": "业务流程ID",
                "example": "123",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "Connection": {
                "backendName": "connection",
                "description_en": "The connection string",
