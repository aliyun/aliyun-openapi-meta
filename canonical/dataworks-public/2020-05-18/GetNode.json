                "example": "默认资源组",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "SchedulerType": {
                "backendName": "schedulerType",
                "description_en": "The scheduling type. Valid values:\nNORMAL: normal scheduling node.\nMANUAL: manual node that is not scheduled on a regular basis.\nPAUSE: paused node.\nSKIP: dry-run node that is scheduled on a regular basis but is directly set to successful when scheduling starts",
                "description_zh": "调度的类型，取值如下：\nNORMAL：正常调度任务。\nMANUAL：手动任务，不会被日常调度。\nPAUSE：暂停任务。\nSKIP：空跑任务，被日常调度，但启动调度时直接被置为成功",
                "example": "NORMAL",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
