                "backendName": "nodeId",
                "description_en": "The ID of the node",
                "description_zh": "节点的ID",
                "example": "1234",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "NodeName": {
                "backendName": "nodeName",
                "description_en": "The name of the node",
                "description_zh": "节点的名称",
