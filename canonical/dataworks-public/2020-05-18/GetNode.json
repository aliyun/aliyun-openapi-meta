      "options": [
        "--node-id"
      ],
      "raw_name": "NodeId",
      "required": true,
      "type": "int"
    },
    {
      "doc_required": true,
      "enum": [
        "PROD",
        "DEV"
      ],
      "example": "PROD",
      "help_en": "The environment of the workspace. Valid values: PROD and DEV",
      "help_zh": "工作空间的环境，包括PROD和DEV",
      "location": "formData",
      "name": "project_env",
      "options": [
        "--project-env"
      ],
      "raw_name": "ProjectEnv",
      "required": true,
      "type": "string"
    }
  ],
