                          {
                            "targetValue": "COMMITTING",
                            "value": "10"
                          },
                          {
                            "targetValue": "COMMITED",
                            "value": "11"
                          },
                          {
                            "targetValue": "CHECK_OK",
                            "value": "20"
                          },
                          {
                            "targetValue": "CHECK_ERROR",
                            "value": "21"
                          },
                          {
                            "targetValue": "CHECK_WARN",
                            "value": "22"
                          },
                          {
                            "targetValue": "PACKAGED",
                            "value": "80"
                          },
                          {
                            "targetValue": "DEPLOYING",
                            "value": "100"
                          },
                          {
                            "targetValue": "DEPLOYED",
                            "value": "101"
                          },
                          {
                            "targetValue": "CANCELED",
                            "value": "200"
                          }
                        ]
                      },
                      "visibility": "Public"
                    },
                    "UseType": {
                      "backendName": "useType",
                      "description_en": "The functional module to which the file belongs. Valid values: NORMAL, MANUAL, MANUAL_BIZ, SKIP, ADHOCQUERY, and COMPONENT. The value SKIP indicates that the node corresponding to the file is run in dry-run mode",
                      "description_zh": "文件所属的功能模块，包括NORMAL（数据开发）、MANUAL（手动任务）、MANUAL_BIZ（手动工作流）、SKIP（数据开发的空跑调度）、ADHOCQUERY（临时查询）和COMPONENT（组件管理）",
                      "example": "NORMAL",
                      "nullToEmpty": true,
                      "type": "string",
                      "valueMapping": {
                        "cases": [
                          {
                            "targetValue": "NORMAL",
                            "value": "0"
                          },
                          {
                            "targetValue": "MANUAL",
                            "value": "1"
                          },
                          {
                            "targetValue": "MANUAL_BIZ",
                            "value": "2"
                          },
                          {
                            "targetValue": "ADHOCQUERY",
                            "value": "10"
                          },
                          {
                            "targetValue": "COMPONENT",
                            "value": "30"
                          }
                        ]
