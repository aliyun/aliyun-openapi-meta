                      "example": "UPDATE",
                      "nullToEmpty": true,
                      "type": "string",
                      "valueMapping": {
                        "cases": [
                          {
                            "targetValue": "NEW",
                            "value": "0"
                          },
                          {
                            "targetValue": "UPDATE",
                            "value": "1"
                          },
                          {
                            "targetValue": "DELETE",
                            "value": "2"
                          }
                        ]
                      },
                      "visibility": "Public"
                    },
                    "Comment": {
                      "backendName": "comment",
