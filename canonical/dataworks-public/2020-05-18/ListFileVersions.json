                      "description_zh": "本次文件版本的说明",
                      "example": "Second version submission",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "CommitTime": {
                      "backendName": "commitTime",
                      "description_en": "The time when the file version was created. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                      "description_zh": "生成文件版本的毫秒时间戳",
                      "example": "1593881265000",
                      "format": "int64",
                      "nullToEmpty": true,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "CommitUser": {
                      "backendName": "commitUser",
                      "description_en": "The ID of the Alibaba Cloud account used to create the file of the current version",
                      "description_zh": "生成本次文件版本的阿里云用户UID",
                      "example": "73842342****",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "FileContent": {
                      "backendName": "fileContent",
                      "description_en": "The code in the file of the current version",
                      "description_zh": "生成本次文件版本的文件代码",
                      "example": "SHOW TABLES;",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "FileName": {
                      "backendName": "fileName",
                      "description_en": "The name of the file of the current version",
                      "description_zh": "生成本次文件版本的文件名",
                      "example": "ods_user_info_d",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "FilePropertyContent": {
                      "backendName": "filePropertyContent",
                      "description_en": "The basic information about the file of the current version",
                      "description_zh": "生成本次文件版本的文本基本信息",
                      "example": "{\"fileName\":\"ods_user_info_d\",\"fileType\":10}",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "FileVersion": {
                      "backendName": "fileVersion",
                      "description_en": "The version of the file",
                      "description_zh": "文件的版本",
                      "example": "2",
                      "format": "int32",
                      "nullToEmpty": true,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "IsCurrentProd": {
                      "backendName": "isCurrentProd",
                      "description_en": "Indicates whether the file version is the same as the latest file version in the production environment",
                      "description_zh": "本次文件版本是否为当前生产环境的最新版本",
                      "example": "false",
                      "nullToEmpty": true,
                      "type": "boolean",
                      "valueMapping": {
                        "cases": [
                          {
                            "targetValue": "true",
                            "value": "1"
                          },
                          {
                            "targetValue": "false",
                            "value": "0"
                          }
                        ]
                      },
                      "visibility": "Public"
                    },
                    "NodeContent": {
                      "backendName": "nodeContent",
                      "description_en": "The scheduling configurations for the node that corresponds to the file of the current version",
                      "description_zh": "生成本次文件版本的调度配置",
                      "example": "{\"cycleType\":0,\"cronExpress\":\"00 05 00 * * ?\"}",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "NodeId": {
                      "backendName": "cloudUuid",
                      "description_en": "The ID of the auto triggered node that corresponds to the file of the current version",
                      "description_zh": "生成文件版本时对应的调度任务ID",
                      "example": "1234",
