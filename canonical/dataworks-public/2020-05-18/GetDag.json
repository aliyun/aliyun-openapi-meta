{
  "cmd_full_name": "dataworks-public get-dag",
  "cmd_name": "get-dag",
  "deprecated": false,
  "description_en": "Queries the information about a directed acyclic graph (DAG). You can call the GetDag operation to query the information about the DAG for a manually triggered workflow, a manually triggered node, or a data backfill instance. However, you cannot query the information about the DAG for an auto triggered node or an auto triggered workflow",
  "description_zh": "支持查询手动业务流程、手动任务、补数据的Dag详情信息，不支持查询日常调度Dag详情",
  "kebab_example": "aliyun dataworks-public get-dag --dag-id 123141452344525 --project-env PROD --api-version 2020-05-18 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "GetDag",
