                "description_zh": "参数配置，参考[扩展程序参数配置]（https://help.aliyun.com/document_detail/405354.html）",
                "example": "extension.project.disabled=projectId1,projectId2,projectId3",
                "type": "string"
              },
              "ProjectTesting": {
                "backendName": "projectTesting",
                "description_en": "The workspace for testing. If the extension is being tested, the extension can be used only in the workspace for testing",
                "description_zh": "测试用的项目空间，当扩展程序处于测试中时，只有测试项目空间可使用",
                "example": "1355211",
                "format": "int64",
                "type": "integer"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The state of the extension. 0: Testing, 1: Publishing, 3: Disabled, 4: Processing, 5: Approved, 6: Approve Failed",
                "description_zh": "扩展程序状态： 0：测试中, 1：上线中, 3：禁用中, 4：审批中, 5：审批通过, 6：审批不通过",
                "example": "0",
                "format": "int32",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID. You can use the request ID to query logs and troubleshoot issues",
            "description_zh": "请求的ID。用于定位日志，排查问题",
            "example": "0000-ABCD-EFG",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
