                "type": "string"
              },
              "ExtensionName": {
                "backendName": "extensionName",
                "description_en": "The name of the extension",
                "description_zh": "扩展程序名称",
                "example": "Extension name",
                "type": "string"
              },
              "HelpDocUrl": {
                "backendName": "helpDocUrl",
                "description_en": "The URL of the help documentation of the extension",
