                  "description_en": "The details of the event type",
                  "description_zh": "事件类型详情",
                  "properties": {
                    "CategoryCode": {
                      "backendName": "categoryCode",
                      "description_en": "The code of the event type",
                      "description_zh": "事件类型编码",
                      "example": "file-change",
                      "type": "string"
                    },
                    "CategoryName": {
                      "backendName": "categoryName",
                      "description_en": "The name of the event type",
                      "description_zh": "事件类型名称",
                      "example": "File change event",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
