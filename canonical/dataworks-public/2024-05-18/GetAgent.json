{
  "camel_example": "aliyun dataworks-public GetAgent --region cn-hangzhou --Name 'my-skill'",
  "cmd_full_name": "dataworks-public get-agent",
  "cmd_name": "get-agent",
  "deprecated": false,
  "description_en": "Retrieves the details of an agent",
  "description_zh": "读取 Agent 详情",
  "kebab_example": "aliyun dataworks-public get-agent --name my-skill --api-version 2024-05-18 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "GetAgent",
  "operation": {
    "action": "GetAgent",
    "api_style": "RPC",
    "api_version": "2024-05-18",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "my-skill",
      "help_en": "The name of the skill to retrieve",
      "help_zh": "要读取的 Skill 名称",
      "location": "formData",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": true,
      "type": "string"
    },
    {
      "example": "2",
      "help_en": "If omitted, the current definition is retrieved. If a published version is specified, the corresponding snapshot and the fixed versions of official skills and suite artifacts are retrieved. If the current unpublished version is specified, the draft is returned without fixed artifact versions. This is not the POP system parameter Version",
      "help_zh": "省略时读取当前定义；指定已发布版本时读取对应快照及固定的官方 Skill、套件制品版本；指定当前未发布版本时仍返回草稿，不返回固定制品版本。不是 POP 系统参数 Version",
      "location": "formData",
      "minimum": "1",
      "name": "agent_version",
      "options": [
        "--agent-version"
      ],
      "raw_name": "AgentVersion",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "dataworks-public",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Response parameters",
        "description_zh": "返回参数",
        "properties": {
          "Agent": {
            "backendName": "data",
            "description_en": "The details of the created agent",
            "description_zh": "创建的Agent详情",
            "properties": {
              "AgentVersion": {
                "backendName": "version",
                "description_en": "The definition version read in this request. When updating the current definition, use this value as the ExpectedVersion for UpdateAgent to prevent overwriting new versions submitted by other callers. The version of a historical snapshot does not represent the current version",
                "description_zh": "本次读取的定义版本。更新当前定义时，将该值作为 UpdateAgent 的 ExpectedVersion，可拒绝覆盖其他调用者已提交的新版本。读取历史快照的版本不代表当前版本",
                "example": "2",
                "format": "int32",
                "title_en": "Agent 定义版本",
                "title_zh": "Agent 定义版本",
                "type": "integer"
              },
              "CallableAgents": {
                "backendName": "callableAgents",
                "description_en": "The list of callable sub-agents",
                "description_zh": "可调用的子 Agent 列表",
                "itemName": "Agent",
                "items": {
                  "properties": {
                    "DisplayName": {
                      "backendName": "displayName",
                      "description_en": "The display name of the sub-agent",
                      "description_zh": "子 Agent 展示名称",
                      "example": "子助手",
                      "type": "string"
                    },
                    "Name": {
                      "backendName": "name",
                      "description_en": "The name of the sub-agent",
                      "description_zh": "子 Agent 名称",
                      "example": "sub-agent",
                      "type": "string"
                    },
                    "Source": {
                      "backendName": "source",
                      "description_en": "The source of the sub-agent",
                      "description_zh": "子 Agent 来源",
                      "example": "custom",
                      "type": "string"
                    },
                    "Version": {
                      "backendName": "version",
                      "description_en": "The version number of the sub-agent",
                      "description_zh": "子 Agent 版本号",
                      "example": "-",
                      "format": "int32",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "CreatorId": {
                "backendName": "creatorId",
                "description_en": "The ID of the creator",
                "description_zh": "创建者 ID",
                "example": "123456",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description",
                "description_zh": "描述",
                "example": "数据分析助手",
                "type": "string"
              },
              "DisplayName": {
                "backendName": "displayName",
                "description_en": "The display name",
                "description_zh": "展示名称",
                "example": "我的助手",
                "type": "string"
              },
              "ExpertSuites": {
                "backendName": "expertSuites",
                "description_en": "The expert suites and fixed release versions associated with the agent definition",
                "description_zh": "Agent 定义绑定的专家套件及固定发布版本",
                "itemName": "ExpertSuite",
                "items": {
                  "properties": {
                    "Description": {
                      "backendName": "description",
                      "description_en": "If the suite is deleted, the release snapshot is missing, or the caller does not have permission to view it, the suite summary is not returned, and only the ID and version number are retained",
                      "description_zh": "套件已删除、发布快照缺失或调用者无权查看时，不返回套件摘要，仅保留 ID 和版本号",
                      "example": "数据分析专家能力集合",
                      "title_en": "绑定版本的套件描述",
                      "title_zh": "绑定版本的套件描述",
                      "type": "string"
                    },
                    "DisplayName": {
                      "backendName": "displayName",
                      "description_en": "The display name of the associated version",
                      "description_zh": "绑定版本的展示名称",
                      "example": "数据分析专家套件",
                      "title_en": "绑定版本的展示名称",
                      "title_zh": "绑定版本的展示名称",
                      "type": "string"
                    },
                    "Name": {
                      "backendName": "name",
                      "description_en": "The suite name of the associated version",
                      "description_zh": "绑定版本的套件名称",
                      "example": "analysis-suite",
                      "title_en": "绑定版本的套件名称",
                      "title_zh": "绑定版本的套件名称",
                      "type": "string"
                    },
                    "PackageVersion": {
                      "backendName": "packageVersion",
                      "description_en": "The fixed official artifact version returned when explicitly querying a released version of the agent. This is not returned when querying a draft or a custom suite",
                      "description_zh": "显式查询 Agent 已发布版本时返回固定的官方制品版本；查询草稿或自定义套件时不返回",
                      "example": "0.1.0.202610211408",
                      "title_en": "官方套件制品版本",
                      "title_zh": "官方套件制品版本",
                      "type": "string"
                    },
                    "SemanticVersion": {
                      "backendName": "semanticVersion",
                      "description_en": "An optional suite summary field that is not returned for new DataAgent applications. A missing value does not indicate version 0. This cannot be used as the Version for UpdateAgent and must be omitted when writing back references. For the fixed version of official artifacts, read PackageVersion",
                      "description_zh": "可选套件摘要字段，当前新 DataAgent 应用不返回；缺省不表示版本 0。不可作为 UpdateAgent 的 Version，回写引用时必须省略。官方制品的固定版本请读取 PackageVersion",
                      "example": "1.2.0",
                      "title_en": "绑定版本的语义版本",
                      "title_zh": "绑定版本的语义版本",
                      "type": "string"
                    },
                    "Source": {
                      "backendName": "source",
                      "description_en": "OFFICIAL indicates an official catalog resource. An omitted value or DB indicates a personal or enterprise resource",
                      "description_zh": "OFFICIAL 表示官方目录资源；省略或 DB 表示个人或企业资源",
                      "example": "OFFICIAL",
                      "title_en": "专家套件来源",
                      "title_zh": "专家套件来源",
                      "type": "string"
                    },
                    "SuiteId": {
                      "backendName": "suiteId",
                      "description_en": "The ID of the expert suite",
                      "description_zh": "专家套件 ID",
                      "example": "suite_example",
                      "title_en": "专家套件 ID",
                      "title_zh": "专家套件 ID",
                      "type": "string"
                    },
                    "Version": {
                      "backendName": "version",
                      "description_en": "Returned only for personal or enterprise suites when referencing an explicitly specified version or reading a release snapshot. This is not returned for official suites. A missing value is not 0. If the SDK initializes a missing integer to 0, it must be omitted when writing back. For official items, only Source and SuiteId are written back, and Version, SemanticVersion, or PackageVersion are not passed",
                      "description_zh": "仅个人或企业套件在引用明确指定版本或读取发布快照时返回；官方套件不返回。未返回不是 0；SDK 若将缺省整数初始化为 0，回写时必须省略。官方项只回写 Source 和 SuiteId，不传 Version、SemanticVersion 或 PackageVersion",
                      "example": "3",
                      "format": "int32",
                      "title_en": "自定义套件发布版本号",
                      "title_zh": "自定义套件发布版本号",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "title_en": "绑定的专家套件",
                "title_zh": "绑定的专家套件",
                "type": "array"
              },
              "GmtCreateTime": {
                "backendName": "gmtCreate",
                "description_en": "The creation time, as a timestamp in milliseconds",
                "description_zh": "创建时间（毫秒时间戳）",
                "example": "1780555634000",
                "format": "iso8601",
                "type": "string"
              },
              "GmtModifiedTime": {
                "backendName": "gmtModified",
                "description_en": "The last modification time, as a timestamp in milliseconds",
                "description_zh": "最近修改时间（毫秒时间戳）",
                "example": "1780555634000",
                "format": "iso8601",
                "type": "string"
              },
              "Metadata": {
                "backendName": "metadata",
                "description_en": "The extended metadata",
                "description_zh": "扩展元数据",
                "example": "{}",
                "type": "object"
              },
              "Model": {
                "backendName": "model",
                "description_en": "The model configuration",
                "description_zh": "模型配置",
                "properties": {
                  "Config": {
                    "backendName": "config",
                    "description_en": "The additional configuration of the model",
                    "description_zh": "模型的额外配置",
                    "example": "{}",
                    "type": "object"
                  },
                  "MaxTokens": {
                    "backendName": "maxTokens",
                    "description_en": "The maximum number of output tokens per request",
                    "description_zh": "单次最大输出 Token 数",
                    "example": "8192",
                    "format": "int32",
                    "type": "integer"
                  },
                  "ModelName": {
                    "backendName": "modelName",
                    "description_en": "The name of the model",
                    "description_zh": "模型名称",
                    "example": "qwen3-max",
                    "type": "string"
                  },
                  "Stream": {
                    "backendName": "stream",
                    "description_en": "Specifies whether to use streaming output",
                    "description_zh": "是否流式输出",
                    "example": "true",
                    "type": "boolean"
                  },
                  "Temperature": {
                    "backendName": "temperature",
                    "description_en": "The sampling temperature",
                    "description_zh": "采样温度",
                    "example": "1",
                    "format": "double",
                    "type": "number"
                  },
                  "TopP": {
                    "backendName": "topP",
                    "description_en": "The top-P value for nucleus sampling",
                    "description_zh": "核采样 Top-P",
                    "example": "1",
                    "format": "double",
                    "type": "number"
                  }
                },
                "type": "object"
              },
              "ModifierId": {
                "backendName": "modifierId",
                "description_en": "The ID of the last modifier",
                "description_zh": "最近修改者 ID",
                "example": "123456",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The agent name",
                "description_zh": "Agent 名称",
                "example": "my-agent",
                "type": "string"
              },
              "RequiredRuntime": {
                "backendName": "requiredRuntime",
                "description_en": "The environment dependencies required for runtime",
                "description_zh": "运行所需的环境依赖",
                "itemName": "requiredRuntime",
                "items": {
                  "description_en": "None",
                  "description_zh": "空",
                  "example": "-",
                  "type": "string"
                },
                "type": "array"
              },
              "Skills": {
                "backendName": "skills",
                "description_en": "The list of skills",
                "description_zh": "技能列表",
                "itemName": "Skill",
                "items": {
                  "description_en": "The details of the skill associated with the agent",
                  "description_zh": "Agent 关联的 Skill 详情",
                  "properties": {
                    "Name": {
                      "backendName": "name",
                      "description_en": "The name of the skill",
                      "description_zh": "技能名称",
                      "example": "my-skill",
                      "title_en": "自定义 Skill 名称",
                      "title_zh": "自定义 Skill 名称",
                      "type": "string"
                    },
                    "PackageVersion": {
                      "backendName": "packageVersion",
                      "description_en": "The fixed official artifact version returned when querying a released snapshot with a specified AgentVersion. This is not returned when querying a draft or a custom skill",
                      "description_zh": "指定 AgentVersion 查询已发布快照时返回固定的官方制品版本；查询草稿或自定义 Skill 时不返回",
                      "example": "0.6.0.202608201110",
                      "title_en": "官方 Skill 制品版本",
                      "title_zh": "官方 Skill 制品版本",
                      "type": "string"
                    },
                    "SkillId": {
                      "backendName": "skillId",
                      "description_en": "The ID of the official skill",
                      "description_zh": "官方 Skill ID",
                      "example": "dataworks-semantic",
                      "title_en": "官方 Skill ID",
                      "title_zh": "官方 Skill ID",
                      "type": "string"
                    },
                    "Source": {
                      "backendName": "source",
                      "description_en": "OFFICIAL indicates an official catalog resource. An omitted value or DB indicates an original personal or enterprise resource",
                      "description_zh": "OFFICIAL 表示官方目录资源；省略或 DB 表示原有个人或企业资源",
                      "example": "OFFICIAL",
                      "title_en": "Skill 来源",
                      "title_zh": "Skill 来源",
                      "type": "string"
                    },
                    "Version": {
                      "backendName": "version",
                      "description_en": "The version number of the skill",
                      "description_zh": "技能版本号",
                      "example": "-",
                      "format": "int32",
                      "title_en": "自定义 Skill 发布版本号",
                      "title_zh": "自定义 Skill 发布版本号",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "SystemPrompt": {
                "backendName": "systemPrompt",
                "description_en": "The system prompt",
                "description_zh": "系统提示词",
                "example": "你是一个数据分析助手。",
                "type": "string"
              },
              "Tools": {
                "backendName": "tools",
                "description_en": "The list of tools",
                "description_zh": "工具列表",
                "itemName": "Tool",
                "items": {
                  "properties": {
                    "BuiltinName": {
                      "backendName": "builtinName",
                      "description_en": "The name of the built-in tool. Valid when Kind is builtin",
                      "description_zh": "内置工具名称，Kind 为 `builtin` 时有效",
                      "example": "builtin_sql",
                      "type": "string"
                    },
                    "Kind": {
                      "backendName": "kind",
                      "description_en": "The tool type",
                      "description_zh": "工具类型",
                      "example": "builtin",
                      "type": "string"
                    },
                    "McpItems": {
                      "backendName": "mcpItems",
                      "description_en": "The selected MCP tool items. Valid when Kind is mcp",
                      "description_zh": "选用的 MCP 工具项，Kind 为 `mcp` 时有效",
                      "itemName": "mcpItem",
                      "items": {
                        "description_en": "The name of the tool. The default value is all",
                        "description_zh": "工具名称，默认为全部",
                        "example": "search_table",
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "McpServerName": {
                      "backendName": "mcpServerName",
                      "description_en": "The name of the associated MCP server. Valid when Kind is mcp",
                      "description_zh": "关联的 MCP Server 名称，Kind 为 `mcp` 时有效",
                      "example": "server-name",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "Visibility": {
                "backendName": "visibility",
                "description_en": "The visibility level",
                "description_zh": "可见性级别",
                "example": "TENANT",
                "type": "string"
              },
              "VisibilityScope": {
                "backendName": "visibilityScope",
                "description_en": "The visibility scope",
                "description_zh": "可见性范围",
                "properties": {
                  "ProjectIds": {
                    "backendName": "projectIds",
                    "description_en": "The list of visible project IDs",
                    "description_zh": "可见的项目 ID 列表",
                    "itemName": "projectId",
                    "items": {
                      "description_en": "The project ID",
                      "description_zh": "项目id列表",
                      "example": "proj_001",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "UserIds": {
                    "backendName": "userIds",
                    "description_en": "The list of visible user IDs",
                    "description_zh": "可见的用户 ID 列表",
                    "itemName": "userId",
                    "items": {
                      "description_en": "The user ID",
                      "description_zh": "用户ID",
                      "example": "123456",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "824F80BA-1778-5D8A-BAFF-668A4D9C4CC7",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "timeout_ms": 60000
}
