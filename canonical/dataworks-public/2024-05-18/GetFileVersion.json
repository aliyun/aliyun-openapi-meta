{
  "camel_example": "aliyun dataworks-public GetFileVersion --region cn-hangzhou --FileVersion 2 --FileId 1000001",
  "cmd_full_name": "dataworks-public get-file-version",
  "cmd_name": "get-file-version",
  "deprecated": false,
  "description_en": "Retrieves the version details of a file",
  "description_zh": "调用GetFileVersion获取文件的版本详情",
  "kebab_example": "aliyun dataworks-public get-file-version --file-id 1000001 --file-version 2 --api-version 2024-05-18 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "GetFileVersion",
  "operation": {
    "action": "GetFileVersion",
    "api_style": "RPC",
    "api_version": "2024-05-18",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "1000001",
      "help_en": "The ID of the file. You can call https://help.aliyun.com/document_detail/173942.html to query the file ID",
      "help_zh": "文件的ID，您可以通过https://help.aliyun.com/document_detail/173942.html查询对应文件的ID",
      "location": "formData",
      "name": "file_id",
      "options": [
        "--file-id"
      ],
      "raw_name": "FileId",
      "required": true,
      "type": "int"
    },
    {
      "example": "1000011",
      "help_en": "The ID of the DataWorks workspace. You can click the small wrench icon in the upper-right corner of the page to go to the storage management page and view the ID",
      "help_zh": "DataWorks工作空间的ID，您可以单击页面右上角的小扳手图标，进入工作空间管理页面查看",
      "location": "formData",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": false,
      "type": "int"
    },
    {
      "example": "dw_project",
      "help_en": "The unique identifier of the DataWorks workspace, which is the English identifier displayed at the top of the DataStudio page for switching workspaces.\n\nYou must set either this parameter or ProjectId to determine the DataWorks workspace for this API call",
      "help_zh": "DataWorks工作空间的唯一标识符，即数据开发页面顶部切换工作空间处的英文标识。\n\n该参数与ProjectId参数二者必须设置其一，以确定本次API调用操作的DataWorks工作空间",
      "location": "formData",
      "name": "project_identifier",
      "options": [
        "--project-identifier"
      ],
      "raw_name": "ProjectIdentifier",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2",
      "help_en": "The version of the file to query",
      "help_zh": "需要查询的文件版本",
      "location": "formData",
      "name": "file_version",
      "options": [
        "--file-version"
      ],
      "raw_name": "FileVersion",
      "required": true,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "dataworks-public",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Data": {
            "backendName": "data",
            "description_en": "The version details of the file",
            "description_zh": "文件的版本详情",
            "nullToEmpty": true,
            "properties": {
              "ChangeType": {
                "backendName": "changeType",
                "description_en": "The change type of this file version. Valid values: CREATE, UPDATE, and DELETE",
                "description_zh": "本次文件版本的变更类型，包括CREATE、UPDATE和DELETE",
                "example": "UPDATE",
                "nullToEmpty": true,
                "type": "string",
                "valueMapping": {
                  "cases": [
                    {
                      "targetValue": "NEW",
                      "value": "0"
                    },
                    {
                      "targetValue": "UPDATE",
                      "value": "1"
                    },
                    {
                      "targetValue": "DELETE",
                      "value": "2"
                    }
                  ]
                },
                "visibility": "Public"
              },
              "Comment": {
                "backendName": "comment",
                "description_en": "The description of this file version",
                "description_zh": "本次文件版本的说明",
                "example": "Second version submission",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "CommitTime": {
                "backendName": "commitTime",
                "description_en": "The timestamp when the file version was generated, in milliseconds",
                "description_zh": "文件版本生成的毫秒时间戳",
                "example": "1593881265000",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "CommitUser": {
                "backendName": "commitUser",
                "description_en": "The Alibaba Cloud user ID that generated this file version",
                "description_zh": "生成本次文件版本的阿里云用户ID",
                "example": "\t\n7384234****\n",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "FileContent": {
                "backendName": "fileContent",
                "description_en": "The file code that generated this file version",
                "description_zh": "生成本次文件版本的文件代码",
                "example": "SHOW TABLES;",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "FileName": {
                "backendName": "fileName",
                "description_en": "The name of the file that generated this file version",
                "description_zh": "生成本次文件版本的文件名",
                "example": "ods_user_info_d",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "FilePropertyContent": {
                "backendName": "filePropertyContent",
                "description_en": "The basic file information when this file version was generated",
                "description_zh": "生成本次文件版本的文件基本信息",
                "example": "{\"fileName\":\"ods_user_info_d\",\"fileType\":10}",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "FileVersion": {
                "backendName": "fileVersion",
                "description_en": "The version of the file",
                "description_zh": "文件的版本",
                "example": "2",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "IsCurrentProd": {
                "backendName": "isCurrentProd",
                "description_en": "Indicates whether this file version is the latest version in the production environment. Valid values:\ntrue: The version is the latest version.\nfalse: The version is not the latest version",
                "description_zh": "本次文件版本是否为当前生产环境的最新版本。\ntrue：是最新版本。\nfalse：不是最新版本",
                "example": "true",
                "nullToEmpty": true,
                "type": "boolean",
                "valueMapping": {
                  "cases": [
                    {
                      "targetValue": "true",
                      "value": "1"
                    },
                    {
                      "targetValue": "false",
                      "value": "0"
                    }
                  ]
                },
                "visibility": "Public"
              },
              "NodeContent": {
                "backendName": "nodeContent",
                "description_en": "The scheduling configuration when this file version was generated",
                "description_zh": "本次文件版本生成时的调度配置",
                "example": "{\"cycleType\":0,\"cronExpress\":\"00 05 00 * * ?\"}",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "NodeId": {
                "backendName": "cloudUuid",
                "description_en": "The ID of the scheduling node associated with the file version when it was generated",
                "description_zh": "文件版本生成时对应的调度任务ID",
                "example": "3000001",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The current status of the file version. Valid values:\nCOMMITTING: The version is being committed.\nCOMMITTED or CHECK_OK: The version has been committed.\nPACKAGED: The version is ready for deployment.\nDEPLOYING: The version is being deployed.\nDEPLOYED: The version has been deployed.\nCANCELLED: The deployment has been canceled",
                "description_zh": "文件版本当前的状态，取值如下：\nCOMMITTING（提交中）\nCOMMITTED或CHECK_OK（已提交）\nPACKAGED（准备发布）\nDEPLOYING（发布中）\nDEPLOYED（已发布）\nCANCELLED（取消发布）",
                "example": "COMMITTED",
                "nullToEmpty": true,
                "type": "string",
                "valueMapping": {
                  "cases": [
                    {
                      "targetValue": "UNDEFINED",
                      "value": "0"
                    },
                    {
                      "targetValue": "COMMITTING",
                      "value": "10"
                    },
                    {
                      "targetValue": "COMMITED",
                      "value": "11"
                    },
                    {
                      "targetValue": "CHECK_OK",
                      "value": "20"
                    },
                    {
                      "targetValue": "CHECK_ERROR",
                      "value": "21"
                    },
                    {
                      "targetValue": "CHECK_WARN",
                      "value": "22"
                    },
                    {
                      "targetValue": "PACKAGED",
                      "value": "80"
                    },
                    {
                      "targetValue": "DEPLOYING",
                      "value": "100"
                    },
                    {
                      "targetValue": "DEPLOYED",
                      "value": "101"
                    },
                    {
                      "targetValue": "CANCELED",
                      "value": "200"
                    }
                  ]
                },
                "visibility": "Public"
              },
              "UseType": {
                "backendName": "useType",
                "description_en": "The functional module to which the file belongs. Valid values:\n0: NORMAL (DataStudio)\n1: MANUAL (manual node)\n2: MANUAL_BIZ (manual workflow)\n3: SKIP (dry-run scheduling in DataStudio)\n10: ADHOCQUERY (ad hoc query)\n30: COMPONENT (component management)",
                "description_zh": "文件所属的功能模块，取值如下：\n0：NORMAL（数据开发）\n1：MANUAL（手动任务）\n2：MANUAL_BIZ（手动工作流）\n3：SKIP（数据开发的空跑调度）\n10：ADHOCQUERY（临时查询）\n30：COMPONENT（组件管理）",
                "example": "0",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "ErrorCode": {
            "backendName": "errorCode",
            "description_en": "The error code",
            "description_zh": "错误码",
            "example": "Invalid.Tenant.ConnectionNotExists",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "ErrorMessage": {
            "backendName": "errorMessage",
            "description_en": "The error message",
            "description_zh": "错误信息",
            "example": "The connection does not exist.",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "HttpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code",
            "description_zh": "HTTP状态码",
            "example": "200",
            "format": "int32",
            "nullToEmpty": true,
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique ID of the request. You can use this ID to troubleshoot issues",
            "description_zh": "本次调用的唯一ID。出现错误后，您可以根据该ID排查问题",
            "example": "0000-ABCD-EFG****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the call was successful. Valid values:\ntrue: The call was successful.\nfalse: The call failed",
            "description_zh": "调用是否成功。\ntrue：成功。\nfalse：失败",
            "example": "true",
            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
