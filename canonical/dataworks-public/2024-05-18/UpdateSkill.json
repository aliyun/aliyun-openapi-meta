  "pathPattern": "",
  "product_code": "dataworks-public",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response schema",
        "description_zh": "Schema of Response",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "824F80BA-1778-5D8A-BAFF-668A4D9C4CC7",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Skill": {
            "backendName": "data",
            "description_en": "The skill details",
            "description_zh": "Skill 详情",
            "properties": {
              "Body": {
                "backendName": "body",
                "description_en": "The body of SKILL.md",
                "description_zh": "SKILL.md 正文",
                "example": "把大象放冰箱分为三步，把冰箱门打开，把大象放进去，把冰箱门关上。",
                "type": "string"
              },
              "CreatorId": {
                "backendName": "creatorId",
                "description_en": "The ID of the creator",
                "description_zh": "创建者 ID",
                "example": "123456",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the skill",
                "description_zh": "Skill 描述",
                "example": "数据分析技能",
                "type": "string"
              },
              "GmtCreateTime": {
                "backendName": "gmtCreate",
                "description_en": "The creation time, expressed as a timestamp in milliseconds",
                "description_zh": "创建时间（毫秒时间戳）",
                "example": "1780555634000",
                "format": "iso8601",
                "type": "string"
              },
              "GmtModifiedTime": {
                "backendName": "gmtModified",
                "description_en": "The last modification time, expressed as a timestamp in milliseconds",
                "description_zh": "最近修改时间（毫秒时间戳）",
                "example": "1780555634000",
                "format": "iso8601",
                "type": "string"
              },
              "ModifierId": {
                "backendName": "modifierId",
                "description_en": "The ID of the last modifier",
                "description_zh": "最近修改者 ID",
                "example": "123456",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the skill",
                "description_zh": "Skill 名称",
                "example": "my-skill",
                "type": "string"
              },
              "PublishedVersion": {
                "backendName": "publishedVersion",
                "description_en": "The integer version pointed to by the current publish pointer. It is empty if not yet published. When PublishImmediately=true succeeds, it points to the version saved in this request",
                "description_zh": "当前发布指针指向的整数版本；尚未发布时为空。PublishImmediately=true 成功时指向本次保存版本",
                "example": "2",
                "format": "int32",
                "title_en": "当前已发布版本",
                "title_zh": "当前已发布版本",
                "type": "integer"
              },
              "SkillVersion": {
                "backendName": "version",
                "description_en": "The integer definition version saved in this request. It can be used as ExpectedVersion for concurrency control in subsequent updates",
                "description_zh": "本次保存的整数定义版本。后续更新时可作为 ExpectedVersion 进行并发控制",
                "example": "2",
                "format": "int32",
                "title_en": "Skill 当前定义版本",
                "title_zh": "Skill 当前定义版本",
                "type": "integer"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The current status of the skill. Saving a new draft does not automatically clear the existing publish pointer. Evaluate this status in combination with SkillVersion and PublishedVersion",
                "description_zh": "Skill 当前状态。只保存新草稿不会自动清空已有发布指针，请结合 SkillVersion 和 PublishedVersion 判断",
                "example": "PUBLISHED",
                "title_en": "Skill 状态",
                "title_zh": "Skill 状态",
                "type": "string"
              },
              "Visibility": {
                "backendName": "visibility",
                "description_en": "The visibility level",
                "description_zh": "可见性级别",
                "example": "TENANT",
                "type": "string"
              },
              "VisibilityScope": {
                "backendName": "visibilityScope",
                "description_en": "The visibility scope",
                "description_zh": "可见性范围",
                "properties": {
                  "ProjectIds": {
                    "backendName": "projectIds",
                    "description_en": "The list of IDs of the projects in which the skill is visible",
                    "description_zh": "可见的项目 ID 列表",
                    "itemName": "projectId",
                    "items": {
                      "description_en": "The project ID",
                      "description_zh": "项目id",
                      "example": "123456",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "UserIds": {
                    "backendName": "userIds",
                    "description_en": "The list of IDs of the users to whom the skill is visible",
                    "description_zh": "可见的用户 ID 列表",
                    "itemName": "userId",
                    "items": {
                      "description_en": "The user ID",
                      "description_zh": "用户 ID",
                      "example": "123456",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "timeout_ms": 60000
}
