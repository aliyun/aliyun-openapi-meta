          "help_zh": "可见的用户 ID 列表",
          "name": "user_ids",
          "options": [
            "--user-ids"
          ],
          "raw_name": "UserIds",
          "required": false,
          "type": "array"
        }
      ],
      "help_en": "The visibility scope. The corresponding fields are used based on the visibility level",
      "help_zh": "可见性范围，按可见性级别取对应字段",
      "location": "formData",
      "name": "visibility_scope",
      "options": [
        "--visibility-scope"
      ],
      "param_style": "json",
      "raw_name": "VisibilityScope",
      "required": false,
      "type": "object"
    },
    {
      "example": "false",
      "help_en": "Specifies whether to publish the current skill version immediately after saving. If omitted, null, or false, only the draft is saved. If true, the existing publish validation is reused to publish the exact saved version. If publishing fails, the saved draft is retained and the original error is returned. Call GetSkill to read back the data before retrying",
      "help_zh": "是否在保存后立即发布本次 Skill 版本。省略、null 或 false 只保存草稿；true 复用既有发布校验，发布本次保存的精确版本。发布失败保留已保存草稿并返回原错误，重试前请先 GetSkill 回读",
      "location": "formData",
      "name": "publish_immediately",
      "options": [
        "--publish-immediately"
      ],
      "raw_name": "PublishImmediately",
      "required": false,
      "type": "bool"
    }
