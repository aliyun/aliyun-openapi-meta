{
  "camel_example": "aliyun dataworks-public CreateSkill --region cn-hangzhou --Name 'my-skill'",
  "cmd_full_name": "dataworks-public create-skill",
  "cmd_name": "create-skill",
  "deprecated": false,
  "description_en": "Creates a skill in DataWorks",
  "description_zh": "用于在 DataWorks 中创建一个新的 Skill",
  "kebab_example": "aliyun dataworks-public create-skill --name my-skill --api-version 2024-05-18 --region cn-hangzhou",
  "method": "POST",
  "multi_version": true,
  "name": "CreateSkill",
  "operation": {
    "action": "CreateSkill",
    "api_style": "RPC",
    "api_version": "2024-05-18",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "my-skill",
      "help_en": "The skill name, which must be unique within the current account",
      "help_zh": "Skill 名称，在当前账号下唯一",
      "location": "formData",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": true,
      "type": "string"
    },
    {
      "example": "数据分析技能",
      "help_en": "The skill description",
      "help_zh": "Skill 描述",
      "location": "formData",
      "name": "description",
      "options": [
        "--description"
      ],
      "raw_name": "Description",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "TENANT",
        "PROJECT",
        "USER"
      ],
      "example": "TENANT",
      "help_en": "The visibility level. `TENANT`: visible to the entire tenant. `PROJECT`: visible to specific projects. `USER`: visible to specific users",
      "help_zh": "可见性级别。`TENANT`：账号内可见；`PROJECT`：指定项目可见；`USER`：指定用户可见",
      "location": "formData",
      "name": "visibility",
      "options": [
        "--visibility"
      ],
      "raw_name": "Visibility",
      "required": false,
      "type": "string"
    },
    {
      "example": "初版",
      "help_en": "The version note",
      "help_zh": "版本说明",
      "location": "formData",
      "name": "version_note",
      "options": [
        "--version-note"
      ],
      "raw_name": "VersionNote",
      "required": false,
      "type": "string"
    },
    {
      "example": "---\nname: example-skill\ndescription: 示例技能。\n---\n\n# 示例技能\n\n按照用户提供的文本完成摘要。",
      "help_en": "The content of the SKILL.md file. This parameter is mutually exclusive with `BundleUrl`. If you do not provide a bundle, use this field to create a lightweight skill that contains only the SKILL.md file",
      "help_zh": "SKILL.md 正文。与 `BundleUrl` 二选一：不提供 bundle 时用本字段创建仅含 SKILL.md 的轻量 Skill",
      "location": "formData",
      "name": "skill_md_override",
      "options": [
        "--skill-md-override"
      ],
      "raw_name": "SkillMdOverride",
      "required": false,
      "type": "string"
    },
    {
      "example": "https://example.com/skill.zip",
      "help_en": "The download URL of the bundle.zip file (HTTP or HTTPS). This parameter is mutually exclusive with `SkillMdOverride`",
      "help_zh": "bundle.zip 的可下载地址（http/https）。与 `SkillMdOverride` 二选一",
      "location": "formData",
      "name": "bundle_url",
      "options": [
        "--bundle-url"
      ],
      "raw_name": "BundleUrl",
      "required": false,
      "type": "string"
    },
    {
      "example": "{\"appId\":\"APP_CWJMV36CT9SAFW1QEHX7\"}",
      "help_en": "The extended metadata in key-value pairs",
      "help_zh": "扩展元数据（键值对）",
      "location": "formData",
      "name": "extra",
      "options": [
        "--extra"
      ],
      "param_style": "json",
      "raw_name": "Extra",
      "required": false,
      "type": "map",
      "value": {
        "type": "any"
      }
    },
    {
      "fields": [
        {
          "element": {
            "type": "string"
          },
          "help_en": "The list of visible project IDs. This field takes effect when `Visibility` is set to `PROJECT`",
          "help_zh": "可见的项目 ID 列表，`Visibility` 为 `PROJECT` 时生效",
          "name": "project_ids",
          "options": [
            "--project-ids"
          ],
          "raw_name": "ProjectIds",
          "required": false,
          "type": "array"
        },
        {
          "element": {
            "type": "string"
          },
          "help_en": "The list of visible user IDs. This field takes effect when `Visibility` is set to `USER`",
          "help_zh": "可见的用户 ID 列表，`Visibility` 为 `USER` 时生效",
          "name": "user_ids",
          "options": [
            "--user-ids"
          ],
          "raw_name": "UserIds",
          "required": false,
          "type": "array"
        }
      ],
      "help_en": "The visibility scope. The effective fields depend on the value of `Visibility`",
      "help_zh": "可见性范围，按 `Visibility` 取对应字段",
      "location": "formData",
      "name": "visibility_scope",
      "options": [
        "--visibility-scope"
      ],
      "param_style": "json",
      "raw_name": "VisibilityScope",
      "required": false,
      "type": "object"
    },
    {
      "example": "false",
      "help_en": "Specifies whether to publish the current skill version immediately after saving. If this parameter is omitted, set to null, or set to false, only a draft is saved. If this parameter is set to true, the existing publish validation is reused to publish the exact saved version. If the publish operation fails, the saved draft is retained and the original error is returned. Before retrying, call GetSkill to read the latest state",
      "help_zh": "是否在保存后立即发布本次 Skill 版本。省略、null 或 false 只保存草稿；true 复用既有发布校验，发布本次保存的精确版本。发布失败保留已保存草稿并返回原错误，重试前请先 GetSkill 回读",
      "location": "formData",
      "name": "publish_immediately",
      "options": [
        "--publish-immediately"
      ],
      "raw_name": "PublishImmediately",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "dataworks-public",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "824F80BA-1778-5D8A-BAFF-668A4D9C4CC7",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Skill": {
            "backendName": "data",
            "description_en": "The skill details",
            "description_zh": "Skill 详情",
            "properties": {
              "Body": {
                "backendName": "body",
                "description_en": "The content of the SKILL.md file",
                "description_zh": "SKILL.md 正文",
                "example": "---\nname: example-skill\ndescription: 示例技能。\n---\n\n# 示例技能\n\n按照用户提供的文本完成摘要。",
                "type": "string"
              },
              "CreatorId": {
                "backendName": "creatorId",
                "description_en": "The creator ID",
                "description_zh": "创建者 ID",
                "example": "123456",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The skill description",
                "description_zh": "Skill 描述",
                "example": "数据分析技能",
                "type": "string"
              },
              "GmtCreateTime": {
                "backendName": "gmtCreate",
                "description_en": "The creation time in milliseconds",
                "description_zh": "创建时间（毫秒时间戳）",
                "example": "1780555634000",
                "format": "iso8601",
                "type": "string"
              },
              "GmtModifiedTime": {
                "backendName": "gmtModified",
                "description_en": "The update time in milliseconds",
                "description_zh": "更新时间，毫秒",
                "example": "12345678901",
                "format": "iso8601",
                "type": "string"
              },
              "ModifierId": {
                "backendName": "modifierId",
                "description_en": "The last modifier ID",
                "description_zh": "最近修改者 ID",
                "example": "123456",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The skill name",
                "description_zh": "Skill 名称",
                "example": "my-skill",
                "type": "string"
              },
              "PublishedVersion": {
                "backendName": "publishedVersion",
                "description_en": "The integer version pointed to by the current publish pointer. This value is empty if the skill has not been published. If `PublishImmediately` is set to true and the operation succeeds, this value points to the version saved in this operation",
                "description_zh": "当前发布指针指向的整数版本；尚未发布时为空。PublishImmediately=true 成功时指向本次保存版本",
                "example": "1",
                "format": "int32",
                "title_en": "当前已发布版本",
                "title_zh": "当前已发布版本",
                "type": "integer"
              },
              "SkillVersion": {
                "backendName": "version",
                "description_en": "The integer definition version saved in this operation. You can use this value as ExpectedVersion for concurrency control in subsequent updates",
                "description_zh": "本次保存的整数定义版本。后续更新时可作为 ExpectedVersion 进行并发控制",
                "example": "1",
                "format": "int32",
                "title_en": "Skill 当前定义版本",
                "title_zh": "Skill 当前定义版本",
                "type": "integer"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The current status of the skill. Saving a new draft does not automatically clear the existing publish pointer. Check this status together with SkillVersion and PublishedVersion",
                "description_zh": "Skill 当前状态。只保存新草稿不会自动清空已有发布指针，请结合 SkillVersion 和 PublishedVersion 判断",
                "example": "PUBLISHED",
                "title_en": "Skill 状态",
                "title_zh": "Skill 状态",
                "type": "string"
              },
              "Visibility": {
                "backendName": "visibility",
                "description_en": "The visibility level",
                "description_zh": "可见性级别",
                "example": "TENANT",
                "type": "string"
              },
              "VisibilityScope": {
                "backendName": "visibilityScope",
                "description_en": "The visibility scope",
                "description_zh": "可见性范围",
                "properties": {
                  "ProjectIds": {
                    "backendName": "projectIds",
                    "description_en": "The list of visible project IDs",
                    "description_zh": "可见的项目 ID 列表",
                    "itemName": "projectId",
                    "items": {
                      "description_en": "The project ID",
                      "description_zh": "项目ID",
                      "example": "123456",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "UserIds": {
                    "backendName": "userIds",
                    "description_en": "The list of visible user IDs. This field takes effect when Visibility is set to `USER`",
                    "description_zh": "可见的用户 ID 列表，Visibility 为 `USER` 时生效",
                    "itemName": "userId",
                    "items": {
                      "description_en": "The user ID",
                      "description_zh": "用户 ID",
                      "example": "123456",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "timeout_ms": 60000
}
