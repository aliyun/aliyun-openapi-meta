  \"projectId\": \"307303\",\n                        \"projectIdentifier\": \"lwttest_standard\",\n                        \"projectName\": \"XXXX\",\n                        \"projectOwnerId\": \"110755000425XXXX\",\n                        \"simple\": false,\n                        \"tenantId\": \"52425742456XXXX\"\n                    },\n                    \"projectId\": \"307XXXX\"\n                },\n                \"inputs\": {},\n                \"outputs\": {\n                    \"nodeOutputs\": [\n                        {\n                            \"data\": \"463497880880954XXXX\",\n                            \"artifactType\": \"NodeOutput\",\n                            \"refTableName\": \"OpenAPI_Test_Workflow_Demo\",\n                            \"isDefault\": true\n                        }\n                    ]\n                },\n                \"nodes\": [],\n                \"dependencies\": []\n            }\n        ]\n    }\n}",
