                    "example": "sg-bp1****",
                    "type": "string"
                  },
                  "VSwitchId": {
                    "backendName": "vSwitchId",
                    "description_en": "The vSwitch ID",
                    "description_zh": "交换机 ID",
                    "example": "vsw-bp1****",
                    "type": "string"
                  },
                  "VpcId": {
                    "backendName": "vpcId",
                    "description_en": "The VPC ID",
                    "description_zh": "专有网络 VPC ID",
                    "example": "vpc-bp1****",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "E7D55162-4489-1619-AAF5-3F97D5FCA948",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
