                          "type": "string"
                        },
                        "ForwardPort": {
                          "backendName": "forwardPort",
                          "description_en": "The target port inside the instance container",
                          "description_zh": "实例容器内的目标端口",
                          "example": "22",
                          "type": "string"
                        },
                        "Name": {
                          "backendName": "name",
                          "description_en": "The name of the port forwarding configuration",
                          "description_zh": "端口转发配置名称",
                          "example": "ssh",
                          "type": "string"
