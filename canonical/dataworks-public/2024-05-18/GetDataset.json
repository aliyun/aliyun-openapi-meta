{
  "camel_example": "aliyun dataworks-public GetDataset --region cn-hangzhou --Id 'dataworks-dataset:3pXXXb8o0ngr07njhps1'",
  "cmd_full_name": "dataworks-public get-dataset",
  "cmd_name": "get-dataset",
  "components": {
    "schemas": {
      "Dataset": {
        "description_en": "The dataset object",
        "description_zh": "数据集对象",
        "properties": {
          "Comment": {
            "backendName": "comment",
            "description_en": "The description of the dataset. The length cannot exceed 1024 characters",
            "description_zh": "数据集描述，长度小于1024",
            "example": "测试数据集",
            "title": "数据集描述，长度小于1024",
            "type": "string"
          },
          "CreateTime": {
            "backendName": "createTime",
            "description_en": "The creation time. This value is a UNIX timestamp in milliseconds",
            "description_zh": "创建时间毫秒级时间戳",
            "example": "1736756055000",
            "format": "int64",
            "title": "创建时间毫秒级时间戳",
            "type": "integer"
          },
          "CreatorId": {
            "backendName": "creatorId",
            "description_en": "The ID of the creator",
            "description_zh": "创建者ID",
            "example": "210484359",
            "title": "创建者ID",
            "type": "string"
          },
          "DataType": {
            "backendName": "dataType",
            "description_en": "The data type. Valid values:\n\nCOMMON\nPIC\nTEXT\nTABLE\nVIDEO\nAUDIO\nINDEX",
            "description_zh": "数据类型，取值有\nCOMMON 通用\nPIC 图片\nTEXT 文本\nTABLE 表格\nVIDEO 视频\nAUDIO 音频\nINDEX 索引",
            "example": "COMMON",
            "title": "数据类型，取值有\n- COMMON 通用\n- PIC 图片\n- TEXT 文本\n- TABLE 表格\n- VIDEO 视频\n- AUDIO 音频\n- INDEX 索引",
            "type": "string"
          },
          "Id": {
            "backendName": "id",
            "description_en": "The dataset ID",
            "description_zh": "数据集ID",
            "example": "dataworks-dataset:1gxxxqjx155usz3hrv",
            "title": "数据集ID",
            "type": "string"
          },
          "Labels": {
            "backendName": "labels",
            "description_en": "Dataset tags. Supported only for PAI datasets",
            "description_zh": "数据集标签，目前仅PAI数据集支持",
            "items": {
              "$ref": "#/components/schemas/DatasetLabel",
              "description_en": "The PAI dataset tag object",
              "description_zh": "PAI数据集标签对象"
            },
            "title": "数据集标签，目前仅PAI数据集支持",
            "type": "array"
          },
          "LatestVersion": {
            "$ref": "#/components/schemas/DatasetVersion",
            "backendName": "latestVersion",
            "description_en": "The latest dataset version object",
            "description_zh": "最新数据集版本对象",
            "title": "最新数据集版本对象"
          },
          "ModifyTime": {
            "backendName": "modifyTime",
            "description_en": "The modification time. This value is a UNIX timestamp in milliseconds",
            "description_zh": "修改时间毫秒级时间戳",
            "example": "1736756055000",
            "format": "int64",
            "title": "修改时间毫秒级时间戳",
            "type": "integer"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The dataset name. It must be a non-empty string and cannot exceed 128 characters",
            "description_zh": "数据集名称，非空字符串，长度小于128",
            "example": "test_dataset",
            "title": "数据集名称，非空字符串，长度小于128",
            "type": "string"
          },
          "Origin": {
            "backendName": "origin",
            "description_en": "The source of the dataset. Currently supported sources:\n\nDataWorks\nPAI",
            "description_zh": "数据集来源，当前支持\nDataWorks\nPAI",
            "example": "DataWorks",
            "title": "数据集来源，当前支持\n- DataWorks\n- PAI",
            "type": "string"
          },
          "ProjectId": {
            "backendName": "projectId",
            "description_en": "The DataWorks workspace ID",
            "description_zh": "DataWorks工作空间ID",
            "example": "123456",
            "format": "int64",
            "title": "DataWorks工作空间ID",
            "type": "integer"
          },
          "Readme": {
            "backendName": "readme",
            "description_en": "Instructions for using the dataset. Markdown rich text is supported",
            "description_zh": "数据集使用说明，支持markdown富文本",
            "example": "## introduction",
            "title": "数据集使用说明，支持markdown富文本",
            "type": "string"
          },
          "StorageType": {
            "backendName": "storageType",
            "description_en": "The storage type. Valid values:\n\nOSS: Object Storage Service\nNAS: General-purpose NAS file systems\nEXTREM_NAS: Extreme NAS file systems\nDLF_LANCE: Data Lake Formation\nCPFS: Cloud Paralleled File System\nBMCPFS: CPFS for Lingjun\nMAXCOMPUTE: MaxCompute table",
            "description_zh": "存储类型，取值有\nOSS  对象存储\nNAS  通用型NAS文件存储\nEXTREM_NAS  极速型NAS文件存储\nDLF_LANCE  数据湖构建\nCPFS  CPFS文件存储\nBMCPFS 智算CPFS文件存储\nMAXCOMPUTE  MaxCompute表",
            "example": "OSS",
            "title": "存储类型，取值有\n- OSS  对象存储\n- NAS  通用型NAS文件存储\n- EXTREM_NAS  极速型NAS文件存储\n- DLF_LANCE  数据湖构建\n- CPFS  CPFS文件存储\n- BMCPFS 智算CPFS文件存储\n- MAXCOMPUTE  MaxCompute表",
            "type": "string"
          }
        },
        "title": "数据集对象",
        "type": "object"
      },
      "DatasetLabel": {
        "description_en": "PAI dataset labels",
        "description_zh": "PAI数据集标签",
        "properties": {
          "Key": {
            "backendName": "key",
            "description_en": "Dataset label keys",
            "description_zh": "数据集标签键",
            "example": "key1",
            "title": "数据集标签键",
            "type": "string"
          },
          "Value": {
            "backendName": "value",
            "description_en": "Dataset label values",
            "description_zh": "数据集标签值",
            "example": "value1",
            "title": "数据集标签值",
            "type": "string"
          }
        },
        "title": "PAI数据集标签",
        "type": "object"
      },
      "DatasetVersion": {
        "description_en": "The dataset version object",
        "description_zh": "数据集版本对象",
        "properties": {
          "Comment": {
            "backendName": "comment",
            "description_en": "The dataset version description",
            "description_zh": "数据集版本描述",
            "example": "初始版本",
            "title": "版本使用说明",
            "type": "string"
          },
          "CreateTime": {
            "backendName": "createTime",
            "description_en": "Creation time (milliseconds)",
            "description_zh": "创建时间毫秒级时间戳",
            "example": "1736756055000",
            "format": "int64",
            "title": "创建时间毫秒级时间戳",
            "type": "integer"
          },
          "CreatorId": {
            "backendName": "creatorId",
            "description_en": "The creator ID",
            "description_zh": "创建者ID",
            "example": "17815XXX61016173",
            "title": "创建者ID",
            "type": "string"
          },
          "DatasetId": {
            "backendName": "datasetId",
            "description_en": "The corresponding dataset ID",
            "description_zh": "对应数据集ID",
            "example": "dataworks-datasetVersion:0gfxxxjx155usz3hrv",
            "title": "对应数据集ID",
            "type": "string"
          },
          "Id": {
            "backendName": "id",
            "description_en": "The dataset version ID",
            "description_zh": "数据集版本ID",
            "example": "dataworks-datasetVersion:0gfxxxjx155usz3hrv:1",
            "title": "数据集版本ID",
            "type": "string"
          },
          "ImportInfo": {
            "additionalProperties": {
              "description_en": "The storage import configuration for the dataset",
              "description_zh": "数据集的存储导入配置信息",
              "example": "None",
              "type": "string"
            },
            "backendName": "importInfo",
            "description_en": "The storage import configuration for the dataset; required configuration varies by storage type.\n\nNAS\n\nRefer to the return values from the file storage API DescribeFileSystems.\n\n```JSON\n{\n\"fileSystemId\": \"3b6XXX89c9\", // The file system ID.\n\"fileSystemStorageType\":  \"Performance\" // The file system storage type.\n\"vpcId\": \"vpc-uf66oxxxrqge1t2gson7s\" // The VPC ID of the mount point.\n}\n```",
            "description_zh": "数据集的存储导入配置, 对于不同存储类型，需要的配置信息不同\n<details>\n<summary>NAS</summary>\n取值可参考文件存储 API DescribeFileSystems 的返回信息\n\n```JSON\n{\n  \"fileSystemId\": \"3b6XXX89c9\", // 文件系统ID\n  \"fileSystemStorageType\": \"Performance\", // 文件系统的存储规格\n  \"vpcId\": \"vpc-uf66oxxxrqge1t2gson7s\" // 挂载点的VPC ID\n}\n```\n\n</details>",
            "title": "数据集的存储导入配置\n对于NAS类型，需要提供以下属性，取值可参考DescribeFileSystems接口的返回信息\n- fileSystemId 文件系统ID\n- fileSystemStorageType 文件系统的存储规格\n- vpcId 挂载点的 VPC ID",
            "type": "object"
          },
          "Labels": {
            "backendName": "labels",
            "description_en": "The PAI dataset label",
            "description_zh": "PAI数据集标签",
            "items": {
              "$ref": "#/components/schemas/DatasetLabel",
              "description_en": "The PAI dataset label",
              "description_zh": "PAI数据集标签"
            },
            "title": "PAI数据集标签",
            "type": "array"
          },
          "ModifyTime": {
            "backendName": "modifyTime",
            "description_en": "Modification time (milliseconds)",
            "description_zh": "修改时间毫秒级时间戳",
            "example": "1736756055000",
            "format": "int64",
            "title": "修改时间毫秒级时间戳",
            "type": "integer"
          },
          "MountPath": {
            "backendName": "mountPath",
            "description_en": "The mount path. Defaults to /mnt/data",
            "description_zh": "挂载路径，默认为 /mnt/data",
            "example": "/mnt/data",
            "title": "挂载路径，默认为 /mnt/data",
            "type": "string"
          },
          "StorageType": {
            "backendName": "storageType",
            "description_en": "Storage type (read-only); consistent with the corresponding property of the parent dataset",
            "description_zh": "存储类型，只读，与所属数据集对应属性保持一致",
            "example": "OSS",
            "title": "存储类型，只读，与所属数据集对应属性保持一致",
            "type": "string"
          },
          "Url": {
            "backendName": "url",
            "description_en": "URL",
            "description_zh": "URL地址",
            "example": "oss://test-oss-bucket/test_dir/",
            "title": "URL地址",
            "type": "string"
          },
          "VersionNumber": {
            "backendName": "versionNumber",
            "description_en": "The dataset version number",
            "description_zh": "数据集版本号",
            "example": "1",
            "format": "int32",
            "title": "数据集版本号",
            "type": "integer"
          }
        },
        "title": "数据集版本对象",
        "type": "object"
      }
    }
  },
