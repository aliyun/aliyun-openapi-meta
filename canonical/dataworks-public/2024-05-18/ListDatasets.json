            "$ref": "#/components/schemas/DatasetVersion",
            "backendName": "latestVersion",
            "description_en": "The latest dataset version object",
            "description_zh": "最新数据集版本对象",
            "title": "最新数据集版本对象"
          },
          "ModifyTime": {
            "backendName": "modifyTime",
            "description_en": "The modification time. This value is a UNIX timestamp in milliseconds",
            "description_zh": "修改时间毫秒级时间戳",
            "example": "1736756055000",
            "format": "int64",
            "title": "修改时间毫秒级时间戳",
            "type": "integer"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The dataset name. It must be a non-empty string and cannot exceed 128 characters",
            "description_zh": "数据集名称，非空字符串，长度小于128",
            "example": "test_dataset",
            "title": "数据集名称，非空字符串，长度小于128",
            "type": "string"
          },
          "Origin": {
            "backendName": "origin",
            "description_en": "The source of the dataset. Currently supported sources:\n\nDataWorks\nPAI",
            "description_zh": "数据集来源，当前支持\nDataWorks\nPAI",
            "example": "DataWorks",
            "title": "数据集来源，当前支持\n- DataWorks\n- PAI",
            "type": "string"
          },
          "ProjectId": {
            "backendName": "projectId",
            "description_en": "The DataWorks workspace ID",
            "description_zh": "DataWorks工作空间ID",
            "example": "123456",
            "format": "int64",
            "title": "DataWorks工作空间ID",
            "type": "integer"
          },
          "Readme": {
            "backendName": "readme",
            "description_en": "Instructions for using the dataset. Markdown rich text is supported",
            "description_zh": "数据集使用说明，支持markdown富文本",
            "example": "## introduction",
            "title": "数据集使用说明，支持markdown富文本",
            "type": "string"
          },
          "StorageType": {
            "backendName": "storageType",
            "description_en": "The storage type. Valid values:\n\nOSS: Object Storage Service\nNAS: General-purpose NAS file systems\nEXTREM_NAS: Extreme NAS file systems\nDLF_LANCE: Data Lake Formation\nCPFS: Cloud Paralleled File System\nBMCPFS: CPFS for Lingjun\nMAXCOMPUTE: MaxCompute table",
            "description_zh": "存储类型，取值有\nOSS  对象存储\nNAS  通用型NAS文件存储\nEXTREM_NAS  极速型NAS文件存储\nDLF_LANCE  数据湖构建\nCPFS  CPFS文件存储\nBMCPFS 智算CPFS文件存储\nMAXCOMPUTE  MaxCompute表",
            "example": "OSS",
            "title": "存储类型，取值有\n- OSS  对象存储\n- NAS  通用型NAS文件存储\n- EXTREM_NAS  极速型NAS文件存储\n- DLF_LANCE  数据湖构建\n- CPFS  CPFS文件存储\n- BMCPFS 智算CPFS文件存储\n- MAXCOMPUTE  MaxCompute表",
            "type": "string"
          }
        },
        "title": "数据集对象",
        "type": "object"
      },
      "DatasetLabel": {
        "description_en": "PAI dataset labels",
        "description_zh": "PAI数据集标签",
