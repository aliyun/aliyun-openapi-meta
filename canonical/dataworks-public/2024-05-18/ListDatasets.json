              "$ref": "#/components/schemas/DatasetLabel",
              "description_en": "The PAI dataset tag object",
              "description_zh": "PAI数据集标签对象"
            },
            "title": "数据集标签，目前仅PAI数据集支持",
            "type": "array"
          },
