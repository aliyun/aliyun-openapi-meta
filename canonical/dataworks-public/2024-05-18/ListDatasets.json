{
  "camel_example": "aliyun dataworks-public ListDatasets --region cn-hangzhou --Origin DataWorks --Order Asc --DataTypeList COMMON --PageSize 10 --PageNumber 1 --CreatorId 12103XXX46492139 --SortBy CreateTime --ProjectId 251363 --StorageTypeList NAS --Name test_dataset",
  "cmd_full_name": "dataworks-public list-datasets",
  "cmd_name": "list-datasets",
  "components": {
    "schemas": {
      "Dataset": {
        "description_en": "The dataset object",
        "description_zh": "数据集对象",
        "properties": {
          "Comment": {
            "backendName": "comment",
            "description_en": "The description of the dataset. The length cannot exceed 1024 characters",
            "description_zh": "数据集描述，长度小于1024",
            "example": "测试数据集",
            "title": "数据集描述，长度小于1024",
            "type": "string"
          },
          "CreateTime": {
            "backendName": "createTime",
            "description_en": "The creation time. This value is a UNIX timestamp in milliseconds",
            "description_zh": "创建时间毫秒级时间戳",
            "example": "1736756055000",
            "format": "int64",
            "title": "创建时间毫秒级时间戳",
            "type": "integer"
          },
          "CreatorId": {
            "backendName": "creatorId",
            "description_en": "The ID of the creator",
            "description_zh": "创建者ID",
            "example": "210484359",
            "title": "创建者ID",
            "type": "string"
          },
          "DataType": {
            "backendName": "dataType",
            "description_en": "The data type. Valid values:\n\nCOMMON\nPIC\nTEXT\nTABLE\nVIDEO\nAUDIO\nINDEX",
            "description_zh": "数据类型，取值有\nCOMMON 通用\nPIC 图片\nTEXT 文本\nTABLE 表格\nVIDEO 视频\nAUDIO 音频\nINDEX 索引",
            "example": "COMMON",
            "title": "数据类型，取值有\n- COMMON 通用\n- PIC 图片\n- TEXT 文本\n- TABLE 表格\n- VIDEO 视频\n- AUDIO 音频\n- INDEX 索引",
            "type": "string"
          },
          "Id": {
            "backendName": "id",
            "description_en": "The dataset ID",
            "description_zh": "数据集ID",
            "example": "dataworks-dataset:1gxxxqjx155usz3hrv",
            "title": "数据集ID",
            "type": "string"
          },
          "Labels": {
            "backendName": "labels",
            "description_en": "Dataset tags. Supported only for PAI datasets",
            "description_zh": "数据集标签，目前仅PAI数据集支持",
