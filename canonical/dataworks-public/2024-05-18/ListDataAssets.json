{
  "camel_example": "aliyun dataworks-public ListDataAssets --region cn-hangzhou --PageSize 10 --PageNumber 1 --ProjectId 10000 --AssetDomainId 1001 --DataAssetIds '[\"7000069357000\"]' --DataAssetType 'ACS::DataWorks::Task' --CategoryUuid 'cate-xxxxxxxx' --Tags '[{\"Value\":\"value\",\"Key\":\"key\"}]' --EnvType Prod --Name '资产域名称'",
  "cmd_full_name": "dataworks-public list-data-assets",
