{
  "camel_example": "aliyun dataworks-public GetCalendar --region cn-hangzhou --Id 12345",
  "cmd_full_name": "dataworks-public get-calendar",
  "cmd_name": "get-calendar",
  "deprecated": false,
  "description_en": "Retrieves the current configuration of a specified scheduling calendar",
  "description_zh": "获取指定调度日历的当前配置",
  "kebab_example": "",
  "method": "POST",
  "multi_version": true,
  "name": "GetCalendar",
  "operation": {
    "action": "GetCalendar",
    "api_style": "RPC",
    "api_version": "2024-05-18",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "12345",
      "help_en": "The ID of the scheduling calendar",
      "help_zh": "调度日历的 ID",
      "location": "formData",
      "minimum": "1",
      "name": "id",
      "options": [
        "--id"
      ],
      "raw_name": "Id",
      "required": true,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "dataworks-public",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Calendar": {
            "backendName": "data",
            "description_en": "The current complete configuration of the scheduling calendar",
            "description_zh": "调度日历的当前完整配置",
            "properties": {
              "AllProjects": {
                "backendName": "allProjects",
                "description_en": "Specifies whether the calendar applies to all workspaces",
                "description_zh": "是否适用于全部工作空间",
                "example": "true",
                "title_en": "是否适用于全部项目空间",
                "title_zh": "是否适用于全部项目空间",
                "type": "boolean"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the scheduling calendar",
                "description_zh": "调度日历描述",
                "example": "工作日调度日历",
                "title_en": "日历描述",
                "title_zh": "日历描述",
                "type": "string"
              },
              "EndDate": {
                "backendName": "endDate",
                "description_en": "The end date of the calendar validity period, in the `yyyy-mm-dd` format. This parameter is returned only for strongly constrained calendars",
                "description_zh": "日历有效期的结束日期，格式为 `yyyy-mm-dd`。仅强约束日历返回",
                "example": "2026-10-09",
                "title_en": "有效期结束日期",
                "title_zh": "有效期结束日期",
                "type": "string"
              },
              "ExpirationReminder": {
                "backendName": "expirationReminder",
                "description_en": "The expiration reminder. This parameter is returned only for strongly constrained calendars. Valid values:\nOneMonthBefore: One month in advance.\nOneWeekBefore: One week in advance.\nThreeDaysBefore: Three days in advance",
                "description_zh": "到期提醒，仅强约束日历返回。\n\nOneMonthBefore：提前一个月。\nOneWeekBefore：提前一周。\nThreeDaysBefore：提前三天",
                "enum": [
                  "OneMonthBefore",
                  "OneWeekBefore",
                  "ThreeDaysBefore"
                ],
                "example": "OneMonthBefore",
                "title_en": "到期提醒",
                "title_zh": "到期提醒",
                "type": "string"
              },
              "FallbackPolicy": {
                "backendName": "fallbackPolicy",
                "description_en": "The default scheduling policy for dates that are not configured. This parameter is returned only for weakly constrained calendars. Valid values:\nNormal: Normal scheduling.\nPause: Pause scheduling.\nSkip: Dry run",
                "description_zh": "未设置日期的默认调度策略，仅弱约束日历返回。\n\nNormal：正常调度。\nPause：暂停调度。\nSkip：空跑",
                "enum": [
                  "Normal",
                  "Pause",
                  "Skip"
                ],
                "example": "Normal",
                "title_en": "弱约束默认策略",
                "title_zh": "弱约束默认策略",
                "type": "string"
              },
              "Id": {
                "backendName": "id",
                "description_en": "The ID of the scheduling calendar",
                "description_zh": "调度日历的 ID",
                "example": "12345",
                "format": "int64",
                "title_en": "调度日历的 ID。",
                "title_zh": "调度日历的 ID。",
                "type": "integer"
              },
              "ModifyTime": {
                "backendName": "modifyTime",
                "description_en": "The time when the calendar was modified. The value is a UNIX timestamp in milliseconds",
                "description_zh": "日历修改时间，单位为毫秒的Unix时间戳",
                "example": "1640000000000",
                "format": "int64",
                "title_en": "修改时间。",
                "title_zh": "修改时间。",
                "type": "integer"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the scheduling calendar",
                "description_zh": "调度日历名称",
                "example": "work_calendar",
                "title_en": "日历名称",
                "title_zh": "日历名称",
                "type": "string"
              },
              "OverduePolicy": {
                "backendName": "overduePolicy",
                "description_en": "The scheduling policy after the calendar expires. This parameter is returned only for strongly constrained calendars. Valid values:\nNormal: Normal scheduling.\nPause: Pause scheduling.\nSkip: Dry run",
                "description_zh": "日历超过有效期后的调度策略，仅强约束日历返回。\n\nNormal：正常调度。\nPause：暂停调度。\nSkip：空跑",
                "enum": [
                  "Normal",
                  "Pause",
                  "Skip"
                ],
                "example": "Skip",
                "title_en": "强约束超期策略",
                "title_zh": "强约束超期策略",
                "type": "string"
              },
              "Owner": {
                "backendName": "owner",
                "description_en": "The account ID of the owner",
                "description_zh": "责任人的账号 ID",
                "example": "123456789",
                "title_en": "责任人的账号 ID。",
                "title_zh": "责任人的账号 ID。",
                "type": "string"
              },
              "ProjectIds": {
                "backendName": "projectIds",
                "description_en": "The list of applicable workspace IDs. An empty array is returned if AllProjects is set to true",
                "description_zh": "适用的工作空间 ID 列表。AllProjects为true时返回空数组",
                "itemName": "ProjectId",
                "items": {
                  "description_en": "The workspace ID",
                  "description_zh": "工作空间 ID",
                  "example": "1000",
                  "format": "int64",
                  "title_en": "工作空间 ID。",
                  "title_zh": "工作空间 ID。",
                  "type": "integer"
                },
                "title_en": "适用的工作空间 ID 列表。",
                "title_zh": "适用的工作空间 ID 列表。",
                "type": "array"
              },
              "SchedulePolicy": {
                "backendName": "schedulePolicy",
                "description_en": "The date scheduling policy",
                "description_zh": "日期调度策略",
                "properties": {
                  "NormalDates": {
                    "backendName": "normalDates",
                    "description_en": "The list of normal scheduling dates",
                    "description_zh": "正常调度日期列表",
                    "itemName": "NormalDate",
                    "items": {
                      "description_en": "The normal scheduling date, in the `yyyy-mm-dd` format",
                      "description_zh": "正常调度日期，格式为 `yyyy-mm-dd`",
                      "example": "2026-10-08",
                      "title_en": "NormalDate",
                      "title_zh": "NormalDate",
                      "type": "string"
                    },
                    "title_en": "正常调度日期",
                    "title_zh": "正常调度日期",
                    "type": "array"
                  },
                  "SkipDates": {
                    "backendName": "skipDates",
                    "description_en": "The list of non-scheduling dates. Tasks perform dry runs on these dates",
                    "description_zh": "非调度日期列表，任务在这些日期空跑",
                    "itemName": "SkipDate",
                    "items": {
                      "description_en": "The non-scheduling date, in the `yyyy-mm-dd` format",
                      "description_zh": "非调度日期，格式为 `yyyy-mm-dd`",
                      "example": "2026-10-08",
                      "title_en": "SkipDate",
                      "title_zh": "SkipDate",
                      "type": "string"
                    },
                    "title_en": "非调度日期",
                    "title_zh": "非调度日期",
                    "type": "array"
                  }
                },
                "title_en": "日期调度策略",
                "title_zh": "日期调度策略",
                "type": "object"
              },
              "StartDate": {
                "backendName": "startDate",
                "description_en": "The start date of the calendar validity period, in the `yyyy-mm-dd` format. This parameter is returned only for strongly constrained calendars",
                "description_zh": "日历有效期的开始日期，格式为 `yyyy-mm-dd`。仅强约束日历返回",
                "example": "2026-10-08",
                "title_en": "有效期开始日期",
                "title_zh": "有效期开始日期",
                "type": "string"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The calendar type. Valid values:\nStrongConstraint: Strongly constrained calendar.\nWeakConstraint: Weakly constrained calendar",
                "description_zh": "日历类型。\n\nStrongConstraint：强约束日历。\nWeakConstraint：弱约束日历",
                "enum": [
                  "StrongConstraint",
                  "WeakConstraint"
                ],
                "example": "StrongConstraint",
                "title_en": "日历类型",
                "title_zh": "日历类型",
                "type": "string"
              },
              "Version": {
                "backendName": "version",
                "description_en": "The version number",
                "description_zh": "版本号",
                "example": "1",
                "format": "int32",
                "title_en": "版本号。",
                "title_zh": "版本号。",
                "type": "integer"
              }
            },
            "title_en": "日历详情",
            "title_zh": "日历详情",
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "6A6CBE87-9F91-1323-B680-E7A7065XXXXX",
            "title_en": "请求的 ID，用于定位日志，排查问题。",
            "title_zh": "请求的 ID，用于定位日志，排查问题。",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
