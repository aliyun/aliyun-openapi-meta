                    "title_en": "主实例RegionID",
                    "title_zh": "主实例RegionID",
                    "type": "string"
                  },
                  "ReplicationCreateTime": {
                    "backendName": "replicationCreateTime",
                    "example": "1778499337000",
                    "format": "int64",
                    "title_en": "灾备数据复制创建时间，Unix时间戳格式，单位为毫秒",
                    "title_zh": "灾备数据复制创建时间，Unix时间戳格式，单位为毫秒",
                    "type": "integer"
