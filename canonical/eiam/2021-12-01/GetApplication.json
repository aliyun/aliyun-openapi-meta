  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Application": {
            "backendName": "data",
            "description_en": "The returned application information",
            "description_zh": "返回的应用信息",
            "properties": {
              "ApiInvokeStatus": {
                "backendName": "apiInvokeStatus",
                "description_en": "The status of the Developer API feature for the application. Valid values:\nenabled: Enabled.\ndisabled: Disabled",
                "description_zh": "应用DeveloperAPI功能状态，取值可选范围：\nenabled：启用中。\ndisabled：禁用中",
