                  "type": "string"
                },
                "type": "array"
              },
              "AuthorizationType": {
                "backendName": "authorizationType",
                "description_en": "The access authorization type of the application. Valid values:\nauthorize_required: Explicit authorization is required for access.\ndefault_all: All members have access permissions by default",
                "description_zh": "应用访问授权类型，取值可选范围：\nauthorize_required：需要显式授权才可访问。\ndefault_all：默认所有成员具备访问权限",
                "example": "authorize_required",
                "title_en": "应用授权类型",
                "title_zh": "应用授权类型",
                "type": "string"
              },
              "ClientId": {
                "backendName": "clientId",
                "description_en": "The client ID of the application",
                "description_zh": "应用的客户端ID",
                "example": "app_mkv7rgt4d7i4u7zqtzev2mxxxx",
                "title_en": "客户端ID",
                "title_zh": "客户端ID",
                "type": "string"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The time when the application was created. The value is a UNIX timestamp in milliseconds",
                "description_zh": "应用创建时间，Unix时间戳格式，单位为毫秒",
                "example": "1649830226000",
                "format": "int64",
                "title_en": "应用创建时间",
                "title_zh": "应用创建时间",
                "type": "integer"
              },
              "CustomFields": {
                "backendName": "customFields",
                "itemName": "CustomField",
                "items": {
                  "properties": {
                    "FieldName": {
                      "backendName": "fieldName",
                      "type": "string"
                    },
                    "FieldValue": {
                      "backendName": "fieldValue",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "CustomSubjectStatus": {
                "backendName": "customSubjectStatus",
                "description_en": "Indicates whether the custom Subject field in the token is enabled. After this feature is enabled, the issued Access Token changes from \\<clientId> to \\<clientId>:\\<client.activeSubjectUrn>, where client.activeSubjectUrn is configured in the attribute mapping of the federated identity credential of the application",
                "description_zh": "是否开启自定义Token中的Subject字段。开启该能力后，签发的 Access Token 将从<clientld> 变成 <clientld>:<client.activeSubjectUrn>，其中 client.activeSubjectUrn 在应用的联邦凭证的属性映射中设置",
                "example": "enabled",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The application description",
                "description_zh": "应用描述信息",
                "example": "An application for test environment",
                "title_en": "应用描述信息",
                "title_zh": "应用描述信息",
                "type": "string"
              },
              "Features": {
                "backendName": "features",
                "description_en": "The features supported by the application, returned as a JSON array string. Valid values:\nsso: Single sign-on.\nprovision: Account synchronization.\napi_invoke: API access",
                "description_zh": "应用支持的功能特性，JSON数组格式字符串返回。取值可选范围：\nsso：单点登录。\nprovision：账户同步。\napi_invoke：API开放。 ",
                "example": "[\"sso\", \"provision\"]",
                "title_en": "应用支持的特性",
                "title_zh": "应用支持的特性",
                "type": "string"
              },
              "InstanceId": {
                "backendName": "instanceId",
                "description_en": "The instance ID",
                "description_zh": "实例ID",
                "example": "idaas_ue2jvisn35ea5lmthk267xxxxx",
                "title_en": "IDaaS EIAM实例Id",
                "title_zh": "IDaaS EIAM实例Id",
                "type": "string"
              },
              "LogoUrl": {
                "backendName": "logoUrl",
                "description_en": "The URL of the application logo",
                "description_zh": "应用图标URL地址",
                "example": "https://img.alicdn.com/imgextra/i4/O1CN01lvYwpv1aGowQXDML9_!!6000000003303-0-tps-580-580.jpg",
                "title_en": "应用图标URL地址",
                "title_zh": "应用图标URL地址",
                "type": "string"
              },
              "M2MClientStatus": {
                "backendName": "m2MClientStatus",
                "description_en": "The M2MClient status",
                "description_zh": "M2MClient状态",
                "example": "enabled",
                "title_en": "M2MClient状态",
                "title_zh": "M2MClient状态",
                "type": "string"
              },
              "ManagedServiceCode": {
                "backendName": "managedServiceCode",
                "description_en": "The ServiceCode of the cloud service that manages the application template",
                "description_zh": "托管应用模板的云产品ServiceCode",
                "example": "rpa",
                "title_en": "托管应用模板的云产品ServiceCode",
                "title_zh": "托管应用模板的云产品ServiceCode",
                "type": "string"
              },
              "ResourceServerIdentifier": {
                "backendName": "resourceServerIdentifier",
                "description_en": "The unique identifier of the ResourceServer, which corresponds to the ResourceServer audience",
                "description_zh": "ResourceServer唯一标识，对应ResourceServer受众",
                "example": "https://www.example.com",
                "title_en": "ResourceServer唯一标识，对应ResourceServer受众",
                "title_zh": "ResourceServer唯一标识，对应ResourceServer受众",
                "type": "string"
              },
              "ResourceServerSourceType": {
                "backendName": "resourceServerSourceType",
                "description_en": "The resource server source type",
                "description_zh": "资源服务器来源类型",
                "enum": [
                  "urn:cloud:idaas:resourceserver:source:custom",
                  "urn:cloud:idaas:resourceserver:source:system"
                ],
                "example": "urn:cloud:idaas:resourceserver:source:custom",
                "title_en": "资源服务器来源类型",
                "title_zh": "资源服务器来源类型",
                "type": "string"
              },
              "ResourceServerStatus": {
                "backendName": "resourceServerStatus",
                "description_en": "The ResourceServer status",
                "description_zh": "ResourceServer状态",
                "example": "enabled",
                "title_en": "ResourceServer状态",
                "title_zh": "ResourceServer状态",
                "type": "string"
              },
              "ServiceManaged": {
                "backendName": "serviceManaged",
                "description_en": "Indicates whether the application template is managed by a cloud service",
                "description_zh": "应用模板是否被云产品托管",
                "example": "true",
                "title_en": "应用模板是否被云产品托管",
                "title_zh": "应用模板是否被云产品托管",
                "type": "boolean"
              },
              "SmartConfigCapabilities": {
                "backendName": "smartConfigCapabilities",
                "itemName": "smartConfigCapabilities",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "SsoType": {
                "backendName": "ssoType",
                "description_en": "The single sign-on protocol. Valid values:\nsaml2: SAML 2.0 protocol.\noidc: OpenID Connect protocol.\noauth2/m2m: OAuth 2.0 protocol.\noidc+oauth2/m2m: OpenID Connect and OAuth 2.0 protocols",
                "description_zh": "单点登录协议，可选范围：\nsaml2：SAML 2.0 协议。\noidc：OpenID Connect 协议。\noauth2/m2m：OAuth2.0协议。\noidc+oauth2/m2m：OpenID Connect和OAuth2.0协议",
                "example": "saml2",
                "title_en": "应用支持的SSO协议",
                "title_zh": "应用支持的SSO协议",
                "type": "string"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The application status. Valid values:\nenabled: Enabled.\ndisabled: Disabled",
                "description_zh": "应用状态，取值可选范围：\nenabled：启用中。\ndisabled：禁用中",
                "example": "enabled",
                "title_en": "应用状态",
                "title_zh": "应用状态",
                "type": "string"
              },
              "UpdateTime": {
                "backendName": "updateTime",
                "description_en": "The time when the application was last updated. The value is a UNIX timestamp in milliseconds",
                "description_zh": "应用最近更新时间，Unix时间戳格式，单位为毫秒",
                "example": "1649830226000",
                "format": "int64",
                "title_en": "应用最近更新时间",
                "title_zh": "应用最近更新时间",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "0441BD79-92F3-53AA-8657-F8CE4A2B912A",
            "title_en": "请求Id",
            "title_zh": "请求Id",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
