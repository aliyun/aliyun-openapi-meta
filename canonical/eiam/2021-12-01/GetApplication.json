                "title_en": "应用apiInvoke能力启用状态",
                "title_zh": "应用apiInvoke能力启用状态",
                "type": "string"
              },
              "ApplicationCreationType": {
                "backendName": "applicationCreationType",
                "description_en": "The application creation type",
                "description_zh": "应用创建类型",
                "enum": [
                  "user_custom",
                  "system_init"
                ],
                "example": "user_custom",
                "title_en": "应用创建类型。",
                "title_zh": "应用创建类型。",
                "type": "string"
              },
              "ApplicationId": {
                "backendName": "applicationId",
                "description_en": "The application ID",
                "description_zh": "应用ID",
                "example": "app_mkv7rgt4d7i4u7zqtzev2mxxxx",
                "title_en": "应用Id",
                "title_zh": "应用Id",
                "type": "string"
              },
              "ApplicationIdentityType": {
                "backendName": "applicationIdentityType",
                "description_en": "The application identity type. Valid values:\napplication: Application.\nagent: Agent",
                "description_zh": "应用身份类型，取值可选范围：\napplication：应用程序。\nagent：智能体",
                "example": "application",
                "type": "string"
              },
              "ApplicationName": {
                "backendName": "applicationName",
                "description_en": "The application name",
                "description_zh": "应用名称",
                "example": "SAML application",
                "title_en": "应用名称",
                "title_zh": "应用名称",
                "type": "string"
              },
              "ApplicationOwner": {
                "backendName": "applicationOwner",
                "properties": {
                  "GroupIds": {
                    "backendName": "groupIds",
                    "itemName": "GroupId",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "UserIds": {
                    "backendName": "userIds",
                    "itemName": "UserId",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              "ApplicationSourceType": {
                "backendName": "applicationSourceType",
