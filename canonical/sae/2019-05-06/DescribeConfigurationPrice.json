  "deprecated": false,
  "description_en": "Queries the price of a configuration",
  "description_zh": "查询configurationprice",
  "kebab_example": "aliyun sae describe-configuration-price --cpu 2000 --memory 4096 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
