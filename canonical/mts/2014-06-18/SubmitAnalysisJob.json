{
  "camel_example": "aliyun mts SubmitAnalysisJob --region cn-hangzhou --Input 'Bucket_:_example-bucket_,_Location_:_oss-cn-hangzhou_,_Object_:_example.flv' --PipelineId bb558c1cc25b45309aab5be44d190000",
  "cmd_full_name": "mts submit-analysis-job",
  "cmd_name": "submit-analysis-job",
  "deprecated": false,
  "description_en": "Submits a preset template analysis job",
  "description_zh": "提交预置模板分析作业",
  "kebab_example": "aliyun mts submit-analysis-job --input Bucket_:_example-bucket_,_Location_:_oss-cn-hangzhou_,_Object_:_example.flv --pipeline-id bb558c1cc25b45309aab5be44d190000 --api-version 2014-06-18 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "SubmitAnalysisJob",
  "operation": {
    "action": "SubmitAnalysisJob",
    "api_style": "RPC",
    "api_version": "2014-06-18",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "{\"Bucket\":\"example-bucket\",\"Location\":\"oss-cn-hangzhou\",\"Object\":\"example.flv\"}",
      "help_en": "The input information about the preset template analysis job to be submitted. The value must be a JSON object. You must log on to the Object Storage Service (OSS) console to grant the read permissions on the specified OSS bucket to MPS. For more information, see the \"Input\" section of the https://help.aliyun.com/document_detail/29253.html topic.\n\nThe OSS bucket must reside in the same region as your MPS service",
      "help_zh": "作业输入，JSON对象。需在OSS控制台Bucket授权页面将Bucket读权限授权给媒体转码服务。更多信息请参见https://help.aliyun.com/document_detail/29253.html。\n\nOSS的地域需要与当前MPS所在地域保持一致",
      "location": "query",
      "name": "input",
      "options": [
        "--input"
      ],
      "raw_name": "Input",
      "required": true,
      "type": "string"
    },
    {
      "example": "{\"QualityControl\":{\"RateQuality\":25,\"MethodStreaming\":\"network\"}}",
      "help_en": "The job configurations. Set this parameter as required. For more information, see the \"AnalysisConfig\" section of the https://help.aliyun.com/document_detail/29253.html topic",
      "help_zh": "模板分析作业配置，根据您的实际需要按需设置。更多参数信息请参见https://help.aliyun.com/document_detail/29253.html",
      "location": "query",
      "name": "analysis_config",
      "options": [
        "--analysis-config"
      ],
      "raw_name": "AnalysisConfig",
      "required": false,
      "type": "string"
    },
    {
      "example": "testid-001",
      "help_en": "The custom data. The custom data can contain letters, digits, and hyphens (-), and can be up to 1,024 bytes in length. The custom data cannot start with a special character",
      "help_zh": "用户自定义数据，可以使用中英文、数字、中划线（-）等，不能以特殊字符开头，最大长度1024个字节",
      "location": "query",
      "name": "user_data",
      "options": [
        "--user-data"
      ],
      "raw_name": "UserData",
      "required": false,
      "type": "string"
    },
    {
      "example": "bb558c1cc25b45309aab5be44d19****",
      "help_en": "The ID of the MPS queue to which the job is submitted. To view the ID of the MPS queue, log on to the MPS console and choose Global Settings > Pipelines in the left-side navigation pane. If you want to enable asynchronous notifications, make sure that the MPS queue is bound to a Message Service (MNS) topic",
      "help_zh": "管道ID，可以通过MPS控制台>全局设置>管道查看。如果需要异步通知，须保证此管道绑定了可用的消息主题",
      "location": "query",
      "name": "pipeline_id",
      "options": [
        "--pipeline-id"
      ],
      "raw_name": "PipelineId",
      "required": true,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The priority of the job in the MPS queue to which the job is submitted.\n\nValid values: 1 to 10. A value of 10 indicates the highest priority.\nDefault value: 6",
      "help_zh": "任务在其对应管道内的转码优先级。\n\n取值范围：[1,10]，10为最高优先级。\n默认值：6",
      "location": "query",
      "name": "priority",
      "options": [
        "--priority"
      ],
      "raw_name": "Priority",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Mts",
