                "description_zh": "作业配置",
                "nullToEmpty": false,
                "properties": {
                  "PropertiesControl": {
                    "backendName": "propertiesControl",
                    "description_en": "The control on the attributes of the job output",
                    "description_zh": "属性控制",
                    "nullToEmpty": false,
                    "properties": {
                      "Crop": {
                        "backendName": "crop",
                        "description_en": "The cropping configurations of video images",
                        "description_zh": "视频裁切配置",
                        "nullToEmpty": false,
                        "properties": {
                          "Height": {
                            "backendName": "height",
                            "description_en": "The height of the video after the margins were cropped out.\n\nThis parameter is invalid if the Mode parameter is set to Auto or None",
                            "description_zh": "裁切后高。\n\n若Mode为Auto或None，则此值失效",
                            "example": "8",
                            "type": "string"
                          },
                          "Left": {
                            "backendName": "left",
                            "description_en": "The left margin that was cropped out.\n\nThis parameter is invalid if the Mode parameter is set to Auto or None",
                            "description_zh": "裁切左边距。\n\n若Mode为Auto或None，则此值失效",
                            "example": "8",
                            "type": "string"
                          },
                          "Mode": {
                            "backendName": "mode",
                            "description_en": "The cropping mode. Valid values:\n\nAuto: Cropping was automatically run. This is the default value.\nForce: Cropping was forced to run.\nNone: Cropping was forced not to run",
                            "description_zh": "裁切方式。取值：\n\nAuto：自动（默认）。\nForce：强制。\nNone：强制不做",
                            "example": "Auto",
                            "type": "string"
                          },
                          "Top": {
                            "backendName": "top",
                            "description_en": "The top margin that was cropped out.\n\nThis parameter is invalid if the Mode parameter is set to Auto or None",
                            "description_zh": "裁切上边距。\n\n若Mode为Auto或None，则此值失效",
                            "example": "8",
                            "type": "string"
                          },
                          "Width": {
                            "backendName": "width",
                            "description_en": "The width of the video after the margins were cropped out.\n\nThis parameter is invalid if the Mode parameter is set to Auto or None",
                            "description_zh": "裁切后宽。\n\n若Mode为Auto或None，则此值失效",
                            "example": "8",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "Deinterlace": {
                        "backendName": "deinterlace",
                        "description_en": "Indicates whether deinterlacing was forced to run. Valid values:\n\nAuto: Deinterlacing was automatically run.\nForce: Deinterlacing was forced to run.\nNone: Deinterlacing was forced not to run",
                        "description_zh": "强制扫描模式判定。\n\nAuto：自动。\nForce：强制做deinterlace。\nNone：强制不做deinterlace",
                        "example": "Force",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "QualityControl": {
                    "backendName": "qualityControl",
                    "description_en": "The quality control on the job output",
                    "description_zh": "输出质量控制",
                    "nullToEmpty": false,
                    "properties": {
                      "MethodStreaming": {
                        "backendName": "methodStreaming",
                        "description_en": "The playback mode. Valid values:\n\nnetwork: online playback\nlocal: playback on local devices\nDefault value: network",
                        "description_zh": "播放方式。\n\nnetwork：在线。\n\nlocal：本地。\n\n默认值：network",
                        "example": "network",
                        "type": "string"
                      },
                      "RateQuality": {
                        "backendName": "rateQuality",
                        "description_en": "The quality level of the output file",
                        "description_zh": "输出质量等级",
                        "example": "50",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "Code": {
                "backendName": "code",
                "description_en": "The error code returned if the job failed. This parameter is not returned if the job was successful",
                "description_zh": "分析失败时错误码。分析成功时不返回此参数",
                "example": "InvalidParameter.ResourceNotFound",
                "type": "string"
              },
              "CreationTime": {
                "backendName": "creationTime",
