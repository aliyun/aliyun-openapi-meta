{
  "camel_example": "aliyun mts SubmitAnalysisJob --region cn-hangzhou --Input 'Bucket_:_example-bucket_,_Location_:_oss-cn-hangzhou_,_Object_:_example.flv' --PipelineId bb558c1cc25b45309aab5be44d190000",
  "cmd_full_name": "mts submit-analysis-job",
  "cmd_name": "submit-analysis-job",
  "deprecated": false,
  "description_en": "Submits a preset template analysis job",
  "description_zh": "提交预置模板分析作业",
  "kebab_example": "aliyun mts submit-analysis-job --input Bucket_:_example-bucket_,_Location_:_oss-cn-hangzhou_,_Object_:_example.flv --pipeline-id bb558c1cc25b45309aab5be44d190000 --api-version 2014-06-18 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "SubmitAnalysisJob",
  "operation": {
    "action": "SubmitAnalysisJob",
    "api_style": "RPC",
    "api_version": "2014-06-18",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "{\"Bucket\":\"example-bucket\",\"Location\":\"oss-cn-hangzhou\",\"Object\":\"example.flv\"}",
      "help_en": "The job input, which is a JSON object. You must grant the read permissions on the bucket to ApsaraVideo Media Processing on the bucket authorization page in the OSS console. For more information, see https://help.aliyun.com/document_detail/29253.html.\n\nThe region of the OSS bucket must be the same as the region of MPS",
      "help_zh": "作业输入，JSON对象。需在OSS控制台Bucket授权页面将Bucket读权限授权给媒体转码服务。更多信息请参见https://help.aliyun.com/document_detail/29253.html。\n\nOSS的地域需要与当前MPS所在地域保持一致",
      "location": "query",
      "name": "input",
      "options": [
        "--input"
      ],
      "raw_name": "Input",
      "required": true,
      "type": "string"
    },
    {
      "example": "{\"QualityControl\":{\"RateQuality\":25,\"MethodStreaming\":\"network\"}}",
      "help_en": "The configuration of the template analysis job. Set the parameters as needed. For more information, see https://help.aliyun.com/document_detail/29253.html",
      "help_zh": "模板分析作业配置，根据您的实际需要按需设置。更多参数信息请参见https://help.aliyun.com/document_detail/29253.html",
      "location": "query",
      "name": "analysis_config",
      "options": [
        "--analysis-config"
      ],
      "raw_name": "AnalysisConfig",
      "required": false,
      "type": "string"
    },
    {
      "example": "testid-001",
      "help_en": "The custom user data. It can contain Chinese and English characters, digits, and hyphens (-). It cannot start with a special character. The maximum length is 1,024 bytes",
      "help_zh": "用户自定义数据，可以使用中英文、数字、中划线（-）等，不能以特殊字符开头，最大长度1024个字节",
      "location": "query",
      "name": "user_data",
      "options": [
        "--user-data"
      ],
      "raw_name": "UserData",
      "required": false,
      "type": "string"
    },
    {
      "example": "bb558c1cc25b45309aab5be44d19****",
      "help_en": "The ID of the MPS queue. You can view the ID by choosing MPS Console > Global Settings > Pipelines. If asynchronous notification is required, make sure that an available message topic is bound to this MPS queue",
      "help_zh": "管道ID，可以通过MPS控制台>全局设置>管道查看。如果需要异步通知，须保证此管道绑定了可用的消息主题",
      "location": "query",
      "name": "pipeline_id",
      "options": [
        "--pipeline-id"
      ],
      "raw_name": "PipelineId",
      "required": true,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The transcoding priority of the job in its corresponding MPS queue.\n\nValid values: [1,10]. A value of 10 indicates the highest priority.\nDefault value: 6",
      "help_zh": "任务在其对应管道内的转码优先级。\n\n取值范围：[1,10]，10为最高优先级。\n默认值：6",
      "location": "query",
      "name": "priority",
      "options": [
        "--priority"
      ],
      "raw_name": "Priority",
      "required": false,
      "type": "string"
    }
