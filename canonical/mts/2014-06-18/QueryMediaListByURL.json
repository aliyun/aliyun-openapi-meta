  "parameters": [
    {
      "example": "http://example-bucket-****.oss-cn-shanghai.aliyuncs.com/example.mp4",
      "help_en": "The URLs of the media files that you want to query. To obtain the URL of a media file, log on to the MPS console, choose Media Management > Media List, find the media file, and then click Manage in the Actions column. On the Get Transcoding URL tab, you can obtain the URL of the media file. Separate multiple URLs with commas (,). You can query a maximum of 10 URLs at a time.\n\nThe URL must be compliant with RFC 3986. The URL must be encoded in UTF-8, and reserved characters must be URL-encoded. For more information, see https://help.aliyun.com/document_detail/423796.html. The URL can be up to 3,200 bytes in length.\n\nOnly OSS HTTP URLs are supported. CDN and HTTPS URLs are not supported",
      "help_zh": "需要查询的媒体文件地址，可以登录MPS控制台，通过媒体管理 > 媒体列表找到需要查询的媒体文件，单击操作列管理，在获取转码地址页签中获取媒体文件地址。用半角逗号（,）分隔，一次最多查询10个。\nURL遵循RFC 3986（UTF8编码，并对保留字符进行URLEncode。更多信息，请参见https://help.aliyun.com/document_detail/423796.html），不超过3200字节。\n\n仅支持OSS HTTP地址，不支持CDN地址和HTTPS地址",
      "location": "query",
      "name": "file_urls",
      "options": [
        "--file-urls"
      ],
      "raw_name": "FileURLs",
      "required": true,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to include playback information in the response.\n\nValid values: true and false.\n\nDefault value: false",
      "help_zh": "返回结果中是否包含播放信息。\n\n取值范围：true（包含）、false（不包含）。\n\n默认值：false",
