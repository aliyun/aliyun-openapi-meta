{
  "camel_example": "aliyun mts QueryMediaListByURL --region cn-hangzhou --FileURLs 'http://example-bucket-0000.oss-cn-shanghai.aliyuncs.com/example.mp4'",
  "cmd_full_name": "mts query-media-list-by-url",
  "cmd_name": "query-media-list-by-url",
  "deprecated": false,
  "description_en": "Queries media files by their Object Storage Service (OSS) file URLs",
  "description_zh": "使用OSS文件地址查询媒体",
  "kebab_example": "aliyun mts query-media-list-by-url --file-urls http://example-bucket-0000.oss-cn-shanghai.aliyuncs.com/example.mp4 --api-version 2014-06-18 --region cn-hangzhou",
  "method": "GET|POST",
