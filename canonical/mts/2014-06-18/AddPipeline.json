{
  "camel_example": "aliyun mts AddPipeline --region cn-hangzhou --Name 'test-pipeline'",
  "cmd_full_name": "mts add-pipeline",
  "cmd_name": "add-pipeline",
  "deprecated": false,
  "description_en": "Adds an ApsaraVideo Media Processing (MPS) queue",
  "description_zh": "新增一个管道",
  "kebab_example": "aliyun mts add-pipeline --name test-pipeline --api-version 2014-06-18 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "AddPipeline",
  "operation": {
    "action": "AddPipeline",
    "api_style": "RPC",
    "api_version": "2014-06-18",
    "method": "POST",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "test-pipeline",
      "help_en": "The name of the MPS queue. The name can be up to 128 bytes in size",
      "help_zh": "管道名称，最大长度128字节",
      "location": "query",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": true,
      "type": "string"
    },
    {
      "example": "Standard",
      "help_en": "The type of the MPS queue. Valid values:\n\nBoost: MPS queue with transcoding speed boosted.\n\nStandard: standard MPS queue.\n\nNarrowBandHDV2: MPS queue that supports Narrowband HD 2.0.\n\nAIVideoCover: MPS queue for intelligent snapshot capture.\n\nAIVideoTag: MPS queue for video tagging. The supported regions are China (Shanghai), China (Beijing), and China (Hangzhou).\n\nDefault value: Standard",
      "help_zh": "管道类型。\n取值：\n\nBoost：倍速转码\nStandard：普通管道\nNarrowBandHDV2：窄带高清2.0\nAIVideoCover：智能截图\nAIVideoTag：视频标签（支持区域上海、北京、杭州）\n\n\n默认值：Standard",
      "location": "query",
      "name": "speed",
      "options": [
        "--speed"
      ],
      "raw_name": "Speed",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The level of the MPS queue. Valid values: 1 to 3",
      "help_zh": "管道级别，取值范围：[1,3]",
      "location": "query",
      "name": "speed_level",
      "options": [
        "--speed-level"
      ],
      "raw_name": "SpeedLevel",
      "required": false,
      "type": "int"
    },
    {
      "example": "{\"Topic\":\"mts-topic-1\"}",
      "help_en": "The Message Service (MNS) configuration",
      "help_zh": "MNS通知配置",
      "location": "query",
      "name": "notify_config",
      "options": [
        "--notify-config"
      ],
      "raw_name": "NotifyConfig",
      "required": false,
      "type": "string"
    },
    {
      "example": "AliyunMTSDefaultRole",
      "help_en": "The role",
      "help_zh": "角色",
      "location": "query",
      "name": "role",
      "options": [
        "--role"
      ],
      "raw_name": "Role",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Mts",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回参数",
        "properties": {
          "Pipeline": {
            "backendName": "data.pipeline",
            "description_en": "The MPS queue",
            "description_zh": "管道",
            "properties": {
              "Id": {
                "backendName": "id",
                "description_en": "The ID of the MPS queue",
                "description_zh": "管道ID",
                "example": "ed450ea0bfbd41e29f80a401fb4d****",
                "mappingResourcePropertyName": "$.PipelineId",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the MPS queue",
                "description_zh": "管道名称",
                "example": "Video DNA",
                "mappingResourcePropertyName": "$.PipelineName",
                "type": "string"
              },
              "NotifyConfig": {
                "backendName": "notifyConfig",
                "description_en": "The MNS configuration",
                "description_zh": "MNS通知配置",
                "nullToEmpty": false,
                "properties": {
                  "MqTag": {
                    "backendName": "mqTag",
                    "description_en": "The tag string",
                    "description_zh": "消息队列mq标签",
                    "example": "mts-test",
                    "mappingResourcePropertyName": "$.NotifyConfig.MqTag",
                    "type": "string"
                  },
                  "MqTopic": {
                    "backendName": "mqTopic",
                    "description_en": "The queue of messages that are received",
                    "description_zh": "消息队列topic",
                    "example": "example1",
                    "mappingResourcePropertyName": "$.NotifyConfig.MqTopic",
                    "type": "string"
                  },
                  "QueueName": {
                    "backendName": "queueName",
                    "description_en": "The name of the queue",
                    "description_zh": "队列名称",
                    "example": "mts-queue-1",
                    "mappingResourcePropertyName": "$.NotifyConfig.QueueName",
                    "type": "string"
                  },
                  "Topic": {
                    "backendName": "topic",
                    "description_en": "The name of the topic",
                    "description_zh": "主题名称",
                    "example": "mts-topic-1",
                    "mappingResourcePropertyName": "$.NotifyConfig.Topic",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "QuotaAllocate": {
                "backendName": "quotaAllocate",
                "description_en": "The quota that is allocated to the MPS queue",
                "description_zh": "管道配额分配",
                "example": "10",
                "format": "int64",
                "mappingResourcePropertyName": "$.QuotaAllocate",
                "type": "integer"
              },
              "Role": {
                "backendName": "role",
                "description_en": "The role",
                "description_zh": "角色",
                "example": "AliyunMTSDefaultRole",
                "mappingResourcePropertyName": "$.Role",
                "type": "string"
              },
              "Speed": {
                "backendName": "speed",
                "description_en": "The type of the MPS queue",
                "description_zh": "管道类型",
                "example": "Standard",
                "mappingResourcePropertyName": "$.Speed",
                "type": "string"
              },
              "SpeedLevel": {
                "backendName": "speedLevel",
                "description_en": "The level of the MPS queue",
                "description_zh": "管道级别",
                "example": "1",
                "format": "int64",
                "mappingResourcePropertyName": "$.SpeedLevel",
                "type": "integer"
              },
              "State": {
                "backendName": "status",
                "description_en": "The state of the MPS queue.\n\nActive: The MPS queue is active. The jobs in the MPS queue are scheduled and transcoded by MPS.\n\nPaused: The MPS queue is paused. Jobs in the MPS queue are no longer scheduled for transcoding by MPS. All of the jobs in the MPS queue remain in the Submitted state. Jobs that are being transcoded are not affected",
                "description_zh": "管道状态。\n\nActive：表示管道内的作业会被媒体转码服务调度转码执行。\nPaused：表示管道暂停，作业不再会被媒体转码调度转码执行，管道内的所有作业状态维持在已提交状态，已经处于转码中的任务将继续转码，不受影响",
                "example": "Active",
                "mappingResourcePropertyName": "$.Status",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "CFEA608A-5A1C-4C83-A54B-6197BC250D23",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
