{
  "cmd_full_name": "aiccs get-call-dialog-content",
  "cmd_name": "get-call-dialog-content",
  "deprecated": false,
  "description_en": "Retrieves the dialog content for a call by using its call ID. You can retrieve content for calls completed within the last 30 days",
  "description_zh": "通过CallId查询对话内容，只支持查询近一个月通话已结束的通话对话内容",
  "kebab_example": "aliyun aiccs get-call-dialog-content --call-date 2025-06-06 --call-id '123456^123478' --api-version 2019-10-15 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetCallDialogContent",
  "operation": {
    "action": "GetCallDialogContent",
    "api_style": "RPC",
    "api_version": "2019-10-15",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": ""
  },
  "parameters": [
    {
      "example": "2025-06-06",
      "help_en": "The outbound call date, in yyyy-MM-dd format. You can only query data from the last 30 days",
      "help_zh": "外呼日期，只可查询最近30天的日期，格式：yyyy-MM-dd",
      "location": "query",
      "name": "call_date",
      "options": [
        "--call-date"
      ],
      "raw_name": "CallDate",
      "required": true,
      "type": "string"
    },
    {
      "example": "123456^123478",
      "help_en": "The unique identifier for a call.\n\nThe LlmSmartCall API returns this ID in the CallId parameter of its response",
      "help_zh": "呼叫记录ID，用于标识一条通话记录。\n\n在调用大模型外呼接口LlmSmartCall是，会返回此呼叫记录ID，即CallId",
      "location": "query",
      "name": "call_id",
      "options": [
        "--call-id"
      ],
      "raw_name": "CallId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "aiccs",
  "protocol": "HTTPS",
  "responses": {
