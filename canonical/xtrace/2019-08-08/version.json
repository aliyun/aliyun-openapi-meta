{
  "apis": {
    "CheckCommercialStatus": {
      "cmd_name": "check-commercial-status",
      "deprecated": false,
      "description_en": "Checks the commercialization status",
      "description_zh": "检查商业化状态"
    },
    "GetTagKey": {
      "cmd_name": "get-tag-key",
      "deprecated": false,
      "description_en": "Calls the GetTagKey operation to retrieve tag keys",
      "description_zh": "调用GetTagKey接口获取标签键"
    },
    "GetTagVal": {
      "cmd_name": "get-tag-val",
      "deprecated": false,
      "description_en": "Retrieves the tag values that correspond to a specified tag key from the reported trace data",
      "description_zh": "获取上报的链路数据中指定Tag Key对应的Tag Value"
    },
    "GetTrace": {
      "cmd_name": "get-trace",
      "deprecated": false,
      "description_en": "Retrieves the details of a trace",
      "description_zh": "调用GetTrace接口获取调用链路详情"
    },
    "ListIpOrHosts": {
      "cmd_name": "list-ip-or-hosts",
      "deprecated": false,
      "description_en": "Retrieves IP addresses or machine names from tracing data. You can retrieve all IP addresses in an entire region or for a specific application",
      "description_zh": "获取链路数据中的IP地址或者机器名称，可获取整个地域或某个应用下的所有IP地址"
    },
    "ListServices": {
      "cmd_name": "list-services",
      "deprecated": false,
      "description_en": "Queries the list of applications by calling ListServices",
      "description_zh": "调用ListServices获取应用列表"
    },
    "ListSpanNames": {
      "cmd_name": "list-span-names",
      "deprecated": false,
      "description_en": "Retrieves all span names in a specified region, or retrieves all span names of a specific microservice",
      "description_zh": "获取指定地域下所有的Span名称，也可获取某个微服务的所有Span名称"
    },
    "OpenXtraceService": {
      "cmd_name": "open-xtrace-service",
      "deprecated": false,
      "description_en": "Activates Managed Service for OpenTelemetry",
      "description_zh": "开通可观测链路 OpenTelemetry 版"
    },
    "QueryMetric": {
      "cmd_name": "query-metric",
      "deprecated": false,
      "description_en": "Queries monitoring metrics by calling QueryMetric",
      "description_zh": "调用QueryMetric查询相关监控指标"
    },
    "SearchTraces": {
      "cmd_name": "search-traces",
      "deprecated": false,
      "description_en": "Queries a list of traces. You can filter traces by time, application name, IP address, span name, tag, and other information",
      "description_zh": "调用SearchTraces查询调用链列表，可根据时间、应用名称、IP地址、Span名称、Tag等信息对调用链进行过滤查询"
    }
  },
