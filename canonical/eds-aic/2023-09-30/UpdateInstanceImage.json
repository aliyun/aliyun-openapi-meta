  "camel_example": "aliyun eds-aic UpdateInstanceImage --region cn-hangzhou --IgnoreParamValidation true --ImageId 'imgc-075cllfeuazh0****' --Reset false --InstanceIdList.1 'acp-dvbhknfasf123****' --version 2023-09-30 --method POST --force",
