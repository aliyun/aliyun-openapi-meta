          "cdcYamlArtifact": {
            "$ref": "#/components/schemas/CdcYamlArtifact",
            "backendName": "cdcYamlArtifact",
            "description_en": "Required for a data ingestion job",
            "description_zh": "数据摄入作业",
            "title": "数据摄入作业"
          },
          "jarArtifact": {
            "$ref": "#/components/schemas/JarArtifact",
            "backendName": "jarArtifact",
            "description_en": "Required for a JAR job",
            "description_zh": "JAR作业必填信息",
            "title": "Jar作业"
          },
          "kind": {
            "backendName": "kind",
            "description_en": "Specifies the kind of job. This field is required and cannot be changed after creation.\n\nSQLSCRIPT: An SQL job.\n\nJAR: A JAR job.\n\nPYTHON: A Python job.\n\nCDCYAML: A CDC data ingestion job",
            "description_zh": "生效作业类型，必填，创建后无法修改。\nSQLSCRIPT：SQL作业。\nJAR：JAR作业。\nPYTHON：Python作业。\nCDCYAML：CDC数据摄入作业",
            "enum": [
              "SQLSCRIPT",
              "JAR",
              "PYTHON",
              "CDCYAML"
            ],
            "example": "SQLSCRIPT",
            "required": false,
            "title": "生效作业类型",
            "type": "string"
          },
          "pythonArtifact": {
            "$ref": "#/components/schemas/PythonArtifact",
            "backendName": "pythonArtifact",
            "description_en": "Required for a Python job",
            "description_zh": "Python作业必填信息",
            "title": "Python作业"
          },
          "sqlArtifact": {
            "$ref": "#/components/schemas/SqlArtifact",
            "backendName": "sqlArtifact",
            "description_en": "Required for an SQL job",
            "description_zh": "SQL作业必填信息",
