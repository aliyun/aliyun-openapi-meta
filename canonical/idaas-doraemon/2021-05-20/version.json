    "ListCostUnitOrders": {
      "cmd_name": "list-cost-unit-orders",
      "deprecated": false,
      "description_en": "Performs a paged query of orders and their compute unit (CU) usage information, sorted by creation time in descending order with paging support",
      "description_zh": "分页查询订单及其 CU 用量信息，按创建时间倒序排列"
    },
    "ListOrderConsumeStatisticRecords": {
      "cmd_name": "list-order-consume-statistic-records",
      "deprecated": false,
      "description_en": "Queries daily usage statistics records for an order by paging. Results are sorted by statistics date in ascending order. The maximum date range is 31 days. If the range exceeds 31 days, the system counts 31 days backward from the maximum date. Statistics records are generated on a T+1 basis, and the previous day's usage is calculated before 12:00 of the current day",
      "description_zh": "分页查询订单每日用量统计记录，按统计日期正序排列。统计日期最大区间范围为 31 天，如果超过从最大值向前推 31 天。T+1 出统计记录，当天12点前统计出昨天的用量"
    },
    "ListPwnedPasswords": {
      "cmd_name": "list-pwned-passwords",
      "deprecated": false,
      "description_en": "Detects password leakage",
      "description_zh": "检测密码泄露"
    },
    "QuerySmsReports": {
      "cmd_name": "query-sms-reports",
