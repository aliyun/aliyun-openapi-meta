{
  "camel_example": "aliyun live DescribeLiveStreamsPublishList --region cn-hangzhou --EndTime '2017-12-22T08:00:00Z' --DomainName 'example.com' --StartTime '2017-12-21T08:00:00Z' --RegionId 'cn-hangzhou'",
