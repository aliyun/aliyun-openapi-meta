{
  "camel_example": "aliyun live GetEdgeTranscodeJob --region cn-hangzhou --ClusterId '0000003b-4d18-395c-8106-ff21a6000000' --RegionId 'cn-hangzhou' --JobId 000020b48fb04483915d4f2cd8ac0000",
  "cmd_full_name": "live get-edge-transcode-job",
  "cmd_name": "get-edge-transcode-job",
  "deprecated": false,
  "description_en": "Queries the details of an edge transcoding job",
  "description_zh": "查询边缘转码任务详情",
  "kebab_example": "aliyun live get-edge-transcode-job --biz-region-id cn-hangzhou --cluster-id 0000003b-4d18-395c-8106-ff21a6000000 --job-id 000020b48fb04483915d4f2cd8ac0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetEdgeTranscodeJob",
  "operation": {
    "action": "GetEdgeTranscodeJob",
    "api_style": "RPC",
    "api_version": "2016-11-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-shanghai",
      "help_en": "The region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "******3b-4d18-395c-8106-ff21a6******",
      "help_en": "The data center ID",
      "help_zh": "机房ID",
      "location": "query",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "****20b48fb04483915d4f2cd8ac****",
      "help_en": "The ID of the edge transcoding job",
      "help_zh": "边缘转码任务ID",
      "location": "query",
      "name": "job_id",
      "options": [
        "--job-id"
      ],
      "raw_name": "JobId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "live",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Job": {
            "backendName": "data.content.job",
            "description_en": "The edge transcoding job",
            "description_zh": "边缘转码任务",
            "properties": {
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The time when the job was created",
                "description_zh": "任务创建时间。格式为：yyyy-MM-ddTHH:mm:ssZ（UTC 时间）",
                "example": "2023-07-24T16:44:55Z",
                "type": "string"
              },
              "JobId": {
                "backendName": "jobId",
                "description_en": "The job ID",
                "description_zh": "任务ID",
                "example": "****20b48fb04483915d4f2cd8ac****",
                "type": "string"
              },
              "LastStartAt": {
                "backendName": "lastStartAt",
                "description_en": "The time when the job was last started",
                "description_zh": "任务上一次启动的时间",
                "example": "2023-07-25T02:48:58Z",
                "type": "string"
              },
              "LastStopAt": {
                "backendName": "lastStopAt",
                "description_en": "The time when the job was last stopped",
                "description_zh": "任务上一次停止的时间",
                "example": "2023-07-25T05:48:58Z",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The job name",
                "description_zh": "任务名称",
                "example": "my_job",
                "type": "string"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The status of the transcoding job. Valid values:\n\n0: The job is not started.\n\n1: The job is running",
                "description_zh": "转码任务状态，枚举：\n0 未启动。\n1 运行中",
                "example": "0",
                "type": "string"
              },
              "StreamInput": {
                "backendName": "streamInput",
                "description_en": "The input stream URL",
                "description_zh": "输入流地址",
                "example": "rtmp://mydomain/app/stream1",
                "type": "string"
              },
              "StreamOutput": {
                "backendName": "streamOutput",
                "description_en": "The output stream URL",
                "description_zh": "输出流地址",
                "example": "rtmp://testdomain/app/stream2",
                "type": "string"
              },
              "TemplateId": {
                "backendName": "templateId",
                "description_en": "The ID of the edge transcoding template used by the job",
                "description_zh": "任务使用的边缘转码模板ID",
                "example": "9b1571b513cb44f7a1ba6ae561ff****",
                "type": "string"
              },
              "TemplateName": {
                "backendName": "templateName",
                "description_en": "The name of the edge transcoding template used by the job",
                "description_zh": "任务使用的边缘转码模板名",
                "example": "my_template",
                "type": "string"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type of edge transcoding. Valid values:\n\ncommon: standard transcoding and Narrowband HD 1.0.\n\nnbhd-2: Narrowband HD 2.0.\n\nultra-hd: ultra-high definition",
                "description_zh": "边缘转码类型，枚举：\ncommon，通用(普通+窄带高清1.0)。\nnbhd-2，窄带高清2.0。\nultra-hd，超高清",
                "example": "common",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "******3B-0E1A-586A-AC29-742247******",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
