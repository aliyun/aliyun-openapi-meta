                        "description_zh": "视频资源绑定的通道位置ID",
                        "example": "RV01",
                        "type": "string"
                      },
                      "FillMode": {
                        "backendName": "fillMode",
                        "description_en": "The fill type. Default value: none",
                        "description_zh": "填充类型。默认为none",
                        "example": "none",
                        "type": "string"
                      },
