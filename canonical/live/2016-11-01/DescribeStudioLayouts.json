                    "description_en": "The layer order configuration",
                    "description_zh": "图层顺序配置",
                    "properties": {
                      "Id": {
                        "backendName": "id",
                        "description_en": "The unique ID of the resource",
                        "description_zh": "该资源的唯一ID",
                        "example": "k12kj31****",
                        "type": "string"
                      },
                      "Type": {
                        "backendName": "type",
                        "description_en": "The type of the resource configuration. Valid values:\n\nbackground: background material.\nmedia: multimedia material",
