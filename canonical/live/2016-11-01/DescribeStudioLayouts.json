                      "Id": {
                        "backendName": "id",
                        "description_en": "The unique ID of the chroma key source material",
                        "description_zh": "该抠像源素材唯一ID",
                        "example": "k12kj31****",
                        "type": "string"
                      },
                      "Index": {
                        "backendName": "index",
                        "description_en": "The chroma key source number. Used for frontend display only and has no logical function",
