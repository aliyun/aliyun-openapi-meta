                        "example": "0",
                        "format": "int32",
                        "type": "integer"
                      },
                      "PositionX": {
                        "backendName": "positionX",
                        "description_en": "The position parameter, x coordinate. Valid values: 0 to 1. The material position is based on the upper-left corner",
                        "description_zh": "位置参数，坐标x。取值：0~1。素材位置以左上角为基准点",
                        "example": "0.1",
                        "type": "string"
                      },
                      "PositionY": {
                        "backendName": "positionY",
                        "description_en": "The position parameter, y coordinate. Valid values: 0 to 1. The material position is based on the upper-left corner",
                        "description_zh": "位置参数，坐标y。取值：0~1。素材位置以左上角为基准点",
                        "example": "0.2",
                        "type": "string"
                      },
                      "VideoResourceId": {
                        "backendName": "videoResourceId",
                        "description_en": "The video resource ID",
                        "description_zh": "视频资源ID",
                        "example": "asdfasdfasdfasdfa****",
                        "type": "string"
                      }
                    },
                    "type": "object"
