{
  "camel_example": "aliyun live DescribeStudioLayouts --region cn-hangzhou --RegionId 'cn-hangzhou' --CasterId '5c6a2a0d-f228-4a64-af62-20e91b960000'",
  "cmd_full_name": "live describe-studio-layouts",
  "cmd_name": "describe-studio-layouts",
  "deprecated": false,
  "description_en": "Retrieves the layout settings of a virtual studio",
  "description_zh": "获取虚拟演播厅布局设置",
  "kebab_example": "aliyun live describe-studio-layouts --biz-region-id cn-hangzhou --caster-id 5c6a2a0d-f228-4a64-af62-20e91b960000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeStudioLayouts",
  "operation": {
    "action": "DescribeStudioLayouts",
    "api_style": "RPC",
    "api_version": "2016-11-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-shanghai",
      "help_en": "The region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "5c6a2a0d-f228-4a64-af62-20e91b96****",
      "help_en": "The production studio ID.\n\nIf you created the production studio by calling the https://help.aliyun.com/document_detail/2848009.html operation, check the CasterId parameter value returned by the CreateCaster operation.\n\nIf you created the production studio in the ApsaraVideo Live console, go to ApsaraVideo Live console > Production Studio > Cloud Production Studio to view the ID.\n\n\nThe production studio name in the production studio list on the Cloud Production Studio page is the production studio ID.\nOnly virtual studio production studios (NormType=4) are supported. If you pass in a production studio ID of another type, InvalidCaster.NotFound is returned. Call DescribeCasters and filter by NormType=4 to obtain the virtual studio production studio ID",
      "help_zh": "导播台ID。\n\n如果您通过https://help.aliyun.com/document_detail/2848009.html创建导播台，请查看CreateCaster接口调用返回的参数CasterId值。\n\n如果您通过直播控制台创建导播台，请通过直播控制台 > 导播台 > 云导播台页面查看。\n\n\n直播控制台云导播台页面导播台列表中的导播台名称即导播台ID。\n仅支持虚拟演播厅型导播台（NormType=4），传入其他类型导播台 ID 将返回 InvalidCaster.NotFound。可先调用 DescribeCasters 并按 NormType=4 过滤获取虚拟演播厅型导播台ID",
      "location": "query",
      "name": "caster_id",
      "options": [
        "--caster-id"
      ],
      "raw_name": "CasterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "445409ec-7eaa-461d-8f29-4bec2eb9****",
      "help_en": "The layout ID.\nSeparate multiple layout IDs with commas (,). If this parameter is not specified, all layouts under the production studio are returned.\n\nIf you added virtual studio layout settings by calling the https://help.aliyun.com/document_detail/2848062.html operation, check the LayoutId parameter value returned by the AddStudioLayout operation",
      "help_zh": "布局ID。\n多个布局ID用英文逗号（,）隔开，不填则返回该导播台下所有布局。\n\n如果您通过https://help.aliyun.com/document_detail/2848062.html添加虚拟演播厅的布局设置，请查看AddStudioLayout接口调用返回的参数LayoutId值",
      "location": "query",
      "name": "layout_id",
      "options": [
        "--layout-id"
      ],
      "raw_name": "LayoutId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "live",
  "protocol": "HTTP|HTTPS",
