                        "example": "k12kj31****",
                        "type": "string"
                      },
                      "ImageMaterialId": {
                        "backendName": "imageMaterialId",
                        "description_en": "The video-on-demand image material ID",
                        "description_zh": "点播图片素材ID",
                        "example": "lkajsdfsa8fd89asd8****",
                        "type": "string"
                      },
                      "Index": {
                        "backendName": "index",
                        "description_en": "The multimedia material number. Used for frontend display only and has no logical function",
                        "description_zh": "多媒体素材编号。前端展示使用，无逻辑作用",
