            "type": "string"
          },
          "StartTime": {
            "backendName": "data.content.startTime",
            "description_en": "The start time. The format is yyyy-MM-ddTHH:mm:ssZ (UTC)",
            "description_zh": "起始时间。格式为：<i>yyyy-MM-dd</i>T<i>HH:mm:ssZ</i>（UTC时间）",
            "example": "2018-03-17T16:00:00Z",
            "type": "string"
          }
        },
        "type": "object"
      }
