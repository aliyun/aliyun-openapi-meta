{
  "camel_example": "aliyun live DescribeCasterConfig --region cn-hangzhou --RegionId 'cn-hangzhou' --CasterId 'LIVEPRODUCER_POST-cn-0pp1czt0000'",
  "cmd_full_name": "live describe-caster-config",
  "cmd_name": "describe-caster-config",
  "deprecated": false,
  "description_en": "Queries the configuration information of a production studio",
  "description_zh": "查询导播台配置信息",
  "kebab_example": "aliyun live describe-caster-config --biz-region-id cn-hangzhou --caster-id LIVEPRODUCER_POST-cn-0pp1czt0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeCasterConfig",
  "operation": {
    "action": "DescribeCasterConfig",
    "api_style": "RPC",
    "api_version": "2016-11-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-shanghai",
      "help_en": "The region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "LIVEPRODUCER_POST-cn-0pp1czt****",
      "help_en": "The production studio ID.\n\nIf you created the production studio by calling the https://help.aliyun.com/document_detail/2848009.html operation, check the CasterId parameter value returned by the CreateCaster operation.\n\nIf you created the production studio in the ApsaraVideo Live console, go to ApsaraVideo Live console > Production Studios > Cloud Production Studio to view the ID.\n\nThe name of the production studio in the production studio list on the Cloud Production Studio page is the production studio ID",
      "help_zh": "导播台ID。\n\n如果您通过https://help.aliyun.com/document_detail/2848009.html接口创建导播台，请查看CreateCaster接口调用返回的参数CasterId值。\n\n如果您通过直播控制台创建导播台，请通过直播控制台 > 导播台 > 云导播台页面查看。\n\n直播控制台云导播台页面导播台列表中的导播台名称即导播台ID",
      "location": "query",
      "name": "caster_id",
      "options": [
        "--caster-id"
      ],
      "raw_name": "CasterId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "live",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The configuration information of the production studio",
        "description_zh": "导播台配置信息",
        "properties": {
          "AudioMixerMode": {
            "backendName": "data.content.audioMixerMode",
            "default": "pgm",
            "type": "string"
          },
          "AutoSwitchUrgentConfig": {
            "backendName": "data.content.autoSwitchConfig",
            "description_en": "The automatic standby video switching configuration. `eofThres`: specifies the duration of stream interruption before automatically switching to the standby video. Unit: seconds",
            "description_zh": "自动切备播配置。`eofThres`：表示断流时间后自动切备播，单位为秒",
            "example": "{\"eofThres\":3}",
            "type": "string"
          },
          "AutoSwitchUrgentOn": {
            "backendName": "data.content.autoSwitchOn",
            "description_en": "Indicates whether automatic switchover to the standby video upon stream interruption is enabled.\ntrue: Enabled.\nfalse: Shutdown",
            "description_zh": "开启断流自动切换备播。\ntrue：开启。\nfalse：关闭",
            "example": "true",
            "type": "string"
          },
          "CallbackUrl": {
            "backendName": "data.content.callbackUrl",
            "description_en": "The user callback URL",
            "description_zh": "用户回调地址",
            "example": "http://learn.aliyundoc.com/callBackLive",
            "type": "string"
          },
          "CasterId": {
            "backendName": "data.casterId",
            "description_en": "The production studio ID",
            "description_zh": "导播台ID",
            "example": "LIVEPRODUCER_POST-cn-0pp1czt****",
            "type": "string"
          },
          "CasterName": {
            "backendName": "data.content.casterName",
            "description_en": "The production studio name",
            "description_zh": "导播台名称",
            "example": "coco-caster10",
            "type": "string"
          },
          "ChannelEnable": {
            "backendName": "data.content.channelEnable",
            "description_en": "Indicates whether Channel is enabled. Valid values:\n         \n0: Disabled.\n1: Enabled",
            "description_zh": "是否启用Channel。 取值：\n         \n0：不启用。\n1：启用",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "Delay": {
            "backendName": "data.content.delay",
            "description_en": "The stream delay. Unit: seconds. \n         \n0: Stream delay is disabled.\nGreater than 0: Stream delay is enabled",
            "description_zh": "延时播放。单位：秒 。 \n         \n0：禁用延时。\n大于0：启用延时。\n ",
            "example": "0",
            "format": "float",
            "type": "number"
          },
          "DomainName": {
            "backendName": "data.content.domainName",
            "description_en": "The primary streaming domain",
            "description_zh": "主播流域名",
            "example": "example.com",
            "type": "string"
          },
          "ProgramEffect": {
            "backendName": "data.content.programEffect",
            "description_en": "The playlist effective flag. Valid values:\n         \n0: Not effective.\n1: Effective",
            "description_zh": "轮播生效标志。 取值：\n         \n0：不生效 。\n1：生效",
            "example": "0",
            "format": "int32",
            "type": "integer"
          },
          "ProgramName": {
            "backendName": "data.content.programName",
            "description_en": "The playlist name",
            "description_zh": "轮播台名称",
            "example": "program_name",
            "type": "string"
          },
          "RecordConfig": {
            "backendName": "data.content.recordConfig",
            "description_en": "The recording configuration. If this parameter is empty, the recording feature is not enabled",
            "description_zh": "录制配置参数为空时，表示不启用录制功能",
            "properties": {
              "OnDemand": {
                "backendName": "onDemand",
                "description_en": "The on-demand recording mode. Valid values:\n\n0: Disabled.\n\n1: HTTP callback-based.\n\n2: On-demand recording by parsing stream ingest parameters.\n\n7: Not recorded by default",
                "description_zh": "按需录制。取值：\n\n0：关闭。\n\n1：通过HTTP回调方式。\n\n2：解析推流参数按需录制。\n\n7：默认不录制",
                "example": "0",
                "format": "int32",
                "type": "integer"
              },
              "OssBucket": {
                "backendName": "ossBucket",
                "description_en": "The storage location",
                "description_zh": "存储位置",
                "example": "liveBucket****",
                "type": "string"
              },
              "OssEndpoint": {
                "backendName": "endpoint",
                "description_en": "The OSS endpoint of the storage location",
                "description_zh": "存储位置所在OSS节点",
                "example": "oss-cn-shanghai.aliyundoc.com",
                "type": "string"
              },
              "RecordFormat": {
                "backendName": "videoFormat",
                "itemName": "RecordFormat",
                "items": {
                  "properties": {
                    "CycleDuration": {
                      "backendName": "interval",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Format": {
                      "backendName": "format",
                      "type": "string"
                    },
                    "OssObjectPrefix": {
                      "backendName": "prefix",
                      "type": "string"
                    },
                    "SliceOssObjectPrefix": {
                      "backendName": "slicePrefix",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": true,
                "type": "array"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "97df6b7f-3490-47d2-ac50-8833e1b64597",
            "type": "string"
          },
          "SideOutputUrl": {
            "backendName": "data.content.sideOutputUrl",
            "description_en": "The custom side output URL of the production studio",
            "description_zh": "用户自定义导播台旁路输出地址",
            "example": "rtmp://sophon-developer.aliyundoc.com/caster/4a82a3d1b7f0462ea37348366201****?auth_key=1608953344-0-0-ac8c628078541d7055a170ec59a5****",
            "type": "string"
          },
          "SideOutputUrlList": {
            "backendName": "data.content.sideOutputUrlList",
            "description_en": "The list of custom side output URLs of the production studio",
            "description_zh": "用户自定义导播台旁路输出地址列表",
            "example": "[\"rtmp://domain/app1/stream1\",\"rtmp://domain/app2/stream2\"]",
            "type": "string"
          },
          "SyncGroupsConfig": {
            "backendName": "data.content.syncGroups",
            "itemName": "SyncGroup",
            "items": {
              "properties": {
                "HostResourceId": {
                  "backendName": "hostResourceId",
                  "type": "string"
                },
                "Mode": {
                  "backendName": "mode",
                  "format": "int32",
                  "type": "integer"
                },
                "ResourceIds": {
                  "backendName": "resourceIds",
                  "itemName": "ResourceId",
                  "items": {
                    "backendName": "resourceIds",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "TranscodeConfig": {
            "backendName": "data.content.transcodeConfig",
            "description_en": "The transcoding configuration",
            "description_zh": "转码配置",
            "properties": {
              "CasterTemplate": {
                "backendName": "casterTemplate",
                "description_en": "The production studio transcoding template. Valid values:\n\nlp_ld: low definition.\nlp_sd: standard definition.\nlp_hd: high definition.\nlp_ud: ultra-high definition.\nlp_ld_v: portrait low definition.\nlp_sd_v: portrait standard definition.\nlp_hd_v: portrait high definition.\nlp_ud_v: portrait ultra-high definition",
                "description_zh": "导播台转码模板。取值：\n\nlp_ld：流畅。\nlp_sd：标清。\nlp_hd：高清。\nlp_ud：超清。\nlp_ld_v：竖屏流畅。\nlp_sd_v：竖屏标清。\nlp_hd_v：竖屏高清。\nlp_ud_v：竖屏超清",
                "example": "lp_hd",
                "type": "string"
              },
              "CustomParams": {
                "backendName": "customParams",
                "description_en": "The custom configuration",
                "description_zh": "自定义配置",
                "properties": {
                  "video": {
                    "backendName": "video",
                    "description_en": "The video parameters",
                    "description_zh": "视频参数",
                    "properties": {
                      "bitrate": {
                        "backendName": "bitrate",
                        "description_en": "The video bitrate",
                        "description_zh": "视频码率",
                        "example": "300",
                        "format": "int32",
                        "type": "integer"
                      },
                      "fps": {
                        "backendName": "fps",
                        "description_en": "The video frame rate",
                        "description_zh": "视频帧率",
                        "example": "300",
                        "format": "int32",
                        "type": "integer"
                      },
                      "height": {
                        "backendName": "height",
                        "description_en": "The video height. Unit: pixels (px)",
                        "description_zh": "视频画面高度，单位为像素（px）",
                        "example": "720",
                        "format": "int32",
                        "type": "integer"
                      },
                      "width": {
                        "backendName": "width",
                        "description_en": "The video width. Unit: pixels (px)",
                        "description_zh": "视频画面宽度，单位为像素（px）",
                        "example": "1080",
                        "format": "int32",
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "LiveTemplateIds": {
                "backendName": "liveTemplate",
                "itemName": "LocationId",
                "items": {
                  "backendName": "liveTemplate",
                  "nullToEmpty": true,
                  "type": "string"
                },
                "nullToEmpty": true,
                "type": "array"
              }
            },
            "type": "object"
          },
          "UrgentImageId": {
            "backendName": "data.content.urgentImageId",
            "description_en": "The media library asset ID of the standby image",
            "description_zh": "备播图片媒资库素材ID",
            "example": "a089175eb5f4427684fc0715159a****",
            "type": "string"
          },
          "UrgentImageUrl": {
            "backendName": "data.content.urgentImageUrl",
            "description_en": "The URL of the standby image",
            "description_zh": "备播图片素材URL",
            "example": "http://learn.aliyundoc.com/AppName/image.jpg",
            "type": "string"
          },
          "UrgentLiveStreamUrl": {
            "backendName": "data.content.urgentLiveStreamUrl",
            "description_en": "The URL of the standby live stream",
            "description_zh": "备播直播流URL",
            "example": "rtmp://demo.aliyundoc.com",
            "type": "string"
          },
          "UrgentMaterialId": {
            "backendName": "data.content.urgentMaterialId",
            "description_en": "The media library asset ID of the standby video",
            "description_zh": "备播视频媒资库素材ID",
            "example": "98646538-bcf9-4aef-bd4a-e6bb76588****",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
