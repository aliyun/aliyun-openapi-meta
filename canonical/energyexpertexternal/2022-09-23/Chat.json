            "example": "0.0",
            "format": "double",
            "type": "number"
          },
          "excelParseResult": {
            "backendName": "excelParseResult",
            "description_en": "Reserved, can be unused for now",
            "description_zh": "预留，暂可不用",
            "example": "null",
            "type": "string"
          },
          "imageHeight": {
            "backendName": "imageHeight",
            "description_en": "The height of the page turns to image",
            "description_zh": "页面转图的高",
            "example": "22",
            "format": "int32",
            "type": "integer"
          },
          "imageUrl": {
            "backendName": "imageUrl",
