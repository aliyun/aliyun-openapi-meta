            "description_zh": "页面转图片后的图片URL。\n注意：图片url超过24小时后将无法获取到图片，需要及时另存",
            "example": "2",
            "type": "string"
          },
          "imageWidth": {
            "backendName": "imageWidth",
            "description_en": "The width of the page turns to image",
            "description_zh": "页面转图的宽",
            "example": "23",
            "format": "int32",
            "type": "integer"
          },
          "pageIdCurDoc": {
            "backendName": "pageIdCurDoc",
            "description_en": "The page index in the current document, starting from 0",
            "description_zh": "页面在当前文档的页索引，从0开始",
            "example": "2",
            "format": "int32",
            "type": "integer"
          },
          "pdfParseResult": {
            "backendName": "pdfParseResult",
            "description_en": "Reserved, can be unused for now",
            "description_zh": "预留，暂可不用",
            "example": "null",
            "type": "string"
          },
          "wordParseResult": {
            "backendName": "wordParseResult",
            "description_en": "Reserved, can be unused for now",
            "description_zh": "预留，暂可不用",
            "example": "null",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChatRefDocPostion": {
        "description_en": "Document coordinates",
        "description_zh": "文档坐标",
        "properties": {
          "x": {
            "backendName": "x",
            "description_en": "The x-coordinate of the layout",
            "description_zh": "版面的x坐标",
            "example": "22",
            "format": "int32",
            "type": "integer"
          },
          "y": {
            "backendName": "y",
            "description_en": "The y-coordinate of the layout",
            "description_zh": "版面的y坐标",
            "example": "86",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
