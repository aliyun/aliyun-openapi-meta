              "$ref": "#/components/schemas/ChatRefDocItem",
              "description_en": "Details of files related to the Q&A",
              "description_zh": "问答相关文件详情"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ChatRefDocInfo": {
        "description_en": "Page document information",
        "description_zh": "页面文档信息",
        "properties": {
          "pageListInfo": {
            "backendName": "pageListInfo",
            "description_en": "Detailed information for each page of the document",
            "description_zh": "文件每页具体信息",
            "items": {
              "$ref": "#/components/schemas/ChatRefDocPageInfo",
              "description_en": "Detailed information for each page",
              "description_zh": "每页具体信息"
            },
            "type": "array"
          },
          "pages": {
            "backendName": "answer",
            "description_en": "Total number of pages in the current document",
            "description_zh": "当前文档总页数",
            "example": "23",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
