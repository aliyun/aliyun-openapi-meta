          },
          "originDocUrl": {
            "backendName": "originDocUrl",
            "description_en": "Original document link",
            "description_zh": "原始文档链接",
            "example": "https://carbon-aidoc.oss-accelerate.aliyuncs.com/jobs/42dbc7-3a9e-4e18-8939-3fd2d247bd3c/document/97178d94c75941d3b932883c810c5e.doc",
            "type": "string"
          },
          "pageNum": {
            "backendName": "pageNum",
            "description_en": "Page number information",
            "description_zh": "页码信息",
            "items": {
              "$ref": "#/components/schemas/ChatDocumentPageNum",
              "description_en": "Page information details",
              "description_zh": "页面信息详情"
            },
            "type": "array"
          },
          "sourceType": {
            "backendName": "sourceType",
            "description_en": "Return file type: 'doc' for document files, 'web' for internet information",
            "description_zh": "返回文件类型，\"doc\": 文件类型； \"web\"：互联网信息",
            "example": "doc",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChatRefDocPageInfo": {
