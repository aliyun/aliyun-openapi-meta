{
  "camel_example": "aliyun energyexpertexternal POST /api/v2/aidoc/document/chat --region cn-hangzhou --header \"Content-Type=application/json\" --body '{\"question\":\"How_to_obtain_knowledge_base_Q_A_documents\",\"sessionId\":\"bfce2248-1546-4298-8bcf-70ac26e69646\",\"documentIds\":[3456]}'",
  "cmd_full_name": "energyexpertexternal chat",
  "cmd_name": "chat",
  "components": {
    "schemas": {
      "ChatDocumentPageNum": {
        "description_en": "Location information of Q&A-related content in the document",
        "description_zh": "问答相关内容在文档的位置信息",
        "properties": {
          "num": {
            "backendName": "num",
            "description_en": "Page numbers of related documents",
            "description_zh": "相关文档页码",
            "example": "12",
            "format": "int32",
            "type": "integer"
          },
          "pos": {
            "backendName": "pos",
            "description_en": "Location information of the document",
            "description_zh": "文档的位置信息",
            "items": {
              "description_en": "Related location coordinates, with each location consisting of 4 coordinate points",
              "description_zh": "相关位置坐标，每个位置为4个坐标点",
              "items": {
                "$ref": "#/components/schemas/ChatRefDocPostion",
                "description_en": "Document block location data",
                "description_zh": "文档块位置数据"
              },
              "type": "array"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "ChatItem": {
        "description_en": "Q&A details",
        "description_zh": "问答详情",
        "properties": {
          "answer": {
            "backendName": "answer",
            "description_en": "The content of the answer to the question",
            "description_zh": "提问的回答内容",
            "example": "未找到相关内容",
            "type": "string"
          },
          "createTime": {
            "backendName": "createTime",
            "description_en": "Q&A time, in milliseconds timestamp",
            "description_zh": "问答时间，毫秒时间戳",
            "example": "1747280158000",
            "format": "int64",
            "type": "integer"
          },
          "folderId": {
            "backendName": "folderId",
            "description_en": "Folder selected for the Q&A",
            "description_zh": "问答选择的文件夹",
            "example": "7708fddb-21dc-4403-a4ea-5b94eccce4c3",
            "type": "string"
          },
          "folderName": {
            "backendName": "folderName",
            "description_en": "Name of the folder selected for the Q&A",
            "description_zh": "问答选择的文件夹名称",
            "example": "默认文件夹",
            "type": "string"
          },
          "question": {
            "backendName": "question",
            "description_en": "Question content",
            "description_zh": "提问内容",
            "example": "如何使用知识库。",
            "type": "string"
          },
          "refDocList": {
            "backendName": "refDocList",
            "description_en": "List of files related to the Q&A.\nIf streaming question answering is used, only the first shard contains data",
            "description_zh": "与问答相关的文件列表。\n如果使用流式问答，只有第一个分片有数据",
