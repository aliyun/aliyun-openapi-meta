                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DiskId": {
                  "backendName": "diskId",
                  "description_en": "The disk ID",
                  "description_zh": "磁盘ID",
                  "example": "d-bp14wq0149cpp2x****",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DiskName": {
                  "backendName": "diskName",
                  "description_en": "The name of the disk",
                  "description_zh": "磁盘名称",
