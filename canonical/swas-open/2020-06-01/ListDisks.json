                  "format": "int32",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the disk. Valid values:\n\nReIniting: The disk is being initialized.\n\nCreating: The disk is being created.\n\nIn_use: The disk is in use.\n\nAvailable: The disk can be attached.\n\nAttaching: The disk is being attached.\n\nDetaching: The disk is being detached",
                  "description_zh": "磁盘状态。可能值：\n\nReIniting：初始化中。\nCreating：创建中。\nIn_use：使用中。\nAvailable：待挂载。\nAttaching：挂载中。\nDetaching：卸载中",
                  "example": "In_use",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Tags": {
                  "backendName": "tags",
                  "description_en": "The tags that are added to the disks",
                  "description_zh": "磁盘的标签列表",
                  "itemName": "tag",
                  "items": {
                    "description_en": "The tags of the disk",
                    "description_zh": "标签",
                    "properties": {
                      "Key": {
                        "backendName": "key",
                        "description_en": "The tag key",
                        "description_zh": "磁盘的标签键",
                        "example": "TestKey",
                        "type": "string"
                      },
                      "Value": {
                        "backendName": "value",
                        "description_en": "The tag value",
                        "description_zh": "磁盘的标签值",
                        "example": "TestValue",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "data.pageNumber",
            "description_en": "The page number",
            "description_zh": "磁盘列表的页码",
            "example": "1",
            "format": "int32",
