                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DiskType": {
                  "backendName": "diskType",
                  "description_en": "The disk type. Valid values:\n\nsystem: system disk\n\ndata: data disk",
                  "description_zh": "磁盘类型。可能值：\n\nSystem：系统盘。\nData：数据盘",
                  "example": "System",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "InstanceId": {
                  "backendName": "instanceId",
                  "description_en": "The ID of the simple application server to which the disk is attached",
                  "description_zh": "磁盘对应的轻量应用服务器的实例ID",
                  "example": "2ad1ae67295445f598017499dc****",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "InstanceName": {
                  "backendName": "instanceName",
                  "description_en": "The name of the simple application server",
                  "description_zh": "轻量应用服务器名称",
                  "example": "myInstance",
                  "type": "string"
                },
                "RegionId": {
                  "backendName": "regionId",
                  "description_en": "The region ID",
                  "description_zh": "地域ID",
                  "example": "cn-hangzhou",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Remark": {
                  "backendName": "remark",
                  "description_en": "The remarks of the disk",
                  "description_zh": "磁盘备注",
                  "example": "remark",
                  "type": "string"
                },
                "ResourceGroupId": {
                  "backendName": "resourceGroupId",
                  "description_en": "The ID of the resource group to which the disk belongs",
                  "description_zh": "磁盘所属的资源组ID",
                  "example": "rg-aek2bti7cf7****",
                  "type": "string"
                },
                "Size": {
                  "backendName": "size",
                  "description_en": "The size of the disk. Unit: GB",
                  "description_zh": "磁盘大小。单位：GB",
