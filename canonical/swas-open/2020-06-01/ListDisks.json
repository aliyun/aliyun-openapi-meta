                  "description_zh": "磁盘类型，可能值：\n\nESSD：ESSD云盘，性能级别PL0。\nSSD：SSD云盘。\nCLOUD_EFFICIENCY：高效云盘",
                  "example": "ESSD",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "CreationTime": {
                  "backendName": "creationTime",
                  "description_en": "The time when the disk was created. The time follows the [ISO 8601]（https://help.aliyun.com/document_detail/25696.html） standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
                  "description_zh": "创建时间。时间格式以[ISO8601]（https://help.aliyun.com/document_detail/25696.html）为标准，并使用UTC+0时间，格式为yyyy-MM-ddTHH:mm:ssZ",
                  "example": "2021-03-08T05:31:06Z",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Device": {
                  "backendName": "device",
                  "description_en": "The device name of the disk after the disk is attached to the simple application server",
                  "description_zh": "磁盘挂载服务器中的设备名",
                  "example": "/dev/xvda",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DiskChargeType": {
                  "backendName": "diskChargeType",
                  "description_en": "The billing method of the disk",
                  "description_zh": "磁盘的计费方式",
