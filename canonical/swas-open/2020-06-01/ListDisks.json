            "type": "integer",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "data.pageSize",
            "description_en": "The number of entries per page",
            "description_zh": "分页查询时设置的每页行数",
            "example": "10",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "20758A-585D-4A41-A9B2-28DA8F4F534F",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "TotalCount": {
            "backendName": "data.totalCount",
            "description_en": "The total number of entries returned",
            "description_zh": "磁盘总条数",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
