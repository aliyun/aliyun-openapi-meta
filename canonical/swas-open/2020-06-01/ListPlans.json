{
  "camel_example": "",
  "cmd_full_name": "swas-open list-plans",
  "cmd_name": "list-plans",
  "deprecated": false,
  "description_en": "Queries all plan information for simple application servers in a specified region",
  "description_zh": "查询指定地域下，轻量应用服务器所有的套餐信息",
  "kebab_example": "aliyun swas-open list-plans --biz-region-id cn-hangzhou --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ListPlans",
  "operation": {
    "action": "ListPlans",
    "api_style": "RPC",
    "api_version": "2020-06-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cn-hangzhou",
      "help_en": "The region ID. You can call https://help.aliyun.com/document_detail/189315.html to query the available regions for simple application servers",
      "help_zh": "地域ID。您可以调用https://help.aliyun.com/document_detail/189315.html查询轻量应用服务器的可用地域",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "SWAS-OPEN",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Plans": {
            "backendName": "data.list",
            "description_en": "The plan information",
            "description_zh": "套餐信息",
            "itemName": "Plan",
            "items": {
              "description_en": "The plan information",
              "description_zh": "套餐信息",
              "properties": {
                "Bandwidth": {
                  "backendName": "bandwidth",
                  "description_en": "The peak bandwidth. Unit: Mbit/s",
                  "description_zh": "峰值带宽。单位：Mbps",
                  "example": "200",
                  "format": "int32",
                  "type": "integer",
                  "visibility": "Public"
                },
                "Core": {
                  "backendName": "core",
                  "description_en": "The number of vCPUs",
                  "description_zh": "vCPU核数",
                  "example": "2",
                  "format": "int32",
                  "type": "integer",
                  "visibility": "Public"
                },
                "Currency": {
                  "backendName": "currency",
                  "description_en": "The currency unit. Valid values:\n\nCNY: Chinese Yuan (CNY).\n\nUSD: US Dollar (USD).\n\nThe currency unit is CNY on the China site (aliyun.com) and USD on the International site (alibabacloud.com)",
                  "description_zh": "价格单位。可能值：\n\nCNY：元\n\nUSD：美元\n\n中国站价格单位为CNY，国际站价格单位为USD",
                  "example": "CNY",
                  "type": "string"
                },
                "DiskSize": {
                  "backendName": "diskSize",
                  "description_en": "The disk capacity. Unit: GiB",
                  "description_zh": "磁盘容量。单位：GiB",
                  "example": "40",
                  "format": "int32",
                  "type": "integer",
                  "visibility": "Public"
                },
                "DiskType": {
                  "backendName": "diskType",
                  "description_en": "The disk type. Valid values:\n\nESSD: ESSD cloud disk at performance level (PL) 0.\nSSD: standard SSD.\nCLOUD_EFFICIENCY: ultra cloud disk",
                  "description_zh": "磁盘类型，可能值：\n\nESSD：ESSD云盘，性能级别 PL0。\nSSD：SSD云盘。\nCLOUD_EFFICIENCY：高效云盘",
                  "example": "ESSD",
                  "type": "string"
                },
                "Flow": {
                  "backendName": "flow",
                  "description_en": "The monthly data transfer quota. Unit: GB",
                  "description_zh": "每月流量。单位：GB",
                  "example": "400",
                  "format": "int32",
                  "type": "integer",
                  "visibility": "Public"
                },
                "IspType": {
                  "backendName": "ispType",
                  "description_en": "The public network line type.\nBGP (default): BGP line.\nBGP_NCO: BGP (outside the Chinese mainland) line",
                  "description_zh": "公网线路类型。\nBGP（默认值）：BGP线路。\nBGP_NCO：BGP（非中国优化）线路",
                  "example": "BGP",
                  "type": "string"
                },
                "Memory": {
                  "backendName": "memory",
                  "description_en": "The memory size. Unit: GiB",
                  "description_zh": "内存。单位：GiB",
                  "example": "1",
                  "format": "float",
                  "type": "number",
                  "visibility": "Public"
                },
                "OriginPrice": {
                  "backendName": "originPrice",
                  "description_en": "The monthly price of the simple application server plan",
                  "description_zh": "轻量应用服务器套餐的包月价格",
                  "example": "60",
                  "type": "string"
                },
                "PlanId": {
                  "backendName": "planId",
                  "description_en": "The plan ID",
                  "description_zh": "套餐ID",
                  "example": "swas.s2.c2m1s40b3t04",
                  "type": "string",
                  "visibility": "Public"
                },
                "PlanType": {
                  "backendName": "planType",
                  "description_en": "The plan type. Valid values:\n\nNORMAL: general-purpose.\nCAPACITY: storage-optimized.\nPREVIOUS: previous generation.\nMULTI_IP: multiple public IP addresses.\nINTERNATIONAL: international.\n\nFor more information, see [Instance family]（https://help.aliyun.com/document_detail/2861773.html）",
                  "description_zh": "套餐类型，可能值：\n\nNORMAL：通用型。\nCAPACITY：容量型。\nPREVIOUS：上一代。\nMULTI_IP：多公网IP型。\nINTERNATIONAL：国际型。\n\n更多信息，请参见[实例规格族]（https://help.aliyun.com/document_detail/2861773.html）",
                  "example": "NORMAL",
                  "type": "string"
                },
                "PublicIpNum": {
                  "backendName": "publicIpNum",
                  "description_en": "The number of public IP addresses",
                  "description_zh": "公网IP数量",
                  "example": "1",
                  "type": "string"
                },
                "SupportPlatform": {
                  "backendName": "supportPlatform",
                  "description_en": "The operating system types supported by the plan",
                  "description_zh": "套餐支持的操作系统类型",
                  "example": "[\"Linux\",\"Windows\"]",
                  "type": "string"
                },
                "Tokens": {
                  "backendName": "tokens",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "20758A-585D-4A41-A9B2-28DA8F4F534F",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
