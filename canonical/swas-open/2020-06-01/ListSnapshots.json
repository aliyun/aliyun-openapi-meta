            "help_zh": "快照的标签键。标签键长度的取值范围：1~64。N 的取值范围：1~20",
            "name": "key",
            "options": [
              "--key"
            ],
            "raw_name": "Key",
            "required": false,
            "type": "string"
          },
          {
            "example": "TestValue",
