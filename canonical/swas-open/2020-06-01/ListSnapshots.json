            "help_zh": "快照的标签值。标签值长度的取值范围：1~64。N 的取值范围：1~20",
            "name": "value",
            "options": [
              "--value"
            ],
            "raw_name": "Value",
            "required": false,
            "type": "string"
          }
        ],
        "type": "object"
      },
      "help_en": "Tag N that you want to add to the snapshot",
      "help_zh": "快照的标签列表",
      "location": "query",
      "name": "tag",
      "options": [
        "--tag"
      ],
      "param_style": "repeatList",
      "raw_name": "Tag",
      "required": false,
      "type": "array"
    },
    {
      "example": "rg-aek2bti7cf7****",
      "help_en": "The ID of the resource group",
      "help_zh": "指定的资源组ID",
      "location": "query",
      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "SWAS-OPEN",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "PageNumber": {
            "backendName": "data.pageNumber",
            "description_en": "The page number",
            "description_zh": "快照列表的页码",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "data.pageSize",
            "description_en": "The number of entries per page",
            "description_zh": "分页查询时设置的每页行数",
            "example": "10",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "20758A-585D-4A41-A9B2-28DA8F4F534F",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Snapshots": {
            "backendName": "data.data",
            "description_en": "Details about the snapshots",
            "description_zh": "快照信息组成的数组",
            "itemName": "Snapshot",
            "items": {
              "properties": {
                "CreationTime": {
                  "backendName": "creationTime",
                  "description_en": "The time when the snapshot was created. The time follows the [ISO 8601]（https://help.aliyun.com/document_detail/25696.html） standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
                  "description_zh": "快照创建时间。时间格式以[ISO8601]（https://help.aliyun.com/document_detail/25696.html）为标准，并使用UTC+0时间，格式为yyyy-MM-ddTHH:mm:ssZ",
                  "example": "2021-03-09T07:12:49Z",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "InstanceId": {
                  "backendName": "instanceId",
                  "description_en": "The ID of the simple application server.\n\nNote: This parameter has a value returned for only system disk snapshots",
                  "description_zh": "轻量应用服务器实例ID。\n\n注：系统盘快照该字段有值，数据盘快照该值为空",
                  "example": "2ad1ae67295445f598017499dc****",
                  "type": "string"
                },
                "Progress": {
                  "backendName": "progress",
                  "description_en": "The progress of snapshot creation",
                  "description_zh": "快照创建的进度",
                  "example": "100%",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "RegionId": {
                  "backendName": "regionId",
                  "description_en": "The region ID",
                  "description_zh": "地域ID",
                  "example": "cn-hangzhou",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Remark": {
                  "backendName": "remark",
                  "description_en": "The remarks of the snapshot",
                  "description_zh": "快照备注",
                  "example": "test-Remark",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "ResourceGroupId": {
                  "backendName": "resourceGroupId",
                  "description_en": "The ID of the resource group to which the snapshot belongs",
                  "description_zh": "快照所属的资源组ID",
                  "example": "rg-aek2bti7cf7****",
                  "type": "string"
                },
                "RollbackTime": {
                  "backendName": "rollbackTime",
                  "description_en": "The time when the last disk rollback was performed",
                  "description_zh": "最近一次回滚时间",
                  "example": "2021-03-09T07:12:49Z",
                  "type": "string"
                },
                "SnapshotId": {
                  "backendName": "snapshotId",
                  "description_en": "The snapshot ID",
                  "description_zh": "快照ID",
                  "example": "s-bp16oazlsold4dks****",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "SnapshotName": {
                  "backendName": "snapshotName",
                  "description_en": "The name of the snapshot",
                  "description_zh": "快照名称",
                  "example": "test-SnapshotName",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "SourceDiskId": {
                  "backendName": "sourceDiskId",
                  "description_en": "The ID of the source disk. This parameter has a value even after the source disk is released",
                  "description_zh": "源磁盘ID。即使快照的源磁盘已经被释放，仍保留该返回值",
                  "example": "d-bp14wq0149cpp2xy****",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "SourceDiskType": {
                  "backendName": "sourceDiskType",
                  "description_en": "The type of the source disk. Valid values:\n\nsystem: system disk.\n\ndata: data disk",
                  "description_zh": "快照源磁盘的磁盘类型。可能值：\nSystem：系统盘。\nData：数据盘",
                  "example": "System",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the snapshot. Valid values:\n\nProgressing: The snapshot is being created.\n\nAccomplished: The snapshot is created.\n\nFailed: The snapshot failed to be created",
                  "description_zh": "快照状态。可能值：\n\nProgressing：正在创建。\nAccomplished：创建成功。\nFailed：创建失败",
                  "example": "Accomplished",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "Tags": {
                  "backendName": "tags",
                  "description_en": "The tags of the snapshot",
                  "description_zh": "快照的标签列表",
                  "itemName": "tag",
                  "items": {
                    "description_en": "The tags of the snapshot",
                    "description_zh": "标签",
                    "properties": {
                      "Key": {
                        "backendName": "key",
                        "description_en": "The tag key of the snapshot",
                        "description_zh": "快照的标签键",
                        "example": "TestKey",
                        "type": "string"
                      },
                      "Value": {
                        "backendName": "value",
                        "description_en": "The tag value of the snapshot",
                        "description_zh": "快照的标签值",
                        "example": "TestValue",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "TotalCount": {
            "backendName": "data.totalCount",
            "description_en": "The total number of entries returned",
            "description_zh": "快照的总条数",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
