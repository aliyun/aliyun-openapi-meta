{
  "camel_example": "",
  "cmd_full_name": "swas-open list-snapshots",
  "cmd_name": "list-snapshots",
  "deprecated": false,
  "description_en": "Queries the information about snapshots that are created for a simple application server",
  "description_zh": "查询一个或多个已创建的快照信息",
  "kebab_example": "aliyun swas-open list-snapshots --biz-region-id cn-hangzhou --instance-id 2ad1ae67295445f598017499dc0000 --disk-id d-bp14wq0149cpp2xy0000 --snapshot-ids s-bp16oazlsold4dks0000_,_s-bp16oazlsold4abc0000 --page-size 10 --page-number 1 --source-disk-type Data --tag Value=TestValue Key=TestKey --resource-group-id rg-aek2bti7cf70000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ListSnapshots",
  "operation": {
    "action": "ListSnapshots",
    "api_style": "RPC",
    "api_version": "2020-06-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cn-hangzhou\t",
      "help_en": "The region ID of the simple application server that corresponds to the snapshots",
      "help_zh": "快照对应的轻量应用服务器所属的地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "2ad1ae67295445f598017499dc****",
      "help_en": "The ID of the simple application server",
      "help_zh": "指定的轻量应用服务器的实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "d-bp14wq0149cpp2xy****",
      "help_en": "The disk ID",
      "help_zh": "指定的磁盘ID",
      "location": "query",
      "name": "disk_id",
      "options": [
        "--disk-id"
      ],
      "raw_name": "DiskId",
      "required": false,
      "type": "string"
    },
    {
      "example": "[\"s-bp16oazlsold4dks****\", \"s-bp16oazlsold4abc****\"]",
      "help_en": "The snapshot IDs. The value can be a JSON array that consists of up to 100 snapshot IDs. Separate multiple snapshot IDs with commas (,)",
      "help_zh": "快照ID。取值可以由多个快照ID组成一个JSON数组，最多支持100个ID，ID之间用半角逗号（,）隔开",
      "location": "query",
      "name": "snapshot_ids",
      "options": [
        "--snapshot-ids"
      ],
      "raw_name": "SnapshotIds",
      "required": false,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The number of entries per page. Maximum value: 100.\n\nDefault value: 10",
      "help_zh": "分页查询时设置的每页行数。最大值：100。\n\n默认值：10",
      "location": "query",
      "maximum": "100",
      "minimum": "1",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number.\n\nDefault value: 1",
      "help_zh": "快照列表的页码。\n\n默认值：1",
      "location": "query",
      "maximum": "1000",
      "minimum": "1",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "Data",
      "help_en": "The type of the source disk. Valid values:\n\nsystem: system disk.\n\ndata: data disk",
      "help_zh": "快照源云盘的云盘类型。取值范围：\nSystem：系统盘。\nData：数据盘",
      "location": "query",
      "name": "source_disk_type",
      "options": [
        "--source-disk-type"
      ],
      "raw_name": "SourceDiskType",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "fields": [
          {
            "example": "TestKey",
