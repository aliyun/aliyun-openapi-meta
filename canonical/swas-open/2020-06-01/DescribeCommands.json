  "kebab_example": "aliyun swas-open describe-commands --biz-region-id cn-hangzhou --provider AlibabaCloud --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeCommands",
  "operation": {
    "action": "DescribeCommands",
    "api_style": "RPC",
    "api_version": "2020-06-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
