{
  "camel_example": "aliyun dds DescribeBackups --region cn-hangzhou --DBInstanceId 'dds-bp1a7009eb240000'",
  "cmd_full_name": "dds describe-backups",
  "cmd_name": "describe-backups",
  "deprecated": false,
  "description_en": "Queries the backups of a MongoDB instance",
  "description_zh": "查询MongoDB实例的备份列表",
  "kebab_example": "aliyun dds describe-backups --db-instance-id dds-bp1a7009eb240000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeBackups",
  "operation": {
    "action": "DescribeBackups",
    "api_style": "RPC",
    "api_version": "2015-12-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "dds-bp1a7009eb24****",
      "help_en": "The ID of the instance.\n\nIf the instance is a sharded cluster instance, you must also specify the NodeId parameter",
      "help_zh": "实例ID。\n当本参数传入的是分片集群实例ID时，还需要传入NodeId参数",
      "location": "query",
      "name": "db_instance_id",
      "options": [
        "--db-instance-id"
      ],
      "raw_name": "DBInstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "d-bp128a003436****",
      "help_en": "The ID of the shard node in the sharded cluster instance.\n\nThis parameter is required if you specify the ID of a sharded cluster instance for the DBInstanceId parameter",
      "help_zh": "分片集群实例中Shard节点的ID。\n\n当DBInstanceId参数传入的是分片集群实例ID时，本参数必填",
      "location": "query",
      "name": "node_id",
      "options": [
        "--node-id"
      ],
      "raw_name": "NodeId",
      "required": false,
      "type": "string"
    },
    {
      "example": "2072****,2072****,2072****",
      "help_en": "The backup ID.\n\nIf you specify the ID of a sharded cluster instance for the DBInstanceId parameter, the number of backup IDs must be the same as the number of shard nodes. Separate the backup IDs with commas (,)",
      "help_zh": "备份ID。\n\n当DBInstanceId参数传入的是分片集群实例ID时，备份ID个数与Shard节点个数相同，中间用英文逗号（,）间隔",
      "location": "query",
      "name": "backup_id",
      "options": [
        "--backup-id"
      ],
      "raw_name": "BackupId",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. The value must be greater than 0 and not greater than the maximum value of the integer data type. Default value: 1",
      "help_zh": "页码，取值为大于0且不超过Integer数据类型的最大值，默认值为1",
      "location": "query",
      "minimum": "1",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "enum": [
        "30",
        "50",
        "100"
      ],
      "example": "30",
      "help_en": "The number of entries to return on each page. Valid values:\n\n30 (Default)\n\n50\n\n100",
      "help_zh": "每页记录数，取值：\n\n30（默认值）\n50\n100",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "2022-01-13T13:00Z",
      "help_en": "The beginning of the time range to query. Specify the time in the yyyy-MM-ddTHH:mmZ format. The time must be in Coordinated Universal Time (UTC).\n\nThis parameter is invalid if you specify the BackupId parameter",
      "help_zh": "查询开始时间，格式为<i>yyyy-MM-dd</i>T<i>HH:mm</i>Z（UTC时间）。\n\n\n当传入BackupId时，此参数无效",
      "location": "query",
      "name": "start_time",
      "options": [
        "--start-time"
      ],
      "raw_name": "StartTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "2022-01-14T13:00Z",
      "help_en": "The end of the time range to query. The end time must be later than the start time. Specify the time in the yyyy-MM-ddTHH:mmZ format. The time must be in UTC.\n\nThis parameter is invalid if you specify the BackupId parameter",
      "help_zh": "查询结束时间，必须晚于查询开始时间，格式为<i>yyyy-MM-dd</i>T<i>HH:mm</i>Z（UTC时间）。\n当传入BackupId时，此参数无效",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-beijing",
      "help_en": "The region where the instance resides.\n\nThis parameter is required to restore a deleted instance.\n\nThis parameter is required for geo-redundancy",
      "help_zh": "实例所在地域。\n\n\n已删除实例恢复必填。\n异地备份必填",
      "location": "query",
      "name": "src_region",
      "options": [
        "--src-region"
      ],
      "raw_name": "SrcRegion",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-hangzhou",
      "help_en": "The region where the backup resides.\n\nThis parameter is required for geo-redundancy",
      "help_zh": "备份所在地域。\n\n\n异地备份必填",
      "location": "query",
      "name": "dest_region",
      "options": [
        "--dest-region"
      ],
      "raw_name": "DestRegion",
      "required": false,
      "type": "string"
    },
    {
      "example": "rg-xxxx",
      "help_en": "The resource group ID",
      "help_zh": "资源组ID",
      "location": "query",
      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    },
    {
      "example": "775051",
      "help_en": "The backup job ID",
      "help_zh": "备份任务ID",
      "location": "query",
      "name": "backup_job_id",
      "options": [
        "--backup-job-id"
      ],
      "raw_name": "BackupJobId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Dds",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_zh": "实例备份信息",
        "properties": {
          "Backups": {
            "backendName": "data.backupItems",
            "itemName": "Backup",
            "items": {
              "properties": {
                "BackupDBNames": {
                  "backendName": "backupDbList",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupDownloadURL": {
                  "backendName": "backupDownloadURL",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupEndTime": {
                  "backendName": "backupEndTime",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupExpireTime": {
                  "backendName": "expectExpireTime",
                  "type": "string"
                },
                "BackupId": {
                  "backendName": "backupSetId",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupIntranetDownloadURL": {
                  "backendName": "backupIntranetDownloadURL",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupJobId": {
                  "backendName": "backupjobId",
                  "type": "string"
                },
                "BackupMethod": {
                  "backendName": "backupMethod",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Logical",
                        "value": "L"
                      },
                      {
                        "targetValue": "Physical",
                        "value": "P"
                      },
                      {
                        "targetValue": "Snapshot",
                        "value": "S"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "BackupMode": {
                  "backendName": "jobMode",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Automated",
                        "value": "0"
                      },
                      {
                        "targetValue": "Manual",
                        "value": "1"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "BackupName": {
                  "backendName": "backupName",
                  "type": "string"
                },
                "BackupScale": {
                  "backendName": "backupScale",
                  "type": "string"
                },
                "BackupSize": {
                  "backendName": "backupSetSize",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "BackupStartTime": {
                  "backendName": "backupStartTime",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupStatus": {
                  "backendName": "backupSetStatus",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Success",
                        "value": "0"
                      },
                      {
                        "targetValue": "Failed",
                        "value": "1"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "BackupType": {
                  "backendName": "backupType",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "FullBackup",
                        "value": "F"
                      },
                      {
                        "targetValue": "IncrementalBackup",
                        "value": "I"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "EngineVersion": {
                  "backendName": "engineVersion",
                  "type": "string"
                },
                "IsAvail": {
                  "backendName": "isAvail",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "data.pageNo",
            "description_en": "The page number",
            "description_zh": "页码",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "data.pageSize",
            "description_en": "The number of entries returned per page. Valid values:\n\n30 (Default)\n\n50\n\n100",
            "description_zh": "每页记录数，取值：\n\n30（默认值）\n50\n100",
            "example": "30",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "275D43C3-F12F-5224-B375-************",
            "type": "string",
            "visibility": "Public"
          },
          "TotalCount": {
            "backendName": "data.total",
            "description_en": "The total number of backups",
            "description_zh": "备份总数",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
