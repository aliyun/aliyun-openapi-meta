                  "description_zh": "备份任务状态。\nScheduled：计划中备份任务，包括未开始的常规备份任务。\nChecking：备份前实例检查。\nBackuping：备份中。\nFinished：备份完成",
                  "example": "Scheduled",
                  "title_en": "",
                  "title_zh": "",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Finished",
                        "value": "finish"
                      },
                      {
                        "targetValue": "Backuping",
                        "value": "backup"
                      },
                      {
                        "targetValue": "Checking",
                        "value": "check"
                      },
                      {
                        "targetValue": "Scheduled",
                        "value": "schedule"
                      }
                    ]
                  }
                },
                "BackupStartTime": {
                  "backendName": "backupStartTime",
                  "description_en": "The start time of the backup",
