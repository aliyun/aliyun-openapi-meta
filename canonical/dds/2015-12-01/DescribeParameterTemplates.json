                  "visibility": "Public"
                },
                "ParameterName": {
                  "backendName": "parameterName",
                  "type": "string",
                  "visibility": "Public"
                },
                "ParameterValue": {
                  "backendName": "parameterValue",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "BDA54203-9D61-54A3-A568-D281F785****",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
