{
  "camel_example": "aliyun dds DescribeParameterTemplates --region cn-hangzhou --EngineVersion '5.0' --RegionId 'cn-hangzhou' --Engine mongodb",
  "cmd_full_name": "dds describe-parameter-templates",
  "cmd_name": "describe-parameter-templates",
  "deprecated": false,
  "description_en": "Queries the default parameter templates for MongoDB instances",
  "description_zh": "查询MongoDB实例默认的参数模板列表",
  "kebab_example": "aliyun dds describe-parameter-templates --biz-region-id cn-hangzhou --engine mongodb --engine-version 5.0 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeParameterTemplates",
  "operation": {
    "action": "DescribeParameterTemplates",
    "api_style": "RPC",
    "api_version": "2015-12-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID. You can call the https://help.aliyun.com/document_detail/61933.html operation to query the most recent region list",
      "help_zh": "地域ID，您可以调用https://help.aliyun.com/document_detail/61933.html查询",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "mongodb",
      "help_en": "The database engine. Set the value to mongodb",
      "help_zh": "数据库引擎，取值：mongodb",
      "location": "query",
      "name": "engine",
      "options": [
        "--engine"
      ],
      "raw_name": "Engine",
      "required": true,
      "type": "string"
    },
    {
      "example": "5.0",
      "help_en": "The database version number. Valid values:\n\n7.0\n\n6.0\n\n5.0\n\n4.4\n\n4.2\n\n4.0\n\n3.4",
      "help_zh": "数据库版本号。取值如下：\n7.0\n6.0\n5.0\n4.4\n4.2\n4.0\n3.4",
      "location": "query",
      "name": "engine_version",
      "options": [
        "--engine-version"
      ],
      "raw_name": "EngineVersion",
      "required": true,
      "type": "string"
    },
    {
      "enum": [
        "normal",
        "db",
        "cs",
        "physical",
        "mongos"
      ],
      "example": "normal",
      "help_en": "The role of the instance. Valid values:\n\ndb: the shard role of a sharded cluster instance.\n\ncs: the config server role of a sharded cluster instance.\n\nmongos: the mongos role of a sharded cluster instance.\n\nnormal: the role of a replica set instance.\n\nphysical: the role of a single node instance.\n\nThe default value is normal",
      "help_zh": "实例的角色类型，取值说明：\n\ndb：分片集群shard角色。\ncs：分片集群config server角色。\nmongos：分片集群mongos角色。\nnormal: 副本集角色。\nphysical：单节点角色。\n\n默认值为normal",
      "location": "query",
      "name": "role",
      "options": [
        "--role"
      ],
      "raw_name": "Role",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Dds",
  "protocol": "HTTP|HTTPS",
  "responses": {
