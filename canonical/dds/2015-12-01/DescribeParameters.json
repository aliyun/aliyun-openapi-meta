{
  "camel_example": "aliyun dds DescribeParameters --region cn-hangzhou --DBInstanceId 'dds-bpxxxxxxxx'",
  "cmd_full_name": "dds describe-parameters",
  "cmd_name": "describe-parameters",
  "deprecated": false,
  "description_en": "Queries the parameter settings of an ApsaraDB for MongoDB instance",
  "description_zh": "查询MongoDB实例的参数配置信息",
  "kebab_example": "aliyun dds describe-parameters --db-instance-id dds-bpxxxxxxxx --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeParameters",
  "operation": {
    "action": "DescribeParameters",
    "api_style": "RPC",
    "api_version": "2015-12-01",
    "method": "POST",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "dds-bpxxxxxxxx",
      "help_en": "The instance ID.\n\nIf you set this parameter to the ID of a sharded cluster instance, you must also specify the NodeId parameter",
      "help_zh": "实例ID。\n\n当本参数传入的是分片集群实例ID时，还需要传入NodeId参数",
      "location": "query",
      "name": "db_instance_id",
      "options": [
        "--db-instance-id"
      ],
      "raw_name": "DBInstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "d-bpxxxxxxxx",
      "help_en": "The ID of the mongos or shard node in the specified sharded cluster instance.\n\nThis parameter is valid when the DBInstanceId parameter is set to the ID of a sharded cluster instance",
      "help_zh": "分片集群实例中的Mongos节点ID或Shard节点ID。\n\n当DBInstanceId参数传入的是分片集群实例ID时，本参数才可用",
      "location": "query",
      "name": "node_id",
      "options": [
        "--node-id"
      ],
      "raw_name": "NodeId",
      "required": false,
      "type": "string"
    },
    {
      "example": "mongos",
      "help_en": "The role of the instance. Valid values:\n\ndb: a shard node.\n\ncs: a Configserver node.\n\nmongos: a mongos node",
      "help_zh": "实例的角色类型，取值说明：\n\ndb：shard角色。\ncs：config server角色。\nmongos：mongos角色",
      "location": "query",
      "name": "character_type",
      "options": [
        "--character-type"
      ],
      "raw_name": "CharacterType",
      "required": false,
      "type": "string"
    },
    {
      "example": "terrform",
      "help_en": "The parameter that is available in the future",
      "help_zh": "扩展参数",
      "location": "query",
      "name": "extra_param",
      "options": [
        "--extra-param"
      ],
      "raw_name": "ExtraParam",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Dds",
  "protocol": "HTTP|HTTPS",
