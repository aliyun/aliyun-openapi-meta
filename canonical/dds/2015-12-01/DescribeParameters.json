                    "cases": [
                      {
                        "targetValue": "false",
                        "value": "0"
                      },
                      {
                        "targetValue": "true",
                        "value": "1"
                      }
                    ]
                  }
                },
                "ParameterDescription": {
                  "backendName": "parameterDescription",
                  "type": "string"
                },
                "ParameterName": {
                  "backendName": "parameterName",
                  "mappingResourcePropertyName": "$.Parameters[*].ParameterName",
                  "type": "string"
                },
                "ParameterValue": {
                  "backendName": "parameterValue",
                  "mappingResourcePropertyName": "$.Parameters[*].ParameterValue",
                  "type": "string"
