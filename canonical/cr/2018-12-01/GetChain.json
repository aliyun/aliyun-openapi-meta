{
  "camel_example": "aliyun cr GetChain --region cn-hangzhou --InstanceId 'cri-4cdrlqmhn4gm0000' --ChainId 'chi-0ops0gsmw5x20000'",
  "cmd_full_name": "cr get-chain",
  "cmd_name": "get-chain",
  "deprecated": false,
  "description_en": "Obtain the delivery chain definition to understand the execution order of edge zones in the delivery chain",
  "description_zh": "获取交付链定义，用于了解交付链的节点执行顺序",
  "kebab_example": "aliyun cr get-chain --instance-id cri-4cdrlqmhn4gm0000 --chain-id chi-0ops0gsmw5x20000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetChain",
  "operation": {
    "action": "GetChain",
    "api_style": "RPC",
    "api_version": "2018-12-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cri-4cdrlqmhn4gm****",
      "help_en": "Instance ID  ",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "chi-0ops0gsmw5x2****",
      "help_en": "Delivery chain ID  ",
      "help_zh": "交付链ID",
      "location": "query",
      "name": "chain_id",
      "options": [
        "--chain-id"
      ],
      "raw_name": "ChainId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "cr",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ChainConfig": {
            "backendName": "data.chainConfig",
            "description_en": "Delivery chain configuration description",
            "description_zh": "交付链配置描述",
            "nullToEmpty": false,
            "properties": {
              "ChainConfigId": {
                "backendName": "chainConfigId",
                "description_en": "Delivery chain configuration ID",
                "description_zh": "交付链配置ID",
                "example": "cci-lz3ycgo69ukt****",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "IsActive": {
                "backendName": "isActive",
                "description_en": "Indicates whether the delivery chain configuration is active. Valid values:\n\n`true`: The configuration is active.\n\n`false`: The configuration is not active",
                "description_zh": "交付链配置是否有生效，取值：\n\n`true`：生效\n\n`false`：不生效",
                "example": "true",
                "nullToEmpty": false,
                "type": "boolean",
                "visibility": "Public"
              },
              "Nodes": {
                "backendName": "nodes",
                "description_en": "Each edge zone in the delivery chain",
                "description_zh": "交付链中的每一个节点",
                "itemName": "Nodes",
                "items": {
                  "properties": {
                    "Enable": {
                      "backendName": "enable",
                      "description_en": "Indicates whether to enable the delivery chain edge zone. Valid values:\n\n`true`: Enable the delivery chain edge zone.\n\n`false`: Do not enable the delivery chain edge zone",
                      "description_zh": "是否启用该交付链节点，取值：\n\n`true`：启用交付链节点\n\n`false`：不启用交付链节点",
                      "example": "true",
                      "nullToEmpty": false,
                      "type": "boolean",
                      "visibility": "Public"
                    },
                    "NodeConfig": {
                      "backendName": "nodeConfig",
                      "description_en": "Delivery chain edge zone configuration",
                      "description_zh": "交付链节点配置",
                      "nullToEmpty": false,
                      "properties": {
                        "DenyPolicy": {
                          "backendName": "denyPolicy",
                          "description_en": "Deny rules for scan nodes in the delivery chain",
                          "description_zh": "交付链节点中扫描节点的阻断规则",
                          "nullToEmpty": false,
                          "properties": {
                            "Action": {
                              "backendName": "action",
                              "description_en": "Deny action. Valid values:\n\n`BLOCK`: Block further execution of the delivery chain\n\n`BLOCK_RETAG`: Block overwriting and pushing image tags\n\n`BLOCK_DELETE_TAG`: Block deleting image tags",
                              "description_zh": "阻断动作，取值：\n\n`BLOCK`：阻断交付链继续执行\n\n`BLOCK_RETAG`：阻断覆盖推送镜像 tag\n\n`BLOCK_DELETE_TAG`：阻断删除镜像 tag",
                              "example": "BLOCK",
                              "type": "string"
                            },
                            "BaselineList": {
                              "backendName": "baselineList",
                              "description_en": "Collection of baseline samples to block. Separate multiple baseline sample names with commas",
                              "description_zh": "需要阻断的基线样本集合，多个基线样本名用英文逗号分隔",
                              "example": "identification,hc_image_exploit",
                              "type": "string"
                            },
                            "IssueCount": {
                              "backendName": "issueCount",
                              "description_en": "Number of scanned vulnerabilities that triggers a block",
                              "description_zh": "扫描漏洞数达到多少时触发阻断",
                              "example": "10",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            },
                            "IssueLevel": {
                              "backendName": "issueLevel",
                              "description_en": "The vulnerability Level at which blocking is triggered during a scan  ",
                              "description_zh": "扫描漏洞等级达到多少时触发阻断",
                              "example": "HIGH",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            },
                            "IssueList": {
                              "backendName": "issueList",
                              "description_en": "Collection of CVE vulnerabilities to block. Separate multiple CVE vulnerability names with commas",
                              "description_zh": "需要阻断的CVE漏洞集合，多个CVE漏洞名用英文逗号分隔",
                              "example": "CVE-2020-8286,CVE-2020-8285",
                              "type": "string"
                            },
                            "Logic": {
                              "backendName": "logic",
                              "description_en": "The logic that triggers blocking upon scan detection  ",
                              "description_zh": "扫描触发阻断的逻辑",
                              "example": "AND",
                              "nullToEmpty": false,
                              "type": "string",
                              "visibility": "Public"
                            },
                            "MaliciousList": {
                              "backendName": "maliciousList",
                              "description_en": "The collection of malicious samples to block, with multiple sample names separated by commas  ",
                              "description_zh": "需要阻断的恶意样本集合，多个恶意样本名用英文逗号分隔",
                              "example": "mutate_cockhorse,abnormal_program",
                              "type": "string"
                            }
                          },
                          "type": "object",
                          "visibility": "Public"
                        },
                        "Retry": {
                          "backendName": "retry",
                          "description_en": "Retry Count  ",
                          "description_zh": "重试次数",
                          "example": "3",
                          "format": "int32",
                          "nullToEmpty": false,
                          "type": "integer",
                          "visibility": "Public"
                        },
                        "ScanEngine": {
                          "backendName": "scanEngine",
                          "description_en": "Scan engine for the delivery chain node  \n\n`SAS_SCAN_SERVICE`, Security Center scan engine (requires paid activation)  \n`ACR_SCAN_SERVICE`, ACR scan engine  ",
                          "description_zh": "交付链扫描节点引擎\n\n`SAS_SCAN_SERVICE`, 云安全扫描引擎（需要付费开通）\n`ACR_SCAN_SERVICE`, ACR扫描引擎",
                          "example": "ACR_SCAN_SERVICE",
                          "type": "string"
                        },
                        "Timeout": {
                          "backendName": "timeout",
                          "description_en": "Timeout (in seconds)",
                          "description_zh": "超时时间（单位秒）",
                          "example": "900",
                          "format": "int64",
                          "nullToEmpty": false,
                          "type": "integer",
                          "visibility": "Public"
                        }
                      },
                      "type": "object",
                      "visibility": "Public"
                    },
                    "NodeName": {
                      "backendName": "nodeName",
                      "description_en": "Delivery chain edge zone name",
                      "description_zh": "交付链节点名称",
                      "example": "VULNERABILITY_SCANNING",
                      "nullToEmpty": false,
                      "type": "string",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": false,
                "type": "array",
                "visibility": "Public"
              },
              "Routers": {
                "backendName": "routers",
                "description_en": "Execution order relationships between edge zones in the delivery chain",
                "description_zh": "交付链节点间执行顺序关系",
                "itemName": "Routers",
                "items": {
                  "properties": {
                    "From": {
                      "backendName": "from",
                      "description_en": "source edge zone",
                      "description_zh": "源节点",
                      "nullToEmpty": false,
                      "properties": {
                        "NodeName": {
                          "backendName": "nodeName",
                          "description_en": "source edge zone name",
                          "description_zh": "源节点名称",
                          "example": "DOCKER_IMAGE_BUILD",
                          "nullToEmpty": false,
                          "type": "string",
                          "visibility": "Public"
                        }
                      },
                      "type": "object",
                      "visibility": "Public"
                    },
                    "To": {
                      "backendName": "to",
                      "description_en": "destination edge zone",
                      "description_zh": "目的节点",
                      "nullToEmpty": false,
                      "properties": {
                        "NodeName": {
                          "backendName": "nodeName",
                          "description_en": "destination edge zone name",
                          "description_zh": "目的节点名称",
                          "example": "DOCKER_IMAGE_PUSH",
                          "nullToEmpty": false,
                          "type": "string",
                          "visibility": "Public"
                        }
                      },
                      "type": "object",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": false,
                "type": "array",
                "visibility": "Public"
              },
              "Version": {
                "backendName": "version",
                "description_en": "Delivery chain version",
                "description_zh": "交付链版本",
                "example": "1",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "ChainId": {
            "backendName": "data.chainId",
            "description_en": "Delivery chain ID  ",
            "description_zh": "交付链ID",
            "example": "chi-0ops0gsmw5x2****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Code": {
            "backendName": "code",
            "description_en": "Return code",
            "description_zh": "返回码",
            "example": "success",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "CreateTime": {
            "backendName": "data.gmtCreate",
            "description_en": "Delivery chain creation time",
            "description_zh": "交付链创建时间",
            "example": "1638255427000",
            "format": "int64",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "Description": {
            "backendName": "data.description",
            "description_en": "Delivery chain description",
            "description_zh": "交付链描述",
            "example": "description",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "InstanceId": {
            "backendName": "data.instanceId",
            "description_en": "Instance ID",
            "description_zh": "实例ID",
            "example": "cri-4cdrlqmhn4gm****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "IsSuccess": {
            "backendName": "success",
            "description_en": "Indicates whether the operation succeeded",
            "description_zh": "是否成功",
            "example": "true",
            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          },
          "ModifiedTime": {
            "backendName": "data.gmtModified",
            "description_en": "Updated At of the delivery chain description  ",
            "description_zh": "交付链描述修改时间",
            "example": "1638259914000",
            "format": "int64",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "Name": {
            "backendName": "data.name",
            "description_en": "Delivery chain name",
            "description_zh": "交付链名称",
            "example": "test",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "C87993B5-7D61-5CAC-8D64-1AC732DD69FF",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "ScopeExclude": {
            "backendName": "data.scopeExclude",
            "description_en": "Collection of repositories excluded from delivery chain execution",
            "description_zh": "不被交付链执行的仓库集合",
            "itemName": "scopeExclude",
            "items": {
              "description_en": "Names of repositories excluded from delivery chain execution, separated by commas",
              "description_zh": "不被交付链执行的仓库名，多个仓库名用英文逗号分隔",
              "example": "repo_name1,repo_name2\n",
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "ScopeId": {
            "backendName": "data.scopeId",
            "description_en": "Delivery chain scope ID",
            "description_zh": "交付链作用域ID",
            "example": "crr-nyrh2oko32xb****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "ScopeType": {
            "backendName": "data.scopeType",
            "description_en": "Delivery chain scope type",
            "description_zh": "交付链作用域类型",
            "example": "REPOSITORY",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
