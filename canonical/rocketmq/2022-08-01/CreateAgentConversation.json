      "help_zh": "会话标题",
      "location": "body",
      "name": "title",
      "options": [
        "--title"
      ],
      "param_style": "json",
      "raw_name": "title",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/conversations",
