    "req_body_type": "json",
    "system_operation_type": "create",
    "url": "/api/v1/conversations"
  },
  "parameters": [
    {
      "example": "conversation-request-001",
      "help_en": "The client token used to ensure idempotency. If the same token and parameters are used within 24 hours, the result of the first request is returned. If the same token is used with different parameters, a conflict error is returned. Reuse the token for retries and use a new token for new operations",
      "help_zh": "请求幂等令牌；24 小时内相同 token 和参数返回首次结果；同 token 不同参数返回冲突；重试复用，新操作换新 token",
      "location": "body",
      "max_length": "64",
      "min_length": "1",
      "name": "client_token",
      "options": [
        "--client-token"
      ],
      "param_style": "json",
      "pattern": "^[A-Za-z0-9_-]+$",
      "raw_name": "clientToken",
      "required": true,
      "type": "string"
    },
    {
      "fields": [
        {
          "example": "告警发生于 10:00",
          "help_en": "The supplementary context from the client",
          "help_zh": "客户端补充上下文",
          "name": "client_context",
          "options": [
            "--client-context"
          ],
          "raw_name": "clientContext",
          "required": false,
          "type": "string"
        },
        {
          "element": {
            "fields": [
              {
                "example": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR4nGNgAAIAAAUAAXpeqz8AAAAASUVORK5CYII=",
                "help_en": "The Base64-encoded data of the image, excluding the data URL prefix",
                "help_zh": "不含 Data URL 前缀的图片 Base64 数据",
                "max_length": "2800000",
                "min_length": "1",
                "name": "data_base64",
                "options": [
                  "--data-base64"
                ],
                "raw_name": "dataBase64",
                "required": true,
                "type": "string"
              },
              {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/gif",
                  "image/webp"
                ],
                "example": "image/png",
                "help_en": "The media type of the image",
                "help_zh": "图片媒体类型",
                "name": "media_type",
                "options": [
                  "--media-type"
                ],
                "raw_name": "mediaType",
                "required": true,
                "type": "string"
              }
            ],
            "type": "object"
          },
          "help_en": "The images sent with the initial message. You can send up to two images. The recommended size of each original image is 2 MiB or less",
          "help_zh": "随首条消息发送的图片，最多 2 张；单张原图建议不超过 2 MiB",
          "name": "images",
          "options": [
            "--images"
          ],
          "raw_name": "images",
          "required": false,
          "type": "array"
        },
        {
          "example": "请排查实例消息堆积原因",
          "help_en": "The initial diagnostic message. You must specify at least one of the message and images parameters",
          "help_zh": "首条诊断消息；message 和 images 至少提供一项",
          "max_length": "50000",
          "min_length": "0",
          "name": "message",
          "options": [
            "--message"
          ],
          "raw_name": "message",
          "required": true,
          "type": "string"
        },
        {
          "enum": [
            "ticket_request"
          ],
          "example": "ticket_request",
          "help_en": "The special message type. A value of ticket_request requests the agent to draft a ticket. For regular issues and draft corrections, omit this parameter. The ticket is then reviewed and submitted by the frontend",
          "help_zh": "特殊消息类型：ticket_request 请求 Agent 起草工单；普通问题及草稿订正省略，工单由前端审阅后提交",
          "name": "message_type",
          "options": [
            "--message-type"
          ],
          "raw_name": "messageType",
          "required": false,
          "type": "string"
        },
        {
          "example": "ticket-request-example-001",
          "help_en": "The unique identifier of the ticket request. This parameter must be specified together with messageType. The value must be 1 to 64 characters in length, and can contain letters, digits, underscores, and hyphens",
          "help_zh": "提单请求唯一标识，与 messageType 成对传入，1 至 64 个字母、数字、下划线或连字符",
          "max_length": "64",
          "min_length": "1",
          "name": "ticket_request_id",
          "options": [
            "--ticket-request-id"
          ],
          "raw_name": "ticketRequestId",
          "required": false,
          "type": "string"
        }
      ],
      "help_en": "The optional initial message. If provided, the session is created and the first round of diagnosis starts immediately",
      "help_zh": "可选首条消息；传入后创建会话并立即启动首轮诊断",
      "location": "body",
      "name": "initial_message",
      "options": [
        "--initial-message"
      ],
      "param_style": "json",
      "raw_name": "initialMessage",
      "required": false,
      "type": "object"
    },
    {
      "example": "消息堆积排查",
