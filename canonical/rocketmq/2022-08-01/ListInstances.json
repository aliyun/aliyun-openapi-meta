{
  "camel_example": "aliyun rocketmq GET /instances --region cn-hangzhou --filter 'rmq-cn-7e22ody0000' --pageNumber 1 --storageSecretKey xxxxx --pageSize 10 --resourceGroupId 'rg-acfmx7caj000000' --seriesCodes standard --tags 'key_:_rmq-test_,_value_:_test' --header \"Content-Type=application/json\"",
