{
  "camel_example": "aliyun rocketmq PATCH /instances/rmq-cn-tl32ue44x0g/consumerGroups/dolphin_status/consumeOffsets/AMZN_REPORT_TOPIC --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "rocketmq reset-consume-offset",
  "cmd_name": "reset-consume-offset",
  "deprecated": false,
  "description_en": "Resets the consumer offset of a consumer group. If you reset a consumer offset, the offset from which a consumer starts to consume messages is changed. If faults occur or wrong messages are consumed during message consumption, you can reset the consumer offset to roll back the consumption to a specific offset for reconsumption. You can also reset the consumer offset to the latest offset and temporarily leave the accumulated messages unhandled",
  "description_zh": "重置指定消费者分组的消费位点。重置消费位点是指改变订阅者当前的消费位置。当消费者出现故障或者消费错误数据时，您可通过重置消费位点将消费位置回滚到之前的某个位点重新开始消费，您也可以将消费位置移动至最新位点，暂时不处理堆积的消息",
  "kebab_example": "aliyun rocketmq reset-consume-offset --instance-id rmq-cn-tl32ue44x0g --consumer-group-id dolphin_status --topic-name AMZN_REPORT_TOPIC --region cn-hangzhou",
