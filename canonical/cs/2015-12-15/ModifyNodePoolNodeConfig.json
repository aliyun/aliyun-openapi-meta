{
  "camel_example": "aliyun cs PUT /clusters/c23421cfa74454bc8b37163fd19af0000/nodepools/np8d8c9c2cd0f64e89884f82a5fbcd0000/node_config --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"rolling_policy\":{\"max_parallelism\":3,\"max_failed_nodes\":0},\"node_names\":[\"cn-beijing.10.180.xx.xx\"],\"kubelet_config\":\"example-string\",\"containerd_config\":\"example-string\",\"os_config\":{\"hugepage\":\"example-string\",\"sysctl\":{\"key\":\"example-string\"}}}",
