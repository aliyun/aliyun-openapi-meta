  "camel_example": "aliyun cs PUT /tags --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"resource_type\":\"CLUSTER\",\"region_id\":\"cn-hangzhou\",\"resource_ids\":[\"c1a7bb282fc0d48b0000\"],\"tags\":[\"example-string\"]}",
