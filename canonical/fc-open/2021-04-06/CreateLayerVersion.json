  "pathPattern": "/2021-04-06/layers/[layerName]/versions",
  "product_code": "FC-Open",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "headers": {
        "ETag": {
          "schema": {
            "type": "string"
          }
        }
      },
      "schema": {
        "description_en": "The details of the layer",
        "description_zh": "层的详细信息",
        "properties": {
          "acl": {
            "description_en": "The access mode of the layer. A value of 0 indicates private, and a value of 1 indicates public. Official public layers are public by default. Custom layers can be set to private or public",
            "description_zh": "层的访问模式。\n取值0代表私有，取值1代表公有。官方公共层默认为公有，自定义层可以设置为私有或者公有",
            "example": "0",
            "format": "int32",
            "type": "integer"
          },
          "arn": {
            "description_en": "The Alibaba Cloud Resource Name (ARN) of the layer resource",
            "description_zh": "层资源的名称",
            "example": "xxxxxxxx#Layer-name#1",
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/OutputCodeLocation",
            "description_en": "The code package information of the layer",
            "description_zh": "层的代码包信息"
          },
          "codeChecksum": {
            "description_en": "The CRC-64 checksum of the layer code package, calculated based on the ECMA-182 standard",
            "description_zh": "层代码包的crc64校验码，根据ECMA-182标准计算得出",
            "example": "2825179536350****",
            "type": "string"
          },
          "codesize": {
            "description_en": "The size of the code package of the layer. Unit: bytes",
            "description_zh": "层的代码包大小，单位为Byte",
            "example": "421",
            "format": "int64",
            "type": "integer"
          },
          "compatibleRuntime": {
            "description_en": "The list of runtime environments supported by the layer",
            "description_zh": "层支持的运行时环境列表",
            "itemName": "runtime",
            "items": {
              "description_en": "The runtime name. Valid values: nodejs20, nodejs18, nodejs16, nodejs14, nodejs12, nodejs10, nodejs8, nodejs6, python3.10, python3.9, python3, python2.7, java11, java8, php7.2, go1, dotnetcore3.1, dotnetcore2.1, custom.debian10, and custom",
              "description_zh": "运行时名称。当前支持nodejs20、nodejs18、nodejs16、nodejs14、nodejs12、nodejs10、nodejs8、nodejs6、python3.10、python3.9、python3、python2.7、java11、java8、php7.2、go1、dotnetcore3.1、dotnetcore2.1、custom.debian10和custom",
              "example": "python3",
              "type": "string"
            },
            "type": "array"
          },
          "createTime": {
            "description_en": "The time when the layer version was created. Format: yyyy-MM-ddTHH:mm:ssZ",
            "description_zh": "层版本的创建时间，格式：yyyy-MM-ddTHH:mm:ssZ",
            "example": "2022-01-01T11:08:00Z",
            "type": "string"
          },
          "description": {
            "description_en": "The description of the version",
            "description_zh": "版本的描述信息",
            "example": "the first layer",
            "type": "string"
          },
          "layerName": {
            "description_en": "The name of the layer",
            "description_zh": "层的名称",
            "example": "MyLayer",
            "type": "string"
          },
          "version": {
            "description_en": "The version of the layer",
            "description_zh": "层的版本",
            "example": "1",
            "format": "int32",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
