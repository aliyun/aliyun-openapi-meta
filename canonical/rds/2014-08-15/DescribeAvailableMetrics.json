                  "example": "cpu_sys_per_core",
                  "type": "string",
                  "visibility": "Public"
                },
                "SortRule": {
                  "backendName": "sortRule",
                  "description_en": "The serial number of the Enhanced Monitoring metric",
                  "description_zh": "增强指标编号",
