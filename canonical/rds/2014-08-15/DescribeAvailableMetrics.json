                  "description_zh": "增强指标描述信息",
                  "example": "sys cpu使用率，sys cpu使用量 / cpu总量",
                  "type": "string",
                  "visibility": "Public"
                },
                "Dimension": {
                  "backendName": "dimension",
                  "description_en": "The category of the Enhanced Monitoring metric. Valid values:\n\nos: OS metric\ndb: database metric",
                  "description_zh": "增强指标类别。返回值：\nos：操作系统指标。\ndb：数据库指标",
                  "example": "os",
                  "type": "string",
                  "visibility": "Public"
                },
                "GroupKey": {
                  "backendName": "groupKey",
                  "description_en": "The key of the group to which the Enhanced Monitoring metric belongs",
                  "description_zh": "增强指标所在分组的Key",
                  "example": "os.cpu_usage",
                  "type": "string",
                  "visibility": "Public"
                },
                "GroupKeyType": {
                  "backendName": "groupKeyType",
                  "description_en": "The name of the group to which the Enhanced Monitoring metric belongs",
