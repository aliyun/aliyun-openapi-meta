      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Rds",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回参数详情",
        "properties": {
          "DBInstanceName": {
            "backendName": "dBInstanceName",
            "description_en": "The instance ID",
            "description_zh": "\n实例ID",
            "example": "rm-bp1****",
            "mappingResourcePropertyName": "$.DbInstanceId",
            "type": "string"
          },
          "Items": {
            "backendName": "data.metricList",
            "description_en": "Details of the Enhanced Monitoring metric",
            "description_zh": "增强监控指标列表",
