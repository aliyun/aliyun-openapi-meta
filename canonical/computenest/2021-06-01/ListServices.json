{
  "camel_example": "aliyun computenest ListServices --region cn-hangzhou --Tag.1.Key key1 --NextToken 'BBBAAfu+XtuBE55iRLHEYYuojI4=' --Filter.1.Value.1 1 --MaxResults 20 --Tag.1.Value value1 --ServiceAccessType All --InUsed false --RegionId 'cn-hangzhou' --Filter.1.Name Status --FuzzyKeyword name --OrderByType UpdateTime",
  "cmd_full_name": "computenest list-services",
  "cmd_name": "list-services",
  "deprecated": false,
  "description_en": "Queries information about your services",
