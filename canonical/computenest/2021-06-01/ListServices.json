  "pathPattern": "",
  "product_code": "ComputeNest",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "MaxResults": {
            "backendName": "maxResults",
            "description_en": "The number of entries returned per page. Maximum value: 100. Default value: 20",
            "description_zh": "分页查询时，每页显示的行数。每页最大100行，默认为20行",
            "example": "20",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "NextToken": {
            "backendName": "nextToken",
            "description_en": "The token for the next query",
            "description_zh": "下一个查询开始Token",
            "example": "AAAAAfu+XtuBE55iRLHEYYuojI41",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "3F976EF8-C10A-57DC-917C-BB7BEB508FFB",
            "type": "string",
            "visibility": "Public"
          },
          "Services": {
            "backendName": "data",
            "description_en": "The list of services",
            "description_zh": "服务列表",
            "itemName": "Service",
            "items": {
              "description_en": "The list of services",
              "description_zh": "服务列表",
              "properties": {
                "Categories": {
                  "backendName": "categories",
                  "description_en": "The category of the data disk. Valid values:\n\ncloud_efficiency: ultra disk.\n\ncloud_ssd: standard SSD.\n\ncloud_essd: ESSD.\n\ncloud: basic disk",
                  "description_zh": "数据盘的种类。取值范围：\n\ncloud_efficiency：高效云盘。\n\ncloud_ssd：SSD云盘。\n\ncloud_essd：ESSD云盘。\n\ncloud：普通云盘",
                  "example": "cloud_ssd",
                  "type": "string",
                  "visibility": "Public"
                },
                "Commodity": {
                  "backendName": "commodity",
                  "description_en": "The commodity specifications",
                  "description_zh": "商品规格",
                  "properties": {
                    "CommodityCode": {
                      "backendName": "commodityCode",
                      "description_en": "The commodity specification code",
                      "description_zh": "商品规格码",
                      "example": "cmjj00****\n\n",
                      "type": "string"
                    },
                    "DeployPage": {
                      "backendName": "deployPage",
                      "description_en": "The deployment page",
                      "description_zh": "部署页面",
                      "example": "Order: Order page\nDetail: Details page",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "CommodityCode": {
                  "backendName": "commodityCode",
                  "description_en": "The commodity code of the service in Alibaba Cloud Marketplace",
                  "description_zh": "云市场商品code",
                  "example": "cmjj00xxxx",
                  "type": "string"
                },
                "DeployFrom": {
                  "backendName": "deployFrom",
                  "description_en": "The deployment source of the service. Valid values:\n\nNoWhere: The service has no deployment source.\n\nMarketplace: The service is deployed from Alibaba Cloud Marketplace.\n\nComputeNest: The service is deployed from Compute Nest",
                  "description_zh": "服务部署途径。可选值：\n\nNoWhere：没有部署途径。\n\nMarketplace：从云市场部署。\n\nComputeNest：从计算巢部署",
                  "example": "ComputeNest",
                  "type": "string"
                },
                "DeployType": {
                  "backendName": "deployType",
                  "description_en": "The deployment type. Valid values:\n\nros: The service is deployed using ROS.\n\nterraform: The service is deployed using Terraform.\n\nspi: The service is deployed by calling SPI",
                  "description_zh": "部署类型。可能值：\n\nros：通过ROS部署。\n\nterraform：通过Terraform部署。\n\nspi：调用SPI部署",
                  "example": "ros",
                  "type": "string",
                  "visibility": "Public"
                },
                "PublishTime": {
                  "backendName": "launchTime",
                  "description_en": "The time when the service was published",
                  "description_zh": "发布时间",
                  "example": "2022-01-21T10:35:44Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "Score": {
                  "backendName": "score",
                  "description_en": "The service score",
                  "description_zh": "服务分数",
                  "example": "5",
                  "format": "int32",
                  "type": "integer"
                },
                "ServiceId": {
                  "backendName": "serviceId",
                  "description_en": "The service ID",
                  "description_zh": "服务ID",
                  "example": "service-6b5d632edd394dxxxxxx",
                  "type": "string",
                  "visibility": "Public"
                },
                "ServiceInfos": {
                  "backendName": "serviceInfos",
                  "description_en": "The service information",
                  "description_zh": "服务信息",
                  "itemName": "ServiceInfo",
                  "items": {
                    "description_en": "The service information",
                    "description_zh": "服务信息",
                    "properties": {
                      "Image": {
                        "backendName": "image",
                        "description_en": "The URL of the service icon",
                        "description_zh": "服务图标地址",
                        "example": "http://img.tidb.oss.url",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "Locale": {
                        "backendName": "locale",
                        "description_en": "The language of the service configuration. Valid values:\n\nzh-CN: Chinese.\n\nen-US: English",
                        "description_zh": "服务配置语言。可能的值：\n\nzh-CN：中文。\n\nen-US：英文",
                        "example": "zh-CN",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "Name": {
                        "backendName": "name",
                        "description_en": "The service name",
                        "description_zh": "服务名称",
                        "example": "Database B",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "ShortDescription": {
                        "backendName": "shortDescription",
                        "description_en": "The service overview",
                        "description_zh": "服务概述",
                        "example": "B is an open-source distributed relational database independently designed and developed by Company A.",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "Softwares": {
                        "backendName": "softwareInfos",
                        "description_en": "The software information of the service",
                        "description_zh": "服务软件信息",
                        "itemName": "Softwares",
                        "items": {
                          "description_en": "The software information of the service",
                          "description_zh": "服务软件信息",
                          "properties": {
                            "Name": {
                              "backendName": "name",
                              "description_en": "The software name",
                              "description_zh": "软件名称",
                              "example": "wordpress",
                              "type": "string"
                            },
                            "Version": {
                              "backendName": "version",
                              "description_en": "The software version",
                              "description_zh": "软件版本",
                              "example": "6.0.1",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array",
                  "visibility": "Public"
                },
                "ServiceLocaleConfigs": {
                  "backendName": "serviceLocaleConfigs",
                  "description_en": "The multi-language configurations of the service",
                  "description_zh": "服务多语言配置",
                  "itemName": "ServiceLocaleConfigs",
                  "items": {
                    "description_en": "The multi-language configurations of the service",
                    "description_zh": "服务多语言配置",
                    "properties": {
                      "EnValue": {
                        "backendName": "enValue",
                        "description_en": "The English value of the business information",
                        "description_zh": "业务信息对应的英文数据值",
                        "example": "Service Name\n",
                        "type": "string"
                      },
                      "OriginalValue": {
                        "backendName": "originalValue",
                        "description_en": "The raw data value of the business information",
                        "description_zh": "业务信息原始数据值",
                        "example": "Service Name\n",
                        "type": "string"
                      },
                      "ZhValue": {
                        "backendName": "zhValue",
                        "description_en": "The Chinese value of the business information",
                        "description_zh": "业务信息对应的中文数据值",
                        "example": "服务名称",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "ServiceProductUrl": {
                  "backendName": "serviceProductUrl",
                  "description_en": "The URL of the product page",
                  "description_zh": "产品页URL",
                  "example": "http://example1.com",
                  "type": "string",
                  "visibility": "Public"
                },
                "ServiceType": {
                  "backendName": "serviceType",
                  "description_en": "The service type. Valid values:\n\nprivate: The service is deployed in the user's account.\n\nmanaged: The service is hosted in the service provider's account.\n\noperation: The service is an Alibaba Cloud Managed Service",
                  "description_zh": "服务类型。可能值：\n\nprivate：部署在用户账户下。\n\nmanaged：托管在服务商账户下。\n\noperation：代运维服务",
                  "example": "private",
                  "type": "string",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The service status. Valid values:\n\nDraft: The service is in the draft state.\n\nSubmitted: The service is submitted for review. You cannot modify the service.\n\nApproved: The service is approved. You cannot modify the service, but you can publish it.\n\nLaunching: The service is being published.\n\nOnline: The service is published.\n\nOffline: The service is unpublished",
                  "description_zh": "服务状态。可能的值：\n\nDraft：草稿状态。\n\nSubmitted：已提交审核。不允许修改。\n\nApproved：已通过审核。不允许修改，可以发布上线。\n\nLaunching：服务上线中。\n\nOnline：已上线。\n\nOffline：已下线",
                  "example": "Online",
                  "type": "string",
                  "visibility": "Public"
                },
                "SupplierName": {
                  "backendName": "supplierName",
                  "description_en": "The service provider name",
                  "description_zh": "服务商名称",
                  "example": "Company A Ltd.",
                  "type": "string",
                  "visibility": "Public"
                },
                "SupplierNameEng": {
                  "backendName": "supplierNameEng",
                  "description_en": "The English name of the service provider",
                  "description_zh": "服务商英文名称",
                  "example": "Alibaba Cloud",
                  "type": "string",
                  "visibility": "Public"
                },
                "SupplierUid": {
                  "backendName": "aliUid",
                  "description_en": "The Alibaba Cloud account ID of the service provider",
                  "description_zh": "服务商AliUid",
                  "example": "1436322xxxxx",
                  "format": "int64",
                  "type": "integer"
                },
                "SupplierUrl": {
                  "backendName": "supplierUrl",
                  "description_en": "The service provider's URL",
                  "description_zh": "服务商地址",
                  "example": "http://example.com",
                  "type": "string",
                  "visibility": "Public"
                },
                "Tags": {
                  "backendName": "tags",
                  "description_en": "The service tags",
                  "description_zh": "服务标签",
                  "itemName": "Tag",
                  "items": {
                    "description_en": "The service tags",
                    "description_zh": "服务标签",
                    "properties": {
                      "Key": {
                        "backendName": "key",
                        "description_en": "The tag key",
                        "description_zh": "标签键",
                        "example": "key1",
                        "type": "string"
                      },
                      "Value": {
                        "backendName": "value",
                        "description_en": "The tag value",
                        "description_zh": "标签值",
                        "example": "value1",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "TenantType": {
                  "backendName": "tenantType",
                  "description_en": "The tenant type. Valid values:\n\nSingleTenant: single-tenant.\n\nMultiTenant: multi-tenant",
                  "description_zh": "租户类型。可选值：\n\nSingleTenant：单租户。\n\nMultiTenant：多租户",
                  "example": "SingleTenant",
                  "type": "string"
                },
                "TrialDuration": {
                  "backendName": "trialDuration",
                  "description_en": "The trial duration. Unit: days. The maximum trial duration is 30 days",
                  "description_zh": "试用时长。单位：天。试用时长的最长天数不超过30天",
                  "example": "7",
                  "type": "string"
                },
                "TrialType": {
                  "backendName": "trialType",
                  "description_en": "The trial type. Valid values:\n\nTrial: The service supports trial.\n\nNotTrial: The service does not support trial",
                  "description_zh": "试用类型。可选值：\n\nTrial：支持试用。\n\nNotTrial：不支持试用",
                  "example": "Trial",
                  "type": "string"
                },
                "Version": {
                  "backendName": "version",
                  "description_en": "The service version",
                  "description_zh": "服务版本",
                  "example": "4",
                  "type": "string",
                  "visibility": "Public"
                },
                "VersionName": {
                  "backendName": "versionName",
                  "description_en": "The custom version name defined by the service provider",
                  "description_zh": "服务商自定义版本名称",
                  "example": "v2.0.0",
                  "type": "string"
                },
                "VirtualInternetService": {
                  "backendName": "virtualInternetService",
                  "description_en": "Indicates whether the service is a virtual Internet service. Valid values:\n\nfalse: No.\n\ntrue: Yes",
                  "description_zh": "是否是虚拟互联网服务。可能的值：\n\nfalse：否。\n\ntrue：是",
                  "example": "false",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "TotalCount": {
            "backendName": "count",
            "description_en": "The total number of results",
            "description_zh": "结果总数",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
