{
  "camel_example": "aliyun edas POST /pop/v5/app/app_info --region cn-hangzhou --AppId 29f0000000000000000000 --header \"Content-Type=application/json\"",
  "cmd_full_name": "edas get-application",
  "cmd_name": "get-application",
  "deprecated": false,
  "description_en": "Retrieves information about a specified application in an ECS cluster",
  "description_zh": "获取ECS集群中指定应用的信息。 ",
  "kebab_example": "aliyun edas get-application --app-id 29f0000000000000000000 --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "GetApplication",
  "operation": {
    "action": "GetApplication",
    "api_style": "ROA",
    "api_version": "2017-08-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/pop/v5/app/app_info"
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "29f0******************",
      "help_en": "The application ID",
      "help_zh": "应用ID",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/pop/v5/app/app_info",
  "product_code": "Edas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The API response",
        "description_zh": "接口响应",
        "properties": {
          "Application": {
            "backendName": "data",
            "description_en": "The application information",
            "description_zh": "应用信息",
            "nullToEmpty": false,
            "properties": {
              "AppId": {
                "backendName": "appId",
                "description_en": "The application ID",
                "description_zh": "应用ID",
                "example": "cfac****-847e-4325-ad56-b5c2bc54****",
                "type": "string",
                "visibility": "Public"
              },
              "AppPhase": {
                "backendName": "appPhase",
                "description_en": "The current phase of the Kubernetes application. This helps determine if the application is stable. Configuration operations are prohibited when the application is in an unstable state.\n\nready: The application is ready and can be changed.\n\nprogressing: The application is being changed.\n\npending: The application change is blocked.\n\nfailed: The application change failed.\n\nThe ready phase is stable. Other phases are unstable",
                "description_zh": "K8s应用当前所属状态，用于判断应用是否处于稳定状态，处于不稳定状态时，禁止相关的配置操作：\n\nready：应用处于就绪状态，可以进行应用变更。\nprogressing：应用变更中。\npending：应用变更被阻塞。\nfailed：应用变更失败。\n\n其中ready为稳定状态，其它状态为不稳定状态",
                "example": "ready",
                "type": "string"
              },
              "ApplicationType": {
                "backendName": "applicationType",
                "description_en": "The deployment type of the application:\n\nWar: The application is deployed from a WAR package.\n\nFatJar: The application is deployed from a JAR package.\n\nEmpty: The application is not deployed",
                "description_zh": "应用部署类型：\nWar：WAR包部署。\nFatJar：JAR包部署。\n空：未部署",
                "example": "FatJar",
                "type": "string",
                "visibility": "Public"
              },
              "BuildPackageId": {
                "backendName": "buildpackId",
                "description_en": "The ID of the container version",
                "description_zh": "容器版本ID",
                "example": "59",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "ClusterId": {
                "backendName": "clusterId",
                "description_en": "The ID of the ECS cluster where the application is deployed",
                "description_zh": "应用部署的ECS集群ID",
                "example": "5ffc5895-****-b03a-c223c6c3****",
                "type": "string",
                "visibility": "Public"
              },
              "ClusterType": {
                "backendName": "clusterType",
                "description_en": "The type of the application cluster:\n\n0: A regular Docker cluster.\n\n1: A Swarm cluster.\n\n2: An ECS cluster.\n\n3: A Kubernetes cluster.\n\n4: A Pandora application cluster that supports automatic registration",
                "description_zh": "应用集群环境类型：\n0：普通Docker集群。\n1：Swarm 集群。\n2：ECS集群。\n3：Kubernetes集群。\n4：Pandora自动注册应用集群",
                "example": "2",
                "type": "string",
                "visibility": "Public"
              },
              "Cpu": {
                "backendName": "cpu",
                "description_en": "The number of CPU cores",
                "description_zh": "CPU核数",
                "example": "1",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The UNIX timestamp when the application was created",
                "description_zh": "应用创建时间的时间戳",
                "example": "1610550324226",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the application",
                "description_zh": "应用描述",
                "example": "test",
                "type": "string",
                "visibility": "Public"
              },
              "Dockerize": {
                "backendName": "dockerize",
                "description_en": "Indicates whether the application is a Docker application:\n\nfalse: The application is not a Docker application.\n\ntrue: The application is a Docker application",
                "description_zh": "是否为Docker应用：\nfalse：非Docker应用。\ntrue：Docker应用",
                "example": "false",
                "type": "boolean",
                "visibility": "Public"
              },
              "Email": {
                "backendName": "email",
                "description_en": "The email address",
                "description_zh": "电子邮箱地址",
                "example": "****@***.com",
                "type": "string",
                "visibility": "Public"
              },
              "EnablePortCheck": {
                "backendName": "enablePortCheck",
                "description_en": "Indicates whether the port health check is enabled:\n\ntrue: Enabled.\n\nfalse: Disabled.\n\nIf enabled, EDAS checks if the port is in use during application startup. If the port is in use, the application is considered started",
                "description_zh": "是否开启了端口健康检查：\ntrue：启用。\nfalse：不启用。\n\n若启用，在应用启动过程中，EDAS将检查端口是否存在，若存在，则认为应用已经启动",
                "example": "false",
                "type": "boolean"
              },
              "EnableUrlCheck": {
                "backendName": "enableUrlCheck",
                "description_en": "Indicates whether the URL health check is enabled:\n\ntrue: Enabled.\n\nfalse: Disabled.\n\nIf enabled, EDAS probes the specified URL during application startup. If the URL is accessible, the application is considered started",
                "description_zh": "是否开启了URL健康检查：\ntrue：启用。\nfalse：不启用。\n\n若启用，则在应用启动过程中，EDAS将尝试探测指定的URL，如果访问正常，则认为应用已经启动",
                "example": "false",
                "type": "boolean"
              },
              "ExtSlbId": {
                "backendName": "extSlbId",
                "description_en": "The ID of the public-facing SLB instance attached to the application",
                "description_zh": "应用绑定的公网SLB的ID",
                "example": "lb-bp1vceck3s3b9xs6x****",
                "type": "string",
                "visibility": "Public"
              },
              "ExtSlbIp": {
                "backendName": "extSlbIp",
                "description_en": "The public IP address of the SLB instance attached to the application",
                "description_zh": "应用绑定的公网SLB的IP",
                "example": "47.114.xxx.xx",
                "type": "string",
                "visibility": "Public"
              },
              "ExtSlbName": {
                "backendName": "extSlbName",
                "description_en": "The name of the public-facing SLB instance attached to the application",
                "description_zh": "应用绑定的公网SLB的名称",
                "example": "aa8eee383db084f42aebc4d9f52c****",
                "type": "string",
                "visibility": "Public"
              },
              "HaveManageAccess": {
                "backendName": "haveManageAccess",
                "description_en": "Indicates whether the current user has management permissions on the application. This parameter is available only in RAM authentication mode",
                "description_zh": "当前用户是否有应用的管理权限(RAM鉴权模式)",
                "example": "true",
                "type": "string"
              },
              "HealthCheckUrl": {
                "backendName": "hcUrl",
                "description_en": "The health check URL of the application",
                "description_zh": "应用的健康检查URL",
                "example": "http://127.0.0.1:8080/xyz.html",
                "type": "string",
                "visibility": "Public"
              },
              "InstanceCount": {
                "backendName": "instances",
                "description_en": "The number of instances in the application",
                "description_zh": "应用包含的实例数",
                "example": "1",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "Memory": {
                "backendName": "mem",
                "description_en": "The memory size for the application instance, in MB",
                "description_zh": "应用实例内存配置大小，单位为MB",
                "example": "0",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the application",
                "description_zh": "应用名称",
                "example": "test",
                "type": "string",
                "visibility": "Public"
              },
              "NameSpace": {
                "backendName": "namespace",
                "description_en": "The namespace to which the application belongs",
                "description_zh": "应用所属的命名空间",
                "example": "doc-test",
                "type": "string",
                "visibility": "Public"
              },
              "Owner": {
                "backendName": "owner",
                "description_en": "The creator of the application",
                "description_zh": "应用创建者",
                "example": "ouou@117274586608****",
                "type": "string",
                "visibility": "Public"
              },
              "Port": {
                "backendName": "port",
                "description_en": "The service port of the application",
                "description_zh": "应用的服务端口",
                "example": "8080",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "RegionId": {
                "backendName": "regionId",
                "description_en": "The ID of the region where the application is located",
                "description_zh": "应用所属地域的ID",
                "example": "cn-hangzhou",
                "type": "string",
                "visibility": "Public"
              },
              "ResourceGroupId": {
                "backendName": "resourceGroupId",
                "description_en": "The ID of the resource group",
                "description_zh": "资源组ID",
                "example": "rg-aekz****",
                "type": "string"
              },
              "RunningInstanceCount": {
                "backendName": "runnings",
                "description_en": "The number of running application instances",
                "description_zh": "运行的应用实例数",
                "example": "1",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "SlbId": {
                "backendName": "slbId",
                "description_en": "The ID of the internal-facing SLB instance attached to the application",
                "description_zh": "应用绑定的私网SLB的ID",
                "example": "lb-bp****ck3s3b9xs6x****",
                "type": "string",
                "visibility": "Public"
              },
              "SlbInfo": {
                "backendName": "slbInfo",
                "description_en": "Information about the internal-facing SLB instance attached to the application",
                "description_zh": "应用绑定的私网SLB的信息",
                "example": "test",
                "type": "string",
                "visibility": "Public"
              },
              "SlbIp": {
                "backendName": "slbIp",
                "description_en": "The IP address of the internal-facing SLB instance attached to the application",
                "description_zh": "应用绑定的私网SLB的IP",
                "example": "192.***.***.***",
                "type": "string",
                "visibility": "Public"
              },
              "SlbName": {
                "backendName": "slbName",
                "description_en": "The name of the internal-facing SLB instance attached to the application",
                "description_zh": "应用绑定的私网SLB的名称",
                "example": "test",
                "type": "string",
                "visibility": "Public"
              },
              "SlbPort": {
                "backendName": "slbPort",
                "description_en": "The port of the internal-facing SLB instance attached to the application",
                "description_zh": "应用绑定的私网SLB的端口",
                "example": "80",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "UserId": {
                "backendName": "userId",
                "description_en": "The ID of the Alibaba Cloud account",
                "description_zh": "云账号ID",
                "example": "test@dd******",
                "type": "string",
                "visibility": "Public"
              },
              "WorkloadType": {
                "backendName": "workloadType",
                "description_en": "The workload type used to create the application. Supported types are Deployment and StatefulSet. This parameter does not apply to ECS applications",
                "description_zh": "创建应用时Workload的类型，目前支持Deployment和StatefulSet类型。对于ECS应用不生效",
                "example": "StatefulSet",
                "type": "string"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Code": {
            "backendName": "code",
            "description_en": "The status code",
            "description_zh": "code码",
            "example": "200",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The additional information",
            "description_zh": "附加信息",
            "example": "success",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "F8DFGED-K98***************",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
