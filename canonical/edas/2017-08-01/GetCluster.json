{
  "camel_example": "aliyun edas GET /pop/v5/resource/cluster --region cn-hangzhou --ClusterId '5439271a-015b-433d-0000-d76db490000' --header \"Content-Type=application/json\"",
  "cmd_full_name": "edas get-cluster",
  "cmd_name": "get-cluster",
  "deprecated": false,
  "description_en": "Queries a specific cluster",
  "description_zh": "获取指定集群的信息",
  "kebab_example": "aliyun edas get-cluster --cluster-id 5439271a-015b-433d-0000-d76db490000 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetCluster",
  "operation": {
    "action": "GetCluster",
    "api_style": "ROA",
    "api_version": "2017-08-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/pop/v5/resource/cluster"
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "5439271a-015b-433d-****-d76db49****",
      "help_en": "The ID of the cluster in Enterprise Distributed Application Service (EDAS). You can call the ListCluster operation to query the cluster ID. For more information, see https://help.aliyun.com/document_detail/154995.html",
      "help_zh": "集群ID。可以通过调用ListCluster获取集群ID，具体操作，请参见https://help.aliyun.com/document_detail/154995.html",
      "location": "query",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/pop/v5/resource/cluster",
  "product_code": "Edas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Cluster": {
            "backendName": "data",
            "description_en": "The information about the cluster",
            "description_zh": "集群信息",
            "nullToEmpty": false,
            "properties": {
              "ClusterId": {
                "backendName": "clusterId",
                "description_en": "The ID of the cluster",
                "description_zh": "集群ID",
                "example": "5439271a-015b-433d-befb-d76d****",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "ClusterImportStatus": {
                "backendName": "clusterImportStatus",
                "description_en": "The import status of the cluster. Valid values:\n\n1: The cluster is imported.\n\n2: The cluster fails to be imported.\n\n3: The cluster is being imported.\n\n4: The cluster is deleted.\n\n0: The cluster is not imported",
                "description_zh": "导入集群状态。\n1：导入成功\n2：导入失败\n3：正在导入\n4：集群已删除\n0：未导入",
                "example": "0",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "ClusterName": {
                "backendName": "clusterName",
                "description_en": "The name of the cluster",
                "description_zh": "集群名称",
                "example": "ClusterTest",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "ClusterType": {
                "backendName": "clusterType",
                "description_en": "The type of the cluster. Valid values:\n\n0: regular Docker cluster\n\n1: Swarm cluster\n\n2: Elastic Compute Service (ECS) cluster\n\n3: self-managed Kubernetes cluster in EDAS\n\n4: cluster in which Pandora automatically registers applications\n\n5: ACK cluster",
                "description_zh": "集群类型。\n0：普通Docker集群\n1：Swarm集群\n2：ECS集群\n3：EDAS自建K8s集群\n4：Pandora自动注册应用集群类型\n5：容器服务K8s集群",
                "example": "2",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "Cpu": {
                "backendName": "cpu",
                "description_en": "The total number of CPU cores",
                "description_zh": "CPU总核数",
                "example": "4",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "CpuUsed": {
                "backendName": "cpuUsed",
                "description_en": "The number of used CPU cores",
                "description_zh": "已使用CPU核数",
                "example": "2",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The time when the cluster was created. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                "description_zh": "集群创建时间的时间戳",
                "example": "1570708232145",
                "format": "int64",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "CsClusterId": {
                "backendName": "csClusterId",
                "description_en": "The ID of the Container Service for Kubernetes (ACK) cluster",
                "description_zh": "容器服务集群ID",
                "example": "c2ce62869f4d4466b920312315f05****",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the cluster",
                "description_zh": "描述",
                "example": "Test",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "IaasProvider": {
                "backendName": "iaasProvider",
                "description_en": "The provider of Infrastructure as a Service (IaaS) resources used in the cluster",
                "description_zh": "IaaS资源提供者",
                "example": "ALIYUN",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Mem": {
                "backendName": "mem",
                "description_en": "The total size of memory. Unit: MB",
                "description_zh": "内存总量，单位为MB",
                "example": "2048",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "MemUsed": {
                "backendName": "memUsed",
                "description_en": "The size of used memory. Unit: MB",
                "description_zh": "已使用内存量，单位MB",
                "example": "1024",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "NetworkMode": {
                "backendName": "networkMode",
                "description_en": "The network type of the cluster. Valid values:\n\n1: classic network\n\n2: virtual private cloud (VPC)",
                "description_zh": "网络类型：\n1：经典网络。\n2：VPC",
                "example": "2",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "NodeNum": {
                "backendName": "nodeNum",
                "description_en": "The number of ECS instances",
                "description_zh": "ECS数量",
                "example": "4",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "OversoldFactor": {
                "backendName": "oversoldFactor",
                "description_en": "The overcommit ratio supported by a Docker cluster. Valid values:\n\n1: 1:1, which means that resources are not overcommitted.\n\n2: 1:2, which means that resources are overcommitted by 1:2.\n\n4: 1:4, which means that resources are overcommitted by 1:4.\n\n8: 1:8, which means that resources are overcommitted by 1:8",
                "description_zh": "Docker集群CPU超卖：\n1：1:1比例，不超卖。\n2：1:2比例超卖\n4：1:4比例超卖\n8：1:8比例超卖",
                "example": "2",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "RegionId": {
                "backendName": "regionId",
                "description_en": "The ID of the region where the cluster resides",
                "description_zh": "地域ID",
                "example": "cn-hangzhou",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "SubClusterType": {
                "backendName": "subClusterType",
                "description_en": "The subtype of the Kubernetes cluster. Valid values: ManagedKubernetes, Ask, and ExternalKubernetes. ManagedKubernetes refers to the ACK cluster. Ask refers to the Serverless Kubernetes (ASK) cluster. ExternalKubernetes refers to the external cluster",
                "description_zh": "K8s类型集群的子类型：ManagedKubernetes为阿里云ACK集群类型，\nAsk为阿里云ASK集群类型，\nExternalKubernetes为外部集群类型",
                "enum": [
                  "ManagedKubernetes",
                  "Ask"
                ],
                "example": "ManagedKubernetes",
                "title_en": "K8S类型集群的子类型：ManagedKubernetes为阿里云ACK集群类型，\nAsk为阿里云ASK集群类型，\nExternalKubernetes为外部集群类型",
                "title_zh": "K8S类型集群的子类型：ManagedKubernetes为阿里云ACK集群类型，\nAsk为阿里云ASK集群类型，\nExternalKubernetes为外部集群类型",
                "type": "string",
                "visibility": "Public"
              },
              "UpdateTime": {
                "backendName": "updateTime",
                "description_en": "The time when the cluster was last modified. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                "description_zh": "最后变更时间的时间戳",
                "example": "1570708232145",
                "format": "int64",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "VpcId": {
                "backendName": "vpcId",
                "description_en": "The ID of the virtual private cloud (VPC)",
                "description_zh": "VPC网络ID",
                "example": "vpc-xxxxz1mlwpb****",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Code": {
            "backendName": "code",
            "description_en": "The HTTP status code that is returned",
            "description_zh": "code码",
            "example": "200",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The detailed information that is returned",
            "description_zh": "详细信息",
            "example": "success",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "d76db491",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
