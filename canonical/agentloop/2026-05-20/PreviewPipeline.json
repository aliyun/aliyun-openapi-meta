  "camel_example": "aliyun agentloop POST /agentspace/my-agent-space/pipeline/preview --region cn-hangzhou --header \"Content-Type=application/json\" --body '{\"pipeline\":{\"nodes\":[{\"id\":\"node-1\",\"type\":\"transform\",\"parameters\":{\"key\":\"example-string\"}}]},\"fromTime\":1735660800,\"source\":{\"inputFields\":[{\"name\":\"question\",\"type\":\"text\"}],\"type\":\"SLS\",\"dataset\":{\"filter\":\"status_=_pending\",\"dataset\":\"my-dataset\"},\"logstore\":{\"query\":\"0_SELECT_0\",\"project\":\"my-sls-project\",\"logstore\":\"my-sls-logstore\"},\"trajectory\":{\"enrich\":{\"columns\":[\"input\"],\"enabled\":false}}},\"toTime\":1735747200}' --version 2026-05-20 --force",
  "cmd_full_name": "agentloop preview-pipeline",
  "cmd_name": "preview-pipeline",
  "deprecated": false,
  "description_en": "Previews a pipeline. Runs a trial query based on the specified data source, node orchestration, and time range without creating pipeline resources, and returns a small amount of sample data to authenticate parameter settings and preview processing results",
