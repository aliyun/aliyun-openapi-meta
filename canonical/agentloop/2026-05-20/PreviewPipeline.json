  "kebab_example": "aliyun agentloop preview-pipeline --agent-space my-agent-space --source '{\"inputFields\":[{\"name\":\"question\",\"type\":\"text\"}],\"type\":\"SLS\",\"dataset\":{\"filter\":\"status_=_pending\",\"dataset\":\"my-dataset\"},\"logstore\":{\"query\":\"0_SELECT_0\",\"project\":\"my-sls-project\",\"logstore\":\"my-sls-logstore\"},\"trajectory\":{\"enrich\":{\"columns\":[\"input\"],\"enabled\":false}}}' --pipeline '{\"nodes\":[{\"id\":\"node-1\",\"type\":\"transform\",\"parameters\":{\"key\":\"example-string\"}}]}' --from-time 1735660800 --to-time 1735747200 --region cn-hangzhou",
