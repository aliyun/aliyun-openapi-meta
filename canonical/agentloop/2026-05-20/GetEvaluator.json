{
  "camel_example": "",
  "cmd_full_name": "agentloop get-evaluator",
  "cmd_name": "get-evaluator",
  "deprecated": false,
  "description_en": "Retrieves the details of an evaluator",
  "description_zh": "获取评估器详情",
  "kebab_example": "aliyun agentloop get-evaluator --agent-space prod-agentspace --name trace_task_completion --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetEvaluator",
  "operation": {
    "action": "GetEvaluator",
    "api_style": "ROA",
    "api_version": "2026-05-20",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/evaluators/{agentSpace}/{name}"
  },
  "parameters": [
    {
      "example": "prod-agentspace",
      "help_en": "The AgentSpace name",
      "help_zh": "AgentSpace 名称",
      "location": "path",
      "name": "agent_space",
      "options": [
        "--agent-space"
      ],
      "raw_name": "agentSpace",
      "required": true,
      "type": "string"
    },
    {
      "example": "trace_task_completion",
      "help_en": "The evaluator name",
      "help_zh": "评估器名称",
      "location": "path",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "name",
      "required": true,
      "type": "string"
    },
    {
      "example": "1.0.0",
      "help_en": "The target version number. If not specified, the latest version is used",
      "help_zh": "目标版本号。不传则使用最新版本",
      "location": "query",
      "name": "version",
      "options": [
        "--biz-version"
      ],
      "raw_name": "version",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/evaluators/[agentSpace]/[name]",
  "product_code": "AgentLoop",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "evaluator": {
            "description_en": "The evaluator details",
            "description_zh": "评估器详情",
            "example": "{\"name\":\"trace_task_completion\",\"type\":\"AGENT\",\"currentVersion\":\"1.0.0\"}",
            "properties": {
              "agentSpace": {
                "description_en": "The AgentSpace name",
                "description_zh": "AgentSpace 名称",
                "example": "prod-agentspace",
                "type": "string"
              },
              "annotations": {
                "description_en": "The list of annotations",
                "description_zh": "注解标记列表",
                "example": "[\"__en\"]",
                "itemName": "annotations",
                "items": {
                  "description_en": "A single annotation",
                  "description_zh": "单个注解标记",
                  "example": "__en",
                  "type": "string"
                },
                "type": "array"
              },
              "config": {
                "description_en": "The configuration of the current version",
                "description_zh": "当前版本配置",
                "example": "{\"prompt\":\"请评估任务完成度\"}",
                "parseType": "json",
                "type": "object"
              },
              "createdAt": {
                "description_en": "The time when the evaluator was created. The value is a UNIX timestamp in seconds",
                "description_zh": "创建时间，秒级 Unix 时间戳",
                "example": "1782816000",
                "format": "int64",
                "type": "integer"
              },
              "currentVersion": {
                "description_en": "The version number returned in the current response",
                "description_zh": "当前返回的版本号",
                "example": "1.0.0",
                "type": "string"
              },
              "description": {
                "description_en": "The evaluator description",
                "description_zh": "评估器描述",
                "example": "判断 Agent 是否完成用户任务",
                "type": "string"
              },
              "displayName": {
                "description_en": "The display name",
                "description_zh": "显示名称",
                "example": "链路任务完成度",
                "type": "string"
              },
              "latestVersion": {
                "description_en": "The latest version number",
                "description_zh": "最新版本号",
                "example": "1.0.0",
                "type": "string"
              },
              "metricName": {
                "description_en": "The evaluation metric name",
                "description_zh": "评估指标名称",
                "example": "agent_task_completion",
                "type": "string"
              },
              "name": {
                "description_en": "The evaluator name",
                "description_zh": "评估器名称",
                "example": "trace_task_completion",
                "type": "string"
              },
              "properties": {
                "description_en": "The evaluator properties",
                "description_zh": "评估器属性",
                "example": "{\"agentEvaluatorMode\":\"raw_prompt\"}",
                "parseType": "json",
                "type": "object"
              },
              "type": {
                "description_en": "The evaluator type",
                "description_zh": "评估器类型",
                "example": "AGENT",
                "type": "string"
              },
              "updatedAt": {
                "description_en": "The time when the evaluator was last updated. The value is a UNIX timestamp in seconds",
                "description_zh": "更新时间，秒级 Unix 时间戳",
                "example": "1782816600",
                "format": "int64",
                "type": "integer"
              },
              "versions": {
                "description_en": "The list of versions",
                "description_zh": "版本列表",
                "example": "[{\"version\":\"1.0.0\"}]",
                "itemName": "versions",
                "items": {
                  "description_en": "A single version object",
                  "description_zh": "单个版本对象",
                  "example": "{\"version\":\"1.0.0\"}",
                  "properties": {
                    "createdAt": {
                      "description_en": "The time when the version was created. The value is a UNIX timestamp in seconds",
                      "description_zh": "版本创建时间，秒级 Unix 时间戳",
                      "example": "1782816000",
                      "format": "int64",
                      "type": "integer"
                    },
                    "version": {
                      "description_en": "The version number",
                      "description_zh": "版本号",
                      "example": "1.0.0",
                      "type": "string"
                    },
                    "versionDescription": {
                      "description_en": "The version description",
                      "description_zh": "版本描述",
                      "example": "初始版本",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "parseType": "json",
                "type": "array"
              }
            },
            "type": "object"
          },
          "requestId": {
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "3FE4CD1E-FF41-56BE-B590-7A021D9C1524",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
