                  "example": "numb",
                  "mappingResourcePropertyName": "$.Comment",
                  "type": "string"
                },
                "CreateTime": {
                  "backendName": "createTime",
                  "description_en": "The time when the bucket was created. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
