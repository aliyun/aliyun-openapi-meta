{
  "camel_example": "aliyun ens ListBuckets --region cn-hangzhou --PageSize 5 --PageNumber 1 --Prefix image",
  "cmd_full_name": "ens list-buckets",
  "cmd_name": "list-buckets",
  "deprecated": false,
