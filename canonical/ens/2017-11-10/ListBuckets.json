      "location": "query",
      "name": "prefix",
      "options": [
        "--prefix"
      ],
      "raw_name": "Prefix",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. Pages start from page 1",
      "help_zh": "翻页页码，从1开始",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "pattern": "^\\d+$",
      "raw_name": "PageNumber",
      "required": false,
      "type": "string"
    },
    {
      "example": "5",
      "help_en": "The maximum number of returned buckets. You can leave this parameter empty. The default value is 10. The value cannot be greater than 100",
      "help_zh": "限定此次返回bucket的最⼤数。可以不设定该参数，不设定时默认值为10，取值不能⼤于100",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "pattern": "^\\d+$",
      "raw_name": "PageSize",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
