            "description_en": "The list of bucket information",
            "description_zh": "Bucket信息列表",
            "itemName": "BucketInfo",
            "items": {
              "properties": {
                "BucketAcl": {
                  "backendName": "bucketAcl",
                  "description_en": "The access control list (ACL) of the bucket.\n\npublic-read-write\n\npublic-read\n\nprivate (default)",
                  "description_zh": "Bucket读写权限类型：\n\npublic-read-write：公共读写\n\npublic-read：公共读\n\nprivate：私有（默认值）",
                  "example": "private",
                  "mappingResourcePropertyName": "$.BucketAcl",
                  "type": "string"
                },
                "BucketName": {
                  "backendName": "bucketName",
                  "description_en": "The name of the bucket",
