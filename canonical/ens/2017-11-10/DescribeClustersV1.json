                    "ContainerRuntime": {
                      "backendName": "container_runtime",
                      "description_en": "The type of the runtime",
                      "description_zh": "运行时的类型",
                      "example": "containerd",
                      "type": "string"
                    },
                    "ImageId": {
                      "backendName": "image_id",
                      "description_en": "The image ID",
                      "description_zh": "镜像ID",
                      "example": "m-68be8cb9f71fhyvjekxa23qsf",
                      "type": "string"
                    },
                    "InstanceSpec": {
                      "backendName": "instance_spec",
                      "description_en": "The instance type",
                      "description_zh": "实例规格",
                      "example": "ens.sn1.medium",
                      "type": "string"
                    },
                    "NodePortRange": {
                      "backendName": "node_port_range",
                      "description_en": "The range of service ports on the node",
                      "description_zh": "节点服务端口范围",
                      "example": "30000-32767",
                      "type": "string"
                    },
                    "Size": {
                      "backendName": "size",
                      "description_en": "The number of control plane nodes",
                      "description_zh": "控制面节点数量",
                      "example": "5",
                      "format": "int64",
                      "type": "integer"
                    },
                    "SystemDiskCategory": {
                      "backendName": "system_disk_category",
                      "description_en": "The type of the system disk for the edge zone. Valid values: \"local_ssd\", \"cloud_ssd\", \"cloud_efficiency\", and \"local_hdd\"",
                      "description_zh": "节点系统盘类型，可选类型：\"local_ssd\", \"cloud_ssd\", \"cloud_efficiency\", \"local_hdd\"",
                      "example": "cloud_ssd",
                      "type": "string"
                    },
                    "SystemDiskSize": {
                      "backendName": "system_disk_size",
                      "description_en": "The size of the system disk, in GB",
                      "description_zh": "系统盘大小规格，单位：GB",
                      "example": "100",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "EnsRegionId": {
                  "backendName": "ens_region_id",
                  "description_en": "The ID of the ENS edge zone",
                  "description_zh": "ENS节点ID",
                  "example": "cn-hangzhou-55",
                  "type": "string"
                },
                "JoinToken": {
                  "backendName": "join_token",
                  "description_en": "The authentication token for accessing the cluster",
                  "description_zh": "集群接入鉴权token",
                  "example": "xxxxxxxxxx.yyyyyyy",
                  "type": "string"
                },
                "KubernetesVersion": {
                  "backendName": "kubernetes_version",
                  "description_en": "The cluster version. It is consistent with the baseline version of the Kubernetes community. Select the latest version. If you do not specify a version, the latest version is used by default",
                  "description_zh": "集群版本，与 Kubernetes 社区基线版本保持一致。建议选择最新版本，若不指定，默认使用最新版本",
                  "example": "1.31.9-aliyunedge.1",
                  "type": "string"
                },
                "LoadBalancerId": {
                  "backendName": "load_balancer_id",
                  "description_en": "The ID of the Server Load Balancer (SLB) instance",
                  "description_zh": "负载均衡实例ID",
                  "example": "lb-58dngw0fyimzzvwljfec7hy0z",
                  "type": "string"
                },
                "Name": {
                  "backendName": "name",
                  "description_en": "The name of the cluster",
                  "description_zh": "集群名称",
                  "example": "test-eck-name",
                  "type": "string"
                },
                "PodVswitchIds": {
                  "backendName": "pod_vswitch_ids",
                  "description_en": "Each pod virtual switch corresponds to a virtual switch of a worker node. The zone of the pod virtual switch and the worker node virtual switch must be the same. If you do not specify this parameter, the value of vswitch_ids is used by default",
                  "description_zh": "每个 Pod 虚拟交换机分别对应一个 Worker 节点的虚拟交换机，Pod 虚拟交换机和 Worker 节点的虚拟交换机的可用区需保持一致。如果不填，默认使用vswitch_ids",
                  "itemName": "pod_vswitch_ids",
                  "items": {
                    "description_en": "The ID of the virtual switch",
                    "description_zh": "虚拟交换机id",
                    "example": "vsw-xxxxxxx",
                    "type": "string"
                  },
                  "type": "array"
                },
                "PublicAccess": {
                  "backendName": "public_access",
                  "description_en": "Specifies whether to enable public network access. The API server is exposed through an elastic IP address (EIP) to allow public access to the cluster. Valid values are \\`true\\` and \\`false\\`. If set to \\`true\\`, public network access is enabled. If set to \\`false\\`, public network access is disabled, and you cannot access the cluster API server from the internet",
                  "description_zh": "是否开启公网访问。通过 EIP 暴露 API Server，实现集群公网访问。\n● true：开启公网访问。\n● false：不开启公网访问。选择不开放时，则无法通过外网访问集群 API Server",
                  "example": "true",
                  "type": "boolean"
                },
                "ServiceCidr": {
                  "backendName": "service_cidr",
                  "description_en": "The CIDR block for services. Valid ranges: 10.0.0.0/16-24, 172.16-31.0.0/16-24, and 192.168.0.0/16-24. The CIDR block cannot overlap with the VPC CIDR block 10.1.0.0/21 or the CIDR blocks used by existing Kubernetes clusters in the VPC. This parameter cannot be changed after the cluster is created",
                  "description_zh": "Service 网络地址段，可选范围：10.0.0.0/16-24，172.16-31.0.0/16-24，192.168.0.0/16-24 不能与 VPC 网段 10.1.0.0/21 及 VPC 内已有 Kubernetes 集群使用的网段重复，创建成功后不能修改",
                  "example": "192.168.0.0/16",
                  "type": "string"
                },
                "State": {
                  "backendName": "state",
                  "description_en": "The status of the cluster",
                  "description_zh": "集群状态",
                  "example": "running",
                  "type": "string"
                },
                "VpcId": {
                  "backendName": "vpc_id",
                  "description_en": "The virtual private cloud (VPC) used by the cluster",
                  "description_zh": "集群使用的专有网络",
                  "example": "n-5wsgr3xeolb2ist303wp3cscp",
                  "type": "string"
                },
                "VswitchIds": {
                  "backendName": "vswitch_ids",
                  "description_en": "The IDs of the virtual switches to which the cluster nodes belong. The virtual switches must be in the region specified by \\`ens\\_region\\_id\\`",
                  "description_zh": "集群节点所在虚拟交换机id。vswitch_ids所处 ENS Region 必须与ens_region_id一致",
                  "itemName": "vswitch_ids",
                  "items": {
                    "description_en": "The ID of the virtual switch",
                    "description_zh": "虚拟交换机id",
                    "example": "vsw-xxxxxxx",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Id of the request",
            "description_zh": "Id of the request",
            "example": "C0003E8B-B930-4F59-ADC0-0E209A9012A8",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
