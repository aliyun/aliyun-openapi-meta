        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Clusters": {
            "backendName": "data",
            "description_en": "A list of cluster information",
            "description_zh": "集群信息列表",
            "itemName": "clusters",
            "items": {
              "description_en": "The details of the cluster",
              "description_zh": "集群详细信息",
              "properties": {
                "AliUid": {
                  "backendName": "aliUid",
                  "description_en": "The user ID",
                  "description_zh": "用户ID",
                  "example": "1375383353108460",
                  "type": "string"
                },
                "ClusterId": {
                  "backendName": "cluster_id",
                  "description_en": "The ID of the cluster instance",
                  "description_zh": "集群实例ID",
                  "example": "eck-xxxxxxx",
                  "type": "string"
                },
                "Config": {
                  "backendName": "kubeConfig",
                  "description_en": "The kubeconfig of the cluster",
                  "description_zh": "集群kubeconfig",
                  "example": "{\n        \"kind\": \"Config\",\n        \"apiVersion\": \"v1\",\n        \"preferences\": {},\n        \"clusters\": [\n          {\n            \"name\": \"kubernetes\",\n            \"cluster\": {\n              \"server\": \"https://000.000.000.000:6443\",\n              \"certificate-authority-data\": \"\"\n            }\n          }\n        ],\n        \"users\": [\n          {\n            \"name\": \"kubernetes-admin\",\n            \"user\": {\n              \"client-certificate-data\": \"\",\n              \"client-key-data\": \"\"\n            }\n          }\n        ],\n        \"contexts\": [\n          {\n            \"name\": \"kubernetes-admin@kubernetes\",\n            \"context\": {\n              \"cluster\": \"kubernetes\",\n              \"user\": \"kubernetes-admin\"\n            }\n          }\n        ],\n        \"current-context\": \"kubernetes-admin@kubernetes\"\n      }",
                  "type": "any"
                },
                "ContainerCidr": {
                  "backendName": "container_cidr",
                  "description_en": "The CIDR block for pods. It must be a valid private CIDR block, such as 10.0.0.0/8, 172.16-31.0.0/12-16, or 192.168.0.0/16, and their subnets. This CIDR block cannot overlap with the VPC CIDR block or the CIDR blocks of existing Kubernetes clusters in the VPC. After the cluster is created, this parameter cannot be changed",
                  "description_zh": "Pod 网络地址段，必须是有效的私有网段，即以下网段及其子网：10.0.0.0/8、172.16-31.0.0/12-16、192.168.0.0/16。不能与 VPC 及 VPC 内已有 Kubernetes 集群使用的网段重复，创建成功后不能修改",
                  "example": "10.0.0.0/8",
                  "type": "string"
                },
                "ControlPlaneConfig": {
                  "backendName": "control_plane_config",
                  "description_en": "The control plane configuration",
                  "description_zh": "控制平面配置",
