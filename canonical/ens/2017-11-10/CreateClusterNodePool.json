{
  "camel_example": "aliyun ens CreateClusterNodePool --region cn-hangzhou --NodepoolInfo '{\"Name\":\"test1\"}' --ClusterId 'eck-xxxxxxxx' --ScalingGroup '{\"DesiredSize\":3,\"KeyPairName\":\"key-pair-name\",\"DataDisks\":[{}],\"SystemDiskSize\":80,\"InstanceChargeType\":\"PostPaid\",\"VswitchIds\":[\"vsw-58eu2p6v64qw8ihhit1wz7wgv\"],\"ImageId\":\"m-6734fzvcwcv2o8jj201cpa7ox\",\"InstanceTypes\":[\"ens.sn1.small\"],\"SystemDiskCategory\":\"cloud_efficiency\",\"Password\":\"some-test-password\"}'",
  "cmd_full_name": "ens create-cluster-node-pool",
  "cmd_name": "create-cluster-node-pool",
  "deprecated": false,
  "description_en": "Creates a node pool for a cluster. A node pool is a logical collection of nodes that share the same attributes, allowing unified management and O&M operations such as node upgrades and elastic scaling. You can further use the automated O&M capabilities of node pools, including automatic OS CVE vulnerability patching, automatic faulty node recovery, and automatic kubelet and containerd version upgrades, to reduce O&M costs",
  "description_zh": "节点池是具有相同属性的一组节点的逻辑集合，允许对节点进行统一的管理和运维，例如节点升级、弹性伸缩等。您可以进一步使用节点池的自动化运维能力，使用OS CVE漏洞自动修复、故障节点自动恢复、kubelet和containerd版本自动升级等功能，降低运维成本。您可以调用CreateClusterNodePool为集群创建节点池",
  "kebab_example": "aliyun ens create-cluster-node-pool --cluster-id eck-xxxxxxxx --nodepool-info Name=test1 --scaling-group '{\"DesiredSize\":3,\"KeyPairName\":\"key-pair-name\",\"DataDisks\":[{}],\"SystemDiskSize\":80,\"InstanceChargeType\":\"PostPaid\",\"VswitchIds\":[\"vsw-58eu2p6v64qw8ihhit1wz7wgv\"],\"ImageId\":\"m-6734fzvcwcv2o8jj201cpa7ox\",\"InstanceTypes\":[\"ens.sn1.small\"],\"SystemDiskCategory\":\"cloud_efficiency\",\"Password\":\"some-test-password\"}' --region cn-hangzhou",
