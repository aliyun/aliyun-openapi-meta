{
  "camel_example": "aliyun openapiexplorer GET /api/sdk/dependencies --region cn-hangzhou --product Ecs --language java --header \"Content-Type=application/json\"",
  "cmd_full_name": "openapiexplorer get-sdk-dependencies",
  "cmd_name": "get-sdk-dependencies",
  "deprecated": false,
  "description_en": "Retrieves SDK information",
  "description_zh": "获取SDK信息",
  "kebab_example": "aliyun openapiexplorer get-sdk-dependencies --product Ecs --biz-language java --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetSdkDependencies",
  "operation": {
    "action": "GetSdkDependencies",
    "api_style": "ROA",
    "api_version": "2024-11-30",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/sdk/dependencies"
  },
  "parameters": [
    {
      "enum": [
        "typed",
        "generic"
      ],
      "example": "typed",
      "help_en": "The SDK call type. Valid values:\n\ntyped: product-specific SDK mode.\ngeneric: Common generalized calls mode.\n\nDefault value: typed",
      "help_zh": "SDK调用类型，typed为产品专属SDK模式，generic为Common泛化调用模式，默认为typed",
      "location": "query",
      "name": "call_type",
      "options": [
        "--call-type"
      ],
      "raw_name": "callType",
      "required": false,
      "type": "string"
    },
    {
      "example": "Ecs",
      "help_en": "The cloud product code",
      "help_zh": "云产品Code",
      "location": "query",
      "name": "product",
      "options": [
        "--product"
      ],
      "raw_name": "product",
      "required": true,
      "type": "string"
    },
    {
      "example": "2014-05-26",
      "help_en": "The OpenAPI version",
      "help_zh": "OpenAPI版本",
      "location": "query",
      "name": "version",
      "options": [
        "--biz-version"
      ],
      "raw_name": "version",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "java",
        "java-async",
        "python",
        "typescript",
        "go",
        "php",
        "csharp",
        "cpp",
        "swift",
        "nodejs"
      ],
      "example": "java",
      "help_en": "The SDK programming language, used to filter the returned SDK version information",
      "help_zh": "SDK编程语言，用于过滤返回的SDK版本信息",
      "location": "query",
      "name": "language",
      "options": [
        "--biz-language"
      ],
      "raw_name": "language",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/sdk/dependencies",
  "product_code": "OpenAPIExplorer",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_en": "The business status code. A value of 0 indicates success",
            "description_zh": "业务状态码，0表示成功",
            "example": "0",
            "format": "int32",
            "title_en": "业务状态码，0表示成功。",
            "title_zh": "业务状态码，0表示成功。",
            "type": "integer"
          },
          "data": {
            "backendName": "data",
            "description_en": "The list of SDK dependency information. Each item corresponds to the latest SDK dependency for a specific programming language",
            "description_zh": "SDK 依赖信息列表，每一项对应一个语言的最新版 SDK 依赖",
            "example": "[{\"packageName\":\"com.aliyun/ecs20140526\",\"sdkVersion\":\"8.7.5\",\"platform\":\"maven\",\"install\":\"<dependency>...</dependency>\"}]",
            "itemName": "data",
            "items": {
              "description_en": "The SDK dependency information for a single language",
              "description_zh": "单个 SDK 依赖信息",
              "example": "{\"packageName\":\"com.aliyun/ecs20140526\",\"sdkVersion\":\"8.7.5\",\"platform\":\"maven\",\"install\":\"<dependency>...</dependency>\"}",
              "properties": {
                "install": {
                  "backendName": "install",
                  "description_en": "The SDK installation command. For Java, this is the Maven <dependency> XML block. For other languages, this is the corresponding package manager installation command",
                  "description_zh": "SDK安装命令。Java 为 Maven <dependency> XML 块；其他语言为对应包管理器的安装命令",
                  "example": "<dependency>\\n  <groupId>com.aliyun</groupId>\\n  <artifactId>ecs20140526</artifactId>\\n  <version>8.7.5</version>\\n</dependency>",
                  "title_en": "SDK安装命令。Java 为 Maven <dependency> XML 块；其他语言为对应包管理器的安装命令。",
                  "title_zh": "SDK安装命令。Java 为 Maven <dependency> XML 块；其他语言为对应包管理器的安装命令。",
                  "type": "string"
                },
                "packageName": {
                  "backendName": "packageName",
                  "description_en": "The SDK package name",
                  "description_zh": "SDK包名称",
                  "example": "com.aliyun/ecs20140526",
                  "title_en": "SDK包名称。",
                  "title_zh": "SDK包名称。",
                  "type": "string"
                },
                "platform": {
                  "backendName": "platform",
                  "description_en": "The SDK package management platform, such as github/maven/pypi/nuget/npm",
                  "description_zh": "SDK包管理平台，如github/maven/pypi/nuget/npm",
                  "example": "maven",
                  "title_en": "SDK包管理平台，如github/maven/pypi/nuget/npm。",
                  "title_zh": "SDK包管理平台，如github/maven/pypi/nuget/npm。",
                  "type": "string"
                },
                "sdkVersion": {
                  "backendName": "sdkVersion",
                  "description_en": "The SDK package version",
                  "description_zh": "SDK包版本",
                  "example": "8.7.5",
                  "title_en": "SDK包版本。",
                  "title_zh": "SDK包版本。",
                  "type": "string"
                }
              },
              "title_en": "单个 SDK 依赖信息。",
              "title_zh": "单个 SDK 依赖信息。",
              "type": "object"
            },
            "title_en": "SDK 依赖信息列表，每一项对应一个语言的最新版 SDK 依赖。",
            "title_zh": "SDK 依赖信息列表，每一项对应一个语言的最新版 SDK 依赖。",
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  }
}
