{
  "apis": {
    "AssumeRole": {
      "cmd_name": "assume-role",
      "deprecated": false,
      "description_en": "Obtains a Security Token Service (STS) token to assume a Resource Access Management (RAM) role",
      "description_zh": "通过调用AssumeRole接口，获取一个扮演RAM角色的临时身份凭证（STS Token）"
    },
    "AssumeRoleWithOIDC": {
      "cmd_name": "assume-role-with-oidc",
      "deprecated": false,
      "description_en": "Obtains a Security Token Service (STS) token for assuming a RAM role during OIDC-based role SSO by calling the AssumeRoleWithOIDC operation",
      "description_zh": "进行OIDC角色SSO时，通过调用AssumeRoleWithOIDC接口，获取扮演RAM角色的临时身份凭证（STS Token）"
    },
    "AssumeRoleWithSAML": {
      "cmd_name": "assume-role-with-saml",
      "deprecated": false,
      "description_en": "For role-based single sign-on (SSO) that uses Security Assertion Markup Language (SAML), call the AssumeRoleWithSAML operation to obtain a temporary identity credential (a Security Token Service (STS) token) for a RAM role",
      "description_zh": "进行SAML角色SSO时，通过调用AssumeRoleWithSAML接口，获取扮演RAM角色的临时身份凭证（STS Token）"
    },
    "GetCallerIdentity": {
      "cmd_name": "get-caller-identity",
      "deprecated": false,
      "description_en": "A call to the GetCallerIdentity operation returns information about the identity of the current caller",
      "description_zh": "调用GetCallerIdentity获取当前调用者的身份信息"
    }
  },
