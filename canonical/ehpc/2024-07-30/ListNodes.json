  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回结果",
        "properties": {
          "Nodes": {
            "backendName": "Nodes",
            "description_en": "The information about the nodes",
            "description_zh": "计算节点列表信息",
            "itemName": "NodeInfo",
            "items": {
              "description_en": "The information about the node",
              "description_zh": "节点列表信息",
              "properties": {
                "AddTime": {
                  "backendName": "AddTime",
                  "description_en": "The time when the node was created",
                  "description_zh": "计算节点的创建时间",
                  "example": "2020-06-09T06:22:02.000Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "DeploymentSetId": {
                  "backendName": "DeploymentSetId",
                  "description_en": "The deployment set ID",
                  "description_zh": "部署集ID",
                  "example": "ds-8vbe4av4gededlqg****",
                  "type": "string"
                },
                "ExpiredTime": {
                  "backendName": "ExpiredTime",
                  "description_en": "The time when the node expires",
                  "description_zh": "计算节点的到期时间",
                  "example": "2020-06-09T06:22:02.000Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "Hostname": {
                  "backendName": "Hostname",
                  "description_en": "The hostname of the node",
                  "description_zh": "计算节点主机名称",
                  "example": "edas.cn-shanghai.aliyuncs.com",
                  "type": "string",
                  "visibility": "Public"
                },
                "HtEnabled": {
                  "backendName": "HtEnabled",
                  "description_en": "Indicates whether hyper-threading is enabled",
                  "description_zh": "是否开启超线程",
                  "example": "true",
                  "type": "boolean",
                  "visibility": "Public"
                },
                "Id": {
                  "backendName": "Id",
                  "description_en": "The instance ID of the node",
                  "description_zh": "计算节点的实例ID",
                  "example": "i-bp15707mys2rsy0j****",
                  "type": "string",
                  "visibility": "Public"
                },
                "ImageId": {
                  "backendName": "ImageId",
                  "description_en": "The image ID of the node",
                  "description_zh": "计算节点的镜像ID",
                  "example": "centos_7_06_64_20G_alibase_20190711.vhd",
                  "type": "string",
                  "visibility": "Public"
                },
                "InstanceType": {
                  "backendName": "InstanceType",
                  "description_en": "The instance type of the node",
                  "description_zh": "计算节点实例规格",
                  "example": "ecs.c5.large",
                  "type": "string",
                  "visibility": "Public"
                },
                "IpAddress": {
                  "backendName": "IpAddress",
                  "description_en": "The VPC IP address of the node",
                  "description_zh": "计算节点的VPC网络IP",
                  "example": "172.16.**.**",
                  "type": "string",
                  "visibility": "Public"
                },
                "KeepAlive": {
                  "backendName": "KeepAlive",
                  "description_en": "Indicates whether deletion protection is enabled for the node. Valid values:\n\ntrue\nfalse",
                  "description_zh": "计算节点是否开启删除保护。可能值：\ntrue：开启。\nfalse：关闭",
                  "example": "true",
                  "type": "boolean"
                },
                "PublicIpAddress": {
                  "backendName": "PublicIpAddress",
                  "description_en": "The public IP address of the node",
                  "description_zh": "计算节点的公网IP地址",
                  "example": "172.16.**.**",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "QueueName": {
                  "backendName": "QueueName",
                  "description_en": "The name of the queue to which the node belongs",
                  "description_zh": "计算节点所属的队列名称",
                  "example": "autoque3",
                  "type": "string"
                },
                "Reason": {
                  "backendName": "Reason",
                  "type": "string"
                },
                "SpotStrategy": {
                  "backendName": "SpotStrategy",
                  "description_en": "The bidding policy of the node. Valid values:\n\nNoSpot: The instances of the compute node are pay-as-you-go instances.\nSpotWithPriceLimit: The instances are created as preemptible instances with a user-defined maximum hourly price.\nSpotAsPriceGo: The node is a preemptible instance for which the market price at the time of purchase is automatically used as the bidding price",
                  "description_zh": "计算节点的竞价策略。可能值：\nNoSpot：正常按量付费实例。\nSpotWithPriceLimit：设置上限价格的抢占式实例。\nSpotAsPriceGo：系统自动出价，跟随当前市场实际价格",
                  "example": "NoSpot",
                  "type": "string",
                  "visibility": "Public"
                },
                "StateInSched": {
                  "backendName": "StateInSched",
                  "description_en": "The node state in the scheduler",
                  "description_zh": "计算节点在调度器中的状态",
                  "example": "active",
                  "type": "string"
                },
                "Status": {
                  "backendName": "Status",
                  "description_en": "The node state. Valid values:\n\nuninit: The node is being installed.\niniting: The node is being initialized.\nrunning: The node is running.\nreleasing: The node is being released.\nstopped: The node is stopped.\nexception: The node has run into an exception.\nuntracking: The node is not added to the cluster",
                  "description_zh": "计算节点状态，可选值：\nuninit：安装中。\niniting：初始化中。\nrunning：运行中。\nreleasing：释放中。\nstopped：已停止。\nexception：异常。\nuntracking：未加入集群",
                  "example": "running",
                  "type": "string",
                  "visibility": "Public"
                },
                "TotalResources": {
                  "backendName": "TotalResources",
                  "description_en": "The hardware configurations of the node",
                  "description_zh": "计算节点的硬件配置信息",
                  "properties": {
                    "Cpu": {
                      "backendName": "Cores",
                      "description_en": "The number of vCPUs",
                      "description_zh": "vCPU数量",
                      "example": "1",
                      "format": "int32",
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Gpu": {
                      "backendName": "Gpu",
                      "description_en": "The number of GPUs",
                      "description_zh": "GPU卡数量",
                      "example": "0",
                      "format": "int32",
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Memory": {
                      "backendName": "Memory",
                      "description_en": "The amount of memory. Unit: GiB",
                      "description_zh": "内存量，单位GiB",
                      "example": "1024",
                      "format": "int32",
                      "type": "integer",
                      "visibility": "Public"
                    }
                  },
                  "type": "object",
                  "visibility": "Public"
                },
                "VSwitchId": {
                  "backendName": "VSwitchId",
                  "description_en": "The vSwitch ID of the node",
                  "description_zh": "计算节点所属的虚拟交换机ID",
                  "example": "vsw-bp1e47optm9g58zcu****",
                  "type": "string",
                  "visibility": "Public"
                },
                "VpcId": {
                  "backendName": "VpcId",
                  "description_en": "The VPC ID",
                  "description_zh": "专有网络ID",
                  "example": "vpc-bp1gnu8br4ay7beb2w****",
                  "type": "string",
                  "visibility": "Public"
                },
                "ZoneId": {
                  "backendName": "ZoneId",
                  "description_en": "The zone ID of the node",
                  "description_zh": "计算节点的可用区ID",
                  "example": "cn-hangzhou-b",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "PageNumber",
            "description_en": "The page number",
            "description_zh": "当前页码",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "PageSize",
            "description_en": "The number of entries per page",
            "description_zh": "本页条数",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "89A1AC0F-4A6C-4F3D-98F9-BEF9A823****",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "TotalCount",
            "description_en": "The total number of entries returned",
            "description_zh": "列表条目总数",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
