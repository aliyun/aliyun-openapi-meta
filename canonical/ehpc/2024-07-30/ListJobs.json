                          "backendName": "Gpus",
                          "description_en": "The number of GPUs",
                          "description_zh": "CPU数",
                          "example": "0",
                          "type": "string"
                        },
                        "Memory": {
                          "backendName": "Memory",
                          "description_en": "The memory size",
                          "description_zh": "内存数",
                          "example": "982MB",
                          "type": "string"
                        },
                        "Nodes": {
                          "backendName": "Nodes",
                          "description_en": "The number of compute nodes",
