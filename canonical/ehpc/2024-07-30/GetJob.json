{
  "cmd_full_name": "ehpc get-job",
  "cmd_name": "get-job",
  "deprecated": false,
  "description_en": "Obtains the details of a job",
  "description_zh": "获取指定作业的详细信息",
  "kebab_example": "aliyun ehpc get-job --cluster-id ehpc-hz-FYUr320000 --job-id 1.manager --api-version 2024-07-30 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetJob",
  "operation": {
    "action": "GetJob",
    "api_style": "RPC",
    "api_version": "2024-07-30",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "ehpc-hz-FYUr32****",
      "help_en": "The cluster ID",
      "help_zh": "集群ID",
      "location": "query",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "1.manager",
      "help_en": "The job ID. You can call the ListJobs operation to query the job ID",
      "help_zh": "作业ID。通过ListJobs接口返回",
      "location": "query",
      "name": "job_id",
      "options": [
        "--job-id"
      ],
      "raw_name": "JobId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "EHPC",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回参数集合",
        "properties": {
          "JobInfo": {
            "backendName": "JobInfo",
            "description_en": "The job details",
            "description_zh": "作业详细信息",
            "properties": {
              "ArrayJobId": {
                "backendName": "ArrayJobId",
                "description_en": "The parent job ID. If the return value is a non-empty string, the job is an array job",
                "description_zh": "数组父作业ID，该返回值为非空字符串时，表示该作业是数组作业",
                "example": "1",
                "type": "string"
              },
              "ArrayJobSubId": {
                "backendName": "ArrayJobSubId",
                "description_en": "The sub-job ID. This parameter is valid when the ArrayJobId parameter is a non-empty string",
                "description_zh": "数组子作业ID，ArrayJobId为非空字符串时有效",
                "example": "3",
                "type": "string"
              },
              "ArrayRequest": {
                "backendName": "ArrayRequest",
                "description_en": "The job queue. If the job is not in a queue, the output is empty.\n\nThe format is X-Y:Z. X indicates the first index, Y indicates the final index, and Z indicates the step size. For example, 2-7:2 indicates three sub-jobs numbered 2, 4, and 6",
                "description_zh": "作业队列参数。如果不是队列作业，输出为空。\n\n格式为X-Y:Z， 最小值X是第一个索引，最大值Y是最后一个索引，Z表示步长，例如2-7:2，表示作业队列包含编号为2、4、6的3个子作业",
                "example": "1-5:2",
                "type": "string"
              },
              "CommandLine": {
                "backendName": "CommandLine",
                "description_en": "The command that is used to run the job",
                "description_zh": "作业执行命令",
                "example": "/home/huangsf/ehpc/job_meta.pbs",
                "type": "string"
              },
              "CreateTime": {
                "backendName": "SubmitTime",
                "description_en": "The time when the job was submitted",
                "description_zh": "作业提交时间",
                "example": "2024-08-16T10:52:48",
                "type": "string"
              },
              "ErrorLog": {
                "backendName": "Stderr",
                "description_en": "The error log file of the job",
                "description_zh": "作业错误日志文件",
                "example": "/home/xxx/STDIN.e1",
                "type": "string"
              },
              "ExtraInfo": {
                "backendName": "ExtraInfo",
                "description_en": "Additional information",
                "description_zh": "其它信息",
                "example": "{}",
                "type": "string"
              },
              "JobId": {
                "backendName": "JobId",
                "description_en": "The job ID",
                "description_zh": "作业ID",
                "example": "1.manager",
                "type": "string"
              },
              "JobName": {
                "backendName": "JobName",
                "description_en": "The job name",
                "description_zh": "作业名称",
                "example": "testJob\n",
                "type": "string"
              },
              "JobQueue": {
                "backendName": "JobQueue",
                "description_en": "The queue to which the job belongs",
                "description_zh": "作业所属队列",
                "example": "workq",
                "type": "string"
              },
              "LastModifyTime": {
                "backendName": "LastModifyTime",
                "description_en": "The time when the job was last modified",
                "description_zh": "作业状态最后修改时间",
                "example": "2024-08-16T10:52:48",
                "type": "string"
              },
              "NodeList": {
                "backendName": "NodeList",
                "description_en": "The compute nodes that are used to run the job",
                "description_zh": "作业执行节点列表",
                "example": "compute000",
                "type": "string"
              },
              "OutputLog": {
                "backendName": "Stdout",
                "description_en": "The standard output log file of the job",
                "description_zh": "作业标准输出日志文件",
                "example": "/home/xxx/STDIN.o1",
                "type": "string"
              },
              "Priority": {
                "backendName": "Priority",
                "description_en": "The priority of the job",
                "description_zh": "作业优先级",
                "example": "0",
                "type": "string"
              },
              "Resources": {
                "backendName": "Resources",
                "description_en": "The resources that were requested when the job was submitted",
                "description_zh": "作业提交时申请的资源数量",
                "properties": {
                  "Cores": {
                    "backendName": "Cores",
                    "description_en": "The number of vCPUs used by the job on each node",
                    "description_zh": "作业在每个节点上使用的CPU核数",
                    "example": "2",
                    "type": "string"
                  },
                  "Gpus": {
                    "backendName": "Gpus",
                    "description_en": "The number of GPUs used by the job on each node",
                    "description_zh": "作业在每个节点上使用的GPU数量",
                    "example": "1",
                    "type": "string"
                  },
                  "Memory": {
                    "backendName": "Memory",
                    "description_en": "The memory size used by the job on each node",
                    "description_zh": "作业在每个节点上使用的内存大小",
                    "example": "1gb",
                    "type": "string"
                  },
                  "Nodes": {
                    "backendName": "Nodes",
                    "description_en": "The number of nodes that are used to run the job",
                    "description_zh": "作业使用的节点数",
                    "example": "1",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "ResourcesUsed": {
                "backendName": "ResourcesUsed",
                "description_en": "The resources that are actually used by the job",
                "description_zh": "作业实际使用的资源数量",
                "properties": {
                  "Cores": {
                    "backendName": "Cores",
                    "description_en": "The number of vCPUs used by the job on each node",
                    "description_zh": "作业在每个节点上使用的CPU核数",
                    "example": "2",
                    "type": "string"
                  },
                  "Memory": {
                    "backendName": "Memory",
                    "description_en": "The memory size used by the job on each node",
                    "description_zh": "作业在每个节点上使用的内存大小",
                    "example": "512mb",
                    "type": "string"
                  },
                  "Nodes": {
                    "backendName": "Nodes",
                    "description_en": "The number of nodes that are used to run the job",
                    "description_zh": "作业使用的总节点数",
                    "example": "2",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "RunasUser": {
                "backendName": "RunasUser",
                "description_en": "The user to which the job belongs or that is used to submit the job. This user is a cluster-side user",
                "description_zh": "作业所属的用户，即提交作业时使用的用户。该用户为集群侧的用户",
                "example": "testuser",
                "type": "string"
              },
              "StartTime": {
                "backendName": "StartTime",
                "description_en": "The time when the job was started",
                "description_zh": "作业启动时间",
                "example": "2024-08-16T10:52:48",
                "type": "string"
              },
              "State": {
                "backendName": "State",
                "description_en": "The job state",
                "description_zh": "作业状态",
                "example": "Running",
                "type": "string"
              },
              "Variables": {
                "backendName": "Variables",
                "description_en": "The variables of the job",
                "description_zh": "作业的变量列表",
                "itemName": "Variables",
                "items": {
                  "description_en": "The environment variables",
                  "description_zh": "作业的环境变量",
                  "properties": {
                    "Name": {
                      "backendName": "Name",
                      "description_en": "The name of the environment variable",
                      "description_zh": "环境变量名称",
                      "example": "ProxyIP",
                      "type": "string"
                    },
                    "Value": {
                      "backendName": "Value",
                      "description_en": "The value of the environment variable",
                      "description_zh": "环境变量值",
                      "example": "10.x.x.x",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "04F0****-1335-****-A1D7-6C044FE7****",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Success": {
            "backendName": "Success",
            "description_en": "The request result. Valid values:\n\ntrue\nfalse",
            "description_zh": "请求结果，可能值：\n\ntrue：请求成功。\n\nfalse：请求失败",
            "example": "true",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
