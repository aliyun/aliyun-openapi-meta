{
  "camel_example": "aliyun ehpc ListNodes --region cn-hangzhou --ClusterId 'ehpc-hz-FYUr320000'",
  "cmd_full_name": "ehpc list-nodes",
  "cmd_name": "list-nodes",
  "deprecated": false,
  "description_en": "Queries the list of nodes in a cluster",
  "description_zh": "调用ListNodes查询指定集群中的节点列表",
  "kebab_example": "aliyun ehpc list-nodes --cluster-id ehpc-hz-FYUr320000 --api-version 2018-04-12 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "ListNodes",
  "operation": {
    "action": "ListNodes",
    "api_style": "RPC",
    "api_version": "2018-04-12",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ehpc-hz-FYUr32****",
      "help_en": "The ID of the cluster.\n\nYou can call the https://help.aliyun.com/document_detail/87116.html operation to query the cluster ID",
      "help_zh": "待查询的集群ID。\n\n您可以通过调用https://help.aliyun.com/document_detail/87116.html获取集群ID",
      "location": "query",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "Manager",
      "help_en": "The type of the node. Valid values:\n\nManager: management node\nLogin: logon node\nCompute: compute node",
      "help_zh": "节点类型。取值范围：\nManager：管控节点\nLogin：登录节点\nCompute：计算节点",
      "location": "query",
      "name": "role",
      "options": [
        "--role"
      ],
      "raw_name": "Role",
      "required": false,
      "type": "string"
    },
    {
      "example": "test-HostName",
      "help_en": "The name of the node. You can perform a fuzzy search. MySQL regular expressions are supported",
      "help_zh": "节点名称，支持模糊查询，支持MySQL的正则表达式",
      "location": "query",
      "name": "host_name",
      "options": [
        "--host-name"
      ],
      "raw_name": "HostName",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The number of the page to return. Pages start from page 1",
      "help_zh": "显示的页码，起始值为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of entries to return on each page. Valid values: 1 to 100.\n\nDefault value: 10",
      "help_zh": "每页显示的条数。取值范围：1~100\n\n默认值：10",
      "location": "query",
      "maximum": "100",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "Forward",
      "help_en": "The sorting method of the node list. Valid values:\n\nForward: sorts the nodes in chronological order.\nBackward: sorts the nodes in reverse chronological order.\n\nDefault value: Forward.\n\nThis parameter is used together with the SortBy parameter. If you set SortBy to AddedTime and set Sequence to Forward, nodes are queried in ascending order of time that they are added",
      "help_zh": "节点列表排序方式。取值范围：\nForward：正序排序。\nBackward：逆序排序。\n\n默认值：Forward\n\n和SortBy同时使用，如SortBy设置为AddedTime，Sequence设置为Forward，表示按节点加入时间正序查询",
      "location": "query",
      "name": "sequence",
      "options": [
        "--sequence"
      ],
      "raw_name": "Sequence",
      "required": false,
      "type": "string"
    },
    {
      "example": "AddedTime",
      "help_en": "The sorting method of the node list. Valid values:\n\nAddedTime: sorts the nodes by the time that they are added.\nHostName: sorts the nodes by their host names",
      "help_zh": "节点列表排序方式。取值范围：\nAddedTime：按加入时间排序\n\nHostName：按节点主机名称排序",
      "location": "query",
      "name": "sort_by",
      "options": [
        "--sort-by"
      ],
      "raw_name": "SortBy",
      "required": false,
      "type": "string"
    },
    {
      "example": "{\"status\":\"running\"}",
      "help_en": "The filter options of the node list.\n\nFormat: {\"status\":\"node_status\"}. Replace node_status with the node status. Valid values of node_status:\n\nuninit: The node is being installed.\nexception: An exception occurred on the node.\nrunning: The node is running.\niniting: The node is being initialized.\nreleasing: The node is being released.\nuntracking: The node is not added to the cluster.\nstopped: The node is stopped",
      "help_zh": "节点状态过滤选项。\n\n取值格式为：{\"status\":\"node_status\"}，请将其中node_status替换为节点的状态。节点的取值范围为：\n\nuninit：安装中\nexception：异常\nrunning：运行中\niniting：初始化中\nreleasing：释放中\nuntracking：未加入集群\nstopped：已停止",
      "location": "query",
      "name": "filter",
      "options": [
        "--filter"
      ],
      "raw_name": "Filter",
      "required": false,
      "type": "string"
    },
    {
      "example": "172.16.**.**",
      "help_en": "The private IP address of the node",
      "help_zh": "私网IP地址",
      "location": "query",
      "name": "private_ip_address",
      "options": [
        "--private-ip-address"
      ],
      "raw_name": "PrivateIpAddress",
      "required": false,
      "type": "string"
    },
    {
      "example": "compute",
      "help_en": "The prefix of the hostname. You can query nodes that have a specified prefix",
      "help_zh": "主机名前缀。查询具有指定前缀的节点",
      "location": "query",
      "name": "host_name_prefix",
      "options": [
        "--host-name-prefix"
