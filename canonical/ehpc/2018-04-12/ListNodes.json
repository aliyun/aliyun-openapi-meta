      "help_zh": "私网IP地址",
      "location": "query",
      "name": "private_ip_address",
      "options": [
        "--private-ip-address"
      ],
      "raw_name": "PrivateIpAddress",
      "required": false,
      "type": "string"
    },
    {
      "example": "compute",
      "help_en": "The hostname prefix. Queries nodes with the specified prefix",
      "help_zh": "主机名前缀。查询具有指定前缀的节点",
      "location": "query",
      "name": "host_name_prefix",
