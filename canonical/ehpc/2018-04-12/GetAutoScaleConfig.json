  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ClusterId": {
            "backendName": "ClusterId",
            "description_en": "The prefix of the queue name. You can query queues that have a specified prefix",
            "description_zh": "集群ID",
            "example": "ehpc-hz-FYUr32****",
            "type": "string",
            "visibility": "Public"
          },
          "ClusterType": {
            "backendName": "ClusterType",
            "description_en": "The ID of the cluster",
            "description_zh": "集群的调度器类型。可能值：\nslurm\npbs\nopengridscheduler\ndeadline",
            "example": "pbs",
            "type": "string",
            "visibility": "Public"
          },
          "ComputeEnableHt": {
            "backendName": "ComputeEnableHt",
            "description_en": "Specifies whether to enable hyper-threading for the ECS instance that is used as the compute node.\n\nYou can only disable hyper-threading for some instance types. The hyper-threading is enabled for ECS instances by default. For more information, see [Specify and view CPU options]（https://help.aliyun.com/document_detail/145895.html）",
            "description_zh": "计算节点对应的ECS实例是否开启超线程",
            "example": "true",
            "type": "boolean"
          },
          "DnsConfig": {
            "backendName": "DnsConfig",
            "description_en": "The configurations of DNS",
            "description_zh": "DNS配置信息",
            "example": "\"{\\\"DnsType\\\":\\\"PrivateZone\\\",\\\"DnsName\\\":\\\"xxxxx\\\"}\"",
            "type": "string"
          },
          "EnableAutoGrow": {
            "backendName": "EnableAutoGrow",
            "description_en": "The percentage of each round of scale-out. Valid values: 1 to 100.\n\nIf you set GrowRatio to 50, the scale-out has two rounds. Each round completes half of the scale-out",
            "description_zh": "集群是否启动自动扩容。可能值：\ntrue\nfalse",
            "example": "true",
            "type": "boolean",
            "visibility": "Public"
          },
          "EnableAutoShrink": {
            "backendName": "EnableAutoShrink",
            "description_en": "The number of consecutive times that a compute node is idle during the resource scale-in check. Valid values: 2 to 5.\n\nIf the parameter is set to 3, a compute node is idle for more than three consecutive times. In this case, the node is released",
            "description_zh": "集群是否启动自动缩容。可能值：\ntrue\nfalse",
            "example": "true",
            "type": "boolean",
            "visibility": "Public"
          },
          "ExcludeNodes": {
            "backendName": "ExcludeNodes",
            "description_en": "The ID of the Alibaba Cloud account",
            "description_zh": "不参与自动伸缩的节点列表，多个节点之间用半角逗号（,）隔开",
            "example": "i-bp19lgqwxb4206t5****,i-bp1g4hvzs9pywrhb****",
            "type": "string",
            "visibility": "Public"
          },
          "ExtraNodesGrowRatio": {
            "backendName": "ExtraNodesGrowRatio",
            "description_en": "The instance type of the compute nodes that were automatically added in the queue",
            "description_zh": "额外节点百分比。可能值：0~100\n\n如果作业负载需要新增100个计算节点，ExtraNodesGrowRatio值为2，那么最终新增数量为102",
            "example": "2",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "GrowIntervalInMinutes": {
            "backendName": "GrowIntervalInMinutes",
            "description_en": "The image ID of the compute nodes in the queue",
            "description_zh": "扩容时间间隔，每轮计算节点扩容的时间间隔。单位：分钟，可能值：2~10\n\n一次扩容任务可能会分几次完成，或者连续触发扩容时的时间间隔",
            "example": "2",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "GrowRatio": {
            "backendName": "GrowRatio",
