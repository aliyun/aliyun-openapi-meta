          "registryConfig": {
            "$ref": "#/components/schemas/RegistryConfig",
            "backendName": "registryConfig",
            "description_en": "The configuration of the custom image repository. This parameter is used when imageRegistryType is set to CUSTOM",
            "description_zh": "自定义镜像仓库的配置信息，当imageRegistryType为CUSTOM时使用",
            "example": "{}",
            "title": "镜像仓库配置"
          }
        },
        "title": "自定义容器配置",
        "type": "object"
      },
      "CredentialConfiguration": {
        "description_en": "Specifies the configuration for credentials used to access external services",
        "description_zh": "访问外部服务的凭证配置",
