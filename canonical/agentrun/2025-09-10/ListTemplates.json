          },
          "imageRegistryType": {
            "backendName": "imageRegistryType",
            "description_en": "The source type of the container image. Valid values: ACR (Alibaba Cloud Container Registry), ACREE (Alibaba Cloud Container Registry Enterprise Edition), and CUSTOM (custom image repository)",
