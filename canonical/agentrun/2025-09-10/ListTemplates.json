            "enum": [
              "ACR",
              "ACREE",
              "CUSTOM"
            ],
            "example": "ACR",
            "title": "镜像仓库类型",
            "type": "string"
          },
          "port": {
            "backendName": "port",
            "description_en": "The port number that the sandbox runtime listens on",
            "description_zh": "沙箱运行时监听的端口号",
