{
  "camel_example": "aliyun cddc DescribeDedicatedHostGroups --region cn-hangzhou --DedicatedHostGroupId 'dhg-872yt76ann7e****' --ImageCategory AliLinux --RegionId 'cn-hangzhou' --Engine MySQL --version 2020-03-20 --method POST --force",
