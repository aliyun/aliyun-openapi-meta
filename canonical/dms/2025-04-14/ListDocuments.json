  "cmd_full_name": "dms list-documents",
  "cmd_name": "list-documents",
  "components": {
    "schemas": {
      "OneMetaKnowledgeBaseDocument": {
        "description_en": "Information about a document in the knowledge base",
        "description_zh": "文档信息",
        "properties": {
          "Description": {
            "backendName": "description",
            "description_en": "The document description",
            "description_zh": "文档描述",
            "example": "abc",
            "title": "文档描述",
            "type": "string"
          },
          "DocsCount": {
            "backendName": "docsCount",
            "description_en": "The number of chunks",
            "description_zh": "知识块数量",
            "example": "123",
            "format": "int32",
            "title": "chunk 数量",
            "type": "integer"
          },
          "DocumentLoaderName": {
            "backendName": "documentLoaderName",
            "description_en": "The name of the document loader",
            "description_zh": "文档加载器名称",
            "example": "ADBPGLoader",
            "title": "文档加载器名称",
            "type": "string"
          },
          "FileExt": {
            "backendName": "fileExt",
            "description_en": "The file extension",
            "description_zh": "文档扩展类型",
