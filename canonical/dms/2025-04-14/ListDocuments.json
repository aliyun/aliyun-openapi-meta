            "format": "int64",
            "title": "文件大小",
            "type": "integer"
          },
          "GmtCreate": {
            "backendName": "gmtCreate",
            "description_en": "When the document was created",
            "description_zh": "文档创建时间",
            "example": "2026-04-22 22:59:35",
            "title": "创建时间",
            "type": "string"
          },
          "GmtModified": {
            "backendName": "gmtModified",
            "description_en": "When the document was last modified",
            "description_zh": "文档修改时间",
            "example": "2026-04-24 21:22:53",
            "title": "修改时间",
            "type": "string"
          },
          "KbUuid": {
            "backendName": "kbUuid",
            "description_en": "The knowledge base ID",
            "description_zh": "知识库ID",
            "example": "kb-***",
            "title": "知识库Uuid",
            "type": "string"
          },
          "Keywords": {
            "backendName": "keywords",
            "description_en": "Keywords extracted from the document",
            "description_zh": "文档关键词",
            "example": "[\"test\",\"abc\"]",
            "type": "string"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The document name",
            "description_zh": "文档名称",
            "example": "test.md",
            "title": "文档名称",
            "type": "string"
          },
          "State": {
            "backendName": "state",
            "description_en": "The document status. Valid values are:\n\n0: Complete.\n\n-1: Unprocessed.\n\n-2: Parsing.\n\n-3: Failed.\n\n-4: Canceled",
            "description_zh": "文档状态，返回值如下：\n\n0：文档解析完成。\n-1：文档未解析。\n-2：文档解析中。\n-3：文档解析失败。\n-4：文档解析取消",
            "example": "0",
            "format": "int32",
            "title": "文档状态：\n0：正常\n-1：未解析\n-2：解析中\n-3：解析失败\n-4：解析取消",
            "type": "integer"
          },
          "Summary": {
            "backendName": "summary",
            "description_en": "The summary of the document",
            "description_zh": "文档摘要",
            "example": "This is a test document.",
            "type": "string"
          },
          "TextSplitterName": {
            "backendName": "textSplitterName",
            "description_en": "The name of the text splitter",
            "description_zh": "文档分词器名称",
            "example": "ChineseRecursiveTextSplitter",
            "title": "文档分词器名称",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
