{
  "camel_example": "aliyun esa GetEdgeContainerApp --region cn-hangzhou --AppId 'app-880688675783790000'",
  "cmd_full_name": "esa get-edge-container-app",
  "cmd_name": "get-edge-container-app",
  "deprecated": false,
  "description_en": "Retrieves application information for an edge container, including basic application configurations and health check settings",
  "description_zh": "获取边缘容器的应用信息，包括应用基础配置、健康检查等信息",
  "kebab_example": "aliyun esa get-edge-container-app --app-id app-880688675783790000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetEdgeContainerApp",
  "operation": {
    "action": "GetEdgeContainerApp",
    "api_style": "RPC",
    "api_version": "2024-09-10",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "app-88068867578379****",
      "help_en": "The application ID. You can obtain the application ID by calling the [ListEdgeContainerApps](~~ListEdgeContainerApps~~) operation",
      "help_zh": "应用ID，可使用[ListEdgeContainerApps](~~ListEdgeContainerApps~~)接口获取应用ID",
      "location": "query",
      "max_length": "64",
      "min_length": "20",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ESA",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "App": {
            "backendName": "data.content.App",
            "description_en": "The basic application information",
            "description_zh": "应用基础信息",
            "properties": {
              "AppId": {
                "backendName": "AppId",
                "description_en": "The application ID",
                "description_zh": "应用ID",
                "example": "app-88068867578379****",
                "type": "string"
              },
              "CreateTime": {
                "backendName": "CreateTime",
                "description_en": "The creation time. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
                "description_zh": "创建时间。日期格式按照 ISO8601 表示法，并使用 UTC 时间，格式为 yyyy-MM-ddTHH:mm:ssZ",
                "example": "2023-07-25T05:58:05Z",
                "type": "string"
              },
              "DomainName": {
                "backendName": "DomainName",
                "description_en": "The domain name bound to the application. If no domain name is bound, an empty string is returned",
                "description_zh": "当前应用绑定的域名，如果未绑定，则为空字符串",
                "example": "www.1feel.cn",
                "type": "string"
              },
              "GatewayType": {
                "backendName": "GatewayType",
                "description_en": "The gateway type. Valid values:\nl7: Layer 7 gateway.\nl4: Layer 4 gateway",
                "description_zh": "网关类型，可能值：\nl7：七层网关\nl4：四层网关",
                "example": "l7",
                "type": "string"
              },
              "HealthCheck": {
                "backendName": "HealthCheck",
                "description_en": "The health check information",
                "description_zh": "表示健康检查信息的对象",
                "properties": {
                  "FailTimes": {
                    "backendName": "fail_times",
                    "description_en": "The number of consecutive failed health checks required",
                    "description_zh": "应用的健康检查连续失败次数",
                    "example": "5",
                    "format": "int32",
                    "type": "integer"
                  },
                  "Host": {
                    "backendName": "host",
                    "description_en": "The domain name used for the health check",
                    "description_zh": "应用健康检查的域名",
                    "example": "test.com",
                    "type": "string"
                  },
                  "HttpCode": {
                    "backendName": "http_code",
                    "description_en": "The range of HTTP status codes that indicate a successful health check",
                    "description_zh": "应用的健康检查成功的状态码范围",
                    "example": "http_2xx",
                    "type": "string"
                  },
                  "Interval": {
                    "backendName": "interval",
                    "description_en": "The interval between health checks. Unit: seconds",
                    "description_zh": "应用健康检查的间隔时间，单位秒",
                    "example": "5",
                    "format": "int32",
                    "type": "integer"
                  },
                  "Method": {
                    "backendName": "method",
                    "description_en": "The method used for the health check",
                    "description_zh": "应用的健康检查的方法",
                    "example": "HEAD",
                    "type": "string"
                  },
                  "Port": {
                    "backendName": "port",
                    "description_en": "The Health Check Port of the application",
                    "description_zh": "应用的健康检查端口",
                    "example": "80",
                    "format": "int32",
                    "type": "integer"
                  },
                  "SuccTimes": {
                    "backendName": "succ_times",
                    "description_en": "The number of consecutive successful health checks required",
                    "description_zh": "应用的健康检查连续成功次数",
                    "example": "3",
                    "format": "int32",
                    "type": "integer"
                  },
                  "Timeout": {
                    "backendName": "timeout",
                    "description_en": "The timeout period of the health check. Unit: seconds",
                    "description_zh": "应用健康检查超时时间，单位为秒",
                    "example": "60",
                    "format": "int32",
                    "type": "integer"
                  },
                  "Type": {
                    "backendName": "type",
                    "description_en": "The health check type. Valid values:\nl7: Layer 7 gateway.\nl4: Layer 4 gateway",
                    "description_zh": "应用健康检查类型，取值：\nl7：七层网关\nl4：四层网关",
                    "example": "l7",
                    "type": "string"
                  },
                  "Uri": {
                    "backendName": "uri",
                    "description_en": "The path used for the health check",
                    "description_zh": "应用的健康检查的路径",
                    "example": "/health_check",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "Name": {
                "backendName": "Name",
                "description_en": "The application name",
                "description_zh": "应用名称",
                "example": "test-app1",
                "type": "string"
              },
              "QuicCid": {
                "backendName": "QuicCid",
                "description_en": "Indicates whether QUIC support is enabled",
                "description_zh": "是否开启QUIC支持",
                "example": "false",
                "type": "string"
              },
              "Remarks": {
                "backendName": "Remarks",
                "description_en": "The remarks of the application",
                "description_zh": "应用的备注信息",
                "example": "test app",
                "type": "string"
              },
              "ServicePort": {
                "backendName": "ServicePort",
                "description_en": "The service port number. Valid values: 1 to 65535",
                "description_zh": "服务端端口号，范围1~65535",
                "example": "80",
                "format": "int32",
                "type": "integer"
              },
              "Status": {
                "backendName": "State",
                "description_en": "The status of the application. Valid values:\ncreating: Being created.\nfailed: Creation failed.\ncreated: Created",
                "description_zh": "应用的状态信息，取值为：\ncreating：创建中\nfailed：创建失败\ncreated：创建成功",
                "example": "created",
                "type": "string"
              },
              "TargetPort": {
                "backendName": "TargetPort",
                "description_en": "The backend port, which is also the service port of the application. Valid values: 1 to 65535",
                "description_zh": "后端端口，也是应用的服务端口，范围1~65535",
                "example": "80",
                "format": "int32",
                "type": "integer"
              },
              "UpdateTime": {
                "backendName": "ModifyTime",
                "description_en": "The last modification time of the application. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
                "description_zh": "应用的上次修改时间。日期格式按照ISO8601表示法，并使用UTC时间，格式为yyyy-MM-ddTHH:mm:ssZ",
                "example": "2023-03-26T02:35:58Z",
                "type": "string"
              },
              "VersionCount": {
                "backendName": "VersionCount",
                "description_en": "The number of application versions",
                "description_zh": "应用版本数量",
                "example": "1",
                "format": "int32",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "156A6B-677B1A-4297B7-9187B7-2B44792",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
