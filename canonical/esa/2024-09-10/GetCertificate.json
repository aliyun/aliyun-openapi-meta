{
  "camel_example": "aliyun esa GetCertificate --region cn-hangzhou --SiteId 1234567890123 --Id babaded901474b9693acf530e0fb1d95",
  "cmd_full_name": "esa get-certificate",
  "cmd_name": "get-certificate",
  "deprecated": false,
  "description_en": "Retrieves information about a specified certificate for a site",
  "description_zh": "获取站点下指定证书信息",
  "kebab_example": "aliyun esa get-certificate --site-id 1234567890123 --id babaded901474b9693acf530e0fb1d95 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetCertificate",
  "operation": {
    "action": "GetCertificate",
    "api_style": "RPC",
    "api_version": "2024-09-10",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "1234567890123",
      "help_en": "The site ID. You can call the [ListSites](~~ListSites~~) operation to query the site ID",
      "help_zh": "站点ID，可通过调用[ListSites](~~ListSites~~)接口查询获取",
      "location": "query",
      "name": "site_id",
      "options": [
        "--site-id"
      ],
      "raw_name": "SiteId",
      "required": true,
      "type": "int"
    },
    {
      "example": "babaded901474b9693acf530e0fb1d95",
      "help_en": "The certificate ID",
      "help_zh": "证书Id",
      "location": "query",
      "name": "id",
      "options": [
        "--id"
      ],
      "raw_name": "Id",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ESA",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Certificate": {
            "backendName": "data.content.Certificate",
            "description_en": "The certificate content",
            "description_zh": "证书内容",
            "example": "-----BEGIN CERTIFICATE-----",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "04F0F334-1335-436C-A1D7-6C044FE73368",
            "type": "string"
          },
          "Result": {
            "backendName": "data.content.Result",
            "description_en": "The certificate information",
            "description_zh": "证书信息",
            "properties": {
              "ApplyCode": {
                "backendName": "ApplyCode",
                "description_en": "The error code of the certificate application",
                "description_zh": "证书申请错误码",
                "example": "2",
                "format": "int64",
                "type": "integer"
              },
              "ApplyMessage": {
                "backendName": "ApplyMessage",
                "description_en": "The error message of the certificate application",
                "description_zh": "证书申请错误信息",
                "example": "canceled",
                "type": "string"
              },
              "CasId": {
                "backendName": "CasId",
                "description_en": "The cloud certificate ID",
                "description_zh": "云证书Id",
                "example": "30000478",
                "type": "string"
              },
              "CommonName": {
                "backendName": "CommonName",
                "description_en": "The Common Name (CN) field of the certificate",
                "description_zh": "证书通用名称CN字段",
                "example": "www.example.com",
                "type": "string"
              },
              "CreateTime": {
                "backendName": "CreateTime",
                "description_en": "The creation time. The time is in the YYYY-MM-DD HH:MM:SS format in the UTC/GMT time zone",
                "description_zh": "创建时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                "example": "2026-07-01 07:25:23",
                "type": "string"
              },
              "DCV": {
                "backendName": "DCV",
                "description_en": "The Domain Control Validation (DCV) information",
                "description_zh": "DCV信息",
                "itemName": "DCV",
                "items": {
                  "description_en": "The Domain Control Validation (DCV) information",
                  "description_zh": "DCV信息",
                  "properties": {
                    "Id": {
                      "backendName": "Id",
                      "description_en": "DCV ID",
                      "description_zh": "DCV ID",
                      "example": "bababf7cdd1546a2ad04c0def1f4c980",
                      "type": "string"
                    },
                    "Key": {
                      "backendName": "Key",
                      "description_en": "The DCV name. For the DNS type, this is the TXT record name. For the HTTP type, this is the URL",
                      "description_zh": "DCV名称。DNS类型为TXT记录名；HTTP类型为URL",
                      "example": "http://www.example.com/.well-known/acme-challenge/pH20CqwS5L3ZnvkhI436DCzadKFuG7QcUcvB_4KsAow",
                      "type": "string"
                    },
                    "Status": {
                      "backendName": "Status",
                      "description_en": "The validation status",
                      "description_zh": "验证状态",
                      "example": "pending",
                      "type": "string"
                    },
                    "Type": {
                      "backendName": "Type",
                      "description_en": "The DCV type. Valid values: DNS and HTTP",
                      "description_zh": "DCV类型。可能值：DNS；HTTP",
                      "example": "HTTP",
                      "type": "string"
                    },
                    "Value": {
                      "backendName": "Value",
                      "description_en": "The DCV content",
                      "description_zh": "DCV内容",
                      "example": "pH20CqwS5L3ZnvkhI436DCzadKFuG7QcUcvB_4KsAow.KfzYo4LH3EgOt7a73G-RqZkbR0eYtLfEUmtmqGmr4FQ",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "FingerprintSha256": {
                "backendName": "FingerprintSha256",
                "description_en": "The SHA-256 fingerprint of the certificate",
                "description_zh": "证书sha256指纹",
                "example": "1dc5fc9af4eead2570c70d94b416130baeb6d4429b51fd3557379588456aca66",
                "type": "string"
              },
              "Id": {
                "backendName": "Id",
                "description_en": "The certificate ID",
                "description_zh": "证书Id",
                "example": "babaded901474b9693acf530e0fb1d95",
                "type": "string"
              },
              "Issuer": {
                "backendName": "Issuer",
                "description_en": "The certificate issuer",
                "description_zh": "证书发行商",
                "example": "DigiCert",
                "type": "string"
              },
              "IssuerCN": {
                "backendName": "IssuerCN",
                "description_en": "The certification authority",
                "description_zh": "证书颁发机构",
                "example": "DigiCert Global Root CA",
                "type": "string"
              },
              "KeyServerId": {
                "backendName": "KeyServerId",
                "description_en": "The Keyless server ID. This parameter is valid only when Type is set to keyless",
                "description_zh": "Keyless server ID，当Type为keyless时有效",
                "example": "baba39055622c008b90285a8838e****",
                "type": "string"
              },
              "Name": {
                "backendName": "Name",
                "description_en": "The certificate name",
                "description_zh": "证书名称",
                "example": "yourCertName",
                "type": "string"
              },
              "NotAfter": {
                "backendName": "NotAfter",
                "description_en": "The end time of the certificate validity period. The time is in the YYYY-MM-DD HH:MM:SS format in the UTC/GMT time zone",
                "description_zh": "证书有效期的截止时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                "example": "2026-09-29 06:26:46",
                "type": "string"
              },
              "NotBefore": {
                "backendName": "NotBefore",
                "description_en": "The start time of the certificate validity period. The time is in the YYYY-MM-DD HH:MM:SS format in the UTC/GMT time zone",
                "description_zh": "证书有效期的开始时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                "example": "2026-07-01 06:26:47",
                "type": "string"
              },
              "PubAlg": {
                "backendName": "PubAlg",
                "description_en": "The public key algorithm of the certificate",
                "description_zh": "证书公钥算法",
                "example": "ECDSA",
                "type": "string"
              },
              "Region": {
                "backendName": "Region",
                "description_en": "The region",
                "description_zh": "地域",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "SAN": {
                "backendName": "SAN",
                "description_en": "The Subject Alternative Name (SAN) of the certificate",
                "description_zh": "证书主题备用名",
                "example": "www.example.com,*.example.com",
                "type": "string"
              },
              "SerialNumber": {
                "backendName": "SerialNumber",
                "description_en": "The certificate serial number",
                "description_zh": "证书的序列号",
                "example": "babaded901474b9693acf530e0fb1daa",
                "type": "string"
              },
              "SigAlg": {
                "backendName": "SigAlg",
                "description_en": "The signature algorithm of the certificate",
                "description_zh": "证书签名算法",
                "example": "ECDSA-SHA1",
                "type": "string"
              },
              "Status": {
                "backendName": "Status",
                "description_en": "The certificate status",
                "description_zh": "证书状态",
                "example": "OK",
                "type": "string"
              },
              "Type": {
                "backendName": "Type",
                "description_en": "The certificate type",
                "description_zh": "证书类型",
                "example": "free",
                "type": "string"
              },
              "UpdateTime": {
                "backendName": "UpdateTime",
                "description_en": "The update time. The time is in the YYYY-MM-DD HH:MM:SS format in the UTC/GMT time zone",
                "description_zh": "更新时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                "example": "2026-07-01 07:25:23",
                "type": "string"
              }
            },
            "type": "object"
          },
          "SiteId": {
            "backendName": "data.content.SiteId",
            "description_en": "The site ID",
            "description_zh": "站点ID",
            "example": "1234567890123",
            "format": "int64",
            "type": "integer"
          },
          "SiteName": {
            "backendName": "data.content.SiteName",
            "description_en": "The site name",
            "description_zh": "站点名称",
            "example": "example.com ",
            "type": "string"
          },
          "Status": {
            "backendName": "data.content.Status",
            "description_en": "The certificate status",
            "description_zh": "证书状态",
            "example": "OK",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
