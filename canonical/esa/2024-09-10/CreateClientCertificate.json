  "method": "POST",
  "multi_version": false,
  "name": "CreateClientCertificate",
  "operation": {
    "action": "CreateClientCertificate",
    "api_style": "RPC",
    "api_version": "2024-09-10",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "1234567890123",
      "help_en": "The site ID",
      "help_zh": "站点ID",
      "location": "query",
      "name": "site_id",
      "options": [
        "--site-id"
      ],
      "raw_name": "SiteId",
      "required": true,
      "type": "int"
    },
    {
      "example": "-----BEGIN CERTIFICATE REQUEST-----",
      "help_en": "The certificate signing request (CSR) content",
      "help_zh": "证书签名请求内容",
      "location": "formData",
      "name": "csr",
      "options": [
        "--csr"
      ],
      "raw_name": "CSR",
      "required": false,
      "type": "string"
    },
    {
      "example": "RSA",
      "help_en": "The private key algorithm type. This parameter is required if CSR is not provided",
      "help_zh": "私钥算法类型，当不提供 CSR 时为必填项",
      "location": "formData",
      "name": "pkey_type",
      "options": [
        "--pkey-type"
      ],
      "raw_name": "PkeyType",
      "required": false,
      "type": "string"
    },
    {
      "example": "365",
      "help_en": "The validity period of the certificate. Unit: days",
      "help_zh": "证书有效期，单位：天",
      "location": "formData",
      "name": "validity_days",
      "options": [
        "--validity-days"
      ],
      "raw_name": "ValidityDays",
      "required": true,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "ESA",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "CACertificateId": {
            "backendName": "data.content.CaCertId",
            "description_en": "The CA certificate ID",
            "description_zh": "CA证书ID",
            "example": "babaded901474b9693acf530e0fb1dbb",
            "type": "string"
          },
          "Certificate": {
            "backendName": "data.content.Certificate",
            "description_en": "The certificate content",
            "description_zh": "证书内容",
            "example": "-----BEGIN CERTIFICATE-----",
            "type": "string"
          },
          "CommonName": {
            "backendName": "data.content.CommonName",
            "description_en": "The common name of the certificate",
            "description_zh": "证书通用名称",
            "example": "www.example.com ",
            "type": "string"
          },
          "FingerprintSha256": {
            "backendName": "data.content.FingerprintSha256",
            "description_en": "The SHA-256 fingerprint of the certificate",
            "description_zh": "证书sha256指纹",
            "example": "1dc5fc9af4eead2570c70d94b416130baeb6d4429b51fd3557379588456aca66",
            "type": "string"
          },
          "Id": {
            "backendName": "data.content.Id",
            "description_en": "The certificate ID",
            "description_zh": "证书Id",
            "example": "babaded901474b9693acf530e0fb1d95",
            "type": "string"
          },
          "Issuer": {
            "backendName": "data.content.IssuerCN",
            "description_en": "The certification authority that issued the certificate",
            "description_zh": "证书颁发机构",
            "example": "ESA CA",
            "type": "string"
          },
          "NotAfter": {
            "backendName": "data.content.NotAfter",
            "description_en": "The end time of the certificate validity period",
            "description_zh": "证书有效期的截止时间",
            "example": "2024-12-01T02:12:49Z",
            "type": "string"
          },
          "NotBefore": {
            "backendName": "data.content.NotBefore",
            "description_en": "The start time of the certificate validity period",
            "description_zh": "证书有效期的开始时间",
            "example": "2023-12-01T02:12:49Z",
            "type": "string"
          },
          "PrivateKey": {
            "backendName": "data.content.PrivateKey",
            "description_en": "The private key of the certificate",
            "description_zh": "证书私钥",
            "example": "-----BEGIN PRIVATE KEY-----",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "C370DAF1-C838-4288-A1A0-9A87633D248E",
            "type": "string"
          },
          "SerialNumber": {
            "backendName": "data.content.SerialNumber",
            "description_en": "The certificate serial number",
            "description_zh": "证书序列号",
            "example": "babaded901474b9693acf530e0fb1daa",
            "type": "string"
          },
          "SignatureAlgorithm": {
            "backendName": "data.content.SigAlg",
            "description_en": "The signature algorithm of the certificate",
            "description_zh": "证书签名算法",
            "example": "SHA256-RSA",
            "type": "string"
          },
          "Status": {
            "backendName": "data.content.Status",
            "description_en": "The certificate status",
            "description_zh": "证书状态",
            "example": "active",
            "type": "string"
          },
          "ValidityDays": {
            "backendName": "data.content.ValidityDays",
            "description_en": "The validity period of the certificate",
            "description_zh": "证书有效期",
            "example": "365",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
