                        "type": "string"
                      },
                      "Id": {
                        "backendName": "Id",
                        "description_en": "The certificate ID",
                        "description_zh": "证书ID",
                        "example": "babab022c5e9b27bf9c64d7f4b1667f4",
                        "type": "string"
                      },
                      "Issuer": {
                        "backendName": "Issuer",
                        "description_en": "The certificate issuer",
                        "description_zh": "证书发行商",
                        "example": "GlobalSign nv-sa",
                        "type": "string"
                      },
                      "IssuerCN": {
                        "backendName": "IssuerCN",
                        "description_en": "The common name of the certificate issuer",
                        "description_zh": "证书发行商通用名",
                        "example": "GlobalSign Organization Validation CA - SHA256 - G3",
                        "type": "string"
                      },
                      "KeyServerId": {
                        "backendName": "KeyServerId",
                        "description_en": "The Keyless server ID. This parameter is valid only when Type is set to keyless",
                        "description_zh": "Keyless server ID，当Type为keyless时有效",
                        "example": "baba39055622c008b90285a8838e****\n",
                        "type": "string"
                      },
                      "Name": {
                        "backendName": "Name",
                        "description_en": "The certificate name",
                        "description_zh": "证书名称",
                        "example": "yourCertName",
                        "type": "string"
                      },
                      "NotAfter": {
                        "backendName": "NotAfter",
                        "description_en": "The end time of the certificate validity period. Format: YYYY-MM-DD HH:MM:SS, in the UTC/GMT time zone",
                        "description_zh": "证书有效期截止时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                        "example": "2024-02-28 06:17:11",
                        "type": "string"
                      },
                      "NotBefore": {
                        "backendName": "NotBefore",
                        "description_en": "The start time of the certificate validity period. Format: YYYY-MM-DD HH:MM:SS, in the UTC/GMT time zone",
                        "description_zh": "证书有效期开始时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                        "example": "2023-02-28 06:17:11",
                        "type": "string"
                      },
                      "PubAlg": {
                        "backendName": "PubAlg",
                        "description_en": "The public key algorithm of the certificate",
                        "description_zh": "证书公钥算法",
                        "example": "RSA",
                        "type": "string"
                      },
                      "Region": {
                        "backendName": "Region",
                        "description_en": "The certificate store area",
                        "description_zh": "证书存储区域",
                        "example": "cn-hangzhou",
                        "type": "string"
                      },
                      "SAN": {
                        "backendName": "SAN",
                        "description_en": "The Subject Alternative Name (SAN) of the certificate",
                        "description_zh": "证书主题备用名",
                        "example": "www.example.com,*.example.com",
                        "type": "string"
                      },
                      "SerialNumber": {
                        "backendName": "SerialNumber",
                        "description_en": "The certificate serial number",
                        "description_zh": "证书序列号",
                        "example": "baba39055622c008b90285a8838ed09a",
                        "type": "string"
                      },
                      "SigAlg": {
                        "backendName": "SigAlg",
                        "description_en": "The signature algorithm of the certificate",
                        "description_zh": "证书签名算法",
                        "example": "SHA256-RSA",
                        "type": "string"
                      },
                      "Status": {
                        "backendName": "Status",
                        "description_en": "The certificate status",
                        "description_zh": "证书状态",
                        "example": "OK",
                        "type": "string"
                      },
                      "Type": {
                        "backendName": "Type",
                        "description_en": "The certificate type",
                        "description_zh": "证书类型",
                        "example": "free",
                        "type": "string"
                      },
                      "UpdateTime": {
                        "backendName": "UpdateTime",
                        "description_en": "The update time. Format: YYYY-MM-DD HH:MM:SS, in the UTC/GMT time zone",
                        "description_zh": "更新时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                        "example": "2023-02-28 06:17:11",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "Count": {
                  "backendName": "Count",
                  "description_en": "The number of certificates that match the record",
                  "description_zh": "匹配记录的证书个数",
                  "example": "3",
                  "format": "int64",
                  "type": "integer"
                },
                "RecordName": {
                  "backendName": "Record",
                  "description_en": "The record name",
                  "description_zh": "记录名称",
                  "example": "www.example.com ",
                  "type": "string"
                },
                "Status": {
                  "backendName": "Status",
                  "description_en": "The certificate configuration status of the record. Valid values:\nnone: Not configured.\nconfigured: Configured.\napplying: Being applied for.\nfailed: Application failed",
                  "description_zh": "Record证书配置状态。可能值：none：未配置；configured：已配置；applying：正在申请；failed：申请失败",
                  "example": "none",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "SiteId": {
            "backendName": "data.content.SiteId",
            "description_en": "The site ID",
            "description_zh": "站点ID",
            "example": "1234567890123",
            "format": "int64",
            "type": "integer"
          },
          "SiteName": {
            "backendName": "data.content.SiteName",
            "description_en": "The site name",
            "description_zh": "站点名称",
            "example": "example.com ",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.content.TotalCount",
            "description_en": "The total number of entries, which is the same as the number of records",
            "description_zh": "总条数，数量和记录数相同",
            "example": "12",
            "format": "int64",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
