              "description_en": "The result",
              "description_zh": "结果",
              "properties": {
                "ApplylingCount": {
                  "backendName": "ApplylingCount",
                  "description_en": "The number of certificates being applied for",
                  "description_zh": "正在申请的证书数量",
                  "example": "1",
                  "format": "int64",
                  "type": "integer"
                },
                "Certificates": {
                  "backendName": "Certificates",
                  "description_en": "The list of certificates that match the record",
                  "description_zh": "匹配记录的证书信息列表",
                  "itemName": "CertItem",
                  "items": {
                    "description_en": "The certificate information",
                    "description_zh": "证书信息",
                    "properties": {
                      "CasId": {
                        "backendName": "CasId",
                        "description_en": "The cloud certificate ID",
                        "description_zh": "云证书Id",
