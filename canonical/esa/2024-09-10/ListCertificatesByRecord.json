{
  "camel_example": "aliyun esa ListCertificatesByRecord --region cn-hangzhou --RecordName 'www.example.com' --SiteId 1234567890123",
  "cmd_full_name": "esa list-certificates-by-record",
  "cmd_name": "list-certificates-by-record",
  "deprecated": false,
  "description_en": "Queries the list of site certificates that match records. Batch record matching is supported",
  "description_zh": "查看匹配记录的站点证书列表，支持批量记录匹配",
  "kebab_example": "aliyun esa list-certificates-by-record --site-id 1234567890123 --record-name www.example.com --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ListCertificatesByRecord",
  "operation": {
    "action": "ListCertificatesByRecord",
    "api_style": "RPC",
    "api_version": "2024-09-10",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": ""
  },
  "parameters": [
    {
      "example": "1234567890123\n",
      "help_en": "The site ID. You can call the [ListSites](~~ListSites~~) operation to query the site ID",
      "help_zh": "站点ID，可通过调用[ListSites](~~ListSites~~)接口查询获取",
      "location": "query",
      "name": "site_id",
      "options": [
        "--site-id"
      ],
      "raw_name": "SiteId",
      "required": true,
      "type": "int"
    },
    {
      "example": "www.example.com ",
      "help_en": "The record name",
      "help_zh": "记录名称",
      "location": "query",
      "name": "record_name",
      "options": [
        "--record-name"
      ],
      "raw_name": "RecordName",
      "required": true,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to return only valid certificates",
      "help_zh": "是否仅返回有效证书",
      "location": "query",
      "name": "valid_only",
      "options": [
        "--valid-only"
      ],
      "raw_name": "ValidOnly",
      "required": false,
      "type": "bool"
    },
    {
      "example": "true",
      "help_en": "Specifies whether to return certificate details",
      "help_zh": "是否返回证书详情",
      "location": "query",
      "name": "detail",
      "options": [
        "--detail"
      ],
      "raw_name": "Detail",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "ESA",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "65C66B7B-671A-8297-9187-2R5477247B76",
            "type": "string"
          },
          "Result": {
            "backendName": "data.content.Result",
            "description_en": "The result array",
            "description_zh": "结果数组",
            "itemName": "RecordItem",
