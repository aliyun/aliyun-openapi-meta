                  "backendName": "FingerprintSha256",
                  "description_en": "The SHA-256 fingerprint of the certificate",
                  "description_zh": "证书Sha256指纹",
                  "example": "1dc5fc9af4eead2570c70d94b416130baeb6d4429b51fd3557379588456a****",
                  "type": "string"
                },
                "Id": {
                  "backendName": "Id",
                  "description_en": "The certificate ID",
                  "description_zh": "证书Id",
                  "example": "baba39055622c008b90285a8838e****",
                  "type": "string"
                },
                "Issuer": {
                  "backendName": "Issuer",
                  "description_en": "The certificate issuer",
                  "description_zh": "证书发行商",
                  "example": "GlobalSign nv-sa",
                  "type": "string"
                },
                "IssuerCN": {
                  "backendName": "IssuerCN",
                  "description_en": "The common name of the certificate issuer",
                  "description_zh": "证书发行商通用名",
                  "example": "GlobalSign Organization Validation CA - SHA256 - G3",
                  "type": "string"
                },
                "KeyServerId": {
                  "backendName": "KeyServerId",
                  "description_en": "The Keyless server ID. This parameter is valid only when Type is set to keyless",
                  "description_zh": "Keyless server ID，当Type为keyless时有效",
                  "example": "baba39055622c008b90285a8838e****\n",
                  "type": "string"
                },
                "Name": {
                  "backendName": "Name",
                  "description_en": "The certificate name",
                  "description_zh": "证书名称",
                  "example": "yourCertName",
                  "type": "string"
                },
                "NotAfter": {
                  "backendName": "NotAfter",
                  "description_en": "The end time of the certificate validity period. Format: YYYY-MM-DD HH:MM:SS, in UTC/GMT time zone",
                  "description_zh": "证书有效期截止时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                  "example": "2024-03-31 02:08:00",
                  "type": "string"
                },
                "NotBefore": {
                  "backendName": "NotBefore",
                  "description_en": "The start time of the certificate validity period. Format: YYYY-MM-DD HH:MM:SS, in UTC/GMT time zone",
                  "description_zh": "证书有效期开始时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                  "example": "2023-03-31 02:08:00",
                  "type": "string"
                },
                "PubAlg": {
                  "backendName": "PubAlg",
                  "description_en": "The public key algorithm of the certificate",
                  "description_zh": "证书公钥算法",
                  "example": "RSA",
                  "type": "string"
                },
                "Region": {
                  "backendName": "Region",
                  "description_en": "The region information",
                  "description_zh": "地域信息",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "SAN": {
                  "backendName": "SAN",
                  "description_en": "The Subject Alternative Name (SAN) of the certificate",
                  "description_zh": "证书主题备用名",
                  "example": "www.example.com,*.example.com",
                  "type": "string"
                },
                "SerialNumber": {
                  "backendName": "SerialNumber",
                  "description_en": "The certificate serial number",
                  "description_zh": "证书序列号",
                  "example": "babab022c5e9b27bf9c64d7f4b16****",
                  "type": "string"
                },
                "SigAlg": {
                  "backendName": "SigAlg",
                  "description_en": "The signature algorithm of the certificate",
                  "description_zh": "证书签名算法",
                  "example": "SHA256-RSA",
                  "type": "string"
                },
                "Status": {
                  "backendName": "Status",
                  "description_en": "The certificate status. Valid values:\nOK: Normal.\nExpired: The certificate has expired.\nExpiring: The certificate is about to expire (within 30 days).\nIssued: Free certificate - issued.\nApplying: Free certificate - applying.\nApplyFailed: Free certificate - application failed.\nCanceled: Free certificate - canceled",
                  "description_zh": "证书状态。\nOK：正常。\nExpired：证书已过期。\nExpiring：证书即将过期（30天内）。\nIssued：免费证书-已签发。\nApplying：免费证书-申请中。\nApplyFailed：免费证书-申请失败。\nCanceled：免费证书-已取消",
                  "example": "OK",
                  "type": "string"
                },
                "Type": {
                  "backendName": "Type",
                  "description_en": "The certificate type. Valid values:\ncas: SSL Certificates Service certificate.\nupload: Custom uploaded certificate.\nfree: Free certificate.\nkeyless: Keyless certificate",
                  "description_zh": "证书类型。\ncas：云盾证书。\nupload：自定义上传证书。\nfree：免费证书。\nkeyless：Keyless证书",
                  "example": "free",
                  "type": "string"
                },
                "UpdateTime": {
                  "backendName": "UpdateTime",
                  "description_en": "The update time. Format: YYYY-MM-DD HH:MM:SS, in UTC/GMT time zone",
                  "description_zh": "更新时间。格式为：YYYY-MM-DD HH:MM:SS，UTC/GMT时区",
                  "example": "2023-04-20 06:18:42",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "SiteId": {
            "backendName": "data.content.SiteId",
            "description_en": "The site ID",
            "description_zh": "站点ID",
            "example": "1234567890123",
            "format": "int64",
            "type": "integer"
          },
          "SiteName": {
            "backendName": "data.content.SiteName",
            "description_en": "The site name",
            "description_zh": "站点名称",
            "example": "example.com ",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.content.TotalCount",
            "description_en": "The total number of records",
            "description_zh": "总个数",
            "example": "10",
            "format": "int64",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
