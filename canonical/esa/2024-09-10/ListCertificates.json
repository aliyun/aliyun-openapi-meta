                        "description_zh": "DCV类型。可能值：DNS；HTTP",
                        "example": "HTTP",
                        "type": "string"
                      },
                      "Value": {
                        "backendName": "Value",
                        "description_en": "The DCV content",
                        "description_zh": "DCV内容",
                        "example": "pH20CqwS5L3ZnvkhI436DCzadKFuG7QcUcvB_4KsAow.KfzYo4LH3EgOt7a73G-RqZkbR0eYtLfEUmtmqGmr4FQ",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
