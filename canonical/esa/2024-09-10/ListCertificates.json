                        "description_zh": "DCV名称。DNS类型为TXT记录名；HTTP类型为URL",
                        "example": "http://www.example.com/.well-known/acme-challenge/pH20CqwS5L3ZnvkhI436DCzadKFuG7QcUcvB_4KsAow",
                        "type": "string"
                      },
                      "Status": {
                        "backendName": "Status",
                        "description_en": "The validation status",
                        "description_zh": "验证状态",
                        "example": "pending",
                        "type": "string"
                      },
                      "Type": {
