  "kebab_example": "aliyun esa get-site-delivery-task --task-name cdn-test-task --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetSiteDeliveryTask",
  "operation": {
    "action": "GetSiteDeliveryTask",
    "api_style": "RPC",
    "api_version": "2024-09-10",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cdn-test-task",
      "help_en": "The task name",
      "help_zh": "任务名称",
