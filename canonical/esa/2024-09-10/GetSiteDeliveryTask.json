      "help_zh": "站点ID，可通过调用https://help.aliyun.com/document_detail/2850189.html接口获取",
      "location": "query",
      "name": "site_id",
      "options": [
        "--site-id"
      ],
      "raw_name": "SiteId",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "ESA",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回体参数",
        "properties": {
          "BusinessType": {
            "backendName": "data.content.BusinessType",
            "description_en": "The real-time log type. Valid values:\n\ndcdn_log_access_l1 (default): access log.\ndcdn_log_er: Edge Routine function log.\ndcdn_log_waf: security protection log.\ndcdn_log_ipa: Layer 4 acceleration log",
            "description_zh": "实时日志类型，取值：\n\ndcdn_log_access_l1（默认值）：访问日志。\ndcdn_log_er：边缘函数日志。\ndcdn_log_waf：安全防护日志。\ndcdn_log_ipa：四层加速日志",
            "example": "dcdn_log_access_l1",
            "type": "string"
          },
          "DataCenter": {
            "backendName": "data.content.DataCenter",
            "description_en": "The data center. Valid values:\n\ncn: the Chinese mainland.\nsg: global (excluding the Chinese mainland)",
            "description_zh": "数据中心。取值为：枚举值：\n\ncn ：中国内地。\nsg： 全球（不包含中国内地）",
            "example": "cn",
            "type": "string"
          },
          "DeliveryType": {
            "backendName": "data.content.SinkType",
            "description_en": "The delivery type. Valid values:\n\nsls: Alibaba Cloud Simple Log Service.\nhttp: HTTP service.\naws3: Amazon S3 service.\noss: Alibaba Cloud Object Storage Service.\nkafka: Kafka service.\naws3cmpt: Amazon S3-compatible service",
            "description_zh": "投递类型：\n\nsls： 阿里云日志服务。\nhttp：http服务。\naws3： 亚马逊s3服务。\noss： 阿里云对象存储服务。\nkafka： kafka服务。\naws3cmpt： 亚马逊s3兼容服务",
            "example": "sls",
            "type": "string"
          },
          "DiscardRate": {
            "backendName": "data.content.DiscardRate",
            "description_en": "The discard rate",
            "description_zh": "丢弃率",
            "example": "0.0",
            "format": "float",
            "type": "number"
          },
          "FieldList": {
            "backendName": "data.content.FieldList",
            "description_en": "The list of delivery fields",
            "description_zh": "投递字段列表",
            "example": "Client,UserAgent",
            "type": "string"
          },
          "FilterRules": {
            "backendName": "data.content.FilterRules",
            "description_en": "The filter rules",
            "description_zh": "过滤规则",
            "example": "[]",
            "type": "string"
          },
          "FilterVer": {
            "backendName": "data.content.RuleVer",
            "description_en": "The version of the filter rules.\n\nFor backward compatibility with legacy filter rules, the default value is v1. Newly created tasks use v2",
            "description_zh": "Filter 过滤规则版本\n\n兼容旧版本过滤规则，默认是v1，新创建是v2",
            "example": "v2",
            "type": "string"
          },
          "RawRule": {
            "backendName": "data.content.RawRule",
            "description_en": "The filter rules for the delivery task.\n\nThe new version of delivery filter rules",
            "description_zh": "投递任务过滤规则\n\n新版投递过滤规则",
            "example": "{\n  \"where\": {\n    \"or\": [\n      {\n        \"and\": [\n          { \"key\": \"site\", \"operator\": \"eq\", \"value\": \"example.com\" },\n          { \"key\": \"status_code\", \"operator\": \"in\", \"value\": [\"200\", \"304\"] }\n        ]\n      }\n    ]\n  }\n}",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "34DCBC8A-****-****-****-6DAA11D7DDBD",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "SinkConfig": {
            "backendName": "data.content.SinkConfig",
            "description_en": "The delivery configuration",
            "description_zh": "投递配置",
            "example": "{'Region': 'cn-hangzhou', 'Endpoint': 'https://***.oss-cn-hangzhou.aliyuncs.com', 'BucketPath': 'hjy-test002/online-logs'}",
            "type": "any"
          },
          "SiteId": {
            "backendName": "data.content.SiteId",
            "description_en": "The site ID",
            "description_zh": "站点ID",
            "example": "123456****",
            "format": "int64",
            "type": "integer"
          },
          "SiteName": {
            "backendName": "data.content.SiteName",
            "description_en": "The site name",
            "description_zh": "站点名称",
            "example": "test.***.com",
            "type": "string"
          },
          "Status": {
            "backendName": "data.content.Status",
            "description_en": "The task status. Valid values:\n\nonline: pushing.\n\noffline: push paused",
            "description_zh": "任务状态\n\nonline：推送中。\n\noffline：暂停推送",
            "example": "online",
            "type": "string"
          },
          "TaskName": {
            "backendName": "data.content.ProjectName",
            "description_en": "The task name",
            "description_zh": "任务名称",
            "example": "cdn-test-task",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
