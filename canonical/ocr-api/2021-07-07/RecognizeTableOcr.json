      "required": false,
      "type": "bool"
    },
    {
      "example": "false",
      "help_en": "Indicates whether detection is skipped. The default value is false.  \ntrue: Skips detection.  \nfalse: Does not skip detection.  ",
      "help_zh": "是否跳过检测，默认为false。\ntrue：跳过检查；false：不跳过检查",
      "location": "query",
      "name": "skip_detection",
      "options": [
        "--skip-detection"
      ],
      "raw_name": "SkipDetection",
      "required": false,
      "type": "bool"
    },
    {
      "enum": [
        "true",
        "false"
      ],
      "example": "false",
      "help_en": "Indicates whether the table contains handwriting. The default value is false.  \ntrue: The table contains handwriting.  \nfalse: The table does not contain handwriting.  \nNote: This field is of the string type.  ",
      "help_zh": "是否是手写表格，默认不是。\ntrue：是手写表格；false：不是手写表格。\n注意：该字段是字符串类型",
      "location": "query",
