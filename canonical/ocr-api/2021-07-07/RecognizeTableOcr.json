  "parameters": [
    {
      "example": "https://example.png",
      "help_en": "You must specify either this field or the body field. You cannot specify both fields or leave both fields empty.  \nImage URL (up to 2048 characters in length; Base64 encoding is not supported).  ",
      "help_zh": "本字段和body字段二选一，不可同时透传或同时为空。\n图片链接（长度不超2048字节，不支持base64）",
      "location": "query",
      "max_length": "2048",
      "name": "url",
      "options": [
        "--url"
      ],
      "raw_name": "Url",
      "required": false,
      "type": "string"
    },
    {
      "direct_body": true,
      "example": "图片二进制文件",
      "format": "binary",
      "help_en": "You must specify either this field or the URL field. You cannot specify both fields or leave both fields empty.  \nBinary file of the image, up to 10 MB in size.  \nWhen using HTTP to invoke the API, upload the binary file of the image in the HTTP body.  \nWhen using the software development kit (SDK) to invoke the API, place the image in the SDK body.  ",
      "help_zh": "本字段和URL字段二选一，不可同时透传或同时为空。\n图片二进制文件，最大10MB。\n使用HTTP方式调用，把图片二进制文件放到HTTP body中上传即可。\n使用SDK的方式调用，把图片放到SDK的body中即可",
      "location": "body",
      "name": "body",
      "options": [
        "--biz-body"
      ],
      "raw_name": "body",
      "required": false,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Indicates whether automatic rotation is required. The default value is true.  \ntrue: Automatic rotation is required.  \nfalse: Automatic rotation is not required.  ",
      "help_zh": "是否需要自动旋转功能，默认需要。\ntrue：需要；false：不需要",
      "location": "query",
      "name": "need_rotate",
      "options": [
        "--need-rotate"
      ],
      "raw_name": "NeedRotate",
      "required": false,
      "type": "bool"
    },
    {
      "example": "false",
      "help_en": "Indicates whether the table has no lines or only horizontal lines without VERTICAL LINEs. The default value is false, which means the table has lines.  \ntrue: The table has no lines.  \nfalse: The table has lines.  ",
      "help_zh": "是否无线条或者只有横线没有竖线,默认有线条。\ntrue：无线条；false：有线条",
      "location": "query",
      "name": "line_less",
      "options": [
        "--line-less"
