  "cmd_full_name": "ocr-api recognize-table-ocr",
  "cmd_name": "recognize-table-ocr",
  "deprecated": false,
  "description_en": "Supports effective detection of wired tables, striped tables, and wireless tables.  ",
  "description_zh": "支持对有线表格、条纹表格、无线表格进行有效识别",
  "kebab_example": "aliyun ocr-api recognize-table-ocr --url https://example.png --biz-body '图片二进制文件' --need-rotate true --line-less false --skip-detection false --is-hand-writing false --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "RecognizeTableOcr",
  "operation": {
    "action": "RecognizeTableOcr",
    "api_style": "RPC",
