                    "example": "public",
                    "type": "string"
                  },
                  "region": {
                    "description_en": "The region where the VPC network resides",
                    "description_zh": "VPC 网络所在地域",
                    "example": "cn-hangzhou",
                    "type": "string"
                  },
                  "securityGroupId": {
                    "description_en": "The security group ID",
                    "description_zh": "安全组 ID",
                    "example": "sg-xxx",
                    "type": "string"
                  },
                  "vpcId": {
                    "description_en": "The virtual private cloud (VPC) ID",
                    "description_zh": "专有网络 VPC ID",
                    "example": "vpc-xxx",
                    "type": "string"
