                    "format": "int64",
                    "type": "integer"
                  },
                  "gatewayId": {
                    "description_en": "The gateway ID",
                    "description_zh": "网关 ID",
                    "example": "gw-xxx",
                    "type": "string"
                  },
                  "mcpServerId": {
                    "description_en": "The MCP Server instance ID",
                    "description_zh": "MCP Server 实例 ID",
                    "example": "mcp-xxx",
                    "type": "string"
