{
  "camel_example": "",
  "cmd_full_name": "starops get-mcp-service",
  "cmd_name": "get-mcp-service",
  "deprecated": false,
  "description_en": "Queries an MCP service",
  "description_zh": "查询 MCP 服务",
  "kebab_example": "aliyun starops get-mcp-service --name test-agent --mcp-service-name log-query --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetMcpService",
  "operation": {
    "action": "GetMcpService",
    "api_style": "ROA",
    "api_version": "2026-04-28",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/digitalEmployee/{name}/mcpService/{mcpServiceName}"
  },
  "parameters": [
    {
      "example": "test-agent",
      "help_en": "The name of the digital employee",
      "help_zh": "数字员工名称",
      "location": "path",
      "min_length": "1",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "name",
      "required": true,
      "type": "string"
    },
    {
      "example": "log-query",
      "help_en": "The service name of the MCP service",
      "help_zh": "MCP 服务名称",
      "location": "path",
      "min_length": "1",
      "name": "mcp_service_name",
      "options": [
        "--mcp-service-name"
      ],
      "raw_name": "mcpServiceName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/digitalEmployee/[name]/mcpService/[mcpServiceName]",
  "product_code": "STAROps",
  "protocol": "HTTPS",
