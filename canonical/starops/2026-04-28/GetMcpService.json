                        "type": "any"
                      },
                      "description_en": "The annotation information of the MCP tool",
                      "description_zh": "MCP 工具注解信息",
                      "example": "{}",
                      "type": "object"
                    },
                    "confirm": {
                      "description_en": "Indicates whether user confirmation is required before the MCP tool is called",
                      "description_zh": "调用该 MCP 工具前是否需要用户确认",
                      "example": "false",
                      "type": "boolean"
                    },
                    "description": {
                      "description_en": "The description of the MCP tool",
                      "description_zh": "MCP 工具描述信息",
                      "example": "查询指定日志库中的日志。",
                      "type": "string"
                    },
                    "displayName": {
                      "description_en": "The display name of the MCP tool",
                      "description_zh": "MCP 工具显示名称",
                      "example": "日志查询工具",
                      "type": "string"
                    },
                    "enable": {
                      "description_en": "Indicates whether the MCP tool is enabled",
                      "description_zh": "是否启用该 MCP 工具",
                      "example": "true",
                      "type": "boolean"
                    },
                    "execution": {
                      "additionalProperties": {
                        "description_en": "The extension fields of the tool execution configuration",
                        "description_zh": "工具执行配置扩展字段",
                        "example": "{}",
                        "type": "any"
                      },
                      "description_en": "The execution configuration of the MCP tool",
                      "description_zh": "MCP 工具执行配置",
                      "example": "{}",
                      "type": "object"
                    },
                    "icons": {
                      "description_en": "The list of MCP tool icons",
                      "description_zh": "MCP 工具图标列表",
                      "example": "[]",
                      "itemName": "icons",
                      "items": {
                        "additionalProperties": {
                          "description_en": "The extension field of the tool icon",
                          "description_zh": "工具图标扩展字段",
                          "example": "https://example.com/icon.png",
                          "type": "any"
                        },
                        "description_en": "The configuration of a single MCP tool",
                        "description_zh": "单个 MCP 工具配置",
                        "example": "[]",
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "inputSchema": {
                      "additionalProperties": {
                        "description_en": "The extension fields of the MCP tool input schema",
                        "description_zh": "MCP 工具输入 Schema 扩展字段",
                        "example": "{\"type\":\"string\"}",
                        "type": "any"
                      },
                      "description_en": "The JSON Schema of the MCP tool input parameters",
                      "description_zh": "MCP 工具输入参数的 JSON Schema",
                      "example": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\"}},\"required\":[\"query\"]}",
                      "type": "object"
                    },
                    "name": {
                      "description_en": "The name of the MCP tool",
                      "description_zh": "MCP 工具名称",
                      "example": "query_logs",
                      "type": "string"
                    },
                    "outputSchema": {
                      "additionalProperties": {
                        "description_en": "The extension fields of the MCP tool output schema",
                        "description_zh": "MCP 工具输出 Schema 扩展字段",
                        "example": "{\"type\":\"string\"}",
                        "type": "any"
                      },
                      "description_en": "The JSON Schema of the MCP tool output",
                      "description_zh": "MCP 工具输出结果的 JSON Schema",
                      "example": "{\"type\":\"object\"}",
                      "type": "object"
                    },
                    "title": {
                      "description_en": "The title of the MCP tool",
                      "description_zh": "MCP 工具标题",
                      "example": "查询日志",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "regionId": {
            "description_en": "The region of the current request",
            "description_zh": "当前请求地域",
            "example": "cn-hangzhou",
            "type": "string"
          },
          "requestId": {
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "0B9377D9-C56B-5C2E-A8A4-************",
