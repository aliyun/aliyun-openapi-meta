                          "type": "string"
                        },
                        "description_en": "The key-value information required for authentication",
                        "description_zh": "认证所需的键值信息",
                        "example": "{\"token\":\"example-token\"}",
                        "type": "object"
                      },
                      "type": {
                        "description_en": "The authentication type. Currently, bearer is supported",
                        "description_zh": "认证类型，目前支持 bearer",
                        "enum": [
                          "bearer"
                        ],
                        "example": "bearer",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "endpoint": {
                    "description_en": "The access endpoint of the MCP service",
                    "description_zh": "MCP 服务访问地址",
                    "example": "https://example.com/mcp",
                    "type": "string"
                  },
                  "headers": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "platform": {
                    "description_en": "The MCP service platform type. Valid values: AIGateway and Custom",
                    "description_zh": "MCP 服务平台类型，支持 AIGateway 和 Custom",
                    "enum": [
                      "AIGateway",
                      "Custom"
                    ],
                    "example": "Custom",
                    "type": "string"
                  },
                  "timeout": {
                    "description_en": "The timeout period for requests to the MCP service. Unit: milliseconds",
                    "description_zh": "请求 MCP 服务的超时时间，单位为毫秒",
                    "example": "5000",
                    "format": "int64",
                    "type": "integer"
                  },
                  "transport": {
                    "description_en": "The MCP service transport protocol. Valid values: http and sse",
                    "description_zh": "MCP 服务传输协议，支持 http 和 sse",
                    "enum": [
                      "http",
                      "sse"
                    ],
                    "example": "http",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "description": {
                "description_en": "The description of the MCP service",
                "description_zh": "MCP 服务描述信息",
