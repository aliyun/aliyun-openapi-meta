{
  "camel_example": "",
  "cmd_full_name": "cc5g get-card",
  "cmd_name": "get-card",
  "deprecated": false,
  "description_en": "Obtain information about a single SIM card",
  "description_zh": "获取单卡信息",
  "kebab_example": "aliyun cc5g get-card --iccid 11111111111 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetCard",
  "operation": {
    "action": "GetCard",
    "api_style": "RPC",
    "api_version": "2022-03-14",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "11111111111",
      "help_en": "ICCID of the IoT SIM card",
      "help_zh": "物联网卡的iccid",
      "location": "query",
      "name": "iccid",
      "options": [
        "--iccid"
      ],
      "raw_name": "Iccid",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CC5G",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "APN": {
            "backendName": "data.apn",
            "description_en": "ID of the carrier's APN",
            "description_zh": "运营商APN的id",
            "example": "zjalyjs01s.5gjs.njiot",
            "type": "string"
          },
          "ActivatedTime": {
            "backendName": "data.activatedTime",
            "description_en": "Activation time",
            "description_zh": "激活时间",
            "example": "2022-08-25 17:34:57",
            "type": "string"
          },
          "AlarmThreshold": {
            "backendName": "data.alarmThreshold",
            "description_en": "Alert threshold, in MB",
            "description_zh": "告警阈值，单位MB",
            "example": "1000",
            "format": "int64",
            "type": "integer"
          },
          "CloudConnectorId": {
            "backendName": "data.cciotId",
            "description_en": "Cloud connector ID",
            "description_zh": "云连接id",
            "example": "iotcc-xxxxxxxx",
            "type": "string"
          },
          "Description": {
            "backendName": "data.description",
            "description_en": "Description",
            "description_zh": "描述",
            "example": "task-test",
            "type": "string"
          },
          "ISP": {
            "backendName": "data.isp",
            "description_en": "Carrier of the 5G high-speed cloud instance. Valid values:\ntelecom: China Telecom\nmobile: China Mobile\nunicom: China Unicom",
            "description_zh": "5G高速上云实例的运营商。取值：\ntelecom：中国电信。\nmobile：中国移动。\nunicom：中国联通",
            "example": "Unicom",
            "type": "string"
          },
          "Iccid": {
            "backendName": "data.iccid",
            "description_en": "ICCID of the IoT SIM card",
            "description_zh": "物联网卡的iccid",
            "example": "111111111",
            "type": "string"
          },
          "Imei": {
            "backendName": "data.imei",
            "description_en": "International Mobile Equipment Identity (IMEI) of the device",
            "description_zh": "设备IMEI",
            "example": "23412313513512",
            "type": "string"
          },
          "Imsi": {
            "backendName": "data.imsi",
            "description_en": "International Mobile Subscriber Identity (IMSI) of the IoT SIM card",
            "description_zh": "物联网卡的IMSI",
            "example": "12123123",
            "type": "string"
          },
          "IpAddress": {
            "backendName": "data.ipAddress",
            "description_en": "Static IP address of the IoT SIM card",
            "description_zh": "物联网卡的固定IP地址",
            "example": "172.24.2.121",
            "type": "string"
          },
          "LimitThreshold": {
            "backendName": "data.limitThreshold",
            "description_en": "Data usage threshold for throttling, in MB",
            "description_zh": "达量限速阈值，单位MB",
            "example": "50",
            "format": "int64",
            "type": "integer"
          },
          "Lock": {
            "backendName": "data.lock",
            "description_en": "Indicates whether the SIM card is locked",
            "description_zh": "卡是否锁定",
            "example": "true",
            "type": "string"
          },
          "Msisdn": {
            "backendName": "data.msisdn",
            "description_en": "MSISDN of the IoT SIM card",
            "description_zh": "物联网卡的MSISDN",
            "example": "2312341231235",
            "type": "string"
          },
          "Name": {
            "backendName": "data.name",
            "description_en": "Name",
            "description_zh": "名称",
            "example": "test",
            "type": "string"
          },
          "NetType": {
            "backendName": "data.netType",
            "description_en": "Network type. Valid values:\n\n4G\n5G",
            "description_zh": "网络类型，取值：\n\n4G\n5G",
            "example": "5G",
            "type": "string"
          },
          "OrderId": {
            "backendName": "data.orderId",
            "description_en": "Order ID",
            "description_zh": "订单id",
            "example": "12312341234124",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Request ID",
            "description_zh": "请求iD",
            "example": "0B28B72A-BD16-51F7-AAEE-55247FE02729",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "SimStatus": {
            "backendName": "data.simStatus",
            "description_en": "SIM card status. Valid values:\n\nTestable: Testing\nActivatable: Activatable\nActivated: Activated\nDeactivated: Deactivated\nFailed: Out Of Effect\nCleared: Purged\nReplaced: Replaced\nResuming: Recovering\nShutDown: Shut down",
            "description_zh": "卡的状态，取值：\n\nTestable: 可测试\nActivatable: 可激活\nActivated: 已激活\nDeactivated: 已停用\nFailed: 已失效\nCleared: 已清除\nReplaced: 已更换\nResuming: 恢复中\nShutDown: 已停机",
            "example": "Deactivated",
            "type": "string"
          },
          "Spec": {
            "backendName": "data.spec",
            "description_en": "Specification",
            "description_zh": "规格",
            "example": "CONSUMER_THREE_IN_ONE",
            "type": "string"
          },
          "Status": {
            "backendName": "data.status",
            "description_en": "Instance status. Valid values:\n\nCreating: Creation in progress\nAvailable: Valid and stable state\nUnAvailable: Invalid state\nPending: Configuration in progress\nDeleting: Deletion in progress",
            "description_zh": "实例状态，取值：\n\nCreating: 创建中\nAvailable: 有效的稳定状态\nUnAvailable: 无效状态\nPending: 配置中\nDeleting: 删除中",
            "example": "Available",
            "type": "string"
          },
          "StopThreshold": {
            "backendName": "data.stopThreshold",
            "description_en": "Data usage threshold for suspending the service, in MB",
            "description_zh": "达量停机阈值，单位MB",
            "example": "4096",
            "format": "int64",
            "type": "integer"
          },
          "UsageDataMonth": {
            "backendName": "data.usageDataMonth",
            "description_en": "Traffic used this month, in MB.  \nDue to certain external factors, synchronization delays may occur for this field. We recommend that you use ListCardUsages (https://help.aliyun.com/document_detail/472077.html?spm=a2c4g.438976.0.0.8bbc1711r5XXDT) to query traffic information for a single SIM card",
            "description_zh": "本月已用流量，单位MB。\n本字段信息存在一些外部条件等影响，会出现信息同步滞后，建议使用ListCardUsages (https://help.aliyun.com/document_detail/472077.html?spm=a2c4g.438976.0.0.8bbc1711r5XXDT)查询单卡流量信息",
            "example": "50",
            "format": "int32",
            "type": "integer"
          },
          "UsageDataTotal": {
            "backendName": "data.usageDataTotal",
            "description_en": "Total usage of the SIM card, in MB",
            "description_zh": "单卡总使用量，单位MB",
            "example": "1000",
            "format": "int64",
            "type": "integer"
          },
          "WirelessCloudConnectorId": {
            "backendName": "data.cc5gId",
            "description_en": "ID of the 5G high-speed cloud instance",
            "description_zh": "5G高速上云实例id",
            "example": "cc5g-xxxxxxx",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
