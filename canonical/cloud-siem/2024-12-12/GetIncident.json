{
  "cmd_full_name": "cloud-siem get-incident",
  "cmd_name": "get-incident",
  "deprecated": false,
  "description_en": "Retrieves the details of an event",
  "description_zh": "获取事件详情",
  "kebab_example": "aliyun cloud-siem get-incident --biz-region-id cn-hangzhou --lang zh --incident-uuid 85ea4241-798f-4684-a876-65d4f0c30000 --role-for 1130916744880000 --api-version 2024-12-12 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetIncident",
  "operation": {
    "action": "GetIncident",
    "api_style": "RPC",
    "api_version": "2024-12-12",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The region where the data management center of the threat analysis feature is located. Specify this parameter based on the region where your assets reside. Valid values:\ncn-hangzhou: Your assets reside in the Chinese mainland.\nap-southeast-1: Your assets reside outside China",
      "help_zh": "威胁分析的数据管理中心所在地。您需要根据资产所在地域，选择管理中心所在地。取值：\ncn-hangzhou：资产属于中国内地。\nap-southeast-1：资产属于海外地域",
      "location": "formData",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "zh",
      "help_en": "The language of the response. Valid values:\nzh (default): Chinese.\nen: English",
      "help_zh": "返回消息的语言类型。取值：\nzh（默认）：中文。\nen：英文",
      "location": "formData",
      "name": "lang",
      "options": [
        "--lang"
      ],
      "raw_name": "Lang",
      "required": false,
      "type": "string"
    },
    {
      "example": "85ea4241-798f-4684-a876-65d4f0c3****",
      "help_en": "The UUID of the event",
      "help_zh": "事件UUID",
      "location": "formData",
      "name": "incident_uuid",
      "options": [
        "--incident-uuid"
      ],
      "raw_name": "IncidentUuid",
      "required": false,
      "type": "string"
    },
    {
      "example": "113091674488****",
      "help_en": "The ID of the member to which the administrator switches the view",
      "help_zh": "管理员切换成其他成员视角的用户ID",
      "location": "formData",
      "name": "role_for",
      "options": [
        "--role-for"
      ],
      "raw_name": "RoleFor",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "cloud-siem",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response struct",
        "description_zh": "返回体",
        "properties": {
          "Incident": {
            "description_en": "The event information",
            "description_zh": "事件信息",
            "properties": {
              "AttckTactics": {
                "description_en": "The count of attack stages associated with the event alerts",
                "description_zh": "事件关联告警攻击阶段计数",
                "example": "{\n\t\"AttckTactics\": [\n\t\t{\n\t\t\t\"tacticName\": \"Reconnaissance\",\n\t\t\t\"alertNum\": 0,\n\t\t\t\"tacticId\": \"TA0040\"\n\t\t}\n\t]\n}",
                "type": "any"
              },
              "CreateTime": {
                "description_en": "The creation time",
                "description_zh": "创建时间",
                "example": "1757386075000",
                "format": "int64",
                "type": "integer"
              },
              "DetectionRuleId": {
                "description_en": "The ID of the detection rule",
                "description_zh": "检测规则ID",
                "example": "dr-fy2zvgiykjifbiim****",
                "type": "string"
              },
              "IncidentAggregationType": {
                "description_en": "The event summaries type. Valid values:\n\nnone: no event is generated.\ngraph_compute: graph computing (supported by predefined rules).\nexpert: expert rule.\npassthrough: alerting pass-through (one-to-one).\nwindow: same-type aggregation (window)",
                "description_zh": "事件聚合类型。取值：\n\nnone：不生成事件\ngraph_compute：图计算（预定义规则支持）\nexpert：专家规则\npassthrough：告警透出（1对1）\nwindow：同类聚合（窗口）",
                "example": "window",
                "type": "string"
              },
              "IncidentDescription": {
                "description_en": "The description of the event",
                "description_zh": "事件描述",
                "example": "Forti incident desc",
                "type": "string"
              },
              "IncidentName": {
                "description_en": "The name of the event",
                "description_zh": "事件名称",
                "example": "Forti",
                "type": "string"
              },
              "IncidentRemark": {
                "description_en": "The remarks of the event",
                "description_zh": "事件备注",
                "example": "Remark",
                "type": "string"
              },
              "IncidentStatus": {
                "description_en": "The status of the event. Valid values:\n0: unhandled.\n1: handling.\n5: handling failed.\n10: handled",
                "description_zh": "事件状态。取值：\n0：未处理。\n1：处理中。\n5：处理失败。\n10：已处理",
                "example": "0",
                "format": "int32",
                "type": "integer"
              },
              "IncidentTags": {
                "description_en": "The tags of the event",
                "description_zh": "事件标签",
                "example": "[\"sys:data_source:waf\"]",
                "type": "string"
              },
              "IncidentUuid": {
                "description_en": "The UUID of the event",
                "description_zh": "事件UUID",
                "example": "85ea4241-798f-4684-a876-65d4f0c3****",
                "type": "string"
              },
              "Owner": {
                "description_en": "The owner of the event",
                "description_zh": "事件责任人",
                "example": "1234567890xxxxxx",
                "title_en": "",
                "title_zh": "事件责任人",
                "type": "string"
              },
              "RelateAlertCount": {
                "description_en": "The number of alerts associated with the event",
                "description_zh": "事件关联告警数",
                "example": "23",
                "format": "int32",
                "type": "integer"
              },
              "RelateAssetCount": {
                "description_en": "The number of assets associated with the event",
                "description_zh": "事件关联资产数",
                "example": "2",
                "format": "int32",
                "type": "integer"
              },
              "RelateDataSourceIds": {
                "description_en": "The list of associated data sources",
                "description_zh": "关联的数据源列表",
                "example": "[\"siem\"]",
                "type": "any"
              },
              "RelateUserIds": {
                "description_en": "The list of user IDs associated with the event",
                "description_zh": "事件关联用户ID列表",
                "example": "[\"176618589410****\",\"1130916744888****\"]",
                "type": "any"
              },
              "ResponseTime": {
                "description_en": "The response time. Unit: milliseconds (ms)",
                "description_zh": "响应时间，单位为毫秒（ms）",
                "example": "1757386075000",
                "format": "int64",
                "type": "integer"
              },
              "ThreatLevel": {
                "description_en": "The threat level. Valid values:\n5: critical.\n4: high.\n3: medium.\n2: low.\n1: informational",
                "description_zh": "威胁等级。取值：\n5：严重。\n4：高危。\n3：中危。\n2：低危。\n1：信息",
                "example": "2",
                "type": "string"
              },
              "ThreatScore": {
                "description_en": "The threat score of the event. Valid values: 0 to 100. A higher score indicates a higher risk level",
                "description_zh": "事件的威胁分值, 范围 0~100, 分值越高风险等级越高",
                "example": "90",
                "type": "string"
              },
              "UpdateTime": {
                "description_en": "The update time",
                "description_zh": "更新时间",
                "example": "1757386075000",
                "format": "int64",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求消息ID",
            "example": "9AAA9ED9-78F4-5021-86DC-D51C7511****",
            "type": "string"
          }
        },
        "title_en": "",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
