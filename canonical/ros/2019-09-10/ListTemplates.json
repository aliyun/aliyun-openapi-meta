{
  "camel_example": "aliyun ros ListTemplates --region cn-hangzhou --IncludeTags Enabled --Tag.1.Key usage --Filters.1.Name Categories --PageSize 10 --ResourceGroupId 'rg-acfmxazb4ph6aiy0000' --PageNumber 1 --Tag.1.Value deploy --Filters.1.Values.1 ROS --TemplateName MyTemplate --ShareType Private",
