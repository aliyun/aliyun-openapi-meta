            "type": "string"
          },
          "codeStatus": {
            "backendName": "codeStatus",
            "description_en": "The status of the voucher electronic credential.\nValid values:\n1: valid\n-1: redeemed\n-2: expired\n100: locked",
            "description_zh": "卡券电子凭证状态\n枚举值：\n1(有效)\n-1(已核销)\n-2(已失效)\n100(锁定)",
            "example": "\n-1",
            "format": "int64",
            "type": "integer"
          },
          "endTime": {
            "backendName": "endTime",
            "description_en": "The end time of the validity period for the voucher electronic credential",
            "description_zh": "卡券电子凭证有效期结束时间",
            "example": "2026-08-02T23:59:59.000+08:00",
            "type": "string"
