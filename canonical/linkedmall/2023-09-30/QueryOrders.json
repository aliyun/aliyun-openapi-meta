            "example": "0",
            "format": "int64",
            "type": "integer"
          },
          "qrcodeUrl": {
            "backendName": "qrcodeUrl",
            "description_en": "The URL of the QR code image for the voucher electronic credential",
            "description_zh": "卡券电子凭证二维码图片链接",
            "example": "http://qrcode.alicdn.com/img.jpg",
            "type": "string"
          },
          "startTime": {
            "backendName": "startTime",
