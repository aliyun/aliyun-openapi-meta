{
  "cmd_full_name": "linkedmall query-address-list",
  "cmd_name": "query-address-list",
  "deprecated": false,
  "description_en": "Queries the addresses of end users to support viewing delivery addresses when placing orders",
  "description_zh": "查询C端用户地址，满足用户下单时候收货地址查看的需要",
  "kebab_example": "aliyun linkedmall query-address-list --biz-id LMALL2000100001 --api-version 2018-01-16 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "QueryAddressList",
  "operation": {
    "action": "QueryAddressList",
    "api_style": "RPC",
    "api_version": "2018-01-16",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "LMALL2***100001",
      "help_en": "The unique identifier of the business. This value is provided by Alibaba Cloud",
      "help_zh": "业务的唯一标识号，由阿里云提供",
      "location": "query",
      "name": "biz_id",
      "options": [
        "--biz-id"
      ],
      "raw_name": "BizId",
      "required": true,
      "type": "string"
    },
    {
      "example": "12312",
      "help_en": "The user ID on the customer side",
      "help_zh": "客户侧用户ID",
      "location": "query",
      "name": "third_party_user_id",
      "options": [
        "--third-party-user-id"
      ],
      "raw_name": "ThirdPartyUserId",
      "required": false,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Deprecated",
      "help_zh": "废弃",
      "location": "query",
      "name": "use_anonymous_tb_account",
      "options": [
        "--use-anonymous-tb-account"
      ],
      "raw_name": "UseAnonymousTbAccount",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "linkedmall",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "AddressList": {
            "backendName": "model",
            "description_en": "The address list",
            "description_zh": "地址列表",
            "itemName": "Address",
            "items": {
              "properties": {
                "AddressDetail": {
                  "backendName": "addressDetail",
                  "description_en": "The detailed delivery address. Only the street information is required",
                  "description_zh": "详细收货地址。（只需要街道）",
                  "example": "*********************",
                  "type": "string",
                  "visibility": "Public"
                },
                "AddressId": {
                  "backendName": "addressId",
                  "description_en": "The address ID",
                  "description_zh": "地址id",
                  "example": "314304607",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "Area": {
                  "backendName": "area",
                  "description_en": "The area",
                  "description_zh": "区域",
                  "example": "xianggang",
                  "type": "string",
                  "visibility": "Public"
                },
                "City": {
                  "backendName": "city",
                  "description_en": "The city",
                  "description_zh": "市",
                  "example": "北京市",
                  "type": "string",
                  "visibility": "Public"
                },
                "Country": {
                  "backendName": "country",
                  "description_en": "The country",
                  "description_zh": "国家",
                  "example": "CN",
                  "type": "string",
                  "visibility": "Public"
                },
                "DivisionCode": {
                  "backendName": "divisionCode",
                  "description_en": "The level-4 delivery area code used to query inventory in the area. This field is obtained through the queryAddress operation",
                  "description_zh": "四级配送区域编码，查询该区域库存。该字段通过queryAddress接⼝获取",
                  "example": "230921",
                  "type": "string",
                  "visibility": "Public"
                },
                "FullName": {
                  "backendName": "fullName",
                  "description_en": "The full name of the recipient",
                  "description_zh": "收货人全名",
                  "example": "海***",
                  "type": "string",
                  "visibility": "Public"
                },
                "Mobile": {
                  "backendName": "mobile",
                  "description_en": "The mobile phone number",
                  "description_zh": "手机号",
                  "example": "18611921898",
                  "type": "string",
                  "visibility": "Public"
                },
                "PostCode": {
                  "backendName": "postCode",
                  "description_en": "The postal code. If this parameter is not specified, 000000 is used",
                  "description_zh": "邮政编码。如果不传我们会写入 000000",
                  "example": "323050",
                  "type": "string",
                  "visibility": "Public"
                },
                "Province": {
                  "backendName": "province",
                  "description_en": "The province",
                  "description_zh": "省份",
                  "example": "广东省",
                  "type": "string",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the delivery address. Valid values:\n\n0: non-default delivery address\n1: default delivery address",
                  "description_zh": "收货地址状态  0: 非默认收获地址 1: 默认收获地址",
                  "example": "1",
                  "format": "int32",
                  "type": "integer",
                  "visibility": "Public"
                },
                "Town": {
                  "backendName": "town",
                  "description_en": "The town",
                  "description_zh": "城镇",
                  "example": "洪山区",
                  "type": "string",
                  "visibility": "Public"
                },
                "TownDivisionCode": {
                  "backendName": "townDivisionCode",
                  "description_en": "The level-4 address ID for the town or street",
                  "description_zh": "第4级地址ID 镇、街道",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "Code": {
            "backendName": "code",
            "description_en": "Returns \"SUCCESS\" on success. For error codes, see the following sections",
            "description_zh": "成功时，返回\"SUCCESS\"。错误码见后面小节",
            "example": "SUCCESS",
            "type": "string",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The response message",
            "description_zh": "返回消息",
            "example": "SUCCESS",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique identifier that Alibaba Cloud generates for the request",
            "description_zh": "阿里云为该请求生成的唯一标识符",
            "example": "79C01D47-3C44-57D9-BC99-1B33F7ED14B8",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
