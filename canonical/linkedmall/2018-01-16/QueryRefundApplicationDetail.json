{
  "cmd_full_name": "linkedmall query-refund-application-detail",
  "cmd_name": "query-refund-application-detail",
  "deprecated": false,
  "description_en": "Queries the status and other information of a refund application after the refund is successfully submitted",
  "description_zh": "申请退款成功之后，可通过此接口确定逆向的状态等信息",
  "kebab_example": "aliyun linkedmall query-refund-application-detail --biz-id LMALL20000000002 --biz-uid 1200000089 --sub-lm-order-id 2300000085 --api-version 2018-01-16 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "QueryRefundApplicationDetail",
  "operation": {
    "action": "QueryRefundApplicationDetail",
    "api_style": "RPC",
    "api_version": "2018-01-16",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "LMALL2******0002",
      "help_en": "The unique identifier of the business. This value is provided by Alibaba Cloud",
      "help_zh": "业务的唯一标识号，由阿里云提供",
      "location": "query",
      "name": "biz_id",
      "options": [
        "--biz-id"
      ],
      "raw_name": "BizId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "12******89",
      "help_en": "The value must be the same as that of thirdPartyUserId",
      "help_zh": "和thirdPartyUserId传一样的值",
      "location": "query",
      "name": "biz_uid",
      "options": [
        "--biz-uid"
      ],
      "raw_name": "BizUid",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "23******85",
      "help_en": "The sub-order ID for which the reverse application is initiated",
      "help_zh": "发起逆向申请的订单号",
      "location": "query",
      "name": "sub_lm_order_id",
      "options": [
        "--sub-lm-order-id"
      ],
      "raw_name": "SubLmOrderId",
      "required": true,
      "type": "string"
    },
    {
      "example": "true",
      "help_en": "Deprecated",
      "help_zh": "废弃",
      "location": "query",
      "name": "use_anonymous_tb_account",
      "options": [
        "--use-anonymous-tb-account"
      ],
      "raw_name": "UseAnonymousTbAccount",
      "required": false,
      "type": "bool"
    },
    {
      "help_en": "The user ID on the customer side",
      "help_zh": "客户侧用户ID",
      "location": "query",
      "name": "third_party_user_id",
      "options": [
        "--third-party-user-id"
      ],
      "raw_name": "ThirdPartyUserId",
      "required": false,
      "type": "string"
    },
    {
      "example": "ANONY",
      "help_en": "Fixed value: ANONY",
      "help_zh": "固定值：ANONY",
      "location": "query",
      "name": "account_type",
      "options": [
        "--account-type"
      ],
      "raw_name": "AccountType",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "linkedmall",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "SUCCESS indicates a successful request",
            "description_zh": "SUCCESS表示成功",
            "example": "SUCCESS",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The specific reason returned when the request fails",
            "description_zh": "失败时，返回具体原因",
            "example": "SUCCESS",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "RefundApplicationDetail": {
            "backendName": "model",
            "description_en": "The parameters of the reverse application",
            "description_zh": "初始化逆向申请参数",
            "nullToEmpty": true,
            "properties": {
              "ApplyDisputeDesc": {
                "backendName": "applyDisputeDesc",
                "description_en": "The refund policy provided by the buyer for the refund application",
                "description_zh": "当前买家申请退款说明",
                "example": "多拍不想要",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "ApplyReasonText": {
                "backendName": "applyReasonText",
                "description_en": "The reason provided by the buyer for the reverse application",
                "description_zh": "买家申请逆向的原因",
                "nullToEmpty": true,
                "properties": {
                  "ReasonTextId": {
                    "backendName": "reasonTextId",
                    "description_en": "The reason text for the reverse application submitted by the buyer",
                    "description_zh": "买家申请逆向的原因文案",
                    "example": "100005",
                    "format": "int64",
                    "nullToEmpty": true,
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "ReasonTips": {
                    "backendName": "reasonTips",
                    "description_en": "The reason ID for the reverse application submitted by the buyer",
                    "description_zh": "买家申请逆向的原因ID",
                    "example": "多拍不想要",
                    "nullToEmpty": true,
                    "type": "string",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "BizClaimType": {
                "backendName": "bizClaimType",
                "description_en": "The supported return method for the order. Valid values: 1: refund only. 3: return and refund",
                "description_zh": "⽀持的订单退货⽅式，1， 标识仅退款，3，标识退货退款",
                "example": "1",
                "format": "int32",
                "nullToEmpty": false,
                "type": "integer",
                "visibility": "Public"
              },
              "DisputeCreateTime": {
                "backendName": "disputeCreateTime",
                "description_en": "The time when the reverse process is initiated",
                "description_zh": "逆向发起时间",
                "example": "2022-04-02 10:16:10",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "DisputeDesc": {
                "backendName": "disputeDesc",
                "description_en": "The description of the reverse application",
                "description_zh": "申请逆向描述",
                "example": "尺码不符",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "DisputeEndTime": {
                "backendName": "disputeEndTime",
                "description_en": "The time when the reverse process ends",
                "description_zh": "逆向结束时间",
                "example": "2022-04-02 10:16:12",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "DisputeId": {
                "backendName": "disputeId",
                "description_en": "The dispute ID",
                "description_zh": "纠纷ID",
                "example": "141******33",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "DisputeStatus": {
                "backendName": "disputeStatus",
                "description_en": "The status of the reverse refund",
                "description_zh": "逆向退款的状态",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "DisputeType": {
                "backendName": "disputeType",
                "description_en": "The type of the reverse event",
                "description_zh": "逆向发生的类型",
                "example": "0: \"任意退款类型\"\n1: \"售中退款\"\n2: \"售后退款\"",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "LmOrderId": {
                "backendName": "lmOrderId",
                "description_en": "The primary order ID",
                "description_zh": "主订单号",
                "example": "46******11",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "MaxRefundFeeData": {
                "backendName": "maxRefundFeeData",
                "description_en": "The refundable amount data for this order",
                "description_zh": "本单可退金额数据",
                "nullToEmpty": true,
                "properties": {
                  "MaxRefundFee": {
                    "backendName": "maxRefundFee",
                    "description_en": "The maximum refundable amount for this order",
                    "description_zh": "本单最大可退金额",
                    "example": "10",
                    "format": "int32",
                    "nullToEmpty": true,
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "MinRefundFee": {
                    "backendName": "minRefundFee",
                    "description_en": "The minimum refundable amount for this order",
                    "description_zh": "本单最小可退金额",
                    "example": "0",
                    "format": "int32",
                    "nullToEmpty": true,
                    "type": "integer",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "OrderLogisticsStatus": {
                "backendName": "orderLogisticsStatus",
                "description_en": "The logistics status of the current order. A value of 1 indicates that the goods have not been shipped",
                "description_zh": " 当前的订单的物流状态，1，标识未发货",
                "example": "1",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "RealRefundFee": {
                "backendName": "realRefundFee",
                "description_en": "The actual amount received by the buyer",
                "description_zh": "实际买家收到的⾦额",
                "example": "10",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "RefundFee": {
                "backendName": "refundFee",
                "description_en": "The refund amount, including the platform subsidy amount",
                "description_zh": "退款⾦额(含退平台补贴的⾦额)",
                "example": "10",
                "format": "int64",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "RefunderAddress": {
                "backendName": "refunderAddress",
                "description_en": "The return address of the seller. This field is displayed only after the seller agrees to the return",
                "description_zh": "商家退货地址，卖家同意退货后才会显示",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "RefunderName": {
                "backendName": "refunderName",
                "description_en": "The recipient name for the return. This field is displayed only after the seller agrees to the return",
                "description_zh": "退货收货人，卖家同意退货后才会显示",
                "example": "张三",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "RefunderTel": {
                "backendName": "refunderTel",
                "description_en": "The contact information for the return. This field is displayed only after the seller agrees to the return",
                "description_zh": "退货联系方式，卖家同意退货后才会显示",
                "example": "158****1234",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "RefunderZipCode": {
                "backendName": "refunderZipCode",
                "description_en": "The postal code of the return address. This field is displayed only after the seller agrees to the return",
                "description_zh": "退货地址邮编，卖家同意退货后才会显示",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "ReturnGoodCount": {
                "backendName": "returnGoodCount",
                "description_en": "The quantity of returned goods",
                "description_zh": "退货数量",
                "example": "1",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "ReturnGoodLogisticsStatus": {
                "backendName": "returnGoodLogisticsStatus",
                "description_en": "The logistics status of the returned goods",
                "description_zh": "退货物流状态",
                "example": "0: \"未退货\"\n1: \"等待揽收\"\n2: \"快件已揽收\"\n3: \"物流走件中\"\n4: \"派送中\"\n5: \"已签收\"\n6: \"签收失败\"",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer",
                "visibility": "Public"
              },
              "SellerAgreeMsg": {
                "backendName": "sellerAgreeMsg",
                "description_en": "The message from the seller agreeing to the return. The actual return address is returned in this field",
                "description_zh": "卖家同意退货说明,真实的退货地址会在这个字段进⾏返回",
                "example": "同意退货",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "SellerRefuseAgreementMessage": {
                "backendName": "sellerRefuseAgreementMessage",
                "description_en": "The message from the seller explaining the refusal",
                "description_zh": "卖家拒绝的留⾔说明",
                "example": "多拍不想要",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "SellerRefuseReason": {
                "backendName": "sellerRefuseReason",
                "description_en": "The reason why the seller refuses the request",
                "description_zh": "商家拒绝原因",
                "example": "不满足退款条件",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "SubLmOrderId": {
                "backendName": "subLmOrderId",
                "description_en": "The sub-order ID for which the reverse process is initiated",
                "description_zh": "当前发起逆向的⼦订单号",
                "example": "44******62",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The input parameter value returned directly for log tracing",
            "description_zh": "直接取入参值返回，用于日志追踪",
            "example": "DAAA6391-3339-5333-9E4D-C71CD26A231F",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
