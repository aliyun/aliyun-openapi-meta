  "pathPattern": "",
  "product_code": "linkedmall",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "Returns \"SUCCESS\" on success. For error codes, see the following sections",
            "description_zh": "成功时，返回\"SUCCESS\"。错误码见后面小节",
            "example": "SUCCESS",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "DeliveryAddress": {
            "backendName": "model",
            "description_en": "The address information",
            "description_zh": "地址信息",
            "nullToEmpty": false,
            "properties": {
              "AddressDetail": {
                "backendName": "addressDetail",
                "description_en": "The detailed delivery address. Only the street information is required",
                "description_zh": "详细收货地址。（只需要街道）",
                "example": "********************",
                "type": "string",
                "visibility": "Public"
              },
              "AddressId": {
                "backendName": "addressId",
                "description_en": "The address record ID",
                "description_zh": "地址记录ID",
                "example": "313312207",
