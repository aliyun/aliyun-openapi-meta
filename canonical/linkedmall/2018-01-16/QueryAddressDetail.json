                "description_zh": "所属国家",
                "example": "CN",
                "type": "string",
                "visibility": "Public"
              },
              "DivisionCode": {
                "backendName": "divisionCode",
                "description_en": "The province, city, and district code",
                "description_zh": "省市区代码",
                "example": "321112104",
                "type": "string",
                "visibility": "Public"
              },
              "FullName": {
                "backendName": "fullName",
                "description_en": "The full name of the recipient",
                "description_zh": "收货人全名",
                "example": "金*****股份有限公司",
                "type": "string",
                "visibility": "Public"
              },
              "Mobile": {
                "backendName": "mobile",
                "description_en": "The mobile phone number of the contact",
                "description_zh": "联系方式，手机号",
                "example": "18941288583",
                "type": "string",
                "visibility": "Public"
              },
              "PostCode": {
                "backendName": "postCode",
                "description_en": "The postal code. If not specified, the value 000000 is used",
                "description_zh": "邮政编码。如果不传我们会写入 000000",
                "example": "518055",
                "type": "string",
                "visibility": "Public"
              },
              "Province": {
                "backendName": "province",
                "description_en": "The province",
                "description_zh": "省份",
                "example": "北京市",
                "type": "string",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The status of the delivery address. Valid values:\n0: non-default delivery address\n1: default delivery address",
                "description_zh": "收货地址状态  0: 非默认收获地址 1: 默认收获地址",
                "example": "0",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "Town": {
                "backendName": "town",
                "description_en": "The town",
                "description_zh": "城镇",
                "example": "荔湾区",
                "type": "string",
                "visibility": "Public"
              },
              "TownDivisionCode": {
                "backendName": "townDivisionCode",
                "description_en": "The level-4 address ID for the town or street",
                "description_zh": "第4级地址ID 镇、街道",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The response message",
            "description_zh": "返回信息",
            "example": "SUCCESS",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique request ID",
            "description_zh": "唯一请求识别码",
            "example": "6103AD7B-21C2-523B-89D0-579DA58D08E8",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
