                "type": "integer",
                "visibility": "Public"
              },
              "Area": {
                "backendName": "area",
                "description_en": "The area",
                "description_zh": "区域",
                "example": "fujian",
                "type": "string",
                "visibility": "Public"
              },
              "City": {
                "backendName": "city",
                "description_en": "The city",
                "description_zh": "所属城市",
