  "method": "GET|POST",
  "multi_version": false,
  "name": "GetEditingProject",
  "operation": {
    "action": "GetEditingProject",
    "api_style": "RPC",
    "api_version": "2017-03-21",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "fb2101bf24b27*****54cb318787dc",
      "help_en": "The online editing project ID",
      "help_zh": "云剪辑工程ID",
      "location": "query",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "ProjectId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "vod",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Project": {
            "backendName": "data.project",
            "description_en": "The online editing project",
            "description_zh": "云剪辑工程",
            "properties": {
              "CoverURL": {
                "backendName": "coverUrl",
                "description_en": "The thumbnail URL of the online editing project",
                "description_zh": "云剪辑工程封面URL",
                "example": "https://****.com/6AB4D0E1E1C74468883516C2349****.png",
                "type": "string",
                "visibility": "Public"
              },
              "CreationTime": {
                "backendName": "utcCreate",
                "description_en": "The time when the online editing project was created. The time is in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format (UTC)",
                "description_zh": "云剪辑工程创建时间。格式为：<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
                "example": "2017-10-23T13:33:40Z",
                "type": "string",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the online editing project",
                "description_zh": "云剪辑工程描述",
                "example": "testdescription",
                "type": "string",
                "visibility": "Public"
              },
              "ModifiedTime": {
                "backendName": "utcModified",
                "description_en": "The time when the online editing project was last modified. The time is in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format (UTC)",
                "description_zh": "云剪辑工程最新修改时间。格式为：<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
                "example": "2017-10-23T14:27:26Z",
                "type": "string",
                "visibility": "Public"
              },
              "ProjectId": {
                "backendName": "projectId",
                "description_en": "The online editing project ID",
                "description_zh": "云剪辑工程ID",
                "example": "fb2101bf24b27*****54cb318787dc",
                "type": "string",
                "visibility": "Public"
              },
              "RegionId": {
                "backendName": "region",
                "description_en": "The region ID",
                "description_zh": "地域",
                "example": "cn-shanghai",
                "type": "string",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "stateStr",
                "description_en": "The status of the online editing project. Multiple statuses are separated by commas (,). By default, all online editing projects are returned. Valid values:\n\nNormal: draft.\nProducing: being produced.\nProduced: produced.\nProduceFailed: failed to be produced",
                "description_zh": "云剪辑工程状态。多个状态使用英文逗号（,）分隔。默认获取所有云剪辑工程。取值：\n\nNormal：草稿。\nProducing：合成中。\nProduced：合成成功。\nProduceFailed：合成失败",
                "example": "Normal",
                "type": "string",
                "visibility": "Public"
              },
              "StorageLocation": {
                "backendName": "storageLocation",
                "description_en": "The storage address.\nYou can log on to the ApsaraVideo VOD console (https://vod.console.aliyun.com/?spm=a2c4g.11186623.2.15.6948257eaZ4m54#/vod/settings/censored) and choose Configuration Management > Media Asset Management Configuration > Storage Management to view the storage address",
                "description_zh": "存储地址。\n您可以登录点播控制台 (https://vod.console.aliyun.com/?spm=a2c4g.11186623.2.15.6948257eaZ4m54#/vod/settings/censored)，选择配置管理 > 媒资管理配置 > 存储管理查看存储地址",
                "example": "location_s",
                "type": "string",
                "visibility": "Public"
              },
              "Timeline": {
                "backendName": "timeline",
                "description_en": "The timeline of the online editing project",
                "description_zh": "云剪辑工程时间线",
                "example": "{\\\"TimelineIn\\\":0,\\\"TimelineOut\\\":9.42}",
                "type": "string",
                "visibility": "Public"
              },
              "Title": {
                "backendName": "title",
                "description_en": "The title of the online editing project",
                "description_zh": "云剪辑工程标题",
                "example": "Video_1508736815000",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "63E8B7C7-4812-46*****AD-0FA56029AC86",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
