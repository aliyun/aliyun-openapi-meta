  "parameters": [
    {
      "doc_required": true,
      "example": "357a8748c5789d2726e6436aa****",
      "help_en": "The video ID. You can obtain the video ID by using one of the following methods:\nFor videos uploaded through the console, log on to the ApsaraVideo VOD console (https://vod.console.aliyun.com) and choose Media Files > Audio/Video to view the video ID.\nObtain the video ID from the value of the VideoId response parameter when you call the https://help.aliyun.com/document_detail/55407.html operation to obtain the upload URL and credential.\nAfter the video is uploaded, call the https://help.aliyun.com/document_detail/86044.html operation to query the video ID, which is the value of the VideoId response parameter",
      "help_zh": "视频ID。可通过以下方式获取：\n通过控制台上传的视频，可登录点播控制台 (https://vod.console.aliyun.com)，选择媒资库 > 音/视频查看视频ID。\n通过https://help.aliyun.com/document_detail/55407.html接口获取上传地址和凭证时，视频ID为返回参数VideoId的值。\n视频上传后，可通过https://help.aliyun.com/document_detail/86044.html接口查询视频ID，为请求后返回参数VideoId的值",
      "location": "query",
      "name": "video_id",
      "options": [
        "--video-id"
      ],
      "raw_name": "VideoId",
      "required": true,
      "type": "string"
    }
