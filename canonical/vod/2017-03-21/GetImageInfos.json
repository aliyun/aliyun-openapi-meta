{
  "camel_example": "aliyun vod GetImageInfos --region cn-hangzhou --ImageIds 'bbc65bba53fed90de118a7849****,594228cdd14b4d069fc17a8c4a****'",
  "cmd_full_name": "vod get-image-infos",
  "cmd_name": "get-image-infos",
  "deprecated": false,
  "description_en": "Retrieves the basic information and access URLs of multiple images uploaded to ApsaraVideo VOD by specifying image IDs",
  "description_zh": "图片上传到视频点播后，可以调用本接口通过传入多个图片ID，批量获取图片的基本信息及访问地址",
  "kebab_example": "aliyun vod get-image-infos --image-ids 'bbc65bba53fed90de118a7849****,594228cdd14b4d069fc17a8c4a****' --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetImageInfos",
  "operation": {
    "action": "GetImageInfos",
    "api_style": "RPC",
    "api_version": "2017-03-21",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "bbc65bba53fed90de118a7849****,594228cdd14b4d069fc17a8c4a****",
      "help_en": "The list of image IDs. Separate multiple IDs with commas (,). You can specify up to 20 IDs. You can obtain the image IDs by using one of the following methods:\nLog on to the ApsaraVideo VOD console (https://vod.console.aliyun.com/) and choose Media Files > Images to view the IDs.\nCall the [CreateUploadImage](~~CreateUploadImage~~) operation to obtain the upload URL and credential. The image ID is returned in the response.\nCall the [SearchMedia](~~SearchMedia~~) operation to query images. The image ID is returned in the response",
      "help_zh": "图片ID列表，多个ID之间使用半角逗号（,）分隔，最多支持20个ID。可通过以下方式获取：\n可登录点播控制台 (https://vod.console.aliyun.com/)，选择媒资库>图片，查看ID。\n调用[CreateUploadImage](~~CreateUploadImage~~)获取上传地址和凭证时会返回。\n调用[SearchMedia](~~SearchMedia~~)查询图片时会返回",
      "location": "query",
      "name": "image_ids",
      "options": [
        "--image-ids"
      ],
      "raw_name": "ImageIds",
      "required": true,
      "type": "string"
    },
    {
      "example": "3600",
      "help_en": "The expiration time of the image access URL. Unit: seconds.\n\nIf OutputType is set to cdn:\n    - Only image URLs for which URL authentication is enabled expire. Otherwise, the URLs are permanently valid.\n    - Minimum value: 1.\n    - Maximum value: unlimited.\n    - Default value: If this parameter is not specified, the default validity period configured for URL authentication is used.\nIf OutputType is set to oss:\n    - Only playback URLs for images stored in private buckets expire. Otherwise, the URLs are permanently valid.\n    - Minimum value: 1.\n    - Maximum value: To reduce security risks to the origin server, the maximum value is 2592000 (30 days) if the image is stored in an ApsaraVideo VOD bucket, and 129600 (36 hours) if the image is stored in a custom OSS bucket.\n    - Default value: If this parameter is not specified, the value is 3600",
      "help_zh": "图片访问地址的过期时间。单位：秒。\n\n当OutputType取值为cdn时：\n    - 只有开启了URL鉴权的图片地址才会过期失效，否则会永久有效。\n    - 最小值：1。\n    - 最大值：无限制。\n    - 默认值：未设置时，取值为URL鉴权中设置的默认有效时长。\n当OutputType取值为oss时：\n    - 只有存储权限为私有，播放地址才会过期失效，否则会永久有效。\n    - 最小值：1。\n    - 最大值：为降低源站安全风险，当图片存储在点播系统Bucket上时，最大值为2592000（即30天），当图片存储在OSS自有Bucket上时，最大值为129600（即36小时）。\n    - 默认值：未设置时，取值为3600",
      "location": "query",
      "name": "auth_timeout",
      "options": [
        "--auth-timeout"
      ],
      "raw_name": "AuthTimeout",
      "required": false,
      "type": "int"
    },
    {
      "example": "cdn",
      "help_en": "The type of the output image access URL. Valid values:\n\noss: back-to-origin URL.\ncdn (default): accelerated URL",
      "help_zh": "输出的图片访问地址的类型。取值范围 ：\n\noss：回源地址。\ncdn（默认）：加速地址",
      "location": "query",
      "name": "output_type",
      "options": [
        "--output-type"
      ],
      "raw_name": "OutputType",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "vod",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ImageInfo": {
            "backendName": "data.imageDTOS",
            "description_en": "The list of image information",
            "description_zh": "图片信息列表",
            "itemName": "Image",
            "items": {
              "description_en": "The list of image information",
              "description_zh": "图片信息列表",
              "properties": {
                "AppId": {
                  "backendName": "appId",
                  "description_en": "The application ID",
                  "description_zh": "应用ID",
                  "example": "app-****",
                  "mappingResourcePropertyName": "$.AppId",
                  "type": "string",
                  "visibility": "Public"
                },
                "CateId": {
                  "backendName": "cateId",
                  "description_en": "The category ID",
                  "description_zh": "分类ID",
                  "example": "254766071",
                  "format": "int64",
                  "mappingResourcePropertyName": "$.CateId",
                  "type": "integer",
                  "visibility": "Public"
                },
                "CateName": {
                  "backendName": "cateName",
                  "description_en": "The category name",
                  "description_zh": "分类名称",
                  "example": "测试",
                  "mappingResourcePropertyName": "$.CateName",
                  "type": "string",
                  "visibility": "Public"
                },
                "CreationTime": {
                  "backendName": "createTime",
                  "description_en": "The time when the image was created. The time follows the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format. The time is displayed in UTC",
                  "description_zh": "图片创建时间。格式为：<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
                  "example": "2018-11-21T02:37:23Z",
                  "mappingResourcePropertyName": "$.CreateTime",
                  "type": "string",
                  "visibility": "Public"
                },
                "Description": {
                  "backendName": "desc",
                  "description_en": "The image description",
                  "description_zh": "图片描述",
                  "example": "测试描述",
                  "mappingResourcePropertyName": "$.Description",
                  "type": "string",
                  "visibility": "Public"
                },
                "ImageId": {
                  "backendName": "mediaId",
                  "description_en": "The image ID",
                  "description_zh": "图片ID",
                  "example": "bbc65bba53f9*****ed90de118a7849",
                  "mappingResourcePropertyName": "$.ImageId",
                  "type": "string",
                  "visibility": "Public"
                },
                "ImageType": {
                  "backendName": "imageType",
                  "description_en": "The image type. Valid values:\ndefault: regular image.\ncover: video thumbnail",
                  "description_zh": "图片类型。取值：\ndefault：普通图片\ncover：视频封面图",
                  "example": "default",
                  "mappingResourcePropertyName": "$.ImageType",
                  "type": "string",
                  "visibility": "Public"
                },
                "Mezzanine": {
                  "backendName": "mezzanineDTO",
                  "description_en": "The source information of the image",
                  "description_zh": "图片源信息",
                  "properties": {
                    "FileSize": {
                      "backendName": "fileSize",
                      "description_en": "The file size. Unit: bytes",
                      "description_zh": "文件大小。单位：字节",
                      "example": "8932",
                      "mappingResourcePropertyName": "$.Mezzanine.FileSize",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "FileURL": {
                      "backendName": "fileUrl",
                      "description_en": "The OSS URL of the image file",
                      "description_zh": "图片文件的OSS地址",
                      "example": "https://outin-bfefbb*****163e1c7426.oss-cn-XXXXXXXX.aliyuncs.com/image/default/5E84CD536*****D4DAD.png?Expires=1590982353&OSSAccessKeyId=REDACTED_ACCESS_KEY_ID&Signature=REDACTED_SIGNATURE",
                      "mappingResourcePropertyName": "$.Mezzanine.FileUrl",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Height": {
                      "backendName": "height",
                      "description_en": "The height of the image. Unit: pixels",
                      "description_zh": "图片高度。单位：像素",
                      "example": "200",
                      "format": "int32",
                      "mappingResourcePropertyName": "$.Mezzanine.Height",
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "OriginalFileName": {
                      "backendName": "originalFileName",
                      "description_en": "The name of the uploaded source image file",
                      "description_zh": "上传的图片源文件地址",
                      "example": "****.gif",
                      "mappingResourcePropertyName": "$.Mezzanine.OriginalFileName",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Width": {
                      "backendName": "width",
                      "description_en": "The width of the image. Unit: pixels",
                      "description_zh": "图片宽度。单位：像素",
                      "example": "200",
                      "format": "int32",
                      "mappingResourcePropertyName": "$.Mezzanine.Width",
                      "type": "integer",
                      "visibility": "Public"
                    }
                  },
                  "type": "object",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "statusDescription",
                  "description_en": "The image status. Valid values:\n\nUploading: The initial status, which indicates that the image is being uploaded.\nNormal: The image is uploaded.\nUploadFail: The image failed to be uploaded",
                  "description_zh": "图片状态。取值：\n\nUploading：初始状态，表示图片正在上传。\nNormal：图片上传成功。\nUploadFail：图片上传失败",
                  "example": "Uploading",
                  "mappingResourcePropertyName": "$.Status",
                  "type": "string",
                  "visibility": "Public"
                },
                "StorageLocation": {
                  "backendName": "storageLocation",
                  "description_en": "The storage address of the image file",
                  "description_zh": "图片文件的存储地址",
                  "example": "outin-****..oss-cn-shanghai.aliyuncs.com",
                  "mappingResourcePropertyName": "$.StorageLocation",
                  "type": "string",
                  "visibility": "Public"
                },
                "Tags": {
                  "backendName": "tags",
                  "description_en": "The image tags. Separate multiple tags with commas (,)",
                  "description_zh": "图片标签。多个标签之间使用半角逗号（,）分隔",
                  "example": "tag1,tag2,tag3",
                  "mappingResourcePropertyName": "$.ImageTags",
                  "type": "string",
                  "visibility": "Public"
                },
                "Title": {
                  "backendName": "title",
                  "description_en": "The image title",
                  "description_zh": "图片标题",
                  "example": "this is a sample",
                  "mappingResourcePropertyName": "$.Title",
                  "type": "string",
                  "visibility": "Public"
                },
                "URL": {
                  "backendName": "url",
                  "description_en": "The image access URL. If a CDN domain name is configured, the value is a CDN URL. Otherwise, the value is an OSS URL",
                  "description_zh": "图片访问地址（如果配置了CDN域名则为CDN地址，否则为OSS地址）",
                  "example": "http://example.aliyundoc.com/image/default/****.gif?auth_key=****",
                  "mappingResourcePropertyName": "$.Url",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "NonExistImageIds": {
            "backendName": "data.nonExistImageIds",
            "description_en": "The list of image IDs that do not exist",
            "description_zh": "不存在的图片ID列表",
            "itemName": "ImageId",
            "items": {
              "description_en": "The list of image IDs that do not exist",
              "description_zh": "不存在的图片ID列表",
              "example": "f45cf4eba5c80233389558c39****",
              "type": "string"
            },
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "25818875-5F78-4AF6-D7393642CA58*****",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
