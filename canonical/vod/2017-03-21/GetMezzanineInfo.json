{
  "camel_example": "aliyun vod GetMezzanineInfo --region cn-hangzhou --VideoId 1f1a6fc03ca04814031b8a6559e0000 --ReferenceId '123-123' --AuthTimeout 3600 --OutputType oss --AdditionType video",
  "cmd_full_name": "vod get-mezzanine-info",
  "cmd_name": "get-mezzanine-info",
  "deprecated": false,
  "description_en": "Retrieves the source file information of an audio or video file, including the file URL, resolution, and bitrate",
  "description_zh": "获取音视频的源文件信息，包括文件地址、分辨率、码率等",
  "kebab_example": "aliyun vod get-mezzanine-info --video-id 1f1a6fc03ca04814031b8a6559e0000 --auth-timeout 3600 --output-type oss --addition-type video --reference-id 123-123 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetMezzanineInfo",
  "operation": {
    "action": "GetMezzanineInfo",
    "api_style": "RPC",
    "api_version": "2017-03-21",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "1f1a6fc03ca04814031b8a6559e****",
      "help_en": "The audio or video ID. You can obtain the ID by using one of the following methods:\nFor audio or video files uploaded through the console, log on to the ApsaraVideo VOD console (https://vod.console.aliyun.com) and choose Media Files > Audio/Video to view the video ID.\nObtain the video ID from the VideoId parameter returned by the https://help.aliyun.com/document_detail/55407.html operation when you request an upload URL and credential.\nAfter the video is uploaded, call the https://help.aliyun.com/document_detail/86044.html operation to query the audio or video ID, which is the value of VideoId in the response",
      "help_zh": "音/视频ID。可通过以下方式获取：\n通过控制台上传的音/视频，可登录点播控制台 (https://vod.console.aliyun.com)，选择媒资库 > 音/视频查看视频ID。\n通过https://help.aliyun.com/document_detail/55407.html接口获取上传地址和凭证时，音/视频ID为返回参数VideoId的值。\n视频上传后，可通过https://help.aliyun.com/document_detail/86044.html接口查询音/视频ID，为请求后返回参数VideoId的值",
      "location": "query",
      "name": "video_id",
      "options": [
        "--video-id"
      ],
      "raw_name": "VideoId",
      "required": false,
      "type": "string"
    },
    {
      "example": "3600",
      "help_en": "The validity period of the signature for FileURL (source file URL). Unit: seconds. Default value: 3600. The minimum value is 1.\nIf OutputType is set to cdn:\n    - FileURL expires periodically only if URL signing is enabled. Otherwise, FileURL is permanently valid.\n    - Minimum value: 1.\n    - Maximum value: unlimited.\n    - Default value: 3600 if this parameter is not specified.\nIf OutputType is set to oss:\n    - FileURL expires periodically only if the storage permission is set to private. Otherwise, FileURL is permanently valid.\n    - Minimum value: 1.\n    - Maximum value: To reduce security risks to the origin server, the maximum value is 2592000 (30 days) when the audio or video file is stored in a bucket managed by ApsaraVideo VOD, and 129600 (36 hours) when the file is stored in your own OSS bucket.\n    - Default value: 3600 if this parameter is not specified",
      "help_zh": "FileURL（源文件地址）签名过期时间。单位：秒。默认值为3600，支持设置最小值为1。\n如果OutputType取值为cdn：\n    - 只有开启了URL鉴权，FileURL才会定期失效，否则会永久有效。\n    - 最小值：1。\n    - 最大值：无限制。\n    - 默认值：未设置时，取值为3600。\n如果OutputType取值为oss：\n    - 只有存储权限为私有，FileURL才会定期失效，否则会永久有效。\n    - 最小值：1。\n    - 最大值：为降低源站安全风险，当音视频存储在点播系统Bucket上时，最大值为2592000（即30天），当音视频存储在OSS自有Bucket上时，最大值为129600（即36小时）。\n    - 默认值：未设置时，取值为3600",
      "location": "query",
      "name": "auth_timeout",
      "options": [
        "--auth-timeout"
      ],
      "raw_name": "AuthTimeout",
      "required": false,
      "type": "int"
    },
    {
      "example": "oss",
      "help_en": "The type of the output URL. Valid values:\n\noss: back-to-origin URL.\ncdn (default): CDN URL.\n\nIf the bucket type of the source file is in, only the OSS URL is returned",
      "help_zh": "输出地址类型。取值：\n\noss：回源地址。\ncdn（默认）：加速地址。\n\n当源文件所在的bucket类型为in时，只返回OSS地址",
      "location": "query",
      "name": "output_type",
      "options": [
        "--output-type"
      ],
      "raw_name": "OutputType",
      "required": false,
      "type": "string"
    },
    {
      "example": "video",
      "help_en": "The type of additional information. Separate multiple values with commas (,). By default, only basic information is returned. Valid values:\n\nvideo: video stream information.\naudio: audio stream information",
      "help_zh": "附加信息类型。多个使用半角逗号（,）分隔，默认只返回基本信息。取值：\n\nvideo：视频流信息。\naudio：音频流信息",
      "location": "query",
      "name": "addition_type",
      "options": [
        "--addition-type"
      ],
      "raw_name": "AdditionType",
      "required": false,
      "type": "string"
    },
    {
      "example": "123-123",
      "help_en": "The custom ID. Only lowercase letters, uppercase letters, digits, hyphens (-), and underscores (_) are supported. The value must be 6 to 64 characters in length and is unique at the user level",
      "help_zh": "自定义ID，仅支持小写字母、大写字母、数字、横线、下划线，长度 6-64 位。用户维度唯一",
      "location": "query",
      "name": "reference_id",
      "options": [
        "--reference-id"
      ],
      "raw_name": "ReferenceId",
      "required": false,
      "type": "string"
    }
  ],
