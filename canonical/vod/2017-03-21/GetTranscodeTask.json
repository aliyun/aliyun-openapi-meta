{
  "camel_example": "aliyun vod GetTranscodeTask --region cn-hangzhou --JobIds '86c1925fba00000,7afb201e7fa0000,2cc49973780000' --TranscodeTaskId b1b65ab107e14000003dbb900f6c1fe0",
