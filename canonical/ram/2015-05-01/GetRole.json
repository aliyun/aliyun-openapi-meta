      "help_zh": "指定角色名。\n\n长度为1~64个字符，可包含英文字母、数字、点号（.）和短划线（-）",
      "location": "query",
      "name": "role_name",
      "options": [
        "--role-name"
      ],
      "raw_name": "RoleName",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Ram",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "04F0F334-1335-436C-A1D7-6C044FE73368",
            "type": "string",
            "visibility": "Public"
          },
          "Role": {
            "backendName": "Role",
            "description_en": "The role information",
            "description_zh": "角色信息",
            "properties": {
              "AllowConsoleLogin": {
                "backendName": "AllowConsoleLogin",
                "description_en": "Indicates whether console logon is allowed for the RAM role",
                "description_zh": "RAM 角色允许控制台登录开关",
                "example": "true",
                "type": "boolean"
              },
              "Arn": {
                "backendName": "Arn",
                "description_en": "The resource descriptor of the role",
                "description_zh": "角色的资源描述符",
                "example": "acs:ram::123456789012****:role/ECSAdmin",
                "mappingResourcePropertyName": "$.Arn",
                "type": "string",
                "visibility": "Public"
              },
              "AssumeRolePolicyDocument": {
                "backendName": "AssumeRolePolicyDocument",
                "description_en": "The access policy that specifies the permission to assume the role",
                "description_zh": "扮演角色的权限策略",
                "example": "{ \"Statement\": [ { \"Action\": \"sts:AssumeRole\", \"Effect\": \"Allow\", \"Principal\": { \"RAM\": \"acs:ram::123456789012****:root\" } } ], \"Version\": \"1\" }",
                "mappingResourcePropertyName": "$.AssumeRolePolicyDocument",
                "type": "string",
                "visibility": "Public"
              },
              "CreateDate": {
                "backendName": "CreateDate",
                "description_en": "The time when the role was created. The time is in UTC in the `YYYY-MM-DDThh:mm:ssZ` format",
                "description_zh": "创建时间，采用 UTC 时间，格式为 `YYYY-MM-DDThh:mm:ssZ`",
                "example": "2015-01-23T12:33:18Z",
                "mappingResourcePropertyName": "$.CreateTime",
                "type": "string",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "Description",
                "description_en": "The description of the role",
                "description_zh": "角色描述",
                "example": "ECS管理角色",
                "mappingResourcePropertyName": "$.Description",
                "type": "string",
                "visibility": "Public"
              },
              "IsServiceLinkedRole": {
                "backendName": "IsServiceLinkedRole",
                "description_en": "Indicates whether the role is a service-linked role",
                "description_zh": "是否为服务关联角色",
                "example": "true",
                "type": "boolean"
              },
              "LatestDeletionTask": {
                "backendName": "LatestDeletionTask",
                "description_en": "The information about the most recent deletion task",
                "description_zh": "最近一次删除任务信息",
                "properties": {
                  "CreateDate": {
                    "backendName": "CreateDate",
                    "description_en": "The time when the deletion task was created. The time is in UTC in the `YYYY-MM-DDThh:mm:ssZ` format",
                    "description_zh": "删除任务创建时间，采用 UTC 时间，格式为 `YYYY-MM-DDThh:mm:ssZ`",
                    "example": "2018-10-23T12:33:18Z",
                    "type": "string"
                  },
                  "DeletionTaskId": {
                    "backendName": "DeletionTaskId",
                    "description_en": "The ID of the deletion task",
                    "description_zh": "删除任务 ID",
                    "example": "task/acs-service-role/sas.aliyuncs.com/AliyunServiceRoleForSas/20843430-bb43-44fe-a7ff-02ab09183436",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "MaxSessionDuration": {
                "backendName": "MaxSessionDuration",
                "description_en": "The maximum session duration of the role",
                "description_zh": "角色最大会话时间",
                "example": "3600",
                "format": "int64",
                "mappingResourcePropertyName": "$.MaxSessionDuration",
                "type": "integer",
                "visibility": "Public"
              },
              "RoleId": {
                "backendName": "RoleId",
                "description_en": "The ID of the role",
                "description_zh": "角色ID",
                "example": "901234567890****",
                "mappingResourcePropertyName": "$.RoleId",
                "type": "string",
                "visibility": "Public"
              },
              "RoleName": {
                "backendName": "RoleName",
                "description_en": "The name of the role",
                "description_zh": "角色名称",
                "example": "ECSAdmin",
                "mappingResourcePropertyName": "$.RoleName",
                "type": "string",
                "visibility": "Public"
              },
              "RolePrincipalName": {
                "backendName": "RolePrincipalName",
                "description_en": "The name of the role with the domain name suffix",
                "description_zh": "带域名后缀的角色名称",
                "example": "ECSAdmin@role.123456.onaliyunservice.com",
                "type": "string"
              },
              "UpdateDate": {
                "backendName": "UpdateDate",
                "description_en": "The time when the role was last updated. The time is in UTC in the `YYYY-MM-DDThh:mm:ssZ` format",
                "description_zh": "更新时间，采用 UTC 时间，格式为 `YYYY-MM-DDThh:mm:ssZ`",
                "example": "2015-01-23T12:33:18Z",
                "mappingResourcePropertyName": "$.UpdateDate",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
