        "--space-id"
      ],
      "raw_name": "SpaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "256",
      "help_en": "Function memory size. Must be a multiple of 64 MB. Minimum is 128 MB. Maximum is 2048 MB",
      "help_zh": "函数内存规格，取值为64的倍数，至少128，至多2048。单位：MB",
      "location": "formData",
      "maximum": "2048",
      "minimum": "128",
      "name": "memory",
      "options": [
        "--memory"
      ],
      "raw_name": "Memory",
      "required": false,
      "type": "int"
    },
    {
      "example": "5",
      "help_en": "Function timeout period in seconds. Default is 5. Valid range is 1 to 7200",
      "help_zh": "函数超时时间，单位为秒，默认值为5，取值范围1-7200",
      "location": "formData",
      "maximum": "7200",
      "minimum": "1",
      "name": "timeout",
      "options": [
        "--timeout"
      ],
      "raw_name": "Timeout",
      "required": false,
      "type": "int"
    },
    {
      "example": "/http/hello",
      "help_en": "HTTP trigger path. To disable this feature, set this parameter to an empty string. The path must start with /http. It cannot end with /. Paths must be unique within the same service space. Only the following characters are allowed: /, -, `_`, `.`, letters, and digits. Maximum length is 128 characters",
      "help_zh": "HTTP触发的路径，设置为空字符串表示取消该功能。必须以`/http`开头，不能以`/`结尾，同一个Space下不允许重复，只支持（/）、（-）、（_）、（.）、字母和数字组合，最长不超过128个字符",
      "location": "formData",
      "max_length": "128",
      "name": "http_trigger_path",
      "options": [
        "--http-trigger-path"
      ],
      "raw_name": "HttpTriggerPath",
      "required": false,
      "type": "string"
    },
    {
      "example": "cron:0 0 * * * *",
      "help_en": "Scheduled trigger configuration. To disable this feature, set this parameter to an empty string. For configuration rules, see Use scheduled triggers for functions (https://help.aliyun.com/document_detail/160666.htm).\n\nPublic preview: cron:0 0 \\/2 \\ * . Commercial edition: 0 0 \\/2 * * *",
      "help_zh": "定时触发配置，设置为空字符串表示取消该功能，配置规则请参见使用云函数定时触发功能 (https://help.aliyun.com/document_detail/160666.htm)。\n公测版：cron:0 0 */2 * * * ；商业版：0 0 */2 * * *",
      "location": "formData",
      "name": "timing_trigger_config",
      "options": [
        "--timing-trigger-config"
      ],
      "raw_name": "TimingTriggerConfig",
      "required": false,
      "type": "string"
    },
    {
      "example": "hello",
      "help_en": "Custom input parameter for scheduled tasks.\n\nThis feature is supported only in the commercial edition",
      "help_zh": "定时函数任务自定义参数\n\n仅商业版支持该功能",
      "location": "formData",
      "name": "timing_trigger_user_payload",
      "options": [
        "--timing-trigger-user-payload"
      ],
      "raw_name": "TimingTriggerUserPayload",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "Maximum concurrent invocations per instance. Default is 1. Valid range is 1 to 20. Setting a value greater than 1 reduces cold starts. Use this setting when your function spends most of its time waiting for downstream services. Do not use it if your function has shared state that cannot be accessed concurrently. Also avoid it if a single request consumes large amounts of CPU or memory.\n\nWhen you set this value to more than 1, memory must be at least 512 MB",
      "help_zh": "单实例允许的最大并发度，默认值为1，取值范围1-20。设置单实例多并发可以降低冷启动的频率，适用于函数中有较多时间在等待下游服务响应的场景，不适用于函数中有共享状态且不能并发访问的场景，也不适用于单个请求的执行要消耗大量CPU及内存资源的场景。\n\n\n\n\n当设置大于1时要求内存不低于512MB",
      "location": "formData",
      "maximum": "20",
      "minimum": "1",
      "name": "instance_concurrency",
      "options": [
        "--instance-concurrency"
      ],
      "raw_name": "InstanceConcurrency",
      "required": false,
      "type": "int"
    },
    {
      "enum": [
        "nodejs8",
        "nodejs12",
        "nodejs14",
        "nodejs16",
        "nodejs18",
        "nodejs20"
      ],
      "example": "nodejs14",
      "help_en": "Function runtime environment. Supported values include nodejs12 and nodejs14. For the full list, see Supported runtimes (https://help.aliyun.com/document_detail/2717618.html)",
      "help_zh": "云函数执行环境，可选值nodejs12,nodejs14等，具体请参见文档《运行时支持列表》 (https://help.aliyun.com/document_detail/2717618.html)",
      "location": "formData",
      "name": "runtime",
      "options": [
        "--runtime"
      ],
      "raw_name": "Runtime",
      "required": false,
      "type": "string"
    }
  ],
