{
  "camel_example": "",
  "cmd_full_name": "mpserverless describe-function",
  "cmd_name": "describe-function",
  "deprecated": false,
  "description_en": "Queries the details of a cloud function",
  "description_zh": "查询已创建的云函数详情",
  "kebab_example": "aliyun mpserverless describe-function --name demoFunction --space-id dece4ea0-d432-4cfa-8514-xxxx --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeFunction",
  "operation": {
    "action": "DescribeFunction",
    "api_style": "RPC",
    "api_version": "2019-06-15",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "demoFunction",
      "help_en": "The name of the cloud function",
      "help_zh": "云函数名称",
      "location": "formData",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "dece4ea0-d432-4cfa-8514-xxxx",
      "help_en": "The ID of the service space to which the cloud function belongs",
      "help_zh": "云函数所属的服务空间ID",
      "location": "formData",
      "name": "space_id",
      "options": [
        "--space-id"
      ],
      "raw_name": "SpaceId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "MPServerless",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Deployment": {
            "backendName": "deployment",
            "description_en": "Details of the deployment record",
            "description_zh": "部署单详情",
            "nullToEmpty": false,
            "properties": {
              "CreatedAt": {
                "backendName": "createdAt",
                "description_en": "The creation time",
                "description_zh": "创建时间",
                "example": "2019-06-11T10:51:19Z",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "DeploymentId": {
                "backendName": "deploymentId",
                "description_en": "The deployment record ID",
                "description_zh": "部署单ID",
                "example": "dep-62020d3bea44fd4608118233",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "DownloadSignedUrl": {
                "backendName": "downloadSignedUrl",
                "description_en": "The download URL",
                "description_zh": "下载URL",
                "example": "http://bucket.oss-cn-shanghai.aliyuncs.com/xxxx-v2.zip?OSSAccessKeyId=LT*********1DkK6&Expires=1561425220&Signature=xEuiAgUMShQ4v8fYIl3FM8Jp3MA%3D",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "ModifiedAt": {
                "backendName": "modifiedAt",
                "description_en": "The last modification time",
                "description_zh": "修改时间",
                "example": "2019-06-11T10:51:19Z",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "VersionNo": {
                "backendName": "versionNo",
                "description_en": "The version number. This equals the timestamp when the deployment package was uploaded",
                "description_zh": "版本号。版本号是部署单上传的时间",
                "example": "2019061110511905080",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Function": {
            "backendName": "function",
            "description_en": "Information about the cloud function",
            "description_zh": "云函数信息",
            "nullToEmpty": false,
            "properties": {
              "CreatedAt": {
                "backendName": "createdAt",
                "description_en": "The creation time of the cloud function",
                "description_zh": "云函数的创建时间",
                "example": "2021-12-02T02:40:37Z",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Desc": {
                "backendName": "desc",
                "description_en": "The description of the cloud function",
                "description_zh": "云函数描述",
                "example": "获取微信绑定手机号",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "HttpTriggerPath": {
                "backendName": "httpTriggerPath",
                "description_en": "The HTTP trigger path. Set this to an empty string to disable the feature. The path must start with `/`, must not end with `/`, must be unique within the same Space, and can contain only letters, digits, and the characters (/), (-), (_), and (.). The maximum length is 128 characters",
                "description_zh": "HTTP触发的路径，设置为空字符串表示取消该功能。必须以`/`开头，不能以`/`结尾，同一个Space下不允许重复，只支持（/）、（-）、（_）、（.）、字母和数字组合，最长不超过128个字符",
                "example": "/http/getWxToken",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "ModifiedAt": {
                "backendName": "modifiedAt",
                "description_en": "The last modification time of the cloud function",
                "description_zh": "云函数的修改时间",
                "example": "2019-06-21T02:22:53Z",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the cloud function",
                "description_zh": "云函数名称",
                "example": "demoFunction",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "Spec": {
                "backendName": "spec",
                "description_en": "The runtime environment",
                "description_zh": "运行环境",
                "nullToEmpty": false,
                "properties": {
                  "InstanceConcurrency": {
                    "backendName": "instanceConcurrency",
                    "description_en": "The maximum concurrency per instance. Default value is 1. Valid range is 1–100. Enabling multi-concurrency per instance reduces cold start frequency. This setting works well when your function spends significant time waiting for downstream service responses. Do not use it if your function maintains shared state that cannot be accessed concurrently or if a single request consumes large amounts of CPU and memory resources",
                    "description_zh": "单实例允许的最大并发度，默认值为1，取值范围1-100。设置单实例多并发可以降低冷启动的频率，适用于函数中有较多时间在等待下游服务响应的场景，不适用于函数中有共享状态且不能并发访问的场景，也不适用于单个请求的执行要消耗大量CPU及内存资源的场景",
                    "example": "1",
                    "format": "int32",
                    "nullToEmpty": false,
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "Memory": {
                    "backendName": "memory",
                    "description_en": "The memory allocation for the function. Must be a multiple of 64 MB, with a minimum of 128 MB and a maximum of 2048 MB",
                    "description_zh": "函数内存规格，取值为64的倍数，至少128MB，至多2048MB",
                    "example": "512",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Runtime": {
                    "backendName": "runtime",
                    "description_en": "The execution environment of the cloud function. Default value is nodejs12. Valid values are nodejs8 and nodejs12",
                    "description_zh": "云函数执行环境，默认值为nodejs12，可选值为nodejs8,nodejs12",
                    "example": "nodejs12",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Timeout": {
                    "backendName": "timeout",
                    "description_en": "The function timeout in seconds. Default value is 5. Valid range is 1–10",
                    "description_zh": "函数超时时间，单位为秒，默认值为5，取值范围1-10",
                    "example": "5",
                    "nullToEmpty": false,
                    "type": "string",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "TimingTriggerConfig": {
                "backendName": "timingTriggerConfig",
                "description_en": "The scheduled trigger configuration",
                "description_zh": "定时触发配置",
                "example": "公测版：cron:0 0 */2 * * *\n\n商业版：0 0 */2 * * *",
                "nullToEmpty": false,
                "type": "string",
                "visibility": "Public"
              },
              "TimingTriggerUserPayload": {
                "backendName": "timingTriggerUserPayload",
                "description_en": "Custom parameters for scheduled trigger tasks.\n\nThis feature is supported only in the commercial version",
                "description_zh": "定时触发任务自定义参数\n仅商业版支持该功能",
                "example": "hello",
                "type": "string"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique request ID",
            "description_zh": "唯一请求ID",
            "example": "75CE67BE-48E9-52AF-B965-4690270CD53A",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
