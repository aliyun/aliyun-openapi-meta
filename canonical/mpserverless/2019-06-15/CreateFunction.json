    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "demoFunction",
      "help_en": "The function name.  \nThe name must be 1 to 30 characters long and can contain only letters, digits, underscores (_), and hyphens (-). It cannot start with a digit or a hyphen.\n\nThe name of the cloud function must match the name of the Node.js code package to be uploaded",
      "help_zh": "函数名称。\n函数名称长度在1-30个字符间，只能包含字母、数字、下划线和中划线，不能以数字、中划线开头。\n\n云函数的名称必须和要上传的Node.js代码包名称一致",
      "location": "formData",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": true,
      "type": "string"
    },
    {
      "example": "测试函数",
      "help_en": "Description of the cloud function",
      "help_zh": "云函数的描述信息",
      "location": "formData",
      "max_length": "128",
      "name": "desc",
      "options": [
        "--desc"
      ],
      "raw_name": "Desc",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "226e5213-697c-4a52-b4ff-xxxxx",
      "help_en": "The ID of the service space to which the cloud function belongs",
      "help_zh": "云函数所属的服务空间ID",
      "location": "formData",
      "name": "space_id",
      "options": [
        "--space-id"
      ],
      "raw_name": "SpaceId",
      "required": true,
      "type": "string"
    },
    {
      "enum": [
        "nodejs8",
        "nodejs12",
        "nodejs14",
        "nodejs16",
        "nodejs18",
        "nodejs20"
      ],
      "example": "nodejs12",
      "help_en": "Execution runtime of the cloud function. The default value is nodejs14. Valid values include nodejs12, nodejs14, and others. For more information, see the document Runtime Support List (https://help.aliyun.com/document_detail/2717618.html)",
      "help_zh": "云函数执行环境，默认值为nodejs14，可选值为nodejs12,nodejs14等，详情参见文档《运行时支持列表》 (https://help.aliyun.com/document_detail/2717618.html)",
      "location": "formData",
      "name": "runtime",
      "options": [
        "--runtime"
      ],
      "raw_name": "Runtime",
      "required": false,
      "type": "string"
    },
    {
      "example": "512",
      "help_en": "Memory specification for the function. The value must be a multiple of 64, with a minimum of 128 MB and a maximum of 2048 MB",
      "help_zh": "函数内存规格，取值为64的倍数，至少128MB，至多2048MB",
      "location": "formData",
      "maximum": "2048",
      "minimum": "128",
      "name": "memory",
      "options": [
        "--memory"
      ],
      "raw_name": "Memory",
      "required": false,
      "type": "int"
    },
    {
      "example": "5",
      "help_en": "The function timeout, in seconds. Default value is 5. Valid values range from 1 to 7200",
      "help_zh": "函数超时时间，单位为秒，默认值为5，取值范围1-7200",
      "location": "formData",
      "maximum": "7200",
      "minimum": "1",
      "name": "timeout",
      "options": [
        "--timeout"
      ],
      "raw_name": "Timeout",
      "required": false,
      "type": "int"
    }
  ],
