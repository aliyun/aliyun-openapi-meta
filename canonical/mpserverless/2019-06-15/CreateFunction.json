{
  "camel_example": "",
  "cmd_full_name": "mpserverless create-function",
  "cmd_name": "create-function",
  "deprecated": false,
  "description_en": "Create a cloud function",
  "description_zh": "创建云函数",
  "kebab_example": "aliyun mpserverless create-function --name demoFunction --space-id 226e5213-697c-4a52-b4ff-xxxxx --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "CreateFunction",
  "operation": {
    "action": "CreateFunction",
    "api_style": "RPC",
