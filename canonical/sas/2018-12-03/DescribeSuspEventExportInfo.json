      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "Sas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ExportStatus": {
            "backendName": "data.status",
            "description_en": "The handling status for the exception. Valid values:\n\nexporting: in progress\nsuccess: successful\nfailed: failed\npending: pending",
            "description_zh": "异常事件处理状态。取值包括：\nexporting：处理中\nsuccess：处理成功\nfailed：处理失败\npending：等待中",
            "example": "success",
            "type": "string"
          },
          "FileName": {
            "backendName": "data.fileName",
            "description_en": "The name of the exported file",
            "description_zh": "导出的文件名称",
            "example": "suspicious_event_20221221_1671590521234.zip",
            "type": "string"
          },
          "GmtCreate": {
            "backendName": "data.gmtCreate",
            "description_en": "The time when the export task was created",
            "description_zh": "创建时间",
            "example": "2022-12-20T15:18Z",
            "format": "int64",
            "type": "integer"
          },
          "GmtModified": {
            "backendName": "data.gmtModified",
            "description_en": "The time when the export task was modified",
            "description_zh": "修改时间",
            "example": "2022-12-20T15:18Z",
            "format": "int64",
            "type": "integer"
          },
          "Id": {
            "backendName": "data.id",
            "description_en": "The ID of the export task",
            "description_zh": "异常事件的导出任务id",
            "example": "11",
            "format": "int32",
            "type": "integer"
          },
          "Link": {
            "backendName": "data.link",
            "description_en": "The URL at which you can download the exported Excel file",
            "description_zh": "导出后Excel的下载链接",
            "example": "http://suspicious-xxxxxxx.oss-cn-shanghai.aliyuncs.com/xxxxxxxxxxx/suspicious_event_20221221_1671590525269.zip?Expires=1671594125&OSSAccessKeyId=yourAccessKeyID&Signature=xxxxxxxxxxxxxxxxxx",
            "type": "string"
          },
          "Progress": {
            "backendName": "data.progress",
            "description_en": "The progress percentage of the export task",
            "description_zh": "异常事件的导出进度百分比",
            "example": "100",
            "format": "int32",
            "type": "integer"
          },
          "Properties": {
            "backendName": "data.properties",
            "description_en": "The exported parameters of exceptions",
            "description_zh": "异常事件的导出参数",
            "example": "id,eventSubType,eventDetail,level,status,ip,instanceName,desc,lastTime,operateTime,note",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "阿里云为该请求生成的唯一标识符",
            "example": "BE120DAB-F4E7-4C53-ADC3-A97578AXXXXX",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.totalCount",
            "description_en": "The total number of exceptions exported",
            "description_zh": "异常事件的总数量",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "Type": {
            "backendName": "data.type",
            "description_en": "The type of the export task. The value is fixed as suspiciousEvent",
            "description_zh": "导出任务类型，固定为 suspiciousEvent",
            "example": "suspiciousEvent",
            "type": "string"
          }
        },
        "type": "object"
      }
