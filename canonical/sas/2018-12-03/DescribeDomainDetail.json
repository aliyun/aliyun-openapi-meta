      "type": "string"
    },
    {
      "example": "example.com",
      "help_en": "The name of the domain name or website to query.\n\nFuzzy match is not supported. Enter the complete domain name or website name",
      "help_zh": "要查询的域名或网站的名称。\n\n不支持模糊查询，您需要输入完整的域名或网站名称",
      "location": "query",
      "name": "domain_name",
      "options": [
        "--domain-name"
      ],
      "raw_name": "DomainName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Sas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "AlarmCount": {
            "backendName": "data.alarmCount",
            "description_en": "The total number of alerts in your website assets",
            "description_zh": "您网站资产中的告警的总数量",
            "example": "2",
            "format": "int32",
            "type": "integer"
          },
          "Domain": {
            "backendName": "data.domain",
            "description_en": "The domain name",
            "description_zh": "域名",
            "example": "example.com",
            "type": "string"
          },
          "DomainDetailItems": {
            "backendName": "data.domainDetailItems",
            "description_en": "The asset information related to the domain name",
            "description_zh": "域名相关的资产信息",
            "itemName": "DomainDetailItem",
            "items": {
              "properties": {
                "AssetType": {
                  "backendName": "machineType",
                  "description_en": "The Asset Type of the asset under the domain name. Valid values:\n\n0: ECS\n1: load balancing\n2: NAT gateway\n3: RDS database\n4: MongoDB database",
                  "description_zh": "域名下资产的资产类型。取值包括：\n\n0：ECS\n1：负载均衡\n2：NAT网关\n3：RDS数据库\n4：MongoDB数据库",
                  "example": "0",
                  "type": "string"
                },
                "InstanceId": {
                  "backendName": "machineInstanceId",
                  "description_en": "The instance ID of the asset",
                  "description_zh": "资产的实例ID",
                  "example": "i-m5e6w7dzsktt6mz4***",
                  "type": "string"
                },
                "InstanceName": {
                  "backendName": "machineName",
                  "description_en": "The name of the asset",
                  "description_zh": "资产的名称",
                  "example": "iZm5e6w7dzsktt6mz4yimeZ-6****",
                  "type": "string"
                },
                "InternetIp": {
                  "backendName": "internetIp",
                  "description_en": "The public IP address of the asset",
                  "description_zh": "资产对应的公网的IP地址",
                  "example": "1.2.XX.XX",
                  "type": "string"
                },
                "IntranetIp": {
                  "backendName": "intranetIp",
                  "description_en": "The private IP address of the asset",
                  "description_zh": "资产对应的私网的IP地址",
                  "example": "1.2.XX.XX",
                  "type": "string"
                },
                "Uuid": {
                  "backendName": "uuid",
                  "description_en": "The UUID of the asset instance",
                  "description_zh": "资产实例的UUID",
                  "example": "lb-bp1g9dohoyin9cjhn6****",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID. The China value is a unique identifier that Alibaba Cloud generates for the request. You can use this ID to troubleshoot issues",
            "description_zh": "本次调用请求的ID，是由阿里云为该请求生成的唯一标识符，可用于排查和定位问题",
            "example": "3A85CFCF-05C8-451A-9E41-C0D5E96BA407",
            "type": "string"
          },
          "RootDomain": {
            "backendName": "data.rootDomain",
            "description_en": "The root domain name that corresponds to the domain name",
            "description_zh": "域名对应的根域名的名称",
            "example": "example.com",
            "type": "string"
          },
          "VulCount": {
            "backendName": "data.vulCount",
            "description_en": "The total number of vulnerabilities in your website assets",
            "description_zh": "您网站资产中的漏洞的总数量",
            "example": "2",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
