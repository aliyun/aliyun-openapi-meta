  "camel_example": "aliyun avatar QueryRunningInstance --region cn-hangzhou --App '{\"AppId\":\"ALIPUB5748B17121450\"}' --TenantId 9185 --version 2022-01-30 --method POST --force",
  "cmd_full_name": "avatar query-running-instance",
  "cmd_name": "query-running-instance",
  "deprecated": false,
  "description_en": "Queries a list of running digital human instances. This operation returns only running instances and does not return closed instances. A maximum of 100 instances are returned in reverse chronological order. You can also query the running status of a specific instance by specifying the SessionId parameter. If the instance is running, its information is returned. If the instance is not running or does not exist, no information is returned",
  "description_zh": "查询运行中的数字人实例列表，该接口仅返回运行中的实例，已关闭的实例不会返回，最多返回100条，按照时间倒序排列；同时支持查询指定sessionId的实例的运行状态，传入sessionId参数，如果该实例在运行中则会返回，不在运行中或者对应实例不存在，则不会返回信息",
  "kebab_example": "aliyun avatar query-running-instance --tenant-id 9185 --app AppId=ALIPUB5748B17121450 --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
