{
  "camel_example": "",
  "cmd_full_name": "avatar query-avatar",
  "cmd_name": "query-avatar",
  "deprecated": false,
  "description_en": "Queries the details of an avatar asset by its code",
  "description_zh": "根据数字人code查询数字人资产详情",
  "kebab_example": "aliyun avatar query-avatar --tenant-id 9185 --code CH_2d_xxxxxx --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "QueryAvatar",
  "operation": {
    "action": "QueryAvatar",
    "api_style": "RPC",
    "api_version": "2022-01-30",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "9185",
      "help_en": "The TenantId obtained from the Digitized Virtual Human Open Platform",
      "help_zh": "从虚拟数字人开放平台中获取的TenantId",
      "location": "query",
      "name": "tenant_id",
      "options": [
        "--tenant-id"
      ],
      "raw_name": "TenantId",
      "required": true,
      "type": "int"
    },
    {
      "example": "CH_2d_xxxxxx",
      "help_en": "The code of the avatar. You can find this code in the asset center of the Open Platform",
      "help_zh": "在开放平台资产中心处查到的数字人形象code",
      "location": "query",
      "name": "code",
      "options": [
        "--code"
      ],
      "raw_name": "Code",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "avatar",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Response schema",
        "description_zh": "Schema of Response",
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The error code returned",
            "description_zh": "返回错误码",
            "example": "10050008",
            "type": "string"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The data returned by the call",
            "description_zh": "调用返回数据",
            "properties": {
              "AllLocateImages": {
                "backendName": "allLocateImages",
                "description_en": "For 3D avatars, this parameter provides thumbnails from all resolutions, camera positions, and angles. It is for customers who build their own Software as a Service (SaaS) platforms using the Platform as a Service (PaaS) APIs of the digital human platform. The value is in JSON format",
                "description_zh": "针对3D数字人的全分辨率、全机位、全角度的人物缩列图，适用于基于数字人平台PAAS API搭建自己的SAAS平台的客户。JSON格式",
                "example": "{}",
                "type": "object"
              },
              "AvatarType": {
                "backendName": "avatarType",
                "description_en": "The avatar type. Valid values:\n\n0: official avatar.\n\n1: custom avatar",
                "description_zh": "人物类型：\n0 官方人物\n1 定制化人物",
                "example": "0",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the avatar",
                "description_zh": "人物描述",
                "example": "朝气蓬勃，富有感染力，适用于播音、传媒广电、企业宣传等场景",
                "type": "string"
              },
              "Image": {
                "backendName": "image",
                "description_en": "The thumbnail of the avatar",
                "description_zh": "人物缩略图",
                "example": "https://virtual-human-assets.oss-cn-beijing.aliyuncs.com/2d_assets/xxx/xxx/xxx.png?Expires=xxx&OSSAccessKeyId=xxx&Signature=xxx",
                "type": "string"
              },
              "MakeFailReason": {
                "backendName": "makeFailReason",
                "description_en": "The reason why the creation of the 2D custom avatar failed. This parameter applies only to queries for 2D avatars",
                "description_zh": "2D自定义人物创建制作失败原因，目前仅针对于2d人物的查询",
                "example": "当前视频时长:6(s)，最小支持180(s)\n",
                "type": "string"
              },
              "MakeStage": {
                "backendName": "makeLargeStage",
                "description_en": "The creation stage of the 2D custom avatar. This parameter applies only to queries for 2D avatars. Valid values:\n\n1: System check\n\n2: Manual review\n\n3: Training\n\n4: Creation successful",
                "description_zh": "2D自定义人物创建制作阶段，目前仅针对于2d人物的查询\n\n1、系统检测\n2、人工审核\n3、训练中\n4、创建成功",
                "example": "1",
                "type": "string"
              },
              "MakeStatus": {
                "backendName": "makeStatus",
                "description_en": "The creation status of the 2D custom avatar. This parameter applies only to queries for 2D avatars. Valid values:\n\n1: Creating\n\n2: Creation failed\n\n3: Creation successful",
                "description_zh": "2D自定义人物创建制作状态，目前仅针对于2d人物的查询\n\n1: 创建中\n2: 创建失败\n3: 创建成功",
                "example": "2",
                "type": "string"
              },
              "ModelType": {
                "backendName": "modelType",
                "description_en": "The model type. Valid values:\n\n2d: queries only 2D avatars.\n\n3d: queries only 3D avatars",
                "description_zh": "模型类型：\n2d 只查询2d人物\n3d 只查询3d人物",
                "example": "2d",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the avatar",
                "description_zh": "人物名称",
                "example": "博远",
                "type": "string"
              },
              "Portrait": {
                "backendName": "portrait",
                "description_en": "The profile picture of the avatar",
                "description_zh": "人物头像",
                "example": "https://virtual-human-assets.oss-cn-beijing.aliyuncs.com/2d_assets/xxx/xxx/xxx.png?Expires=xxx&OSSAccessKeyId=xxx&Signature=xxx",
                "type": "string"
              },
              "Preview": {
                "backendName": "preview",
                "description_en": "The preview video of the 2D avatar",
                "description_zh": "2D人物预览视频",
                "example": "https://xxx/xx/preview.webm",
                "type": "string"
              },
              "SupportedResolutions": {
                "backendName": "supportedResolutions",
                "description_en": "The supported resolutions",
                "description_zh": "支持的分辨率",
                "properties": {
                  "Offline": {
                    "backendName": "offline",
                    "description_en": "The resolutions for offline scenarios",
                    "description_zh": "离线场景分辨率",
                    "itemName": "offline",
                    "items": {
                      "description_en": "The resolution",
                      "description_zh": "分辨率",
                      "properties": {
                        "Desc": {
                          "backendName": "desc",
                          "description_en": "The description of the resolution",
                          "description_zh": "分辨率描述",
                          "example": "1080P竖向，分辨率1080*1920\n",
                          "type": "string"
                        },
                        "Height": {
                          "backendName": "height",
                          "description_en": "The height in pixels (px)",
                          "description_zh": "高度，单位为像素（px）",
                          "example": "1920",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Width": {
                          "backendName": "width",
                          "description_en": "The width in pixels (px)",
                          "description_zh": "宽度，单位为像素（px）",
                          "example": "1080",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "Online": {
                    "backendName": "online",
                    "description_en": "The resolutions for real-time scenarios",
                    "description_zh": "实时场景分辨率",
                    "itemName": "online",
                    "items": {
                      "description_en": "The resolution",
                      "description_zh": "分辨率",
                      "properties": {
                        "Desc": {
                          "backendName": "desc",
                          "description_en": "The description of the resolution",
                          "description_zh": "分辨率描述",
                          "example": "1080P竖向，分辨率1080*1920",
                          "type": "string"
                        },
                        "Height": {
                          "backendName": "height",
                          "description_en": "The height in pixels (px)",
                          "description_zh": "高度，单位为像素（px）",
                          "example": "1920",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Width": {
                          "backendName": "width",
                          "description_en": "The width in pixels (px)",
                          "description_zh": "宽度，单位为像素（px）",
                          "example": "1080",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The error message",
            "description_zh": "错误消息",
            "example": "超过可同时生成的视频数上限",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "4C8BF3A5-948F-1F89-AACD-D18DEF52D1XX",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "是否成功",
            "example": "true",
            "type": "boolean"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
