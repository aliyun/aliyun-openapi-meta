                "sensitive": true,
                "type": "string"
              },
              "timeRange": {
                "backendName": "timeRange",
                "description_en": "The time range of the original request. Valid values: OneDay, OneWeek, OneMonth, OneYear, and NoLimit",
                "description_zh": "原始请求的时间范围，取值为 OneDay、OneWeek、OneMonth、OneYear 或 NoLimit",
                "example": "NoLimit",
