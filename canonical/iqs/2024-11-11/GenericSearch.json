{
  "camel_example": "aliyun iqs GET /linked-retrieval/linked-retrieval-entry/v2/linkedRetrieval/commands/genericSearch --region cn-hangzhou --query '苹果手机' --header \"Content-Type=application/json\"",
  "cmd_full_name": "iqs generic-search",
