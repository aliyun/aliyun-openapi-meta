  "pathPattern": "",
  "product_code": "dms-enterprise",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "DataExportOrderDetail": {
            "backendName": "data.pluginExtraData",
            "description_en": "The information about the data export ticket",
            "description_zh": "SQL结果集导出工单详情信息",
            "nullToEmpty": false,
            "properties": {
              "KeyInfo": {
                "backendName": "keyInfo",
                "description_en": "The status information",
                "description_zh": "状态信息",
                "properties": {
                  "JobId": {
                    "backendName": "jobId",
                    "description_en": "Export task ID",
                    "description_zh": "导出任务ID",
                    "example": "1385****",
                    "format": "int64",
                    "type": "integer"
                  },
                  "JobStatus": {
                    "backendName": "jobStatus",
                    "description_en": "The state of the data export ticket. Valid values:\n\nPRE_CHECKING: The ticket was being prechecked.\nPRE_CHECK_SUCCESS: The ticket passed the precheck.\nPRE_CHECK_FAIL: The ticket failed to pass the prechecked.\nWAITING_APPLY_AUDIT: The ticket was to be submitted for approval.\nAPPLY_AUDIT_SUCCESS: The ticket was submitted for approval.\nENABLE_EXPORT: The ticket was approved. Data can be exported.\nWAITING_EXPORT: Data was to be scheduled for export.\nDOING_EXPORT: Data was being exported.\nEXPORT_FAIL: Data failed to be exported.\nEXPORT_SUCCESS: Data was exported",
                    "description_zh": "导出工单状态，取值如下：\nPRE_CHECKING：执行预校验。\nPRE_CHECK_SUCCESS：预校验成功。\nPRE_CHECK_FAIL：预校验失败。\nWAITING_APPLY_AUDIT：等待提交审批。\nAPPLY_AUDIT_SUCCESS：提交审批成功。\nENABLE_EXPORT：审批通过，允许导出。\nWAITING_EXPORT：等待调度进行导出。\nDOING_EXPORT：执行导出。\nEXPORT_FAIL：导出失败。\nEXPORT_SUCCESS：导出成功",
                    "example": "EXPORT_SUCCESS",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "PreCheckId": {
                    "backendName": "identifier",
                    "description_en": "The precheck ID",
                    "description_zh": "预校验ID",
                    "example": "6393****",
                    "format": "int64",
                    "type": "integer",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "OrderDetail": {
                "backendName": "orderDetail",
                "description_en": "The details of the ticket",
                "description_zh": "工单详情信息",
                "properties": {
                  "ActualAffectRows": {
                    "backendName": "actualAffectRows",
                    "description_en": "The number of rows that were affected by the SQL statement",
                    "description_zh": "系统校验影响的SQL行数",
                    "example": "1",
                    "format": "int64",
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "Classify": {
                    "backendName": "classify",
                    "description_en": "The category of the reason for the data export",
                    "description_zh": "导出工单的原因类别",
                    "example": "text",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Database": {
                    "backendName": "database",
                    "description_en": "The name of the database from which data was exported",
                    "description_zh": "导出的数据库名称",
                    "example": "xxx@xxx:3306",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "DbId": {
                    "backendName": "dbId",
                    "description_en": "The ID of the database from which data was exported",
                    "description_zh": "数据库ID",
                    "example": "3733****",
                    "format": "int32",
                    "type": "integer",
                    "visibility": "Public"
                  },
                  "EnvType": {
                    "backendName": "envType",
                    "description_en": "The type of the environment to which the database belongs",
                    "description_zh": "导出数据库环境信息",
                    "example": "test",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "ExeSQL": {
                    "backendName": "exeSQL",
                    "description_en": "The SQL statement that was executed to export data",
                    "description_zh": "执行的导出SQL语句",
                    "example": "SELECT * FROM DMS_test\n LIMIT 20;",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "IgnoreAffectRows": {
                    "backendName": "ignoreAffectRows",
                    "description_en": "Indicates whether the affected rows are skipped",
                    "description_zh": "是否忽略影响行数",
                    "example": "false",
                    "type": "boolean",
                    "visibility": "Public"
                  },
                  "IgnoreAffectRowsReason": {
                    "backendName": "ignoreAffectRowsReason",
                    "description_en": "The reason why the affected rows are skipped",
                    "description_zh": "忽略校验原因",
                    "example": "empty",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "Logic": {
                    "backendName": "logic",
                    "description_en": "Indicates whether the database is a logical database",
                    "description_zh": "是否为逻辑库",
                    "example": "false",
                    "type": "boolean",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "ErrorCode": {
            "backendName": "errorCode",
            "description_en": "The error code",
            "description_zh": "错误码",
            "example": "UnknownError",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "ErrorMessage": {
            "backendName": "message",
            "description_en": "The error message",
            "description_zh": "错误信息",
            "example": "UnknownError",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "427688B8-ADFB-4C4E-9D45-EF5C1FD6E23D",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful. Valid values: Valid values:\n\ntrue\nfalse",
            "description_zh": "请求是否成功。返回值如下：\n\ntrue：请求成功。\nfalse：请求失败",
            "example": "true",
            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
