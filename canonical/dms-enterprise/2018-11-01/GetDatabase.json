                "type": "string",
                "visibility": "Public"
              },
              "InstanceAlias": {
                "backendName": "alias",
                "description_en": "The alias of the instance",
                "description_zh": "实例别名",
                "example": "test",
                "type": "string"
              },
              "InstanceId": {
                "backendName": "instanceId",
                "description_en": "The instance ID",
                "description_zh": "实例ID",
                "example": "149****",
