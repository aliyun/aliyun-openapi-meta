                },
                "parseType": "null",
                "type": "array",
                "visibility": "Public"
              },
              "OwnerNameList": {
                "backendName": "ownerNames",
                "itemName": "OwnerNames",
                "items": {
                  "backendName": "ownerNames",
                  "type": "string",
                  "visibility": "Public"
                },
                "parseType": "null",
                "type": "array",
                "visibility": "Public"
              },
              "Port": {
                "backendName": "port",
                "description_en": "The port used to connect to the database",
                "description_zh": "数据库连接端口",
                "example": "3306",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "SchemaName": {
                "backendName": "schemaName",
                "description_en": "The schema name",
                "description_zh": "数据库名称",
                "example": "mysql",
                "type": "string",
                "visibility": "Public"
              },
              "SearchName": {
                "backendName": "searchName",
