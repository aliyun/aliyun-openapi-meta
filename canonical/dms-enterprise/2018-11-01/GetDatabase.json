              "State": {
                "backendName": "state",
                "description_en": "The state of the database. Valid values:\n\nNORMAL: The database is running.\n\nDISABLED: The database is disabled.\n\nOFFLINE: The database is offline.\n\nNOT_EXIST: The database does not exist",
                "description_zh": "数据库状态，返回值说明如下：\nNORMAL： 正常。\nDISABLE：禁用。\nOFFLINE：下线。\nNOT_EXIST：不存在",
                "example": "NORMAL",
                "type": "string",
                "visibility": "Public"
