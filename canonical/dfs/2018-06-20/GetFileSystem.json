{
  "camel_example": "aliyun dfs GetFileSystem --region cn-hangzhou --FileSystemId '37af8f42-2abc-4e74-889d-664f5163****' --InputRegionId 'cn-hangzhou' --version 2018-06-20 --method POST --force",
