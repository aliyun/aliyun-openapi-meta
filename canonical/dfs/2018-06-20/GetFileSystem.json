{
  "camel_example": "aliyun dfs GetFileSystem --region cn-hangzhou --FileSystemId '37af8f42-2abc-4e74-889d-664f51630000' --InputRegionId 'cn-hangzhou' --version 2018-06-20 --method POST --force",
  "cmd_full_name": "dfs get-file-system",
