{
  "camel_example": "",
  "cmd_full_name": "dfs get-file-system",
  "cmd_name": "get-file-system",
  "deprecated": false,
  "description_en": "Query file system information",
  "description_zh": "查询文件系统信息",
  "kebab_example": "aliyun dfs get-file-system --file-system-id 37af8f42-2abc-4e74-889d-664f51630000 --input-region-id cn-hangzhou --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetFileSystem",
  "operation": {
    "action": "GetFileSystem",
    "api_style": "RPC",
    "api_version": "2018-06-20",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "37af8f42-2abc-4e74-889d-664f5163****",
      "help_en": "File system ID",
      "help_zh": "文件系统ID",
      "location": "query",
      "name": "file_system_id",
      "options": [
        "--file-system-id"
      ],
      "raw_name": "FileSystemId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "cn-hangzhou",
      "help_en": "Region ID",
      "help_zh": "地域ID",
      "location": "query",
      "name": "input_region_id",
      "options": [
        "--input-region-id"
      ],
      "raw_name": "InputRegionId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "DFS",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "FileSystem": {
            "backendName": "fileSystem",
            "description_en": "Collection of file system information",
            "description_zh": "文件系统信息集合",
            "properties": {
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "Creation Time of the file system",
                "description_zh": "文件系统的创建时间",
                "example": "2022-04-18T06:03:15.836222Z",
                "type": "string",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "description",
                "description_en": "Description of the file system",
                "description_zh": "文件系统的描述信息",
                "example": "这是我公司的第一个文件存储HDFS版实例。",
                "type": "string",
                "visibility": "Public"
              },
              "FileSystemId": {
                "backendName": "fileSystemId",
                "description_en": "File system ID",
                "description_zh": "文件系统ID",
                "example": "37af8f42-2abc-4e74-889d-664f5163****",
                "type": "string",
                "visibility": "Public"
              },
              "FileSystemName": {
                "backendName": "fileSystemName",
                "description_en": "File system name",
                "description_zh": "文件系统名称",
                "example": "MyFirstHDFS",
                "type": "string",
                "visibility": "Public"
              },
              "MeteringSpaceSize": {
                "backendName": "meteringSpaceSize",
                "description_en": "Billable storage usage of the file system. Unit: byte.\n\nBillable storage usage = MAX[(Number of files + Number of folders) × 5 MiB, Used capacity].\n\nThis is statistical data provided for reference only and is not used for billing. Hadoop Distributed File System (HDFS) is billed based on the peak billable storage usage recorded in the previous hour. If you want to query more detailed metering data, see [View Consumption Details]（https://help.aliyun.com/document_detail/419001.html）",
                "description_zh": "文件系统的计费容量。单位：字节（byte）。\n\n计费容量=MAX[（文件数+目录数）*5MiB，使用容量]。\n\n统计数据，不作为计费数据，仅作参考。HDFS按照上一小时计费容量峰值进行计费。若您希望查询更详细的计量数据，请参见[查看消费明细]（https://help.aliyun.com/document_detail/419001.html）",
                "example": "107374182400",
                "format": "float",
                "type": "number"
              },
              "MountPointCount": {
                "backendName": "mountPointCount",
                "description_en": "Number of mount targets",
                "description_zh": "挂载点数量",
                "example": "2",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "NumberOfDirectories": {
                "backendName": "numberOfDirectories",
                "description_en": "Number of folders",
                "description_zh": "目录数量",
                "example": "100",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "NumberOfFiles": {
                "backendName": "numberOfFiles",
                "description_en": "Number of files",
                "description_zh": "文件数量",
                "example": "1000",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "ProtocolType": {
                "backendName": "protocolType",
                "description_en": "Protocol Type.\n\nOnly Hadoop Distributed File System (HDFS) is supported",
                "description_zh": "协议类型。\n\n仅支持HDFS（Hadoop Distributed File System）",
                "example": "HDFS",
                "type": "string",
                "visibility": "Public"
              },
              "ProvisionedThroughputInMiBps": {
                "backendName": "provisionedThroughputInMiBps",
                "description_en": "Preset throughput.\n\nUnit: MB/s",
                "description_zh": "预置吞吐量。\n\n单位：MB/s",
                "example": "1024",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "RegionId": {
                "backendName": "regionId",
                "description_en": "Region ID",
                "description_zh": "地域ID",
                "example": "cn-hangzhou",
                "type": "string",
                "visibility": "Public"
              },
              "SpaceCapacity": {
                "backendName": "spaceCapacity",
                "description_en": "File system capacity.\n\nUnit: GB",
                "description_zh": "文件系统容量。\n\n单位：GB",
                "example": "1024",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "StoragePackageId": {
                "backendName": "storagePackageId",
                "description_en": "Storage plan ID",
                "description_zh": "存储包ID",
                "example": "1",
                "type": "string",
                "visibility": "Public"
              },
              "StorageType": {
                "backendName": "storageType",
                "description_en": "Storage medium type.\n\nIncludes:\n\nSTANDARD: medium\nPERFORMANCE: compute-optimized instance",
                "description_zh": "存储介质类型。\n\n包括：\n\nSTANDARD：标准型\nPERFORMANCE：性能型",
                "example": "STANDARD",
                "type": "string",
                "visibility": "Public"
              },
              "ThroughputMode": {
                "backendName": "throughputMode",
                "description_en": "Throughput pattern.\n\nIncludes:\n\nStandard: standard throughput\nProvisioned: preset throughput",
                "description_zh": "吞吐模式。\n\n包括：\n\nStandard：标准吞吐\nProvisioned：预置吞吐",
                "example": "Standard",
                "type": "string",
                "visibility": "Public"
              },
              "UsedSpaceSize": {
                "backendName": "usedSpaceSize",
                "description_en": "Used bucket space.\n\nUnit: GB",
                "description_zh": "已使用存储空间。\n\n单位：GB",
                "example": "100",
                "format": "float",
                "type": "number",
                "visibility": "Public"
              },
              "Version": {
                "backendName": "version",
                "description_en": "Version of Apsara File Storage for HDFS, not the Hadoop version",
                "description_zh": "阿里云文件存储 HDFS 版的版本，非hadoop版本",
                "example": "1.0.0",
                "type": "string"
              },
              "ZoneId": {
                "backendName": "zoneId",
                "description_en": "Zone ID",
                "description_zh": "可用区ID",
                "example": "cn-hangzhou-b",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "55C5FFD6-BF99-41BD-9C66-FFF39189****",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
