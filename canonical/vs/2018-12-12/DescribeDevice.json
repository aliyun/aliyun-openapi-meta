{
  "camel_example": "",
  "cmd_full_name": "vs describe-device",
  "cmd_name": "describe-device",
  "deprecated": false,
  "description_en": "Query information about a device",
  "description_zh": "查询设备信息",
  "kebab_example": "aliyun vs describe-device --id 32388480000092996-cn-qingdao --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeDevice",
  "operation": {
    "action": "DescribeDevice",
    "api_style": "RPC",
    "api_version": "2018-12-12",
    "method": "POST",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "3238848****092996-cn-qingdao",
      "help_en": "Device ID",
      "help_zh": "设备ID",
      "location": "query",
      "name": "id",
      "options": [
        "--id"
      ],
      "raw_name": "Id",
      "required": true,
      "type": "string"
    },
    {
      "example": "false",
      "help_en": "Return stream statistics. Default value: false",
      "help_zh": "是否返回流统计信息，默认值：false",
      "location": "query",
      "name": "include_stats",
      "options": [
        "--include-stats"
      ],
      "raw_name": "IncludeStats",
      "required": false,
      "type": "bool"
    },
    {
      "example": "false",
      "help_en": "Return directory information. Default value: false",
      "help_zh": "是否返回目录信息，默认值：false",
      "location": "query",
      "name": "include_directory",
      "options": [
        "--include-directory"
      ],
      "raw_name": "IncludeDirectory",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "vs",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "AlarmMethod": {
            "backendName": "data.content.alarmMethod",
            "description_en": "Subscribed GB alarm method. Valid values:\n\n0 (all)\n\n5 (video alarm)\n\n7 (other alarms)\n\nAn empty value means no subscription.\n\nMultiple values are supported, separated by commas (,)",
            "description_zh": "订阅的国标报警方式。取值范围：\n0（全部）\n5（视频报警）\n7（其他报警）\n空值表示不订阅。\n支持多个，用英文逗号（,）分隔",
            "example": "5",
            "type": "string"
          },
          "AutoPos": {
            "backendName": "data.content.autoPos",
            "description_en": "Indicates whether device location subscription is enabled",
            "description_zh": "是否启用设备位置订阅",
            "example": "false",
            "type": "boolean"
          },
          "AutoStart": {
            "backendName": "data.content.autoStart",
            "description_en": "Automatically start the stream",
            "description_zh": "是否自动启动流",
            "example": "false",
            "type": "boolean"
          },
          "ChannelSyncTime": {
            "backendName": "data.content.channelSyncTime",
            "description_en": "Channel synchronization time",
            "description_zh": "通道同步时间",
            "example": "2019-02-28T17:01:17Z",
            "type": "string"
          },
          "CreatedTime": {
            "backendName": "data.content.createdTime",
            "description_en": "Device creation time",
            "description_zh": "设备创建时间",
            "example": "2019-02-28T17:00:17Z",
            "type": "string"
          },
          "Description": {
            "backendName": "data.content.description",
            "description_en": "Device description",
            "description_zh": "设备描述",
            "example": "xxx路口摄像头",
            "type": "string"
          },
          "Directory": {
            "backendName": "data.content.directory",
            "description_en": "Directory information",
            "description_zh": "目录信息",
            "properties": {
              "CreatedTime": {
                "backendName": "createdTime",
                "description_en": "Directory creation time",
                "description_zh": "目录创建时间",
                "example": "2019-02-28T17:00:17Z",
                "type": "string"
              },
              "Description": {
                "backendName": "description",
                "description_en": "Directory description",
                "description_zh": "目录描述",
                "example": "目录1",
                "type": "string"
              },
              "GroupId": {
                "backendName": "groupId",
                "description_en": "Space ID to which the directory belongs",
                "description_zh": "目录所属空间ID",
                "example": "3238848****092994-cn-qingdao",
                "type": "string"
              },
              "Id": {
                "backendName": "id",
                "description_en": "Directory ID",
                "description_zh": "目录ID",
                "example": "3238848****092994-cn-qingdao",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "Directory name",
                "description_zh": "目录名称",
                "example": "目录1",
                "type": "string"
              },
              "ParentId": {
                "backendName": "parentId",
                "description_en": "Parent directory ID",
                "description_zh": "上级目录ID",
                "example": "3238848****092995-cn-qingdao",
                "type": "string"
              }
            },
            "type": "object"
          },
          "DirectoryId": {
            "backendName": "data.content.directoryId",
            "description_en": "Directory ID",
            "description_zh": "目录ID",
            "example": "3238848****092994-cn-qingdao",
            "type": "string"
          },
          "Dsn": {
            "backendName": "data.content.dsn",
            "description_en": "Device serial number",
            "description_zh": "设备序列号",
            "example": "7D0*****4C0",
            "type": "string"
          },
          "Enabled": {
            "backendName": "data.content.enabled",
            "description_en": "Whether the device is enabled",
            "description_zh": "设备是否启用",
            "example": "true",
            "type": "boolean"
          },
          "GbId": {
            "backendName": "data.content.gbId",
            "description_en": "GB device ID.\n\nThis applies only to GB protocols",
            "description_zh": "设备国标ID。\n仅适用于国标协议",
            "example": "31000000****00000002",
            "type": "string"
          },
          "GroupId": {
            "backendName": "data.content.groupId",
            "description_en": "Space ID to which the device belongs",
            "description_zh": "设备所属空间ID",
            "example": "3238848****092994-cn-qingdao",
            "type": "string"
          },
          "Id": {
            "backendName": "data.content.id",
            "description_en": "Device ID",
            "description_zh": "设备ID",
            "example": "3238848****092996-cn-qingdao",
            "type": "string"
          },
          "Ip": {
            "backendName": "data.content.ip",
            "description_en": "Device IP address",
            "description_zh": "设备IP",
            "example": "10.10.10.10",
            "type": "string"
          },
          "Latitude": {
            "backendName": "data.content.latitude",
            "description_en": "Device latitude",
            "description_zh": "设备维度",
            "example": "119.20",
            "type": "string"
          },
          "Longitude": {
            "backendName": "data.content.longitude",
            "description_en": "Device longitude",
            "description_zh": "设备经度",
            "example": "45.00",
            "type": "string"
          },
          "Name": {
            "backendName": "data.content.name",
            "description_en": "Device name",
            "description_zh": "设备名称",
            "example": "xxx路口摄像头",
            "type": "string"
          },
          "Params": {
            "backendName": "data.content.params",
            "description_en": "Other device parameters",
            "description_zh": "设备其他参数",
            "example": "{}",
            "type": "string"
          },
          "ParentId": {
            "backendName": "data.content.parentId",
            "description_en": "Parent device ID. For example, the platform ID to which a camera belongs",
            "description_zh": "上级设备ID，比如：摄像头所属的平台ID",
            "example": "3238848****092995-cn-qingdao",
            "type": "string"
          },
          "Password": {
            "backendName": "data.content.password",
            "description_en": "Device password",
            "description_zh": "设备密码",
            "example": "admin",
            "type": "string"
          },
          "Port": {
            "backendName": "data.content.port",
            "description_en": "Device port",
            "description_zh": "设备端口",
            "example": "8080",
            "format": "int64",
            "type": "integer"
          },
          "PosInterval": {
            "backendName": "data.content.posInterval",
            "description_en": "Position subscription interval, in seconds",
            "description_zh": "位置订阅周期，单位：秒",
            "example": "300",
            "format": "int64",
            "type": "integer"
          },
          "Protocol": {
            "backendName": "data.content.protocol",
            "description_en": "Device registration protocol",
            "description_zh": "设备注册协议",
            "example": "gb28181",
            "type": "string"
          },
          "RegisteredTime": {
            "backendName": "data.content.registeredTime",
            "description_en": "Device registration time",
            "description_zh": "设备注册时间",
            "example": "2019-02-28T17:00:17Z",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "BEA5625F-8FCF-48F4-851B-CA63946DA664",
            "type": "string"
          },
          "Stats": {
            "backendName": "data.content.stats",
            "description_en": "Device stream statistics",
            "description_zh": "设备流统计信息",
            "properties": {
              "ChannelNum": {
                "backendName": "channelNum",
                "description_en": "Number of channels",
                "description_zh": "通道数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "FailedNum": {
                "backendName": "failedNum",
                "description_en": "Number of failed streams",
                "description_zh": "失败流数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "OfflineNum": {
                "backendName": "offlineNum",
                "description_en": "Number of offline streams",
                "description_zh": "离线流数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "OnlineNum": {
                "backendName": "onlineNum",
                "description_en": "Number of online streams",
                "description_zh": "在线流数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "StreamNum": {
                "backendName": "streamNum",
                "description_en": "Number of streams",
                "description_zh": "流数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "Status": {
            "backendName": "data.content.status",
            "description_en": "Device status. Valid values:\n\non (online)\n\noff (offline)\n\nfailed (locked)\n\nnew (unregistered)",
            "description_zh": "设备状态。取值范围：\non（在线）\noff（离线）\nfailed（锁定）\nnew（未注册）",
            "example": "on",
            "type": "string"
          },
          "Type": {
            "backendName": "data.content.type",
            "description_en": "Device type. Valid values:\n\nipc (camera)\n\nplatform (platform)\n\nied (intelligent device)",
            "description_zh": "设备类型。取值范围：\nipc（摄像头）\nplatform（平台）\nied（智能设备）",
            "example": "ipc",
            "type": "string"
          },
          "Url": {
            "backendName": "data.content.url",
            "description_en": "Stream URL on the device",
            "description_zh": "设备上的流URL",
            "example": "rtmp://xxx/xxx",
            "type": "string"
          },
          "Username": {
            "backendName": "data.content.username",
            "description_en": "Device username",
            "description_zh": "设备用户名",
            "example": "admin",
            "type": "string"
          },
          "Vendor": {
            "backendName": "data.content.vendor",
            "description_en": "Device vendor",
            "description_zh": "设备厂商",
            "example": "公司A",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
