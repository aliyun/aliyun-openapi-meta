  "kebab_example": "aliyun vs describe-vs-top-domains-by-flow --start-time 2021-12-12T10:00:00Z --end-time 2018-12-10T18:00:00Z --limit 3 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
