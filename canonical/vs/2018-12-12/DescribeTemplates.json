                  "backendName": "ossEndpoint",
                  "description_en": "OSS domain name",
                  "description_zh": "OSS的域名",
                  "example": "oss-cn-qingdao.aliyuncs.com",
                  "type": "string"
                },
                "OssFilePrefix": {
                  "backendName": "ossFilePrefix",
                  "description_en": "OSS file prefix",
                  "description_zh": "OSS文件前缀",
                  "example": "my_prefix",
                  "type": "string"
                },
