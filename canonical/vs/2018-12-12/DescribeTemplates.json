                    "properties": {
                      "Fps": {
                        "backendName": "fps",
                        "description_en": "Video frame rate in fps",
                        "description_zh": "视频帧率，单位：fps",
                        "example": "25",
                        "format": "int64",
                        "type": "integer"
                      },
                      "Gop": {
                        "backendName": "gop",
                        "description_en": "Video GOP in frames",
                        "description_zh": "视频Gop，单位：帧",
                        "example": "50",
                        "format": "int64",
                        "type": "integer"
                      },
                      "Height": {
                        "backendName": "height",
                        "description_en": "Video height",
                        "description_zh": "视频高度",
                        "example": "720",
                        "format": "int64",
                        "type": "integer"
                      },
                      "Name": {
                        "backendName": "name",
                        "description_en": "Transcoding rule name. This name becomes the suffix of the transcoded stream. Use a descriptive suffix such as sd or 200k. Only letters and numbers are allowed",
                        "description_zh": "转码规则名称，转码规则名称将作为转码流后缀，建议按使用习惯设置为sd，200k等易辨识后缀，只支持数字和字母",
                        "example": "sd",
                        "type": "string"
                      },
                      "VideoBitrate": {
                        "backendName": "videoBitrate",
                        "description_en": "Video bitrate in kbps",
                        "description_zh": "视频比特率，单位：kbps",
                        "example": "800",
                        "format": "int64",
                        "type": "integer"
                      },
                      "VideoCodec": {
                        "backendName": "videoCodec",
                        "description_en": "Video encoding",
                        "description_zh": "视频编码",
                        "example": "h264",
                        "type": "string"
                      },
                      "Width": {
                        "backendName": "width",
                        "description_en": "Video width",
                        "description_zh": "视频宽度",
                        "example": "1280",
                        "format": "int64",
                        "type": "integer"
                      },
                      "id": {
                        "backendName": "id",
                        "description_en": "Transcoding configuration ID",
                        "description_zh": "转码配置ID",
                        "example": "399788187729597430-cn-qingdao",
                        "type": "string"
                      }
                    },
                    "type": "object"
