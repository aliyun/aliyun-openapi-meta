                  "type": "string"
                },
                "Type": {
                  "backendName": "type",
                  "description_en": "Template type. Valid values:\n\nrecord (recording)\n\nsnapshot (snapshot)\n\ntranscode (transcoding)\n\ntimeshift (time shifting)",
                  "description_zh": "模板类型。取值：\nrecord（录制）\nsnapshot（截图）\ntranscode（转码）\ntimeshift（时移）",
                  "example": "record",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "TotalCount": {
            "backendName": "data.content.totalCount",
            "description_en": "Total number of templates",
            "description_zh": "模板总数",
            "example": "100",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
