                  "example": "osspath/snapshot/{AppName}/{StreamName}/{UnixTimestamp}_ondemand.jpg",
                  "type": "string"
                },
                "JpgOverwrite": {
                  "backendName": "jpgOverwrite",
                  "description_en": "JPG storage path for overwrite snapshots.\n\nThis applies only to snapshot templates",
                  "description_zh": "JPG的存储路径，用于覆盖截图。\n仅限截图模板",
