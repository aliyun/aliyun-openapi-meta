                  "example": "2019-02-28T17:00:17Z",
                  "type": "string"
                },
                "Stats": {
                  "backendName": "stats",
                  "description_en": "The stream statistics information of the device",
                  "description_zh": "设备流统计信息",
                  "properties": {
                    "ChannelNum": {
                      "backendName": "channelNum",
                      "description_en": "The number of channels",
                      "description_zh": "通道数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "FailedNum": {
                      "backendName": "failedNum",
                      "description_en": "The number of failed streams",
                      "description_zh": "失败流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "OfflineNum": {
                      "backendName": "offlineNum",
                      "description_en": "The number of offline streams",
                      "description_zh": "离线流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "OnlineNum": {
                      "backendName": "onlineNum",
                      "description_en": "The number of online streams",
                      "description_zh": "在线流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "StreamNum": {
                      "backendName": "streamNum",
                      "description_en": "The number of streams",
                      "description_zh": "流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The device status. Valid values:\non: Online.\noff: Offline.\nfailed: Locked.\nnew: Unregistered",
                  "description_zh": "设备状态。取值范围：\non（在线）\noff（离线）\nfailed（锁定）\nnew（未注册）",
                  "example": "on",
                  "type": "string"
                },
                "Type": {
                  "backendName": "type",
                  "description_en": "The device type. Valid values:\nipc: Camera.\nplatform: Platform.\nied: Intelligent device",
                  "description_zh": "设备类型。取值范围：\nipc（摄像头）\nplatform（平台）\nied（智能设备）",
                  "example": "ipc",
                  "type": "string"
                },
                "Url": {
                  "backendName": "url",
                  "description_en": "The stream URL on the device",
                  "description_zh": "设备上的流URL",
                  "example": "rtmp://xxx/xxx",
                  "type": "string"
                },
                "Username": {
                  "backendName": "username",
                  "description_en": "The device username",
                  "description_zh": "设备用户名",
                  "example": "admin",
                  "type": "string"
                },
                "Vendor": {
                  "backendName": "vendor",
                  "description_en": "The device vendor",
                  "description_zh": "设备厂商",
                  "example": "公司A",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "PageCount": {
            "backendName": "data.content.pageCount",
            "description_en": "The total number of pages",
            "description_zh": "分页总数",
            "example": "5",
            "format": "int64",
            "type": "integer"
          },
          "PageNum": {
            "backendName": "data.content.pageNum",
            "description_en": "The page number",
            "description_zh": "第几个分页",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "PageSize": {
            "backendName": "data.content.pageSize",
            "description_en": "The number of entries per page",
            "description_zh": "分页大小",
            "example": "20",
            "format": "int64",
            "type": "integer"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "BEA5625F-8FCF-48F4-851B-CA63946DA664",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.content.totalCount",
            "description_en": "The total number of devices",
            "description_zh": "设备总数",
            "example": "77",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
