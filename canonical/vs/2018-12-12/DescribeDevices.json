                    "CreatedTime": {
                      "backendName": "createdTime",
                      "description_en": "The time when the directory was created. The time is displayed in UTC and follows the ISO 8601 standard in the YYYY-MM-DDTHH:mm:ssZ format",
                      "description_zh": "目录创建时间，采用 ISO 8601 标准的 UTC 时间，格式为 YYYY-MM-DDTHH:mm:ssZ",
                      "example": "2019-02-28T17:00:17Z",
                      "type": "string"
                    },
                    "Description": {
                      "backendName": "description",
                      "description_en": "The directory description",
