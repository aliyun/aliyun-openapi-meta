                  "example": "3238848****092995",
                  "type": "string"
                },
                "Password": {
                  "backendName": "password",
                  "description_en": "The device password",
                  "description_zh": "设备密码",
                  "example": "admin",
                  "type": "string"
                },
                "Port": {
                  "backendName": "port",
                  "description_en": "The device port",
                  "description_zh": "设备端口",
                  "example": "8080",
