                      "description_zh": "目录ID",
                      "example": "399*****488-cn-qingdao",
                      "type": "string"
                    },
                    "Name": {
                      "backendName": "name",
                      "description_en": "The directory name",
                      "description_zh": "目录名称",
                      "example": "目录1",
                      "type": "string"
                    },
                    "ParentId": {
                      "backendName": "parentId",
                      "description_en": "The ID of the parent directory",
                      "description_zh": "上级目录ID",
                      "example": "399*****774-cn-qingdao",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "DirectoryId": {
                  "backendName": "directoryId",
                  "description_en": "The directory ID",
                  "description_zh": "目录ID",
                  "example": "399*****488-cn-qingdao",
