                  "description_zh": "设备国标ID。\n仅适用于国标协议",
                  "example": "310000000****0000002",
                  "type": "string"
                },
                "GroupId": {
                  "backendName": "groupId",
                  "description_en": "The ID of the workspace to which the device belongs",
                  "description_zh": "设备所属空间ID",
                  "example": "348*****174-cn-qingdao",
                  "type": "string"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "The device ID",
                  "description_zh": "设备ID",
                  "example": "348*****380-cn-qingdao",
                  "type": "string"
                },
                "Ip": {
                  "backendName": "ip",
                  "description_en": "The IP address of the device",
                  "description_zh": "设备IP",
                  "example": "10.10.10.10",
                  "type": "string"
                },
                "Latitude": {
                  "backendName": "latitude",
                  "description_en": "The latitude of the device",
                  "description_zh": "设备维度",
                  "example": "119.20",
                  "type": "string"
                },
                "Longitude": {
                  "backendName": "longitude",
                  "description_en": "The longitude of the device",
                  "description_zh": "设备经度",
                  "example": "45.00",
                  "type": "string"
                },
                "Name": {
                  "backendName": "name",
                  "description_en": "The device name",
                  "description_zh": "设备名称",
                  "example": "xxx路口摄像头",
                  "type": "string"
                },
