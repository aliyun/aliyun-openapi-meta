        "properties": {
          "Devices": {
            "backendName": "data.content.devices",
            "description_en": "The list of devices",
            "description_zh": "设备列表",
            "itemName": "Device",
            "items": {
              "properties": {
                "AlarmMethod": {
                  "backendName": "alarmMethod",
                  "description_en": "The subscribed national standard alarm methods. Valid values:\n0: All.\n5: Video alarm.\n7: Other alarms.\nAn empty value indicates no subscription. You can specify multiple values separated by commas (,)",
                  "description_zh": "订阅的国标报警方式。取值范围：\n0（全部）\n5（视频报警）\n7（其他报警）\n空值表示不订阅。\n支持多个，用英文逗号（,）分隔",
                  "example": "0",
                  "type": "string"
                },
                "AutoDirectory": {
                  "backendName": "autoDirectory",
                  "description_en": "Specifies whether to enable directory reporting for platform devices",
                  "description_zh": "是否启用平台设备的目录上报",
                  "example": "true",
                  "type": "boolean"
                },
                "AutoPos": {
                  "backendName": "autoPos",
                  "description_en": "Specifies whether to enable device position subscription",
                  "description_zh": "是否启用设备位置订阅",
                  "example": "false",
                  "type": "boolean"
                },
                "AutoStart": {
                  "backendName": "autoStart",
                  "description_en": "Specifies whether to automatically start the stream",
                  "description_zh": "是否自动启动流",
                  "example": "false",
                  "type": "boolean"
                },
