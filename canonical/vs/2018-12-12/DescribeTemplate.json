{
  "camel_example": "",
  "cmd_full_name": "vs describe-template",
  "cmd_name": "describe-template",
  "deprecated": false,
  "description_en": "Query information about a template",
  "description_zh": "查询模板信息",
  "kebab_example": "aliyun vs describe-template --id 32300000998-cn-qingdao --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeTemplate",
  "operation": {
    "action": "DescribeTemplate",
    "api_style": "RPC",
    "api_version": "2018-12-12",
    "method": "POST",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "323*****998-cn-qingdao",
      "help_en": "Template ID",
      "help_zh": "模板ID",
      "location": "query",
      "name": "id",
      "options": [
        "--id"
      ],
      "raw_name": "Id",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "vs",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Callback": {
            "backendName": "data.content.callback",
            "description_en": "Callback URL triggered after template execution",
            "description_zh": "模板执行后的回调",
            "example": "http://example.com/callback",
            "type": "string"
          },
          "CreatedTime": {
            "backendName": "data.content.createdTime",
            "description_en": "Template creation time",
            "description_zh": "模板创建时间",
            "example": "2020-12-10T10:00:00Z",
            "type": "string"
          },
          "Description": {
            "backendName": "data.content.description",
            "description_en": "Template description",
            "description_zh": "模板描述",
            "example": "录制模板",
            "type": "string"
          },
          "FileFormat": {
            "backendName": "data.content.fileFormat",
            "description_en": "Storage file format. Separate multiple values with commas. Valid values: mp4, flv, hls, jpg",
            "description_zh": "存储文件格式，多值用逗号分隔。取值：mp4,flv,hls,jpg",
            "example": "hls",
            "type": "string"
          },
          "Flv": {
            "backendName": "data.content.flv",
            "description_en": "Storage path for FLV files.\n\nApplies only to recording templates",
            "description_zh": "FLV的存储路径。\n仅限录制模板",
            "example": "osspath/record/{StreamName}/{EscapedStartTime}_{EscapedEndTime}",
            "type": "string"
          },
          "HlsM3u8": {
            "backendName": "data.content.hlsM3u8",
            "description_en": "Storage path for HLS .m3u8 files.\n\nApplies only to recording templates",
            "description_zh": "HLS的存储路径，m3u8文件。\n仅限录制模板",
            "example": "osspath/record/{StreamName}/{EscapedStartTime}_{EscapedEndTime}",
            "type": "string"
          },
          "HlsTs": {
            "backendName": "data.content.hlsTs",
            "description_en": "Storage path for HLS .ts files.\n\nApplies only to recording templates",
            "description_zh": "HLS的存储路径，ts文件。\n仅限录制模板",
            "example": "osspath/record/{StreamName}/{UnixTimestamp}_{Sequence}",
            "type": "string"
          },
          "Id": {
            "backendName": "data.content.id",
            "description_en": "Template ID",
            "description_zh": "模板ID",
            "example": "323*****998-cn-qingdao",
            "type": "string"
          },
          "Interval": {
            "backendName": "data.content.interval",
            "description_en": "Operation interval, in seconds",
            "description_zh": "操作周期，单位：秒",
            "example": "3600",
            "format": "int64",
            "type": "integer"
          },
          "JpgOnDemand": {
            "backendName": "data.content.jpgOnDemand",
            "description_en": "Storage path for JPG files used for on-demand snapshots.\n\nApplies only to snapshot templates",
            "description_zh": "JPG的存储路径，用于按需截图。\n仅限截图模板",
            "example": "osspath/snapshot/{AppName}/{StreamName}/{UnixTimestamp}_ondemand.jpg",
            "type": "string"
          },
          "JpgOverwrite": {
            "backendName": "data.content.jpgOverwrite",
            "description_en": "Storage path for JPG files used to overwrite snapshots.\n\nApplies only to snapshot templates",
            "description_zh": "JPG的存储路径，用于覆盖截图。\n仅限截图模板",
            "example": "osspath/snapshot/{AppName}/{StreamName}.jpg",
            "type": "string"
          },
          "JpgSequence": {
            "backendName": "data.content.jpgSequence",
            "description_en": "Storage path for JPG files used for sequential snapshots.\n\nApplies only to snapshot templates",
            "description_zh": "JPG的存储路径，用于序列截图。\n仅限截图模板",
            "example": "osspath/snapshot/{AppName}/{StreamName}/{UnixTimestamp}.jpg",
            "type": "string"
          },
          "Mp4": {
            "backendName": "data.content.mp4",
            "description_en": "Storage path for MP4 files.\n\nApplies only to recording templates",
            "description_zh": "MP4的存储路径。\n仅限录制模板",
            "example": "osspath/record/{StreamName}/{EscapedStartTime}_{EscapedEndTime}",
            "type": "string"
          },
          "Name": {
            "backendName": "data.content.name",
            "description_en": "Template name",
            "description_zh": "模板名称",
            "example": "录制模板",
            "type": "string"
          },
          "OssBucket": {
            "backendName": "data.content.ossBucket",
            "description_en": "OSS bucket",
            "description_zh": "OSS的Bucket",
            "example": "my_oss_bucket",
            "type": "string"
          },
          "OssEndpoint": {
            "backendName": "data.content.ossEndpoint",
            "description_en": "OSS domain name",
            "description_zh": "OSS的域名",
            "example": "oss-cn-qingdao.aliyuncs.com",
            "type": "string"
          },
          "OssFilePrefix": {
            "backendName": "data.content.ossFilePrefix",
            "description_en": "OSS file prefix",
            "description_zh": "OSS文件前缀",
            "example": "oss-prefix",
            "type": "string"
          },
          "Region": {
            "backendName": "data.content.region",
            "description_en": "OSS region, which is the service center",
            "description_zh": "OSS所属区域，即服务中心",
            "example": "cn-qingdao",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "BEA5625F-8FCF-48F4-851B-CA63946DA664",
            "type": "string"
          },
          "Retention": {
            "backendName": "data.content.retention",
            "description_en": "Timeshift retention period, in days.\n\nApplies only to timeshift templates",
            "description_zh": "时移保存周期，单位：天\n仅限时移模板",
            "example": "3",
            "format": "int64",
            "type": "integer"
          },
          "TransConfigs": {
            "backendName": "data.content.transConfigs",
            "description_en": "List of transcoding configurations.\n\nApplies only to transcoding templates",
            "description_zh": "转码配置列表。\n仅限转码模板",
            "itemName": "TransConfig",
            "items": {
              "properties": {
                "Fps": {
                  "backendName": "fps",
                  "description_en": "Video frame rate, in fps",
                  "description_zh": "视频帧率，单位：fps",
                  "example": "25",
                  "format": "int64",
                  "type": "integer"
                },
                "Gop": {
                  "backendName": "gop",
                  "description_en": "Video GOP, in frames",
                  "description_zh": "视频Gop，单位：帧",
                  "example": "50",
                  "format": "int64",
                  "type": "integer"
                },
                "Height": {
                  "backendName": "height",
                  "description_en": "Video height",
                  "description_zh": "视频高度",
                  "example": "720",
                  "format": "int64",
                  "type": "integer"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "Transcoding configuration ID",
                  "description_zh": "转码配置ID",
                  "example": "399*****430-cn-qingdao",
                  "type": "string"
                },
                "Name": {
                  "backendName": "name",
                  "description_en": "Transcoding rule name. The name appears as a suffix in the transcoded stream. We recommend using recognizable suffixes such as sd or 200k. Only letters and digits are supported",
                  "description_zh": "转码规则名称，转码规则名称将作为转码流后缀，建议按使用习惯设置为sd，200k等易辨识后缀，只支持数字和字母",
                  "example": "sd",
                  "type": "string"
                },
                "VideoBitrate": {
                  "backendName": "videoBitrate",
                  "description_en": "Video bitrate, in kbps",
                  "description_zh": "视频比特率，单位：kbps",
                  "example": "800",
                  "format": "int64",
                  "type": "integer"
                },
                "VideoCodec": {
                  "backendName": "videoCodec",
                  "description_en": "Video encoding",
                  "description_zh": "视频编码",
                  "example": "h264",
                  "type": "string"
                },
                "Width": {
                  "backendName": "width",
                  "description_en": "Video width",
                  "description_zh": "视频宽度",
                  "example": "1280",
                  "format": "int64",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "Trigger": {
            "backendName": "data.content.trigger",
            "description_en": "Template trigger type. Valid values:\n\nauto\n\nondemand\n\nApplies only to recording templates",
            "description_zh": "模板触发类型。取值：\nauto（自动）\nondemand（按需）\n仅限录制模板",
            "example": "auto",
            "type": "string"
          },
          "Type": {
            "backendName": "data.content.type",
            "description_en": "Template type. Valid values:\n\nrecord\n\nsnapshot\n\ntranscode\n\ntimeshift",
            "description_zh": "模板类型。取值：\nrecord（录制）\nsnapshot（截图）\ntranscode（转码）\ntimeshift（时移）",
            "example": "record",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
