{
  "camel_example": "aliyun kms ListClientKeys --region cn-hangzhou --AapName aap_test",
  "cmd_full_name": "kms list-client-keys",
  "cmd_name": "list-client-keys",
  "deprecated": false,
  "description_en": "Queries all client keys within an AAP",
  "description_zh": "查询应用身份凭证（ClientKey）列表",
  "kebab_example": "aliyun kms list-client-keys --aap-name aap_test --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListClientKeys",
  "operation": {
    "action": "ListClientKeys",
    "api_style": "RPC",
    "api_version": "2016-01-20",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "aap_test",
      "help_en": "The name of the application access point (AAP)",
      "help_zh": "应用接入点名称",
      "location": "query",
      "name": "aap_name",
      "options": [
        "--aap-name"
      ],
      "raw_name": "AapName",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Kms",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ClientKeys": {
            "description_en": "A list of client keys",
            "description_zh": "ClientKey列表",
            "items": {
              "description_en": "A list of client keys",
              "description_zh": "ClientKey列表",
              "properties": {
                "AapName": {
                  "description_en": "The name of the AAP",
                  "description_zh": "绑定的应用接入点名称",
                  "example": "aap_test",
                  "type": "string"
                },
                "ClientKeyId": {
                  "description_en": "The ID of the client key",
                  "description_zh": "ClientKey的ID",
                  "example": "KAAP.66abf237-63f6-4625-b8cf-47e1086e****",
                  "type": "string"
                },
                "CreateTime": {
                  "description_en": "The time when the client key was created",
                  "description_zh": "ClientKey的创建时间",
                  "example": "2023-08-31T09:14:38Z",
                  "type": "string"
                },
                "KeyAlgorithm": {
                  "description_en": "The private key algorithm of the client key",
                  "description_zh": "ClientKey的私钥算法",
                  "example": "RSA_2048",
                  "type": "string"
                },
                "KeyOrigin": {
                  "description_en": "The provider of the client key.\n\nCurrently, only KMS is supported. The value is fixed as KMS_PROVIDED",
                  "description_zh": "ClientKey由谁生成。\n\n目前仅支持由KMS生成，取值为KMS_PROVIDED",
                  "example": "KMS_PROVIDED",
                  "type": "string"
                },
                "NotAfter": {
                  "description_en": "The end of the validity period of the client key",
                  "description_zh": "ClientKey的有效期结束时间",
                  "example": "2028-08-31T17:14:33Z",
                  "type": "string"
                },
                "NotBefore": {
                  "description_en": "The beginning of the validity period of the client key",
                  "description_zh": "ClientKey的有效期起始时间",
                  "example": "2023-08-31T17:14:33Z",
                  "type": "string"
                },
                "PublicKeyData": {
                  "description_en": "The public key of the client key",
                  "description_zh": "ClientKey的公钥内容",
                  "example": "-----BEGIN CERTIFICATE-----\\nMIIDcjCCAlqgAwIBAgIQT/sAVRxwYp54mrw****-----END CERTIFICATE-----",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "本次调用请求的ID，是由阿里云为该请求生成的唯一标识符，可用于排查和定位问题",
            "example": "2312e45f-b2fa-4c34-ad94-3eca50932916",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
