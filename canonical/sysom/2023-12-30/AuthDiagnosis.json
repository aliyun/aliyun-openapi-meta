  "cmd_name": "auth-diagnosis",
  "deprecated": false,
  "description_en": "Authorizes SysOM to diagnose ECS instances under the current account. You must call this operation to authorize diagnosis on a specific ECS instance before you can call the InvokeDiagnosis operation to initiate diagnosis on it",
