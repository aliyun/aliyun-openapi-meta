  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "AccessDeniedDetail": {
            "backendName": "accessDeniedDetail",
            "description_en": "The details of the access denial. An empty string is returned if you have sufficient permissions",
            "description_zh": "无权限错误详细信息。如果有权限，则返回空字符串",
            "example": "{\\\"AuthAction\\\":\\\"ram:GetTicket\\\",\\\"AuthPrincipalDisplayName\\\":\\\"2146216584788xxxxx\\\",\\\"AuthPrincipalOwnerId\\\":\\\"1135850448xxxxx\\\",\\\"AuthPrincipalType\\\":\\\"SubUser\\\",\\\"NoPermissionType\\\":\\\"ImplicitDeny\\\",\\\"PolicyType\\\":\\\"AccountLevelIdentityBasedPolicy\\\"}",
            "type": "string"
          },
          "Code": {
            "backendName": "code",
            "description_en": "The response code",
            "description_zh": "接口请求结果返回码",
            "example": "0",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The data returned on success",
            "description_zh": "接口调用成功后，返回的业务数据",
            "properties": {
              "CategoryId": {
                "backendName": "categoryId",
                "description_en": "The ID of the ticket category",
                "description_zh": "工单问题分类ID",
                "example": "7161",
                "type": "string"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The UNIX timestamp when the ticket was created",
                "description_zh": "工单创建时间的时间戳",
                "example": "1623396736000",
                "format": "int64",
                "type": "integer"
              },
              "CreatorId": {
                "backendName": "creatorId",
                "description_en": "The UID of the user who created the ticket",
                "description_zh": "工单创建人uid",
                "example": "1168025",
                "type": "string"
              },
              "Description": {
                "backendName": "firstDescription",
                "description_en": "The description of the ticket. Only plain text is supported",
                "description_zh": "工单问题描述, 目前只支持纯文本格式",
                "example": "Why ECS renewal failed?",
                "type": "string"
              },
              "Severity": {
                "backendName": "severity",
                "description_en": "The severity level. A value of 1 indicates a common issue. A value of 2 indicates an urgent issue",
                "description_zh": "紧急度枚举值, 1 代表一般问题, 2 代表紧急问题",
                "properties": {
                  "Label": {
                    "backendName": "label",
                    "description_en": "The severity label",
                    "description_zh": "枚举文本",
                    "example": "General issue",
                    "type": "string"
                  },
                  "Value": {
                    "backendName": "value",
                    "description_en": "The severity value",
                    "description_zh": "枚举值",
                    "example": "1",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The status of the ticket. The following are the valid values:\n\n1: assigned (To be processed)\n\n2: dealing (Processing)\n\n3: wait_feedback (Waiting for feedback)\n\n4: feedback (Feedback received)\n\n5: wait_confirm (To be confirmed)\n\n6: confirmed (Completed)",
                "description_zh": "工单状态, 参考值如下\n1, \"assigned\", \"待响应\", \n2, \"dealing\", \"处理中\",\n3, \"wait_feedback\", \"待反馈\",\n4, \"feedback\", \"已反馈\",\n5, \"wait_confirm\", \"待确认\",\n6, \"confirmed\", \"已完成\"",
                "properties": {
                  "Label": {
                    "backendName": "label",
                    "description_en": "The status label",
                    "description_zh": "状态枚举文本",
                    "example": "Completed",
                    "type": "string"
                  },
                  "Value": {
                    "backendName": "value",
                    "description_en": "The status value",
                    "description_zh": "状态枚举值",
                    "example": "6",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "TicketId": {
                "backendName": "ticketId",
                "description_en": "The ticket ID",
                "description_zh": "工单编号",
                "example": "0005PYGCW",
                "type": "string"
              },
              "Title": {
                "backendName": "title",
                "description_en": "The ticket title",
                "description_zh": "工单标题",
                "example": "Why did ECS renewal fail?",
                "type": "string"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The error message. Returned only when Success is false",
            "description_zh": "错误信息, 当success=false的时候, 可以取到message",
            "example": "success",
            "type": "string",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "pageNumber",
            "description_en": "The page number",
            "description_zh": "分页查询参数的页码",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "pageSize",
            "description_en": "The number of entries per page",
            "description_zh": "分页查询参数的每页条数",
            "example": "10",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "阿里云为该请求生成的唯一标识符",
            "example": "C499BB0F-630D-5BE6-B3EA-5FCD95B85503",
            "type": "string",
            "visibility": "Public"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful. A value of true indicates success",
            "description_zh": "调用接口返回是否成功,true代表调用正常",
            "example": "True",
            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          },
          "TotalCount": {
            "backendName": "totalCount",
            "description_en": "The total number of tickets",
            "description_zh": "查询结果总数, 即我的工单记录总条数",
            "example": "108",
            "format": "int64",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
