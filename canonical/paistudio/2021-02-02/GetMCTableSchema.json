{
  "cmd_full_name": "paistudio get-mc-table-schema",
  "cmd_name": "get-mc-table-schema",
  "deprecated": false,
  "description_en": "Retrieves the schema of a MaxCompute table",
  "description_zh": "获取MaxCompute表的Scheme",
  "kebab_example": "aliyun paistudio get-mc-table-schema --table-name table_name --workspace-id 12345 --api-version 2021-02-02 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "GetMCTableSchema",
  "operation": {
    "action": "GetMCTableSchema",
    "api_style": "ROA",
    "api_version": "2021-02-02",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/datasources/maxcompute/tables/{TableName}/schema"
  },
  "parameters": [
    {
      "example": "table_name",
      "help_en": "The name of the MaxCompute table",
      "help_zh": "MaxCompute表名",
      "location": "path",
      "name": "table_name",
      "options": [
        "--table-name"
      ],
      "pattern": "^([a-zA-Z][a-zA-Z0-9_]*\\.)?[a-zA-Z0-9_]+$",
      "raw_name": "TableName",
      "required": true,
      "type": "string"
    },
    {
      "example": "12345",
      "help_en": "The workspace ID",
      "help_zh": "工作空间ID",
      "location": "query",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "WorkspaceId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/datasources/maxcompute/tables/[TableName]/schema",
  "product_code": "PaiStudio",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "响应结果",
        "properties": {
          "Columns": {
            "description_en": "The column information",
            "description_zh": "列信息",
            "itemName": "Column",
            "items": {
              "description_en": "The MaxCompute table column",
              "description_zh": "MaxCompute表列",
              "properties": {
                "Name": {
                  "description_en": "The column name",
                  "description_zh": "列名",
                  "example": "column1",
                  "type": "string"
                },
                "Preview": {
                  "description_en": "The data preview of the column",
                  "description_zh": "列内数据预览",
                  "itemName": "Preview",
                  "items": {
                    "description_en": "The data in the column",
                    "description_zh": "列中数据",
                    "example": "123",
                    "type": "string"
                  },
                  "type": "array"
                },
                "Type": {
                  "description_en": "The column type",
                  "description_zh": "列类型",
                  "example": "STRING",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "PartitionColumns": {
            "description_en": "The partition columns. If this parameter is empty, the table is a non-partitioned table",
            "description_zh": "分区列，假如为空说明是非分区表",
            "itemName": "PartitionColumn",
            "items": {
              "description_en": "The partition column name",
              "description_zh": "分区列名",
              "example": "dt",
              "type": "string"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
