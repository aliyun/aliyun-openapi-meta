{
  "cmd_full_name": "paistudio get-algorithm-tree",
  "cmd_name": "get-algorithm-tree",
  "deprecated": false,
  "description_en": "Retrieves the algorithm tree",
  "description_zh": "获取算法树",
  "kebab_example": "aliyun paistudio get-algorithm-tree --source PaiStudio --workspace-id 12345 --api-version 2021-02-02 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "GetAlgorithmTree",
  "operation": {
    "action": "GetAlgorithmTree",
    "api_style": "ROA",
    "api_version": "2021-02-02",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/algorithm/tree"
  },
  "parameters": [
    {
      "example": "PaiStudio",
      "help_en": "The source from which to retrieve the algorithm list. Default value: PaiStudio",
      "help_zh": "获取指定源的算法列表，默认为PaiStudio",
      "location": "query",
      "name": "source",
      "options": [
        "--source"
      ],
      "raw_name": "Source",
      "required": false,
      "type": "string"
    },
    {
      "example": "12345",
      "help_en": "The workspace ID. If you specify a workspace ID, the algorithm tree results are filtered based on whether GPU resources are enabled for the workspace",
      "help_zh": "工作空间ID。指定工作空间ID后，将根据当前工作空间是否开通GPU资源对算法树结果进行过滤",
      "location": "query",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "WorkspaceId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/algorithm/tree",
  "product_code": "PaiStudio",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "返回结果",
        "properties": {
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "46B59732-033F-5C96-9B15-1E05E7705548",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Timestamp": {
            "description_en": "The timestamp when the algorithm tree was last updated",
            "description_zh": "算法树最后更新的时间戳",
            "example": "20210317101023",
            "type": "string"
          },
          "Tree": {
            "description_en": "The algorithm tree",
            "description_zh": "算法树",
            "itemName": "algo",
            "items": {
              "description_en": "The algorithm definition",
              "description_zh": "算法定义",
              "example": "{\n  \"name\": \"Tensorflow\",\n  \"nodeType\": \"algo\",\n  \"icon\": \"yyyy\",\n  \"metadata\": {\n    \"provider\": \"pai\",\n    \"identifier\": \"evaluate-tensorflow\",\n    \"version\": \"v2\",\n    \"signature\": \"49c9904dc177eb4d58f68915f35315b6fc6ee2db\"\n  },\n  \"doc\": \"http://www.aliyun.com/doc?id=11\"\n}",
              "type": "object"
            },
            "type": "array"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
