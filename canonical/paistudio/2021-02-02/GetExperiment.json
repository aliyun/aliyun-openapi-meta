            "type": "string"
          },
          "Creator": {
            "description_en": "The ID of the creator",
            "description_zh": "创建人ID",
            "example": "13266*******76250",
            "type": "string"
          },
          "Description": {
            "description_en": "The description of the workflow draft",
            "description_zh": "工作流草稿描述",
            "example": "Pipeline Draft Description",
            "type": "string"
          },
          "ExperimentId": {
            "description_en": "The workflow draft ID",
            "description_zh": "工作流草稿ID",
            "example": "draft-rbvg5wzljzjhc9ks92",
            "type": "string"
          },
          "GmtCreateTime": {
            "description_en": "The creation time in UTC, in ISO 8601 format",
            "description_zh": "创建UTC时间，日期格式ISO8601",
            "example": "2021-01-30T12:51:33.028Z",
            "type": "string"
          },
          "GmtModifiedTime": {
            "description_en": "The last modification time of the workflow in UTC, in ISO 8601 format",
            "description_zh": "工作流修改的UTC时间，日期格式ISO8601",
            "example": "2021-01-30T12:51:33.028Z",
            "type": "string"
          },
          "Name": {
            "description_en": "The name of the workflow draft",
            "description_zh": "工作流草稿名称",
            "example": "Pipeline Draft Name",
            "type": "string"
          },
          "Options": {
            "description_en": "The workflow options, in JSON format",
            "description_zh": "工作流选项，json格式",
            "example": "{\"mlflow\":{\"experimentId\":\"exp-1\"}}",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "DD405810-73C9-5721-996A-EA04BCC4BBF2",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Source": {
            "description_en": "The source of the workflow draft",
            "description_zh": "工作流草稿来源",
            "example": "PaiStudio",
            "type": "string"
          },
          "Version": {
            "description_en": "The version of the workflow draft. The version is automatically incremented each time the content is updated",
            "description_zh": "工作流草稿版本，每次更新内容版本会自增",
            "example": "12",
            "format": "int64",
            "type": "integer"
          },
          "WorkspaceId": {
            "description_en": "The workspace ID",
            "description_zh": "工作空间ID",
            "example": "23487",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
