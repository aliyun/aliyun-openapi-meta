  "method": "GET",
  "multi_version": true,
  "name": "GetExperiment",
  "operation": {
    "action": "GetExperiment",
    "api_style": "ROA",
    "api_version": "2021-02-02",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/experiments/{ExperimentId}"
  },
  "parameters": [
    {
      "example": "draft-rbvg5wzljzjhc9ks92",
      "help_en": "The workflow draft ID",
      "help_zh": "工作流草稿ID",
      "location": "path",
      "name": "experiment_id",
      "options": [
        "--experiment-id"
      ],
      "raw_name": "ExperimentId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/experiments/[ExperimentId]",
  "product_code": "PaiStudio",
  "protocol": "HTTP|HTTPS",
