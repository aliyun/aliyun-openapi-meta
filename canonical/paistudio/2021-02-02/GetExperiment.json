{
  "cmd_full_name": "paistudio get-experiment",
  "cmd_name": "get-experiment",
  "deprecated": false,
  "description_en": "Retrieves a PAI Designer workflow draft",
  "description_zh": "获取PAI Designer工作流草稿",
