{
  "cmd_full_name": "paistudio list-jobs",
  "cmd_name": "list-jobs",
  "deprecated": false,
  "description_en": "Retrieves the list of jobs for a workflow draft",
  "description_zh": "获取工作流草稿作业列表",
  "kebab_example": "aliyun paistudio list-jobs --experiment-id draft-8up80bg0k1q23stml6 --api-version 2021-02-02 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "ListJobs",
  "operation": {
    "action": "ListJobs",
    "api_style": "ROA",
    "api_version": "2021-02-02",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/api/v1/jobs"
  },
  "parameters": [
    {
      "example": "draft-8up80bg0k1q23stml6",
      "help_en": "The workflow draft ID",
      "help_zh": "工作流草稿ID",
      "location": "query",
      "name": "experiment_id",
      "options": [
        "--experiment-id"
      ],
      "raw_name": "ExperimentId",
      "required": true,
      "type": "string"
    },
    {
      "example": "13266*******76250",
      "help_en": "The UID of the creator",
      "help_zh": "创建人的UID",
      "location": "query",
      "name": "creator",
      "options": [
        "--creator"
      ],
      "raw_name": "Creator",
      "required": false,
      "type": "string"
    },
    {
      "example": "DESC",
      "help_en": "The sort order. Jobs are sorted by creation time by default. Valid values:\nDESC: descending order.\nASC: ascending order",
      "help_zh": "默认按创建时间排序，排列顺序：\nDESC：降序。\nASC：升序",
      "location": "query",
      "name": "order",
      "options": [
        "--order"
      ],
      "raw_name": "Order",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. Default value: 1",
      "help_zh": "当前页码。默认值：1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of entries per page for a paged query. Default value: 20",
      "help_zh": "分页查询时每页的大小，默认为20",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "/api/v1/jobs",
  "product_code": "PaiStudio",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "响应结果",
        "properties": {
          "Jobs": {
            "description_en": "The list of jobs",
            "description_zh": "作业列表",
            "itemName": "Job",
            "items": {
              "description_en": "The job details",
              "description_zh": "作业详情",
              "properties": {
                "Creator": {
                  "description_en": "The UID of the creator",
                  "description_zh": "创建人的UID",
                  "example": "17677*******89598",
                  "type": "string"
                },
                "ExecuteType": {
                  "description_en": "The execution type. Valid values:\nEXECUTE_ALL: runs all nodes in the workflow draft.\nEXECUTE_ONE: runs a specified node.\nEXECUTE_TO_HERE: runs from the root node to the specified node.\nEXECUTE_FROM_HERE: runs from the specified node.\nEXECUTE_CHILDREN: runs the downstream nodes of the specified node",
                  "description_zh": "执行的类型:\nEXECUTE_ALL(运行工作流草稿中所有节点)\nEXECUTE_ONE(执行指定节点)\nEXECUTE_TO_HERE(从根节点执行到该节点)\nEXECUTE_FROM_HERE(从指定的节点开始运行)\nEXECUTE_CHILDREN(执行指定节点的下游节点)",
                  "example": "EXECUTE_ALL",
                  "type": "string"
                },
                "ExperimentId": {
                  "description_en": "The workflow draft ID",
                  "description_zh": "工作流草稿ID",
                  "example": "draft-4x4iv3a9enuxw4vgka",
                  "type": "string"
                },
                "GmtCreateTime": {
                  "description_en": "The creation time in UTC, in ISO 8601 format",
                  "description_zh": "创建时间，UTC 时间，日期格式 iso8601",
                  "example": "2021-01-21T17:12:35.232Z",
                  "type": "string"
                },
                "JobId": {
                  "description_en": "The job ID",
                  "description_zh": "任务 ID",
                  "example": "job-mewqhd72nsrqujn1px",
                  "type": "string"
                },
                "NodeId": {
                  "description_en": "The node ID in the workflow draft",
                  "description_zh": "工作流草稿中的节点ID",
                  "example": "nodeId1",
                  "type": "string"
                },
                "PaiflowNodeId": {
                  "description_en": "The Pipeline Run node ID in PaiFlow",
                  "description_zh": "PaiFlow中的Pipeline Run节点ID",
                  "example": "node-xdfasf8ewxfdaddl",
                  "type": "string"
                },
                "RunId": {
                  "description_en": "The corresponding PaiFlow Pipeline Run ID",
                  "description_zh": "对应的PaiFlow的Pipeline Run ID",
                  "example": "flow-aayfouai80i980ncvz",
                  "type": "string"
                },
                "Status": {
                  "description_en": "The status of the job. Valid values:\nInitialized: The job is initialized.\nStarting: The job is starting.\nWorkflowServiceStarting: The job is being submitted.\nRunning: The job is running.\nSucceeded: The job succeeded.\nFailed: The job failed.\nTerminating: The job is being terminated.\nTerminated: The job is terminated.\nUnknown: The job status is unknown.\nSkipped: The job is skipped because a preceding node failed.\nReadyToSchedule: The job is ready to run because a preceding node has not completed",
                  "description_zh": "作业的状态，目前状态有：\nInitialized: 初始化完成\nStarting：开始\nWorkflowServiceStarting：准备提交\nRunning：运行中\nSucceeded：运行成功\nFailed：运行失败\nTerminating：终止中\nTerminated：已终止\nUnknown：未知\nSkipped：跳过（前序节点失败导致）\nReadyToSchedule：准备运行（前序节点未完成导致）",
                  "example": "Running",
                  "type": "string"
                },
                "WorkspaceId": {
                  "description_en": "The workspace ID",
                  "description_zh": "工作空间ID",
                  "example": "94436",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
