{
  "cmd_full_name": "paistudio list-node-outputs",
  "cmd_name": "list-node-outputs",
  "deprecated": false,
  "description_en": "Retrieves the output models of a node in a workflow draft",
  "description_zh": "获取工作流草稿节点的输出模型",
  "kebab_example": "aliyun paistudio list-node-outputs --experiment-id draft-rbvg5wzljzjhc9ks92 --node-id node-5dzotrnwyzfxmbwwc8 --api-version 2021-02-02 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "ListNodeOutputs",
  "operation": {
    "action": "ListNodeOutputs",
    "api_style": "ROA",
    "api_version": "2021-02-02",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/api/v1/experiments/{ExperimentId}/nodes/{NodeId}/outputs"
  },
  "parameters": [
    {
      "example": "draft-rbvg5wzljzjhc9ks92",
      "help_en": "The ID of the workflow draft",
      "help_zh": "工作流草稿ID",
      "location": "path",
      "name": "experiment_id",
      "options": [
        "--experiment-id"
      ],
      "raw_name": "ExperimentId",
      "required": true,
      "type": "string"
    },
    {
      "example": "node-5dzotrnwyzfxmbwwc8",
      "help_en": "The ID of the node in the workflow draft",
      "help_zh": "工作流草稿中的节点ID",
      "location": "path",
      "name": "node_id",
      "options": [
        "--node-id"
      ],
      "raw_name": "NodeId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/experiments/[ExperimentId]/nodes/[NodeId]/outputs",
  "product_code": "PaiStudio",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "响应结果",
        "properties": {
          "Outputs": {
            "description_en": "The list of models for the node",
            "description_zh": "节点的模型列表",
            "itemName": "Outputs",
            "items": {
              "description_en": "The model information",
              "description_zh": "模型信息",
              "properties": {
                "AlgoName": {
                  "description_en": "The algorithm name",
                  "description_zh": "算法名称",
                  "example": "逻辑回归二分类",
                  "type": "string"
                },
                "DisplayName": {
                  "description_en": "The model name in the format of {NodeName}-{outputId}",
                  "description_zh": "模型名称，格式是{NodeName}-{outputId}",
                  "example": "逻辑回归二分类-2-outputModel",
                  "type": "string"
                },
                "LocationType": {
                  "description_en": "The model location. Valid values:\nMaxComputeTable: MaxCompute table.\nOSS: OSS",
                  "description_zh": "模型位置：\nMaxComputeTable: MaxCompute表\nOSS: OSS",
                  "example": "MaxComputeTable",
                  "type": "string"
                },
                "NodeName": {
                  "description_en": "The node name",
                  "description_zh": "节点名称",
                  "example": "node1",
                  "type": "string"
                },
                "OutputId": {
                  "description_en": "The output port ID of the algorithm node",
                  "description_zh": "算法节点输出端口id",
                  "example": "outputModel",
                  "type": "string"
                },
                "OutputIndex": {
                  "description_en": "The index of the variable-length node, starting from 0",
                  "description_zh": "可变长节点的index，从0开始",
                  "example": "0",
                  "type": "string"
                },
                "Type": {
                  "description_en": "The type. Valid values:\nModel\nDataSet",
                  "description_zh": "类型，有Model、DataSet",
                  "example": "Model",
                  "type": "string"
                },
                "Value": {
                  "description_en": "The content of the output. Different output types correspond to different keys",
                  "description_zh": "Output的内容，不同Type的Output对应的key不一样",
                  "example": "{\n  \"name\": \"model_flow_wayrh3k605s7i51wey_node_7n3tstbuhr36t0ukiz_model\",\n  \"modelType\": \"OfflineModel\",\n  \"labelCol\": \"_c2\",\n  \"features\": \"pm10,so2,co,no2\",\n  \"gmtCreateTime\": \"2021-01-21T17:12:35.232Z\",\n  \"gmtModifiedTime\": \"2021-01-21T17:12:35.232Z\",\n  \"parameters\": {\n    \"epsilon\": \"0.000001\",\n    \"enableSparse\": \"false\",\n    \"regularizedLevel\": \"1\",\n    \"roleArn\": \"true\",\n    \"maxIter\": \"100\",\n    \"regularizedType\": \"None\",\n    \"generatePmml\": \"true\"\n  }\n}",
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "473469C7-AA6F-4DC5-B3DB-A3DC0DE3C83E",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
