      "schema": {
        "description_en": "The response",
        "description_zh": "返回结果",
        "properties": {
          "Accessibility": {
            "description_en": "The visibility of the workspace. Valid values:\nPRIVATE: Visible only to you and administrators in this workspace.\nPUBLIC: Visible to all users in this workspace",
            "description_zh": "工作空间可见性，可能值为：\nPRIVATE：在此工作空间中，仅对您和管理员可见。\nPUBLIC：在此工作空间中，对所有人可见",
            "example": "PUBLIC",
            "type": "string"
          },
          "Creator": {
            "description_en": "The ID of the creator",
            "description_zh": "创建人ID",
            "example": "1326****76250",
            "type": "string"
          },
          "Description": {
            "description_en": "The description of the workflow draft",
            "description_zh": "工作流草稿描述",
            "example": "Pipeline draft description",
            "type": "string"
          },
          "ExperimentId": {
            "description_en": "The workflow draft ID",
            "description_zh": "工作流草稿ID",
            "example": "draft-rbvg5wzljzjhc9ks92",
            "type": "string"
          },
          "GmtCreateTime": {
            "description_en": "The creation time in UTC, in ISO 8601 format",
            "description_zh": "创建UTC时间，时间格式为ISO8601",
            "example": "2021-01-30T12:51:33.028Z",
            "type": "string"
          },
          "GmtModifiedTime": {
            "description_en": "The last modification time of the workflow draft in UTC, in ISO 8601 format",
            "description_zh": "工作流草稿修改 UTC 时间，日期格式ISO8601",
            "example": "2021-01-30T12:51:33.028Z",
            "type": "string"
          },
          "Name": {
            "description_en": "The name of the workflow draft",
            "description_zh": "工作流草稿名称",
            "example": "Pipeline draft name",
            "type": "string"
          },
          "Options": {
            "description_en": "The options of the workflow draft",
            "description_zh": "工作流草稿选项",
            "example": "{\"mlflow\":{\"experimentId\":\"exp-1\"}}",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "F2D0392B-D749-5C48-A98A-3FAE5C9444A6",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Source": {
            "description_en": "The source of the workflow draft",
            "description_zh": "工作流草稿来源",
            "example": "PaiStudio",
            "type": "string"
          },
          "Version": {
            "description_en": "The version of the workflow draft. The version is incremented each time the content is updated",
            "description_zh": "工作流草稿版本，每次更新内容版本会自增",
            "example": "12",
            "type": "string"
          },
          "WorkspaceId": {
            "description_en": "The workspace ID",
            "description_zh": "工作空间ID",
            "example": "23487",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
