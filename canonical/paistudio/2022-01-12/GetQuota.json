            "$ref": "#/components/schemas/ResourceAmount",
            "backendName": "AllocatableQuota",
            "description_en": "The user-allocatable quota amount. For general computing resources, each node has system-reserved resources. This value represents the quota resources that user workloads can occupy.\nActualMin = AllocatableQuota + SystemReservedQuota",
            "description_zh": "用户可分配Quota量：针对通用计算资源，每个节点存在系统预留，此处表示用户Workload可占用的Quota资源量。\nActualMin = AllocatableQuota + SystemReservedQuota",
            "title": "用户可分配Quota量"
          },
          "AllocatedQuota": {
            "$ref": "#/components/schemas/ResourceAmount",
            "backendName": "AllocatedQuota",
            "description_en": "The total quota usage information, which is the total resources occupied by workloads after scheduling to nodes",
            "description_zh": "Quota总共用量信息：指调度到节点的Workload占用的资源总和",
            "title": "Quota总共用量信息"
          },
          "AncestorsAllocatedQuota": {
            "$ref": "#/components/schemas/ResourceAmount",
            "backendName": "AncestorsAllocatedQuota",
            "description_en": "The ancestor quota usage information, which is the total resources of workloads submitted using ancestor quotas after they are scheduled to nodes",
            "description_zh": "祖先Quota用量信息：使用祖先Quota到Workload，调度到节点后的资源总和",
            "title": "祖先Quota用量信息"
          },
          "DescendantsAllocatedQuota": {
            "$ref": "#/components/schemas/ResourceAmount",
            "backendName": "DescendantsAllocatedQuota",
            "description_en": "The descendant quota usage information, which is the total resources of workloads submitted using descendant quotas after they are scheduled to nodes",
            "description_zh": "子孙Quota用量信息：使用子孙Quota，调度到节点后的资源总和",
            "title": "子孙Quota用量信息"
          },
          "DesiredMinQuota": {
            "$ref": "#/components/schemas/ResourceAmount",
            "backendName": "DesiredMinQuota",
            "description_en": "The total MinQuota desired by the user",
            "description_zh": "用户所需的MinQuota总量",
            "title": "用户所需的MinQuota总量"
          },
          "NodeStatistics": {
            "$ref": "#/components/schemas/QuotaNodeStatistics",
