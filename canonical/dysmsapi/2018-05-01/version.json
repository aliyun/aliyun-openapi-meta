{
  "apis": {
    "BatchSendMessageToGlobe": {
      "cmd_name": "batch-send-message-to-globe",
      "deprecated": false,
      "description_en": "Sends a message to multiple recipients in countries or regions outside the Chinese mainland",
      "description_zh": "批量发送短信到中国境外"
    },
    "ConversionData": {
      "cmd_name": "conversion-data",
      "deprecated": false,
      "description_en": "Reports the status of an OTP message to Alibaba Cloud SMS",
      "description_zh": "将短信转化率统计数据反馈给阿里云国际短信平台"
    },
    "QueryMessage": {
      "cmd_name": "query-message",
      "deprecated": false,
      "description_en": "Queries the delivery report of a message",
      "description_zh": "使用短信MessageId查询短信发送记录"
    },
    "SendMessageToGlobe": {
      "cmd_name": "send-message-to-globe",
      "deprecated": false,
      "description_en": "Sends messages to regions outside the Chinese mainland, including Hong Kong (China), Macao (China), Taiwan (China)",
      "description_zh": "发送短信到中国香港、中国澳门、中国台湾以及中国境外地区"
    },
    "SendMessageWithTemplate": {
      "cmd_name": "send-message-with-template",
      "deprecated": false,
      "description_en": "Sends a message to the Chinese mainland by using a message template",
      "description_zh": "使用短信模板发送短信，只支持发往中国内地"
    },
    "SmsConversion": {
      "cmd_name": "sms-conversion",
      "deprecated": false,
      "description_en": "Delivers one-time password (OTP) message statuses to Alibaba Cloud, which calculates and monitors OTP conversion rates",
      "description_zh": "将每一条消息ID(MessageId) 对应短信的接收情况反馈给阿里云国际短信平台"
    }
  },
