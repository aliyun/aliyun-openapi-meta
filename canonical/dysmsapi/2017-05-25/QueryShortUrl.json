            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "819BE656-D2E0-4858-8B21-B2E477085AAF",
            "type": "string",
            "visibility": "Public"
