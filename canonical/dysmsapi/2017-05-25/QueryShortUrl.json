  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The request status code.\n\nA successful request returns `OK`.\n\nFor other error codes, see [Error codes]（https://help.aliyun.com/document_detail/101346.html）",
            "description_zh": "请求状态码。\n\n返回OK代表请求成功。\n其他错误码，请参见[错误码列表]（https://help.aliyun.com/document_detail/101346.html）",
            "example": "OK",
            "type": "string",
            "visibility": "Public"
          },
          "Data": {
            "backendName": "module",
            "description_en": "The details of the short link",
            "description_zh": "短链详情",
            "nullToEmpty": false,
            "properties": {
              "CreateDate": {
                "backendName": "createDate",
                "description_en": "The creation date and time of the short link",
                "description_zh": "短链创建时间",
                "example": "2019-01-08 16:44:13",
                "type": "string",
                "visibility": "Public"
              },
              "ExpireDate": {
                "backendName": "expireDate",
                "description_en": "The expiration date and time of the short link",
                "description_zh": "短链失效时间",
                "example": "2019-01-22 11:21:11",
                "type": "string",
                "visibility": "Public"
              },
              "PageViewCount": {
                "backendName": "pageViewCount",
                "description_en": "The page view (PV) count for the short link",
                "description_zh": "短链使用的PV数据",
                "example": "300",
                "type": "string",
                "visibility": "Public"
              },
              "ShortUrl": {
                "backendName": "shortUrl",
                "description_en": "The generated short link",
                "description_zh": "生成的短链服务地址",
