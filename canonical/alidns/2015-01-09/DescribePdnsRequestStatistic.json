                  "format": "int64",
                  "type": "integer"
                },
                "V4Count": {
                  "backendName": "v4Count",
                  "description_en": "The number of IPv4 requests",
                  "description_zh": "IPv4请求量",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "V4HttpCount": {
                  "backendName": "v4HttpCount",
                  "description_en": "The number of IPv4 HTTP requests",
                  "description_zh": "IPv4 HTTP 请求量",
                  "example": "0",
                  "format": "int64",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                },
                "V4HttpsCount": {
                  "backendName": "v4HttpsCount",
                  "description_en": "The number of IPv4 HTTPS requests",
                  "description_zh": "IPv4 HTTPS 请求量",
                  "example": "0",
                  "format": "int64",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                },
                "V6Count": {
                  "backendName": "v6Count",
                  "description_en": "The number of IPv6 requests",
                  "description_zh": "IPv6请求量",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "V6HttpCount": {
                  "backendName": "v6HttpCount",
                  "description_en": "The number of IPv6 HTTP requests",
                  "description_zh": "IPv6 HTTP 请求量",
                  "example": "0",
                  "format": "int64",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                },
                "V6HttpsCount": {
                  "backendName": "v6HttpsCount",
                  "description_en": "The number of IPv6 HTTPS requests",
                  "description_zh": "IPv6 HTTPS 请求量",
                  "example": "0",
                  "format": "int64",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique request ID",
            "description_zh": "唯一请求识别码",
            "example": "536E9CAD-DB30-4647-AC87-AA5CC38C5382",
