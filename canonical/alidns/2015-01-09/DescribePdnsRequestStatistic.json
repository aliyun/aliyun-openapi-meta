                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "HttpCount": {
                  "backendName": "httpCount",
                  "description_en": "The number of HTTP requests",
                  "description_zh": "HTTP请求量",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "HttpsCount": {
                  "backendName": "httpsCount",
                  "description_en": "The number of HTTPS requests. On the Traffic Analysis tab of the Public DNS console, this parameter includes the number of DNS-over-HTTPS (DoH) requests. Therefore, DoH requests are not displayed separately in the console",
                  "description_zh": "HTTPS请求量。但在公共DNS控制台流量分析页签中，此参数版包含了DoH的请求量，所以DoH的请求量没有在控制台单独展示",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "IpCount": {
                  "backendName": "ipCount",
                  "description_en": "The number of source IP addresses",
                  "description_zh": "源IP地址数量",
                  "example": "10",
                  "format": "int64",
                  "type": "integer"
                },
                "Timestamp": {
                  "backendName": "timestamp",
                  "description_en": "The timestamp of the statistics. Unit: milliseconds",
                  "description_zh": "统计时间戳。单位：毫秒",
                  "example": "1706716800000",
                  "format": "int64",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                },
                "TotalCount": {
                  "backendName": "totalCount",
                  "description_en": "The total number of requests",
                  "description_zh": "请求总量",
                  "example": "0",
                  "format": "int64",
                  "type": "integer"
                },
                "UdpTotalCount": {
                  "backendName": "udpTotalCount",
                  "description_en": "The total number of UDP requests",
