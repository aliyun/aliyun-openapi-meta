                        "example": "1.2.XX.XX",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": false,
                  "type": "array",
                  "visibility": "Public"
                },
                "Name": {
                  "backendName": "name",
                  "description_en": "The name of the line",
