            "nullToEmpty": false,
            "type": "boolean",
            "visibility": "Public"
          },
          "SubDomain": {
            "backendName": "module.subDomain",
            "description_en": "Indicates whether the queried domain is a hosted subdomain. Valid values:\n\ntrue\n\nfalse",
            "description_zh": "查询的 domain 是否是托管的子域名。\n取值：\ntrue\nfalse",
            "example": "false",
            "type": "boolean"
          },
          "VersionCode": {
            "backendName": "module.versionCode",
            "description_en": "The edition ID of Alibaba Cloud DNS. Valid values:\n\nversion_enterprise_advanced: Ultimate Edition\n\nversion_personal: Personal Edition\n\nmianfei: Free Edition",
            "description_zh": "云解析版本ID。取值范围：\nversion_enterprise_advanced：企业旗舰版\nversion_personal 个人版\nmianfei：免费版",
            "example": "mianfei",
            "type": "string",
            "visibility": "Public"
          },
          "VersionName": {
            "backendName": "module.versionName",
            "description_en": "The name of the Alibaba Cloud DNS edition",
            "description_zh": "云解析产品名称",
            "example": "企业旗舰版",
            "type": "string",
            "visibility": "Public"
