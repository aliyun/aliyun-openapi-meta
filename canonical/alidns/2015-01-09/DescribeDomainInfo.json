                  "visibility": "Public"
                },
                "LineCode": {
                  "backendName": "lineCode",
                  "type": "string",
                  "visibility": "Public"
                },
                "LineDisplayName": {
                  "backendName": "lineDisplayName",
                  "type": "string",
                  "visibility": "Public"
                },
                "LineName": {
                  "backendName": "lineName",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
