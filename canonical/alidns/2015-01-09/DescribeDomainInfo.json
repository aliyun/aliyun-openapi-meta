    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "en",
      "help_en": "The language of the response. Valid values:\n\nzh: Chinese\n\nen: English\n\nDefault value: en",
      "help_zh": "返回值语言，取值：\nzh：中文\nen：英文\n\n默认值：en",
      "location": "query",
