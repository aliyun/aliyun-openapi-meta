{
  "camel_example": "aliyun alidns DescribeDomainInfo --region cn-hangzhou --DomainName 'example.com'",
  "cmd_full_name": "alidns describe-domain-info",
  "cmd_name": "describe-domain-info",
  "deprecated": false,
