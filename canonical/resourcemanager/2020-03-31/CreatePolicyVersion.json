              "VersionId": {
                "backendName": "VersionId",
                "description_en": "The ID of the access policy version",
                "description_zh": "权限策略版本标识",
                "example": "v3",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
