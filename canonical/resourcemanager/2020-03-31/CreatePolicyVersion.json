{
  "camel_example": "aliyun resourcemanager CreatePolicyVersion --region cn-hangzhou --PolicyName 'OSS-Administrator' --PolicyDocument 'Statement_:_Action_:_oss:0_,_Effect_:_Allow_,_Resource_:_acs:oss:0:0:0_,_Version_:_1'",
  "cmd_full_name": "resourcemanager create-policy-version",
  "cmd_name": "create-policy-version",
  "deprecated": false,
  "description_en": "Creates a version of an access policy by calling CreatePolicyVersion",
  "description_zh": "调用CreatePolicyVersion创建权限策略版本",
  "kebab_example": "aliyun resourcemanager create-policy-version --policy-name OSS-Administrator --policy-document Statement_:_Action_:_oss:0_,_Effect_:_Allow_,_Resource_:_acs:oss:0:0:0_,_Version_:_1 --api-version 2020-03-31 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "CreatePolicyVersion",
  "operation": {
    "action": "CreatePolicyVersion",
    "api_style": "RPC",
    "api_version": "2020-03-31",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "OSS-Administrator",
      "help_en": "Policy Name of the access policy.\n\nPolicy Name must be 1 to 128 characters in length and can contain letters, digits, and hyphens (-)",
      "help_zh": "权限策略名称。\n\n长度为1~128个字符，可包含英文字母、数字和短横线（-）",
      "location": "query",
      "name": "policy_name",
      "options": [
        "--policy-name"
      ],
      "raw_name": "PolicyName",
      "required": true,
      "type": "string"
    },
    {
      "example": "{ \"Statement\": [{ \"Action\": [\"oss:*\"], \"Effect\": \"Allow\", \"Resource\": [\"acs:oss:*:*:*\"]}], \"Version\": \"1\"}",
      "help_en": "The content of the access policy.\n\nThe content must be 1 to 6,144 characters in length",
      "help_zh": "权限策略内容。\n\n长度为1~6144个字符",
      "location": "query",
      "name": "policy_document",
      "options": [
        "--policy-document"
      ],
      "raw_name": "PolicyDocument",
      "required": true,
      "type": "string"
    },
    {
      "example": "false",
      "help_en": "Specifies whether to set the version as the default access policy version.\n\nValid values:\n\nfalse (default): Does not set the version as the default access policy version.\ntrue: Sets the version as the default access policy version",
      "help_zh": "是否设置为默认权限策略。 \n\nfalse（默认值）：不设置为默认权限策略。\ntrue：设置为默认权限策略",
      "location": "query",
      "name": "set_as_default",
      "options": [
        "--set-as-default"
      ],
      "raw_name": "SetAsDefault",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "ResourceManager",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "PolicyVersion": {
            "backendName": "PolicyVersion",
            "description_en": "The access policy version information",
            "description_zh": "权限策略版本信息",
            "properties": {
              "CreateDate": {
                "backendName": "CreateDate",
                "description_en": "The time when the access policy version was created. The time is in RFC 3339 UTC format, indicated by Z",
                "description_zh": "权限策略版本创建时间，采用 RFC 3339 UTC 时间格式，以 Z 表示 UTC",
                "example": "2015-01-23T12:33:18Z",
                "type": "string",
                "visibility": "Public"
              },
              "IsDefaultVersion": {
                "backendName": "IsDefaultVersion",
                "description_en": "Indicates whether the version is the default version of the access policy",
