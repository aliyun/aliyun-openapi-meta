{
  "camel_example": "aliyun resourcemanager UpdateAccount --region cn-hangzhou --AccountId 123233440000",
  "cmd_full_name": "resourcemanager update-account",
  "cmd_name": "update-account",
  "deprecated": false,
  "description_en": "Changes the display name of a member, or switches the type of a member",
  "description_zh": "调用UpdateAccount修改成员名称或切换成员类型",
  "kebab_example": "aliyun resourcemanager update-account --account-id 123233440000 --api-version 2020-03-31 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "UpdateAccount",
  "operation": {
    "action": "UpdateAccount",
    "api_style": "RPC",
    "api_version": "2020-03-31",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
  "parameters": [
    {
      "example": "admin",
      "help_en": "The new display name of the member.\n\nYou can configure either the `NewDisplayName` or `NewAccountType` parameter",
      "help_zh": "新的成员名称。\n`NewDisplayName`与`NewAccountType`任选其一设置，不能同时设置",
      "location": "query",
      "name": "new_display_name",
      "options": [
        "--new-display-name"
      ],
      "raw_name": "NewDisplayName",
      "required": false,
      "type": "string"
    },
    {
      "example": "ResourceAccount",
      "help_en": "The new type of the member. Valid values:\n\nResourceAccount: resource account\nCloudAccount: cloud account\n\nYou can configure either the `NewDisplayName` or `NewAccountType` parameter",
      "help_zh": "新的成员类型。取值：\n\nResourceAccount：将指定的云账号切换为资源账号。\nCloudAccount：将指定的资源账号切换为云账号。\n\n`NewDisplayName`与`NewAccountType`任选其一设置，不能同时设置",
      "location": "query",
      "name": "new_account_type",
      "options": [
        "--new-account-type"
      ],
      "raw_name": "NewAccountType",
      "required": false,
      "type": "string"
    },
    {
      "example": "12323344****",
      "help_en": "The ID of the Alibaba Cloud account that corresponds to the member",
      "help_zh": "成员ID",
      "location": "query",
      "name": "account_id",
      "options": [
        "--account-id"
      ],
      "raw_name": "AccountId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ResourceManager",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_zh": "返回参数",
        "properties": {
          "Account": {
            "backendName": "data.rdAccountInfo",
            "description_en": "The information of the member",
            "description_zh": "成员信息",
            "properties": {
              "AccountId": {
                "backendName": "accountId",
                "description_en": "The ID of the Alibaba Cloud account that corresponds to the member",
                "description_zh": "成员ID",
                "example": "12323344****",
                "type": "string",
                "visibility": "Public"
              },
              "AccountName": {
                "backendName": "accountName",
                "description_en": "The name of the Alibaba Cloud account that corresponds to the member",
                "description_zh": "阿里云账号名称",
                "example": "ecs-manager@aliyun.com",
                "type": "string",
                "visibility": "Public"
              },
              "DisplayName": {
                "backendName": "displayName",
                "description_en": "The display name of the member",
                "description_zh": "成员名称",
                "example": "admin",
                "type": "string",
                "visibility": "Public"
              },
              "FolderId": {
                "backendName": "folderId",
                "description_en": "The ID of the folder",
                "description_zh": "资源夹ID",
                "example": "fd-bVaRIG****",
                "type": "string",
                "visibility": "Public"
              },
              "JoinMethod": {
                "backendName": "joinMethod",
                "description_en": "The way in which the member joins the resource directory. Valid values:\n\ninvited: The member is invited to join the resource directory.\ncreated: The member is directly created in the resource directory",
                "description_zh": "成员加入方式。取值：\n\ninvited：邀请。\ncreated：创建",
                "example": "created",
                "type": "string",
                "visibility": "Public"
              },
              "JoinTime": {
                "backendName": "joinTime",
                "description_en": "The time when the member joined the resource directory. The time is displayed in UTC",
                "description_zh": "成员加入时间（UTC时间）",
                "example": "2015-01-23T12:33:18Z",
                "type": "string",
                "visibility": "Public"
              },
              "ModifyTime": {
                "backendName": "modifyTime",
                "description_en": "The time when the member was modified. The time is displayed in UTC",
                "description_zh": "成员修改时间（UTC时间）",
                "example": "2015-01-23T12:33:18Z",
                "type": "string",
                "visibility": "Public"
              },
              "ResourceDirectoryId": {
                "backendName": "rdId",
                "description_en": "The ID of the resource directory",
                "description_zh": "资源目录ID",
                "example": "rd-k3****",
                "type": "string",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The status of the member. Valid values:\n\nCreateSuccess: The member is created.\nInviteSuccess: The member accepts the invitation.\nRemoved: The member is removed.\nSwitchSuccess: The type of the member is switched",
                "description_zh": "成员加入状态。取值：\n\nCreateSuccess：创建成功。\nInviteSuccess：邀请成功。\nRemoved：已移除。\nSwitchSuccess：切换成功",
                "example": "CreateSuccess",
                "type": "string",
                "valueMapping": {
                  "cases": [
                    {
                      "targetValue": "InviteSuccess",
                      "value": "InvitedSucceed"
                    },
                    {
                      "targetValue": "PromoteSuccess",
                      "value": "PromoteSucceed"
                    },
                    {
                      "targetValue": "CreateSuccess",
                      "value": "CreateSucceed"
                    }
                  ]
                },
                "visibility": "Public"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type of the member. Valid values:\n\nCloudAccount: cloud account\nResourceAccount: resource account",
                "description_zh": "成员类型。取值：\n\nCloudAccount：云账号。\nResourceAccount：资源账号",
                "example": "ResourceAccount",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "9B34724D-54B0-4A51-B34D-4512372FE1BE",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
