{
  "camel_example": "aliyun resourcemanager GetRole --region cn-hangzhou --RoleName ECSAdmin",
  "cmd_full_name": "resourcemanager get-role",
  "cmd_name": "get-role",
  "deprecated": false,
  "description_en": "Queries the information about a role by calling GetRole",
  "description_zh": "调用GetRole获取角色信息",
  "kebab_example": "aliyun resourcemanager get-role --role-name ECSAdmin --api-version 2020-03-31 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetRole",
  "operation": {
    "action": "GetRole",
    "api_style": "RPC",
    "api_version": "2020-03-31",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "ECSAdmin",
      "help_en": "The role name.\n\nThe name must be 1 to 64 characters in length and can contain letters, digits, periods (.), and hyphens (-)",
      "help_zh": "角色名称。\n\n长度为1~64个字符，可包含英文字母、数字、点号（.）和短横线（-）",
      "location": "query",
      "name": "role_name",
      "options": [
        "--role-name"
      ],
      "raw_name": "RoleName",
      "required": true,
      "type": "string"
    },
    {
      "example": "zh-CN",
      "help_en": "The language type. The role description is returned in the specified language. Valid values:\n\nen: English.\nzh-CN: Chinese.\nja: Japanese",
      "help_zh": "语言类型。角色描述将以此语言返回。\n\nen：英文。\nzh-CN：中文。\nja：日文",
      "location": "query",
      "name": "language",
      "options": [
        "--biz-language"
      ],
      "raw_name": "Language",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ResourceManager",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "04F0F334-1335-436C-A1D7-6C044FE73368",
            "type": "string",
            "visibility": "Public"
          },
          "Role": {
            "backendName": "Role",
            "description_en": "The role information",
            "description_zh": "角色信息",
            "properties": {
              "Arn": {
                "backendName": "Arn",
                "description_en": "The resource descriptor of the role",
                "description_zh": "角色的资源描述符",
                "example": "acs:ram::123456789012****:role/ECSAdmin",
                "mappingResourcePropertyName": "$.Arn",
                "type": "string",
                "visibility": "Public"
              },
              "AssumeRolePolicyDocument": {
                "backendName": "AssumeRolePolicyDocument",
                "description_en": "The content of the access policy that specifies the trusted entity to assume the role",
                "description_zh": "扮演角色的权限策略内容",
                "example": "{ \\\"Statement\\\": [ { \\\"Action\\\": \\\"sts:AssumeRole\\\", \\\"Effect\\\": \\\"Allow\\\", \\\"Principal\\\": { \\\"RAM\\\": \\\"acs:ram::12345678901234****:root\\\" } } ], \\\"Version\\\": \\\"1\\\" }",
                "mappingResourcePropertyName": "$.AssumeRolePolicyDocument",
                "type": "string",
                "visibility": "Public"
              },
              "CreateDate": {
                "backendName": "CreateDate",
                "description_en": "The time when the role was created. The time is in RFC 3339 UTC format, indicated by Z",
                "description_zh": "角色创建时间，采用 RFC 3339 UTC 时间格式，以 Z 表示 UTC",
                "example": "2015-01-23T12:33:18Z",
                "mappingResourcePropertyName": "$.CreateTime",
                "type": "string",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "Description",
                "description_en": "The description of the role",
                "description_zh": "角色描述",
                "example": "ECS管理角色",
                "mappingResourcePropertyName": "$.Description",
                "type": "string",
                "visibility": "Public"
              },
              "IsServiceLinkedRole": {
                "backendName": "IsServiceLinkedRole",
                "description_en": "Indicates whether the role is a service-linked role",
                "description_zh": "是否为服务关联角色",
                "example": "true",
                "type": "boolean",
                "visibility": "Public"
              },
              "LatestDeletionTask": {
                "backendName": "LatestDeletionTask",
                "description_en": "The information about the most recent deletion task",
                "description_zh": "最近一次删除任务信息",
                "properties": {
                  "CreateDate": {
                    "backendName": "CreateDate",
                    "description_en": "The time when the deletion task was created. The time is in RFC 3339 UTC format, indicated by Z",
                    "description_zh": "删除任务创建时间，采用 RFC 3339 UTC 时间格式，以 Z 表示 UTC",
                    "example": "2018-10-23T12:33:18Z",
                    "type": "string",
                    "visibility": "Public"
                  },
                  "DeletionTaskId": {
                    "backendName": "DeletionTaskId",
                    "description_en": "The ID of the deletion task",
                    "description_zh": "删除任务ID",
                    "example": "ECSAdmin/cc61514b-26eb-4453-ab53-b142eb702a3d",
                    "type": "string",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "MaxSessionDuration": {
                "backendName": "MaxSessionDuration",
                "description_en": "The maximum session duration of the role",
                "description_zh": "角色最大会话时间",
                "example": "3600",
                "format": "int64",
                "mappingResourcePropertyName": "$.MaxSessionDuration",
                "type": "integer",
                "visibility": "Public"
              },
              "RoleId": {
                "backendName": "RoleId",
                "description_en": "The role ID",
                "description_zh": "角色ID",
                "example": "90123456789****",
                "mappingResourcePropertyName": "$.RoleId",
                "type": "string",
                "visibility": "Public"
              },
              "RoleName": {
                "backendName": "RoleName",
                "description_en": "The role name",
                "description_zh": "角色名称",
                "example": "ECSAdmin",
                "mappingResourcePropertyName": "$.RoleName",
                "type": "string",
                "visibility": "Public"
              },
              "RolePrincipalName": {
                "backendName": "RolePrincipalName",
                "description_en": "The name of the authorized role",
                "description_zh": "被授权角色名称",
                "example": "ECSAdmin@role.123456.onaliyunservice.com",
                "type": "string",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "UpdateDate",
                "description_en": "The time when the role was last updated. The time is in RFC 3339 UTC format, indicated by Z",
                "description_zh": "角色更新时间，采用 RFC 3339 UTC 时间格式，以 Z 表示 UTC",
                "example": "2016-01-23T12:33:18Z",
                "mappingResourcePropertyName": "$.UpdateDate",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
