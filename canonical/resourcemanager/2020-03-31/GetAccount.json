                "visibility": "Public"
              },
              "Location": {
                "backendName": "location",
                "description_en": "The location of the member account in the resource directory",
                "description_zh": "成员所在资源目录的位置",
                "example": "root/AlRd****/Z5Aa****",
                "type": "string"
              },
              "ModifyTime": {
                "backendName": "modifyTime",
                "description_en": "The time when the member account was last modified. The time is displayed in UTC in RFC 3339 format, indicated by Z",
                "description_zh": "成员修改时间，采用 RFC 3339 UTC 时间格式，以 Z 表示 UTC",
                "example": "2015-01-23T12:33:18Z",
                "type": "string",
                "visibility": "Public"
              },
              "ResourceDirectoryId": {
                "backendName": "rdId",
                "description_en": "The ID of the resource directory",
                "description_zh": "资源目录ID",
                "example": "rd-k3****",
                "type": "string",
                "visibility": "Public"
              },
              "ResourceDirectoryPath": {
                "backendName": "rdPath",
                "description_en": "The path ID (RDPath) of the member account in the resource directory",
                "description_zh": "成员在资源目录中的路径ID（RDPath）",
                "example": "rd-k3****/r-Wm****/fd-bVaRIG****/181761095690****",
                "type": "string"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The join status of the member account. Valid values:\n\nCreateSuccess: Created.\nPromoteVerifying: Upgrade is being confirmed.\nPromoteFailed: Upgrade failed.\nPromoteExpired: Upgrade expired.\nPromoteCancelled: Upgrade canceled.\nPromoteSuccess: Upgrade succeeded.\nInviteSuccess: Invitation succeeded",
                "description_zh": "成员加入状态。取值：\n\nCreateSuccess：创建成功。\nPromoteVerifying：升级确认中。\nPromoteFailed：升级失败。\nPromoteExpired：升级过期。\nPromoteCancelled：升级取消。\nPromoteSuccess：升级成功。\nInviteSuccess：邀请成功",
                "example": "CreateSuccess",
                "type": "string",
                "valueMapping": {
                  "cases": [
                    {
                      "targetValue": "CreateSuccess",
                      "value": "CreateSucceed"
                    },
                    {
                      "targetValue": "InviteSuccess",
                      "value": "InvitedSucceed"
                    },
                    {
                      "targetValue": "PromoteSuccess",
                      "value": "PromoteSucceed"
                    }
                  ]
                },
                "visibility": "Public"
              },
              "Tags": {
                "backendName": "tags",
                "description_en": "The tags",
                "description_zh": "标签",
                "itemName": "Tag",
                "items": {
                  "description_en": "The list of tags",
                  "description_zh": "标签列表",
                  "properties": {
                    "Key": {
                      "backendName": "key",
                      "description_en": "The tag key",
                      "description_zh": "标签键",
                      "example": "tag_key",
                      "type": "string"
                    },
                    "Value": {
                      "backendName": "value",
                      "description_en": "The tag value",
                      "description_zh": "标签值",
                      "example": "tag_value",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type of the member account. Valid values:\n\nCloudAccount: Cloud account.\nResourceAccount: Resource account",
                "description_zh": "成员类型。取值：\n\nCloudAccount：云账号。\nResourceAccount：资源账号",
                "example": "ResourceAccount",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "9B34724D-54B0-4A51-B34D-4512372FE1BE",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
