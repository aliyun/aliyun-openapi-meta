                "description_zh": "邮箱状态。取值：\n\n空：不存在邮箱修改记录。\nWAIT_MODIFY：正在修改中。\nCANCELLED：修改取消。\nEXPIRED：修改过期",
                "example": "WAIT_MODIFY",
                "type": "string"
              },
              "FolderId": {
                "backendName": "folderId",
                "description_en": "The ID of the folder",
                "description_zh": "资源夹ID",
