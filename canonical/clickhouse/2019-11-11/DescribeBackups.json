{
  "cmd_full_name": "clickhouse describe-backups",
  "cmd_name": "describe-backups",
  "deprecated": false,
  "description_en": "Queries the backup sets of a specified ApsaraDB for ClickHouse cluster",
  "description_zh": "查看指定云数据库ClickHouse集群的备份集",
  "kebab_example": "aliyun clickhouse describe-backups --db-cluster-id cc-bp1qx68m069810000 --start-time 2021-11-21T16:00Z --end-time 2021-11-25T16:00Z --api-version 2019-11-11 --region cn-hangzhou",
  "method": "GET|POST|PUT",
  "multi_version": true,
  "name": "DescribeBackups",
  "operation": {
    "action": "DescribeBackups",
    "api_style": "RPC",
    "api_version": "2019-11-11",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cc-bp1qx68m06981****",
      "help_en": "The cluster ID",
      "help_zh": "集群ID",
      "location": "query",
      "name": "db_cluster_id",
      "options": [
        "--db-cluster-id"
      ],
      "raw_name": "DBClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "117403****",
      "help_en": "The ID of the backup task",
      "help_zh": "备份数据任务ID",
      "location": "query",
      "name": "backup_id",
      "options": [
        "--backup-id"
      ],
      "raw_name": "BackupId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2021-11-21T16:00Z",
      "help_en": "The beginning of the time range to query. Format: yyyy-MM-ddTHH:mmZ (UTC)",
      "help_zh": "查询开始时间。格式：yyyy-MM-ddTHH:mmZ（UTC时间）",
      "location": "query",
      "name": "start_time",
      "options": [
        "--start-time"
      ],
      "raw_name": "StartTime",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2021-11-25T16:00Z",
      "help_en": "The end of the time range to query. Format: yyyy-MM-ddTHH:mmZ (UTC)",
      "help_zh": "查询结束时间。格式：yyyy-MM-ddTHH:mmZ（UTC时间）",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": true,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "The number of entries per page. Valid values:\n\n30 (default)\n50\n100",
      "help_zh": "每页记录数，取值：\n\n30（默认值）\n50\n100",
      "location": "query",
      "maximum": "100",
      "minimum": "30",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number",
      "help_zh": "页数",
      "location": "query",
      "maximum": "2147483647",
      "minimum": "1",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "clickhouse",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Items": {
            "backendName": "data.backupsetItemsCK",
            "description_en": "The list of backup sets",
            "description_zh": "备份集列表",
            "itemName": "Backup",
            "items": {
              "properties": {
                "BackupEndTime": {
                  "backendName": "backupEndTime",
                  "description_en": "The time when the backup ended.\nFormat: yyyy-MM-ddTHH:mmZ (UTC)",
                  "description_zh": "备份结束时间。\n格式：yyyy-MM-ddTHH:mmZ（UTC时间）",
                  "example": "2021-11-22T18:28:41Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupId": {
                  "backendName": "backupSetId",
                  "description_en": "The ID of the backup task",
                  "description_zh": "备份数据任务ID",
                  "example": "117403****",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupMethod": {
                  "backendName": "backupMethod",
                  "description_en": "The backup method. The value is Physical, which indicates physical backup",
                  "description_zh": "备份方式。唯一取值为Physical，代表物理备份",
                  "example": "Physical",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Logical",
                        "value": "L"
                      },
                      {
                        "targetValue": "Physical",
                        "value": "P"
                      },
                      {
                        "targetValue": "Snapshot",
                        "value": "S"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "BackupScheduleType": {
                  "backendName": "backupScheduleType",
                  "description_en": "The backup type. Valid values: manual (manual backup) and scheduled (automatic backup)",
                  "description_zh": "备份类型。取值manual（手动备份）/ scheduled（自动备份）",
                  "example": "manual",
                  "type": "string"
                },
                "BackupSetInfo": {
                  "backendName": "backupSetInfo",
                  "description_en": "The number of nodes in the cluster.\n\nSingle-replica edition: valid values: 1 to 48.\nMaster-replica cluster: valid values: 1 to 24",
                  "description_zh": "集群节点数量。\n\n单副本版，取值范围：1~48。\n双副本版，取值范围：1~24",
                  "example": "{\"shard_count\": 4}",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupSize": {
                  "backendName": "backupSetSize",
                  "description_en": "The backup size.\nUnit: MB",
                  "description_zh": "备份大小。\n单位：MB",
                  "example": "131072",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "BackupStartTime": {
                  "backendName": "backupStartTime",
                  "description_en": "The time when the backup started. Format: yyyy-MM-ddTHH:mmZ (UTC)",
                  "description_zh": "备份开始时间。格式：yyyy-MM-ddTHH:mmZ（UTC时间）",
                  "example": "2021-11-22T18:28:22Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupStatus": {
                  "backendName": "backupSetStatus",
                  "description_en": "The backup status. Valid values:\n\nSuccess: The backup is complete.\nFailure: The backup failed",
                  "description_zh": "备份状态，取值说明：\n\nSuccess：已完成。\nFailure：备份失败",
                  "example": "Success",
                  "type": "string",
                  "visibility": "Public"
                },
                "BackupType": {
                  "backendName": "backupType",
                  "description_en": "The backup type. Valid values:\n\nFullBackup: full backup.\nIncrementalBackup: incremental backup",
                  "description_zh": "备份类型，取值说明：\n\nFullBackup：全量备份。\nIncrementalBackup：增量备份",
                  "example": "IncrementalBackup",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "FullBackup",
                        "value": "F"
                      },
                      {
                        "targetValue": "IncrementalBackup",
                        "value": "I"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "DBClusterId": {
                  "backendName": "dbInstanceId",
                  "description_en": "The cluster ID",
                  "description_zh": "集群ID",
                  "example": "cc-bp1qx68m06981****",
                  "type": "string",
                  "visibility": "Public"
                },
                "ExpireDate": {
                  "backendName": "expireDate",
                  "description_en": "The expiration time of the backup set.\nFormat: yyyy-MM-ddTHH:mmZ (UTC)",
                  "description_zh": "备份集到期时间。\n格式：yyyy-MM-ddTHH:mmZ（UTC时间）",
                  "example": "2022-07-22T18:28:41Z",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "data.pageNumbers",
            "description_en": "The page number",
            "description_zh": "页数",
            "example": "1",
            "type": "string",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "data.maxRecordsPerPage",
            "description_en": "The number of entries per page. Valid values:\n\n30 (default)\n50\n100",
            "description_zh": "每页记录数，取值：\n\n30（默认值）\n50\n100",
            "example": "30",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "F5178C10-1407-4987-9133-DE4DC9119F75",
            "type": "string",
            "visibility": "Public"
          },
          "TotalCount": {
            "backendName": "data.totalRecords",
            "description_en": "The total number of entries returned",
            "description_zh": "总记录数",
            "example": "1",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
