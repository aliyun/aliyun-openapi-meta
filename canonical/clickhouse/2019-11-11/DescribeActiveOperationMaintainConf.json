                "example": "18:00Z",
                "type": "string",
                "visibility": "Public"
              },
              "ModifiedTime": {
                "backendName": "modifiedTime",
                "description_en": "The modification time",
                "description_zh": "修改时间",
                "example": "2025-06-27T07:12:53Z",
                "type": "string",
                "visibility": "Public"
              },
