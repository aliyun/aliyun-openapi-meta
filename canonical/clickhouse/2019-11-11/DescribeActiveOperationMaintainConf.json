                "description_zh": "周期时间。\n\n当CycleType为Month，返回1～28的数字，表示每月几号，用\",\"拼接。\n当CycleType为Week，返回1～7的数字，表示每周星期几，用\",\"拼接",
                "example": "1",
                "type": "string",
                "visibility": "Public"
              },
              "CycleType": {
                "backendName": "cycleType",
                "description_en": "The cycle type. Valid values:\n\nMonth: Monthly.\nWeek: Weekly",
                "description_zh": "周期类型。\n\nMonth 每月\nWeek 每周",
                "example": "Week",
                "type": "string",
                "visibility": "Public"
              },
              "MaintainEndTime": {
                "backendName": "maintainEndtime",
                "description_en": "The end time of the maintenance window",
