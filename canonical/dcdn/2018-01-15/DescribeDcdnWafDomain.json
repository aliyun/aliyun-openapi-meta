{
  "camel_example": "aliyun dcdn DescribeDcdnWafDomain --region cn-hangzhou --ResourceGroupId '/' --DomainName 'example.com' --RegionId 'cn-hangzhou'",
  "cmd_full_name": "dcdn describe-dcdn-waf-domain",
  "cmd_name": "describe-dcdn-waf-domain",
  "deprecated": false,
  "description_en": "Call DescribeDcdnWafDomain to query all accelerated domain names protected by WAF and retrieve their details, such as ACL status, CC protection status, creation status, and WAF status",
  "description_zh": "调用DescribeDcdnWafDomain查询WAF全量域名列表和开通WAF功能的加速域名的相关信息（包括加速域名ACL状态、CC状态、创建状态和WAF开通状态等）",
  "kebab_example": "aliyun dcdn describe-dcdn-waf-domain --biz-region-id cn-hangzhou --domain-name example.com --resource-group-id / --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeDcdnWafDomain",
  "operation": {
    "action": "DescribeDcdnWafDomain",
    "api_style": "RPC",
    "api_version": "2018-01-15",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "enum": [
        "cn-hangzhou",
        "ap-southeast-1"
      ],
      "example": "cn-hangzhou",
      "help_en": "The ID of the region where the WAF instance is deployed. You can set this to `cn-hangzhou` (the default). At present, you can only set this to `cn-hangzhou`",
      "help_zh": "WAF管控区域",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "example.com",
      "help_en": "The accelerated domain name to query. If you omit this parameter, the operation returns information about all accelerated domain names",
      "help_zh": "加速域名。若参数为空，则返回所有加速域名",
      "location": "query",
      "name": "domain_name",
      "options": [
        "--domain-name"
      ],
      "raw_name": "DomainName",
      "required": false,
      "type": "string"
    },
    {
      "example": "/",
      "help_en": "The ID of the resource group. If you do not specify this parameter, the system queries the default resource group",
      "help_zh": "资源组。若参数为空，代表默认资源组",
      "location": "query",
      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "dcdn",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "OutPutDomains": {
            "backendName": "data.content.domains",
            "description_en": "Details about the accelerated domain names",
            "description_zh": "加速域名信息",
            "itemName": "OutPutDomain",
            "items": {
              "properties": {
                "AclStatus": {
                  "backendName": "AclStatus",
                  "description_en": "The ACL status.\n\n0: Disabled.\n\n1: Enabled",
                  "description_zh": "ACL状态。\n\n0：关闭。\n1：开通",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "CcStatus": {
                  "backendName": "CcStatus",
                  "description_en": "The CC protection status.\n\n0: Disabled.\n\n1: Enabled",
                  "description_zh": "CC状态。\n\n0：关闭。\n1：开通",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "Domain": {
                  "backendName": "Domain",
                  "description_en": "The accelerated domain name",
                  "description_zh": "开通了WAF的加速域名",
                  "example": "example.com",
                  "type": "string"
                },
                "Status": {
                  "backendName": "Status",
                  "description_en": "The creation status of the domain name:\n\n1: Active.\n\n10: Creating.\n\n11: Creation failed",
                  "description_zh": "域名创建状态：\n\n1：域名创建成功/域名有效。\n10：域名创建中。\n11：域名创建失败",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "WafStatus": {
                  "backendName": "WafStatus",
                  "description_en": "The WAF status.\n\n0: Disabled.\n\n1: Enabled",
                  "description_zh": "WAF状态。\n\n0：关闭。\n1：开通",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "CB1A380B-09F0-41BB-802B-72F8FD6DA2FE",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.content.count",
            "description_en": "The total number of accelerated domain names returned",
            "description_zh": "加速域名数量",
            "example": "1",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
