      "name": "defense_scene",
      "options": [
        "--defense-scene"
      ],
      "raw_name": "DefenseScene",
      "required": true,
      "type": "string"
    },
    {
      "example": "example.com",
      "help_en": "The protected DCDN domain name. Fuzzy queries are supported",
      "help_zh": "防护域名，支持模糊查询",
