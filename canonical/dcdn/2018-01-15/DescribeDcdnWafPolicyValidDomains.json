      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "20",
      "help_en": "The number of domain names to display on each page. Default value: 20. Valid values: an integer from 1 to 500",
      "help_zh": "每页显示的域名个数，默认值20，取值范围：1~500之间的任意整数",
      "location": "query",
      "maximum": "500",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    }
