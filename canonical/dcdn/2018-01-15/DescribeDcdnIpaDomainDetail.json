{
  "camel_example": "aliyun dcdn DescribeDcdnIpaDomainDetail --region cn-hangzhou --DomainName 'example.com'",
  "cmd_full_name": "dcdn describe-dcdn-ipa-domain-detail",
  "cmd_name": "describe-dcdn-ipa-domain-detail",
  "deprecated": false,
  "description_en": "Call DescribeDcdnIpaDomainDetail to get the basic configuration of a specified accelerated domain name",
  "description_zh": "调用DescribeDcdnIpaDomainDetail获取指定加速域名配置的基本信息",
  "kebab_example": "aliyun dcdn describe-dcdn-ipa-domain-detail --domain-name example.com --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeDcdnIpaDomainDetail",
  "operation": {
    "action": "DescribeDcdnIpaDomainDetail",
    "api_style": "RPC",
    "api_version": "2018-01-15",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "example.com",
      "help_en": "The domain name accelerated by IP Application Accelerator (IPA). You can query only one domain name at a time",
      "help_zh": "接入全站加速IPA进行加速的域名，仅支持单个查询",
      "location": "query",
      "name": "domain_name",
      "options": [
        "--domain-name"
      ],
      "raw_name": "DomainName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "dcdn",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "DomainDetail": {
            "backendName": "data",
            "description_en": "The details of the domain name",
            "description_zh": "域名详情",
            "properties": {
              "CertName": {
                "backendName": "certName",
                "description_en": "The name of the certificate if HTTPS is enabled",
                "description_zh": "如果开启HTTPS，此处为证书名称",
                "example": "yourCertName",
                "type": "string"
              },
              "Cname": {
                "backendName": "cname",
                "description_en": "The CNAME of the domain name",
                "description_zh": "CNAME",
                "example": "example.com",
                "type": "string"
              },
              "Description": {
                "backendName": "remark",
                "description_en": "The description",
                "description_zh": "描述",
                "example": "audit failed",
                "type": "string"
              },
              "DomainName": {
                "backendName": "domainNameReal",
                "description_en": "The domain name that is accelerated by IPA",
                "description_zh": "接入全站加速IPA进行加速的域名",
                "example": "example.com",
                "type": "string"
              },
              "DomainStatus": {
                "backendName": "domainStatus",
                "description_en": "The status of the accelerated domain name. Valid values:\n\nonline: enabled.\n\noffline: disabled.\n\nconfiguring: configuring.\n\nconfigure_failed: configuration failed.\n\nchecking: under review.\n\ncheck_failed: review failed",
                "description_zh": "加速域名运行状态。取值：\n\nonline：启用。\n\noffline：停用。\n\nconfiguring：配置中。\n\nconfigure_failed：配置失败。\n\nchecking：正在审核。\n\ncheck_failed：审核失败",
                "example": "online",
                "type": "string"
              },
              "GmtCreated": {
                "backendName": "gmtCreated",
                "description_en": "The time when the domain name was created",
                "description_zh": "创建时间",
                "example": "2017-11-27T06:51:26Z",
                "type": "string"
              },
              "GmtModified": {
                "backendName": "gmtModified",
                "description_en": "The time when the domain name was last modified",
                "description_zh": "最近修改时间",
                "example": "2017-11-27T06:51:26Z",
                "type": "string"
              },
              "ResourceGroupId": {
                "backendName": "resourceGroupId",
                "description_en": "The ID of the resource group",
                "description_zh": "资源组ID",
                "example": "rg-acfmyuji4b6xxxx",
                "type": "string"
              },
              "SSLProtocol": {
                "backendName": "sslProtocol",
                "description_en": "Indicates whether an SSL certificate is enabled. Valid values:\n\non: enabled.\n\noff: disabled",
                "description_zh": "是否开启SSL证书。取值：\non：开启。\noff：关闭",
                "example": "on",
                "type": "string"
              },
              "SSLPub": {
                "backendName": "sslPub",
                "description_en": "The public key of the certificate if HTTPS is enabled",
                "description_zh": "如果开启HTTPS，此处为证书公钥",
                "example": "SSLPub",
                "type": "string"
              },
              "Scope": {
                "backendName": "scope",
                "description_en": "The acceleration region. Valid values:\n\ndomestic: the Chinese mainland only.\n\noverseas: global (excluding the Chinese mainland).\n\nglobal: global",
                "description_zh": "加速区域。取值：\n\ndomestic：仅中国内地。\n\noverseas：全球（不包含中国内地）。\n\nglobal：全球",
                "example": "overseas",
                "type": "string"
              },
              "Sources": {
                "backendName": "sources",
                "itemName": "Source",
                "items": {
                  "properties": {
                    "Content": {
                      "backendName": "content",
                      "type": "string"
                    },
                    "Enabled": {
                      "backendName": "enabled",
                      "type": "string"
                    },
                    "Port": {
                      "backendName": "port",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Priority": {
                      "backendName": "priority",
                      "type": "string"
                    },
                    "Type": {
                      "backendName": "type",
                      "type": "string"
                    },
                    "Weight": {
                      "backendName": "weight",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": true,
                "type": "array"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "09ABE829-6CD3-4FE0-AFEE-556113E29727",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
