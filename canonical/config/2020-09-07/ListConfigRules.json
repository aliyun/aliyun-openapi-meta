                            "description_zh": "规则的标签键",
                            "example": "env",
                            "type": "string"
                          },
                          "Value": {
                            "backendName": "value",
                            "description_en": "The tag value of the rule",
                            "description_zh": "规则的标签值",
                            "example": "prod",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
