                      "example": "acs:config::100931896542****:rule/cr-fdc8626622af00f9****",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "ConfigRuleId": {
                      "backendName": "configRuleId",
                      "description_en": "The rule ID",
                      "description_zh": "规则ID",
                      "example": "cr-fdc8626622af00f9****",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "ConfigRuleName": {
                      "backendName": "configRuleName",
                      "description_en": "The name of the rule",
