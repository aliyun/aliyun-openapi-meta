                      "example": "ACS::EIP::EipAddress",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "RiskLevel": {
                      "backendName": "riskLevel",
                      "description_en": "The risk level of the rule. Valid values:\n\n1: High risk.\n\n2: Medium risk.\n\n3: Low risk",
                      "description_zh": "规则风险等级。取值：\n1：高风险。\n2：中风险。\n3：低风险",
                      "example": "1",
                      "format": "int32",
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "SourceIdentifier": {
                      "backendName": "sourceIdentifier",
                      "description_en": "The identifier of the rule.\n\nIf the rule is a managed rule, this parameter indicates the identifier of the managed rule.\n\nIf the rule is a custom rule, this parameter indicates the Alibaba Cloud Resource Name (ARN) of the function",
                      "description_zh": "规则标识符。\n如果是规则模板，该参数为规则模板标识。\n如果是自定义规则，该参数为函数ARN",
                      "example": "eip-bandwidth-limit",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "SourceOwner": {
                      "backendName": "sourceOwner",
                      "description_en": "The owner of the rule. Valid values:\n\nCUSTOM_FC: a custom rule created using a Function Compute (FC) function.\n\nALIYUN: a managed rule",
                      "description_zh": "规则来源的归属。取值：\nCUSTOM_FC：自定义规则。\nALIYUN：规则模板",
                      "example": "ALIYUN",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Tags": {
                      "backendName": "tags",
                      "description_en": "The tags of the rule",
                      "description_zh": "规则的标签",
                      "itemName": "tag",
                      "items": {
                        "description_en": "The tags of the rule",
                        "description_zh": "规则的标签",
                        "properties": {
                          "Key": {
                            "backendName": "key",
