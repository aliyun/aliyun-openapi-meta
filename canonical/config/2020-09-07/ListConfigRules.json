                "items": {
                  "description_en": "The details of the rules",
                  "description_zh": "规则列表详细信息",
                  "properties": {
                    "AccountId": {
                      "backendName": "accountId",
                      "description_en": "The ID of the account to which the rule belongs",
                      "description_zh": "规则归属的账号ID",
                      "example": "100931896542****",
                      "format": "int64",
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "AutomationType": {
                      "backendName": "automationInfo.automationType",
                      "description_en": "The remediation type. Only Operation Orchestration Service (OOS) is supported",
                      "description_zh": "修正类型。仅支持OOS（运维编排）",
                      "example": "OOS",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Compliance": {
                      "backendName": "compliance",
                      "description_en": "The compliance aggregation results of the rule",
                      "description_zh": "规则的合规聚合结果",
