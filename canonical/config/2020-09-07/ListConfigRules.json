            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "traceId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "AC3A7E12-72E6-5CC9-A5C1-D8D8919829A7",
            "type": "string",
            "visibility": "Public"
