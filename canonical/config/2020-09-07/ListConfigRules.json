                      "type": "string",
                      "visibility": "Public"
                    },
                    "ConfigRuleState": {
                      "backendName": "configRuleState",
                      "description_en": "The state of the rule. Valid values:\n\nACTIVE: The rule is enabled.\n\nDELETING: The rule is being deleted.\n\nEVALUATING: The rule is being evaluated.\n\nINACTIVE: The rule is disabled",
                      "description_zh": "规则运行状态。取值：\nACTIVE：应用中。\nDELETING：删除中。\nEVALUATING：评估中。\nINACTIVE：已停用",
                      "example": "ACTIVE",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "CreateBy": {
                      "backendName": "createBy",
                      "description_en": "The information about the creator of the rule",
                      "description_zh": "创建规则的信息",
                      "properties": {
                        "CompliancePackId": {
                          "backendName": "compliancePackId",
                          "description_en": "The ID of the compliance package",
                          "description_zh": "合规包ID",
                          "example": "cp-fdc8626622af00f9****",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "CompliancePackName": {
                          "backendName": "compliancePackName",
                          "description_en": "The name of the compliance package",
                          "description_zh": "合规包名称",
                          "example": "The name of the compliance package.",
                          "type": "string",
                          "visibility": "Public"
                        }
                      },
                      "type": "object",
                      "visibility": "Public"
                    },
                    "CreateDate": {
                      "backendName": "createDate",
                      "description_en": "The time when the rule was created. The time is displayed in UTC+8",
                      "description_zh": "规则创建时间(UTC+8)",
                      "example": "2025-09-19T15:51:00",
