                        "ComplianceType": {
                          "backendName": "complianceType",
                          "description_en": "The summary of the compliance evaluation result. Valid values:\n\nCOMPLIANT: Compliant.\n\nNON_COMPLIANT: Non-compliant.\n\nNOT_APPLICABLE: Not applicable.\n\nINSUFFICIENT_DATA: Insufficient data",
                          "description_zh": "规则合规评估的摘要结果。取值：\nCOMPLIANT：合规。\nNON_COMPLIANT：不合规。\nNOT_APPLICABLE：不适用。\nINSUFFICIENT_DATA：无数据",
                          "example": "COMPLIANT",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Count": {
                          "backendName": "count",
                          "description_en": "The number of evaluated resources that correspond to the compliance summary",
                          "description_zh": "规则评估的摘要结果对应的评估数量",
                          "example": "2",
                          "format": "int32",
                          "type": "integer",
                          "visibility": "Public"
                        }
                      },
                      "type": "object",
                      "visibility": "Public"
                    },
                    "ConfigRuleArn": {
                      "backendName": "configRuleArn",
