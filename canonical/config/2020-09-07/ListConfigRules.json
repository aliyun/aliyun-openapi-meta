                "backendName": "pageNumber",
                "description_en": "The page number",
                "description_zh": "页码",
                "example": "1",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "PageSize": {
                "backendName": "pageSize",
                "description_en": "The number of entries returned per page",
                "description_zh": "分页时每页显示的数据行数",
                "example": "10",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "TotalCount": {
                "backendName": "totalCount",
                "description_en": "The total number of rules",
                "description_zh": "规则总数",
                "example": "1",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              }
