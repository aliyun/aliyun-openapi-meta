                      "required": false,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Description": {
                      "backendName": "description",
                      "description_en": "The description of the rule",
                      "description_zh": "规则描述",
                      "example": "The description of the rule.",
                      "type": "string",
                      "visibility": "Public"
                    },
