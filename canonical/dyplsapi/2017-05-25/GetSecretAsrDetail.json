{
  "camel_example": "",
  "cmd_full_name": "dyplsapi get-secret-asr-detail",
  "cmd_name": "get-secret-asr-detail",
  "deprecated": false,
  "description_en": "Obtains the details of the automatic speech recognition (ASR) result",
  "description_zh": "获取ASR识别结果详情",
  "kebab_example": "aliyun dyplsapi get-secret-asr-detail --call-id 2256250000 --call-time 2019-03-05_12:00:00 --pool-key FC22670000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetSecretAsrDetail",
  "operation": {
    "action": "GetSecretAsrDetail",
    "api_style": "RPC",
    "api_version": "2017-05-25",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "225625****",
      "help_en": "The ID of the call record.\n\nYou can log on to the Phone Number Protection console (https://dypls.console.aliyun.com/dypls.htm#/account) and view Call Record ID on the Call Record Query page",
      "help_zh": "呼叫记录ID，用于标识一条通话记录。\n\n获取方式如下：\n在控制台呼叫记录查询 (https://dyplsnext.console.aliyun.com/call)页面进行查询，获取呼叫记录ID。\n在录音状态报告回执消息中查看call_id字段",
      "location": "query",
      "name": "call_id",
      "options": [
        "--call-id"
      ],
      "raw_name": "CallId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2019-03-05 12:00:00",
      "help_en": "The call initiation time in the call record.\n\nYou can log on to the Phone Number Protection console (https://dypls.console.aliyun.com/dypls.htm#/account). View Call Initiated At on the Call Record Query page, or view the call_time field in the Call Detail Record (CDR) receipt",
      "help_zh": "呼叫记录中的呼叫发起时间。\n\n获取方式如下：\n\n在控制台呼叫记录查询 (https://dyplsnext.console.aliyun.com/call)页面进行查询，获取呼叫时间列的呼叫发起时间。\n在录音状态报告回执消息中查看call_time字段。\n\nCallTime不支持传入时间戳格式的参数",
      "location": "query",
      "name": "call_time",
      "options": [
        "--call-time"
      ],
      "raw_name": "CallTime",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "FC2267****",
      "help_en": "The key of the phone number pool.\n\nYou can log on to the Phone Number Protection console (https://dypls.console.aliyun.com/dypls.htm#/account) and view the key of the phone number pool on the Number Pool Management page",
      "help_zh": "号码池Key。\n\n在号码隐私保护控制台，号码池管理 (https://dyplsnext.console.aliyun.com/number-pool)页面获取号码池Key",
      "location": "query",
      "name": "pool_key",
      "options": [
        "--pool-key"
      ],
      "raw_name": "PoolKey",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Dyplsapi",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_zh": "返回数据",
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The response code",
            "description_zh": "错误码",
            "example": "OK",
            "type": "string",
            "visibility": "Public"
          },
          "Data": {
            "backendName": "module",
            "description_en": "The ASR details",
            "description_zh": "ASR详情实体类信息",
            "example": "{\"bizDuration\":10944,\"businessId\":\"435ee78c7a019650@!FC100000074672458@!20200615225802\",\"businessKey\":\"JCGTncltuNaolegJ\",\"code\":\"21050000\",\"msg\":\"SUCCESS\",\"requestId\":\"8d2329d407a83447a83be441681f4872ac74nE\",\"sentences\":[{\"beginTime\":1020,\"channelId\":0,\"emotionValue\":\"5.7\",\"endTime\":1770,\"silenceDuration\":\"0\",\"speechRate\":\"80\",\"text\":\"喂\"}],\"success\":true,\"type\":\"asrResult\"}",
            "properties": {
              "BizDuration": {
                "backendName": "bizDuration",
                "description_en": "The total duration of the audio file that was recognized. Unit: milliseconds",
                "description_zh": "识别的音频文件总时长，单位：毫秒",
                "example": "10944",
                "format": "int64",
                "type": "integer"
              },
              "BusinessId": {
                "backendName": "businessId",
                "description_en": "The ID of the business process",
                "description_zh": "业务流程的ID",
                "example": "435ee78c7a******@!FC100000074******@!2020061522****",
                "type": "string"
              },
              "BusinessKey": {
                "backendName": "businessKey",
                "description_en": "The business keyword",
                "description_zh": "业务关键字",
                "example": "JCGTncltuNao****",
                "type": "string"
              },
              "Code": {
                "backendName": "code",
                "description_en": "The status code. The status code 21050000 indicates that the request was successful",
                "description_zh": "状态码。21050000表示请求成功",
                "example": "21050000",
                "type": "string"
              },
              "Msg": {
                "backendName": "msg",
                "description_en": "The description",
                "description_zh": "描述信息",
                "example": "SUCCESS",
                "type": "string"
              },
              "RequestId": {
                "backendName": "requestId",
                "description_en": "The request ID",
                "description_zh": "请求ID",
                "example": "8d2329d407a83447a83be441681f4872ac74nE",
                "type": "string"
              },
              "Sentences": {
                "backendName": "sentences",
                "description_en": "The ASR result",
                "description_zh": "ASR识别结果",
                "itemName": "SecretAsrSentenceDTO",
                "items": {
                  "description_zh": "ASR识别结果",
                  "properties": {
                    "BeginTime": {
                      "backendName": "beginTime",
                      "description_en": "The start time offset of the sentence. Unit: milliseconds",
                      "description_zh": "该句的起始时间偏移，单位：毫秒",
                      "example": "1020",
                      "format": "int64",
                      "type": "integer"
                    },
                    "ChannelId": {
                      "backendName": "channelId",
                      "description_en": "The ID of the audio track to which the sentence belongs",
                      "description_zh": "该句所属音轨ID",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "EmotionValue": {
                      "backendName": "emotionValue",
                      "description_en": "The emotion value. Value range: 1 to 10. The higher the value, the stronger the emotion",
                      "description_zh": "情绪能量值，取值：1~10，值越高情绪越强烈",
                      "example": "5.7",
                      "type": "string"
                    },
                    "EndTime": {
                      "backendName": "endTime",
                      "description_en": "The end time offset of the sentence. Unit: milliseconds",
                      "description_zh": "该句的结束时间偏移，单位：毫秒",
                      "example": "1770",
                      "format": "int64",
                      "type": "integer"
                    },
                    "SilenceDuration": {
                      "backendName": "silenceDuration",
                      "description_en": "The silence duration between the current sentence and the previous sentence. Unit: seconds",
                      "description_zh": "本句和上一句之间的静音时长，单位：秒",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "SpeechRate": {
                      "backendName": "speechRate",
                      "description_en": "The average speech rate of the sentence. Unit: number of words per minute",
                      "description_zh": "本句的平均语速，单位为每分钟字数",
                      "example": "80",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Text": {
                      "backendName": "text",
                      "description_en": "The recognition result of the sentence",
                      "description_zh": "该句的识别文本结果",
                      "example": "您好",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type",
                "description_zh": "类型",
                "example": "asrResult",
                "type": "string"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The returned message",
            "description_zh": "错误码描述",
            "example": "OK",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "F655A8D5-B967-440B-8683-DAD6FF8DE990",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
