{
  "cmd_full_name": "openanalytics-open list-spark-job",
  "cmd_name": "list-spark-job",
  "deprecated": false,
  "description_en": "Retrieves historical job details of a Data Lake Analytics (DLA) Spark virtual cluster by page",
  "description_zh": "分页提取某个数据湖分析Spark虚拟集群的历史作业详情信息",
  "kebab_example": "aliyun openanalytics-open list-spark-job --vc-name MySparkCluster --page-number 1 --page-size 10 --api-version 2018-06-19 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "ListSparkJob",
  "operation": {
    "action": "ListSparkJob",
    "api_style": "RPC",
    "api_version": "2018-06-19",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "MySparkCluster",
      "help_en": "The name of the virtual cluster that runs Spark jobs",
      "help_zh": "执行Spark作业的虚拟集群名称",
      "location": "query",
      "name": "vc_name",
      "options": [
        "--vc-name"
      ],
      "raw_name": "VcName",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "1",
      "help_en": "The page number. Pages start from page 1. This parameter is used to traverse all data",
      "help_zh": "指定需要查询的页码号，用于遍历全部数据，页码的编码从1开始",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": true,
      "type": "int"
    },
    {
      "doc_required": true,
      "example": "10",
      "help_en": "The number of jobs to return on each page",
      "help_zh": "每页返回的作业的个数",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": true,
      "type": "int"
    },
    {
      "example": "{   \"createTime\":\"2020-12-28 09:00:00\",   \"jobName\":\"SparkPi\" }",
      "help_en": "The filter condition for retrieving historical job details of the Spark virtual cluster. If you leave this parameter empty, no filter condition is applied",
      "help_zh": "提取Spark虚拟集群的历史作业详情信息的过滤条件，不填写表示没有过滤条件",
      "location": "query",
      "name": "condition",
      "options": [
        "--condition"
      ],
      "param_style": "json",
      "raw_name": "Condition",
      "required": false,
      "type": "map",
      "value": {
        "type": "any"
      }
    }
  ],
  "pathPattern": "",
  "product_code": "openanalytics-open",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "DataResult": {
            "backendName": "data",
            "description_en": "The list of historical job results of the virtual cluster",
            "description_zh": "虚拟集群的历史作业结果列表",
            "nullToEmpty": false,
            "properties": {
              "JobList": {
                "backendName": "items",
                "description_en": "The array of historical job details",
                "description_zh": "历史作业详情数组",
                "itemName": "Data",
                "items": {
                  "properties": {
                    "CreateTime": {
                      "backendName": "createTime",
                      "description_en": "The time when the Spark job was created. The time zone is the time zone of the region where the cluster resides",
                      "description_zh": "创建Spark作业的时间点，时区为该集群所在的地域的时区",
                      "example": "2020-10-27 17:51:05",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "CreateTimeValue": {
                      "backendName": "createTimeValue",
                      "description_en": "The timestamp in milliseconds when the Spark job was created",
                      "description_zh": "创建Spark作业的毫秒级时间戳",
                      "example": "1603792267000",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Detail": {
                      "backendName": "detail",
                      "description_en": "The JSON-formatted string that describes the job",
                      "description_zh": "描述此作业的JSON格式的字符串",
