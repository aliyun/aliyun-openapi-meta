                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "DriverResourceSpec": {
                      "backendName": "driverResourceSpec",
                      "description_en": "The instance specifications of the driver requested by the job",
                      "description_zh": "作业所申请的Driver的实例规格",
                      "example": "small",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "ExecutorInstances": {
                      "backendName": "executorInstances",
                      "description_en": "The number of executors requested by the job",
                      "description_zh": "作业所申请的Executor的数量",
                      "example": "100",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "ExecutorResourceSpec": {
                      "backendName": "executorResourceSpec",
                      "description_en": "The resource specifications of the executor requested by the job",
                      "description_zh": "作业所申请的Executor的规格",
                      "example": "small",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "JobId": {
                      "backendName": "jobId",
                      "description_en": "The ID of the Spark job",
                      "description_zh": "Spark作业的ID",
                      "example": "j202010271750hangzhouf742a4330000950",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "JobName": {
                      "backendName": "jobName",
                      "description_en": "The name of the Spark job",
                      "description_zh": "Spark作业的名称",
                      "example": "SparkPi",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "SparkUI": {
                      "backendName": "sparkUI",
                      "description_en": "The Spark UI of the job. For more information, refer to [Spark UI]（https://help.aliyun.com/document_detail/163470.html） in References",
                      "description_zh": "Spark作业的UI，具体请参考文档[Spark UI]（https://help.aliyun.com/document_detail/163470.html）",
                      "example": "https://dlaui-cn-hangzhou.aliyuncs.com/?token=xxx",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Status": {
                      "backendName": "status",
                      "description_en": "The status code of the job",
                      "description_zh": "作业的状态码",
                      "example": "running",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "SubmitTime": {
                      "backendName": "submitTime",
                      "description_en": "The time when the job was submitted. The time zone is the time zone of the region where the cluster resides",
                      "description_zh": "提交作业的时间，时区为该集群所在的地域的时区",
                      "example": "2020-10-27 17:51:05",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "SubmitTimeValue": {
                      "backendName": "submitTimeValue",
                      "description_en": "The timestamp in milliseconds when the job was submitted",
                      "description_zh": "提交作业的毫秒级时间戳",
                      "example": "1603792267000",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "UpdateTime": {
                      "backendName": "updateTime",
                      "description_en": "The time when the job status was last updated. The time zone is the time zone of the region where the cluster resides",
                      "description_zh": "最后一次更新作业状态的时间，时区为该集群所在的地域的时区",
                      "example": "2020-10-27 17:51:05",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "UpdateTimeValue": {
                      "backendName": "updateTimeValue",
                      "description_en": "The timestamp in milliseconds when the job status was last updated",
                      "description_zh": "最后一次更新作业状态的毫秒级时间戳",
                      "example": "1603792267000",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    },
                    "VcName": {
                      "backendName": "vcName",
                      "description_en": "The name of the virtual cluster that runs the job",
                      "description_zh": "执行作业的虚拟集群名称",
                      "example": "MyCluster",
                      "nullToEmpty": true,
                      "type": "string",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": true,
                "type": "array",
                "visibility": "Public"
              },
              "PageNumber": {
                "backendName": "pageNumber",
                "description_en": "The page number of the returned page",
                "description_zh": "当前请求返回的页码",
                "example": "1",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "PageSize": {
                "backendName": "pageSize",
                "description_en": "The number of jobs returned per page",
                "description_zh": "当前请求返回的每页作业数量",
                "example": "10",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              },
              "TotalCount": {
                "backendName": "totalCount",
                "description_en": "The total number of historical jobs that can be queried",
                "description_zh": "当前可查询的历史作业的总数",
                "example": "4998",
                "nullToEmpty": true,
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The unique ID of the request",
            "description_zh": "本次请求的唯一编码",
            "example": "E18B0634-F003-486A-90B9-4AA6932DA3AA",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
