{
  "apis": {
    "CancelSparkStatement": {
      "cmd_name": "cancel-spark-statement",
      "deprecated": false,
      "description_en": "Stops the execution of a code block",
      "description_zh": "终止一个代码块的执行"
    },
    "CreateInstance": {
      "cmd_name": "create-instance",
      "deprecated": false,
      "description_en": "Creates an instance by calling CreateInstance",
      "description_zh": "调用CreateInstance创建实例"
    },
    "ExecuteSparkStatement": {
      "cmd_name": "execute-spark-statement",
      "deprecated": false,
      "description_en": "Submits a code block to a Spark job for execution",
      "description_zh": "提交一段代码块给Spark作业执行"
    },
    "GetJobAttemptLog": {
      "cmd_name": "get-job-attempt-log",
      "deprecated": false,
      "description_en": "Retrieves the log of a specified JobAttempt",
      "description_zh": "获取对应JobAttempt的日志"
    },
    "GetJobDetail": {
      "cmd_name": "get-job-detail",
      "deprecated": false,
      "description_en": "Calls GetJobDetail to retrieve the details of a Spark job",
      "description_zh": "调用GetJobDetail获取Spark作业的详细信息"
    },
    "GetJobLog": {
      "cmd_name": "get-job-log",
      "deprecated": false,
      "description_en": "Retrieves the log of a Spark job",
      "description_zh": "获取Spark作业的日志"
    },
    "GetJobStatus": {
      "cmd_name": "get-job-status",
      "deprecated": false,
      "description_en": "Retrieves the execution status of a Spark job",
      "description_zh": "获取Spark作业的执行状态"
    },
    "GetSparkSessionState": {
      "cmd_name": "get-spark-session-state",
      "deprecated": false,
      "description_en": "Retrieves the status of an interactive Spark job",
      "description_zh": "获取可交互Spark作业的状态"
    },
    "GetSparkStatement": {
      "cmd_name": "get-spark-statement",
      "deprecated": false,
      "description_en": "Retrieves the execution status of a specified code block",
      "description_zh": "获取指定代码块的执行状态"
    },
    "KillSparkJob": {
      "cmd_name": "kill-spark-job",
      "deprecated": false,
      "description_en": "Calls KillSparkJob to forcefully stop a running Spark job",
      "description_zh": "调用KillSparkJob强行停止一个运行中的Spark作业"
    },
    "ListSparkJob": {
      "cmd_name": "list-spark-job",
      "deprecated": false,
      "description_en": "Retrieves historical job details of a Data Lake Analytics (DLA) Spark virtual cluster by page",
      "description_zh": "分页提取某个数据湖分析Spark虚拟集群的历史作业详情信息"
    },
    "ListSparkJobAttempt": {
      "cmd_name": "list-spark-job-attempt",
      "deprecated": false,
      "description_en": "Retrieves all JobAttempt information for a specified job",
      "description_zh": "获取一个Job对应的所有JobAttempt信息"
    },
    "ListSparkStatements": {
      "cmd_name": "list-spark-statements",
      "deprecated": false,
      "description_en": "Retrieves the execution status of all code blocks in a Spark session",
      "description_zh": "获取Spark Session的所有代码块的执行状态"
    },
    "ReleaseInstance": {
      "cmd_name": "release-instance",
      "deprecated": false,
      "description_en": "Releases an instance",
      "description_zh": "调用ReleaseInstance释放实例"
    },
    "SubmitSparkJob": {
      "cmd_name": "submit-spark-job",
      "deprecated": false,
      "description_en": "Submits a Spark job",
      "description_zh": "提交Spark作业"
    },
    "SubmitSparkSQL": {
      "cmd_name": "submit-spark-sql",
      "deprecated": false,
      "description_en": "Submits a Spark SQL job",
      "description_zh": "提交SubmitSQL作业"
    },
    "ValidateVirtualClusterName": {
      "cmd_name": "validate-virtual-cluster-name",
      "deprecated": false,
      "description_en": "Calls ValidateVirtualClusterName to check whether a virtual cluster name is valid",
