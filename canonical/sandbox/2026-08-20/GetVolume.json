{
  "camel_example": "",
  "cmd_full_name": "sandbox get-volume",
  "cmd_name": "get-volume",
  "components": {
    "schemas": {
      "AgenticBucketVolumeConfig": {
        "description_zh": "AgenticBucket Volume配置",
        "properties": {
          "agenticBucket": {
            "backendName": "agenticBucket",
            "description_zh": "AgenticBucket名称",
            "example": "workspace01",
            "type": "string"
          },
          "bucketName": {
            "backendName": "bucketName",
            "description_zh": "OSS Bucket名称",
            "example": "sandbox-test",
            "type": "string"
          },
          "bucketPath": {
            "backendName": "bucketPath",
            "description_zh": "挂载的OSS Bucket路径",
            "example": "/",
            "type": "string"
          },
          "endpoint": {
            "backendName": "endpoint",
            "description_zh": "OSS 接入点地址",
            "example": "https://oss-cn-hangzhou.aliyuncs.com",
            "type": "string"
          },
          "readOnly": {
            "backendName": "readOnly",
            "description_zh": "挂载OSS Bucket后，挂载目录的访问权限是否为只读。取值说明如下：\ntrue：只读。\nfalse：读写",
            "example": "true",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "AgenticFSVolumeConfig": {
        "description_en": "The AgenticFS Volume configuration",
        "description_zh": "AgenticFS Volume配置",
        "properties": {
          "accessPointID": {
            "backendName": "accessPointID",
            "description_en": "The access point ID",
            "description_zh": "接入点ID",
            "example": "ap-xxxx",
            "type": "string"
          },
          "agenticSpaceID": {
            "backendName": "agenticSpaceID",
            "description_en": "The workspace ID",
            "description_zh": "工作空间ID",
            "example": "agentic-xxxx",
            "type": "string"
          },
          "fileSystemID": {
            "backendName": "fileSystemID",
            "description_en": "The file system ID",
            "description_zh": "文件系统ID",
            "example": "03204sl2qjiax4ocdt2",
            "type": "string"
          },
          "groupID": {
            "backendName": "groupID",
            "description_en": "The group ID for local mounting",
            "description_zh": "本地挂载的GroupID",
            "example": "1000",
            "format": "int32",
            "type": "integer"
          },
          "serverAddr": {
            "backendName": "serverAddr",
            "description_en": "The AgenticFS access point address",
            "description_zh": "AgenticFS 接入点地址",
            "example": "ap-xxxx.03204sl2qjiax4ocdt2-ljs60.cn-shanghai.nas.aliyuncs.com",
            "type": "string"
          },
          "userID": {
            "backendName": "userID",
            "description_en": "The user ID for local mounting",
            "description_zh": "本地挂载的UserID",
            "example": "1000",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "E2BVolume": {
        "description_en": "The volume configuration",
        "description_zh": "Volume 配置",
        "properties": {
          "agenticBucketVolumeConfig": {
            "$ref": "#/components/schemas/AgenticBucketVolumeConfig",
            "backendName": "agenticBucketVolumeConfig",
            "description_en": "The AgenticBucket volume configuration",
            "description_zh": "AgenticBucket Volume配置"
          },
          "agenticFSVolumeConfig": {
            "$ref": "#/components/schemas/AgenticFSVolumeConfig",
            "backendName": "agenticFSVolumeConfig",
            "description_en": "The AgenticFS volume configuration",
            "description_zh": "AgenticFS Volume配置"
          },
          "createdAt": {
            "backendName": "createdAt",
            "description_en": "The time when the volume was created, in UTC. The time is in the yyyy-MM-ddTHH:mm:ss.SSSSSSZ format, with exactly 6 decimal places for fractional seconds (microsecond precision)",
            "description_zh": "存储卷的创建时间，为 UTC 时间，格式为 yyyy-MM-ddTHH:mm:ss.SSSSSSZ，小数秒固定 6 位（微秒精度）",
            "example": "2026-09-07T02:12:36.531000Z",
            "type": "string"
          },
          "juiceFSVolumeConfig": {
            "$ref": "#/components/schemas/JuiceFSVolumeConfig",
            "backendName": "juiceFSVolumeConfig",
            "description_en": "The JuiceFS volume configuration",
            "description_zh": "JuiceFS Volume 配置"
          },
          "mountConfig": {
            "$ref": "#/components/schemas/VolumeMountConfig",
            "backendName": "mountConfig",
            "description_en": "The mount configuration",
            "description_zh": "挂载配置"
          },
          "ossVolumeConfig": {
            "$ref": "#/components/schemas/OSSVolumeConfig",
            "backendName": "ossVolumeConfig",
            "description_en": "The OSS volume configuration",
            "description_zh": "OSS Volume配置"
          },
          "resourceGroupID": {
            "backendName": "resourceGroupID",
            "description_en": "The resource group ID",
            "description_zh": "资源组 ID",
            "example": "rg-****",
            "type": "string"
          },
          "status": {
            "backendName": "status",
            "description_en": "The volume status. Valid values:\nAVAILABLE",
            "description_zh": "Volume 状态\nAVAILABLE",
            "example": "AVAILABLE",
            "type": "string"
          },
          "statusReason": {
            "backendName": "statusReason",
            "description_en": "The status reason",
            "description_zh": "状态原因",
            "example": "无",
            "type": "string"
          },
          "storageClass": {
            "backendName": "storageClass",
            "description_en": "The storage type. Valid values:\nOSS\nAGENTIC_FS",
            "description_zh": "存储类型：\nOSS\nAGENTIC_FS",
            "example": "OSS",
            "type": "string"
          },
          "teamID": {
            "backendName": "teamID",
            "description_en": "The unique identifier of the team",
            "description_zh": "Team 唯一标识",
            "example": "9f5a1fe9-****",
            "type": "string"
          },
          "updatedAt": {
            "backendName": "updatedAt",
            "description_en": "The time when the volume was last updated, in UTC. The time is in the yyyy-MM-ddTHH:mm:ss.SSSSSSZ format, with exactly 6 decimal places for fractional seconds (microsecond precision)",
            "description_zh": "存储卷的最后更新时间，为 UTC 时间，格式为 yyyy-MM-ddTHH:mm:ss.SSSSSSZ，小数秒固定 6 位（微秒精度）",
            "example": "2026-09-07T03:48:05.274000Z",
            "type": "string"
          },
          "userID": {
            "backendName": "userID",
            "description_en": "The UID of the creator",
            "description_zh": "创建人 UID",
            "example": "2000****",
            "type": "string"
          },
          "volumeID": {
            "backendName": "volumeID",
            "description_en": "The unique identifier of the volume",
            "description_zh": "Volume 唯一标识",
            "example": "25878d34-****",
            "type": "string"
          },
          "volumeName": {
            "backendName": "volumeName",
            "description_en": "The name, which is unique within the team",
            "description_zh": "名称，Team 内唯一",
            "example": "workspace",
            "type": "string"
          }
        },
        "type": "object"
      },
      "JuiceFSVolumeConfig": {
        "description_zh": "JuiceFS Volume 配置",
        "properties": {
          "args": {
            "backendName": "args",
            "description_zh": "其他挂载参数",
            "items": {
              "description_zh": "其他挂载参数",
              "example": "无",
              "type": "string"
            },
            "type": "array"
          },
          "baseURL": {
            "backendName": "baseUrl",
            "description_zh": "接入点地址",
            "example": "http://127.0.0.1:8080",
            "type": "string"
          },
          "remoteDir": {
            "backendName": "remoteDir",
            "description_zh": "远程挂载目录",
            "example": "/sandbox/workspace",
            "type": "string"
          },
          "token": {
            "backendName": "token",
            "description_zh": "访问令牌",
            "example": "xxxxxx",
            "sensitive": true,
            "type": "string"
          },
          "volumeName": {
            "backendName": "volumeName",
            "description_zh": "JuiceFS 的卷名称",
            "example": "data",
            "type": "string"
          }
        },
        "type": "object"
      },
      "OSSVolumeConfig": {
        "description_en": "The configuration of an Object Storage Service (OSS) storage volume",
        "description_zh": "对象存储 OSS 类型存储卷的配置",
        "properties": {
          "bucketName": {
            "backendName": "bucketName",
            "description_en": "The name of the OSS bucket to mount as a storage volume",
            "description_zh": "作为存储卷挂载的 OSS Bucket 名称",
            "example": "sandbox-shared-data",
            "type": "string"
          },
          "bucketPath": {
            "backendName": "bucketPath",
            "description_en": "The path prefix within the bucket to use as the mount source. If this parameter is not specified, the entire bucket is mounted",
            "description_zh": "Bucket 内作为挂载源的路径前缀。不配置时挂载整个 Bucket",
            "example": "/workspace/",
            "type": "string"
          },
          "endpoint": {
            "backendName": "endpoint",
            "description_en": "The OSS service registration address used to access the bucket. Use an internal network address in the same region as the sandboxed container",
            "description_zh": "访问该 Bucket 使用的 OSS 服务接入地址，建议使用与沙箱同地域的内网地址",
            "example": "oss-cn-hangzhou-internal.aliyuncs.com",
            "type": "string"
          },
          "readOnly": {
            "backendName": "readOnly",
            "description_en": "Specifies whether the storage volume is mounted as read-only in the sandboxed container",
            "description_zh": "存储卷在沙箱内是否以只读方式挂载",
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "VolumeMountConfig": {
        "description_en": "The volume mount configuration",
        "description_zh": "Volume 挂载配置",
        "properties": {
          "role": {
            "backendName": "role",
            "description_en": "The RAM role that grants Function Compute the required permissions. Scenarios include:\n\nSending logs generated by the function to your Logstore.\nGenerating temporary access tokens for the function to access other cloud resources during execution",
            "description_zh": "授予函数计算所需权限的RAM角色，使用场景包含：\n\n把函数产生的日至发送到您的日志库中。\n为函数在执行过程中访问其他云资源生成的临时访问令牌",
            "example": "acs:ram::xxxx:role/xxxx",
            "type": "string"
          },
          "vpcConfig": {
            "backendName": "vpcConfig",
            "description_en": "The VPC configuration",
            "description_zh": "VPC配置",
            "properties": {
              "securityGroupId": {
                "backendName": "securityGroupId",
                "description_en": "The security group ID",
                "description_zh": "安全组ID",
                "example": "sg-xxxx",
                "type": "string"
              },
              "vSwitchIds": {
                "backendName": "vSwitchIds",
                "description_en": "The vSwitch IDs",
                "description_zh": "交换机ID",
                "items": {
                  "description_en": "The vSwitch ID",
                  "description_zh": "交换机 ID",
                  "example": "vsw-xxxx",
                  "type": "string"
                },
                "type": "array"
              },
              "vpcId": {
                "backendName": "vpcId",
                "description_en": "VPC ID",
                "description_zh": "VPC ID",
                "example": "vpc-xxxx",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
