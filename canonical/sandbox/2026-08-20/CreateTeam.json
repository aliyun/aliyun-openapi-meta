            "type": "string"
          },
          "teamID": {
            "backendName": "teamID",
            "description_zh": "资源所属团队的 ID，为 UUID 格式",
            "example": "5f4a2c18-****",
            "type": "string"
          },
          "teamName": {
            "backendName": "teamName",
            "description_zh": "团队名称",
            "example": "sandbox-dev",
            "type": "string"
          },
          "userID": {
            "backendName": "userID",
            "description_zh": "团队创建者的用户 ID，为 UUID 格式",
            "example": "9c1d4e72-****",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
