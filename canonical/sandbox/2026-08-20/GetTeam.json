  "cmd_full_name": "sandbox get-team",
  "cmd_name": "get-team",
  "components": {
    "schemas": {
      "E2BTeam": {
        "description_zh": "团队信息。描述一个沙箱团队及其套餐、状态和资源归属",
        "properties": {
          "allowUpdateTeamName": {
            "backendName": "allowUpdateTeamName",
            "description_zh": "是否允许修改团队名称。默认团队不允许修改",
            "type": "boolean"
          },
          "createdTime": {
            "backendName": "createdTime",
            "description_zh": "团队的创建时间，为 UTC 时间，格式为 RFC 3339",
            "example": "2026-08-20T08:30:00Z",
            "type": "string"
          },
          "description": {
            "backendName": "description",
            "description_zh": "团队描述信息",
            "example": "算法团队的沙箱环境",
            "type": "string"
          },
          "plan": {
            "backendName": "plan",
            "description_zh": "团队套餐规格。取值：eco（经济型）、std（标准型）、pro（专业型）、ent（企业型）",
            "example": "std",
            "type": "string"
          },
          "readOnly": {
            "backendName": "readOnly",
            "description_zh": "当前调用者对该团队是否只读。为 true 时不能修改团队配置",
            "type": "boolean"
          },
          "resourceGroupID": {
            "backendName": "resourceGroupID",
            "description_zh": "团队所属的阿里云资源组 ID",
            "example": "rg-****",
            "type": "string"
          },
          "status": {
            "backendName": "status",
            "description_zh": "团队状态。取值：active（正常）、deleting（删除中）、delete_failed（删除失败）",
            "example": "active",
            "type": "string"
          },
          "teamID": {
            "backendName": "teamID",
            "description_zh": "资源所属团队的 ID，为 UUID 格式",
            "example": "5f4a2c18-****",
            "type": "string"
          },
          "teamName": {
            "backendName": "teamName",
            "description_zh": "团队名称",
            "example": "sandbox-dev",
            "type": "string"
          },
          "userID": {
            "backendName": "userID",
            "description_zh": "团队创建者的用户 ID，为 UUID 格式",
            "example": "9c1d4e72-****",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
