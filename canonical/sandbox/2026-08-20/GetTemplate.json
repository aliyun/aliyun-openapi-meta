{
  "camel_example": "",
  "cmd_full_name": "sandbox get-template",
  "cmd_name": "get-template",
  "components": {
    "schemas": {
      "PublicTemplateLogConfig": {
        "description_zh": "模板的日志投递配置",
        "properties": {
          "logstore": {
            "backendName": "logstore",
            "description_zh": "接收沙箱运行日志的日志服务 Logstore 名称",
            "example": "sandbox-runtime",
            "type": "string"
          },
          "project": {
            "backendName": "project",
            "description_zh": "接收沙箱运行日志的日志服务 Project 名称",
            "example": "sandbox-log-cn-hangzhou",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PublicTemplateRegistryConfig": {
        "description_en": "The configuration for the template to access the image repository. For security reasons, only the network configuration is returned in queries. Logon credentials and certificate configurations are not returned",
        "description_zh": "模板访问镜像仓库的配置。出于安全考虑，查询时仅返回网络配置，不返回登录凭证和证书配置",
        "properties": {
          "networkConfig": {
            "$ref": "#/components/schemas/PublicTemplateRegistryNetworkConfig",
            "backendName": "networkConfig",
            "description_en": "The VPC configuration used to access the image repository",
            "description_zh": "访问镜像仓库所使用的专有网络配置"
          }
        },
        "type": "object"
      },
      "PublicTemplateRegistryNetworkConfig": {
        "description_en": "The VPC configuration used to access the image repository",
        "description_zh": "访问镜像仓库所使用的专有网络配置",
        "properties": {
          "securityGroupId": {
            "backendName": "securityGroupId",
            "description_en": "The ID of the security group used to access the image repository",
            "description_zh": "访问镜像仓库所使用的安全组 ID",
            "example": "sg-****",
            "type": "string"
          },
          "vSwitchId": {
            "backendName": "vSwitchId",
            "description_en": "The ID of the vSwitch used to access the image repository",
            "description_zh": "访问镜像仓库所使用的交换机 ID",
            "example": "vsw-****",
            "type": "string"
          },
          "vpcId": {
            "backendName": "vpcId",
            "description_en": "The ID of the VPC used to access the image repository",
            "description_zh": "访问镜像仓库所使用的专有网络 VPC ID",
            "example": "vpc-****",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PublicTemplateRuntimeConfig": {
        "description_en": "The runtime configuration of the template",
        "description_zh": "模板的运行时配置",
        "properties": {
          "cpu": {
            "backendName": "cpu",
            "description_en": "The CPU specification of the sandbox instance, in cores",
            "description_zh": "沙箱实例的 CPU 规格，单位为核",
            "example": "2",
            "format": "float",
            "type": "number"
          },
          "diskSize": {
            "backendName": "diskSize",
            "description_en": "The disk specification of the sandbox instance, in MB",
            "description_zh": "沙箱实例的磁盘规格，单位为 MB",
            "example": "10240",
            "format": "int32",
            "type": "integer"
          },
          "internetAccess": {
            "backendName": "internetAccess",
            "description_en": "Specifies whether the sandbox instance is allowed to access the Internet",
            "description_zh": "是否允许沙箱实例访问公网",
            "type": "boolean"
          },
          "logConfig": {
            "$ref": "#/components/schemas/PublicTemplateLogConfig",
            "backendName": "logConfig",
            "description_en": "The log delivery configuration of the sandbox instance",
            "description_zh": "沙箱实例的日志投递配置"
          },
          "memorySize": {
            "backendName": "memorySize",
            "description_en": "The memory specification of the sandbox instance, in MB",
            "description_zh": "沙箱实例的内存规格，单位为 MB",
            "example": "2048",
            "format": "int32",
            "type": "integer"
          },
          "sandboxConfig": {
            "$ref": "#/components/schemas/PublicTemplateSandboxConfig",
            "backendName": "sandboxConfig",
            "description_en": "The image and startup configuration of the sandbox instance",
            "description_zh": "沙箱实例的镜像与启动配置"
          },
          "vpcConfig": {
            "$ref": "#/components/schemas/PublicTemplateVPCConfig",
            "backendName": "vpcConfig",
            "description_en": "The VPC configuration of the sandbox instance",
            "description_zh": "沙箱实例的专有网络配置"
          }
        },
        "type": "object"
      },
      "PublicTemplateSandboxConfig": {
        "description_zh": "模板的沙箱镜像与启动配置",
        "properties": {
          "acrInstanceId": {
            "backendName": "acrInstanceId",
            "description_zh": "容器镜像服务企业版实例 ID，registryType 为 acree 时必填",
            "example": "cri-****",
            "type": "string"
          },
          "generation": {
            "backendName": "generation",
            "description_zh": "沙箱代际。取值：1（第一代）或 2（第二代）。缺省为 1",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "image": {
            "backendName": "image",
            "description_zh": "沙箱基础镜像地址",
            "example": "registry-vpc.cn-hangzhou.aliyuncs.com/sandbox-demo/python:3.12",
            "type": "string"
          },
          "osType": {
            "backendName": "osType",
            "description_zh": "第二代沙箱的操作系统类型。取值：linux-amd64、android-36-osworld、windows-osworld",
            "example": "linux-amd64",
            "type": "string"
          },
          "readyCommand": {
            "backendName": "readyCommand",
            "description_zh": "沙箱就绪探测命令，执行成功表示沙箱可以接收请求，仅第一代沙箱支持",
            "example": "curl -sf http://127.0.0.1:49983/health",
            "type": "string"
          },
          "registryConfig": {
            "$ref": "#/components/schemas/PublicTemplateRegistryConfig",
            "backendName": "registryConfig",
            "description_zh": "访问镜像仓库所使用的配置。出于安全考虑，查询时仅回显网络配置，不返回登录凭证"
          },
          "startCommand": {
            "backendName": "startCommand",
            "description_zh": "沙箱容器的启动命令，仅第一代沙箱支持",
            "example": "/usr/local/bin/start.sh",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PublicTemplateStatus": {
        "description_en": "The template status. Describes the current build status, failure reason, and the time when the status was reached",
        "description_zh": "模板状态。描述模板当前的构建状态、失败原因和状态到达时间",
        "properties": {
          "finishedAt": {
            "backendName": "finishedAt",
            "description_en": "The time when the template reached the current desired state, in UTC and RFC 3339 format. This parameter is empty when the template is still being built or updated",
            "description_zh": "模板到达当前终态的时间，为 UTC 时间，格式为 RFC 3339。模板仍在构建或更新时为空",
            "example": "2026-08-20T08:35:12Z",
            "type": "string"
          },
          "reason": {
            "$ref": "#/components/schemas/PublicTemplateStatusReason",
            "backendName": "reason",
            "description_en": "The reason why the template entered a failure state. This parameter is returned only when state is error or updateFailed",
            "description_zh": "模板进入失败状态的原因。仅当 state 为 error 或 updateFailed 时返回"
          },
          "state": {
            "backendName": "state",
            "description_en": "The template status. Valid values:\nbuilding: The template is being built.\nready: The template is active.\nupdating: The template is being updated.\nupdateFailed: The template failed to be updated.\nerror: The template failed to be built",
            "description_zh": "模板状态。取值：building（构建中）、ready（可用）、updating（更新中）、updateFailed（更新失败）、error（构建失败）",
            "example": "ready",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PublicTemplateStatusReason": {
        "description_zh": "公开模板状态原因",
        "properties": {
          "message": {
            "backendName": "message",
            "description_zh": "失败原因详情",
            "example": "拉取源镜像失败：认证信息无效",
            "title": "失败原因详情",
            "type": "string"
          },
          "step": {
            "backendName": "step",
            "description_zh": "失败步骤标识",
            "example": "build-context",
            "title": "失败步骤标识",
            "type": "string"
          }
        },
        "title": "公开模板状态原因",
        "type": "object"
      },
      "PublicTemplateVPCConfig": {
        "description_zh": "模板的专有网络配置",
        "properties": {
          "role": {
            "backendName": "role",
            "description_zh": "沙箱实例访问专有网络时扮演的 RAM 角色 ARN，格式为 acs:ram::{账号 ID}:role/{角色名}",
            "example": "acs:ram::1234567890123456:role/aliyunfcdefaultrole",
            "type": "string"
          },
          "securityGroupId": {
            "backendName": "securityGroupId",
            "description_zh": "沙箱实例使用的安全组 ID",
            "example": "sg-****",
            "type": "string"
          },
          "vSwitchIds": {
            "backendName": "vSwitchIds",
            "description_zh": "沙箱实例接入的交换机 ID 列表",
            "items": {
              "description_zh": "交换机 ID",
              "example": "vsw-****",
              "type": "string"
            },
            "type": "array"
          },
          "vpcId": {
            "backendName": "vpcId",
            "description_zh": "沙箱实例接入的专有网络 VPC ID",
            "example": "vpc-****",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "deprecated": false,
  "description_en": "查询 Template",
  "description_zh": "查询模板",
  "kebab_example": "",
