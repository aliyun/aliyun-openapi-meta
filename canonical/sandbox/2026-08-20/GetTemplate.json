            "$ref": "#/components/schemas/PublicTemplateRuntimeConfig",
            "description_zh": "模板运行时配置"
          },
          "status": {
            "$ref": "#/components/schemas/PublicTemplateStatus",
            "description_zh": "模板状态"
          },
          "teamID": {
            "description_zh": "团队 ID",
            "example": "13b721e6-8cc8-5df2-af13-80316f7508af",
            "type": "string"
          },
          "teamName": {
            "description_zh": "团队名称",
            "example": "my-team",
            "type": "string"
          },
          "templateID": {
            "description_zh": "模板唯一标识",
            "example": "us7dxqaezw5uu7aa2cm5",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
