  "components": {
    "schemas": {
      "E2BTeam": {
        "description_zh": "团队信息。描述一个沙箱团队及其套餐、状态和资源归属",
        "properties": {
          "allowUpdateTeamName": {
            "backendName": "allowUpdateTeamName",
            "description_zh": "是否允许修改团队名称。默认团队不允许修改",
            "type": "boolean"
          },
          "createdTime": {
            "backendName": "createdTime",
            "description_zh": "团队的创建时间，为 UTC 时间，格式为 RFC 3339",
