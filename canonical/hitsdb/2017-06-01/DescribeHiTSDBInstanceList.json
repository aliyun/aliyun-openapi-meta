                  "backendName": "maxSeriesPerDatabase",
                  "description_en": "The maximum number of time series per database",
                  "description_zh": "单个数据库时间线的最大数量",
                  "example": "10000",
                  "type": "string",
                  "visibility": "Public"
                },
                "NetworkType": {
                  "backendName": "networkType",
                  "description_en": "The network type of the instance. Valid values:\nVPC: virtual private cloud",
                  "description_zh": "实例网络类型：VPC-专有网络",
                  "example": "VPC",
                  "mappingResourcePropertyName": "$.NetworkType",
                  "type": "string",
                  "visibility": "Public"
                },
                "PaymentType": {
                  "backendName": "paymentType",
                  "description_en": "The billing method. Valid values:\nPREPAY: subscription.\nPOSTPAY: pay-as-you-go",
                  "description_zh": "付费类型，PREPAY-包年包月；POSTPAY-按量付费",
                  "example": "PREPAY",
