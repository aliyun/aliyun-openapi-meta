                  "mappingResourcePropertyName": "$.VpcId",
                  "type": "string",
                  "visibility": "Public"
                },
                "VswitchId": {
                  "backendName": "vswitchId",
                  "description_en": "The ID of the vSwitch",
                  "description_zh": "虚拟交换机的ID",
                  "example": "vsw-bp1xxxxxxxxxxxxxxxxxx",
                  "mappingResourcePropertyName": "$.VSwitchId",
                  "type": "string",
                  "visibility": "Public"
                },
                "ZoneId": {
                  "backendName": "zoneId",
                  "description_en": "The zone ID of the instance",
                  "description_zh": "实例可用区ID",
                  "example": "cn-hongkong-b",
                  "mappingResourcePropertyName": "$.ZoneId",
                  "type": "string",
                  "visibility": "Public"
