            "backendName": "data.pageNumber",
            "description_en": "The page number",
            "description_zh": "页码",
            "example": "1",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "PageSize": {
            "backendName": "data.pageSize",
            "description_en": "The page size",
            "description_zh": "分页大小",
            "example": "20",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "0A7153E4-8354-497E-87E5-5D0EBEF5AEB1",
            "type": "string",
            "visibility": "Public"
          },
          "Total": {
            "backendName": "data.total",
            "description_en": "The total number of entries",
