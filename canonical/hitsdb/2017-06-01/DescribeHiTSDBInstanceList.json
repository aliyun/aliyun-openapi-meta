                  "example": "cn-hangzhou",
                  "type": "string",
                  "visibility": "Public"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The instance status. Valid values:\nACTIVATION: Running.\nCREATING: Being created.\nNET_CREATING: Creating network connection.\nCLASS_CHANGING: Changing instance specifications.\nLOCKED: Locked.\nDELETED: Deleted",
