                          "visibility": "Public"
                        },
                        "Name": {
                          "backendName": "name",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Required": {
                          "backendName": "required",
                          "type": "boolean",
                          "visibility": "Public"
                        }
                      },
                      "type": "object"
                    },
                    "nullToEmpty": true,
                    "type": "array",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "DisplayName": {
                "backendName": "displayName",
                "description_en": "The display name of the application",
                "description_zh": "应用的显示名称",
                "example": "myapp",
                "type": "string",
                "visibility": "Public"
