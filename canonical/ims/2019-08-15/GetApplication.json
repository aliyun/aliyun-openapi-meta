                "description_zh": "是否允许被其他账号安装",
                "example": "true",
                "type": "boolean",
                "visibility": "Public"
              },
              "ProtocolVersion": {
                "backendName": "protocolVersion",
                "description_en": "The OAuth protocol version of the application. Valid values:\n\n`2.0`: OAuth 2.0\n\n`2.1`: OAuth 2.1",
                "description_zh": "应用的OAuth协议版本。取值：\n`2.0`：表示为OAuth 2.0协议。\n`2.1`：表示为OAuth 2.1协议",
                "example": "2.0",
                "type": "string"
              },
              "RedirectUris": {
                "backendName": "redirectUris",
                "itemName": "RedirectUri",
                "items": {
                  "backendName": "redirectUris",
                  "nullToEmpty": true,
                  "type": "string",
