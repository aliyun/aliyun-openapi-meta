                "backendName": "refreshTokenValidity",
                "description_en": "The validity period of the refresh token. Unit: seconds",
                "description_zh": "刷新令牌有效期。单位：秒",
                "example": "7776000",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "SecretRequired": {
                "backendName": "secretRequired",
                "description_en": "Indicates whether a secret is required",
                "description_zh": "是否需要应用密钥",
                "example": "true",
                "type": "boolean",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "updateDate",
                "description_en": "The time when the application was last updated",
                "description_zh": "更新时间。\n\n格式：RFC 3339（UTC），例如：2020-10-23T08:06:57Z",
                "example": "2020-10-23T08:06:57Z",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "6616F09B-2768-4C11-8866-A8EE4C4A583E",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
