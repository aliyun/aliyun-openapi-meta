{
  "camel_example": "aliyun ims GetApplication --region cn-hangzhou --AppId '472457090344041****'",
  "cmd_full_name": "ims get-application",
  "cmd_name": "get-application",
  "deprecated": false,
  "description_en": "Queries the configuration information of a specified application",
