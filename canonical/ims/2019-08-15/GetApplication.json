      "schema": {
        "description_en": "The returned result",
        "description_zh": "返回结果",
        "properties": {
          "Application": {
            "backendName": "application",
            "description_en": "The application information",
            "description_zh": "应用信息",
            "properties": {
              "AccessTokenValidity": {
                "backendName": "accessTokenValidity",
                "description_en": "The validity period of the access token. Unit: seconds",
                "description_zh": "访问令牌有效期。单位：秒",
                "example": "3600",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "AccountId": {
                "backendName": "accountId",
                "description_en": "The Alibaba Cloud account ID to which the application belongs",
                "description_zh": "应用所属的阿里云账号ID",
                "example": "177242285274****",
                "type": "string",
                "visibility": "Public"
              },
              "AppId": {
                "backendName": "appId",
                "description_en": "The application ID",
                "description_zh": "应用ID",
                "example": "472457090344041****",
                "type": "string",
                "visibility": "Public"
              },
              "AppName": {
                "backendName": "appName",
                "description_en": "The application name",
                "description_zh": "应用名称",
                "example": "myapp",
                "type": "string",
                "visibility": "Public"
              },
              "AppType": {
                "backendName": "appType",
                "description_en": "The application type. Valid values:\n\nWebApp: web applications that are based on browser interactions.\nNativeApp: local applications that run in operating systems, such as desktop or shift operating systems.\nServerApp: applications that directly access Alibaba Cloud services without requiring user logon. Currently, only user synchronization applications based on the System for Cross-domain Identity Management protocol are supported",
                "description_zh": "应用类型。取值：\n\nWebApp：指基于浏览器交互的网络应用。\nNativeApp：指操作系统中运行的本地应用，主要为运行在桌面操作系统或移动操作系统中的应用。\nServerApp：指直接访问阿里云服务，而无需依赖用户登录的应用，目前仅支持基于SCIM协议的用户同步应用",
                "example": "WebApp",
                "type": "string",
                "visibility": "Public"
              },
              "AssignmentType": {
                "backendName": "assignmentType",
                "description_en": "The application assignment type. Valid values:\nAllowAll: full assignment. All RAM users and roles within the account are allowed to use the application.\nOnDemand: on-demand assignment. Only specified RAM users and roles within the account are allowed to use the application",
                "description_zh": "应用分配类型。取值：\nAllowAll：全分配，允许账号下所有子用户和角色使用该应用。\nOnDemand：按需分配，仅允许账号下指定子用户和角色使用该应用",
                "example": "AllowAll",
                "type": "string"
              },
              "CreateDate": {
                "backendName": "createDate",
                "description_en": "The creation time. Format: RFC 3339 (UTC). Example: 2020-10-23T08:06:57Z",
                "description_zh": "创建时间。\n\n格式：RFC 3339（UTC），例如：2020-10-23T08:06:57Z",
                "example": "2020-10-23T08:06:57Z",
                "type": "string",
                "visibility": "Public"
              },
              "DelegatedScope": {
                "backendName": "delegatedScope",
                "description_en": "The delegated scope information of the application",
                "description_zh": "应用权限范围信息",
                "properties": {
                  "PredefinedScopes": {
                    "backendName": "predefinedScopes",
                    "itemName": "PredefinedScope",
                    "items": {
                      "properties": {
                        "Description": {
                          "backendName": "description",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Name": {
                          "backendName": "name",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Required": {
                          "backendName": "required",
                          "type": "boolean",
                          "visibility": "Public"
                        }
                      },
                      "type": "object"
                    },
                    "nullToEmpty": true,
                    "type": "array",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "DisplayName": {
                "backendName": "displayName",
                "description_en": "The display name of the application",
                "description_zh": "应用的显示名称",
                "example": "myapp",
                "type": "string",
                "visibility": "Public"
              },
              "IsMultiTenant": {
                "backendName": "isMultiTenant",
                "description_en": "Specifies whether the application can be installed by other accounts",
                "description_zh": "是否允许被其他账号安装",
                "example": "true",
                "type": "boolean",
                "visibility": "Public"
              },
              "NeedPrincipalConsent": {
                "backendName": "needPrincipalConsent",
                "description_en": "Specifies whether user authorization is required. Valid values:\ntrue: User authorization is required.\nfalse: User authorization is not required",
                "description_zh": "是否需要用户授权。取值：\ntrue：需要用户授权。\nfalse：不需要用户授权",
                "example": "true",
                "type": "boolean"
              },
              "ProtocolVersion": {
                "backendName": "protocolVersion",
                "description_en": "The OAuth protocol version of the application. Valid values:\n`2.0`: OAuth 2.0 protocol.\n`2.1`: OAuth 2.1 protocol",
                "description_zh": "应用的OAuth协议版本。取值：\n`2.0`：表示为OAuth 2.0协议。\n`2.1`：表示为OAuth 2.1协议",
                "example": "2.0",
                "type": "string"
              },
              "RedirectUris": {
                "backendName": "redirectUris",
                "itemName": "RedirectUri",
                "items": {
                  "backendName": "redirectUris",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "nullToEmpty": true,
                "type": "array",
                "visibility": "Public"
              },
              "RefreshTokenValidity": {
                "backendName": "refreshTokenValidity",
                "description_en": "The validity period of the refresh token. Unit: seconds",
                "description_zh": "刷新令牌有效期。单位：秒",
                "example": "7776000",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "SecretRequired": {
                "backendName": "secretRequired",
                "description_en": "Specifies whether an application secret is required",
                "description_zh": "是否需要应用密钥",
                "example": "true",
                "type": "boolean",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "updateDate",
                "description_en": "The update time. Format: RFC 3339 (UTC). Example: 2020-10-23T08:06:57Z",
                "description_zh": "更新时间。\n\n格式：RFC 3339（UTC），例如：2020-10-23T08:06:57Z",
                "example": "2020-10-23T08:06:57Z",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "6616F09B-2768-4C11-8866-A8EE4C4A583E",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
