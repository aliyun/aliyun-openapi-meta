                "type": "boolean",
                "visibility": "Public"
              },
              "RequireUppercaseCharacters": {
                "backendName": "requireUppercaseCharacters",
                "description_en": "Indicates whether the password must contain uppercase letters",
                "description_zh": "密码中是否必须包含大写字母",
                "example": "false",
                "type": "boolean",
                "visibility": "Public"
