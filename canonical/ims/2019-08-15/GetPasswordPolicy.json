                "title_en": "初始密码有效期。",
                "title_zh": "初始密码有效期。",
                "type": "integer"
              },
              "InterceptRiskPasswordOnApi": {
                "backendName": "interceptRiskPasswordOnApi",
                "description_en": "Indicates whether threat passwords are blocked when set using APIs.\n\nValid values:\n\ntrue\n\nfalse (default)",
