                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "MaxPasswordAge": {
                "backendName": "maxPasswordAge",
                "description_en": "The password validity period",
                "description_zh": "密码有效期",
                "example": "0",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "MinimumPasswordDifferentCharacter": {
                "backendName": "minimumPasswordDifferentCharacter",
                "description_en": "The minimum number of different characters in the password",
                "description_zh": "密码中最少包含的不同字符数量",
                "example": "0",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "MinimumPasswordLength": {
                "backendName": "minimumPasswordLength",
                "description_en": "The minimum password length",
                "description_zh": "最小密码长度",
                "example": "8",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
              },
              "PasswordNotContainUserName": {
                "backendName": "passwordNotContainAccountName",
                "description_en": "Indicates whether the password must not contain the user name",
                "description_zh": "密码中是否不允许包含用户名",
                "example": "false",
                "type": "boolean",
                "visibility": "Public"
              },
              "PasswordReusePrevention": {
                "backendName": "passwordReusePrevention",
                "description_en": "The password reuse prevention policy",
                "description_zh": "历史密码检查策略",
                "example": "0",
                "format": "int32",
                "type": "integer",
                "visibility": "Public"
