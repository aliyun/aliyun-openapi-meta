{
  "camel_example": "aliyun ims ProvisionExternalApplication --region cn-hangzhou --AppId 4035506116466040000",
  "cmd_full_name": "ims provision-external-application",
  "cmd_name": "provision-external-application",
  "deprecated": false,
  "description_en": "Installs an external application",
  "description_zh": "安装外部应用",
  "kebab_example": "aliyun ims provision-external-application --app-id 4035506116466040000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ProvisionExternalApplication",
  "operation": {
    "action": "ProvisionExternalApplication",
    "api_style": "RPC",
    "api_version": "2019-08-15",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "403550611646604****",
      "help_en": "The ID of the external application that was created by another Alibaba Cloud account and can be installed by the current account. The application IDs returned by `ListApplications` for the current account are not applicable. `ListExternalApplications` and `ListApplicationProvisionInfos` only query installed records and cannot discover external application IDs that have not been installed",
      "help_zh": "其他阿里云账号创建且当前账号可安装的外部应用 ID。当前账号 `ListApplications` 返回的本账号应用 ID 不适用；`ListExternalApplications` 和 `ListApplicationProvisionInfos` 仅查询已安装记录，不能发现尚未安装的外部应用 ID",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": true,
      "type": "string"
    },
    {
      "example": "openid;aliuid",
      "help_en": "The permission scopes granted to the application. You can specify multiple scopes separated by semicolons (;).\n\n\nFor supported permission scopes, refer to \"OAuth Scopes\" in https://help.aliyun.com/document_detail/93693.html",
      "help_zh": "授予该应用的权限范围信息，可填写多个范围，以分号（；）分隔。\n\n\n支持的权限范围可以参考https://help.aliyun.com/document_detail/93693.html中的“OAuth范围”",
      "location": "query",
      "name": "scopes",
      "options": [
        "--scopes"
      ],
      "raw_name": "Scopes",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Ims",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ExternalApplication": {
            "backendName": "application",
            "description_en": "The external application information",
            "description_zh": "外部应用信息",
            "properties": {
              "AppPrincipalName": {
                "backendName": "appPrincipalName",
                "description_en": "The application principal name in the format of `<app_name>@app.<account_id>.onaliyun.com`",
                "description_zh": "应用主体名称，格式为`<app_name>@app.<account_id>.onaliyun.com`",
                "example": "GiteePrd@app.177242285274****.onaliyun.com\n",
                "type": "string",
                "visibility": "Public"
              },
              "CreateDate": {
                "backendName": "createDate",
                "description_en": "The installation timestamp",
                "description_zh": "安装时间戳",
                "example": "1603693518000",
                "type": "string",
                "visibility": "Public"
              },
              "DelegatedScope": {
                "backendName": "delegatedScope",
                "description_en": "The permission scope information of the application",
                "description_zh": "应用权限范围信息",
                "properties": {
                  "PredefinedScopes": {
                    "backendName": "predefinedScopes",
                    "itemName": "PredefinedScope",
                    "items": {
                      "properties": {
                        "Description": {
                          "backendName": "description",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Name": {
                          "backendName": "name",
                          "type": "string",
                          "visibility": "Public"
                        }
                      },
                      "type": "object"
                    },
                    "nullToEmpty": true,
                    "type": "array",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "DisplayName": {
                "backendName": "displayName",
                "description_en": "The display name",
                "description_zh": "显示名称",
                "example": "GiteeAliyun\n",
                "type": "string",
                "visibility": "Public"
              },
              "ForeignAppId": {
                "backendName": "foreignAppId",
                "description_en": "The external application ID",
                "description_zh": "外部应用ID",
                "example": "403550611646604****",
                "type": "string",
                "visibility": "Public"
              },
              "TenantId": {
                "backendName": "tenantId",
                "description_en": "The Alibaba Cloud account ID to which the external application is installed",
                "description_zh": "外部应用安装到的阿里云账号ID",
                "example": "157242285274****",
                "type": "string",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "updateDate",
                "description_en": "The update timestamp",
                "description_zh": "更新时间戳",
                "example": "1603693518000",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "55535873-9A6B-5C87-853F-C7CD258826F2",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
