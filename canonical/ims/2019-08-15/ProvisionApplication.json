                "type": "string",
                "visibility": "Public"
              },
              "TenantId": {
                "backendName": "tenantId",
                "description_en": "The ID of the Alibaba Cloud account for which the application was installed",
                "description_zh": "该应用安装到的阿里云账号ID",
                "example": "177242285274****",
                "type": "string",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "updateDate",
                "description_en": "The update time. The value is a timestamp",
                "description_zh": "更新时间戳",
                "example": "1603693518000",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "C8AE06ED-9593-5BF9-8D4A-68D5DDCC90AB",
            "type": "string",
            "visibility": "Public"
