      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Ims",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ApplicationProvisionInfo": {
            "backendName": "applicationProvisionInfo",
            "description_en": "The installation information of the application",
            "description_zh": "应用安装信息",
            "properties": {
              "AccountId": {
                "backendName": "accountId",
                "description_en": "The ID of the Alibaba Cloud account",
                "description_zh": "阿里云账号ID",
                "example": "177242285274****",
                "type": "string",
                "visibility": "Public"
              },
              "AppId": {
                "backendName": "appId",
                "description_en": "The ID of the application",
                "description_zh": "应用ID",
                "example": "452392483381546****",
                "type": "string",
                "visibility": "Public"
              },
              "AppName": {
                "backendName": "appName",
                "description_en": "The name of the application",
                "description_zh": "应用名称",
                "example": "GiteePrd",
                "type": "string",
                "visibility": "Public"
              },
              "AppPrincipalName": {
                "backendName": "appPrincipalName",
                "description_en": "The name of the application principal. The value is in the `<app_name>@app.<account_id>.onaliyun.com` format",
                "description_zh": "应用主体名称，格式为`<app_name>@app.<account_id>.onaliyun.com`",
                "example": "GiteePrd@app.177242285274****.onaliyun.com",
                "type": "string",
                "visibility": "Public"
              },
              "CreateDate": {
                "backendName": "createDate",
                "description_en": "The time when the application was installed. The value is a timestamp",
                "description_zh": "安装时间戳",
                "example": "1603693518000",
                "type": "string",
                "visibility": "Public"
              },
              "DelegatedScope": {
                "backendName": "delegatedScope",
                "description_en": "The information about the permissions that are granted to the application",
                "description_zh": "应用权限范围信息",
                "properties": {
                  "PredefinedScopes": {
                    "backendName": "predefinedScopes",
                    "itemName": "PredefinedScope",
                    "items": {
                      "properties": {
                        "Description": {
                          "backendName": "description",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Name": {
                          "backendName": "name",
                          "type": "string",
                          "visibility": "Public"
                        }
                      },
                      "type": "object"
                    },
                    "nullToEmpty": true,
                    "type": "array",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "DisplayName": {
                "backendName": "displayName",
                "description_en": "The display name of the application",
