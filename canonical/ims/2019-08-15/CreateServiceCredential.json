{
  "camel_example": "aliyun ims CreateServiceCredential --region cn-hangzhou --ServiceName 'xxx.aliyuncs.com' --ServiceCredentialName yourServiceCredentialName",
  "cmd_full_name": "ims create-service-credential",
  "cmd_name": "create-service-credential",
  "deprecated": false,
  "description_en": "Creates a service credential for a Resource Access Management (RAM) user in a specified cloud service",
  "description_zh": "创建RAM用户在指定云服务的服务凭证",
  "kebab_example": "aliyun ims create-service-credential --service-name xxx.aliyuncs.com --service-credential-name yourServiceCredentialName --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "CreateServiceCredential",
  "operation": {
    "action": "CreateServiceCredential",
    "api_style": "RPC",
    "api_version": "2019-08-15",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "test@example.onaliyun.com",
      "help_en": "The logon name of the RAM user.\nIf this parameter is left empty, a service credential is created for the current user by default",
      "help_zh": "RAM 用户的登录名称。\n如果为空，默认为当前用户创建服务凭证",
      "location": "query",
      "name": "user_principal_name",
      "options": [
        "--user-principal-name"
      ],
      "raw_name": "UserPrincipalName",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "xxx.aliyuncs.com",
      "help_en": "The Alibaba Cloud service name",
      "help_zh": "阿里云服务名称",
      "location": "query",
      "name": "service_name",
      "options": [
        "--service-name"
      ],
      "raw_name": "ServiceName",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "yourServiceCredentialName",
      "help_en": "The service credential name.\nThe name must be 1 to 128 characters in length and can contain letters, digits, periods (.), hyphens (-), and underscores (_)",
      "help_zh": "服务凭证名称。\n长度为1~128个字符，可包含英文字母、数字、半角句号（.）、短划线（-）和下划线（_）",
      "location": "query",
      "name": "service_credential_name",
      "options": [
        "--service-credential-name"
      ],
      "raw_name": "ServiceCredentialName",
      "required": true,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "The expiration time of the service credential, in days.\nValid values: 1 to 36600.\nIf this parameter is not specified, the service credential is permanently valid",
      "help_zh": "服务凭证过期时间，以天为单位。\n取值范围1-36600.\n不传表示永久有效",
      "location": "query",
      "name": "credential_age_days",
      "options": [
        "--credential-age-days"
      ],
      "raw_name": "CredentialAgeDays",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "Ims",
  "protocol": "HTTPS",
