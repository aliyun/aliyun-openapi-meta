{
  "camel_example": "",
  "cmd_full_name": "pailangstudio get-snapshot",
  "cmd_name": "get-snapshot",
  "deprecated": false,
  "description_en": "Retrieves the details of a snapshot",
  "description_zh": "获取快照详情",
  "kebab_example": "aliyun pailangstudio get-snapshot --workspace-id 478000 --snapshot-id snap-asfg000000123 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetSnapshot",
  "operation": {
    "action": "GetSnapshot",
    "api_style": "ROA",
    "api_version": "2024-07-10",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v1/langstudio/snapshots/{SnapshotId}"
  },
  "parameters": [
    {
      "example": "478***",
      "help_en": "The workspace ID. To obtain a workspace ID, see https://help.aliyun.com/document_detail/449124.html",
      "help_zh": "工作空间ID。如何获取工作空间ID，请参见 https://help.aliyun.com/document_detail/449124.html ",
      "location": "query",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "WorkspaceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "snap-asfg******123",
      "help_en": "The snapshot ID",
      "help_zh": "快照ID",
      "location": "path",
      "name": "snapshot_id",
      "options": [
        "--snapshot-id"
      ],
      "raw_name": "SnapshotId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v1/langstudio/snapshots/[SnapshotId]",
  "product_code": "PAILangStudio",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response body",
        "description_zh": "返回结果",
        "properties": {
          "Accessibility": {
            "backendName": "accessibility",
            "description_en": "The visibility of the snapshot. Valid values:\n\nPRIVATE: The snapshot is visible only to you and administrators.\n\nPUBLIC: The snapshot is visible to all users",
            "description_zh": "工作空间可见性，可能值为：\nPRIVATE：在此工作空间中，仅对您和管理员可见。\nPUBLIC：在此工作空间中，对所有人可见",
            "example": "PRIVATE",
            "type": "string",
            "visibility": "Public"
          },
          "CreationType": {
            "backendName": "creationType",
            "description_en": "The creation type of the snapshot. Valid values:\n\nManualCreated: The snapshot was created manually.\n\nDeploymentAutoCreated: The snapshot was created automatically by a deployment service.\n\nEvaluationAutoCreated: The snapshot was created automatically by an evaluation task",
            "description_zh": "快照的创建类型。取值：\nManualCreated：手动创建\nDeploymentAutoCreated: 部署服务自动创建\nEvaluationAutoCreated: 评测任务自动创建",
            "example": "ManualCreated",
            "type": "string",
            "visibility": "Public"
          },
          "Creator": {
            "backendName": "creator",
            "description_en": "The ID of the user who created the snapshot",
            "description_zh": "创建者ID",
            "example": "2680******4103",
            "type": "string",
            "visibility": "Public"
          },
          "Description": {
            "backendName": "description",
            "description_en": "A description of the snapshot",
            "description_zh": "快照描述",
            "example": "This is description",
            "type": "string",
            "visibility": "Public"
          },
          "ErrorMessage": {
            "backendName": "errorMessage",
            "type": "string",
            "visibility": "Public"
          },
          "GmtCreateTime": {
            "backendName": "gmtCreateTime",
            "description_en": "The time the snapshot was created",
            "description_zh": "创建时间",
            "example": "2025-09-24T07:33:53Z",
            "type": "string",
            "visibility": "Public"
          },
          "GmtModifiedTime": {
            "backendName": "gmtModifiedTime",
            "description_en": "The time the snapshot was last modified",
            "description_zh": "修改时间",
            "example": "2025-09-24T08:58:35Z",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "963BD7F9-0C02-5594-9550-BCC6DD43E3C0",
            "notResourceProperty": true,
            "title_en": "Request ID",
            "title_zh": "请求ID",
            "type": "string"
          },
          "SnapshotId": {
            "backendName": "snapshotId",
            "description_en": "The ID of the snapshot",
            "description_zh": "快照ID",
            "example": "snap-asfg******123",
            "type": "string",
            "visibility": "Public"
          },
          "SnapshotName": {
            "backendName": "snapshotName",
            "description_en": "The name of the snapshot",
            "description_zh": "快照名称",
            "example": "snapshot01",
            "type": "string",
            "visibility": "Public"
          },
          "SnapshotResourceId": {
            "backendName": "snapshotResourceId",
            "description_en": "The ID of the snapshot resource",
            "description_zh": "快照资源ID",
            "example": "flow-asfg******1234",
            "type": "string",
            "visibility": "Public"
          },
          "SnapshotResourceType": {
            "backendName": "snapshotResourceType",
            "description_en": "The resource type of the snapshot. Valid value:\n\nFlow: A workflow",
            "description_zh": "快照资源类型。取值：\nFlow：工作流",
            "example": "Flow",
            "type": "string",
            "visibility": "Public"
          },
          "SnapshotStatus": {
            "backendName": "snapshotStatus",
            "type": "string",
            "visibility": "Public"
          },
          "SnapshotStoragePath": {
            "backendName": "snapshotUri",
            "description_en": "The OSS path to the snapshot's source file",
            "description_zh": "存储快照源文件的OSS路径",
            "example": "oss://mybucket.oss-cn-hangzhou.aliyuncs.com/workdir/snapshot/snap-1234/src",
            "type": "string",
            "visibility": "Public"
          },
          "SnapshotUrl": {
            "backendName": "snapshotUrl",
            "description_en": "The download URL for the snapshot",
            "description_zh": "快照下载地址",
            "example": "https://path/to/snapshot/zipfile",
            "type": "string",
            "visibility": "Public"
          },
          "WorkDir": {
            "backendName": "workDir",
            "description_en": "The OSS working directory for the snapshot",
            "description_zh": "存储快照的 OSS 工作目录",
            "example": "oss://mybucket.oss-cn-hangzhou-internal.aliyuncs.com/workdir/",
            "type": "string",
            "visibility": "Public"
          },
          "WorkspaceId": {
            "backendName": "workspaceId",
            "description_en": "The workspace ID. To obtain a workspace ID, see [ListWorkspaces]（https://help.aliyun.com/document_detail/449124.html）",
            "description_zh": "工作空间ID。如何获取工作空间ID，请参见 [ListWorkspaces]（https://help.aliyun.com/document_detail/449124.html）",
            "example": "478**",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  },
  "v1_parameters": [
