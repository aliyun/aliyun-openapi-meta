                "description_zh": "资产创建时间，格式 2024-11-21T06:45:32Z表示北京时间 2024-11-21 14:45:32",
                "example": "2024-11-21T06:45:32Z",
                "title_en": "资产创建时间，格式 2024-11-21T06:45:32Z表示北京时间 2024-11-21 14:45:32",
                "title_zh": "资产创建时间，格式 2024-11-21T06:45:32Z表示北京时间 2024-11-21 14:45:32",
                "type": "string"
              },
