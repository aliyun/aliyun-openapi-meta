                      "example": "Playable",
                      "title_en": "状态，支持值：\nQueuing：排队处理中；\nPlayable: 可以播放；\nFailed：打包失败，无法播放。",
                      "title_zh": "状态，支持值：\nQueuing：排队处理中；\nPlayable: 可以播放；\nFailed：打包失败，无法播放。",
                      "type": "string"
                    },
                    "Url": {
                      "backendName": "url",
                      "description_en": "The playback URL. If the asset fails to be packaged, no playback URL is returned",
                      "description_zh": "播放URL，当资产打包失败时不返回对应的播放URL",
                      "example": "https://y92kpc.**/v1/sy9gtc0w00i0bw2q33q2a4y71oydkofm/cvtcqv3lvrftd68k7f5avfjznvv0tje4/o3cfzi6c3qxo18ascgvnz7974qy3c02o/index.m3u8",
                      "title_en": "播放URL，当资产打包失败时不返回对应的播放URL。",
                      "title_zh": "播放URL，当资产打包失败时不返回对应的播放URL。",
                      "type": "string"
                    }
                  },
                  "title_en": "资产打包播放端点。",
                  "title_zh": "资产打包播放端点。",
                  "type": "object"
                },
                "title_en": "资产打包播放输出端点列表，一个打包配置对应一个打包播放端点。",
                "title_zh": "资产打包播放输出端点列表，一个打包配置对应一个打包播放端点。",
                "type": "array"
              },
              "GroupName": {
                "backendName": "asset.groupName",
                "description_en": "The name of the packaging group",
                "description_zh": "打包组名称",
                "example": "vod_hls",
                "title_en": "打包组名称。",
                "title_zh": "打包组名称。",
                "type": "string"
              },
              "Input": {
                "backendName": "asset.input",
                "description_en": "The asset input configurations",
                "description_zh": "打包资产输入",
                "properties": {
                  "Media": {
                    "backendName": "media",
                    "description_en": "The URL of the media file. Only M3U8 files stored in OSS are supported",
                    "description_zh": "输入媒资，目前只支持OSS路径，如 OSS://test-bucket/video/202208/test.m3u8。只支持后缀为.m3u8的输入",
                    "example": "OSS://***test-bucket***/***video/input.m3u8",
                    "title_en": "输入媒资，目前只支持OSS路径，如 OSS://test-bucket/video/202208/test.m3u8。只支持后缀为.m3u8的输入。",
                    "title_zh": "输入媒资，目前只支持OSS路径，如 OSS://test-bucket/video/202208/test.m3u8。只支持后缀为.m3u8的输入。",
                    "type": "string"
                  },
                  "Type": {
                    "backendName": "type",
                    "description_en": "The input type. Only Object Storage Service (OSS) is supported",
                    "description_zh": "输入类型，暂支持OSS",
                    "example": "OSS",
                    "title_en": "输入类型，暂支持OSS。",
                    "title_zh": "输入类型，暂支持OSS。",
                    "type": "string"
                  }
                },
                "title_en": "打包资产输入。",
                "title_zh": "打包资产输入。",
                "type": "object"
              }
            },
            "title_en": "打包资产信息。",
            "title_zh": "打包资产信息。",
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "0622C702-41BE-467E-AF2E-883D4517962E",
            "title_en": "请求ID。",
            "title_zh": "请求ID。",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
