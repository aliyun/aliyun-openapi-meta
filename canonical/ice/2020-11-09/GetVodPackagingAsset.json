                "title_zh": "打包资产名称。",
                "type": "string"
              },
              "ContentId": {
                "backendName": "asset.contentId",
                "description_en": "The content ID in the DRM system. The maximum length is 256 characters. Letters, digits, underscores (_), and hyphens (-) are supported",
                "description_zh": "DRM系统中的内容id，格式：[A-Za-z0-9_-]+，长度最多256",
                "example": "movie",
                "title_en": "DRM系统中的内容id，格式：[A-Za-z0-9_-]+，长度最多256。",
                "title_zh": "DRM系统中的内容id，格式：[A-Za-z0-9_-]+，长度最多256。",
                "type": "string"
