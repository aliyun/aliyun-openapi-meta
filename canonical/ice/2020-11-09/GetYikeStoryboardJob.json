{
  "camel_example": "",
  "cmd_full_name": "ice get-yike-storyboard-job",
  "cmd_name": "get-yike-storyboard-job",
  "deprecated": false,
  "description_en": "Retrieves an AI application task for storyboard generation",
  "description_zh": "获取一刻AI应用任务",
  "kebab_example": "aliyun ice get-yike-storyboard-job --job-id 000020b48fb04483915d4f2cd8ac0000 --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "GetYikeStoryboardJob",
  "operation": {
    "action": "GetYikeStoryboardJob",
    "api_style": "RPC",
    "api_version": "2020-11-09",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "****20b48fb04483915d4f2cd8ac****",
      "help_en": "The snapshot task ID",
      "help_zh": "截图任务ID",
      "location": "query",
      "name": "job_id",
      "options": [
        "--job-id"
      ],
      "raw_name": "JobId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ICE",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "JobId": {
            "backendName": "data.jobId",
            "description_en": "The job ID. You can obtain this value from the response parameters of [Submit a packaging job]（https://help.aliyun.com/document_detail/461964.html）",
            "description_zh": "任务ID。可以从[提交打包任务]（https://help.aliyun.com/document_detail/461964.html）的返回参数中获取",
            "example": "****a046-263c-3560-978a-fb287782****",
            "title_en": "任务ID。可以从[提交打包任务]（https://help.aliyun.com/document_detail/461964.html）的返回参数中获取。",
            "title_zh": "任务ID。可以从[提交打包任务]（https://help.aliyun.com/document_detail/461964.html）的返回参数中获取。",
            "type": "string"
          },
          "JobParams": {
            "backendName": "data.jobParams",
            "description_en": "The algorithm job parameters. This is a JSON object whose content varies depending on the algorithm",
            "description_zh": "算法作业参数，JSON对象，不同算法对应参数内容不同",
            "properties": {
              "AspectRatio": {
                "backendName": "AspectRatio",
                "description_en": "The aspect ratio of the video",
                "description_zh": "视频宽高比",
                "example": "16:9",
                "title_en": "视频宽高比",
                "title_zh": "视频宽高比",
                "type": "string"
              },
              "FileURL": {
                "backendName": "FileURL",
                "description_en": "The OSS URL of the file",
                "description_zh": "文件 OSS 地址",
                "example": "https://test.oss-cn-shanghai.aliyuncs.com/test.mp4",
                "title_en": "文件 OSS 地址",
                "title_zh": "文件 OSS 地址",
                "type": "string"
              },
              "ModelParams": {
                "backendName": "ModelParams",
                "description_en": "The random seed",
                "description_zh": "随机种子",
                "example": "{\n  \"AudioEnable\": false\n}",
                "title_en": "随机种子",
                "title_zh": "随机种子",
                "type": "string"
              },
              "NarrationVoiceId": {
                "backendName": "NarrationVoiceId",
                "description_en": "The narration voice ID",
                "description_zh": "旁白音色",
                "example": "sys_YoungGracefulWoman",
                "title_en": "旁白音色",
                "title_zh": "旁白音色",
                "type": "string"
              },
              "Resolution": {
                "backendName": "Resolution",
                "description_en": "The resolution of the generated video",
                "description_zh": "生成视频分辨率",
                "example": "1K",
                "title_en": "生成视频分辨率",
                "title_zh": "生成视频分辨率",
                "type": "string"
              },
              "ShotPromptMode": {
                "backendName": "ShotPromptMode",
                "description_en": "The shot prompt generation mode",
                "description_zh": "分镜生成模式",
                "example": "multi",
                "title_en": "分镜生成模式",
                "title_zh": "分镜生成模式",
                "type": "string"
              },
              "ShotSplitMode": {
                "backendName": "ShotSplitMode",
                "description_en": "The shot split mode",
                "description_zh": "分镜拆分模式",
                "example": "firstPersonNarration",
                "title_en": "分镜拆分模式",
                "title_zh": "分镜拆分模式",
                "type": "string"
              },
              "SourceType": {
                "backendName": "SourceType",
                "description_en": "The source type",
                "description_zh": "源类型",
                "example": "Novel",
                "title_en": "源类型",
                "title_zh": "源类型",
                "type": "string"
              },
              "StyleId": {
                "backendName": "StyleId",
                "description_en": "The style ID",
                "description_zh": "风格id",
                "example": "RealisticPhotography",
                "title_en": "风格id",
                "title_zh": "风格id",
                "type": "string"
              },
              "Title": {
                "backendName": "Title",
                "description_en": "The job title.\n\n- Maximum length: 128 bytes.\n\n- UTF-8 encoded",
                "description_zh": "任务标题\n\n- 长度不超过128字节。\n\n- UTF8编码",
                "example": "test-title",
                "title_en": "任务标题\n\n- 长度不超过128字节。\n\n- UTF8编码。",
                "title_zh": "任务标题\n\n- 长度不超过128字节。\n\n- UTF8编码。",
                "type": "string"
              },
              "VideoModel": {
                "backendName": "VideoModel",
                "description_en": "The video model",
                "description_zh": "视频模型",
                "example": "wan2.6-r2v-flash",
                "title_en": "视频模型",
                "title_zh": "视频模型",
                "type": "string"
              }
            },
            "title_en": "算法作业参数，JSON对象，不同算法对应参数内容不同。",
            "title_zh": "算法作业参数，JSON对象，不同算法对应参数内容不同。",
            "type": "object"
          },
          "JobResult": {
            "backendName": "data.jobResult",
            "description_en": "The job result",
            "description_zh": "任务结果",
            "properties": {
              "ExceptionStoryboardIds": {
                "backendName": "exceptionStoryboards",
                "description_en": "The list of exception storyboard IDs",
                "description_zh": "异常故事板列表",
                "example": "[\\\"st_2053348871\\\"]",
                "title_en": "异常故事板列表",
                "title_zh": "异常故事板列表",
                "type": "string"
              },
              "FailureShotList": {
                "backendName": "failureShotList",
                "description_en": "The list of failed shots",
                "description_zh": "失败分镜列表",
                "example": "[{\\\"errorCode\\\":\\\"NoMediaData\\\",\\\"storyboardId\\\":\\\"st_2118280473\\\",\\\"shotId\\\":\\\"54\\\"}]",
                "title_en": "失败分镜列表",
                "title_zh": "失败分镜列表",
                "type": "string"
              },
              "OutputUrl": {
                "backendName": "outputUrl",
                "description_en": "The downloadable OSS URL",
                "description_zh": "可下载的OSS地址",
                "example": "https://test.oss-cn-shanghai.aliyuncs.com/test.mp4",
                "title_en": "可下载的OSS地址。",
                "title_zh": "可下载的OSS地址。",
                "type": "string"
              },
              "StoryboardInfoList": {
                "backendName": "storyboardInfoList",
                "description_en": "The detailed storyboard information for the storyboard generation task",
                "description_zh": "故事版生成任务，故事版详细信息",
                "example": "[{\\\"storyboardId\\\":\\\"st_1541525214\\\",\\\"title\\\":\\\"test_1\\\",\\\"status\\\":\\\"Produced\\\",\\\"subStatus\\\":\\\"ProduceSucc\\\"},{\\\"storyboardId\\\":\\\"st_1633435355\\\",\\\"title\\\":\\\"test_2\\\",\\\"status\\\":\\\"Produced\\\",\\\"subStatus\\\":\\\"ProduceSucc\\\"}]",
                "type": "string"
              },
              "SuccessStoryboardIds": {
                "backendName": "successStoryboards",
                "description_en": "The list of successful storyboard IDs, separated by commas",
                "description_zh": "成功故事版数据列表，逗号分割",
                "example": "st_2118280473, st_2118280471",
                "type": "string"
              },
              "SuccessStoryboardList": {
                "backendName": "successStoryboardList",
                "description_en": "The list of successful storyboards",
                "description_zh": "成功故事板列表",
                "example": "[\\\"st_2118280473\\\"]",
                "title_en": "成功故事板列表",
                "title_zh": "成功故事板列表",
                "type": "string"
              }
            },
            "title_en": "任务结果",
            "title_zh": "任务结果",
            "type": "object"
          },
          "JobStatus": {
            "backendName": "data.jobStatus",
            "description_en": "The job status. Valid values:\n\nSucceeded: The job is processed.\n\nFailed: The job failed.\n\nRunning: The job is being processed",
            "description_zh": "任务状态，可取值：\n\nSucceeded：处理成功。\n\nFailed：处理失败。\n\nRunning：处理中",
            "example": "Succeeded",
            "title_en": "任务状态，可取值：\n\nSucceeded：处理成功。\n\nFailed：处理失败。\n\nRunning：处理中。",
            "title_zh": "任务状态，可取值：\n\nSucceeded：处理成功。\n\nFailed：处理失败。\n\nRunning：处理中。",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "******3B-0E1A-586A-AC29-742247******",
            "title_en": "请求ID。",
            "title_zh": "请求ID。",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
