{
  "camel_example": "",
  "cmd_full_name": "ice list-sources",
  "cmd_name": "list-sources",
  "components": {
    "schemas": {
      "ChannelAssemblySource": {
        "description_en": "The source information",
        "description_zh": "源信息",
        "properties": {
          "Arn": {
            "backendName": "arn",
            "description_en": "The ARN of the source",
            "description_zh": "源资源描述",
            "example": "acs:ims:mediaweaver:<regionId>:<userId>:vodSource/mySourceLocation/mySource\n",
            "type": "string"
          },
          "GmtCreate": {
            "backendName": "gmtCreateUTC",
            "description_en": "The time when the source was created",
            "description_zh": "创建时间",
            "example": "2022-10-20T07:15:51Z",
            "type": "string"
          },
          "GmtModified": {
            "backendName": "gmtModifiedUTC",
            "description_en": "The time when the source was last modified",
            "description_zh": "修改时间",
            "example": "2024-11-07T10:12:01Z\n",
            "type": "string"
          },
          "HttpPackageConfigurations": {
            "backendName": "httpPackageConfigurations",
            "description_en": "The source configuration",
            "description_zh": "源配置",
            "example": "[{\n\t\"sourceGroupName\": \"mySourceGroup-1\",\n\t\"relativePath\": \"group1/hls.m3u8\",\n\t\"packageType\": \"hls\"\n}]",
            "type": "string"
          },
          "SourceLocationName": {
            "backendName": "sourceLocationName",
            "description_en": "The name of the source location",
            "description_zh": "源位置名称",
            "example": "MySourceLocation\n",
            "type": "string"
          },
          "SourceName": {
            "backendName": "sourceName",
            "description_en": "The name of the source",
            "description_zh": "源名称",
            "example": "MyVodSource\n",
            "type": "string"
          },
          "SourceType": {
            "backendName": "sourceTypeString",
            "description_en": "The source type. Valid values: vodSource and liveSource",
            "description_zh": "源类型。vodSource，liveSource",
            "example": "vodSource",
            "type": "string"
          },
          "State": {
            "backendName": "state",
            "description_en": "The status of the source. 0: normal. 1: deleted",
            "description_zh": "源状态，0表示正常，1表示删除",
            "example": "0",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
