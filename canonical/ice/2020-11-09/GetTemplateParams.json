  "kebab_example": "aliyun ice get-template-params --template-id 000020b48fb04483915d4f2cd8ac0000 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetTemplateParams",
  "operation": {
    "action": "GetTemplateParams",
    "api_style": "RPC",
    "api_version": "2020-11-09",
