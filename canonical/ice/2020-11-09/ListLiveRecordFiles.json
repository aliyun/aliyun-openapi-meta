                  "type": "string"
                },
                "Height": {
                  "backendName": "Height",
                  "description_en": "The height of the video",
                  "description_zh": "视频高",
                  "example": "640",
                  "format": "int32",
                  "type": "integer"
                },
                "JobId": {
                  "backendName": "JobId",
                  "description_en": "The ID of the recording job",
                  "description_zh": "录制任务ID",
                  "example": "c4d7f0a4-b506-43f9-8de3-07732c3f****",
                  "type": "string"
                },
                "JobName": {
                  "backendName": "JobName",
                  "description_en": "The name of the recording job",
                  "description_zh": "录制任务名称",
                  "example": "LiveRecordJob***",
                  "type": "string"
                },
                "RecordId": {
                  "backendName": "RecordId",
                  "description_en": "The ID of the index file",
                  "description_zh": "索引文件ID",
                  "example": "c4d7f0a4-b506-43f9-8de3-07732c3f****",
                  "type": "string"
                },
                "RecordOutput": {
                  "backendName": "RecordOutput",
                  "description_en": "The storage information about the recording file",
                  "description_zh": "录制文件的储存相关信息",
                  "example": "{ \"Type\": \"oss\", \"Endpoint\":\"oss-cn-shanghai.aliyuncs.com\", \"Bucket\": \"test-bucket\" }",
                  "type": "string"
                },
                "RecordUrl": {
                  "backendName": "RecordUrl",
                  "description_en": "The URL of the index file",
                  "description_zh": "索引文件地址",
                  "example": "http://****/atestObject****.m3u8",
                  "type": "string"
                },
                "StartTime": {
                  "backendName": "StartTime",
                  "description_en": "The beginning of the time range to query. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
                  "description_zh": "开始时间。格式为：yyyy-MM-ddTHH:mm:ssZ（UTC时间）",
                  "example": "2015-12-01T07:36:00Z",
                  "type": "string"
                },
                "StreamUrl": {
                  "backendName": "StreamUrl",
                  "description_en": "The name of the live stream",
                  "description_zh": "直播流名",
                  "example": "LiveStream***",
                  "type": "string"
                },
                "Width": {
                  "backendName": "Width",
                  "description_en": "The width of the video",
                  "description_zh": "视频宽",
                  "example": "480",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "PageNo": {
            "backendName": "data.PageNo",
            "description_en": "The page number",
            "description_zh": "分页的页码",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "PageSize": {
            "backendName": "data.PageSize",
            "description_en": "The number of entries per page",
            "description_zh": "每页大小",
            "example": "10",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "DE24625C-7C0F-4020-8448-****",
            "type": "string"
          },
          "SortBy": {
            "backendName": "data.SortBy",
            "description_en": "The sorting order of the index files by creation time",
            "description_zh": "排序",
            "example": "asc",
            "type": "string"
          },
          "TotalCount": {
            "backendName": "data.TotalCount",
            "description_en": "The total number of files that meet the specified conditions",
            "description_zh": "符合条件的总个数",
            "example": "100",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
