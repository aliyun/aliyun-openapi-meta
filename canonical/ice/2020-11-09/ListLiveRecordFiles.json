{
  "camel_example": "",
  "cmd_full_name": "ice list-live-record-files",
  "cmd_name": "list-live-record-files",
  "deprecated": false,
  "description_en": "Queries all recording index files in the specified period of time",
  "description_zh": "调用ListLiveRecordFiles查询某个时间段内的所有录制索引文件",
  "kebab_example": "aliyun ice list-live-record-files --end-time 2017-12-22T08:00:00Z --start-time 2017-12-21T08:00:01Z --job-ids 9E83D5D0-8D72-5E7D-B61A-0000 --page-no 1 --page-size 10 --sort-by asc --record-format m3u8 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListLiveRecordFiles",
  "operation": {
    "action": "ListLiveRecordFiles",
    "api_style": "RPC",
    "api_version": "2020-11-09",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "2017-12-22T08:00:00Z",
      "help_en": "The end of the time range to query. The maximum time range to query is four days. Specify the time in the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time must be in UTC",
      "help_zh": "结束时间。与StartTime间隔时间不能超过4天。格式为：yyyy-MM-ddTHH:mm:ssZ（UTC时间）",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "2017-12-21T08:00:01Z",
      "help_en": "The beginning of the time range to query. Specify the time in the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time must be in UTC",
      "help_zh": "开始时间。格式为：yyyy-MM-ddTHH:mm:ssZ（UTC时间）",
      "location": "query",
      "name": "start_time",
      "options": [
        "--start-time"
      ],
      "raw_name": "StartTime",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The list of job IDs",
      "help_zh": "任务ID列表",
      "location": "query",
      "name": "job_ids",
      "options": [
        "--job-ids"
      ],
      "param_style": "flat",
      "raw_name": "JobIds",
      "required": false,
      "type": "array"
    },
    {
      "example": "1",
      "help_en": "The page number of the page to return. Default value: 1",
      "help_zh": "当前页码。默认值为1",
      "location": "query",
      "name": "page_no",
      "options": [
        "--page-no"
      ],
      "raw_name": "PageNo",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of entries per page. Valid values: 5 to 30. Default value: 10",
      "help_zh": "每页大小。取值范围：5~30，默认值为10",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "asc",
      "help_en": "The sorting order of the index files by creation time. Valid values:\n\nasc: The query results are displayed in ascending order. This is the default value.\n\ndesc: The query results are displayed in descending order",
      "help_zh": "排序。取值：\n\nasc（默认值）：升序。\n\ndesc：降序",
      "location": "query",
      "name": "sort_by",
      "options": [
        "--sort-by"
      ],
      "raw_name": "SortBy",
      "required": false,
      "type": "string"
    },
    {
      "example": "m3u8",
      "help_en": "The format of the recording file. Valid values:\n\nM3U8, FLV, and MP4",
      "help_zh": "录制文件格式。取值：\n\nm3u8， flv， mp4",
      "location": "query",
      "name": "record_format",
      "options": [
        "--record-format"
      ],
      "raw_name": "RecordFormat",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ICE",
  "protocol": "HTTP|HTTPS",
