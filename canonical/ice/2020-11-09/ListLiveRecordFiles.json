                  "format": "float",
                  "type": "number"
                },
                "EndTime": {
                  "backendName": "EndTime",
                  "description_en": "The end of the time range to query. The time follows the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time is displayed in UTC",
                  "description_zh": "结束时间。格式为：yyyy-MM-ddTHH:mm:ssZ（UTC时间）",
                  "example": "2015-12-01T07:36:10Z",
                  "type": "string"
                },
                "Format": {
                  "backendName": "Format",
                  "description_en": "The format of the recording file",
