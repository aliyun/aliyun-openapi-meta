            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "******3B-0E1A-586A-AC29-742247******",
            "title_en": "请求ID",
            "title_zh": "请求ID",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
