{
  "camel_example": "",
  "cmd_full_name": "ice query-dna-job-list",
  "cmd_name": "query-dna-job-list",
  "deprecated": false,
  "description_en": "Queries DNA jobs by calling QueryDNAJobList",
  "description_zh": "调用QueryDNAJobList查询DNA作业",
  "kebab_example": "aliyun ice query-dna-job-list --job-ids 88c6ca184c0e47098a5b665e2a120000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "QueryDNAJobList",
  "operation": {
    "action": "QueryDNAJobList",
    "api_style": "RPC",
    "api_version": "2020-11-09",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "88c6ca184c0e47098a5b665e2a12****",
      "help_en": "The IDs of the DNA jobs to query. You can specify up to 10 job IDs at a time, separated by commas (,)",
      "help_zh": "需要查询的DNA作业ID列表。一次最多建议查询10个，用半角逗号（,）分隔",
      "location": "query",
      "name": "job_ids",
      "options": [
        "--job-ids"
      ],
      "raw_name": "JobIds",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ICE",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "JobList": {
            "backendName": "data.dNAJobList",
            "description_en": "The DNA job information",
            "description_zh": "DNA作业信息",
            "itemName": "DNAJob",
            "items": {
              "description_en": "DNAJob",
              "description_zh": "DNAJob",
              "properties": {
                "Code": {
                  "backendName": "code",
                  "description_en": "The error code of the job execution",
                  "description_zh": "作业执行错误码",
                  "example": "\"InvalidParameter.ResourceNotFound\"",
                  "type": "string",
                  "visibility": "Public"
                },
                "Config": {
                  "backendName": "config",
                  "description_en": "The DNA configuration",
                  "description_zh": "DNA配置",
                  "example": "{\"SaveType\": \"save\",\"MediaType\"\":\"video\"}",
                  "type": "string",
                  "visibility": "Public"
                },
                "CreationTime": {
                  "backendName": "createTime",
                  "description_en": "The time when the job was created",
                  "description_zh": "作业创建时间",
                  "example": "2022-12-28T03:21:37Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "DBId": {
                  "backendName": "dBId",
                  "description_en": "The ID of the DNA library",
                  "description_zh": "DNA库Id",
                  "example": "2288c6ca184c0e47098a5b665e2a12****",
                  "type": "string"
                },
                "DNAResult": {
                  "backendName": "dNAResult",
                  "description_en": "The DNA result link",
                  "description_zh": "DNA结果链接",
                  "example": "http://test_bucket.oss-cn-shanghai.aliyuncs.com/fingerprint/video/search_result/5/5.txt",
                  "type": "string",
                  "visibility": "Public"
                },
                "FinishTime": {
                  "backendName": "finishTime",
                  "description_en": "The time when the job was completed",
                  "description_zh": "作业完成时间",
                  "example": "2022-12-28T03:21:44Z",
                  "type": "string",
                  "visibility": "Public"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "The job ID",
                  "description_zh": "作业ID",
                  "example": "88c6ca184c0e47098a5b665e2a12****",
                  "type": "string",
                  "visibility": "Public"
                },
                "Input": {
                  "backendName": "input",
                  "description_en": "The input file",
                  "description_zh": "输入文件",
                  "properties": {
                    "Media": {
                      "backendName": "media",
                      "description_en": "The input file information. Both OSS addresses and media asset IDs are supported.\nThe OSS address rules are as follows:\n\noss://bucket/object\n\nhttp(s)://bucket.oss-[regionId].aliyuncs.com/object\n\nIn the preceding rules, bucket is the name of the OSS bucket that is in the same region as the current project, and object is the file path",
                      "description_zh": "输入文件信息，支持OSS地址和媒资ID两种。\nOSS地址规则为\n\n1、oss://bucket/object\n\n2、http(s)://bucket.oss-[regionId].aliyuncs.com/object\n\n其中bucket为和当前项目处于同一区域的oss bucket名称，object为文件路径",
                      "example": "1b1b9cd148034739af413150fded****",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "Type": {
                      "backendName": "type",
                      "description_en": "The type of the input file. Valid values:\nOSS: an OSS file address.\nMedia: a media asset ID",
                      "description_zh": "输入文件类型，取值：\nOSS：OSS文件地址\nMedia：媒资ID",
                      "example": "Media",
                      "type": "string",
                      "visibility": "Public"
                    }
                  },
                  "type": "object",
                  "visibility": "Public"
                },
                "Message": {
                  "backendName": "message",
                  "description_en": "The error message of the job execution",
                  "description_zh": "作业执行错误信息",
                  "example": "\"The resource operated \\\"a887d0b***d805ef6f7f6786302\\\" cannot be found\"",
                  "type": "string",
                  "visibility": "Public"
                },
                "PrimaryKey": {
                  "backendName": "primaryKey",
                  "description_en": "The unique primary key of the video. The uniqueness is guaranteed by the user",
                  "description_zh": "唯一的视频主键，唯一性由用户保证",
                  "example": "3ca84a39a9024f19853b21be9cf9****",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The job status. Valid values:\n\nQueuing: The job is queued.\nAnalysing: The job is being analyzed.\nSuccess: The job succeeded.\nFail: The job failed",
                  "description_zh": "作业状态，可取值：\n\nQueuing：排队中。\nAnalysing：分析中。\nSuccess：成功。\nFail：失败",
                  "example": "Queuing",
                  "type": "string",
                  "visibility": "Public"
                },
                "UserData": {
                  "backendName": "userData",
                  "description_en": "The custom data",
                  "description_zh": "用户自定义数据",
                  "example": "testdna",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "25818875-5F78-4A13-BEF6-D7393642CA58",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
