                                "H": {
                                  "backendName": "h",
                                  "description_en": "The height of the bounding box, in pixels",
                                  "description_zh": "矩形框高度，单位为像素",
                                  "example": "168",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "W": {
                                  "backendName": "w",
                                  "description_en": "The width of the bounding box, in pixels",
                                  "description_zh": "矩形框宽度，单位为像素",
                                  "example": "128",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "X": {
                                  "backendName": "x",
                                  "description_en": "The x-axis coordinate of the upper-left vertex, in pixels",
                                  "description_zh": "左上顶点x轴坐标，单位为像素",
                                  "example": "517",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "Y": {
                                  "backendName": "y",
                                  "description_en": "The y-axis coordinate of the upper-left vertex, in pixels",
                                  "description_zh": "左上顶点y轴坐标，单位为像素",
                                  "example": "409",
                                  "format": "int32",
                                  "type": "integer"
                                }
                              },
                              "type": "object"
                            },
                            "Timestamp": {
                              "backendName": "timestamp",
                              "description_en": "The timestamp when the face appears in the media asset, in seconds. The value is of the Float type",
                              "description_zh": "人脸在媒资中出现的时间戳，单位为秒，Float类型",
                              "example": "62.03302",
                              "format": "float",
                              "type": "number"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "type": "object"
                  },
                  "title_en": "FileInfos",
                  "title_zh": "FileInfos",
                  "type": "array"
                },
                "Score": {
                  "backendName": "score",
                  "description_en": "The score of the matched clip. The value is of the Float type and ranges from 0 to 1",
                  "description_zh": "匹配片段得分，Float类型，范围为[0，1]",
                  "example": "0.99041677",
                  "format": "float",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "title_en": "符合要求的媒资集合",
            "title_zh": "符合要求的媒资集合",
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "E44FFACD-9E90-555A-A09A-6FD3B7335E39",
            "type": "string"
          },
          "Success": {
            "backendName": "success",
            "description_en": "Indicates whether the operation was successful. A value of true indicates success. A value of false indicates failure",
            "description_zh": "操作是否成功。true表示成功，false表示失败",
            "example": "true",
            "type": "string"
          },
          "Total": {
            "backendName": "data.total",
            "description_en": "The total number of media asset clips that meet the conditions",
            "description_zh": "符合条件的媒资片段总数",
            "example": "5",
            "format": "int64",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object",
        "visibility": "Public"
