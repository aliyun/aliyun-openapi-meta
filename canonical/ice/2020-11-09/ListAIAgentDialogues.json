                  "type": "string"
                },
                "Producer": {
                  "backendName": "producer",
                  "description_en": "The producer of this message. Valid values:\n\nuser: a message produced by the user.\n\nagent: a message produced by the agent",
                  "description_zh": "这句话的产生者。\n\nuser： 用户产生的句子\n\nagent：智能体产生的句子",
