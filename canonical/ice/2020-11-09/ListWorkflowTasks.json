                    "WorkflowId": {
                      "backendName": "workflowId",
                      "description_en": "The workflow ID",
                      "description_zh": "工作流ID",
                      "example": "******2491c84dce913da9fe65******",
                      "type": "string"
                    }
                  },
                  "type": "object"
