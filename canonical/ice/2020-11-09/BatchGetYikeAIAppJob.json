                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the job. Valid values are:\n\n`Created`: The job has been created.\n\n`Queuing`: The job is in the queue.\n\n`Executing`: The job is executing.\n\n`Finished`: The job completed successfully.\n\n`Failed`: The job failed to complete",
