{
  "camel_example": "",
  "cmd_full_name": "ice submit-media-convert-job",
  "cmd_name": "submit-media-convert-job",
  "components": {
    "schemas": {
      "MediaConvertInput": {
        "description_en": "The input file for transcoding",
        "description_zh": "转码输入",
        "properties": {
          "InputFile": {
            "$ref": "#/components/schemas/MediaObject",
            "backendName": "inputFile",
            "description_en": "The input file",
            "description_zh": "输入文件",
            "title": "输入文件"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The name of the input file. If Output contains InputRef, use this name to reference the input file",
            "description_zh": "输入文件名称。Output 中有 InputRef 时，可以使用该名称实现对输入文件的引用",
            "example": "InputVideo",
            "type": "string"
          }
        },
        "title": "转码输入",
        "type": "object"
      },
      "MediaConvertOutput": {
        "description_en": "The output configuration",
        "description_zh": "转码输出配置",
        "properties": {
          "Features": {
            "backendName": "features",
            "description_en": "The feature parameters",
            "description_zh": "功能参数",
            "example": "{}",
            "type": "string"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The name of the output",
            "description_zh": "转码输出名称",
            "example": "output-video",
            "title": "转码输出名称",
            "type": "string"
          },
          "OutputFile": {
            "$ref": "#/components/schemas/MediaObject",
            "backendName": "outputFile",
            "description_en": "The output file",
            "description_zh": "转码输出文件",
            "title": "转码输出文件"
          },
          "OverrideParams": {
            "backendName": "overrideParams",
            "description_en": "A JSON string containing parameters to overwrite the corresponding settings of the template",
            "description_zh": "覆盖参数（JSON字符串），支持对转码模板关联的参数覆盖",
            "example": "{}",
            "type": "string"
          },
          "Priority": {
            "backendName": "priority",
            "description_en": "The priority. Valid values: 1 to 10. A larger value indicates a higher priority. Default value: 6",
            "description_zh": "优先级，1-10，值越大，优先级越高，默认6",
            "example": "6",
            "format": "int32",
            "maximum": "10",
            "minimum": "1",
            "title": "优先级，1-10，值越大，优先级越高，默认6",
            "type": "integer"
          },
          "TemplateId": {
            "backendName": "templateId",
            "description_en": "The ID of the transcoding template",
            "description_zh": "转码模板ID",
            "example": "****96e8864746a0b6f3****",
            "title": "转码模板ID",
            "type": "string"
          }
        },
        "title": "转码输出配置",
        "type": "object"
      },
      "MediaConvertOutputDetail": {
        "description_en": "The details for the output of a MediaConvert task",
        "description_zh": "MediaConvert输出详情",
        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The error code for a failed task",
            "description_zh": "转码失败错误码",
            "example": "InvalidParameter.ResourceContentBad\n",
            "title": "转码失败错误码",
            "type": "string"
          },
          "CreateTime": {
            "backendName": "createTime",
            "description_en": "The time the output task was created, in UTC format (yyyy-MM-ddTHH:mm:ssZ)",
            "description_zh": "输出创建时间，格式为<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
            "example": "2024-12-07T06:06:58Z",
            "type": "string"
          },
          "FinishTime": {
            "backendName": "finishTime",
            "description_en": "The time the output task finished, in UTC format (yyyy-MM-ddTHH:mm:ssZ)",
            "description_zh": "输出结束时间，格式为<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
            "example": "2024-12-07T13:01:07Z",
            "type": "string"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The reason for a task failure",
            "description_zh": "转码失败详细原因",
            "example": "The resource operated InputFile is bad\n",
            "title": "转码失败详细原因",
            "type": "string"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The name of the output",
            "description_zh": "转码输出名称",
            "example": "720P-mp4",
            "title": "转码输出名称",
            "type": "string"
          },
          "Result": {
            "backendName": "result",
            "description_en": "The detailed output results",
            "description_zh": "输出结果详情",
            "properties": {
              "OutFileMeta": {
                "$ref": "#/components/schemas/MediaConvertOutputDetailFileMeta",
                "backendName": "outFileMeta",
                "description_en": "The metadata of the audio and video streams",
                "description_zh": "音视频流元信息"
              },
              "OutputFile": {
                "backendName": "outputFile",
                "description_en": "Details about the generated output file",
                "description_zh": "输出文件详情",
                "properties": {
                  "Media": {
                    "backendName": "media",
                    "description_en": "The value depends on the Type field:\n\nIf Type is set to OSS, the value is the URL of the output file. The following formats are supported: oss://... and https://...\nIf Type is set to Media, the value is the ID of the media asset",
                    "description_zh": "媒体值：\n\ntype 为 OSS 时，URL 支持 OSS 协议和 HTTP 协议；\ntype 为 Media 时，为媒资 ID",
                    "example": "oss://bucket/path/to/video.mp4\n",
                    "type": "string"
                  },
                  "Type": {
                    "backendName": "type",
                    "description_en": "The type of the output file. Valid values:\n\nOSS: an Object Storage Service (OSS) object.\nMedia: a media asset",
                    "description_zh": "媒体对象类型。 取值：\nOSS：OSS 文件；\nMedia：媒资 ID",
                    "example": "OSS",
                    "type": "string"
                  },
                  "Url": {
                    "backendName": "url",
                    "description_en": "If Type is set to Media, this field provides the actual storage URL of the media asset",
                    "description_zh": "Type 为 Media 时，用来说明真实文件地址",
                    "example": "oss://bucket/path/to/video.mp4",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "Status": {
            "backendName": "status",
            "description_en": "The task status. Valid values:\n\nInit: Initializing the task.\nScheduled: The task is scheduled for processing.\nSuccess: The task is completed.\nFailed: The task failed.\nSkipped: The task was skipped",
            "description_zh": "任务状态:\nInit: 初始化；\nScheduled: 已调度；\nSuccess: 成功；\nFailed: 失败；\nSkipped: 已跳过",
            "example": "Success",
            "title": "任务状态\n",
            "type": "string"
          },
          "TaskId": {
            "backendName": "taskId",
            "description_en": "The task ID",
            "description_zh": "转码输出任务ID",
            "example": "******4215e042b3966ca5441e******",
            "title": "转码输出任务ID",
            "type": "string"
          }
        },
        "type": "object"
      },
      "MediaConvertOutputDetailFileMeta": {
        "description_en": "The metadata of a media file",
        "description_zh": "音视频文件元信息",
        "properties": {
          "AudioStreamInfoList": {
            "backendName": "audioStreamInfoList",
            "description_en": "The audio stream information",
            "description_zh": "音频流信息",
            "itemName": "AudioStreamInfoList",
            "items": {
              "description_en": "The audio stream metadata",
              "description_zh": "音频流元信息",
              "properties": {
                "Bitrate": {
                  "backendName": "bitrate",
                  "description_en": "The bitrate",
                  "description_zh": "码率",
                  "example": "0.f",
                  "title": "码率。",
                  "type": "string"
                },
                "ChannelLayout": {
                  "backendName": "channelLayout",
                  "description_en": "The layout of the audio channels",
                  "description_zh": "声道布局",
                  "example": "stereo",
                  "title": "声道布局。",
                  "type": "string"
                },
                "Channels": {
                  "backendName": "channels",
                  "description_en": "The number of audio channels",
                  "description_zh": "声道数",
                  "example": "2",
                  "title": "声道数。",
                  "type": "string"
                },
                "CodecLongName": {
                  "backendName": "codecLongName",
                  "description_en": "The full name of the codec",
                  "description_zh": "编码格式名",
                  "example": "AAC (Advanced Audio Coding)",
                  "title": "编码格式名。",
                  "type": "string"
                },
                "CodecName": {
                  "backendName": "codecName",
                  "description_en": "The short name of the codec",
                  "description_zh": "编码格式",
                  "example": "aac",
                  "title": "编码格式。",
                  "type": "string"
                },
                "CodecTag": {
                  "backendName": "codecTag",
                  "description_en": "The tag of the codec",
                  "description_zh": "编码器标签",
                  "example": "0x000f",
                  "title": "编码器标签。",
                  "type": "string"
                },
                "CodecTagString": {
                  "backendName": "codecTagString",
                  "description_en": "The tag of the codec",
                  "description_zh": "编码器标签名",
                  "example": "[15][0][0][0]",
                  "title": "编码器标签名。",
                  "type": "string"
                },
                "CodecTimeBase": {
                  "backendName": "codecTimeBase",
                  "description_en": "The time base used by the codec",
                  "description_zh": "编码器时间基",
                  "example": "1/44100",
                  "title": "编码器时间基。",
                  "type": "string"
                },
                "Duration": {
                  "backendName": "duration",
                  "description_en": "The duration of the stream. Unit: seconds",
                  "description_zh": "时长（单位: 秒）",
                  "example": "403.039989",
                  "title": "时长（单位: 秒）。",
                  "type": "string"
                },
                "Index": {
                  "backendName": "index",
                  "description_en": "The index of this stream within the file",
                  "description_zh": "流序号",
                  "example": "1",
                  "title": "流序号。",
                  "type": "string"
                },
                "Lang": {
                  "backendName": "lang",
                  "description_en": "The language code for the stream",
                  "description_zh": "语言",
                  "example": "cn",
                  "title": "语言。",
                  "type": "string"
                },
                "SampleFmt": {
                  "backendName": "sampleFmt",
                  "description_en": "The audio sample format",
                  "description_zh": "采样格式",
                  "example": "fltp",
                  "title": "采样格式。",
                  "type": "string"
                },
                "SampleRate": {
                  "backendName": "sampleRate",
                  "description_en": "The sample rate. Unit: Hz",
                  "description_zh": "采样率（单位: Hz）",
                  "example": "44100",
                  "title": "采样率（单位: Hz）。",
                  "type": "string"
                },
                "StartTime": {
                  "backendName": "startTime",
                  "description_en": "The start time of the stream. Unit: seconds",
                  "description_zh": "开始时间",
                  "example": "1.473556",
                  "title": "开始时间。",
                  "type": "string"
                },
                "Timebase": {
                  "backendName": "timebase",
                  "description_en": "The time base of the stream's presentation timestamps",
                  "description_zh": "时间基",
                  "example": "1/90000",
                  "title": "时间基。",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "title": "音频流信息",
            "type": "array"
          },
          "FileBasicInfo": {
            "backendName": "fileBasicInfo",
            "description_en": "The basic information of the media file",
            "description_zh": "基础文件信息",
            "properties": {
              "Bitrate": {
                "backendName": "bitrate",
                "description_en": "The video bitrate",
                "description_zh": "视频码率",
                "example": "888.563",
                "title": "视频码率。",
                "type": "string"
              },
              "Duration": {
                "backendName": "duration",
                "description_en": "The total duration of the media file. Unit: seconds",
                "description_zh": "视频时长（单位: 秒）",
                "example": "403.039999",
                "title": "视频时长（单位: 秒）。",
                "type": "string"
              },
              "FileName": {
                "backendName": "fileName",
                "description_en": "The name of the file",
                "description_zh": "文件名",
                "example": "file.m3u8",
                "title": "文件名。",
                "type": "string"
              },
              "FileSize": {
                "backendName": "fileSize",
                "description_en": "The file size. Unit: bytes",
                "description_zh": "文件大小。单位：Byte",
                "example": "31737",
                "title": "文件大小。单位：Byte。",
                "type": "string"
              },
              "FileStatus": {
                "backendName": "fileStatus",
                "description_en": "The status of the file",
                "description_zh": "文件状态",
                "example": "Normal",
                "title": "文件状态。",
                "type": "string"
              },
              "FileType": {
                "backendName": "fileType",
                "description_en": "Indicates if this is the source or a transcoded output. Valid values: source_file and transcode_file",
                "description_zh": "文件类型。取值: source_file, transcode_file",
                "example": "source_file",
                "title": "文件类型。取值: source_file, transcode_file",
                "type": "string"
              },
              "FileUrl": {
                "backendName": "fileUrl",
                "description_en": "The URL of the file",
                "description_zh": "文件 URL",
                "example": "http://bucket.oss-cn-shanghai.aliyuncs.com/path/to/file.m3u8",
                "title": "文件 URL。",
                "type": "string"
              },
              "FormatName": {
                "backendName": "formatName",
                "description_en": "The container format name",
                "description_zh": "视频格式名称",
                "example": "hls,applehttp",
                "title": "视频格式名称。",
                "type": "string"
              },
              "Height": {
                "backendName": "height",
                "description_en": "The height of the video, in pixels",
                "description_zh": "高",
                "example": "478",
                "title": "高。",
                "type": "string"
              },
              "MediaId": {
                "backendName": "mediaId",
                "description_en": "The ID of the media asset",
                "description_zh": "媒资 ID",
                "example": "9066406c306771f0bfa35107e0c90102",
                "title": "媒资 ID。",
                "type": "string"
              },
              "Region": {
                "backendName": "region",
                "description_en": "The storage region of the file",
                "description_zh": "文件所在区域",
                "example": "cn-shanghai",
                "title": "文件所在区域。",
                "type": "string"
              },
              "Width": {
                "backendName": "width",
                "description_en": "The width of the video, in pixels",
                "description_zh": "宽",
                "example": "848",
                "title": "宽。",
                "type": "string"
              }
            },
            "title": "基础文件信息",
            "type": "object"
          },
          "VideoStreamInfoList": {
            "backendName": "videoStreamInfoList",
            "description_en": "The video stream information",
            "description_zh": "视频流信息",
            "itemName": "VideoStreamInfoList",
            "items": {
              "description_en": "The video stream metadata",
              "description_zh": "视频流元信息",
              "properties": {
                "Avg_fps": {
                  "backendName": "avg_fps",
                  "description_en": "The average frame rate",
                  "description_zh": "平均帧率",
                  "example": "25.0",
                  "title": "平均帧率。",
                  "type": "string"
                },
                "Bit_rate": {
                  "backendName": "bit_rate",
                  "description_en": "The bitrate",
                  "description_zh": "码率",
                  "example": "888.563",
                  "title": "码率。",
                  "type": "string"
                },
                "Codec_long_name": {
                  "backendName": "codec_long_name",
                  "description_en": "The full name of the codec",
                  "description_zh": "编码格式名",
                  "example": "H.264 / AVC / MPEG-4 AVC / MPEG-4 part 10",
                  "title": "编码格式名。",
                  "type": "string"
                },
                "Codec_name": {
                  "backendName": "codec_name",
                  "description_en": "The short name of the codec",
                  "description_zh": "编码格式",
                  "example": "h264",
                  "title": "编码格式。",
                  "type": "string"
                },
                "Codec_tag": {
                  "backendName": "codec_tag",
                  "description_en": "The tag of the codec",
                  "description_zh": "编码格式标记",
                  "example": "0x001b",
                  "title": "编码格式标记。",
                  "type": "string"
                },
                "Codec_tag_string": {
                  "backendName": "codec_tag_string",
                  "description_en": "The tag of the codec",
                  "description_zh": "编码格式标记文本",
                  "example": "[27][0][0][0]",
                  "title": "编码格式标记文本。",
                  "type": "string"
                },
                "Codec_time_base": {
                  "backendName": "codec_time_base",
                  "description_en": "The time base used by the codec",
                  "description_zh": "编码时基",
                  "example": "1/50",
                  "type": "string"
                },
                "Dar": {
                  "backendName": "dar",
                  "description_en": "The display aspect ratio",
                  "description_zh": "图像显示宽高比",
                  "example": "16:9",
                  "title": "图像显示宽高比。",
                  "type": "string"
                },
                "Duration": {
                  "backendName": "duration",
                  "description_en": "The duration of the stream. Unit: seconds",
                  "description_zh": "时长（单位: 秒）",
                  "example": "403.039989",
                  "title": "时长（单位: 秒）。",
                  "type": "string"
                },
                "Fps": {
                  "backendName": "fps",
                  "description_en": "The frame rate",
                  "description_zh": "帧率",
                  "example": "25.0",
                  "title": "帧率。",
                  "type": "string"
                },
                "Has_b_frames": {
                  "backendName": "has_b_frames",
                  "description_en": "Indicates whether the video stream contains B-frames. Valid value:\n\n0: None.\n1: One B-frame.\n2: Multiple consecutive B-frames",
                  "description_zh": "是否有B帧。\n取值: \n0: 没有 B 帧, \n1: 有一个 B 帧, \n2: 有多个连续 B 帧",
                  "example": "2",
                  "title": "是否有B帧。\n取值: \n- 0: 没有 B 帧, \n- 1: 有一个 B 帧, \n- 2: 有多个连续 B 帧。",
                  "type": "string"
                },
                "Height": {
                  "backendName": "height",
                  "description_en": "The height of the video stream, in pixels",
                  "description_zh": "高",
                  "example": "478",
                  "title": "高。",
                  "type": "string"
                },
                "Index": {
                  "backendName": "index",
                  "description_en": "The index of this stream within the file",
                  "description_zh": "流序号",
                  "example": "0",
                  "title": "流序号。",
                  "type": "string"
                },
                "Lang": {
                  "backendName": "lang",
                  "description_en": "The language code for the stream",
                  "description_zh": "语言",
                  "example": "cn",
                  "title": "语言。",
                  "type": "string"
                },
                "Level": {
                  "backendName": "level",
                  "description_en": "The codec level",
                  "description_zh": "编码等级",
                  "example": "31",
                  "title": "编码等级。",
                  "type": "string"
                },
                "NumFrames": {
                  "backendName": "numFrames",
                  "description_en": "The total number of frames",
                  "description_zh": "总帧数",
                  "example": "10040",
                  "title": "总帧数。",
                  "type": "string"
                },
                "PixFmt": {
                  "backendName": "pixFmt",
                  "description_en": "The pixel format",
                  "description_zh": "颜色存储格式",
                  "example": "yuv420p",
                  "title": "颜色存储格式。",
                  "type": "string"
                },
                "Profile": {
                  "backendName": "profile",
                  "description_en": "The codec profile",
                  "description_zh": "编码器预设",
