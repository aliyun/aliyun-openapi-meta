                  "title": "采集点数宽高比。",
                  "type": "string"
                },
                "Start_time": {
                  "backendName": "start_time",
                  "description_en": "The start time of the stream",
                  "description_zh": "起始时间",
                  "example": "1.473556",
                  "title": "起始时间。",
                  "type": "string"
                },
                "Time_base": {
                  "backendName": "time_base",
                  "description_en": "The time base of the stream's presentation timestamps",
                  "description_zh": "时基",
                  "example": "1/90000",
                  "title": "时基。",
                  "type": "string"
                },
                "Width": {
                  "backendName": "width",
                  "description_en": "The width of the video stream, in pixels",
                  "description_zh": "宽",
                  "example": "848",
                  "title": "宽。",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "title": "视频流信息",
            "type": "array"
          }
        },
        "type": "object"
      },
      "MediaConvertOutputGroup": {
        "description_en": "The output group configuration",
        "description_zh": "输出组设置",
        "properties": {
          "GroupConfig": {
            "$ref": "#/components/schemas/MediaConvertOutputGroupConfig",
            "backendName": "groupConfig",
            "description_en": "The output group configuration",
            "description_zh": "输出组配置",
            "title": "输出组配置"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The name of the output group",
            "description_zh": "输出组名称",
            "example": "hls-group",
            "title": "输出组名称",
            "type": "string"
          },
          "Outputs": {
            "backendName": "outputs",
