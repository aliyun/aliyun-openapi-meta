{
  "camel_example": "",
  "cmd_full_name": "ice get-categories",
  "cmd_name": "get-categories",
  "deprecated": false,
  "description_en": "Queries the information about a category and its subcategories",
  "description_zh": "调用GetCategories获取指定的分类信息，及其子分类（即下一级分类）的列表",
  "kebab_example": "aliyun ice get-categories --cate-id 33 --page-no 1 --page-size 10 --sort-by CreationTime:Desc --type default --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetCategories",
  "operation": {
    "action": "GetCategories",
    "api_style": "RPC",
    "api_version": "2020-11-09",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "33",
      "help_en": "The category ID. You can use one of the following methods to obtain the ID:\n\nLog on to the Intelligent Media Services (IMS) console (https://ims.console.aliyun.com) and choose Media Asset Management > Category Management to view the category ID.\n\nView the value of CateId returned by the AddCategory operation that you called to create a category.\n\nView the value of CateId returned by the GetCategories operation that you called to query a category",
      "help_zh": "分类ID。可通过以下方式获取：\n登录IMS控制台 (https://ims.console.aliyun.com)，选择 媒资管理 > 分类管理查看分类ID。\n通过创建分类接口创建分类时，分类ID为返回参数CateId的值。\n通过获取分类接口查询分类时，为请求后返回参数CateId的值",
      "location": "query",
      "name": "cate_id",
      "options": [
        "--cate-id"
      ],
      "raw_name": "CateId",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number. Default value: 1",
      "help_zh": "分页的页码。默认值：1",
      "location": "query",
      "name": "page_no",
      "options": [
        "--page-no"
      ],
      "raw_name": "PageNo",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of entries per page. Valid values: 10 to 100",
      "help_zh": "分页大小，最小值为10，最大值为100",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "CreationTime:Desc",
      "help_en": "The sorting rule of results. Valid values:\n\n- CreationTime:Desc (default): The results are sorted in reverse chronological order based on the creation time.\n\n- CreationTime:Asc: The results are sorted in chronological order based on the creation time",
      "help_zh": "结果排序方式。取值范围：\n\nCreationTime:Desc（默认值）：按创建时间倒序。\n\nCreationTime:Asc：按创建时间升序",
      "location": "query",
      "name": "sort_by",
      "options": [
        "--sort-by"
      ],
      "raw_name": "SortBy",
      "required": false,
      "type": "string"
    },
    {
      "example": "default",
      "help_en": "The type of the category. Valid values: default and material. A value of default indicates audio, video, and image files. This is the default value. A value of material indicates short video materials",
      "help_zh": "分类类型。取值：\n\ndefault（默认值）：音视频/图片分类。\n\nmaterial：短视频素材分类",
      "location": "query",
      "name": "type",
      "options": [
        "--type"
      ],
      "raw_name": "Type",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ICE",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Category": {
            "backendName": "data.category",
            "description_en": "The information about the category",
            "description_zh": "媒资分类信息",
            "nullToEmpty": true,
            "properties": {
              "CateId": {
                "backendName": "cateId",
                "description_en": "The category ID",
                "description_zh": "分类ID",
                "example": "46",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "CateName": {
                "backendName": "cateName",
                "description_en": "The category name",
                "description_zh": "分类名称",
                "example": "First-level category",
                "type": "string",
                "visibility": "Public"
              },
              "Level": {
                "backendName": "level",
                "description_en": "The level of the category. A value of 0 indicates a level-1 category, a value of 1 indicates a level-2 category, and a value of 2 indicates a level-3 category",
                "description_zh": "分类层级。一级分类层级为0，二级分类层级为1，三级分类层级为2",
                "example": "0",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "ParentId": {
                "backendName": "parentId",
                "description_en": "The ID of the parent category",
                "description_zh": "父分类ID",
                "example": "-1",
                "format": "int64",
                "type": "integer",
                "visibility": "Public"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type of the category. Valid values:\n\ndefault: audio, video, and image files. This is the default value.\n\nmaterial: short video materials",
                "description_zh": "分类类型。取值：\ndefault（默认值）：音视频/图片分类。\nmaterial：短视频素材分类",
                "example": "default",
                "type": "string",
                "valueMapping": {
                  "cases": [
                    {
                      "targetValue": "default",
                      "value": "ice_default"
                    },
                    {
                      "targetValue": "material",
                      "value": "ice_material"
                    }
                  ]
                },
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "******3B-0E1A-586A-AC29-742247******",
            "type": "string",
            "visibility": "Public"
          },
          "SubCategories": {
            "backendName": "data.subCategories",
            "itemName": "Category",
            "items": {
              "properties": {
                "CateId": {
                  "backendName": "cateId",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "CateName": {
                  "backendName": "cateName",
                  "type": "string",
                  "visibility": "Public"
                },
                "Level": {
                  "backendName": "level",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "ParentId": {
                  "backendName": "parentId",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "SubTotal": {
                  "backendName": "subTotal",
                  "format": "int64",
                  "type": "integer",
                  "visibility": "Public"
                },
                "Type": {
                  "backendName": "type",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "default",
                        "value": "ice_default"
                      },
                      {
                        "targetValue": "material",
                        "value": "ice_material"
                      }
                    ]
                  },
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "SubTotal": {
            "backendName": "data.subTotal",
            "description_en": "The total number of subcategories",
            "description_zh": "子分类总数",
            "example": "100",
            "format": "int64",
            "type": "integer",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
