  "cmd_full_name": "smartag describe-qoses",
  "cmd_name": "describe-qoses",
  "deprecated": false,
  "description_en": "Queries quality of service (QoS) policies in a specified region",
  "description_zh": "调用DescribeQoses接口查询指定地域下QoS策略实例信息",
  "kebab_example": "aliyun smartag describe-qoses --biz-region-id cn-hangzhou --qos-ids qos-oek3r2cmvk7m8q0000 --qos-name zxtest --page-size 10 --page-number 1 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeQoses",
  "operation": {
    "action": "DescribeQoses",
    "api_style": "RPC",
    "api_version": "2018-03-13",
    "method": "POST",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cn-shanghai",
      "help_en": "The ID of the region where the QoS policy is deployed",
      "help_zh": "QoS策略实例所属的地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "qos-oek3r2cmvk7m8q****",
      "help_en": "The ID of the QoS policy.\n\nSeparate multiple QoS polices with commas (,).\nIf you do not specify this parameter, all QoS policies in the region are queried",
      "help_zh": "QoS策略实例ID。\n\n如果要同时查询多个QoS策略实例，多个实例ID之间以半角逗号（,）分隔开。\n如果不填写该项，则默认查询该地域下所有QoS策略实例信息",
      "location": "query",
      "name": "qos_ids",
      "options": [
        "--qos-ids"
      ],
      "raw_name": "QosIds",
      "required": false,
      "type": "string"
    },
    {
      "example": "zxtest",
      "help_en": "The name of the QoS policy.\n\nThe name must be 2 to 100 characters in length and can contain letters, digits, periods (.), underscores (_),and hyphens (-). The name must start with a letter",
      "help_zh": "QoS策略实例名称。\n\n名称长度为2~100个字符，以大小写字母或中文开头，可包含数字、下划线（_）、半角句号（.）和短划线（-）",
