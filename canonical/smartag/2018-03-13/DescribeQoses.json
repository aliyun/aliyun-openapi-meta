      "name": "qos_name",
      "options": [
        "--qos-name"
      ],
      "raw_name": "QosName",
      "required": false,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The number of entries to return on each page. Default value: 10. Maximum value: 50",
      "help_zh": "分页查询时，每页包含的条目数。默认值为10，最大值为50",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The number of the page to return. Default value: 1",
      "help_zh": "查询页码。默认值为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
