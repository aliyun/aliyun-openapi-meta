        "--db-cluster-ids"
      ],
      "raw_name": "DBClusterIds",
      "required": false,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "The number of entries per page. Valid values: 30, 50, and 100.\n                              \nDefault value: 30",
      "help_zh": "每页记录数，取值为30、50或100。\n                              \n默认值为30。 ",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number",
      "help_zh": "页码",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
