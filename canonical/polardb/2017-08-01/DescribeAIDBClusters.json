      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "vnode,container",
      "help_en": "The node type. Multiple types are supported. Separate two values with a comma (,).\n\nvnode: managed by Kubernetes.\ncontainer: logon-enabled container.\nmaas: model service",
      "help_zh": "节点类型。支持多个类型搜索，两个值用逗号隔离：\n\nvnode： K8s纳管\ncontainer：可登录容器\nmaas: 模型服务",
      "location": "query",
      "name": "ai_node_type",
      "options": [
        "--ai-node-type"
      ],
