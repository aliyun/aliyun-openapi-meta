  "responses": {
    "200": {
      "schema": {
        "description_zh": "Schema of Response",
        "properties": {
          "Items": {
            "backendName": "data.Items",
            "description_en": "The details of the cluster endpoints",
            "description_zh": "集群地址详情",
            "itemName": "DBEndpoint",
            "items": {
              "properties": {
                "AddressItems": {
                  "backendName": "AddressItems",
                  "description_en": "The connection string information",
                  "description_zh": "连接串信息",
                  "itemName": "Address",
                  "items": {
                    "properties": {
                      "ConnectionString": {
                        "backendName": "ConnectionString",
                        "description_en": "The connection string",
                        "description_zh": "连接串",
                        "example": "********.rwlb.polardb-pg-public.rds.aliyuncs.com",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "DashboardUsed": {
                        "backendName": "DashboardUsed",
                        "description_en": "Specifies whether the endpoint is the dashboard endpoint of a PolarDB search node. Valid values:\n\nTrue: Yes.\n\nFalse: No",
                        "description_zh": "是否为 PolarDB Search 节点 Dashboard 地址\n\nTure：是。\n\nFalse：否",
                        "example": "True",
                        "type": "boolean"
                      },
                      "IPAddress": {
                        "backendName": "IPAddress",
                        "description_en": "The IP address",
                        "description_zh": "IP 地址",
                        "example": "192.***.***.***",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "NetType": {
                        "backendName": "NetType",
                        "description_en": "The network type. Valid values:\n\nPublic: Internet.\n\nPrivate: internal network",
                        "description_zh": "网络类型，取值范围如下：\n\nPublic：公网。\n\nPrivate：私网",
                        "example": "Private",
                        "nullToEmpty": true,
                        "type": "string",
                        "valueMapping": {
                          "cases": [
                            {
                              "targetValue": "Public",
                              "value": "0"
                            },
                            {
                              "targetValue": "Inner",
                              "value": "1"
                            },
                            {
                              "targetValue": "Private",
                              "value": "2"
                            },
                            {
                              "targetValue": "NlbPublic",
                              "value": "3"
                            },
                            {
                              "targetValue": "NlbVpc",
                              "value": "4"
                            }
                          ]
                        },
                        "visibility": "Public"
                      },
                      "Port": {
                        "backendName": "Port",
                        "description_en": "The port number",
                        "description_zh": "端口",
                        "example": "1521",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "PrivateZoneConnectionString": {
                        "backendName": "PrivateZoneConnectionString",
                        "description_en": "The private domain name that is bound to the endpoint",
                        "description_zh": "绑定的私有域名",
                        "example": "***.***.**.com",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VPCId": {
                        "backendName": "VPCId",
                        "description_en": "The ID of the virtual private cloud (VPC)",
                        "description_zh": "专有网络 ID",
                        "example": "vpc-***************",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VSwitchId": {
                        "backendName": "VSwitchId",
                        "description_en": "The virtual switch ID",
                        "description_zh": "虚拟交换机 ID",
                        "example": "vsw-************",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VpcInstanceId": {
                        "backendName": "VpcInstanceId",
                        "description_en": "The VPC instance ID",
                        "description_zh": "VPC 实例 ID",
                        "example": "pe-*************",
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array",
                  "visibility": "Public"
                },
                "AutoAddNewNodes": {
                  "backendName": "AutoAddNewNodes",
                  "description_en": "Specifies whether new nodes are automatically added to the default cluster endpoint. Valid values:\n\nEnable.\n\nDisable",
                  "description_zh": "新节点是否自动加入默认集群地址：\n\nEnable。\n\nDisable",
                  "example": "Enable",
                  "type": "string",
                  "visibility": "Public"
                },
                "DBClusterId": {
                  "backendName": "DBClusterId",
                  "description_en": "The cluster ID",
                  "description_zh": "集群 ID",
                  "example": "pc-bp1s826a1up******",
                  "type": "string"
                },
                "DBEndpointDescription": {
                  "backendName": "DBEndpointDescription",
                  "description_en": "The name of the endpoint",
                  "description_zh": "地址名称",
                  "example": "test",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DBEndpointId": {
                  "backendName": "DBEndpointId",
                  "description_en": "The endpoint ID",
                  "description_zh": "连接地址 ID",
                  "example": "pe-*************",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "EndpointConfig": {
                  "backendName": "EndpointConfig",
                  "description_en": "The advanced configurations of the cluster endpoint.\n\nDistributedTransaction: The status of transaction splitting. Valid values:\n\non: Transaction splitting is enabled.\n\noff: Transaction splitting is disabled.\n\nConsistLevel: The consistency level. Valid values:\n\n0: Eventual consistency.\n\n1: Session consistency.\n\n2: Global consistency.\n\nLoadBalanceStrategy: The load balancing policy for automatic scheduling based on loads. The value is fixed as load.\n\nMasterAcceptReads: Specifies whether the primary node accepts read requests. Valid values:\n\non: The primary node accepts read requests.\n\noff: The primary node does not accept read requests",
                  "description_zh": "集群地址的高级配置。\n\nDistributedTransaction：事务拆分状态，取值范围如下：\n    * on：事务拆分已开启\n    * off：事务拆分已关闭\n\nConsistLevel：会话一致性级别，取值范围如下：\n    * 0：最终一致性\n    * 1：会话一致性。\n    * 2：全局一致性\n\nLoadBalanceStrategy：负载均衡策略，基于负载的自动调度，取值固定为load。\n\nMasterAcceptReads：主库是否接受读，取值范围如下：\n    * on：主库接受读\n    * off：主库不接受读",
                  "example": "{\\\"DistributedTransaction\\\":\\\"off\\\",\\\"ConsistLevel\\\":\\\"0\\\",\\\"LoadBalanceStrategy\\\":\\\"load\\\",\\\"MasterAcceptReads\\\":\\\"on\\\"}",
                  "type": "string",
                  "visibility": "Public"
                },
                "EndpointType": {
                  "backendName": "EndpointType",
                  "description_en": "The type of the cluster endpoint. Valid values:\n\nCluster: the default cluster endpoint.\n\nPrimary: the primary endpoint.\n\nCustom: a custom cluster endpoint",
                  "description_zh": "集群地址类型：\n\nCluster：默认集群地址。\n\nPrimary：主地址。\n\nCustom：自定义集群地址",
                  "example": "Custom",
                  "nullToEmpty": true,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Cluster",
                        "value": "RWSplit"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "NodeWithRoles": {
                  "backendName": "NodeWithRoles",
                  "description_en": "The role of each node in the endpoint. The primary node has the Writer role. Because multiple read-only nodes can be added to an endpoint, each read-only node is assigned a role name suffixed with a number, such as Reader1 and Reader2",
                  "description_zh": "目标连接地址下各节点的角色名称，其中主节点为 Writer；由于一个连接地址下可加入多个只读节点，因此每个只读节点的角色名称后会加上数字作为区分，如 Reader1、Reader2，以此类推",
                  "example": "Reader1",
                  "type": "string"
                },
                "Nodes": {
                  "backendName": "Nodes",
                  "description_en": "The list of nodes that are configured for the endpoint",
                  "description_zh": "连接地址配置的节点列表",
                  "example": "pi-***************,pi-***************",
                  "type": "string",
                  "visibility": "Public"
                },
                "PolarSccTimeoutAction": {
                  "backendName": "PolarSccTimeoutAction",
                  "description_en": "The policy for global consistency timeout. Valid values:\n\n0: Sends the request to the primary node.\n\n2: Degrades the request. If a global consistency read times out, the query is automatically degraded to a regular request. The client does not receive an error message",
                  "description_zh": "全局一致性超时策略。取值范围如下：\n\n0：发送该请求到主节点。\n\n2：超时降级，当全局一致性读超时后，本次查询操作会自动降级为非一致性读取，且客户端不会收到报错信息",
                  "example": "0",
                  "type": "string"
                },
                "PolarSccWaitTimeout": {
                  "backendName": "PolarSccWaitTimeout",
                  "description_en": "The timeout period for global consistency",
                  "description_zh": "全局一致性超时时间",
                  "example": "100",
                  "type": "string"
                },
                "ReadWriteMode": {
                  "backendName": "ReadWriteMode",
                  "description_en": "The read/write mode. Valid values:\n\nReadWrite: read and write (automatic read/write splitting).\n\nReadOnly: read-only",
                  "description_zh": "读写模式：\n\nReadWrite：可读可写（自动读写分离）。\n\nReadOnly：只读",
                  "example": "ReadOnly",
                  "type": "string",
                  "visibility": "Public"
                },
                "SccMode": {
                  "backendName": "sccMode",
                  "description_en": "Specifies whether global consistency (high-performance mode) is enabled for the node. Valid values:\n\non: enabled.\n\noff: disabled",
                  "description_zh": "节点是否开启全局一致性（高性能模式）功能。取值范围如下：\n\non：开启。\n\noff：关闭",
                  "example": "on",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "2DC120BF-6EBA-4C63-BE99-B09F9E******",
            "type": "string",
            "visibility": "Public"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
