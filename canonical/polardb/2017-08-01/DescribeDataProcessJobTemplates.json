      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Items": {
            "backendName": "data.items",
            "description_en": "The list of data processing task templates",
            "description_zh": "数据处理任务模板列表",
            "itemName": "DataProcessJobTemplate",
            "items": {
              "properties": {
                "Captioning": {
                  "backendName": "captioning",
                  "description_en": "Specifies whether it is required to fetch the summary or video synopsis",
                  "description_zh": "是否提取图片或视频摘要",
                  "example": "true",
                  "type": "boolean"
                },
                "CaptioningPrompt": {
                  "backendName": "captioningPrompt",
                  "description_en": "The prompt used when extracting captions",
