                  "example": "template1",
                  "type": "string"
                },
                "TemplateType": {
                  "backendName": "templateType",
                  "description_en": "The node templatetype. Valid value: image",
                  "description_zh": "任务模板类型，当前支持 image",
                  "example": "image",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "PageNumber": {
            "backendName": "pageNumber",
            "description_en": "The current page number",
            "description_zh": "当前页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageRecordCount": {
            "backendName": "data.pageRecordCount",
            "description_en": "The number of templates returned on the current page",
            "description_zh": "当前页返回的模板数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "2921D843-433A-5FB3-A03B-4EC093B219F8",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "TotalRecordCount": {
            "backendName": "data.totalRecordCount",
            "description_en": "The total number of templates that meet the specified conditions",
            "description_zh": "符合条件的模板总数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
