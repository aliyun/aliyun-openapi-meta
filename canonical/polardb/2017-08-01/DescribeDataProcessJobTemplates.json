                  "example": "{\"ETL_TEMPLATE_STR\":\"config\"}",
                  "type": "string"
                },
                "TemplateId": {
                  "backendName": "templateId",
                  "description_en": "The task template ID",
                  "description_zh": "任务模板 ID",
                  "example": "tpl-123456",
                  "type": "string"
                },
                "TemplateName": {
                  "backendName": "templateName",
                  "description_en": "The task template name",
