  "cmd_name": "describe-data-process-job-templates",
  "deprecated": false,
  "description_en": "Queries data processing task templates by region, template ID, or type, and returns paginated template configurations",
  "description_zh": "按地域、模板 ID 或类型查询数据处理任务模板，并分页返回模板配置",
  "kebab_example": "",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeDataProcessJobTemplates",
  "operation": {
    "action": "DescribeDataProcessJobTemplates",
    "api_style": "RPC",
    "api_version": "2017-08-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The ID of the region where the template resides",
      "help_zh": "模板所在地域的地域 ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "tpl-123456",
      "help_en": "The task template ID used for filtering",
      "help_zh": "用于筛选的任务模板 ID",
      "location": "query",
      "name": "template_id",
      "options": [
        "--template-id"
      ],
      "raw_name": "TemplateId",
      "required": false,
      "type": "string"
    },
    {
      "example": "image",
      "help_en": "The node templatetype used for filtering. Valid value: image",
      "help_zh": "用于筛选的任务模板类型，当前支持 image",
      "location": "query",
      "name": "template_type",
      "options": [
        "--template-type"
      ],
      "raw_name": "TemplateType",
      "required": false,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "The number of entries to return on each page. Default value: 30",
      "help_zh": "每页返回的记录数，默认 30",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. Pages start from 1. Default value: 1",
      "help_zh": "页码，从 1 开始，默认 1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "polardb",
  "protocol": "HTTPS",
  "responses": {
