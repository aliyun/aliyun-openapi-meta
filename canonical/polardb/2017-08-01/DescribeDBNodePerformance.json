{
  "camel_example": "aliyun polardb DescribeDBNodePerformance --region cn-hangzhou --EndTime '2020-09-23T01:01Z' --StartTime '2020-09-23T01:00Z' --DBNodeId 'pi-0000000000000' --Key PolarDBDiskUsage",
