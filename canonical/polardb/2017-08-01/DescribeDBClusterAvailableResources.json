{
  "camel_example": "aliyun polardb DescribeDBClusterAvailableResources --region cn-hangzhou --PayType Postpaid --RegionId 'cn-hangzhou'",
  "cmd_full_name": "polardb describe-db-cluster-available-resources",
  "cmd_name": "describe-db-cluster-available-resources",
  "deprecated": false,
  "description_en": "Queries the available resources of a PolarDB cluster",
  "description_zh": "查询PolarDB集群可售卖资源",
  "kebab_example": "aliyun polardb describe-db-cluster-available-resources --pay-type Postpaid --biz-region-id cn-hangzhou --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeDBClusterAvailableResources",
  "operation": {
    "action": "DescribeDBClusterAvailableResources",
    "api_style": "RPC",
    "api_version": "2017-08-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "Postpaid",
      "help_en": "The billing method. Valid values:\n\nPostpaid: pay-as-you-go (also known as postpaid or hourly billing).\n\nPrepaid: subscription (also known as prepaid)",
      "help_zh": "付费类型，取值范围如下：\n\nPostpaid：按量付费（也称后付费或按小时付费）。\nPrepaid：包年包月（也称预付费）",
      "location": "query",
      "name": "pay_type",
      "options": [
        "--pay-type"
      ],
      "raw_name": "PayType",
      "required": true,
      "type": "string"
    },
    {
      "example": "MySQL",
      "help_en": "The type of the database engine. Valid values:\n\nMySQL\n\nPostgreSQL\n\nOracle",
      "help_zh": "数据库引擎类型，取值范围如下：\n\nMySQL\nPostgreSQL\nOracle",
      "location": "query",
      "name": "db_type",
      "options": [
        "--db-type"
      ],
      "raw_name": "DBType",
      "required": false,
      "type": "string"
    },
    {
      "example": "5.6",
      "help_en": "The version of the database engine.\nValid values for MySQL:\n\n5.6\n\n5.7\n\n8.0\n\nValid values for PostgreSQL:\n\n11\n\n14\n\nValid values for Oracle:\n\n11\n\n14\n\nThis parameter is required when the DBType parameter is specified",
      "help_zh": "数据库引擎版本号。\nMySQL版本号取值范围如下： \n5.6\n5.7\n8.0\n\nPostgreSQL版本号取值范围如下：\n11\n14\n\nOracle版本号取值范围如下：\n11\n14\n\n当传入DBType参数时，该参数必填",
      "location": "query",
      "name": "db_version",
      "options": [
        "--db-version"
      ],
      "raw_name": "DBVersion",
      "required": false,
      "type": "string"
    },
    {
      "example": "polar.mysql.x4.large",
      "help_en": "The specifications of the node. For more information, see https://help.aliyun.com/document_detail/102542.html",
      "help_zh": "节点规格，详情请参见https://help.aliyun.com/document_detail/102542.html。 ",
      "location": "query",
      "name": "db_node_class",
      "options": [
        "--db-node-class"
      ],
      "raw_name": "DBNodeClass",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID. The default value is cn-hangzhou.\n\nYou can call the https://help.aliyun.com/document_detail/98041.html operation to query the available regions",
      "help_zh": "地域ID。默认为cn-hangzhou。\n\n可通过接口https://help.aliyun.com/document_detail/98041.html查看可用的地域",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-hangzhou-i",
