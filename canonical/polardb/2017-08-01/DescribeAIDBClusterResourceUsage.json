                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "VNodeId": {
                  "backendName": "vNodeId",
                  "description_en": "The ID of the virtual node associated with the database node",
                  "description_zh": "节点对应的虚拟节点 ID",
                  "example": "vnode-001",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "2921D843-433A-5FB3-A03B-4EC093B219F8",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
