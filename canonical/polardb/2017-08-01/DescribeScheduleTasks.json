    {
      "example": "2021-01-28T12:00Z",
      "help_en": "The earliest start time of the task. The time is in UTC",
      "help_zh": "为目标任务设定的执行开始时间（UTC时间）",
      "location": "query",
      "name": "planned_start_time",
      "options": [
        "--planned-start-time"
