{
  "camel_example": "aliyun polardb DescribeTasks --region cn-hangzhou --EndTime '2020-12-02T03:00Z' --StartTime '2020-11-30T00:00Z'",
  "cmd_full_name": "polardb describe-tasks",
  "cmd_name": "describe-tasks",
  "deprecated": false,
  "description_en": "Queries the progress details of tasks generated by API calls, such as creating a cluster",
  "description_zh": "查看通过API生成的任务（如创建集群）进度详情",
  "kebab_example": "aliyun polardb describe-tasks --start-time 2020-11-30T00:00Z --end-time 2020-12-02T03:00Z --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeTasks",
  "operation": {
    "action": "DescribeTasks",
    "api_style": "RPC",
    "api_version": "2017-08-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "pc-***************",
      "help_en": "The cluster ID.\n\nSpecify either `DBNodeId` or `DBClusterId`. Call the https://help.aliyun.com/document_detail/98094.html operation to query the details of all clusters in your account, including cluster IDs",
      "help_zh": "集群ID。\n`DBNodeId`和`DBClusterId`必选其一填入。您可以通过https://help.aliyun.com/document_detail/98094.html接口查看账号下所有集群的详细信息，包括集群ID",
      "location": "query",
      "name": "db_cluster_id",
      "options": [
        "--db-cluster-id"
      ],
      "raw_name": "DBClusterId",
      "required": false,
      "type": "string"
    },
    {
      "example": "pi-***************",
      "help_en": "The node ID.\n\nSpecify either `DBNodeId` or `DBClusterId`. Call the https://help.aliyun.com/document_detail/98094.html operation to query the details of all clusters in your account, including node IDs",
      "help_zh": "节点ID。\n`DBNodeId`和`DBClusterId`必选其一填入。您可以通过https://help.aliyun.com/document_detail/98094.html接口查看账号下所有集群的详细信息，包括节点ID",
      "location": "query",
      "name": "db_node_id",
      "options": [
        "--db-node-id"
      ],
      "raw_name": "DBNodeId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2020-11-30T00:00Z",
      "help_en": "The beginning of the time range to query. Specify the time in the `YYYY-MM-DDThh:mmZ` format. The time must be in UTC",
      "help_zh": "查询开始时间，格式为`YYYY-MM-DDThh:mmZ`（UTC时间）",
      "location": "query",
      "name": "start_time",
      "options": [
        "--start-time"
      ],
      "raw_name": "StartTime",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2020-12-02T03:00Z",
      "help_en": "The end of the time range to query. The end time must be later than the start time. Specify the time in the `YYYY-MM-DDThh:mmZ` format. The time must be in UTC",
      "help_zh": "查询结束时间，查询结束时间需晚于开始时间，格式为`YYYY-MM-DDThh:mmZ`（UTC时间）",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": true,
      "type": "string"
    },
    {
      "example": "Running",
      "help_en": "The task status. Valid values:\n\nWaiting: The task is waiting to be executed.\n\nRunning: The task is running.\n\nFinished: The task is complete.\n\nClosed: The task is closed.\n\nPause: The task is paused.\n\nStop: The task is interrupted.\n\nIf you leave this parameter empty, the details of all tasks in the Waiting or Running state for the current cluster or node are returned.\n\nTo query tasks in multiple states, separate the state names with a comma (,)",
      "help_zh": "任务状态，取值范围如下：\nWaiting：任务等待执行中\nRunning：任务正在执行中\nFinished：任务已完成\nClosed：任务已关闭\nPause：任务已暂停\nStop：任务已中断\n\n若该参数留空，仅返回当前集群或节点下所有状态为Waiting或Running的任务详情。\n支持输入多个任务状态，各状态之间用逗号分割查询",
      "location": "query",
      "name": "status",
      "options": [
        "--status"
      ],
      "raw_name": "Status",
      "required": false,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "The number of entries to return on each page. Valid values: 30, 50, and 100.\n\nDefault value: 30",
      "help_zh": "每页记录数，取值为30、50或100。\n\n默认值为30。 ",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number. The value must be an integer that is greater than 0 and does not exceed the maximum value of the Integer data type.\n\nDefault value: 1",
      "help_zh": "页码，取值为大于0且不超过Integer数据类型的最大值。\n\n默认值为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    }
  ],
