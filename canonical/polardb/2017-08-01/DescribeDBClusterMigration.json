            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "SrcDbType": {
            "backendName": "data.srcDbType",
            "description_en": "The type of the source database. Valid values:\n\nPolarDBMySQL: The source database for a major version upgrade of a PolarDB cluster.\n\nRDS: The source database for migrating data from an ApsaraDB RDS instance to a PolarDB for MySQL cluster",
            "description_zh": "源数据库类型。取值如下：\nPolarDBMySQL：PolarDB大版本升级迁移时的源数据库类型。\nRDS：将数据从RDS迁移至PolarDB MySQL时的源数据类型",
            "example": "PolarDBMySQL",
            "nullToEmpty": true,
            "type": "string",
            "valueMapping": {
              "cases": [
                {
                  "targetValue": "PolarDBMySQL",
                  "value": "polardb_mysql"
                },
                {
                  "targetValue": "RDS",
                  "value": "mysql"
                }
              ]
            },
            "visibility": "Public"
          },
          "Topologies": {
            "backendName": "data.syncDirection",
            "description_en": "The data synchronization relationship. Valid values:\n\nRDS2POLARDB: Data is synchronized from the ApsaraDB RDS instance to the PolarDB cluster.\n\nPOLARDB2RDS: Data is synchronized from the PolarDB cluster to the ApsaraDB RDS instance",
            "description_zh": "同步关系，取值范围如下：\nRDS2POLARDB：从RDS到PolarDB同步\nPOLARDB2RDS：从PolarDB到RDS同步",
            "example": "RDS2POLARDB",
            "nullToEmpty": true,
            "type": "string",
            "valueMapping": {
              "cases": [
                {
                  "targetValue": "RDS2POLARDB",
                  "value": "0"
                },
                {
                  "targetValue": "POLARDB2RDS",
                  "value": "1"
                },
                {
                  "targetValue": "Invalid",
                  "value": "-1"
                }
              ]
            },
            "visibility": "Public"
          }
