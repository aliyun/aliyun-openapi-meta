          "RdsReadWriteMode": {
            "backendName": "data.srcReadWriteMode",
            "description_en": "The read/write mode of the source ApsaraDB RDS instance. Valid values:\n\nrw: Read and write.\n\nro: Read-only",
            "description_zh": "源RDS实例读写模式，取值范围如下：\nrw：读写\nro：只读",
            "example": "rw",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "F2A9EFA7-915F-4572-8299-85A307******",
