            "backendName": "data.replicationDelay",
            "description_en": "The replication delay between the ApsaraDB RDS instance and the PolarDB cluster, in seconds",
            "description_zh": "RDS与PolarDB之间的复制延迟时间，单位为秒",
            "example": "0",
            "format": "int32",
            "nullToEmpty": true,
            "type": "integer",
            "visibility": "Public"
          },
