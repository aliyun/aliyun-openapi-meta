                  "backendName": "endpointId",
                  "description_en": "The endpoint ID",
                  "description_zh": "连接地址ID",
                  "example": "pe-***********",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "EndpointType": {
                  "backendName": "endpointType",
                  "description_en": "The type of the endpoint. Valid values:\n\nCluster: The default cluster endpoint.\n\nPrimary: The primary endpoint.\n\nCustom: A custom cluster endpoint",
                  "description_zh": "连接地址类型，取值范围如下：\nCluster：默认集群地址\nPrimary：主地址\nCustom：自定义集群地址",
                  "example": "Cluster",
                  "nullToEmpty": false,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Cluster",
                        "value": "RWSplit"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "ReadWriteMode": {
                  "backendName": "readWriteMode",
                  "description_en": "The read/write mode. Valid values:\n\nReadWrite: Read and write (automatic read/write splitting).\n\nReadOnly (Default): Read-only",
                  "description_zh": "读写模式，取值范围如下：\n\nReadWrite：可读可写（自动读写分离）。\nReadOnly（默认）：只读",
                  "example": "ReadOnly",
                  "type": "string"
                }
              },
              "type": "object"
            },
