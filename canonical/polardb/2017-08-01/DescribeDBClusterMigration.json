                        "description_zh": "是否开启SSL加密。取值如下：\nEnabled：开启SSL加密。\nDisabled：关闭SSL加密",
                        "example": "Enabled",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VPCId": {
                        "backendName": "vpcId",
                        "description_en": "The ID of the virtual private cloud (VPC)",
                        "description_zh": "专有网络ID",
                        "example": "vpc-**********",
                        "nullToEmpty": false,
                        "type": "string",
