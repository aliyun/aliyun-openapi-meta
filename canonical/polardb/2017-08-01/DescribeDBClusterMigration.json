                        "backendName": "vpcId",
                        "description_en": "The ID of the VPC",
                        "description_zh": "专有网络ID",
                        "example": "vpc-************",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VSwitchId": {
                        "backendName": "vswitchId",
                        "description_en": "The ID of the vSwitch",
                        "description_zh": "虚拟交换机ID",
                        "example": "vsw-**************",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": false,
                  "type": "array",
                  "visibility": "Public"
                },
                "CustinsType": {
                  "backendName": "custinsType",
                  "description_en": "The instance type",
                  "description_zh": "实例类型",
                  "example": "ReadOnly\nMaxscale\nPrimary",
                  "type": "string"
                },
                "DBEndpointId": {
                  "backendName": "endpointId",
                  "description_en": "The endpoint ID",
                  "description_zh": "连接地址ID",
                  "example": "rm-************-normal",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "EndpointType": {
                  "backendName": "endpointType",
                  "description_en": "The type of the endpoint. Valid values:\n\nNormal: A regular endpoint.\n\nReadWriteSplitting: A read/write splitting endpoint",
                  "description_zh": "连接地址类型，取值范围如下：\nNormal：普通地址\nReadWriteSplitting：读写分离地址",
                  "example": "Normal",
                  "nullToEmpty": false,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Cluster",
