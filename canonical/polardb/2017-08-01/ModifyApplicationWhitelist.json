      "name": "application_id",
      "options": [
        "--application-id"
      ],
      "raw_name": "ApplicationId",
      "required": true,
      "type": "string"
    },
    {
      "example": "pac-*******************",
      "help_en": "The ID of the application subcomponent. If you specify this parameter, the whitelist modification takes effect only for this subcomponent",
