      "help_zh": "资源组ID",
      "location": "query",
      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "polardb",
  "protocol": "HTTP|HTTPS",
  "responses": {
