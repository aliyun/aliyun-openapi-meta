          "DBVersion": {
            "backendName": "data.serviceVersion",
            "description_en": "The database engine version. Only version 8.0 is supported",
            "description_zh": "数据库引擎版本。当前仅支持8.0版本",
            "example": "8.0",
            "nullToEmpty": true,
            "type": "string",
            "valueMapping": {
              "cases": [
                {
                  "targetValue": "5.6",
                  "value": "1.0"
                },
                {
                  "targetValue": "8.0",
                  "value": "8.0"
                }
              ]
            }
          },
          "GDNDescription": {
            "backendName": "data.description",
            "description_en": "The description of the GDN. It must meet the following requirements:\n\nIt cannot start with `http://` or `https://`.\n\nIt must start with a letter or a Chinese character.\n\nIt can contain only letters, Chinese characters, digits, underscores (_), and hyphens (-).\n\nIt must be 2 to 126 characters in length",
            "description_zh": "GDN备注描述。要求如下：\n\n不能以http://或https://开头。\n\n必须以大小写字母或中文开头。\n\n可以包含大小写字母、中文、数字、下划线（_）或连字符（-）。\n\n长度为2~126个字符",
            "example": "GDN-fortest",
            "nullToEmpty": true,
            "type": "string"
          },
          "GDNId": {
            "backendName": "data.gdnInsName",
            "description_en": "The GDN ID",
            "description_zh": "GDN ID",
            "example": "gdn-bp1fttxsrmv*****",
            "type": "string"
          },
          "GDNStatus": {
            "backendName": "data.status",
            "description_en": "The status of the Global Database Network (GDN). Valid values:\n\ncreating: The GDN is being created.\n\nactive: The GDN is running.\n\ndeleting: The GDN is being deleted.\n\nlocked: The GDN is locked. In this state, you cannot perform any operations on any cluster in the GDN.\n\nremoving_member: A cluster is being removed from the GDN",
            "description_zh": "GDN的状态。取值：\n\ncreating：创建中\n\nactive：运行中\n\ndeleting：删除中\n\nlocked：锁定中（此时无法对GDN下的任一集群执行任何操作）\n\nremoving_member：从集群正在脱离GDN",
            "example": "active",
            "type": "string"
          },
          "GlobalDomainName": {
            "backendName": "data.globalDomainName",
            "description_en": "The global domain name",
            "description_zh": "全局域名",
            "example": "[gdnid].gdn.rds.aliyuncs.com",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "Labels": {
            "backendName": "data.labels",
            "description_en": "The labels of the GDN",
            "description_zh": "属性标签",
            "properties": {
              "GDNVersion": {
                "backendName": "gdn_version",
                "description_en": "The version of the GDN",
                "description_zh": "GDN版本",
