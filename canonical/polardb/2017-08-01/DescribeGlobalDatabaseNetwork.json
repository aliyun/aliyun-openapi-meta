              "properties": {
                "ConnectionString": {
                  "backendName": "address",
                  "description_en": "The connection string",
                  "description_zh": "链接地址",
                  "example": "abc.polardb.rds.aliyuncs.com",
                  "type": "string"
                },
                "NetType": {
                  "backendName": "netType",
                  "description_en": "The network type",
                  "description_zh": "网络类型",
                  "example": "Private",
                  "nullToEmpty": true,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Public",
                        "value": "public"
                      },
                      {
                        "targetValue": "Inner",
                        "value": "classic"
                      },
                      {
                        "targetValue": "Private",
                        "value": "vpc"
                      }
                    ]
                  }
                },
                "Port": {
                  "backendName": "port",
                  "description_en": "The port number of the connection string",
                  "description_zh": "链接地址的端口号",
                  "example": "3306",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "CreateTime": {
            "backendName": "data.gmtCreated",
            "description_en": "The time when the GDN was created",
            "description_zh": "GDN的创建时间",
            "example": "2020-02-24T11:57:54Z",
            "nullToEmpty": true,
            "type": "string"
          },
          "DBClusterId": {
            "backendName": "data.dbClusterId",
            "description_en": "The cluster ID",
            "description_zh": "集群ID",
            "example": "pc-bp1s826a1up******",
            "type": "string"
          },
          "DBClusters": {
            "backendName": "data.memberList",
            "description_en": "The clusters in the GDN",
            "description_zh": "GDN中包含的集群",
            "itemName": "DBCluster",
            "items": {
              "properties": {
                "Category": {
                  "backendName": "category",
                  "description_en": "The edition of the cluster. Valid values:\n\n`Normal`: Cluster Edition `Basic`: Single-node Edition `Archive`: X-Engine Edition `NormalMultimaster`: Multi-master Cluster Edition `SENormal`: Standard Edition\n\nSingle-node Edition is not supported for PolarDB for PostgreSQL clusters that run PostgreSQL 11.\n\nStandard Edition is supported for PolarDB for MySQL clusters that run MySQL 8.0 or 5.7 and for PolarDB for PostgreSQL clusters that run PostgreSQL 14.\n\nX-Engine Edition and Multi-master Cluster Edition are supported only for PolarDB for MySQL clusters that run MySQL 8.0",
                  "description_zh": "产品系列，取值范围如下：\n\nNormal：集群版\nBasic：单节点\nArchive：高压缩引擎（X-Engine）\nNormalMultimaster：多主架构集群版\nSENormal：标准版\n\nPolarDB PostgreSQL 版 PostgreSQL 11 版本不支持单节点。\nPolarDB MySQL 版 8.0 版本、5.7 版本，PolarDB PostgreSQL 版 PostgreSQL 14 版本支持标准版。\nPolarDB MySQL 版 8.0 版本，支持高压缩引擎（X-Engine）和多主架构集群版",
                  "example": "Normal",
                  "type": "string"
                },
                "DBClusterDescription": {
                  "backendName": "dbClusterDescription",
                  "description_en": "The description of the cluster",
                  "description_zh": "集群描述",
                  "example": "test",
                  "type": "string"
                },
                "DBClusterId": {
                  "backendName": "memberName",
                  "description_en": "The cluster ID",
                  "description_zh": "GDN中的集群ID",
                  "example": "pc-wz9fb5nn44u1d****",
                  "type": "string"
                },
                "DBClusterStatus": {
                  "backendName": "dbClusterStatus",
                  "description_en": "The status of the cluster. For more information, see [Cluster statuses]（https://help.aliyun.com/document_detail/99286.html）",
                  "description_zh": "GDN中的集群状态。具体请参见[集群状态表]（https://help.aliyun.com/document_detail/99286.html）",
                  "example": "Running",
