  "kebab_example": "aliyun polardb describe-global-database-network --gdn-id gdn-bp1fttxsrmv00000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeGlobalDatabaseNetwork",
  "operation": {
    "action": "DescribeGlobalDatabaseNetwork",
    "api_style": "RPC",
    "api_version": "2017-08-01",
