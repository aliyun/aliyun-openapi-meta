                      },
                      {
                        "targetValue": "NetAddressDeleting",
                        "value": "NET_DELETING"
                      },
                      {
                        "targetValue": "NetAddressModifying",
                        "value": "NET_MODIFYING"
                      },
                      {
                        "targetValue": "MinorVersionUpgrading",
                        "value": "MINOR_VERSION_UPGRADING"
                      },
                      {
                        "targetValue": "Maintaining",
                        "value": "INS_MAINTAINING"
                      },
                      {
                        "targetValue": "Switching",
                        "value": "HA_SWITCHING"
                      },
                      {
                        "targetValue": "Deleted",
                        "value": "DELETED"
                      },
                      {
                        "targetValue": "InsMaintaining",
                        "value": "INS_MAINTAINING"
                      },
                      {
                        "targetValue": "SSLModifying",
                        "value": "SSL_MODIFYING"
                      },
                      {
                        "targetValue": "RoleSwitching",
                        "value": "ROLE_SWITCHING"
                      },
                      {
                        "targetValue": "UpgradeForbidden",
                        "value": "UPGRADE_FORBIDDEN"
                      },
                      {
                        "targetValue": "StorageExpandin",
                        "value": "STORAGE_EXPANDIN"
                      },
                      {
                        "targetValue": "TDEModifying",
                        "value": "TDE_MODIFYING"
                      }
                    ]
                  }
                },
                "DBNodeClass": {
                  "backendName": "dbInstanceClass",
                  "description_en": "The node type",
                  "description_zh": "数据库节点规格",
                  "example": "polar.mysql.x4.large",
                  "nullToEmpty": true,
                  "type": "string"
                },
                "DBNodes": {
                  "backendName": "dbNodeInfos",
                  "description_en": "The details of the nodes in the cluster",
                  "description_zh": "数据库节点的信息详情",
                  "itemName": "DBNode",
                  "items": {
                    "properties": {
                      "CreationTime": {
                        "backendName": "creationTime",
                        "description_en": "The time when the node was created",
                        "description_zh": "数据库节点的创建时间",
                        "example": "2020-03-23T21:35:43Z",
                        "type": "string"
                      },
                      "DBNodeClass": {
                        "backendName": "dbNodeClass",
                        "description_en": "The node type",
                        "description_zh": "数据库节点规格",
                        "example": "polar.mysql.x4.large",
                        "type": "string"
                      },
                      "DBNodeId": {
                        "backendName": "dbNodeId",
                        "description_en": "The node ID",
                        "description_zh": "数据库节点ID",
                        "example": "pi-****************",
                        "type": "string"
                      },
                      "DBNodeRole": {
                        "backendName": "dbNodeRole",
                        "description_en": "The role of the node. Valid values:\n\nWriter: the primary node\n\nReader: a read-only node",
                        "description_zh": "数据库节点的角色。取值：\n\nWriter：主节点\n\nReader：只读节点",
                        "example": "Reader",
                        "type": "string"
                      },
                      "DBNodeStatus": {
                        "backendName": "dbNodeStatus",
                        "description_en": "The status of the node. Valid values:\n\nCreating: The node is being created.\n\nRunning: The node is running.\n\nDeleting: The node is being deleted.\n\nRebooting: The node is being restarted.\n\nClassChanging: The node type is being changed.\n\nNetAddressCreating: A network connection is being created.\n\nNetAddressDeleting: A network connection is being deleted.\n\nNetAddressModifying: A network connection is being modified.\n\nMinorVersionUpgrading: The minor version is being upgraded.\n\nMaintaining: The cluster is being maintained.\n\nSwitching: A failover is in progress",
                        "description_zh": "节点状态。取值：\n\nCreating：创建中\n\nRunning：运行中\n\nDeleting：删除中\n\nRebooting：重启中\n\nClassChanging：正在变更节点规格\n\nNetAddressCreating：正在创建网络连接\n\nNetAddressDeleting：正在删除网络连接\n\nNetAddressModifying：正在修改网络连接\n\nMinorVersionUpgrading：小版本升级中\n\nMaintaining：集群维护中\n\nSwitching：切换中",
                        "example": "Running",
                        "type": "string"
                      },
                      "FailoverPriority": {
                        "backendName": "failoverPriority",
                        "description_en": "The failover priority. In the event of a failover, the system promotes a read-only node to the primary node. A larger value indicates a higher priority. Each read-only node is assigned a failover priority. Valid values: 1 to 15",
                        "description_zh": "Failover优先级。每个节点都有一个Failover优先级，决定了当故障切换时，该节点被选举为主节点的概率高低。数值越大，优先级越高，取值范围为1~15",
                        "example": "1",
                        "format": "int32",
                        "type": "integer"
                      },
                      "MaxConnections": {
                        "backendName": "maxConnections",
                        "description_en": "The maximum number of concurrent connections",
                        "description_zh": "集群最大的并发连接数",
                        "example": "8000",
                        "format": "int32",
                        "type": "integer"
                      },
                      "MaxIOPS": {
                        "backendName": "maxIOPS",
                        "description_en": "The maximum I/O operations per second (IOPS)",
                        "description_zh": "最大I/O请求次数，即IOPS",
                        "example": "32000",
                        "format": "int32",
                        "type": "integer"
                      },
                      "ZoneId": {
                        "backendName": "zoneId",
                        "description_en": "The zone ID",
                        "description_zh": "可用区ID",
                        "example": "cn-hangzhou-i",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "DBType": {
                  "backendName": "service",
                  "description_en": "The database engine. Only MySQL is supported",
                  "description_zh": "数据库引擎类型。当前仅支持MySQL类型",
                  "example": "MySQL",
                  "nullToEmpty": true,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "MySQL",
                        "value": "polardb_mysql"
                      },
                      {
                        "targetValue": "Oracle",
                        "value": "polardb_ppas"
                      },
                      {
                        "targetValue": "PostgreSQL",
                        "value": "polardb_pg"
                      }
                    ]
                  }
                },
                "DBVersion": {
                  "backendName": "serviceVersion",
                  "description_en": "The database engine version. Only version 8.0 is supported",
                  "description_zh": "数据库引擎版本。当前仅支持8.0版本",
                  "example": "8.0",
                  "nullToEmpty": true,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "5.6",
                        "value": "1.0"
                      },
                      {
                        "targetValue": "8.0",
                        "value": "8.0"
                      }
                    ]
                  }
                },
                "ExpireTime": {
                  "backendName": "expireTime",
                  "description_en": "The expiration time of the cluster.\n\nThis parameter is returned only for subscription clusters. An empty string is returned for pay-as-you-go clusters",
                  "description_zh": "集群到期时间。\n\n仅付费方式为Prepaid（包年包月）的集群会返回具体参数值，Postpaid（按量付费）集群则返回空值",
                  "example": "2020-11-14T16:00:00Z",
                  "type": "string"
                },
                "Expired": {
                  "backendName": "expired",
                  "description_en": "Indicates whether the cluster has expired. Valid values:\n\ntrue: The cluster has expired.\n\nfalse: The cluster has not expired.\n\nThis parameter is returned only for subscription clusters",
                  "description_zh": "集群是否到期。\n\ntrue：是\n\nfalse：否\n\n仅付费方式为Prepaid（包年包月）的集群支持返回该参数",
                  "example": "false",
                  "type": "string"
                },
                "PayType": {
                  "backendName": "payType",
                  "description_en": "The billing method of the cluster. Valid values:\n\nPostpaid: pay-as-you-go.\n\nPrepaid: subscription",
                  "description_zh": "付费类型：\n\nPostpaid：按量付费。\n\nPrepaid：预付费（包年包月）",
                  "example": "Prepaid",
                  "nullToEmpty": true,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Postpaid",
                        "value": "postpay"
                      },
                      {
                        "targetValue": "Postpaid",
                        "value": "postpaid"
                      },
                      {
                        "targetValue": "Prepaid",
                        "value": "prepay"
                      },
                      {
                        "targetValue": "Prepaid",
                        "value": "prepaid"
                      }
                    ]
                  }
                },
                "RegionId": {
                  "backendName": "memberRegion",
                  "description_en": "The region ID of the cluster",
                  "description_zh": "地域ID",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "ReplicaLag": {
                  "backendName": "replicaLag",
                  "description_en": "The replication lag for cross-region replication between the primary and standby clusters. Unit: seconds",
                  "description_zh": "主从集群间跨地域的复制延迟时间。单位为秒",
                  "example": "1",
                  "type": "string"
                },
                "Role": {
                  "backendName": "role",
                  "description_en": "The role of the cluster in the GDN. Valid values:\n\nprimary: the primary cluster\n\nstandby: a standby cluster\n\nA GDN consists of one primary cluster and up to four standby clusters",
                  "description_zh": "集群角色。取值：\n\nprimary：主集群\n\nstandby：从集群\n\n一个GDN中包含一个主集群和最多四个从集群",
                  "example": "primary",
                  "type": "string"
                },
                "ServerlessType": {
                  "backendName": "serverlessType",
                  "description_en": "The type of the Serverless cluster. The value is fixed as `AgileServerless`.\n\nThis parameter is returned only for Serverless clusters",
                  "description_zh": "Serverless类型。当前取值固定为AgileServerless（敏态）。\n仅Serverless集群支持该参数",
                  "example": "AgileServerless",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "AgileServerless",
                        "value": "2"
                      },
                      {
                        "targetValue": "SteadyServerless",
                        "value": "3"
                      }
                    ]
                  }
                },
                "StorageUsed": {
                  "backendName": "storageUsed",
                  "description_en": "The amount of storage space used. Unit: bytes",
                  "description_zh": "存储空间的使用量，单位为Byte",
                  "example": "3012558848",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "DBType": {
            "backendName": "data.service",
            "description_en": "The database engine type. Only MySQL is supported",
            "description_zh": "数据库引擎类型。当前仅支持MySQL类型",
            "example": "MySQL",
            "nullToEmpty": true,
            "type": "string",
            "valueMapping": {
              "cases": [
                {
                  "targetValue": "MySQL",
