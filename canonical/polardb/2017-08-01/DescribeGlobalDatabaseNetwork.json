{
  "camel_example": "aliyun polardb DescribeGlobalDatabaseNetwork --region cn-hangzhou --GDNId 'gdn-bp1fttxsrmv00000'",
  "cmd_full_name": "polardb describe-global-database-network",
  "cmd_name": "describe-global-database-network",
  "deprecated": false,
  "description_en": "Retrieves details for a Global Database Network (GDN)",
