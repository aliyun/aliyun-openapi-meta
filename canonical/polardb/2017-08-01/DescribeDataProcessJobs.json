                  "description_zh": "数据处理任务 ID",
                  "example": "job-123456",
                  "type": "string"
                },
                "ProcessingMode": {
                  "backendName": "dataProcessingMode",
                  "description_en": "The data processing mode. Valid values: Full, Incremental, and Both",
                  "description_zh": "数据处理方式，可选 Full、Incremental 或 Both",
                  "example": "Full",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Full",
                        "value": "0"
                      },
                      {
                        "targetValue": "Incremental",
                        "value": "1"
                      },
                      {
                        "targetValue": "Both",
                        "value": "2"
                      }
                    ]
                  }
                },
                "RegionId": {
                  "backendName": "regionId",
                  "description_en": "The ID of the region where the data processing job resides",
                  "description_zh": "数据处理任务所在地域的地域 ID",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "SourceId": {
                  "backendName": "sourceId",
                  "description_en": "The ID of the source PolarFS instance",
                  "description_zh": "源 PolarFS 实例 ID",
                  "example": "pfs-123456",
                  "type": "string"
                },
                "SourcePath": {
                  "backendName": "sourcePath",
                  "description_en": "The source data path in PolarFS",
                  "description_zh": "PolarFS 中的源数据路径",
                  "example": "/data/input",
                  "type": "string"
                },
                "SourceType": {
                  "backendName": "sourceType",
                  "description_en": "The type of the data source. Currently, only PolarFS is supported",
                  "description_zh": "数据源类型，当前支持 PolarFS",
                  "example": "PolarFS",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the data processing job",
                  "description_zh": "数据处理任务状态",
                  "example": "Running",
                  "type": "string"
                },
                "TemplateId": {
                  "backendName": "templateId",
                  "description_en": "The ID of the template used by the job",
                  "description_zh": "任务使用的模板 ID",
                  "example": "tpl-123456",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "PageNumber": {
            "backendName": "data.pageNumber",
            "description_en": "The current page number",
            "description_zh": "当前页码",
            "example": "1",
            "type": "string"
          },
          "PageRecordCount": {
            "backendName": "data.pageRecordCount",
            "description_en": "The number of jobs returned on the current page",
            "description_zh": "当前页返回的任务数",
            "example": "1",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "2921D843-433A-5FB3-A03B-4EC093B219F8",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "TotalRecordCount": {
            "backendName": "data.totalRecordCount",
            "description_en": "The total number of jobs that match the query conditions",
            "description_zh": "符合条件的任务总数",
            "example": "1",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
