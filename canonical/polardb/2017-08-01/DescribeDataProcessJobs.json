{
  "camel_example": "aliyun polardb DescribeDataProcessJobs --region cn-hangzhou --SourceId 'pfs-123456' --RegionId 'cn-hangzhou'",
  "cmd_full_name": "polardb describe-data-process-jobs",
  "cmd_name": "describe-data-process-jobs",
  "deprecated": false,
  "description_en": "Queries the data processing jobs of a specified PolarFS instance. You can filter the jobs by job ID and paginate the results",
  "description_zh": "查询指定 PolarFS 实例的数据处理任务，并支持按任务 ID 筛选和分页",
  "kebab_example": "aliyun polardb describe-data-process-jobs --biz-region-id cn-hangzhou --source-id pfs-123456 --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "DescribeDataProcessJobs",
  "operation": {
    "action": "DescribeDataProcessJobs",
    "api_style": "RPC",
    "api_version": "2017-08-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The ID of the region where the job resides",
      "help_zh": "任务所在地域的地域 ID",
