      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "pfs-123456",
      "help_en": "The ID of the source PolarFS instance",
      "help_zh": "源 PolarFS 实例 ID",
      "location": "query",
      "name": "source_id",
      "options": [
        "--source-id"
      ],
      "raw_name": "SourceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "job-123456",
      "help_en": "The ID of the data processing job used for filtering",
      "help_zh": "用于筛选的数据处理任务 ID",
      "location": "query",
      "name": "job_id",
      "options": [
        "--job-id"
      ],
      "raw_name": "JobId",
      "required": false,
      "type": "string"
    },
    {
      "example": "30",
      "help_en": "The number of entries to return on each page. Default value: 30",
      "help_zh": "每页返回的记录数，默认 30",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number. Pages start from 1. Default value: 1",
      "help_zh": "页码，从 1 开始，默认 1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "polardb",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "Items": {
            "backendName": "data.items",
            "description_en": "The list of data processing jobs",
            "description_zh": "数据处理任务列表",
            "itemName": "Job",
            "items": {
              "properties": {
                "CreationTime": {
                  "backendName": "creationTime",
                  "description_en": "The time when the job was created, in RFC 3339 format",
                  "description_zh": "任务创建时间，采用 RFC 3339 格式",
                  "example": "2025-01-01T00:00:00Z",
                  "type": "string"
                },
                "Description": {
                  "backendName": "description",
                  "description_en": "The description of the data processing job",
                  "description_zh": "数据处理任务描述",
                  "example": "图片数据处理任务",
                  "type": "string"
                },
                "DestinationId": {
                  "backendName": "destinationId",
                  "description_en": "The ID of the destination PolarDB cluster",
                  "description_zh": "目标 PolarDB 集群 ID",
                  "example": "pc-test123456",
                  "type": "string"
                },
                "DestinationPath": {
                  "backendName": "destinationPath",
                  "description_en": "The name of the destination database",
                  "description_zh": "目标数据库名称",
                  "example": "testdb",
                  "type": "string"
                },
                "DestinationType": {
                  "backendName": "destinationType",
                  "description_en": "The type of the destination. Currently, only PolarDB is supported",
                  "description_zh": "目标类型，当前支持 PolarDB",
                  "example": "PolarDB",
                  "type": "string"
                },
                "JobId": {
                  "backendName": "jobId",
