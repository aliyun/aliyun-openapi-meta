                        "description_zh": "参数值",
                        "example": "utf8",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "type": "array"
