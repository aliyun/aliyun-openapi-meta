                  "description_zh": "账号状态。取值范围：\n\nCreating：创建中。\nAvailable：可用。\nDeleting：删除中",
                  "example": "Available",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Creating",
                        "value": "0"
                      },
                      {
                        "targetValue": "Available",
                        "value": "1"
                      },
                      {
                        "targetValue": "Deleting",
                        "value": "3"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "AccountType": {
                  "backendName": "accountType",
                  "description_en": "The type of the account. Valid values:\n\nNormal: standard account.\n\nSuper: privileged account.\n\nReadOnly: global read-only account",
                  "description_zh": "账户类型。取值范围：\n\nNormal：普通账号。\nSuper：高权限账号。\nReadOnly：全局只读账号",
                  "example": "Normal",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Normal",
                        "value": "0"
                      },
                      {
                        "targetValue": "Super",
                        "value": "1"
                      },
                      {
                        "targetValue": "Orca",
                        "value": "5"
                      },
                      {
                        "targetValue": "ReadOnly",
                        "value": "2"
                      },
                      {
                        "targetValue": "DocumentDB",
                        "value": "6"
                      },
                      {
                        "targetValue": "DocumentDBNormal",
                        "value": "7"
                      },
                      {
                        "targetValue": "DynamoDB",
                        "value": "8"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "DatabasePrivileges": {
                  "backendName": "databasePrivileges",
                  "description_en": "The list of database permissions that are granted to the account",
                  "description_zh": "目标账号拥有的数据库权限详情",
                  "itemName": "DatabasePrivilege",
                  "items": {
                    "properties": {
                      "AccountPrivilege": {
                        "backendName": "accountPrivilege",
                        "description_en": "The permissions of the account",
                        "description_zh": "账号权限",
                        "example": "ReadOnly",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "DBName": {
                        "backendName": "dbName",
                        "description_en": "The database name",
                        "description_zh": "数据库名称",
                        "example": "DBtest",
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "PageNumber": {
            "backendName": "data.pageNumber",
            "description_en": "The page number. Pages start from page 1",
            "description_zh": "页码",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "PageRecordCount": {
            "backendName": "data.pageRecordCount",
            "description_en": "The number of entries returned per page",
            "description_zh": "本页记录数",
            "example": "1",
            "format": "int32",
            "nullToEmpty": false,
            "type": "integer",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "155462B9-205F-4FFC-BB43-4855FE******",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
