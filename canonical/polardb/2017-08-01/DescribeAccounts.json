            "items": {
              "properties": {
                "AccountDescription": {
                  "backendName": "accountDescription",
                  "description_en": "The description of the database account",
                  "description_zh": "账号备注",
                  "example": "test",
                  "type": "string",
                  "visibility": "Public"
                },
                "AccountLockState": {
                  "backendName": "accountLockState",
                  "description_en": "The lock status of the account. Valid values:\n\nUnLock: The account is not locked.\n\nLock: The account is locked",
                  "description_zh": "账号锁定状态。取值范围：\n\nUnLock：未锁定。\nLock：锁定",
                  "example": "UnLock",
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Lock",
                        "value": "NOLOGIN"
                      },
                      {
                        "targetValue": "UnLock",
                        "value": "LOGIN"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "AccountName": {
                  "backendName": "accountName",
                  "description_en": "The name of the database account",
                  "description_zh": "账号名",
                  "example": "test_acc",
                  "type": "string",
                  "visibility": "Public"
                },
                "AccountPasswordValidTime": {
                  "backendName": "accountPwdValidTime",
