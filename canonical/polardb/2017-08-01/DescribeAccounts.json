      "name": "account_name",
      "options": [
        "--account-name"
      ],
      "raw_name": "AccountName",
      "required": false,
      "type": "string"
    },
    {
      "example": "Search",
      "help_en": "The node type. Required when you query the PolarDB search node account\n\nSearch",
      "help_zh": "节点类型，查询 PolarDB Search节点账号时需要传入\n\nSearch",
      "location": "query",
      "name": "node_type",
      "options": [
        "--node-type"
      ],
      "raw_name": "NodeType",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number of the returned page. The value must be an integer that is larger than 0. The default value is 1",
      "help_zh": "页码，取值范围为大于0但不超过Integer最大值的整数。默认值为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "30",
      "help_en": "The number of entries returned per page. Valid values:\n\n30\n\n50\n\n100\n\nThe default value is 30",
      "help_zh": "每页记录数，取值范围：\n30\n50\n100\n\n默认值为30",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "polardb",
  "protocol": "HTTP|HTTPS",
  "responses": {
