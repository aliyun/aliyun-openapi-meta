{
  "camel_example": "aliyun polardb DescribeDBClusterEndpoints --region cn-hangzhou --DBClusterId 'pc-0000000000000'",
  "cmd_full_name": "polardb describe-db-cluster-endpoints",
  "cmd_name": "describe-db-cluster-endpoints",
  "deprecated": false,
  "description_en": "Queries the endpoints of a PolarDB cluster",
  "description_zh": "查询PolarDB集群的地址信息",
  "kebab_example": "aliyun polardb describe-db-cluster-endpoints --db-cluster-id pc-0000000000000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeDBClusterEndpoints",
  "operation": {
    "action": "DescribeDBClusterEndpoints",
    "api_style": "RPC",
    "api_version": "2017-08-01",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "pc-*************",
      "help_en": "The ID of the cluster.\n\nYou can call the https://help.aliyun.com/document_detail/98094.html operation to find the IDs of all clusters in your account",
      "help_zh": "集群ID。\n您可以通过https://help.aliyun.com/document_detail/98094.html接口查看账号下所有集群的详细信息，包括集群ID",
      "location": "query",
      "name": "db_cluster_id",
      "options": [
        "--db-cluster-id"
      ],
      "raw_name": "DBClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "pe-*************",
      "help_en": "The ID of the cluster endpoint",
      "help_zh": "集群地址ID",
      "location": "query",
      "name": "db_endpoint_id",
      "options": [
        "--db-endpoint-id"
      ],
      "raw_name": "DBEndpointId",
      "required": false,
      "type": "string"
    },
    {
      "example": "AI",
      "help_en": "Specifies whether to return information about AI nodes",
      "help_zh": "是否需要返回ai节点信息",
      "location": "query",
      "name": "describe_type",
      "options": [
        "--describe-type"
      ],
      "raw_name": "DescribeType",
      "required": false,
      "type": "string"
    },
    {
      "example": "pfs-test*****",
      "help_en": "The ID of the PolarFS instance",
      "help_zh": "Polarlakebase实例ID",
      "location": "query",
      "name": "polar_fs_instance_id",
      "options": [
        "--polar-fs-instance-id"
      ],
      "raw_name": "PolarFsInstanceId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "polardb",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Items": {
            "backendName": "data.endpointList",
            "description_en": "A list of cluster endpoints",
            "description_zh": "集群地址详情",
            "itemName": "DBEndpoint",
            "items": {
              "properties": {
                "AddressItems": {
                  "backendName": "netInfoItems",
                  "description_en": "The connection addresses for the endpoint",
                  "description_zh": "连接串信息",
                  "itemName": "Address",
                  "items": {
                    "properties": {
                      "ConnectionString": {
                        "backendName": "connectionString",
                        "description_en": "The connection string",
                        "description_zh": "连接串",
                        "example": "********.rwlb.polardb-pg-public.rds.aliyuncs.com",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "DashboardUsed": {
                        "backendName": "dashboardUsed",
                        "description_en": "Indicates whether the endpoint is a dashboard endpoint for a PolarDB Search node.\n\nTrue: Yes\n\nFalse: No",
                        "description_zh": "是否为 PolarDB Search节点 Dashboard 地址\n\nTure：是\nFalse：否",
                        "example": "True",
                        "type": "boolean"
                      },
                      "IPAddress": {
                        "backendName": "ipAddress",
                        "description_en": "The IP address",
                        "description_zh": "IP地址",
                        "example": "192.***.***.***",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "NetType": {
                        "backendName": "netType",
                        "description_en": "The network type. Valid values:\n\nPublic: public network\n\nPrivate: private network\n\n<props=\"china\">\n\nInner: classic network\n\n</props>\n\n<props=\"china\">\n\nOnly PolarDB for MySQL clusters support the classic network type.\n\n</props>",
                        "description_zh": "网络类型，取值范围如下： \n\nPublic：公网\nPrivate：私网\n<props=\"china\">- Inner：经典网络</props>\n\n<props=\"china\">仅PolarDB MySQL版集群支持经典网络类型。</props>",
                        "example": "Private",
                        "nullToEmpty": true,
                        "type": "string",
                        "valueMapping": {
                          "cases": [
                            {
                              "targetValue": "Public",
                              "value": "0"
                            },
                            {
                              "targetValue": "Inner",
                              "value": "1"
                            },
                            {
                              "targetValue": "Private",
                              "value": "2"
                            },
                            {
                              "targetValue": "NlbPublic",
                              "value": "3"
                            },
                            {
                              "targetValue": "NlbVpc",
                              "value": "4"
                            }
                          ]
                        },
                        "visibility": "Public"
                      },
                      "Port": {
                        "backendName": "port",
                        "description_en": "The port",
                        "description_zh": "端口",
                        "example": "1521",
                        "nullToEmpty": true,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "PrivateZoneConnectionString": {
                        "backendName": "pvtzConnectionString",
                        "description_en": "The connection string for the private domain name",
                        "description_zh": "绑定的私有域名，",
                        "example": "***.***.**.com",
                        "nullToEmpty": false,
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VPCId": {
                        "backendName": "vpcId",
                        "description_en": "The VPC ID",
                        "description_zh": "专有网络ID",
                        "example": "vpc-***************",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VSwitchId": {
                        "backendName": "vswitchId",
                        "description_en": "The vSwitch ID",
                        "description_zh": "虚拟交换机ID",
                        "example": "vsw-************",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "VpcInstanceId": {
                        "backendName": "vpcInstanceId",
                        "description_en": "The VPC instance ID.\n\nThis parameter is returned only for PolarDB for MySQL clusters",
                        "description_zh": "VPC实例ID。\n仅PolarDB MySQL版集群会返回该参数",
                        "example": "pe-*************",
                        "type": "string",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array",
                  "visibility": "Public"
                },
                "AutoAddNewNodes": {
                  "backendName": "autoAddNewNodes",
                  "description_en": "Indicates whether new nodes are automatically added to the default cluster endpoint. Valid values:\n\nEnable\n\nDisable",
                  "description_zh": "新节点是否自动加入默认集群地址： \n\nEnable。 \nDisable",
                  "example": "Enable",
                  "type": "string",
                  "visibility": "Public"
                },
                "ConnectionString": {
                  "backendName": "connectionString",
                  "description_en": "The connection string",
                  "description_zh": "连接串",
                  "example": "********.rwlb.polardb-pg-public.rds.aliyuncs.com",
                  "type": "string"
                },
                "DBClusterId": {
                  "backendName": "dbClusterId",
                  "description_en": "The cluster ID",
                  "description_zh": "集群ID",
                  "example": "pc-bp1s826a1up******",
                  "type": "string"
                },
                "DBEndpointDescription": {
                  "backendName": "dbEndpointDescription",
                  "description_en": "The endpoint name",
                  "description_zh": "地址名称",
                  "example": "test",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DBEndpointId": {
                  "backendName": "endpointId",
                  "description_en": "The endpoint ID",
                  "description_zh": "连接地址ID",
                  "example": "pe-*************",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "EndpointConfig": {
                  "backendName": "endpointConfig",
                  "description_en": "The advanced settings for the cluster endpoint.\n\nDistributedTransaction: The transaction splitting status. Valid values:\n\non: enabled\n\noff: disabled\n\nConsistLevel: The consistency level. Valid values:\n\n0: eventual consistency\n\n1: session consistency\n\n2: global consistency\n\nLoadBalanceStrategy: The load balancing policy. The value is fixed to load, which indicates load-based scheduling.\n\nMasterAcceptReads: Indicates whether the primary node accepts read requests. Valid values:\n\non: The primary node accepts read requests.\n\noff: The primary node does not accept read requests",
                  "description_zh": "集群地址的高级配置。\n\nDistributedTransaction：事务拆分状态，取值范围如下：\n    * on：事务拆分已开启\n    * off：事务拆分已关闭\n\nConsistLevel：会话一致性级别，取值范围如下：\n    * 0：最终一致性\n    * 1：会话一致性。\n    * 2：全局一致性\n\nLoadBalanceStrategy：负载均衡策略，基于负载的自动调度，取值固定为load。\n\nMasterAcceptReads：主库是否接受读，取值范围如下：\n    * on：主库接受读\n    * off：主库不接受读",
                  "example": "{\\\"DistributedTransaction\\\":\\\"off\\\",\\\"ConsistLevel\\\":\\\"0\\\",\\\"LoadBalanceStrategy\\\":\\\"load\\\",\\\"MasterAcceptReads\\\":\\\"on\\\"}",
                  "type": "string",
                  "visibility": "Public"
                },
                "EndpointType": {
                  "backendName": "endpointType",
                  "description_en": "The type of the cluster endpoint. Valid values:\n\nCluster: the default cluster endpoint.\n\nPrimary: the primary endpoint.\n\nCustom: a custom cluster endpoint",
                  "description_zh": "集群地址类型： \n\nCluster：默认集群地址。 \nPrimary：主地址。 \nCustom：自定义集群地址",
                  "example": "Custom",
                  "nullToEmpty": true,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Cluster",
                        "value": "RWSplit"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "NetType": {
                  "backendName": "netType",
                  "description_en": "The network type. Valid values:\n\nPublic: public network\n\nPrivate: private network",
                  "description_zh": "网络类型，取值范围如下： \n\nPublic：公网\nPrivate：私网",
                  "example": "Private",
                  "type": "string"
                },
                "NodeWithRoles": {
                  "backendName": "nodeWithRoles",
                  "description_en": "The role of each node in the endpoint. The primary node has the Writer role. Read-only nodes have numbered roles, such as Reader1, Reader2, and so on.\n\nThis parameter is supported only by PolarDB for PostgreSQL clusters and PolarDB for PostgreSQL (compatible with Oracle) clusters",
                  "description_zh": "目标连接地址下各节点的角色名称，其中主节点为Writer；由于一个连接地址下可加入多个只读节点，因此每个只读节点的角色名称后会加上数字作为区分，如Reader1、Reader2，以此类推。\n仅PolarDB PostgreSQL版集群和PolarDB PostgreSQL版（兼容Oracle）集群支持该参数",
                  "example": "Reader1",
                  "type": "string"
                },
                "Nodes": {
                  "backendName": "nodes",
                  "description_en": "The list of nodes configured for the endpoint",
                  "description_zh": "连接地址配置的节点列表",
                  "example": "pi-***************,pi-***************",
                  "type": "string",
                  "visibility": "Public"
                },
                "PolarSccTimeoutAction": {
                  "backendName": "polarSccTimeoutAction",
                  "description_en": "The policy for handling global consistency read timeouts. Valid values:\n\n0: Redirects the request to the primary node.\n\n2: Downgrades the request. If a global consistency read times out, the system automatically downgrades the query to a non-consistent read, and the client does not receive an error",
                  "description_zh": "全局一致性超时策略。取值范围如下：\n\n0：发送该请求到主节点\n\n2：超时降级，当全局一致性读超时后，本次查询操作会自动降级为非一致性读取，且客户端不会收到报错信息",
                  "example": "0",
                  "type": "string"
                },
                "PolarSccWaitTimeout": {
                  "backendName": "polarSccWaitTimeout",
                  "description_en": "The timeout period for global consistency reads",
                  "description_zh": "全局一致性超时时间",
                  "example": "100",
                  "type": "string"
                },
                "Port": {
                  "backendName": "port",
                  "description_en": "The port",
                  "description_zh": "端口",
                  "example": "1521",
                  "type": "string"
                },
                "Protocol": {
                  "backendName": "protocol",
                  "description_en": "The protocol type",
                  "description_zh": "协议类型",
                  "example": "http",
                  "type": "string"
                },
                "ReadWriteMode": {
                  "backendName": "readWriteMode",
                  "description_en": "The read/write mode. Valid values:\n\nReadWrite: read and write (automatic read/write splitting).\n\nReadOnly: read-only",
                  "description_zh": "读写模式： \n\nReadWrite：可读可写（自动读写分离）。 \nReadOnly：只读",
                  "example": "ReadOnly",
                  "type": "string",
                  "visibility": "Public"
                },
                "SccMode": {
                  "backendName": "sccMode",
                  "description_en": "Indicates whether global consistency (high-performance mode) is enabled for the node. Valid values:\n\non: enabled\n\noff: disabled",
                  "description_zh": "节点是否开启全局一致性（高性能模式）功能。取值范围如下：\n\non：开启\n\noff：关闭",
                  "example": "on",
                  "type": "string"
                },
                "ServiceName": {
                  "backendName": "serviceName",
                  "description_en": "The service name",
                  "description_zh": "服务名称",
                  "example": "test-name",
                  "type": "string"
                },
                "VPCId": {
                  "backendName": "vpcId",
                  "description_en": "The VPC ID",
                  "description_zh": "专有网络ID",
                  "example": "vpc-***************",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "2DC120BF-6EBA-4C63-BE99-B09F9E******",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
