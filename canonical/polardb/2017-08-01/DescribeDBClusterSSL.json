                  "type": "string",
                  "visibility": "Public"
                },
                "SSLAutoRotate": {
                  "backendName": "sslAutoRotate",
                  "description_en": "Indicates whether automatic SSL certificate rotation is enabled. Valid values:\n\nEnable: Enabled.\n\nDisable: Disabled.\n\nThis parameter is supported only when the database engine is PostgreSQL-compatible or Oracle syntax-compatible",
                  "description_zh": "是否开启SSL证书自动轮转。取值：\n\nEnable：开启\n\nDisable：关闭\n\n仅当数据库引擎为 PostgreSQL 兼容或 Oracle 语法兼容时，支持该参数",
                  "example": "Enable",
                  "type": "string",
                  "visibility": "Public"
                },
                "SSLConnectionString": {
                  "backendName": "certCommonName",
                  "description_en": "The SSL connection address",
                  "description_zh": "SSL链路地址",
                  "example": "pc-************.mysql.polardb.rds.aliyuncs.com",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "SSLEnabled": {
                  "backendName": "sslEnabled",
                  "description_en": "Indicates whether Secure Sockets Layer (SSL) encryption is enabled. Valid values:\n\nEnabled: Enabled.\nDisabled: Shutdown",
                  "description_zh": "是否开启SSL加密。取值：\n\nEnabled：开启。\nDisabled：关闭",
                  "example": "Enabled",
                  "nullToEmpty": false,
                  "type": "string",
                  "valueMapping": {
                    "cases": [
                      {
                        "targetValue": "Enabled",
                        "value": "true"
                      },
                      {
                        "targetValue": "Disabled",
                        "value": "false"
                      }
                    ]
                  },
                  "visibility": "Public"
                },
                "SSLExpireTime": {
                  "backendName": "sslExpiredTime",
                  "description_en": "The expiration time of the SSL certificate. The time is in the `yyyy-MM-ddTHH:mm:ssZ` format (UTC)",
                  "description_zh": "SSL证书有效期。格式：`yyyy-MM-ddTHH:mm:ssZ`（UTC时间）",
                  "example": "2021-11-13T07:14:22Z",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": false,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "C890995A-CF06-4F4D-8DB8-DD26C2******",
            "type": "string",
            "visibility": "Public"
          },
          "SSLAutoRotate": {
            "backendName": "data.sslAutoRotate",
            "description_en": "Indicates whether automatic SSL certificate rotation is enabled. Valid values:\n\nEnable: Enabled.\n\nDisable: Disabled.\n\nThis parameter is supported only for PolarDB for MySQL",
            "description_zh": "是否开启SSL证书自动轮转。取值：\n\nEnable：开启\n\nDisable：关闭\n\n该参数仅PolarDB MySQL版支持",
            "example": "Enable",
            "type": "string"
          }
        },
        "type": "object"
      }
