                "itemName": "gwlbeVswInfo",
                "items": {
                  "description_zh": "一个可用区的交换机配置",
                  "properties": {
                    "CidrBlock": {
                      "backendName": "cidrBlock",
                      "description_zh": "交换机网段。创建新交换机时必填",
