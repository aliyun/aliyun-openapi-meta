                      "type": "string"
                    },
                    "VswInstanceId": {
                      "backendName": "vswInstanceId",
                      "description_zh": "交换机实例 ID。使用已有交换机时必填",
                      "example": "vsw-bp1example",
                      "type": "string"
                    },
                    "ZoneId": {
                      "backendName": "zoneId",
                      "description_zh": "可用区 ID",
                      "example": "cn-hangzhou-h",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "MaxBandwidth": {
                "backendName": "maxBandwidth",
                "description_zh": "私网引流带宽，单位为 Gbps。创建或修改配置时取值为 10～50，且必须为 10 的整数倍",
                "example": "20",
                "format": "int32",
                "type": "integer"
              },
              "MaxTraffic": {
                "backendName": "maxTraffic",
                "description_zh": "私网引流流量上限，单位为 GB。-1 表示不限制",
                "example": "-1",
                "format": "int64",
                "type": "integer"
              },
              "TimeConfig": {
                "backendName": "timeConfig",
                "description_zh": "引流时间配置。支持固定起止时间，或按开始时间、结束时间、星期和日期设置周期，例如 00:00 23:59 * * 表示每天全天执行。星期与日期不能同时限定",
                "example": "00:00 23:59 * *",
                "type": "string"
              },
              "TractionEndTime": {
                "backendName": "tractionEndTime",
                "description_zh": "最近一次停止引流的时间，Unix 时间戳，单位为秒；仍在引流时可能不返回",
                "example": "1788310800",
                "format": "int64",
                "type": "integer"
              },
              "TractionStartTime": {
                "backendName": "tractionStartTime",
                "description_zh": "最近一次开始引流的时间，Unix 时间戳，单位为秒",
                "example": "1788307200",
                "format": "int64",
                "type": "integer"
              },
              "VpcInstanceId": {
                "backendName": "vpcInstanceId",
                "description_zh": "VPC 实例 ID",
                "example": "vpc-bp1example",
