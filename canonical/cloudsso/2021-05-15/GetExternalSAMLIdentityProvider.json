{
  "camel_example": "aliyun cloudsso GetExternalSAMLIdentityProvider --region cn-hangzhou --DirectoryId 'd-00fc2p610000'",
  "cmd_full_name": "cloudsso get-external-saml-identity-provider",
  "cmd_name": "get-external-saml-identity-provider",
  "deprecated": false,
  "description_en": "Queries the configurations of a Security Assertion Markup Language (SAML) identity provider (IdP)",
  "description_zh": "调用GetExternalSAMLIdentityProvider查询SAML身份提供商（IdP）的配置信息",
  "kebab_example": "aliyun cloudsso get-external-saml-identity-provider --directory-id d-00fc2p610000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetExternalSAMLIdentityProvider",
  "operation": {
    "action": "GetExternalSAMLIdentityProvider",
    "api_style": "RPC",
    "api_version": "2021-05-15",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "d-00fc2p61****",
      "help_en": "The ID of the directory",
      "help_zh": "目录ID",
      "location": "query",
      "name": "directory_id",
      "options": [
        "--directory-id"
      ],
      "raw_name": "DirectoryId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "cloudsso",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回结果",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "96D1E5FF-0301-5636-8D33-071E033CFB82",
            "type": "string"
          },
          "SAMLIdentityProviderConfiguration": {
            "backendName": "data",
            "description_en": "The configurations of the IdP",
            "description_zh": "IdP配置信息",
            "properties": {
              "BindingType": {
                "backendName": "bindingType",
                "description_en": "The binding for sending SAML requests. Valid values:\n\nPost: HTTP Post bindings.\nRedirect: HTTP Redirect bindings",
                "description_zh": "发起SAML请求的Binding方式。取值：\n\nPost: 以Post的方式发起SAML请求。\nRedirect: 以Redirect的方式发起SAML请求",
                "example": "Post",
                "type": "string"
              },
              "CertificateIds": {
                "backendName": "certificateIds",
                "description_en": "The SAML signing certificates",
                "description_zh": "SAML签名证书列表",
                "itemName": "String",
                "items": {
                  "description_en": "The ID of the SAML signing certificate.\n\nMultiple IDs are separated by commas (,)",
                  "description_zh": "SAML签名证书ID。\n\n多个ID之间用半角逗号（,）分隔",
                  "example": "[ \"idp-c-00s6c04my7hvv1uj****\" ]",
                  "type": "string"
                },
                "type": "array"
              },
              "CreateTime": {
                "backendName": "createTime",
                "description_en": "The time when the IdP was configured for the first time",
                "description_zh": "首次配置IdP的时间。格式为 RFC 3339 的 UTC 时间（YYYY-MM-DDTHH:mm:ssZ）",
                "example": "2021-11-09T09:30:13Z",
                "type": "string"
              },
              "DirectoryId": {
                "backendName": "directoryId",
                "description_en": "The ID of the directory",
                "description_zh": "目录ID",
                "example": "d-00fc2p61****",
                "type": "string"
              },
              "EncodedMetadataDocument": {
                "backendName": "encodedMetadataDocument",
                "description_en": "The metadata file of the IdP. The value of this parameter is Base64-encoded",
                "description_zh": "IdP元数据文档（Base64编码）",
                "example": "PD94bWwgdmVyc2lvbj0iMS4****",
                "sensitive": true,
                "type": "string"
              },
              "EntityId": {
                "backendName": "entityId",
                "description_en": "The ID of the IdP",
                "description_zh": "IdP标识",
                "example": "http://www.okta.com/exk3qwgtjhetR2Od****",
                "type": "string"
              },
              "LoginUrl": {
                "backendName": "loginUrl",
                "description_en": "The logon URL of the IdP",
                "description_zh": "IdP的登录地址",
                "example": "https://dev-xxxxxx.okta.com/app/dev-xxxxxx_cloudssodemo_1/exk3qwgtjhetR2Od****/sso/saml",
                "sensitive": true,
                "type": "string"
              },
              "SSOStatus": {
                "backendName": "samlSsoStatus",
                "description_en": "Indicates whether SSO is enabled. Valid values:\n\nEnabled\nDisabled",
                "description_zh": "SSO登录的启用状态。取值：\n\nEnabled：启用。\nDisabled：禁用",
                "example": "Enabled",
                "type": "string"
              },
              "UpdateTime": {
                "backendName": "updateTime",
                "description_en": "The time when the IdP configurations were last modified",
                "description_zh": "最近一次修改IdP配置的时间。格式为 RFC 3339 的 UTC 时间（YYYY-MM-DDTHH:mm:ssZ）",
                "example": "2021-11-09T09:30:22Z",
                "type": "string"
              },
              "WantRequestSigned": {
                "backendName": "wantRequestSigned",
                "description_en": "Indicates whether CloudSSO needs to sign SAML requests. The requests are sent when users log on to the CloudSSO user portal to initiate SAML-based SSO. Valid values:\n\ntrue:\nfalse (default)",
                "description_zh": "在用户访问云SSO登录页面发起SAML SSO时，是否要求云SSO发送签名的SAML请求。取值：\n\ntrue：要求签名。\nfalse（默认值）：不要求签名",
                "example": "false",
                "type": "boolean"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  }
}
