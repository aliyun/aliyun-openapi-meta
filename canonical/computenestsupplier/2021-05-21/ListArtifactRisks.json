{
  "camel_example": "aliyun computenestsupplier ListArtifactRisks --region cn-hangzhou --ArtifactVersion 1 --ArtifactId 'artifact-3fd95cdfdf0d4b1fa00c'",
  "cmd_full_name": "computenestsupplier list-artifact-risks",
  "cmd_name": "list-artifact-risks",
  "deprecated": false,
  "description_en": "Retrieves a list of security risks for an artifact",
  "description_zh": "获取部署物安全风险列表",
  "kebab_example": "aliyun computenestsupplier list-artifact-risks --artifact-id artifact-3fd95cdfdf0d4b1fa00c --artifact-version 1 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "ListArtifactRisks",
  "operation": {
    "action": "ListArtifactRisks",
    "api_style": "RPC",
    "api_version": "2021-05-21",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "artifact-3fd95cdfdf0d4b1fa00c",
      "help_en": "The artifact ID",
      "help_zh": "部署物ID",
      "location": "query",
      "name": "artifact_id",
      "options": [
        "--artifact-id"
      ],
      "raw_name": "ArtifactId",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The artifact version",
      "help_zh": "部署物版本",
      "location": "query",
      "name": "artifact_version",
      "options": [
        "--artifact-version"
      ],
      "raw_name": "ArtifactVersion",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ComputeNestSupplier",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ArtifactRiskList": {
            "backendName": "data.artifactRiskList",
            "description_en": "The list of artifact risks",
            "description_zh": "部署物风险列表",
            "itemName": "ArtifactRisk",
            "items": {
              "properties": {
                "CveNos": {
                  "backendName": "cveNos",
                  "description_en": "The CVE ID",
                  "description_zh": "漏洞编号",
                  "example": "CVE-2023-4911",
                  "type": "string"
                },
                "ExtendInfo": {
                  "backendName": "extendInfo",
                  "description_en": "The extended information in JSON format. Parse this information based on the risk type",
                  "description_zh": "扩展信息，json格式，根据风险类别进行解析",
                  "example": "{\n  \"feature\": \"ntpdate\", \n  \"version\": \"4.2.6\", \n  \"cveLocation\": \"/usr/lib\" \n}",
                  "type": "string"
                },
                "Level": {
                  "backendName": "level",
                  "description_en": "The risk level.\n\nhigh: High",
                  "description_zh": "风险级别：\n\nhigh代表高",
                  "example": "high",
                  "type": "string"
                },
                "RiskName": {
                  "backendName": "riskName",
                  "description_en": "The name of the risk",
                  "description_zh": "风险名称",
                  "example": "USN-3686-1: file vulnerabilities",
                  "type": "string"
                },
                "RiskType": {
                  "backendName": "riskType",
                  "description_en": "The risk type. Valid values:\n\nAcrCve: system vulnerabilities in a container image\n\nAcrSca: application vulnerabilities in a container image\n\nEcsVulnerability: ECS image vulnerabilities\n\nEcsAlarm: ECS image security alerts\n\nEcsBaseline: ECS image baseline checks",
                  "description_zh": "风险类型。取值：\nAcrCve  容器镜像系统漏洞\nAcrSca  容器镜像应用漏洞\nEcsVulnerability  ECS镜像漏洞信息\nEcsAlarm           ECS镜像安全告警\nEcsBaseline      ECS镜像基线检查",
                  "example": "AcrCve",
                  "type": "string"
                },
                "RiskTypeName": {
                  "backendName": "riskTypeName",
                  "description_en": "The name of the risk type",
                  "description_zh": "风险类别名称",
                  "example": "Container image system vulnerability",
                  "type": "string"
                },
                "Solution": {
                  "backendName": "solution",
                  "description_en": "The solution to the risk",
                  "description_zh": "检查项风险的解决方案",
                  "example": "apt-get update && apt-get install ntpdate --only-upgrade",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "52919DB1-03A0-55F5-BDD4-DB6DEBB8267A",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
