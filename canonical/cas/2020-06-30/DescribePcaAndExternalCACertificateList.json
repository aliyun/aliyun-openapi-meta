  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "CertificateList": {
            "backendName": "data.objectList",
            "description_en": "The list of certificates",
            "description_zh": "证书显示列表",
            "itemName": "Certificate",
            "items": {
              "description_en": "The list of certificates",
              "description_zh": "证书显示列表",
              "properties": {
                "AfterDate": {
                  "backendName": "afterDate",
                  "description_en": "The certificate expiration time. The value is a timestamp in milliseconds",
                  "description_zh": "证书到期时间。时间戳，单位毫秒",
                  "example": "1787539908871",
                  "format": "int64",
                  "type": "integer"
                },
                "Algorithm": {
                  "backendName": "algorithm",
                  "description_en": "The certificate ID",
                  "description_zh": "证书id",
                  "example": "RSA",
                  "type": "string"
                },
                "BeforeDate": {
                  "backendName": "beforeDate",
                  "description_en": "The certificate issuance time. The value is a timestamp in milliseconds",
                  "description_zh": "证书签发时间。时间戳，单位毫秒",
                  "example": "1787539908871",
                  "format": "int64",
                  "type": "integer"
                },
                "CertificateType": {
                  "backendName": "certType",
                  "description_en": "The certificate type",
                  "description_zh": "证书类型",
                  "example": "SUB_ROOT",
                  "type": "string"
                },
                "CommonName": {
                  "backendName": "commonName",
                  "description_en": "The primary domain name bound to the certificate",
                  "description_zh": "证书绑定的主域名",
                  "example": "aliyun.com",
                  "type": "string"
                },
                "CountryCode": {
                  "backendName": "country",
                  "description_en": "The country code of the certificate",
                  "description_zh": "证书国家标准编码",
                  "example": "CN",
                  "type": "string"
                },
                "Identifier": {
                  "backendName": "identifier",
                  "description_en": "The certificate ID",
                  "description_zh": "证书id",
                  "example": "05e148d8d3ecc9976d9ecd2b2f25****",
                  "type": "string"
                },
                "KeySize": {
                  "backendName": "keySize",
                  "description_en": "The size of the certificate key. Unit: GB",
                  "description_zh": "证书key的大小，单位gb",
                  "example": "2048",
                  "format": "int32",
                  "type": "integer"
                },
                "Locality": {
                  "backendName": "locality",
                  "description_en": "The primary domain name bound to the certificate",
                  "description_zh": "证书绑定的主域名",
                  "example": "Hangzhou",
                  "type": "string"
                },
                "Md5": {
                  "backendName": "md5",
                  "description_en": "The MD5 value bound to the certificate",
                  "description_zh": "证书绑定的md5值",
                  "example": "05e148d8d3ecc9976d9ecd2b2f25****",
                  "type": "string"
                },
                "Organization": {
                  "backendName": "organization",
                  "description_en": "The certificate organization",
                  "description_zh": "证书组织",
                  "example": "阿里云计算有限公司",
                  "type": "string"
                },
                "OrganizationUnit": {
                  "backendName": "organizationUnit",
                  "description_en": "The certification authority that issued the certificate",
                  "description_zh": "证书颁发机构",
                  "example": "Security",
                  "type": "string"
                },
                "ParentIdentifier": {
                  "backendName": "parentIdentifier",
                  "description_en": "The parent certificate ID",
                  "description_zh": "父证书id",
                  "example": "1a83bcbb89e562885e40aa0108f5****",
                  "type": "string"
                },
                "Sans": {
                  "backendName": "sans",
                  "description_en": "All domain names bound to the certificate",
                  "description_zh": "证书绑定的所有域名",
                  "example": "[ {\"Type\": 7, \"Value\": \"192.0.XX.XX\"}, {\"Type\": 2, \"Value\": \"www.aliyundoc.com\"}, ]",
                  "type": "string"
                },
                "SerialNumber": {
                  "backendName": "serialNumber",
                  "description_en": "The certificate serial number",
                  "description_zh": "证书序列号",
                  "example": "62b2b943a32d96883a6650e672ea0276****",
                  "type": "string"
                },
                "Sha2": {
                  "backendName": "sha2",
                  "description_en": "The primary domain name bound to the certificate",
                  "description_zh": "证书绑定的主域名",
                  "example": "14dcc8afc7578e1fcec36d658f7e20de18f6957bbac42b373a66bc9de4e9****",
                  "type": "string"
                },
                "SignAlgorithm": {
                  "backendName": "signAlgorithm",
                  "description_en": "The certificate signature algorithm. Valid values:\nprefix: Prefix match.\nmatch: Exact match.\nany: Match all",
                  "description_zh": "证书签名算法，取值：-prefix：前缀验证。-match：完全匹配。-any：全部匹配",
                  "example": "SHA256WITHRSA",
                  "type": "string"
                },
                "State": {
                  "backendName": "state",
                  "description_en": "The certificate state. Valid values:\nsuccess: Effective.\nchecking: Checking whether the domain name is on Alibaba Cloud Dynamic Route for CDN.\ncname_error: The domain name is not pointed to an Alibaba Cloud Global Accelerator (GA) instance.\ndomain_invalid: The domain name contains invalid characters.\nunsupport_wildcard: Wildcard domain names are not supported",
                  "description_zh": "证书状态。-success：已生效-checking：检测域名是否在阿里云全站加速-cname_error：域名没有切到阿里云全球加速实例-domain_invalid：域名包含非法字符-unsupport_wildcard：不支持泛域名",
                  "example": "Zhejiang",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The certificate status. Valid values:\npayed: Paid.\nchecking: Being reviewed.\nissued: Issued.\nrevoked: Revoked.\nchecked_fail: Review failed",
                  "description_zh": "证书状态。取值：-payed：已付款-checking：审核中-issued：已签发-revoked：已吊销-checked_fail：审核失败",
                  "example": "ISSUE",
                  "type": "string"
                },
                "SubjectDN": {
                  "backendName": "subjectDN",
                  "description_en": "The certificate subject (owner), represented in DN format",
                  "description_zh": "证书主体（拥有者），采用dn标识",
                  "example": "C=CN,O=阿里云计算有限公司,OU=Security,L=Hangzhou,ST=Zhejiang,CN=Aliyun",
                  "type": "string"
                },
                "X509Certificate": {
                  "backendName": "content",
                  "description_en": "The x.509 certificate",
                  "description_zh": "x09证书",
                  "example": "-----BEGIN CERTIFICATE----- …… -----END CERTIFICATE-----",
                  "type": "string"
                },
                "Years": {
                  "backendName": "years",
                  "description_en": "The number of years for which the certificate was purchased",
                  "description_zh": "证书购买年限",
                  "example": "3",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "CurrentPage": {
            "backendName": "data.currentPage",
            "description_en": "The current page number",
            "description_zh": "当前页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageCount": {
            "backendName": "data.pageCount",
            "description_en": "The number of entries in the list",
            "description_zh": "列表条目数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "结果的请求id",
            "example": "CBF1E9B7-D6A0-4E9E-AD3E-2B47E6C2837D",
            "type": "string"
          },
          "ShowSize": {
            "backendName": "data.showSize",
            "description_en": "The number of records to display per page. Default value: 50",
            "description_zh": "指定每页显示多少条记录。默认值为50",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "TotalCount": {
            "backendName": "data.totalCount",
            "description_en": "The total number of records",
            "description_zh": "总记录数",
            "example": "10",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
