  "kebab_example": "aliyun cas describe-pca-and-external-ca-certificate-list --current-page 1 --show-size 50 --identifiers aaa,bbb --key-word test_name --api-version 2020-06-30 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribePcaAndExternalCACertificateList",
  "operation": {
    "action": "DescribePcaAndExternalCACertificateList",
    "api_style": "RPC",
    "api_version": "2020-06-30",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "example": "1",
      "help_en": "The current page number",
      "help_zh": "当前页码",
      "location": "query",
      "name": "current_page",
      "options": [
        "--current-page"
      ],
      "raw_name": "CurrentPage",
      "required": false,
      "type": "int"
    },
    {
      "example": "50",
      "help_en": "The number of records to display per page. Default value: 50",
      "help_zh": "指定每页显示多少条记录。默认值为50",
      "location": "query",
      "name": "show_size",
      "options": [
        "--show-size"
      ],
      "raw_name": "ShowSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "aaa,bbb",
      "help_en": "The certificate identifiers. Separate multiple identifiers with commas (,)",
      "help_zh": "证书标识。多个标识间英文逗号间隔",
      "location": "query",
      "name": "identifiers",
      "options": [
        "--identifiers"
      ],
      "raw_name": "Identifiers",
      "required": false,
      "type": "string"
    },
    {
      "example": "test_name",
      "help_en": "The search keyword. Fuzzy search by name, domain name, or SANs is supported",
      "help_zh": "查询关键字。支持通过名称、域名、SANS模糊查询",
      "location": "query",
      "name": "key_word",
      "options": [
        "--key-word"
      ],
      "raw_name": "KeyWord",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
