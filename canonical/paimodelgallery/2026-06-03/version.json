    },
    "GetModelDeploymentSpec": {
      "cmd_name": "get-model-deployment-spec",
      "deprecated": false,
      "description_en": "Retrieves the configuration file (EAS InferenceSpec) for model deployment",
      "description_zh": "获取模型部署的配置文件（ EAS InferenceSpec）"
    },
    "ListModelDeploymentProfiles": {
      "cmd_name": "list-model-deployment-profiles",
      "deprecated": false,
      "description_en": "Queries the current deployable profiles for a specified model, including the inference framework, scenarios, optimization combinations, supported device types, and member summaries",
      "description_zh": "查询指定模型当前的可部署方案，包含推理框架、场景、优化组合、支持卡型和成员摘要"
    },
    "ListModelGalleryModels": {
      "cmd_name": "list-model-gallery-models",
      "deprecated": false,
      "description_en": "Retrieves a list of models in Model Gallery",
      "description_zh": "获取ModelGallery模型列表"
    }
  },
