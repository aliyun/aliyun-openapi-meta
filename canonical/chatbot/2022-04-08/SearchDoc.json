                        "title_zh": "标签组ID",
                        "type": "integer"
                      },
                      "GroupName": {
                        "backendName": "GroupName",
                        "description_en": "The tag group name",
                        "description_zh": "标签组名称",
                        "example": "文章",
                        "title_en": "Tag Group Name  ",
                        "title_zh": "标签组名称",
                        "type": "string"
                      },
                      "TagId": {
                        "backendName": "TagId",
                        "description_en": "The tag ID",
                        "description_zh": "标签ID",
                        "example": "1201",
                        "format": "int64",
