                  "example": "https://doc2bot-bucket-cloud.oss-cn-shanghai.aliyuncs.com/doc2bot/input/文档问答说明书_V1.pdf",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "PageNumber": {
            "backendName": "Data.PageNumber",
            "description_en": "The page number",
            "description_zh": "当前⻚码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageSize": {
