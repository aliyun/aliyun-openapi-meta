                  "example": "2023-02-28T11:40:18Z",
                  "type": "string"
                },
                "Status": {
                  "backendName": "Status",
                  "description_en": "The editing status of the document. Valid values:<br>• 1: Unpublished<br>• 2: Published<br>• 3: Updated but not published<br><br><br>",
                  "description_zh": "编辑状态： 1 未发布 2 已发布 3 已更新未发布",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "Url": {
