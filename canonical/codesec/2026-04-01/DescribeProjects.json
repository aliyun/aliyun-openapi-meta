{
  "camel_example": "",
  "cmd_full_name": "codesec describe-projects",
  "cmd_name": "describe-projects",
  "deprecated": false,
  "description_en": "Lists projects under the current tenant with pagination. Supports fuzzy match by name or prompt",
  "description_zh": "分页列出租户下的项目（Project），支持按名称/提示词模糊搜索",
  "kebab_example": "",
  "method": "GET",
  "multi_version": false,
  "name": "DescribeProjects",
  "operation": {
    "action": "DescribeProjects",
    "api_style": "ROA",
    "api_version": "2026-04-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/v1/projects"
  },
  "parameters": [
    {
      "example": "20",
      "help_en": "The number of entries per page. Default value: 10. Maximum value: 20",
      "help_zh": "每页数量。默认10，最大支持20",
      "location": "query",
      "maximum": "20",
      "minimum": "1",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "maxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "eyJ0IjoiMjAyNi0wNy0xNlQwNzo1MzozOC4wMjFaIiwiaSI6MTAwMDQ0OH0",
      "help_en": "The pagination token. Do not specify this parameter or set it to an empty string for the first page. To retrieve subsequent pages, pass the nextToken value from the previous response without any modification. If the nextToken value in the response is empty, the last page has been reached",
      "help_zh": "分页Token，首页不传nextToken省略或为空字符串，翻页原样回传把上一次响应的nextToken值不做任何修改地传入下一次请求，响应中nextToken 为空，已到最后一页",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "nextToken",
      "required": false,
      "type": "string"
    },
    {
      "example": "project",
      "help_en": "The keyword used for fuzzy match by project name or prompt",
      "help_zh": "可按项目名称、提示词模糊查询",
      "location": "query",
      "name": "query",
      "options": [
        "--query"
      ],
      "raw_name": "query",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "updatedAt",
        "createdAt",
        "lastScanTime"
      ],
      "example": "last_scan_time",
      "help_en": "The field by which to sort the results. Default value: last_scan_time.\n\nValid values:\nlast_scan_time: the time when a task was last created.\ncreated_at: the time when the project was created.\nupdated_at: the time when the project was last modified",
      "help_zh": "排序的字段，默认值 last_scan_time\n取值如下：\nlast_scan_time 最近一次创建任务时间\ncreated_at 创建项目的时间\nupdated_at 修改项目的时间",
      "location": "query",
      "name": "sort_by",
      "options": [
        "--sort-by"
      ],
      "raw_name": "sortBy",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "asc",
        "desc"
      ],
      "example": "desc",
      "help_en": "The sort order. Default value: desc.\n\nValid values:\ndesc: descending order.\nasc: ascending order",
      "help_zh": "指定排序顺序，默认值desc。\n取值如下：\ndesc 倒序\nasc 正序",
      "location": "query",
      "name": "sort_order",
      "options": [
        "--sort-order"
      ],
      "raw_name": "sortOrder",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/v1/projects",
  "product_code": "CodeSec",
