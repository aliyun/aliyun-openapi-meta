                  "description_zh": "任务进度",
                  "example": "100",
                  "format": "int64",
                  "type": "integer"
                },
                "startedAt": {
                  "backendName": "started_at",
                  "description_en": "The time when the task started",
                  "description_zh": "开始时间",
                  "example": "2026-07-28T03:36:31.573Z",
                  "type": "string"
                },
                "status": {
                  "backendName": "status",
                  "description_en": "The task status. Valid values:\nrunning: Running.\ncompleted: Completed.\nfailed: Failed.\ncanceling: Being canceled. \ncanceled: Canceled",
                  "description_zh": "状态取值：\nrunning：运行中\ncompleted：已完成\nfailed：失败\ncanceling：取消中 \ncanceled：取消完成",
                  "example": "completed",
                  "type": "string"
                },
                "taskName": {
                  "backendName": "task_name",
                  "description_en": "The task name",
                  "description_zh": "任务名称",
                  "example": "1648622222394847-ha-cn-lm64p7tby01_dsl_kb_video_1773817008236_full",
                  "type": "string"
                },
                "updatedAt": {
                  "backendName": "updated_at",
                  "description_en": "The time when the task was last updated",
                  "description_zh": "更新时间",
                  "example": "2026-07-28T03:36:31.573Z",
                  "type": "string"
                },
                "workerId": {
                  "backendName": "worker_id",
                  "description_en": "Deprecated",
                  "description_zh": "弃用",
                  "example": "1",
                  "type": "string"
