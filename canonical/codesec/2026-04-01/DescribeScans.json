      "help_zh": "分页 Token，首页不传 nextToken 省略或为空字符串，翻页原样回传把上一次响应的 nextToken 值不做任何修改地传入下一次请求，响应中 nextToken 为空，已到最后一页",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "nextToken",
      "required": false,
      "type": "string"
    },
    {
      "example": "completed",
      "help_en": "The task status. Valid values:\nrunning: Running.\ncompleted: Completed.\nfailed: Failed",
      "help_zh": "状态取值：\nrunning：运行中\ncompleted：已完成\nfailed：失败",
      "location": "query",
      "name": "status",
      "options": [
        "--status"
      ],
      "raw_name": "status",
      "required": false,
      "type": "string"
    },
    {
      "example": "name",
      "help_en": "The task name",
      "help_zh": "任务名称",
      "location": "query",
      "name": "task_name",
      "options": [
        "--task-name"
      ],
      "raw_name": "taskName",
      "required": false,
      "type": "string"
    }
  ],
