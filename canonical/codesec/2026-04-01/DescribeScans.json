                      "example": "459",
                      "format": "int64",
                      "type": "integer"
                    },
                    "linesOfCode": {
                      "backendName": "lines_of_code",
                      "description_en": "The number of lines of code",
                      "description_zh": "代码行数",
                      "example": "11",
                      "format": "int64",
                      "type": "integer"
                    },
                    "tokenTotal": {
                      "backendName": "token_total",
                      "description_en": "Deprecated",
                      "description_zh": "弃用",
                      "example": "1",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "scanProgress": {
                  "backendName": "scan_progress",
