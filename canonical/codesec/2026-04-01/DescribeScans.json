  "kebab_example": "",
  "method": "GET",
  "multi_version": false,
  "name": "DescribeScans",
  "operation": {
    "action": "DescribeScans",
    "api_style": "ROA",
    "api_version": "2026-04-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/v1/projects/{projectId}/scans"
  },
  "parameters": [
    {
      "example": "p-pe0l23v622d55em",
      "help_en": "The project ID",
      "help_zh": "项目ID",
      "location": "path",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "projectId",
      "required": true,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of entries per page. Default value: 20. Maximum value: 100",
      "help_zh": "每页数量。默认 20，最大支持 100",
      "location": "query",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "maxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "eyJ0IjoiMjAyNi0wNy0xNlQwNzo1MzozOC4wMjFaIiwiaSI6MTAwMDQ0OH0",
