                  "type": "string"
                },
                "startLine": {
                  "backendName": "start_line",
                  "description_en": "The start line number",
                  "description_zh": "起始行号",
                  "example": "1",
                  "format": "int64",
                  "type": "integer"
                },
                "status": {
                  "backendName": "status",
                  "description_en": "The status. Valid values:\nrunning: Running.\ncompleted: Completed.\nfailed: Failed",
                  "description_zh": "状态取值：\nrunning：运行中\ncompleted：已完成\nfailed：失败",
                  "example": "completed",
                  "type": "string"
                },
                "taintFlow": {
                  "backendName": "taint_flow",
                  "description_en": "The SAST taint analysis call chain that describes the complete propagation path of sensitive data from the taint source to the dangerous sink. This field is returned only when engine is set to sast",
                  "description_zh": "SAST 污点分析调用链，描述敏感数据从污染源（source）到危险汇聚点（sink）的完整传播路径。（仅engine=sast ）",
