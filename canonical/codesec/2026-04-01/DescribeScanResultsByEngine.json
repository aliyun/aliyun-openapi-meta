                        "properties": {
                          "cveId": {
                            "backendName": "cve_id",
                            "description_en": "The associated CWE ID",
                            "description_zh": "关联 CWE 编号",
                            "example": "CVE-2021-44228",
                            "type": "string"
                          },
                          "cvss": {
                            "backendName": "cvss",
                            "description_en": "The CVSS score",
                            "description_zh": "CVSS分值",
                            "example": "1",
                            "format": "double",
                            "type": "number"
                          },
                          "cvssVersion": {
                            "backendName": "cvss_version",
                            "description_en": "The CVSS version",
                            "description_zh": "CVSS版本",
                            "example": "v2.0",
                            "type": "string"
                          },
                          "description": {
                            "backendName": "description",
                            "description_en": "The description",
                            "description_zh": "描述",
                            "example": "Apache Log4j2 JNDI features do not protect against attacker-controlled LDAP and other JNDI-related endpoints.",
                            "type": "string"
                          },
                          "references": {
                            "backendName": "references",
                            "description_en": "The reference information",
                            "description_zh": "引用信息",
                            "itemName": "data",
                            "items": {
                              "description_en": "The reference list",
                              "description_zh": "引用列表",
                              "example": "https://nvd.nist.gov/vuln/detail/CVE-2021-44228",
                              "type": "string"
                            },
                            "type": "array"
                          },
                          "severity": {
                            "backendName": "severity",
                            "description_en": "The severity level. Valid values:\ncritical\nhigh\nmedium\nlow",
                            "description_zh": "严重等级取值：\ncritical\nhigh\nmedium\nlow",
                            "example": "critical",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "introPaths": {
                      "backendName": "intro_paths",
                      "description_en": "The list of dependency introduction paths in the SCA component information. This field is returned only when engine is set to sca",
                      "description_zh": "SCA 组件信息中的依赖引入路径列表。（仅engine=sca 响应中出现）",
