                      },
                      "file": {
                        "backendName": "file",
                        "description_en": "The file path",
                        "description_zh": "文件路径",
                        "example": "src/main/java/com/example/UserService.java",
                        "type": "string"
                      },
                      "kind": {
                        "backendName": "kind",
                        "description_en": "The role type in the taint propagation chain. Valid values:\nsource: taint source.\npropagator: propagation node.\nvalidation: validation or scrubbing center.\nsink: dangerous sink",
                        "description_zh": "污点传播链中的角色类型：\nsource：污染源\npropagator：传播节点\nvalidation：校验/清洗节点\nsink：危险汇聚点",
                        "example": "source",
                        "type": "string"
                      },
                      "line": {
                        "backendName": "line",
                        "description_en": "The line number",
                        "description_zh": "行号",
                        "example": "111",
                        "format": "int32",
                        "type": "integer"
                      },
                      "note": {
                        "backendName": "note",
                        "description_en": "The remarks",
                        "description_zh": "备注信息",
                        "example": "Sink: SQL query executed",
                        "type": "string"
                      },
                      "step": {
                        "backendName": "step",
                        "description_en": "The step number, starting from 0 and incrementing",
                        "description_zh": "步骤序号，从 0 开始递增",
                        "example": "1",
                        "format": "int32",
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "taintFlowSummary": {
                  "backendName": "taint_flow_summary",
                  "description_en": "The text summary of the taint call chain. This field is returned only when engine is set to sast",
