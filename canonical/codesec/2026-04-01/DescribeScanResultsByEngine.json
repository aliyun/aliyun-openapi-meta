        "--scan-id"
      ],
      "raw_name": "scanId",
      "required": true,
      "type": "int"
    },
    {
      "enum": [
        "sast",
        "sca"
      ],
      "example": "sca",
      "help_en": "The engine type. Valid values:\nsast\nsca",
      "help_zh": "类型取值：\nsast\nsca",
      "location": "path",
      "name": "engine",
      "options": [
        "--engine"
      ],
      "raw_name": "engine",
      "required": true,
      "type": "string"
    },
    {
      "example": "eyJ0IjoiMjAyNi0wNy0xNlQwNzo1MzozOC4wMjFaIiwiaSI6MTAwMDQ0OH0",
      "help_en": "The pagination token. Do not pass nextToken or pass an empty string for the first page. To retrieve the next page, pass the nextToken value from the previous response without any modification. When the nextToken in the response is empty, you have reached the last page",
      "help_zh": "分页 Token，首页不传 nextToken 省略或为空字符串，翻页原样回传把上一次响应的 nextToken 值不做任何修改地传入下一次请求，响应中 nextToken 为空，已到最后一页",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "nextToken",
      "required": false,
      "type": "string"
    },
    {
      "example": "50",
      "help_en": "The number of entries per page. Default value: 10. Maximum value: 50",
      "help_zh": "每页数量。默认 10，最大支持 50",
      "location": "query",
      "maximum": "50",
      "minimum": "1",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "maxResults",
      "required": false,
      "type": "int"
    },
    {
      "enum": [
        "new",
        "unchanged",
        "absent",
        "updated"
      ],
      "example": "unchanged",
      "help_en": "Filters results by incremental scan baseline status. Valid values: new, unchanged, absent, updated",
      "help_zh": "按增量扫描 baseline 状态过滤，可选 new / unchanged / absent / updated",
      "location": "query",
      "name": "baseline_state",
      "options": [
        "--baseline-state"
      ],
      "raw_name": "baselineState",
      "required": false,
      "type": "string"
    },
    {
      "example": "app10000006824_fulljoin_61b2c_global_ad_budget_ctrl_v1.5.jar",
      "help_en": "Performs a fuzzy match by component name. This parameter takes effect only when engine is set to sca",
      "help_zh": "仅 engine=sca 时生效，按组件名模糊查询",
      "location": "query",
      "name": "package_name",
      "options": [
        "--package-name"
      ],
      "raw_name": "packageName",
      "required": false,
      "type": "string"
    },
    {
      "example": "zh",
      "help_en": "The language. Valid values:\nzh: Chinese (default).\nen: English",
      "help_zh": "语言取值：\nzh：中文（默认 ）\nen：英文",
      "location": "query",
      "name": "lang",
      "options": [
        "--lang"
      ],
      "raw_name": "lang",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/v1/projects/[projectId]/scans/[scanId]/results/[engine]",
  "product_code": "CodeSec",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "engine": {
            "backendName": "data.engine",
            "description_en": "The engine type. Valid values:\nsast\nsca",
            "description_zh": "类型取值：\nsast\nsca",
            "enum": [
              "sast",
              "sca"
            ],
            "example": "sca",
            "type": "string"
          },
          "items": {
            "backendName": "data.items",
            "description_en": "The result list",
            "description_zh": "结果列表",
            "itemName": "data",
            "items": {
              "description_en": "The result information",
              "description_zh": "结果信息",
              "properties": {
                "baselineState": {
                  "backendName": "baseline_state",
                  "description_en": "Filters results by incremental scan baseline status. Valid values: new, unchanged, absent, updated",
                  "description_zh": "按增量扫描 baseline 状态过滤，可选 new / unchanged / absent / updated",
                  "example": "new",
                  "type": "string"
                },
                "category": {
                  "backendName": "category",
                  "description_en": "The category. The system classifies files based on file name extensions and MIME types. Common categories include doc, image, audio, and video",
                  "description_zh": "分类， pds 会根据文件的后缀名和 mime-type 对文件进行分类，主要分类有 doc, image, audio, video",
                  "example": "SQL Injection",
                  "type": "string"
                },
                "codeSnippet": {
                  "backendName": "code_snippet",
                  "description_en": "The code snippet near the primary location (SAST)",
                  "description_zh": "主展示位置附近代码片段（SAST）",
                  "example": "1",
                  "type": "string"
                },
                "confidence": {
                  "backendName": "confidence",
                  "description_en": "The rule confidence level, ranging from 0 to 1. This field is common in SAST results and is omitted if not applicable",
                  "description_zh": "规则置信度 0–1，SAST 常见，无则省略",
                  "example": "1",
                  "format": "double",
                  "type": "number"
                },
                "createdAt": {
                  "backendName": "created_at",
                  "description_en": "The time when the finding record was created (RFC 3339 format)",
                  "description_zh": "发现记录创建时间（RFC3339）",
                  "example": "2026-07-28T03:36:31.573Z",
                  "type": "string"
                },
                "cweId": {
                  "backendName": "cwe_id",
                  "description_en": "The associated CWE ID",
                  "description_zh": "关联 CWE 编号",
                  "example": "CWE-601",
                  "type": "string"
                },
                "description": {
                  "backendName": "description",
                  "description_en": "The issue description",
                  "description_zh": "问题描述",
                  "example": "User input is directly concatenated into an SQL statement, which may lead to SQL injection.",
                  "type": "string"
                },
                "endLine": {
                  "backendName": "end_line",
                  "description_en": "The end line number",
                  "description_zh": "结束行号",
                  "example": "1",
                  "format": "int64",
                  "type": "integer"
                },
                "filePath": {
                  "backendName": "file_path",
                  "description_en": "The file path",
                  "description_zh": "文件路径",
                  "example": "aone2/2247063/1767838276141/Artifacts_EBookingApps_Pipeline_V2_Staging_131.tgz",
                  "type": "string"
                },
                "id": {
                  "backendName": "id",
                  "description_en": "The project ID",
                  "description_zh": "项目ID",
                  "example": "934",
                  "format": "int64",
                  "type": "integer"
                },
                "itemSummary": {
                  "backendName": "item_summary",
                  "description_en": "The brief summary of the finding. Unlike description, this field is more of a conclusion statement",
                  "description_zh": "该条 finding 的简短总结。与 description 区分，更偏向结论句",
                  "example": "User input is used to construct SQL queries without sanitization",
                  "type": "string"
                },
                "owaspCategory": {
                  "backendName": "owasp_category",
                  "description_en": "The OWASP category",
                  "description_zh": "OWASP 类目",
                  "example": "A01:2021-Broken Access Control",
                  "type": "string"
                },
                "projectName": {
                  "backendName": "project_name",
                  "description_en": "The project name",
                  "description_zh": "项目名称",
                  "example": "cdp2cdl_cdp_sha_nprd",
                  "type": "string"
                },
                "remediationCodeExample": {
                  "backendName": "remediation_code_example",
                  "description_en": "The remediation code example",
                  "description_zh": "修复示例代码",
                  "example": "String sql = \\\"SELECT * FROM users WHERE name = ?\\\";\\nPreparedStatement ps = conn.prepareStatement(sql);\\nps.setString(1, username);\\nResultSet rs = ps.executeQuery();",
                  "type": "string"
                },
                "remediationSuggestion": {
                  "backendName": "remediation_suggestion",
                  "description_en": "The remediation suggestion",
                  "description_zh": "修复建议说明",
                  "example": "Use PreparedStatement with parameterized queries instead of string concatenation",
                  "type": "string"
                },
                "ruleId": {
                  "backendName": "rule_id",
                  "description_en": "The rule ID",
                  "description_zh": "规则 ID",
                  "example": "java-sqli-001",
                  "type": "string"
                },
                "scaComponent": {
                  "backendName": "sca_component",
                  "description_en": "The SCA component information. This field is returned only when engine is set to sca",
                  "description_zh": "SCA 组件信息（仅 engine=sca）",
                  "properties": {
                    "cveCount": {
                      "backendName": "cve_count",
                      "description_en": "The number of CVEs",
                      "description_zh": "CVE 条数",
                      "example": "1",
                      "format": "int64",
                      "type": "integer"
                    },
                    "cveDetails": {
                      "backendName": "cve_details",
                      "description_en": "The list of CVE details associated with a component in the SCA finding",
