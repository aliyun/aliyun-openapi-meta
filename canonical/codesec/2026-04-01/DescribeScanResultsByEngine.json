          },
          "projectId": {
            "backendName": "data.project_id",
            "description_en": "The project ID",
            "description_zh": "项目ID",
            "example": "76851f2b5bf0187fbc29e8bca4",
            "format": "int64",
            "type": "integer"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "Id of the request",
            "description_zh": "Id of the request",
            "example": "9A1F403F-0A85-5578-8B7C-55E3E9408659",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "scanId": {
            "backendName": "data.scan_id",
            "description_en": "The task ID",
            "description_zh": "任务ID",
            "example": "3088795",
            "format": "int64",
            "type": "integer"
          },
          "totalCount": {
            "backendName": "data.total_count",
            "description_en": "The total number of entries",
            "description_zh": "总条数",
            "example": "2",
