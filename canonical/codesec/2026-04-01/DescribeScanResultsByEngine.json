                      "example": "Upgrade log4j-core to version 2.17.1 or later",
                      "type": "string"
                    },
                    "version": {
                      "backendName": "version",
                      "description_en": "The component version",
                      "description_zh": "组件版本",
                      "example": "2.14.1",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "scanId": {
                  "backendName": "scan_id",
                  "description_en": "The task ID",
                  "description_zh": "任务ID",
                  "example": "3176",
                  "format": "int64",
                  "type": "integer"
                },
                "severity": {
                  "backendName": "severity",
                  "description_en": "The severity level. Valid values:\ncritical \nhigh \nmedium \nlow",
                  "description_zh": "严重等级取值：\ncritical \nhigh \nmedium \nlow",
                  "example": "high",
                  "type": "string"
                },
