                  "items": {
                    "description_en": "The propagation path",
                    "description_zh": "传播路径",
                    "properties": {
                      "code": {
                        "backendName": "code",
                        "description_en": "The code",
                        "description_zh": "代码",
                        "example": "stmt.executeQuery(sql);",
