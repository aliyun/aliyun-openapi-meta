{
  "camel_example": "",
  "cmd_full_name": "codesec describe-scan-results-by-engine",
  "cmd_name": "describe-scan-results-by-engine",
  "deprecated": false,
  "description_en": "Queries the task result list to retrieve detailed SAST or SCA results for a specific scan",
  "description_zh": "查询任务结果列表的接口，用于获取某次扫描的 SAST 或 SCA 详细结果",
  "kebab_example": "",
  "method": "GET",
  "multi_version": false,
  "name": "DescribeScanResultsByEngine",
  "operation": {
    "action": "DescribeScanResultsByEngine",
    "api_style": "ROA",
    "api_version": "2026-04-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/v1/projects/{projectId}/scans/{scanId}/results/{engine}"
  },
  "parameters": [
    {
      "example": "1",
      "help_en": "The project ID",
      "help_zh": "项目ID",
      "location": "path",
      "name": "project_id",
      "options": [
        "--project-id"
      ],
      "raw_name": "projectId",
      "required": true,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The task ID",
      "help_zh": "任务ID",
      "location": "path",
      "name": "scan_id",
