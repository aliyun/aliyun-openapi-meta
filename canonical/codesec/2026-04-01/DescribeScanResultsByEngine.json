                      },
                      "type": "array"
                    },
                    "isDirect": {
                      "backendName": "is_direct",
                      "description_en": "Indicates whether the component is a direct dependency",
                      "description_zh": "是否为直接依赖",
                      "example": "false\n",
                      "type": "boolean"
                    },
                    "packageName": {
                      "backendName": "package_name",
                      "description_en": "The component coordinate",
                      "description_zh": "组件坐标",
                      "example": "org.apache.logging.log4j:log4j-core",
                      "type": "string"
