                  "example": "https://www.aliyun.com/product/imm",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                },
                "QRCodeBoundary": {
                  "backendName": "QRCodeBoundary",
                  "description_en": "The bounding box of the QR code",
                  "description_zh": "二维码位置框",
                  "nullToEmpty": true,
                  "properties": {
                    "Height": {
                      "backendName": "Height",
                      "description_en": "The height of the QR code bounding box. Unit: px",
                      "description_zh": "二维码位置框高度。单位为px",
                      "example": "706",
                      "format": "int32",
                      "nullToEmpty": true,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Left": {
                      "backendName": "Left",
                      "description_en": "The X coordinate of the top-left vertex, which is the distance from the left edge. Unit: px",
                      "description_zh": "顶点X坐标，距离左端距离。单位为px",
                      "example": "460",
                      "format": "int32",
                      "nullToEmpty": true,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Top": {
                      "backendName": "Top",
                      "description_en": "The Y coordinate of the top-left vertex, which is the distance from the top edge. Unit: px",
                      "description_zh": "顶点Y坐标，距离顶端距离。单位为px",
                      "example": "295",
                      "format": "int32",
                      "nullToEmpty": true,
                      "type": "integer",
                      "visibility": "Public"
                    },
                    "Width": {
                      "backendName": "Width",
                      "description_en": "The width of the QR code bounding box. Unit: px",
                      "description_zh": "二维码位置框宽度。单位为px",
                      "example": "741",
                      "format": "int32",
                      "nullToEmpty": true,
                      "type": "integer",
                      "visibility": "Public"
                    }
                  },
                  "type": "object",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "当次请求的Request ID",
            "example": "52D33EAE-88B2-4ADE-A5DB-18BD426617A5",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
