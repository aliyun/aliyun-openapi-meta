{
  "cmd_full_name": "imm detect-image-qr-codes",
  "cmd_name": "detect-image-qr-codes",
  "deprecated": false,
  "description_en": "Detects the positions and content of QR codes in an image",
  "description_zh": "检测图片中二维码的位置和内容",
  "kebab_example": "aliyun imm detect-image-qr-codes --project immimagetest --image-uri oss://imm-test/testcases/QRcodetest.jpg --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DetectImageQRCodes",
  "operation": {
    "action": "DetectImageQRCodes",
    "api_style": "RPC",
    "api_version": "2017-09-06",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "immimagetest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "oss://imm-test/testcases/QRcodetest.jpg",
      "help_en": "The OSS URI of the image.\n\nThe OSS URI follows the format `oss://bucket/object`, where bucket is the name of the OSS bucket in the same region as the current project, and object is the file path",
      "help_zh": "图片的OSS URI。\n\nOSS地址规则为`oss://bucket/object`，其中bucket为和当前项目处于同一区域的OSS Bucket名称，object为文件路径",
      "location": "query",
      "name": "image_uri",
      "options": [
        "--image-uri"
      ],
      "raw_name": "ImageUri",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ImageUri": {
            "backendName": "ImageUri",
            "description_en": "The OSS URI of the image",
            "description_zh": "图片的OSS URI",
            "example": "oss://imm-test/testcases/QRcodetest.jpg",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "QRCodes": {
            "backendName": "QRCodes",
            "description_en": "The detected QR code information.\n\nCurrently, only one QR code can be returned at most",
