{
  "cmd_full_name": "imm detect-qr-codes",
  "cmd_name": "detect-qr-codes",
  "deprecated": false,
  "description_en": "Detects QR codes in images. We recommend that you use DetectImageQRCodes instead",
  "description_zh": "二维码检测，建议换用DetectImageQRCodes",
  "kebab_example": "aliyun imm detect-qr-codes --project immimagetest --src-uris '“oss://imm-test/testcases/QRcodetest.jpg”' --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DetectQRCodes",
  "operation": {
    "action": "DetectQRCodes",
    "api_style": "RPC",
    "api_version": "2017-09-06",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "immimagetest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "example": "[“oss://imm-test/testcases/QRcodetest.jpg”]",
      "help_en": "The OSS URI of the image, represented as a JSON string. Only one image is supported.\n\nThe OSS URI follows the format `oss://bucket/object`, where bucket is the name of an OSS bucket in the same region as the current project, and object is the file path",
      "help_zh": "图片的OSS URI，以JSON格式的字符串表示。当前仅支持1张图片。\n\nOSS地址规则为`oss://bucket/object`，其中bucket为和当前项目处于同一区域的OSS Bucket名称，object为文件路径",
      "location": "query",
      "name": "src_uris",
      "options": [
        "--src-uris"
      ],
      "raw_name": "SrcUris",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "FailDetails": {
            "backendName": "FailDetails",
            "description_en": "The list of failed items",
            "description_zh": "失败项目列表",
            "itemName": "FailDetails",
            "items": {
              "properties": {
                "ErrorCode": {
                  "backendName": "ErrorCode",
                  "description_en": "The error code",
                  "description_zh": "错误码",
                  "example": "InvalidSrcUris",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "ErrorMessage": {
                  "backendName": "ErrorMessage",
                  "description_en": "The error message",
                  "description_zh": "错误信息",
                  "example": "The resource SrcUris is not valid. Please check.",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "SrcUri": {
                  "backendName": "SrcUri",
                  "description_en": "The OSS URI of the image",
                  "description_zh": "图片的OSS URI",
                  "example": "oss://imm-test/testcases/QRcodetest.jpg",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": false,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "当次请求的Request ID",
            "example": "E6A558B8-87C1-45BE-90B9-26049B0BAB01",
            "type": "string",
            "visibility": "Public"
          },
          "SuccessDetails": {
            "backendName": "SuccessDetails",
            "description_en": "The list of successful items",
            "description_zh": "成功项目列表",
            "itemName": "SuccessDetails",
            "items": {
              "properties": {
                "QRCodes": {
                  "backendName": "QRCodes",
                  "description_en": "The detected QR code information.\n\nCurrently, only one QR code can be returned at most",
                  "description_zh": "识别出的二维码信息。\n\n目前最多只能返回一个二维码",
                  "itemName": "QRCodes",
                  "items": {
                    "properties": {
                      "Content": {
                        "backendName": "Content",
                        "description_en": "The content of the QR code",
                        "description_zh": "二维码内容",
                        "example": "https://www.aliyun.com/product/imm",
                        "type": "string",
                        "visibility": "Public"
                      },
                      "QRCodesRectangle": {
                        "backendName": "QRCodesRectangle",
                        "description_en": "The bounding box information of the QR code",
                        "description_zh": "二维码位置框信息",
                        "properties": {
                          "Height": {
                            "backendName": "Height",
                            "description_en": "The height of the QR code bounding box. Unit: px",
                            "description_zh": "二维码位置框高度。单位为px",
                            "example": "706",
                            "type": "string",
                            "visibility": "Public"
                          },
                          "Left": {
                            "backendName": "Left",
                            "description_en": "The X coordinate of the top-left vertex, which is the distance from the left edge. Unit: px",
                            "description_zh": "顶点X坐标，距离左端距离。单位为px",
                            "example": "460",
                            "type": "string",
                            "visibility": "Public"
                          },
                          "Top": {
                            "backendName": "Top",
                            "description_en": "The Y coordinate of the top-left vertex, which is the distance from the top edge. Unit: px",
                            "description_zh": "顶点Y坐标，距离顶端距离。单位为px",
                            "example": "295",
                            "type": "string",
                            "visibility": "Public"
                          },
                          "Width": {
                            "backendName": "Width",
                            "description_en": "The width of the QR code bounding box. Unit: px",
                            "description_zh": "二维码位置框宽度。单位为px",
                            "example": "741",
                            "type": "string",
                            "visibility": "Public"
                          }
                        },
                        "type": "object",
                        "visibility": "Public"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array",
                  "visibility": "Public"
                },
                "SrcUri": {
                  "backendName": "SrcUri",
                  "description_en": "The OSS URI of the image",
                  "description_zh": "图片的OSS URI",
                  "example": "oss://imm-test/testcases/QRcodetest.jpg",
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": false,
            "type": "array",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
