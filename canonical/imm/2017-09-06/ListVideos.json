{
  "cmd_full_name": "imm list-videos",
  "cmd_name": "list-videos",
  "deprecated": false,
  "description_en": "Calls the ListVideos operation to retrieve a list of video information from a media set. The results are sorted in ascending order by the time when the videos were added to the media set",
  "description_zh": "调用ListVideos接口获取媒体集中的视频信息列表，返回结果以视频加入媒体集的时间升序排序",
  "kebab_example": "aliyun imm list-videos --project immvideotest --set-id videotest --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "ListVideos",
  "operation": {
    "action": "ListVideos",
    "api_style": "RPC",
    "api_version": "2017-09-06",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "immvideotest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "videotest",
      "help_en": "The unique identifier of the media set",
      "help_zh": "媒体集的唯一标识",
      "location": "query",
      "name": "set_id",
      "options": [
        "--set-id"
      ],
      "raw_name": "SetId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "2021-01-21T06:40:41.683Z",
      "help_en": "The start time for video creation. Only videos added to the media set after this time are returned",
      "help_zh": "视频创建时间的起始点，返回的视频均在此时间后加入媒体集",
      "location": "query",
      "name": "create_time_start",
      "options": [
        "--create-time-start"
      ],
      "raw_name": "CreateTimeStart",
      "required": false,
      "type": "string"
    },
    {
      "example": "",
      "help_en": "The marker from which to return video information in lexicographic order. If this parameter is not specified, video information is returned from the beginning",
      "help_zh": "从Marker开始按字典序返回视频信息列表。如果不设置此参数，则从头开始返回视频信息",
      "location": "query",
      "name": "marker",
      "options": [
        "--marker"
      ],
      "raw_name": "Marker",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
