        "properties": {
          "NextMarker": {
            "backendName": "NextMarker",
            "description_en": "The marker to use in the next request to list video information. Unreturned results are returned starting from this value. \n\nThis parameter has a value only when not all video information has been returned",
            "description_zh": "下一次列出视频信息时以此值为Marker，将未返回的结果返回。 \n\n当视频信息未全部返回时，此参数才有值",
            "example": "",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "当次请求的Request ID",
            "example": "B1469D0A-862A-405E-B81B-37760516627D",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "SetId": {
            "backendName": "SetId",
