                  "example": "2",
                  "format": "int32",
                  "nullToEmpty": false,
                  "type": "integer",
                  "visibility": "Public"
                },
                "TagName": {
                  "backendName": "TagName",
                  "description_en": "The label name",
                  "description_zh": "标签名称",
                  "example": "脸",
                  "nullToEmpty": true,
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
