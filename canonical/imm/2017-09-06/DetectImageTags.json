            "backendName": "Tags",
            "description_en": "The list of label detection results",
            "description_zh": "标签识别结果列表",
            "itemName": "Tags",
            "items": {
              "properties": {
                "CentricScore": {
                  "backendName": "CentricScore",
                  "description_en": "The centricity score of the label. This score indicates how prominent the label content is in the image. A higher score means the label is more likely to represent the main subject of the image. Valid values: 0 to 1",
                  "description_zh": "标签主体分数。用于提示该标签内容在图片中的主要程度，越高则说明该标签越可能为图片主体。取值范围为0~1",
                  "example": "0",
                  "format": "float",
                  "type": "number"
                },
                "ParentTagEnName": {
                  "backendName": "ParentTagEnName",
                  "description_en": "This parameter is not supported in the current version.\n\nThe English name of the parent label",
                  "description_zh": "当前版本不支持此参数。\n\n父级标签英文名称",
                  "example": "person",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "ParentTagName": {
                  "backendName": "ParentTagName",
                  "description_en": "The parent label name",
                  "description_zh": "父级标签名称",
