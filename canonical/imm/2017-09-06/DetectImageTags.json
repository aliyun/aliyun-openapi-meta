    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "immimagetest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "oss://imm-test/testcases/facetest.jpg",
      "help_en": "The OSS URI of the image.\n\nThe OSS URI follows the format `oss://bucket/object`, where bucket is the name of an OSS bucket in the same region as the current project, and object is the file path",
      "help_zh": "图片的OSS URI。\n\nOSS地址规则为`oss://bucket/object`，其中bucket为和当前项目处于同一区域的OSS Bucket名称，object为文件路径",
      "location": "query",
      "name": "image_uri",
      "options": [
        "--image-uri"
      ],
      "raw_name": "ImageUri",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ImageUri": {
            "backendName": "ImageUri",
            "description_en": "The OSS URI of the image",
            "description_zh": "图片的OSS URI",
            "example": "oss://imm-test/testcases/facetest.jpg",
            "nullToEmpty": true,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
