                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "TagConfidence": {
                  "backendName": "TagConfidence",
                  "description_en": "The confidence level of the label",
                  "description_zh": "标签置信度",
                  "example": "0.9897482395172119",
                  "format": "float",
                  "nullToEmpty": false,
                  "type": "number",
                  "visibility": "Public"
                },
                "TagEnName": {
                  "backendName": "TagEnName",
                  "description_en": "This parameter is not supported in the current version.\n\nThe English name of the label",
                  "description_zh": "当前版本不支持此参数。\n\n标签英文名称",
