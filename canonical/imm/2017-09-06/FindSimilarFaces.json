  "kebab_example": "aliyun imm find-similar-faces --project immimagetest --set-id set001 --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "FindSimilarFaces",
  "operation": {
    "action": "FindSimilarFaces",
    "api_style": "RPC",
    "api_version": "2017-09-06",
