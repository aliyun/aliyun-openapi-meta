  "kebab_example": "aliyun opensearch list-query-processors --app-group-identity my_app_group_name --app-id 110157886 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListQueryProcessors",
  "operation": {
    "action": "ListQueryProcessors",
    "api_style": "ROA",
    "api_version": "2017-12-25",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/v4/openapi/app-groups/{appGroupIdentity}/apps/{appId}/query-processors"
  },
  "parameters": [
