  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeRtcChannelMetric",
  "operation": {
    "action": "DescribeRtcChannelMetric",
    "api_style": "RPC",
    "api_version": "2018-01-11",
    "method": "POST",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "2018-01-29T00:00:00Z",
