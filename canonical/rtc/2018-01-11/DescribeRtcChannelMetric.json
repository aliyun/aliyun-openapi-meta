      "name": "time_point",
      "options": [
        "--time-point"
      ],
      "raw_name": "TimePoint",
      "required": true,
      "type": "string"
    },
    {
      "example": "aoe****",
      "help_en": "The application ID. You can create and query the application ID in the console. Only a single ID is supported",
      "help_zh": "应用ID，可通过控制台创建和查询，仅支持传单个ID",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": true,
      "type": "string"
