      "param_style": "repeatList",
      "raw_name": "TemplateIds",
      "required": false,
      "type": "array"
    },
    {
      "doc_required": true,
      "example": "yourAppId",
      "help_en": "The application ID. You can create and query the application ID in the console. Only a single ID can be passed",
      "help_zh": "应用ID。通过控制台创建和查询，仅支持传单个ID",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": true,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The number of entries to return on each page. Default value: 10",
      "help_zh": "每页显示个数，默认取值10",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    },
    {
      "example": "1",
      "help_en": "The page number. By default, the first page (1) is queried",
      "help_zh": "第几页，默认查询第1页",
      "location": "query",
      "name": "page_num",
      "options": [
        "--page-num"
      ],
      "raw_name": "PageNum",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "rtc",
  "protocol": "HTTP|HTTPS",
