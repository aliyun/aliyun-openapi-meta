{
  "camel_example": "",
  "cmd_full_name": "rtc describe-rtc-duration-data",
  "cmd_name": "describe-rtc-duration-data",
  "deprecated": false,
  "description_en": "Retrieves the total communication duration for an application within a specified time range. Data is aggregated by audio and video specifications",
  "description_zh": "获取应用在一段时间内按照音视频规格进行统计的累计通信时长",
  "kebab_example": "aliyun rtc describe-rtc-duration-data --start-time 2020-02-04T05:00:00Z --end-time 2020-02-04T07:00:00Z --app-id yourAppId --service-area CN --interval 3600 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeRtcDurationData",
  "operation": {
    "action": "DescribeRtcDurationData",
    "api_style": "RPC",
    "api_version": "2018-01-11",
    "method": "POST",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "2020-02-04T05:00:00Z",
      "help_en": "The start of the time range to query. Specify the time in UTC format: yyyy-MM-ddTHH:mm:ssZ",
      "help_zh": "查询数据起始时间，UTC格式，格式为yyyy-MM-ddTHH:mm:ssZ",
      "location": "query",
      "name": "start_time",
      "options": [
        "--start-time"
      ],
      "raw_name": "StartTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "2020-02-04T07:00:00Z",
      "help_en": "The end of the time range to query. Specify the time in UTC format: yyyy-MM-ddTHH:mm:ssZ.\n\nThe end time must be later than the start time",
      "help_zh": "查询数据结束时间，UTC格式，格式为yyyy-MM-ddTHH:mm:ssZ。\n\n结束时间需大于起始时间",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "yourAppId",
      "help_en": "The ID of the application. You can specify only one ID.\n\nIf you leave this parameter empty, data for all your applications is returned",
      "help_zh": "应用ID，仅支持传单个ID。\n\n默认查询所有应用ID。\n                           ",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": false,
      "type": "string"
    },
    {
      "example": "CN",
      "help_en": "The area where the service is deployed. The default value is CN, which indicates China",
      "help_zh": "服务区域，CN：中国（默认值）",
      "location": "query",
      "name": "service_area",
      "options": [
        "--service-area"
      ],
      "raw_name": "ServiceArea",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "86400",
        "3600"
      ],
      "example": "3600",
      "help_en": "The time granularity of the query, in seconds.\n\nValid values are 3600 (1 hour) and 86400 (1 day). The default value is 3600",
      "help_zh": "查询数据的时间粒度，单位：秒。\n\n取值为3600（1小时）或86400（1天），默认为3600。\n                           ",
      "location": "query",
      "name": "interval",
      "options": [
        "--interval"
      ],
      "raw_name": "Interval",
      "required": false,
      "type": "string"
    }
  ],
