                  "backendName": "consecutiveFails",
                  "description_en": "The number of consecutive failed attempts to bind or authenticate the virtual MFA device",
                  "description_zh": "连续绑定或者认证虚拟MFA设备失败的次数",
                  "example": "0",
                  "format": "int32",
                  "type": "integer"
                },
                "DeviceType": {
                  "backendName": "deviceType",
                  "description_en": "The type of the virtual MFA device. Set the value to `TOTP_VIRTUAL`, which indicates a virtual MFA device that complies with the Time-based One-time Password (TOTP) algorithm",
                  "description_zh": "虚拟MFA设备类型。目前仅支持`TOTP_VIRTUAL`，即遵循TOTP算法的虚拟MFA设备",
                  "example": "TOTP_VIRTUAL",
                  "type": "string"
                },
                "Email": {
                  "backendName": "email",
                  "description_en": "This parameter is not in use",
                  "description_zh": "该参数暂未开放使用",
                  "example": "username@example.com",
                  "type": "string"
                },
                "EndUserId": {
                  "backendName": "endUserId",
                  "description_en": "The username of the convenience user who uses the virtual MFA device",
                  "description_zh": "使用该虚拟MFA设备的便捷账号用户名",
                  "example": "alice",
                  "type": "string"
                },
                "GmtEnabled": {
                  "backendName": "gmtEnabled",
                  "description_en": "The time when the virtual MFA device was enabled. The time is displayed in UTC and is formatted as `yyyy-MM-ddTHH:mm:ssZ`",
                  "description_zh": "虚拟MFA设备启用时间。按照ISO8601标准表示，并使用UTC+0时间，格式为`yyyy-MM-ddTHH:mm:ssZ`",
                  "example": "2021-06-22T06:20:49Z",
                  "type": "string"
                },
                "GmtUnlock": {
                  "backendName": "gmtUnlock",
                  "description_en": "The time when the locked virtual MFA device is automatically unlocked. The time is displayed in UTC and is formatted as `yyyy-MM-ddTHH:mm:ssZ`",
                  "description_zh": "虚拟MFA设备被锁定后的自动解锁时间。按照ISO8601标准表示，并使用UTC+0时间，格式为`yyyy-MM-ddTHH:mm:ssZ`",
                  "example": "2021-06-23T06:20:49Z",
                  "type": "string"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "The ID of the virtual MFA device",
                  "description_zh": "虚拟MFA设备的ID",
                  "example": "36",
                  "format": "int64",
                  "type": "integer"
                },
                "SerialNumber": {
                  "backendName": "serialNumber",
                  "description_en": "The serial number of the virtual MFA device",
                  "description_zh": "虚拟MFA设备的序列号",
                  "example": "dc856334-446b-4035-bfbc-18af261e****",
                  "type": "string"
                },
                "Status": {
                  "backendName": "status",
                  "description_en": "The status of the virtual MFA device",
                  "description_zh": "虚拟MFA设备状态",
                  "example": "NORMAL",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "title_en": "mfa device list",
            "title_zh": "mfa device list",
            "type": "array"
          },
