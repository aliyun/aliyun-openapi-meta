      "options": [
        "--variable-values"
      ],
      "param_style": "json",
      "raw_name": "variableValues",
      "required": false,
      "type": "object"
    }
  ],
  "pathPattern": "/2023-07-14/templates/action/renderServices",
  "product_code": "Devs",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "parseType": "struct",
        "properties": {
          "changedServiceNames": {
            "additionalProperties": {
              "description_en": "Original service name",
              "description_zh": "原始服务名称",
              "example": "demo-service",
              "title_en": "原始服务名称",
              "title_zh": "原始服务名称",
              "type": "string"
            },
            "description_en": "A map of changed service names where the key is the new service name and the value is the original service name. This tracking enables you to modify names multiple times before deployment",
            "description_zh": "变化后的服务名称。key是新的服务名称，value是原始服务名称。\n通过这个字段，可以记录模板的原始服务名称，实现部署前的不断修改名称",
            "title_en": "变化后的服务名称。key是新的服务名称，value是原始服务名称。\n通过这个字段，可以记录模板的原始服务名称，实现部署前的不断修改名称",
            "title_zh": "变化后的服务名称。key是新的服务名称，value是原始服务名称。\n通过这个字段，可以记录模板的原始服务名称，实现部署前的不断修改名称",
            "type": "object"
          },
          "services": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ServiceConfig",
              "description_en": "Service configuration",
              "description_zh": "服务配置",
              "title_en": "服务配置",
              "title_zh": "服务配置"
            },
            "description_en": "A map of the parsed services",
            "description_zh": "解析后的服务集合",
            "title_en": "解析后的服务集合",
            "title_zh": "解析后的服务集合",
            "type": "object"
          },
          "variables": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Variable",
              "description_en": "Variable configuration",
              "description_zh": "变量配置",
              "title_en": "变量配置",
              "title_zh": "变量配置"
            },
            "description_en": "A map of the parsed variables",
            "description_zh": "解析后的变量集合",
            "title_en": "解析后的变量集合",
            "title_zh": "解析后的变量集合",
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  },
  "v1_body_parameters": [
    {
