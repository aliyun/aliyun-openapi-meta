      "required": false,
      "type": "map",
      "value": {
        "type": "any"
      }
    },
    {
      "example": "my-project",
      "help_en": "The name of the project to which services will be added. When a project name is provided, the operation checks for naming conflicts between services in the template and those already in the project. If a conflict is found, the operation automatically generates a unique service name",
      "help_zh": "项目名称，用于在已有项目中通过模板新增服务的场景。当指定时，会检测模板中的服务名和指定项目中的服务是否存在命名冲突，如果冲突时会自动生成新的服务名称",
      "location": "body",
      "name": "project_name",
      "options": [
        "--project-name"
      ],
      "param_style": "json",
      "raw_name": "projectName",
      "required": false,
      "type": "string"
    },
    {
      "example": "{\"svc1\":\"svc2\"}",
      "help_en": "A map for renaming services. The key is the original service name from the template, and the value is the new service name",
      "help_zh": "服务名称变化，key是模板原始服务名，value是需要修改的目标服务名",
      "location": "body",
      "name": "service_name_changes",
      "options": [
        "--service-name-changes"
      ],
      "param_style": "json",
      "raw_name": "serviceNameChanges",
      "required": false,
      "type": "map",
      "value": {
        "type": "string"
      }
    },
    {
      "example": "start-springboot",
      "help_en": "Template name",
      "help_zh": "模板名称",
      "location": "body",
      "name": "template_name",
      "options": [
        "--template-name"
      ],
      "param_style": "json",
      "raw_name": "templateName",
      "required": true,
      "type": "string"
    },
    {
      "fields": [
        {
          "help_en": "服务变量",
          "help_zh": "服务变量",
          "name": "services",
          "options": [
            "--services"
          ],
          "raw_name": "services",
          "required": false,
          "type": "map",
          "value": {
            "type": "map",
            "value": {
              "type": "string"
            }
          }
        },
        {
          "example": "{\"TEST_KEY\":\"new_value\"}",
          "help_en": "共享变量",
          "help_zh": "共享变量",
          "name": "shared",
