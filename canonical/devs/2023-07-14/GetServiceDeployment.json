        "properties": {
          "finishedTime": {
            "backendName": "finishedTime",
            "title": "部署完成时间",
            "type": "string"
          },
          "phase": {
            "backendName": "phase",
            "example": "Running",
            "title": "本次服务部署的状态，包括：Initializing：初始化中、Running: 部署中、Finished: 已部署、Failed: 部署失败、Canceled: 已取消、HangUp：已挂起",
            "type": "string"
          },
          "pipelineName": {
            "backendName": "pipelineName",
            "example": "my-pipeline",
