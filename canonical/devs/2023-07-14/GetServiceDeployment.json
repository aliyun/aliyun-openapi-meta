            "type": "object"
          },
          "name": {
            "backendName": "name",
            "example": "my-deployment",
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^(?![0-9]+$)(?!-)[a-zA-Z0-9-_]{0,63}(?<!-)$",
            "required": true,
            "title": "当前资源的名称。在项目中，它需要是唯一的，且无法变更",
            "type": "string"
          },
          "status": {
