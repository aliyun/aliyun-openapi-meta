{
  "camel_example": "",
  "cmd_full_name": "devs deploy-environment",
  "cmd_name": "deploy-environment",
  "components": {
    "schemas": {
      "ArtifactMeta": {
        "description_en": "产物的元数据内容",
        "description_zh": "产物的元数据内容",
        "properties": {
          "checksum": {
            "backendName": "checksum",
            "example": "CRC-64 code",
            "title": "产物的CRC-64校验和。如果指定，则只有当制品当前的校验和指定的相同时才进行部署。",
            "type": "string"
          },
          "name": {
            "backendName": "name",
            "example": "my-artifact",
            "title": "产物的名称",
            "type": "string"
          }
        },
        "title": "产物的元数据内容，能唯一标识一个产物",
        "type": "object"
      },
      "BranchFilter": {
        "description_en": "分支过滤规则",
        "description_zh": "分支过滤规则",
        "properties": {
          "name": {
            "backendName": "name",
            "example": "master",
            "title": "目标分支发生变更则触发",
            "type": "string"
          }
        },
        "title": "分支过滤规则",
        "type": "object"
      },
      "BuildCacheConfig": {
        "description_en": "构建缓存配置",
        "description_zh": "构建缓存配置",
        "properties": {
          "keyPath": {
            "backendName": "keyPath",
            "example": "{ \t\"3C75C832-0EAD-40D6-8FA1-2BA9171C926B\": \"~/.npm\", \t\"D256BB7A-1886-4A19-A75B-A1FDC23D5A00\": \"~/.cache\" }",
            "title": "缓存唯一标识符与缓存路径的映射关系，可以由系统自动生成",
            "type": "object"
          },
          "paths": {
            "backendName": "paths",
            "items": {
              "example": "~/.npm",
              "type": "string"
            },
            "title": "需要缓存的路径",
            "type": "array"
          }
        },
        "title": "构建时的缓存配置，拉取代码后，缓存文件会被放入指定位置，任务成功后，缓存文件将被更新",
        "type": "object"
      },
      "BuildConfig": {
        "description_en": "构架配置",
        "description_zh": "构架配置",
        "properties": {
          "default": {
            "$ref": "#/components/schemas/DefaultBuilderConfig",
            "backendName": "default",
            "title": "基于默认构建器的构建配置"
          }
        },
        "title": "描述一个服务的代码应该如何被构建",
        "type": "object"
      },
      "CodeVersionReference": {
        "description_en": "代码版本引用",
        "description_zh": "代码版本引用",
        "properties": {
          "branch": {
            "backendName": "branch",
            "example": "main",
            "title": "仓库分支名称",
            "type": "string"
          },
          "commitID": {
            "backendName": "commitID",
            "example": "12721ec262d03a93809ba2bbc717963cb298ceca",
            "title": "仓库分支中某个commit的SHA值，为空时使用当前分支中最新的commit",
            "type": "string"
          }
        },
        "title": "代码版本引用",
        "type": "object"
      },
      "DefaultBuilderConfig": {
        "description_en": "构架配置",
        "description_zh": "构架配置",
        "properties": {
          "cache": {
            "$ref": "#/components/schemas/BuildCacheConfig",
            "backendName": "cache",
            "title": "缓存配置"
          },
          "languages": {
            "backendName": "languages",
            "items": {
              "example": "Python3.9",
              "type": "string"
            },
            "title": "执行环境需要设置的语言，例如Java11，Python3.9等",
            "type": "array"
          },
          "rootPath": {
            "backendName": "rootPath",
            "example": "./src",
            "title": "构建时使用的源码根目录，默认为代码仓库的根目录。构建时，会在源码根目录下执行所有构建步骤，并且将源码根目录进行打包。如果需要在打包时过滤指定文件，可以在源码根目录下增加.signore文件指定要打包时排除的文件",
            "type": "string"
          },
          "steps": {
            "backendName": "steps",
            "items": {
              "example": "{\"run\": \"npm build\"}",
              "type": "any"
            },
            "title": "组件构建的步骤，步骤将被顺序执行。步骤的类型可以是命令类型(ServiceCommandStep)，插件类型(ServicePluginStep)以\\ 及组件类型(ServiceComponentStep)",
            "type": "array"
          }
        },
        "title": "描述一个服务的代码应该如何被构建",
        "type": "object"
      },
      "EnvironmentChanges": {
        "description_en": "环境配置的变化",
        "description_zh": "环境配置的变化",
        "properties": {
          "services": {
            "backendName": "services",
            "title": "环境中服务的配置变化，只读。是经过变量解析后的ServicesConfigs的JSON Merge Patch对象",
            "type": "object"
          }
        },
        "title": "环境中的配置变化，只读",
        "type": "object"
      },
      "EnvironmentDeployment": {
        "description_en": "环境部署。描述一次环境的部署，每次环境的部署会产生并编排服务的部署并执行",
        "description_zh": "环境部署。描述一次环境的部署，每次环境的部署会产生并编排服务的部署并执行",
        "properties": {
          "createdTime": {
            "backendName": "createdTime",
            "example": "2021-11-19T09:34:38Z",
            "title": "表示创建此对象时服务器的时间，只读",
            "type": "string"
          },
          "description": {
            "backendName": "description",
            "example": "commit by xxx.",
            "title": "资源的描述信息",
            "type": "string"
          },
          "kind": {
            "backendName": "kind",
            "example": "Deployment",
            "title": "当前资源的名称，只读",
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "example": "value to the label key.",
              "type": "string"
            },
            "backendName": "labels",
            "title": "资源的标签",
            "type": "object"
          },
          "name": {
            "backendName": "name",
            "example": "my-deployment",
            "maxLength": 63,
            "minLength": 1,
            "pattern": "^(?![0-9]+$)(?!-)[a-zA-Z0-9-_]{0,63}(?<!-)$",
            "required": true,
            "title": "当前资源的名称。在项目中，它需要是唯一的，且无法变更",
            "type": "string"
          },
          "spec": {
            "$ref": "#/components/schemas/EnvironmentDeploymentSpec",
            "backendName": "spec",
            "title": "资源的配置"
          },
          "status": {
            "$ref": "#/components/schemas/EnvironmentDeploymentStatus",
            "backendName": "status",
            "title": "资源的状态"
          },
          "uid": {
            "backendName": "uid",
            "example": "1455541096***548",
            "required": false,
            "title": "当前阿里云主账号的ID，只读",
            "type": "string"
          }
        },
        "title": "环境部署。描述一次环境的部署，每次环境的部署会产生并编排若干个服务的部署并执行",
        "type": "object"
      },
      "EnvironmentDeploymentSpec": {
        "description_en": "环境部署的配置信息",
        "description_zh": "环境部署的配置信息",
        "properties": {
          "baseline": {
            "$ref": "#/components/schemas/EnvironmentSnapshot",
            "backendName": "baseline",
            "title": "环境配置基线"
          },
          "changes": {
            "$ref": "#/components/schemas/EnvironmentChanges",
            "backendName": "changes",
            "title": "环境配置的变化内容"
          },
          "skipRemoveResources": {
            "backendName": "skipRemoveResources",
            "example": "false",
            "title": "删除时，是否要跳过清理资源。默认为false，对资源进行清理",
            "type": "boolean"
          },
          "target": {
            "$ref": "#/components/schemas/EnvironmentStagedConfigs",
            "backendName": "target",
            "title": "本次环境部署计划达到的配置目标"
          },
          "webhookCodeContext": {
            "$ref": "#/components/schemas/WebhookCodeContext",
            "backendName": "webhookCodeContext",
            "title": "webhook触发的上下文"
          }
        },
        "title": "环境部署配置",
        "type": "object"
      },
      "EnvironmentDeploymentStatus": {
        "properties": {
          "finishedTime": {
            "backendName": "finishedTime",
            "title": "部署完成时间",
            "type": "string"
          },
          "phase": {
            "backendName": "phase",
            "example": "Running",
            "title": "本次环境部署的执行状态，包括：Initializing: 初始化中、InitFailed: 初始化失败、Running: 执行中、HangUp: 挂起等待审批中、Finished: 执行完成、Failed: 部署失败、Canceled: 已取消",
            "type": "string"
          },
          "pipelineName": {
            "backendName": "pipelineName",
            "example": "my-pipeline",
            "title": "完成本次环境部署所使用的流水线名称",
            "type": "string"
          },
          "serviceDeployments": {
            "additionalProperties": {
              "example": "服务部署名称",
              "type": "string"
            },
            "backendName": "serviceDeployments",
            "title": "服务名称对应的部署。",
            "type": "object"
          }
        },
        "title": "环境部署的状态信息",
        "type": "object"
      },
      "EnvironmentSnapshot": {
        "description_en": "环境中当前已部署的服务的快照。包含已部署的服务的配置、状态、变量等信息",
        "description_zh": "环境中当前已部署的服务的快照。包含已部署的服务的配置、状态、变量等信息",
        "properties": {
          "services": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ServiceInstance"
            },
            "backendName": "services",
            "title": "环境中已部署的服务",
            "type": "object"
          }
        },
        "title": "环境中当前已部署的服务的快照。包含已部署的服务的配置、状态、变量等信息",
        "type": "object"
      },
      "EnvironmentStagedConfigs": {
        "description_en": "环境配置的变化",
        "description_zh": "环境配置的变化",
        "properties": {
          "services": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ServiceConfig"
            },
            "backendName": "services",
            "title": "环境中服务的配置",
            "type": "object"
          },
          "variables": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Variable"
            },
            "backendName": "variables",
            "title": "环境中共享变量的配置",
            "type": "object"
          }
        },
        "title": "环境中的一套可被部署的配置",
        "type": "object"
      },
      "EventFilterConfig": {
        "description_en": "The event filtering configuration",
        "description_zh": "事件过滤配置",
        "properties": {
          "branch": {
            "$ref": "#/components/schemas/BranchFilter",
            "backendName": "branch",
            "description_en": "The branch where the change event occurs",
            "description_zh": "分支发生变更事件",
            "title": "分支发生变更事件"
          }
        },
        "title": "事件过滤配置",
        "type": "object"
      },
      "OssSourceConfig": {
        "properties": {
          "bucket": {
            "backendName": "bucket",
            "example": "demo-bucket",
            "title": "OSS bucket名称",
            "type": "string"
          },
          "object": {
            "backendName": "object",
            "example": "demo-object",
            "title": "OSS 对象名称",
            "type": "string"
          }
        },
        "title": "OSS代码源对象",
        "type": "object"
      },
      "RepositorySourceConfig": {
        "description_en": "仓库源码配置，描述一个代码仓库中的一套源码",
        "description_zh": "仓库源码配置，描述一个代码仓库中的一套源码",
        "properties": {
          "codeVersion": {
            "$ref": "#/components/schemas/CodeVersionReference",
            "backendName": "codeVersion",
            "title": "代码版本引用，描述了代码仓库中一个具体的代码版本"
          },
          "filter": {
            "$ref": "#/components/schemas/EventFilterConfig",
            "backendName": "filter"
          },
          "repositoryName": {
            "backendName": "repositoryName",
            "example": "my-repository",
            "required": true,
            "title": "关联的平台中的仓库绑定实体的名称，该实体描述了一个具体的代码仓库",
            "type": "string"
          }
        },
        "title": "仓库源码配置，描述一个代码仓库中的一套源码",
        "type": "object"
      },
      "ServiceConfig": {
        "description_en": "服务配置描述",
        "description_zh": "服务配置描述",
        "properties": {
          "artifact": {
            "$ref": "#/components/schemas/ArtifactMeta",
            "backendName": "artifact",
            "title": "交付物配置。配置后部署时会使用指定的交付物"
          },
          "build": {
            "$ref": "#/components/schemas/BuildConfig",
            "backendName": "build"
          },
          "component": {
            "backendName": "component",
            "example": "fc3@1.0.0",
            "title": "组件名称，符合ServerlessDevs的规范",
            "type": "string"
          },
          "props": {
            "backendName": "props",
            "title": "服务属性",
            "type": "object"
          },
          "source": {
            "$ref": "#/components/schemas/SourceConfig",
            "backendName": "source",
            "title": "代码源配置"
          },
          "type": {
            "backendName": "type",
            "example": "Function",
            "title": "服务的类型",
            "type": "string"
          },
          "variables": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Variable"
            },
            "backendName": "variables",
            "title": "服务变量",
            "type": "object"
          }
        },
        "title": "服务配置",
        "type": "object"
      },
      "ServiceInstance": {
        "description_en": "服务在具体环境中部署所产生的服务实例",
        "description_zh": "服务在具体环境中部署所产生的服务实例",
        "properties": {
          "config": {
            "$ref": "#/components/schemas/ServiceConfig",
            "backendName": "config",
            "title": "服务在当前环境中的配置信息"
          },
          "latestDeployment": {
            "backendName": "latestDeployment",
            "properties": {
              "finishedTime": {
                "backendName": "finishedTime",
                "title": "部署完成时间",
                "type": "string"
              },
              "name": {
                "backendName": "name",
                "title": "服务部署（ServiceDeployment）的名称",
                "type": "string"
              },
              "phase": {
                "backendName": "phase",
                "example": "Running",
                "title": "本次服务部署的状态，包括：Initializing：初始化中、Running: 部署中、Finished: 已部署、Failed: 部署失败、Canceled: 已取消、HangUp：已挂起",
                "type": "string"
              },
              "startTime": {
                "backendName": "startTime",
                "title": "部署开始时间，具体为状态从Initializing转换为Running的时刻的时间",
                "type": "string"
              }
            },
            "title": "最近一次服务部署的必要元数据信息",
            "type": "object"
          },
          "outputs": {
            "additionalProperties": {
              "type": "any"
            },
            "backendName": "outputs",
            "example": "{}",
            "title": "服务的输出，可以被引用",
            "type": "object"
          },
          "variables": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Variable"
            },
            "backendName": "variables",
            "title": "服务当前所使用的环境共享变量的快照，在服务每次成功部署时更新",
            "type": "object"
          }
        },
        "title": "A short description of struct",
        "type": "object"
      },
      "SourceConfig": {
        "description_en": "代码源配置",
        "description_zh": "代码源配置",
        "properties": {
          "oss": {
            "$ref": "#/components/schemas/OssSourceConfig",
            "backendName": "oss"
          },
          "repository": {
            "$ref": "#/components/schemas/RepositorySourceConfig",
            "backendName": "repository",
            "title": "仓库源码配置，描述了一个代码仓库中的一套源码"
          },
          "template": {
            "$ref": "#/components/schemas/TemplateSourceConfig",
            "backendName": "template",
            "title": "模板源码配置，描述Serverless Registry中一个模板代码仓库中的一套源代码"
          }
        },
        "title": "源代码配置，Dipper平台会使用该配置定位一套源代码并进行后续的构建和部署",
        "type": "object"
      },
      "TemplateSourceConfig": {
        "description_en": "模板源码配置，描述Serverless Registry中一个模板代码仓库中的一套源代码",
        "description_zh": "模板源码配置，描述Serverless Registry中一个模板代码仓库中的一套源代码",
        "properties": {
          "downloadUrl": {
            "backendName": "downloadUrl",
            "example": "https://api.devsapp.cn/v3/packages/start-modelscope-v3/zipball/0.1.6",
            "title": "Serverless Registry中模板下载地址",
            "type": "string"
          },
          "name": {
            "backendName": "name",
            "example": "start-springboot-cap",
            "title": "模板名称",
            "type": "string"
          }
        },
        "title": "模板源码配置，描述Serverless Registry中一个模板代码仓库中的一套源代码",
        "type": "object"
      },
      "Variable": {
        "description_en": "变量",
        "description_zh": "变量",
        "properties": {
          "encrypted": {
            "backendName": "encrypted",
            "description_zh": "变量是否被加密",
            "example": "false",
            "title": "变量是否被加密",
            "type": "boolean"
          },
          "sensitive": {
            "backendName": "sensitive",
            "description_zh": "变量是否敏感",
            "example": "false",
            "title": "变量是否敏感",
            "type": "boolean"
          },
          "value": {
            "backendName": "value",
            "description_zh": "变量的值",
            "example": "object_value",
            "title": "变量的值",
            "type": "any"
          }
        },
        "title": "变量",
        "type": "object"
      },
      "WebhookCodeContext": {
        "properties": {
          "branch": {
            "backendName": "branch",
            "example": "master",
            "title": "用于checkout的分支。Merge Request或Pull Request的最新的分支，或是推送的目标分支。",
            "type": "string"
          },
          "commitID": {
            "backendName": "commitID",
            "example": "b1dd9ba168dfef1cb3a1dd608b6054c771a93959",
            "title": "最新的提交的ID",
            "type": "string"
          },
          "description": {
            "backendName": "description",
            "example": "my PR decscription",
            "title": "Merge Request或Pull Request的描述",
            "type": "string"
          },
          "eventType": {
            "backendName": "eventType",
            "example": "PUSH",
            "title": "Git事件类型。推送类型事件为PUSH，Merge Request或Pull Request的事件为MR",
            "type": "string"
          },
          "message": {
            "backendName": "message",
            "example": "commit message",
            "title": "最新的提交的提交信息",
            "type": "string"
          },
          "prType": {
            "backendName": "prType",
            "example": "merged",
            "title": "Merge Request或Pull Request的类型。包括打开（opened）、关闭（closed）、合并（merged）、重新打开（reopened）、更新（updated）和无效（invalid）等类型。",
            "type": "string"
          },
          "repoUrl": {
            "backendName": "repoUrl",
            "example": "https://codeup.aliyun.com/my-namespace/my-repo.git",
            "title": "代码仓库的URL",
            "type": "string"
          },
          "sourceBranch": {
            "backendName": "sourceBranch",
            "example": "master",
            "title": "来源分支。Merge Request或Pull Request的来源分支，推送的来源分支",
            "type": "string"
          },
          "tag": {
            "backendName": "tag",
            "example": "release-0.0.1",
            "title": "推送的标签",
            "type": "string"
          },
          "targetBranch": {
            "backendName": "targetBranch",
            "example": "master",
            "title": "来源分支。Merge Request或Pull Request的目标分支，推送的目标分支",
            "type": "string"
          },
          "title": {
            "backendName": "title",
            "example": "# FIX",
            "title": "Merge Request或Pull Request的标题",
            "type": "string"
          }
        },
        "title": "git事件对应的上下文",
        "type": "object"
      }
    }
  },
  "deprecated": false,
  "description_en": "Triggers a manual environment deployment",
  "description_zh": "手动触发环境部署",
  "kebab_example": "aliyun devs deploy-environment --project-name demo-name --name demo-name --region cn-hangzhou",
  "method": "PATCH",
  "multi_version": false,
  "name": "DeployEnvironment",
  "operation": {
    "action": "DeployEnvironment",
    "api_style": "ROA",
    "api_version": "2023-07-14",
    "body_mapping": {
      "services": "services"
    },
    "content_type": "application/json",
    "method": "PATCH",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "update",
    "url": "/2023-07-14/projects/{projectName}/environments/{name}/deploy"
  },
  "parameters": [
    {
      "example": "demo-name",
      "help_en": "The project name",
      "help_zh": "所属项目名称",
      "location": "path",
      "name": "project_name",
      "options": [
        "--project-name"
