      "schema": {
        "description_en": "The response struct",
        "description_zh": "返回结构体",
        "properties": {
          "collectionPolicy": {
            "description_en": "The collection policy",
            "description_zh": "返回规则",
            "properties": {
              "centralizeConfig": {
                "description_en": "The centralized delivery configuration",
                "description_zh": "中心化转投配置",
                "properties": {
                  "destLogstore": {
                    "description_en": "The destination Logstore for centralized delivery",
                    "description_zh": "中心化转投目的日志库",
