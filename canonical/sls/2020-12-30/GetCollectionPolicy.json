                    "type": "string"
                  },
                  "destProject": {
                    "description_en": "The destination project for centralized delivery",
                    "description_zh": "中心化转投目的项目",
                    "example": "your-sls-project-in-beijing\n",
                    "type": "string"
                  },
                  "destRegion": {
                    "description_en": "The destination region for centralized delivery",
                    "description_zh": "中心化转投目的地域",
                    "example": "cn-beijing\n",
                    "type": "string"
                  },
                  "destTTL": {
                    "description_en": "The data retention period in days for centralized delivery",
                    "description_zh": "中心化转投目的天数",
                    "example": "0",
                    "format": "int32",
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              "centralizeEnabled": {
                "description_en": "Indicates whether centralized storage is enabled",
                "description_zh": "是否开启中心化存储",
                "example": "false",
                "type": "boolean"
              },
              "dataCode": {
                "description_en": "The log type code",
                "description_zh": "日志类型编码",
                "example": "access_log",
                "type": "string"
              },
              "dataConfig": {
                "description_en": "The configuration that is supported only when the log type is a global log type, such as when productCode is set to sls. Otherwise, this parameter is empty",
                "description_zh": "当且仅当日志类型为全局日志类型时支持的配置，例如productCode为sls时的场景。否则为空",
                "properties": {
                  "dataProject": {
                    "description_en": "This parameter is valid only when the log type is a global log type, such as when productCode is set to sls. If this parameter is empty, logs are collected to the default dedicated project of the account in the specified dataRegion",
                    "description_zh": "当且仅当日志类型为全局日志类型时有效，例如productCode为sls时的场景，如果为空，表示日志被采集到该账号在特定dataRegion下的默认专属的Project中",
                    "example": "\"\"",
                    "type": "string"
                  },
                  "dataRegion": {
                    "description_en": "The configuration that is supported only when the log type is a global log type, such as when productCode is set to sls. This parameter specifies the region to which global logs are collected during initial configuration",
                    "description_zh": "当且仅当日志类型为全局日志类型时支持的配置，例如productCode为sls时的场景，表示首次配置时全局日志将被采集到对应地域",
                    "example": "cn-beijing",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "enabled": {
                "description_en": "Indicates whether the policy is enabled",
                "description_zh": "是否开启",
                "example": "true\n",
                "type": "boolean"
              },
              "internalPolicy": {
                "description_en": "Indicates whether the policy is a built-in policy. Built-in policies cannot be modified or deleted",
                "description_zh": "是否是内置规则策略，内置规则不允许修改、删除",
                "example": "false",
                "type": "boolean"
              },
              "policyConfig": {
                "description_en": "The collection policy configuration",
                "description_zh": "采集规则配置",
                "properties": {
                  "instanceIds": {
                    "description_en": "The list of instance IDs",
                    "description_zh": "实例ID集合",
                    "items": {
                      "description_en": "The instance ID",
                      "description_zh": "实例ID",
                      "example": "your-test-bucket1\n",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "regions": {
                    "description_en": "The list of regions to which the instances belong. Wildcards are supported",
                    "description_zh": "实例所属的地域集合，支持通配符",
                    "items": {
                      "description_en": "The region ID",
                      "description_zh": "地域ID",
                      "example": "cn-hangzhou",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "resourceMode": {
                    "description_en": "The resource collection mode",
                    "description_zh": "资源采集模式",
                    "example": "all",
                    "type": "string"
                  },
                  "resourceTags": {
                    "description_en": "The resource tags",
                    "description_zh": "资源标签",
                    "example": "{\"tag1\":\"value1\",\"tag2\":\"value2\"}",
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "policyName": {
                "description_en": "The name of the policy",
                "description_zh": "规则名称",
                "example": "your_log_policy",
                "type": "string"
              },
              "policyUid": {
                "description_en": "The Alibaba Cloud account ID of the account to which the policy belongs. If the policy is created by a resource directory administrator or a resource directory delegated administrator, this parameter is set to the Alibaba Cloud account ID of that administrator",
                "description_zh": "规则所属的账号阿里云账号Uid，如果该规则由资源目录管理员或者资源目录委派管理员创建，则为其阿里云账号Uid",
                "example": "148***********50\n",
                "type": "string"
              },
              "productCode": {
                "description_en": "The product code",
                "description_zh": "产品编码",
                "example": "oss",
                "type": "string"
              },
              "resourceDirectory": {
                "description_en": "The resource directory configuration. This parameter is empty if no resource directory is configured",
                "description_zh": "资源目录配置, 如有配置，否则为空",
                "properties": {
                  "accountGroupType": {
                    "description_en": "The account group type in the resource directory. Valid values:\nall: all accounts.\ncustom: custom accounts",
                    "description_zh": "在该资源目录下，全选模式all或自定义模式custom",
                    "example": "all,custom",
                    "type": "string"
                  },
                  "members": {
                    "description_en": "The list of member accounts when the resource directory configuration is set to custom mode",
                    "description_zh": "当资源目录配置为custom模式时，对应的成员账号列表",
                    "items": {
                      "description_en": "The Alibaba Cloud account ID",
                      "description_zh": "阿里云账号Uid",
                      "example": "165***********50",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "title_en": "",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
