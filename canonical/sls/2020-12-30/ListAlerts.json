            "format": "int32",
            "required": false,
            "title": "定时类任务延迟执行（单位是秒：s）",
            "type": "integer"
          },
          "interval": {
            "description_en": "The fixed interval",
            "description_zh": "FixedRate情况下：固定间隔",
            "example": "60s",
            "required": false,
            "title": "FixedRate情况下：固定间隔",
            "type": "string"
          },
          "runImmediately": {
            "description_en": "Specifies whether to execute the scheduled task immediately",
            "description_zh": "定时任务是否立即执行",
            "example": "false",
            "required": false,
            "title": "定时任务是否立即执行",
            "type": "boolean"
          },
          "timeZone": {
            "description_en": "The time zone of the cron expression. If this parameter is left empty, the default time zone UTC+8 is used",
            "description_zh": "Cron表达式所在时区，默认为空，表示东八区",
