            "$ref": "#/components/schemas/AlertConfiguration",
            "description_en": "The configuration of the alert rule",
            "description_zh": "告警规则配置",
            "required": true,
            "title": "告警规则配置"
          },
          "createTime": {
            "description_en": "The time when the alert rule was created",
            "description_zh": "创建时间",
            "example": "1695090077",
            "format": "int64",
            "title": "创建时间",
            "type": "integer"
          },
          "description": {
            "description_en": "The description of the alert rule",
            "description_zh": "告警规则描述",
