            "description_en": "The time until which the alert is muted",
            "description_zh": "临时关闭时间",
            "example": "1698907508",
            "format": "int64",
            "title": "临时关闭时间",
            "type": "integer"
          },
          "noDataFire": {
            "description_en": "Specifies whether to enable no-data alerts",
            "description_zh": "是否开启无数据告警",
