      },
      "Schedule": {
        "description_en": "The schedule structure",
        "description_zh": "调度结构",
        "properties": {
          "cronExpression": {
            "description_en": "The cron expression",
            "description_zh": "Cron情况下：cron表达式",
            "example": "0/5 * * * *",
            "required": false,
            "title": "Cron情况下：cron表达式",
            "type": "string"
          },
          "delay": {
            "description_en": "The delay before a scheduled task is executed, in seconds (s)",
