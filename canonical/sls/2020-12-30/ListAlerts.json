            "required": true,
            "title": "是否开启无数据告警",
            "type": "boolean"
          },
          "noDataSeverity": {
            "description_en": "The severity of no-data alerts",
            "description_zh": "无数据告警严重度",
            "example": "6",
            "format": "int32",
            "title": "无数据告警严重度",
            "type": "integer"
          },
          "policyConfiguration": {
            "$ref": "#/components/schemas/PolicyConfiguration",
