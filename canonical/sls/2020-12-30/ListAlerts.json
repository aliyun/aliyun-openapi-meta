            "description_zh": "发送给SLS告警管理服务配置",
            "required": false,
            "title": "发送给SLS告警管理服务配置"
          },
          "sinkCms": {
            "$ref": "#/components/schemas/SinkCmsConfiguration",
            "description_en": "The configuration for sending alerts to Cloud Monitor",
            "description_zh": "发送给云监控配置",
            "title": "发送给云监控配置"
          },
          "sinkEventStore": {
            "$ref": "#/components/schemas/SinkEventStoreConfiguration",
            "description_en": "The configuration for sending alerts to the eventstore",
            "description_zh": "发送给EventStore配置",
            "title": "发送给EventStore配置"
