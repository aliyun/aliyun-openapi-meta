            "title": "满足评估表达式的结果条数",
            "type": "string"
          }
        },
        "title": "触发条件配置",
        "type": "object"
      },
      "GroupConfiguration": {
        "description_en": "The configuration for alert group evaluation",
        "description_zh": "告警分组评估配置",
        "properties": {
          "fields": {
            "description_en": "The group evaluation fields",
            "description_zh": "分组评估字段",
            "items": {
              "description_en": "",
              "description_zh": "",
              "example": "id",
              "type": "string"
            },
            "title": "分组评估字段",
            "type": "array"
          },
          "type": {
            "description_en": "The group evaluation type",
            "description_zh": "分组评估类型",
            "example": "custom",
            "required": true,
            "title": "分组评估类型",
            "type": "string"
          }
        },
        "title": "告警分组评估配置.",
        "type": "object"
      },
      "JoinConfiguration": {
        "description_en": "The set operation configurations for the alert rule",
        "description_zh": "告警集合操作配置",
        "properties": {
          "condition": {
            "description_en": "The condition of the set operation",
            "description_zh": "集合操作条件",
            "example": "$0.id == $1.id",
            "title": "集合操作条件",
            "type": "string"
          },
          "type": {
            "description_en": "The type of the set operation",
            "description_zh": "集合操作类型",
            "example": "left_join",
            "title": "集合操作类型",
            "type": "string"
          }
        },
        "title": "告警集合操作配置",
