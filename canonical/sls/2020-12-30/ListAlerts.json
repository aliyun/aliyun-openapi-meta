          "type": {
            "description_en": "The type of the alert rule",
            "description_zh": "告警规则类型",
            "example": "default",
            "title": "告警规则类型",
            "type": "string"
          },
          "version": {
            "default": "2.0",
            "description_en": "The version",
            "description_zh": "版本",
            "example": "2.0",
            "required": true,
            "title": "版本",
            "type": "string"
          }
        },
        "title": "告警规则配置",
        "type": "object"
      },
      "AlertQuery": {
