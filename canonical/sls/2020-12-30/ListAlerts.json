            "title": "Cron表达式所在时区，默认为空，表示东八区",
            "type": "string"
          },
          "type": {
            "description_en": "schedule type",
            "description_zh": "定时类型：FixedRate/Cron",
            "enum": [
              "FixedRate",
              "Cron"
            ],
            "example": "FixedRate",
            "required": true,
            "title": "定时类型：FixedRate/Cron",
            "type": "string"
          }
        },
        "required": false,
        "title": "job schedule",
        "type": "object"
      },
