            "required": true,
            "title": "store名称",
            "type": "string"
          },
          "storeType": {
            "description_en": "Store type",
            "description_zh": "store类型",
            "example": "log",
            "required": true,
            "title": "store类型",
            "type": "string"
          },
          "timeSpanType": {
            "description_en": "Time span type",
            "description_zh": "时间片类型",
            "example": "Relative",
            "required": true,
            "title": "时间片类型",
            "type": "string"
          },
          "ui": {
            "description_en": "Used by the frontend for specific-scenario alerts",
            "description_zh": "特定场景告警前端使用",
            "title": "特定场景告警前端使用",
            "type": "string"
          }
        },
        "title": "告警查询分析配置",
        "type": "object"
      },
      "AlertTag": {
        "description_en": "The alert tag",
        "description_zh": "alert tag",
        "properties": {
          "key": {
            "description_en": "The key name",
            "description_zh": "键名",
            "example": "title",
            "title": "键名",
            "type": "string"
          },
          "value": {
            "description_en": "The key value",
            "description_zh": "值",
            "example": "example value",
            "title": "值",
            "type": "string"
          }
        },
        "title": "alertTag",
        "type": "object"
      },
