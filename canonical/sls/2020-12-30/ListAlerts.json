            "description_zh": "SLS告警通知服务配置",
            "title": "SLS告警通知服务配置"
          },
          "queryList": {
            "description_en": "The list of query statements",
            "description_zh": "查询语句列表",
            "items": {
              "$ref": "#/components/schemas/AlertQuery",
              "description_en": "The query statement",
              "description_zh": "查询语句列表"
            },
            "required": true,
            "title": "查询语句列表",
            "type": "array"
          },
          "sendResolved": {
            "description_en": "Specifies whether to send recovery alerts",
            "description_zh": "是否发送恢复告警",
            "example": "false",
            "required": true,
            "title": "是否发送恢复告警",
            "type": "boolean"
          },
          "severityConfigurations": {
            "description_en": "The alert severity configurations",
            "description_zh": "告警严重度配置",
            "items": {
              "$ref": "#/components/schemas/SeverityConfiguration",
              "description_en": "The alert severity configuration",
              "description_zh": "告警严重度配置"
            },
            "required": true,
            "title": "告警严重度配置",
            "type": "array"
          },
          "sinkAlerthub": {
            "$ref": "#/components/schemas/SinkAlerthubConfiguration",
