                "type": "string"
              },
              "JobId": {
                "backendName": "jobId",
                "description_en": "The task ID",
                "description_zh": "任务ID",
                "example": "fdc7f121056249c2b64e04bba27bcc8c",
                "type": "string"
              },
              "JobParameters": {
                "backendName": "jobParameters",
                "description_en": "The task feature configuration. No configuration is required at this time",
                "description_zh": "任务功能配置，暂不需要设置",
                "example": "{}",
                "type": "string"
              },
              "JobType": {
                "backendName": "jobType",
                "description_en": "The task type",
                "description_zh": "任务类型",
                "example": "first_last_frame",
                "type": "string"
              },
              "Model": {
                "backendName": "model",
                "description_en": "The model name",
                "description_zh": "模型名称",
                "example": "happyhorse-1.1",
                "type": "string"
              },
              "N": {
                "backendName": "n",
                "description_en": "The number of generated videos",
                "description_zh": "生成数量",
                "example": "1",
                "format": "int32",
                "type": "integer"
              },
              "Output": {
                "backendName": "output",
                "description_en": "The generation result. The value is a JSON string that contains the following fields:\n\nMedias: a list of media information (Media objects). A Media object contains the following fields:\nMediaId: String. The media asset ID.\nOutputUrl: String. The media URL (with an authentication string)",
                "description_zh": "生成结果，JsonString 类型，包含：\n\nMedias，媒体信息（Media 对象）列表，Media 对象字段：\nMediaId，String，媒资 ID；\nOutputUrl，String，媒体地址（含鉴权串）；",
                "example": "{\\\"Medias\\\":[{\\\"MediaId\\\":\\\"*****470732171f1bfcaf7f6d44*****\\\",\\\"OutputUrl\\\":\\\"https://xxxxxxx/.../xxxxx.mp4?Expires=xxxx&OSSAccessKeyId=xxx&Signature=xxxx\\\"}]}",
                "type": "string"
              },
              "Resolution": {
                "backendName": "resolution",
                "description_en": "The resolution",
                "description_zh": "分辨率",
                "example": "720P",
                "type": "string"
              },
              "Scene": {
                "backendName": "scene",
                "description_en": "The scene type. Currently, only general is supported",
                "description_zh": "场景类型，目前仅有 general",
                "example": "general",
                "type": "string"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The task status. Valid values:\nCreated: The task is created.\nQueuing: The task is queuing.\nExecuting: The task is being executed.\nFinished: The task is completed.\nFailed: The task failed",
                "description_zh": "任务状态，枚举类型，包含：\nCreated：任务已创建\nQueuing：任务排队中\nExecuting：任务执行中\nFinished：任务运行成功\nFailed：任务运行失败",
                "example": "Executing",
                "type": "string"
              },
              "UserData": {
                "backendName": "userData",
                "description_en": "The user business information",
                "description_zh": "用户业务信息",
                "example": "{}",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
