      "schema": {
        "description_en": "Schema of Response",
        "description_zh": "Schema of Response",
        "properties": {
          "RequestId": {
            "backendName": "requestId",
            "description_en": "Id of the request",
            "description_zh": "Id of the request",
            "example": "****63E8B7C7-4812-46AD-0FA56029AC86****",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "VideoGenerationJob": {
            "backendName": "data.aiGenerationJob",
            "description_en": "The video generation task",
            "description_zh": "视频生成任务",
