{
  "cmd_full_name": "yike get-yike-agent-job",
  "cmd_name": "get-yike-agent-job",
  "deprecated": false,
  "description_en": "Queries an intelligent agent task",
  "description_zh": "查询一刻智能体任务",
  "kebab_example": "aliyun yike get-yike-agent-job --job-id ab4802364a2e49208c99efab82df0000 --api-version 2026-03-19 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetYikeAgentJob",
  "operation": {
    "action": "GetYikeAgentJob",
    "api_style": "RPC",
    "api_version": "2026-03-19",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "ab4802364a2e49208c99efab82df****",
      "help_en": "The task ID",
      "help_zh": "任务 ID",
      "location": "formData",
      "name": "job_id",
      "options": [
        "--job-id"
      ],
      "raw_name": "JobId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "Yike",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "CreateTime": {
            "backendName": "data.createTime",
            "description_en": "The time when the task started, in the yyyy-mm-ddTHH:mm:ssZ format (UTC)",
            "description_zh": "任务开始时间，格式为：yyyy-mm-ddTHH:mm:ssZ（UTC 时间）",
            "example": "2026-02-06T18:53:34.001+08:00",
            "type": "string"
          },
          "ErrorCode": {
            "backendName": "data.errorCode",
            "description_en": "The error code. This parameter is returned only when the task is in the Failed state",
            "description_zh": "错误码，Failed状态下返回",
            "example": "WorkflowTaskFailed",
            "type": "string"
          },
          "FinishTime": {
            "backendName": "data.finishTime",
            "description_en": "The time when the task ended, in the yyyy-mm-ddTHH:mm:ssZ format (UTC)",
            "description_zh": "任务结束时间，格式为：yyyy-mm-ddTHH:mm:ssZ（UTC 时间）",
            "example": "2026-02-06T18:53:34.001+08:00",
            "type": "string"
          },
          "JobId": {
            "backendName": "data.jobId",
            "description_en": "The task ID",
            "description_zh": "任务ID",
            "example": "ab4802364a2e49208c99efab82df****",
            "type": "string"
          },
          "JobParams": {
            "backendName": "data.jobParams",
            "description_en": "The input parameters of the task, in JSON string format",
            "description_zh": "任务输入参数，Json String",
            "example": "{\\\"TextType\\\":2,\\\"TextContent\\\":\\\"Today, Beijing held a press conference to announce plans to further optimize the city's transportation network, including adding three new subway lines within the next three years....\\\",\\\"AspectRatio\\\":\\\"16:9\\\", \\\"Resolution\\\":\\\"720P\\\", \\\"OutputLanguages\\\":[\\\"CN\\\",\\\"YUE\\\"]\"}",
            "type": "string"
          },
          "JobResult": {
            "backendName": "data.jobResult",
            "description_en": "The task results. This parameter is valid only when the task is in the Succeeded state",
            "description_zh": "多个任务结果，仅Succeeded状态时有效",
            "itemName": "result",
            "items": {
              "description_en": "A single task result",
              "description_zh": "单个任务结果",
              "properties": {
                "EditingProjectId": {
                  "backendName": "editingProjectId",
                  "description_en": "The online editing project ID",
                  "description_zh": "在线剪辑工程 ID",
                  "example": "01a6adbbd181437eb5030d3d93e0182d",
                  "type": "string"
                },
                "MediaId": {
                  "backendName": "mediaId",
                  "description_en": "The asset ID",
                  "description_zh": "资产ID",
                  "example": "9d7e982012c671f1b803e7f6d75a6302",
                  "type": "string"
                },
                "OutputLanguage": {
                  "backendName": "outputLanguage",
                  "description_en": "The output language",
                  "description_zh": "输出语种",
                  "example": "CN",
                  "type": "string"
                },
                "OutputUrl": {
                  "backendName": "outputUrl",
                  "description_en": "The download URL",
                  "description_zh": "下载 URL",
                  "example": "https://test.oss-cn-shanghai.aliyuncs.com/videos/task_abc123def456.mp4",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "JobStatus": {
            "backendName": "data.jobStatus",
            "description_en": "The task status. Valid values:\n\nRunning\nSucceeded\nFailed",
            "description_zh": "任务状态：Running、Succeeded、Failed",
            "example": "Running",
            "type": "string"
          },
          "JobType": {
            "backendName": "data.jobType",
            "description_en": "The agent task type. Valid values:\n\nVoiceNarrator: narration video without a digital human.\nAvatarNarrator: narration video with a digital human.\nVideoClone: video cloning",
            "description_zh": "Agent任务类型\nVoiceNarrator：无数字人口播视频\nAvatarNarrator：带数字人口播视频\nVideoClone：视频复刻",
            "example": "VoiceNarrator",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "******11-DB8D-4A9A-875B-275798******\n",
            "type": "string"
          },
          "UserData": {
            "backendName": "data.userData",
            "description_en": "The custom user data that was passed in when the task was created. The value is returned as-is",
            "description_zh": "创建任务时传入的用户自定义参数（原样返回）",
            "example": "{\\\"newsKey\\\":\\\"NEWS_20260420_001\\\",\\\"key1\\\":\\\"value1\\\", \\\"NotifyAddress\\\":\\\"https://cms.example.com/callback/video-task\\\"}",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
