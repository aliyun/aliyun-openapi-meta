                          "MediaId": {
                            "backendName": "mediaId",
                            "description_en": "The media asset ID",
                            "description_zh": "媒资ID",
                            "example": "ec2de25068fd71f0a48cf7e6c4596302\n",
                            "type": "string"
                          },
                          "OutputUrl": {
                            "backendName": "outputUrl",
                            "description_en": "The output file URL",
                            "description_zh": "输出文件地址",
                            "example": "https://dtlive-bj.oss-cn-beijing.aliyuncs.com/cover/01e1271d-ff4f-4689-9c20-e1df81486859_open_live_cover.mp4",
