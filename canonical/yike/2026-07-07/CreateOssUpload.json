{
  "camel_example": "aliyun yike CreateOssUpload --region cn-hangzhou --FileExt mp4 --version 2026-07-07 --method POST --force",
  "cmd_full_name": "yike create-oss-upload",
  "cmd_name": "create-oss-upload",
  "deprecated": false,
  "description_en": "Generates OSS upload credentials for client-side direct upload without registering media assets or creating media asset records",
