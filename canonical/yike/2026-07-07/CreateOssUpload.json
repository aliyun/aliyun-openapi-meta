    {
      "example": "{\"ProductionId\": \"pd_***\", \"FolderId\": \"fd_***\"}",
      "help_en": "The business configuration JSON, which includes ProductionId and FolderId",
      "help_zh": "业务配置 JSON， 包含ProductionId / FolderId",
      "location": "query",
      "name": "biz_config",
      "options": [
        "--biz-config"
      ],
      "raw_name": "BizConfig",
      "required": false,
      "type": "string"
    }
