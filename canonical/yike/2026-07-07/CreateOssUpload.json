  "kebab_example": "aliyun yike create-oss-upload --file-ext mp4 --api-version 2026-07-07 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "CreateOssUpload",
  "operation": {
    "action": "CreateOssUpload",
    "api_style": "RPC",
    "api_version": "2026-07-07",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "example": "test-bucket",
      "help_en": "The explicitly specified target bucket",
      "help_zh": "显式指定的目标 Bucket",
      "location": "query",
      "name": "target_bucket",
      "options": [
        "--target-bucket"
      ],
      "raw_name": "TargetBucket",
      "required": false,
      "type": "string"
    },
    {
      "example": "mp4",
      "help_en": "The file name extension, such as mp4, wav, or png. Do not include the dot. If this parameter is missing, `MissingParameter` is returned",
      "help_zh": "文件扩展名，如 mp4、wav、png，不带点。缺失返回 `MissingParameter`",
      "location": "query",
      "name": "file_ext",
      "options": [
        "--file-ext"
      ],
      "raw_name": "FileExt",
      "required": true,
      "type": "string"
    },
    {
      "example": "Media",
      "help_en": "The file type. Valid values: `Media` (default), `StoryboardInput`, `ImageFusion`, `AIAppParams`, `Workflow`, and `CommonFile`. If an invalid value is specified, `InvalidParameter` is returned. This value is used as a path segment in the `ObjectKey` and is converted to lowercase",
      "help_zh": "文件类型，可选值 `Media`（默认）、`StoryboardInput`、`ImageFusion`、`AIAppParams`、`Workflow`、`CommonFile`；非法值返回 `InvalidParameter`。会作为 `ObjectKey` 中的路径段（转小写）",
      "location": "query",
      "name": "file_type",
      "options": [
        "--file-type"
      ],
      "raw_name": "FileType",
      "required": false,
      "type": "string"
    },
    {
      "example": "STS",
