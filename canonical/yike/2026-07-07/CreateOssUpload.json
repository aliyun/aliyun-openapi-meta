                "title_zh": "签名所用AccessKeyId（POST_POLICY时返回）",
                "type": "string"
              },
              "PostEndpoint": {
                "backendName": "postEndpoint",
                "description_en": "The target endpoint for the POST request. This is returned when POST_POLICY is used",
                "description_zh": "Post请求目标endpoint（POST_POLICY时返回）",
                "example": "-",
                "title_en": "Post请求目标endpoint（POST_POLICY时返回）",
                "title_zh": "Post请求目标endpoint（POST_POLICY时返回）",
                "type": "string"
              },
              "Region": {
                "backendName": "region",
