                "title_en": "PostObject Policy，Base64编码（POST_POLICY时返回）",
                "title_zh": "PostObject Policy，Base64编码（POST_POLICY时返回）",
                "type": "string"
              },
              "PostAccessKeyId": {
                "backendName": "postAccessKeyId",
                "description_en": "The AccessKey ID used for the signature. This is returned when POST_POLICY is used",
                "description_zh": "签名所用AccessKeyId（POST_POLICY时返回）",
                "example": "-",
