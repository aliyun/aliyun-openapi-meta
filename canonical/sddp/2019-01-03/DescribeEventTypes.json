  "responses": {
    "200": {
      "schema": {
        "properties": {
          "EventTypeList": {
            "backendName": "content",
            "description_en": "The list of anomalous activity types.\n\nIf ParentTypeId is empty, the parent anomalous activity types are returned. If ParentTypeId is not empty, the child anomalous activity types are returned",
