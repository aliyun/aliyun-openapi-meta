            "itemName": "EventType",
            "items": {
              "description_en": "The details of the anomalous activity type",
              "description_zh": "异常事件类型详情",
              "properties": {
                "Code": {
                  "backendName": "code",
                  "description_en": "The code of the parent anomalous activity type",
                  "description_zh": "父类型异常事件编码",
                  "example": "01",
                  "type": "string"
                },
                "Description": {
                  "backendName": "description",
                  "description_en": "The description of the parent anomalous activity type",
                  "description_zh": "父类型异常事件描述信息",
                  "example": "Permission usage anomaly, ****",
                  "type": "string"
                },
                "Id": {
                  "backendName": "id",
                  "description_en": "The unique ID of the parent anomalous activity type",
                  "description_zh": "父类型异常事件的唯一标识ID",
                  "example": "1",
                  "format": "int64",
                  "type": "integer"
                },
                "Name": {
                  "backendName": "name",
