                  "backendName": "subTypeList",
                  "description_en": "The list of child anomalous activity types",
                  "description_zh": "子类型异常事件列表",
                  "itemName": "SubType",
                  "items": {
                    "description_en": "The details of the child anomalous activity type",
                    "description_zh": "子类型异常事件详情",
                    "properties": {
                      "AdaptedProduct": {
                        "backendName": "adaptedProduct",
                        "description_en": "The products to which the rule applies, including MaxCompute, OSS, AnalyticDB for MySQL, Tablestore, and ApsaraDB RDS",
                        "description_zh": "规则适用产品。取值：MaxCompute、OSS、ADS、OTS、RDS等",
                        "example": "RDS",
                        "type": "string"
                      },
                      "Code": {
                        "backendName": "code",
                        "description_en": "The code of the child anomalous activity type",
                        "description_zh": "子类型异常事件编码",
                        "example": "020008",
                        "type": "string"
                      },
                      "ConfigCode": {
                        "backendName": "configCode",
                        "description_en": "The configuration code",
                        "description_zh": "配置编码",
                        "example": "0100**",
                        "type": "string"
                      },
                      "ConfigContentType": {
                        "backendName": "configContentType",
                        "description_en": "The format of the rule item. Valid values:\n\n0: numeric (such as a threshold).\n\n1: text (such as an IP address)",
                        "description_zh": "规则项内容格式。取值：\n0：数字类（阈值等）。\n1：文本类（IP等）",
                        "example": "1",
                        "format": "int32",
                        "type": "integer"
                      },
                      "ConfigDescription": {
                        "backendName": "configDescription",
                        "description_en": "The configuration description",
                        "description_zh": "配置描述",
                        "example": "Permission idle period exceeds threshold: current threshold is defined as 7 natural days\n\n\n",
                        "type": "string"
                      },
                      "ConfigValue": {
                        "backendName": "configValue",
                        "description_en": "The configuration value",
                        "description_zh": "配置值",
                        "example": "90",
                        "type": "string"
                      },
                      "Description": {
                        "backendName": "description",
                        "description_en": "The description of the child anomalous activity type",
                        "description_zh": "子类型异常事件描述信息",
                        "example": "Configuration error - MaxCompute sensitive project not protected，****",
                        "type": "string"
                      },
                      "EventHitCount": {
                        "backendName": "eventHitCount",
                        "description_en": "The number of times the rule is hit",
                        "description_zh": "事件命中次数",
                        "example": "2",
                        "format": "int32",
                        "type": "integer"
                      },
                      "Id": {
                        "backendName": "id",
                        "description_en": "The unique ID of the child anomalous activity type",
                        "description_zh": "子类型异常事件唯一标识ID",
                        "example": "1",
                        "format": "int64",
                        "type": "integer"
                      },
                      "Name": {
                        "backendName": "name",
                        "description_en": "The name of the child anomalous activity type",
                        "description_zh": "子类型异常事件名称",
                        "example": "Configuration error - MaxCompute sensitive project not protected",
                        "type": "string"
                      },
                      "Status": {
                        "backendName": "status",
                        "description_en": "The detection feature of Data Security Center (DSC) for the child anomalous activity type. Valid values:\n\n1: enabled.\n\n0: disabled",
                        "description_zh": "DSC对子类型异常事件的检测功能。取值：\n1：开启。\n0：关闭",
                        "example": "1",
                        "format": "int32",
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "nullToEmpty": true,
                  "type": "array"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "结果的请求ID",
            "example": "769FB3C1-F4C9-42DF-9B72-7077A8989C13",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
