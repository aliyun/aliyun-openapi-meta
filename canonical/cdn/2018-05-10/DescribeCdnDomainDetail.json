                "nullToEmpty": true,
                "type": "array"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "18CF38AA-1275-451D-A12B-4EC0BF1C5E30",
            "type": "string"
