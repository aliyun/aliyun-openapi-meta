                    "Priority": {
                      "backendName": "priority",
                      "type": "string"
                    },
                    "Type": {
                      "backendName": "type",
                      "type": "string"
                    },
                    "Weight": {
                      "backendName": "weight",
                      "type": "string"
                    }
                  },
                  "type": "object"
