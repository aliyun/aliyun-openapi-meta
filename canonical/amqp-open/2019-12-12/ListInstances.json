  "kebab_example": "aliyun amqp-open list-instances --max-results 1 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListInstances",
  "operation": {
    "action": "ListInstances",
    "api_style": "RPC",
    "api_version": "2019-12-12",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
