  "kebab_example": "aliyun composer get-version --flow-id lc-uf6axpwfcw4ubx --version-id ve-uf6bwdtvid7o25 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetVersion",
  "operation": {
    "action": "GetVersion",
    "api_style": "RPC",
    "api_version": "2018-12-12",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "lc-uf6axpwfcw4ubx",
      "help_en": "The workflow ID",
      "help_zh": "工作流ID",
      "location": "formData",
      "name": "flow_id",
      "options": [
        "--flow-id"
      ],
      "raw_name": "FlowId",
      "required": true,
      "type": "string"
    },
    {
      "example": "ve-uf6bwdtvid7o25",
      "help_en": "The version ID",
      "help_zh": "版本ID",
      "location": "formData",
      "name": "version_id",
      "options": [
        "--version-id"
      ],
      "raw_name": "VersionId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "composer",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "CreateTime": {
            "backendName": "CreateTime",
            "description_en": "The creation time of the version",
            "description_zh": "版本创建时间",
            "example": "2018-12-12T07:36:22.992Z",
            "type": "string",
            "visibility": "Public"
          },
          "Definition": {
            "backendName": "Definition",
            "description_en": "The workflow definition corresponding to the current version",
            "description_zh": "当前版本对应的工作流定义",
            "example": "{\\\"schemaVersion\\\":\\\"2018-12-12\\\",\\\"actions\\\":{},\\\"version\\\":\\\"1.0.0\\\",\\\"triggers\\\":{}}",
            "type": "string",
            "visibility": "Public"
          },
          "FlowId": {
            "backendName": "FlowId",
            "description_en": "The workflow ID to which the version belongs",
            "description_zh": "该版本所属工作流ID",
            "example": "lc-uf6wvbsyvvl5sy",
            "type": "string",
            "visibility": "Public"
          },
          "RegionId": {
            "backendName": "RegionId",
            "description_en": "The region to which the current workflow belongs",
            "description_zh": "当前工作流所属地域",
            "example": "cn-shanghai",
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "ADB97A33-50E7-48A5-963D-ACBAE36D0BEC",
            "type": "string",
            "visibility": "Public"
          },
          "UpdateTime": {
            "backendName": "UpdateTime",
            "description_en": "The last update time of the version",
            "description_zh": "版本最后更新时间",
            "example": "2018-12-12T07:36:22.992Z",
            "type": "string",
            "visibility": "Public"
          },
          "VersionDescription": {
            "backendName": "VersionDescription",
            "description_en": "The version description",
            "description_zh": "版本描述",
            "example": "这是版本描述",
            "type": "string",
            "visibility": "Public"
          },
          "VersionId": {
            "backendName": "VersionId",
            "description_en": "The version ID",
            "description_zh": "版本ID",
            "example": "ve-uf6bwdtvid7o25",
            "type": "string",
            "visibility": "Public"
          },
          "VersionName": {
            "backendName": "VersionName",
            "description_en": "The version name",
            "description_zh": "版本名称",
            "example": "5.3.6",
            "type": "string",
            "visibility": "Public"
          },
          "VersionStatus": {
            "backendName": "VersionStatus",
            "description_en": "The version status. Enabled indicates that the version is enabled",
            "description_zh": "版本状态，Enabled表示启用中",
            "example": "Enabled",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
