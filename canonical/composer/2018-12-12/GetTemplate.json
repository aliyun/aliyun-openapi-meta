            "type": "string",
            "visibility": "Public"
          },
          "TemplateDescription": {
            "backendName": "TemplateDescription",
            "description_en": "The description of the template",
            "description_zh": "模板的描述",
            "example": "该模板仅用于测试用途",
            "type": "string",
            "visibility": "Public"
          },
          "TemplateId": {
            "backendName": "TemplateId",
            "description_en": "The template ID",
            "description_zh": "模板 ID",
            "example": "tp-uf6tbvhheciyxl",
            "type": "string",
            "visibility": "Public"
          },
          "TemplateLocale": {
            "backendName": "TemplateLocale",
            "description_en": "The language of the template. Currently, Chinese (zh) and English (en) are supported",
