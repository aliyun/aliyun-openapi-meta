      "help_zh": "模板 ID",
      "location": "formData",
      "name": "template_id",
      "options": [
        "--template-id"
      ],
      "raw_name": "TemplateId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
