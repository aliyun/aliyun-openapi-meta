            "type": "string",
            "visibility": "Public"
          },
          "TemplateTag": {
            "backendName": "TemplateTag",
            "description_en": "The tag of the template",
            "description_zh": "模板标签",
            "example": "test,owner",
            "type": "string",
            "visibility": "Public"
          },
          "TemplateVersion": {
            "backendName": "TemplateVersion",
            "description_en": "The version of the template. The value is a number that increments from 0",
            "description_zh": "模板版本，为从 0 递增的数字",
            "example": "0",
            "format": "int32",
            "type": "integer",
            "visibility": "Public"
          },
          "UpdateTime": {
            "backendName": "UpdateTime",
            "description_en": "The time when the template was last updated",
            "description_zh": "模板最后更新时间",
            "example": "2020-08-19T03:31:32.415Z",
            "type": "string",
            "visibility": "Public"
          }
