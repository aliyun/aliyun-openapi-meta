                  "description_en": "The detailed structure of the private network information",
                  "description_zh": "私网信息具体结构",
                  "properties": {
                    "domain": {
                      "description_en": "The domain name information",
                      "description_zh": "域名信息",
                      "example": "test-123.private.cn-hangzhou.es-serverless.aliyuncs.com",
                      "type": "string"
                    },
                    "enabled": {
                      "description_en": "Indicates whether private network access is enabled",
                      "description_zh": "是否开启私网访问",
                      "example": "true",
                      "type": "boolean"
                    },
                    "port": {
                      "description_en": "The port number",
                      "description_zh": "端口号",
                      "example": "9200",
                      "format": "int32",
                      "type": "integer"
                    },
                    "pvlEndpointId": {
                      "description_en": "The endpoint information",
                      "description_zh": "终端节点信息",
                      "example": "ep-aaaddd**",
                      "type": "string"
                    },
                    "type": {
                      "description_en": "The type of the IP address whitelist. Valid values:\n\nPRIVATE_KIBANA: Kibana private network access whitelist\nPRIVATE_ES: Elasticsearch private network access whitelist",
                      "description_zh": "IP白名单的类型\n\nPRIVATE_KIBANA：Kibana私网访问白名单\nPRIVATE_ES：Elasticsearch私网访问白名单",
                      "example": "PRIVATE_ES",
                      "type": "string"
                    },
                    "vpcId": {
                      "description_en": "The VPC ID",
                      "description_zh": "VPC ID",
                      "example": "vpc-bp16ul4pwsg1mjni***",
                      "type": "string"
                    },
                    "whiteIpGroup": {
                      "description_en": "The whitelist",
                      "description_zh": "白名单列表",
                      "itemName": "whiteIpGroup",
                      "items": {
                        "description_en": "The detailed structure of the whitelist",
                        "description_zh": "白名单具体结构",
                        "properties": {
                          "groupName": {
                            "description_en": "The name of the whitelist group",
                            "description_zh": "白名单组的组名",
                            "example": "test",
                            "type": "string"
                          },
                          "ips": {
                            "description_en": "The list of IP addresses in the whitelist group",
                            "description_zh": "白名单组中的IP地址列表",
                            "itemName": "ips",
                            "items": {
                              "description_en": "The specific IP address or CIDR block",
                              "description_zh": "具体IP或IP段",
                              "example": "127.0.0.1",
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "regionId": {
                "description_en": "The region where the application resides",
                "description_zh": "应用所在地域",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "scenario": {
                "description_zh": "应用场景",
                "example": "GENERAL",
                "type": "string"
              },
              "status": {
                "description_en": "The status of the application. Valid values:\n\nACTIVE: Normal.\nINIT: Creating.\nINACTIVE: Frozen",
                "description_zh": "应用状态：\n\nACTIVE：正常\nINIT：创建中\nINACTIVE：冻结",
                "example": "ACTIVE",
                "type": "string"
              },
              "tags": {
                "itemName": "tags",
                "items": {
                  "properties": {
                    "key": {
                      "description_zh": "应用标签的键",
                      "example": "B2",
