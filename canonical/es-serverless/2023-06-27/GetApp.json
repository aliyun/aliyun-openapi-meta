{
  "camel_example": "",
  "cmd_full_name": "es-serverless get-app",
  "cmd_name": "get-app",
  "deprecated": false,
  "description_en": "Call the GetApp operation to retrieve details about an Elasticsearch Serverless application",
  "description_zh": "调用GetApp接口，获取Elasticsearch Serverless应用的详情信息",
  "kebab_example": "aliyun es-serverless get-app --app-name test --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetApp",
  "operation": {
    "action": "GetApp",
    "api_style": "ROA",
    "api_version": "2023-06-27",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/openapi/es-serverless/instances/{appName}"
  },
  "parameters": [
    {
      "example": "test",
      "help_en": "Application name. Call https://help.aliyun.com/document_detail/2539816.html to get the application name",
