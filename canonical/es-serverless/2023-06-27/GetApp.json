                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "version": {
                "description_en": "The edition",
                "description_zh": "产品版本",
                "example": "7.10",
                "type": "string"
              }
            },
            "type": "object"
          }
