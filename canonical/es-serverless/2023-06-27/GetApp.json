      "name": "app_name",
      "options": [
        "--app-name"
      ],
      "raw_name": "appName",
      "required": true,
      "type": "string"
    },
    {
      "example": "false",
      "help_en": "Specifies whether to retrieve detailed information. Valid values:\nfalse (default): No.\ntrue: Yes",
      "help_zh": "是否获取详细信息。取值如下：\nfalse（默认）：不获取\ntrue：获取",
      "location": "query",
      "name": "detailed",
      "options": [
        "--detailed"
      ],
      "raw_name": "detailed",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "/openapi/es-serverless/instances/[appName]",
  "product_code": "es-serverless",
  "protocol": "HTTP|HTTPS",
