                      "example": "vpc-bp16ul4pwsg1mjni***",
                      "type": "string"
                    },
                    "whiteIpGroup": {
                      "description_en": "IP address whitelist groups",
                      "description_zh": "白名单列表",
                      "itemName": "whiteIpGroup",
                      "items": {
                        "description_en": "Structure of an IP address whitelist group",
                        "description_zh": "白名单具体结构",
                        "properties": {
                          "groupName": {
                            "description_en": "Name of the IP address whitelist group",
                            "description_zh": "白名单组的组名",
                            "example": "test",
                            "type": "string"
                          },
                          "ips": {
                            "description_en": "List of IP addresses or CIDR blocks in the whitelist group",
                            "description_zh": "白名单组中的IP地址列表",
                            "itemName": "ips",
                            "items": {
                              "description_en": "An individual IP address or CIDR block",
                              "description_zh": "具体IP或IP段",
                              "example": "127.0.0.1",
                              "type": "string"
