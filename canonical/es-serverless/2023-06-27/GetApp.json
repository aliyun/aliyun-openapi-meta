{
  "camel_example": "aliyun es-serverless GET /openapi/es-serverless/instances/test --region cn-hangzhou --header \"Content-Type=application/json\" --version 2023-06-27 --force",
  "cmd_full_name": "es-serverless get-app",
  "cmd_name": "get-app",
  "deprecated": false,
  "description_en": "Retrieves the details of an Elasticsearch Serverless application",
  "description_zh": "调用GetApp接口，获取Elasticsearch Serverless应用的详情信息",
  "kebab_example": "aliyun es-serverless get-app --app-name test --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetApp",
  "operation": {
    "action": "GetApp",
    "api_style": "ROA",
    "api_version": "2023-06-27",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/openapi/es-serverless/instances/{appName}"
  },
  "parameters": [
    {
      "example": "test",
      "help_en": "The name of the application. You can call the https://help.aliyun.com/document_detail/2539816.html operation to obtain the application name",
      "help_zh": "应用名称。调用https://help.aliyun.com/document_detail/2539816.html获取应用名称",
