                            "example": "test",
                            "type": "string"
                          },
                          "ips": {
                            "description_en": "The list of IP addresses in the whitelist group",
                            "description_zh": "白名单组中的IP地址列表",
                            "itemName": "ips",
                            "items": {
                              "description_en": "The specific IP address or CIDR block",
                              "description_zh": "具体IP或IP段",
                              "example": "127.0.0.1",
                              "type": "string"
                            },
                            "type": "array"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "ownerId": {
                "description_en": "The UID of the Alibaba Cloud account to which the application belongs",
