                "description_zh": "应用名称",
                "example": "es-severless-test-app",
                "type": "string"
              },
              "appType": {
                "description_zh": "应用类型",
                "example": "STANDARD",
                "type": "string"
              },
              "chargeType": {
                "type": "string"
              },
              "createTime": {
                "description_en": "The time when the application was created",
