  "cmd_name": "update-dict",
  "deprecated": false,
  "description_en": "Call the UpdateDict operation to create or update a dictionary for an Elasticsearch Serverless application. You can upload dictionaries only from OSS",
  "description_zh": "调用UpdateDict接口，创建或修改ES Serverless应用词典。目前仅支持通过OSS地址上传",
  "kebab_example": "aliyun es-serverless update-dict --app-name test --region cn-hangzhou",
  "method": "PUT",
  "multi_version": false,
  "name": "UpdateDict",
  "operation": {
    "action": "UpdateDict",
    "api_style": "ROA",
    "api_version": "2023-06-27",
    "body_mapping": {
