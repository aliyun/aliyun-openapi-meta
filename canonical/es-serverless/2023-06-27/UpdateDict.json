      "param_style": "json",
      "raw_name": "files",
      "required": true,
      "type": "array"
    },
    {
      "example": "OSS",
      "help_en": "The source type of the dictionary file. Only OSS is supported",
      "help_zh": "词典文件来源类型。目前仅支持OSS（使用OSS开放存储）",
      "location": "body",
      "name": "source_type",
      "options": [
        "--source-type"
      ],
      "param_style": "json",
      "raw_name": "sourceType",
      "required": false,
      "type": "string"
    },
    {
      "example": "MAIN",
      "help_en": "The type of dictionary to update:\n\nMAIN: IK main tokenizer dictionary\n\nSTOP: IK stopword dictionary",
      "help_zh": "要更新的词典类型：\n\nMAIN：IK主分词词库\nSTOP：IK停用词库",
      "location": "body",
      "name": "type",
      "options": [
        "--type"
      ],
      "param_style": "json",
      "raw_name": "type",
