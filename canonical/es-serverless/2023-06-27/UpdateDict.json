      "source_type": "sourceType",
      "type": "type"
    },
    "content_type": "application/json",
    "method": "PUT",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "update",
    "url": "/openapi/es-serverless/instances/{appName}/dicts"
  },
