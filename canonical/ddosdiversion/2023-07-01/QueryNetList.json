        "properties": {
          "Code": {
            "backendName": "code",
            "description_en": "The status code.\n\n200: The request was successful.\n\nOther codes: The request failed",
            "description_zh": "接口返回码：\n\n200：表示成功。\n其它：表示错误码",
            "example": "200",
            "format": "int64",
            "type": "integer"
          },
          "Data": {
            "backendName": "data",
            "description_en": "The CIDR blocks",
            "description_zh": "网段列表",
            "nullToEmpty": true,
            "properties": {
              "Nets": {
                "backendName": "data",
                "description_en": "The CIDR blocks",
                "description_zh": "网段列表",
                "itemName": "nets",
                "items": {
                  "properties": {
                    "DDoSDefense": {
                      "backendName": "ddos_defense",
                      "description_en": "The DDoS mitigation configuration of the CIDR block",
                      "description_zh": "防护配置",
                      "properties": {
                        "CleanTh": {
                          "backendName": "clean_th",
                          "description_en": "The configuration of traffic scrubbing",
                          "description_zh": "清洗阈值",
                          "properties": {
                            "Mbps": {
                              "backendName": "Mbps",
                              "description_en": "The traffic scrubbing threshold in Mbit/s",
                              "description_zh": "每秒带宽清洗阈值。单位：Mbps",
                              "example": "0",
                              "format": "int32",
                              "type": "integer"
                            },
                            "Pps": {
                              "backendName": "Pps",
                              "description_en": "The traffic scrubbing threshold in packets per second (pps)",
                              "description_zh": "每秒报文数清洗阈值。单位：Pps",
                              "example": "0",
                              "format": "int32",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        },
                        "DjPolicy": {
                          "backendName": "dj_policy",
                          "description_en": "The configuration of the mitigation policy",
                          "description_zh": "防护模板",
                          "properties": {
                            "PolicyName": {
                              "backendName": "policy_name",
                              "description_en": "The name of the mitigation policy",
                              "description_zh": "模板名称",
                              "example": "gf_origin_xxxxx",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "HoleTh": {
                          "backendName": "hole_th",
                          "description_en": "The configuration of blackhole filtering",
                          "description_zh": "黑洞阈值",
                          "properties": {
                            "ThreshMbps": {
                              "backendName": "thresh_mbps",
                              "description_en": "The blackhole filtering threshold in Mbit/s. The value 0 indicates best-effort protection",
                              "description_zh": "黑洞阈值。单位：Mbps。0代表全力防护",
                              "example": "0",
                              "format": "int32",
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        }
                      },
                      "type": "object"
                    },
                    "Declared": {
                      "backendName": "declared",
                      "description_en": "The advertising details",
                      "description_zh": "区域牵引状态",
                      "itemName": "declared",
                      "items": {
                        "properties": {
                          "Declared": {
                            "backendName": "declared",
                            "description_en": "Indicates whether the CIDR block is advertised. Valid values:\n\n0: The CIDR block is not advertised.\n\n1: The CIDR block is advertised",
                            "description_zh": "区域牵引状态。枚举值：\n0：未牵引。\n1：牵引中",
                            "example": "0",
                            "type": "string"
                          },
                          "Region": {
                            "backendName": "region",
                            "description_en": "The region in which the CIDR block is advertised. Valid values:\n\noe26: China (Hong Kong).\n\nus50: US (Virginia).\n\noe24: US (Silicon Valley).\n\noe28: Singapore.\n\njp141: Japan (Tokyo).\n\nGb145: UK (London).\n\noi39: Germany (Frankfurt)",
                            "description_zh": "牵引区域。枚举值：\noe26：香港。\nus50：美东。\noe24：美西。\noe28：新加坡。\njp141：日本。\ngb145：英国。\noi39：德国",
                            "example": "oe26",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "DeclaredState": {
                      "backendName": "declared_state",
                      "description_en": "The advertising status of the CIDR block. Valid values:\n\n0: The CIDR block is not advertised.\n\n1: The CIDR block is advertised",
                      "description_zh": "牵引状态。枚举值：\n0：未牵引。\n1：牵引中",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "FwdEffect": {
                      "backendName": "fwd_effect",
                      "description_en": "Indicates whether the forwarding configuration takes effect. Valid values:\n\n0: The forwarding configuration does not take effect.\n\n1: The forwarding configuration takes effect",
                      "description_zh": "转发生效状态。枚举值：\n0：未生效。\n1：生效中",
                      "example": "1",
                      "format": "int64",
                      "type": "integer"
                    },
                    "GmtCreate": {
                      "backendName": "gmt_create",
                      "description_en": "The creation time",
                      "description_zh": "添加时间",
                      "example": "2024-09-05 13:52:50",
                      "type": "string"
                    },
                    "GmtModify": {
                      "backendName": "gmt_modify",
                      "description_en": "The modification time",
                      "description_zh": "修改时间",
                      "example": "2024-09-05 13:59:55",
                      "type": "string"
                    },
                    "Mode": {
                      "backendName": "mode",
                      "description_en": "The scheduling mode. Valid values:\n\nnetflow-auto\n\nmanual",
                      "description_zh": "代播启动模式。枚举值：\nnetflow-auto：NetFlow自动。\nmanual：手动",
                      "example": "manual",
                      "type": "string"
                    },
                    "Net": {
                      "backendName": "net",
                      "description_en": "The CIDR block of the anti-DDoS diversion instance",
                      "description_zh": "代播实例的网段",
                      "example": "192.168.XX.XX/24",
                      "type": "string"
                    },
                    "NetExtend": {
                      "backendName": "net_extend",
                      "description_en": "Indicates whether the CIDR block needs to be extended. Valid values:\n\n0: The CIDR block does not need to be extended.\n\n1: The CIDR block needs to be extended",
                      "description_zh": "是否需要扩展。枚举值：\n0：不扩展。\n1：扩展",
                      "example": "0",
                      "type": "string"
                    },
                    "NetMain": {
                      "backendName": "net_main",
                      "description_en": "The primary CIDR block of the anti-DDoS diversion instance for which an extended CIDR block is configured. If no extended CIDR blocks are configured for the anti-DDoS diversion instance, this parameter is left empty",
                      "description_zh": "子网段展示，主网段默认为空字符串",
                      "example": "192.168.XX.XX/22",
                      "type": "string"
                    },
                    "NetType": {
                      "backendName": "net_type",
                      "description_en": "The type of the CIDR block",
                      "description_zh": "网段类型",
                      "example": "ipv4",
                      "type": "string"
                    },
                    "Permit": {
                      "backendName": "permit",
                      "description_en": "The review status. Valid values:\n\n0: not reviewed.\n\n1: reviewed.\n\n2: under review",
                      "description_zh": "审核状态。\n枚举值：\n0：未审核。\n1：已审核。\n2：审核中",
                      "example": "2",
                      "format": "int32",
                      "type": "integer"
                    },
                    "SaleId": {
                      "backendName": "sale_id",
                      "description_en": "The ID of the anti-DDoS diversion instance",
                      "description_zh": "代播实例的ID",
                      "example": "ddos_diversion_public_cn-xxxxxxxxxxxxx",
                      "type": "string"
                    },
                    "UpstreamType": {
                      "backendName": "upstream_type",
                      "description_en": "The reinjection type. Valid values:\n\naliyun_line\n\npccw_line\n\ngre_line\n\nprivate_line",
                      "description_zh": "回注类型。枚举值：\naliyun_line：阿里云专线。\npccw_line：合作专线（pccw）。\ngre_line：GRE专线。\nprivate_line：私有专线",
                      "example": "aliyun_line",
                      "type": "string"
                    },
                    "UserId": {
                      "backendName": "user_id",
                      "description_en": "The user ID",
                      "description_zh": "用户ID",
                      "example": "57690941xxxxxxxx",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "Num": {
                "backendName": "num",
                "description_en": "The number of entries per page. Valid values: 1 to 100. Default value: 100",
                "description_zh": "每页展示的网段数量。取值范围：1~100，默认值为100",
                "example": "100",
                "format": "int64",
                "type": "integer"
              },
              "Page": {
                "backendName": "page",
                "description_en": "The page number",
                "description_zh": "当前页码",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "Total": {
                "backendName": "total",
                "description_en": "The total number of entries returned",
                "description_zh": "网段总数量",
                "example": "10",
                "format": "int64",
                "type": "integer"
              }
            },
            "type": "object"
          },
          "Message": {
            "backendName": "message",
            "description_en": "The response parameters",
            "description_zh": "返回信息",
            "example": "successful",
            "type": "string"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "本次调用请求的ID，是由阿里云为该请求生成的唯一标识符，可用于排查和定位问题",
            "example": "24B652B5-AEFF-3F03-9114-00D053C42277",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
