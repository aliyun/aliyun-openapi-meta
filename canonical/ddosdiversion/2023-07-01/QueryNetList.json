{
  "camel_example": "aliyun ddosdiversion QueryNetList --region cn-hangzhou --MainNet '192.168.XX.XX/22' --Mode 'netflow-auto' --Num 100 --SaleId 'ddos_diversion_public_cn-xxxxxxxxxxxxx' --Page 1 --Net '192.168.XX.XX/24'",
  "cmd_full_name": "ddosdiversion query-net-list",
  "cmd_name": "query-net-list",
  "deprecated": false,
  "description_en": "Queries the CIDR blocks of an anti-DDoS diversion instance",
  "description_zh": "查询代播的网段列表",
  "kebab_example": "aliyun ddosdiversion query-net-list --sale-id ddos_diversion_public_cn-xxxxxxxxxxxxx --net 192.168.XX.XX/24 --biz-mode netflow-auto --main-net 192.168.XX.XX/22 --page 1 --num 100 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "QueryNetList",
  "operation": {
    "action": "QueryNetList",
    "api_style": "RPC",
    "api_version": "2023-07-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "ddos_diversion_public_cn-xxxxxxxxxxxxx",
      "help_en": "The ID of the anti-DDoS diversion instance",
      "help_zh": "代播实例的ID",
      "location": "query",
      "name": "sale_id",
      "options": [
        "--sale-id"
      ],
      "raw_name": "SaleId",
      "required": false,
      "type": "string"
    },
    {
      "example": "192.168.XX.XX/24",
      "help_en": "The CIDR block of the anti-DDoS diversion instance.\n\nIf no extended CIDR blocks are configured for the anti-DDoS diversion instance, this parameter specifies the CIDR block of the instance. If an extended CIDR block is configured for the anti-DDoS diversion instance, this parameter specifies the extended CIDR block that is configured for the instance. If this parameter is specified, the MainNet parameter is required",
      "help_zh": "代播实例的网段。\n代播实例没有扩展网段时，表示实例的网段。代播实例有扩展网段时，表示扩展的网段，与MainNet参数配合使用",
      "location": "query",
      "name": "net",
      "options": [
        "--net"
      ],
      "raw_name": "Net",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "manual",
        "netflow-auto",
        "beaver-auto"
      ],
      "example": "netflow-auto",
      "help_en": "The scheduling mode. Valid values:\n\nmanual: manual scheduling.\n\nnetflow-auto: automatic scheduling",
      "help_zh": "调度模式。取值：\n\nmanual : 人工。\nnetflow-auto：netflow自动调度",
      "location": "query",
      "name": "mode",
      "options": [
        "--biz-mode"
      ],
      "raw_name": "Mode",
      "required": false,
      "type": "string"
    },
    {
      "example": "192.168.XX.XX/22",
      "help_en": "The primary CIDR block of the anti-DDoS diversion instance for which an extended CIDR block is configured. If no extended CIDR blocks are configured for the anti-DDoS diversion instance, leave this parameter empty",
      "help_zh": "具有扩展网段的代播实例的主网段。如果查询的代播实例没有扩展网段，此参数为空",
      "location": "query",
      "name": "main_net",
      "options": [
        "--main-net"
      ],
      "raw_name": "MainNet",
      "required": false,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. Default value: 1",
      "help_zh": "页码。 默认值：1",
      "location": "query",
      "name": "page",
      "options": [
        "--page"
      ],
      "raw_name": "Page",
      "required": false,
      "type": "int"
    },
    {
      "example": "100",
      "help_en": "The number of entries per page. Default value: 100",
      "help_zh": "数量。默认值：100",
      "location": "query",
      "name": "num",
      "options": [
        "--num"
      ],
      "raw_name": "Num",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "DdosDiversion",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
