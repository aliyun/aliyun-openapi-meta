{
  "camel_example": "aliyun ddosdiversion QueryNetList --region cn-hangzhou --MainNet '192.168.XX.XX/22' --Mode 'netflow-auto' --Num 100 --SaleId 'ddos_diversion_public_cn-xxxxxxxxxxxxx' --Page 1 --Net '192.168.XX.XX/24'",
  "cmd_full_name": "ddosdiversion query-net-list",
