{
  "camel_example": "",
  "cmd_full_name": "airec list-samples",
  "cmd_name": "list-samples",
  "components": {
    "schemas": {
      "Sample": {
        "description_en": "The sample entity",
        "description_zh": "样本实体",
        "properties": {
          "GmtCreate": {
            "backendName": "gmtCreate",
            "description_en": "The time when the sample was created. The time is in UTC",
            "description_zh": "创建时间，单位为UTC时间",
            "example": "2021-12-07T12:28:52.000Z",
            "title": "创建时间",
            "type": "string"
          },
          "GmtModified": {
            "backendName": "gmtModified",
            "description_en": "The time when the sample was last modified",
            "description_zh": "最后修改时间",
            "example": "2021-12-07T12:28:52.000Z",
            "title": "修改时间",
            "type": "string"
          },
          "Meta": {
            "backendName": "meta",
            "description_en": "The configuration",
            "description_zh": "配置",
            "properties": {
              "AutoUpdate": {
                "backendName": "autoUpdate",
                "description_en": "Specifies whether to automatically update the sample configuration",
                "description_zh": "是否自动更新样本配置",
                "example": "true",
                "title": "是否自动更新",
                "type": "boolean"
              },
              "AutoUpdateFrequency": {
                "backendName": "autoUpdateFrequency",
                "description_en": "The update frequency. The value is a UNIX timestamp in seconds",
                "description_zh": "更新频率，秒级别时间戳",
                "example": "1673341140",
                "format": "int64",
                "title": "更新频率，秒级别时间戳",
                "type": "integer"
              },
              "ClonedId": {
                "backendName": "clonedId",
                "description_en": "The ID of the cloned sample",
                "description_zh": "克隆的ID",
                "example": "1638877561147",
                "title": "克隆的id",
                "type": "string"
              },
              "Config": {
                "backendName": "config",
                "description_en": "The details of the sample configuration",
                "description_zh": "样本配置详情",
                "properties": {
                  "BhvTableSourceIds": {
                    "backendName": "bhvTableSourceIds",
                    "description_en": "A list of behavioral data sources",
                    "description_zh": "行为数据源列表",
                    "items": {
                      "description_en": "A behavioral data source",
                      "description_zh": "行为数据源",
                      "type": "string"
                    },
                    "title": "行为数据源列表",
                    "type": "array"
                  },
                  "FeatureConfig": {
                    "backendName": "featureConfig",
                    "description_en": "The feature configuration",
                    "description_zh": "特征配置",
                    "properties": {
                      "ItemFeatures": {
                        "backendName": "itemFeatures",
                        "description_en": "The item features. Multiple features are supported. Separate multiple features with commas",
                        "description_zh": "物品特征，支持多值，逗号分隔",
                        "example": "deress,red",
                        "title": "物品特征，支持多值，逗号分隔。",
                        "type": "string"
                      },
                      "UserFeatures": {
                        "backendName": "userFeatures",
                        "description_en": "The user features. Multiple features are supported. Separate multiple features with commas",
                        "description_zh": "用户特征，支持多值，逗号分隔",
                        "example": "man",
                        "title": "用户特征，支持多值，逗号分隔。",
                        "type": "string"
                      }
                    },
                    "title": "特征",
                    "type": "object"
                  },
                  "LabelLogic": {
                    "backendName": "labelLogic",
                    "description_en": "The logic for sample labeling",
                    "description_zh": "样品打标逻辑",
                    "properties": {
                      "BhvTimeWindow": {
                        "backendName": "bBhvTimeWindow",
                        "description_en": "The time window, in seconds",
                        "description_zh": "时间窗口，秒级别时间戳",
                        "example": "86400",
                        "format": "int64",
                        "title": "时间窗口，秒级别时间戳。",
                        "type": "integer"
                      },
                      "NegativeBhvTypes": {
                        "backendName": "negativeBhvTypes",
                        "description_en": "The negative behaviors. Multiple behaviors are supported. Separate multiple behaviors with commas",
                        "description_zh": "负行为，支持多值，逗号分隔",
                        "example": "click,expose",
                        "title": "负行为，支持多值，逗号分隔。",
                        "type": "string"
                      },
                      "PositiveBhvTypes": {
                        "backendName": "positiveBhvTypes",
                        "description_en": "The positive behaviors. Multiple behaviors are supported. Separate multiple behaviors with commas",
                        "description_zh": "是正行为，支持多值，逗号分隔",
                        "example": "like",
                        "title": "是\t正行为，支持多值，逗号分隔。",
                        "type": "string"
                      }
                    },
                    "title": "打标逻辑",
                    "type": "object"
                  },
                  "WeightLogicList": {
                    "backendName": "weightLogicList",
                    "description_en": "The weight logic configuration",
                    "description_zh": "权重逻辑配置",
                    "items": {
                      "description_en": "The weight",
                      "description_zh": "权重",
                      "properties": {
                        "Bhv": {
                          "backendName": "bhv",
                          "description_en": "The behavior type",
                          "description_zh": "行为类型",
                          "example": "click",
                          "title": "行为类型",
                          "type": "string"
                        },
                        "Weight": {
                          "backendName": "weight",
                          "description_en": "The weight. The value ranges from 1 to 100",
                          "description_zh": "权重（1-100）",
                          "example": "1",
                          "title": "权重",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "title": "权重逻辑",
                    "type": "array"
                  }
                },
                "title": "样本配置详情",
                "type": "object"
              },
              "ExtendParams": {
                "backendName": "extendParams",
                "description_en": "The extended parameters",
                "description_zh": "扩展参数",
                "properties": {
                  "LatestTaskStatus": {
                    "backendName": "latestTaskStatus",
                    "description_en": "The status of the latest task.\n\nValid values:\n\n0: No task.\n\n1: Normal.\n\n2: Abnormal",
                    "description_zh": "任务状态枚举值。\n\n取值：\n\n0：没有任务。\n\n1：正常。\n\n2：异常",
                    "example": "1",
                    "format": "int64",
                    "title": "任务状态",
                    "type": "integer"
                  },
                  "SampleCount": {
                    "backendName": "sampleCount",
                    "description_en": "The number of samples",
                    "description_zh": "样本数量",
                    "example": "0",
                    "format": "int64",
                    "title": "样本数量",
                    "type": "integer"
                  }
                },
                "title": "扩展参数",
                "type": "object"
              },
              "MetaType": {
                "backendName": "metaType",
                "description_en": "The type of metadata",
                "description_zh": "修改元信息类型",
                "example": "Sample",
                "title": "修改元信息类型",
                "type": "string"
              },
              "Name": {
                "backendName": "name",
                "description_en": "The name of the sample",
                "description_zh": "样本名称",
                "example": "12345",
                "title": "样本名称",
                "type": "string"
              },
              "StoreConfig": {
                "backendName": "storeConfig",
                "description_en": "The storage location",
                "description_zh": "存储位置",
                "example": "projectName.tableName",
                "title": "存储位置",
                "type": "string"
              },
              "Type": {
                "backendName": "type",
                "description_en": "The type of the sample.\n\nValid values:\n\nCloned: A cloned sample.\n\nSystem: A system-generated sample.\n\nCustom: A custom sample",
                "description_zh": "样本类型枚举值。\n\n取值：\n\nCloned：复制的。\n\nSystem：系统的。\n\nCustom：自定义的",
                "example": "System",
                "title": "样本类型",
                "type": "string"
              }
            },
            "title": "配置",
            "type": "object"
          },
          "SampleId": {
            "backendName": "sampleId",
            "description_en": "The ID of the sample",
            "description_zh": "样本ID",
            "example": "1638880131873",
            "title": "样本id",
            "type": "string"
          },
          "Status": {
            "backendName": "status",
            "description_en": "The status of the sample.\n\nValid values:\n\nUnready: The configuration is not complete.\n\nReady: The configuration is complete.\n\nGenerating: The sample is being generated.\n\nSuccess: The sample is generated.\n\nFailed: The sample failed to generate.\n\nFormatting: The sample is being formatted.\n\nFormatted: The sample is formatted.\n\nFormatFailed: The sample failed to be formatted.\n\nApplied: The sample is applied to the model",
            "description_zh": "样本状态枚举值。\n\n取值：\n\nUnready：未完成配置。\n\nReady：配置完成。\n\nGenerating：样本生成中。\n\nSuccess：样本生成成功。\n\nFailed：样本生成失败。\n\nFormatting：格式化中。\n\nFormatted：格式化完成。\n\nFormatFailed：格式化失败。\n\nApplied：已应用到模型中",
            "example": "Formatted",
            "title": "状态",
            "type": "string"
          }
        },
        "title": "样本",
        "type": "object"
      }
    }
  },
  "deprecated": false,
  "description_en": "Retrieves a list of samples",
  "description_zh": "获取样本列表",
  "kebab_example": "aliyun airec list-samples --instance-id airec-cn-shdjkgkeog --api-version 2020-11-26 --region cn-hangzhou",
