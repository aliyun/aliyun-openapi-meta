            "items": {
              "properties": {
                "Comment": {
                  "backendName": "comment",
                  "description_zh": "列备注",
                  "example": "主键ID",
                  "title": "列备注",
                  "type": "string"
                },
                "Name": {
                  "backendName": "name",
                  "description_zh": "列名",
                  "example": "id",
                  "title": "列名",
                  "type": "string"
                },
                "Type": {
                  "backendName": "type",
                  "description_zh": "列数据类型",
                  "example": "bigint",
                  "title": "列数据类型",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "title": "列定义列表",
            "type": "array"
          },
          "Comment": {
            "backendName": "comment",
