            "title": "备注描述",
            "type": "string"
          },
          "CreateTime": {
            "backendName": "createTime",
            "description_en": "The creation time of the table (Unix timestamp, in milliseconds)",
            "description_zh": "表的创建时间（Unix 时间戳，毫秒）",
            "example": "1717948800000",
            "format": "int64",
            "title": "创建时间",
            "type": "integer"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The unique identifier name of the event table",
            "description_zh": "事件表的唯一标识名称",
            "example": "my_table",
            "title": "表名称",
            "type": "string"
          },
          "Namespace": {
            "backendName": "database",
            "description_en": "The name of the namespace to which the table belongs",
            "description_zh": "表所属的命名空间名称",
            "example": "my_namespace",
            "title": "所属命名空间",
            "type": "string"
          },
          "RetentionPolicy": {
            "backendName": "retentionPolicy",
            "description_en": "Data retention policy. Includes the retention days for hot data and cold data",
            "description_zh": "数据保留策略。包含热数据和冷数据的保留天数",
            "properties": {
              "ColdTTL": {
                "backendName": "coldTTL",
                "description_en": "Retention days for cold data, used for low-cost archival storage",
                "description_zh": "冷数据保留天数，低成本归档存储",
                "example": "30",
                "format": "int32",
                "title": "冷数据保留天数",
                "type": "integer"
              },
              "HotTTL": {
                "backendName": "hotTTL",
                "description_en": "Retention days for hot data, used for high-performance query storage",
                "description_zh": "热数据保留天数，高性能查询存储",
                "example": "7",
                "format": "int32",
                "title": "热数据保留天数",
                "type": "integer"
              }
            },
            "title": "数据保留策略",
            "type": "object"
          },
          "UpdateTime": {
            "backendName": "updateTime",
            "description_en": "The last update time of the table (Unix timestamp, in milliseconds)",
            "description_zh": "表的最后更新时间（Unix 时间戳，毫秒）",
            "example": "1717948800000",
            "format": "int64",
            "title": "更新时间",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
