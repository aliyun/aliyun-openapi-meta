            "description_zh": "满足条件的总行数，当 IsTruncated=true 时与 RowCount 不同",
            "example": "2",
            "format": "int32",
            "title": "总行数",
            "type": "integer"
          }
        },
        "title": "SQL 执行结果",
        "type": "object"
      },
      "SchemaColumn": {
        "description_en": "The column definition",
        "description_zh": "列定义",
        "properties": {
