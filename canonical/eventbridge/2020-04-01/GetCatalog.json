            "backendName": "connectionName",
            "descriptionEn": "The connection name associated with a mounted catalog",
            "description_en": "The connection name associated with a mounted catalog. This parameter has a value only when Provider is set to MySQL, PostgreSQL, Elasticsearch, OSS_TABLES, SLS, OTS, MaxCompute, MongoDB, Redis, SQLServer, ClickHouse, Oracle, Hive, or Iceberg",
            "description_zh": "挂载类型 Catalog 关联的连接名称。仅 Provider 为 MySQL/PostgreSQL/Elasticsearch/OSS_TABLES/SLS/OTS/MaxCompute/MongoDB/Redis/SQLServer/ClickHouse/Oracle/Hive/Iceberg 时有值",
            "example": "my_connection",
            "title": "连接名称",
            "type": "string"
          },
          "Name": {
            "backendName": "name",
            "description_en": "The unique identifier name of the data catalog",
            "description_zh": "数据目录的唯一标识名称",
            "example": "my_catalog",
            "required": false,
            "title": "数据目录名称",
            "type": "string"
          },
          "Properties": {
            "backendName": "properties",
            "description_en": "The extended properties (JSON object). For the Elasticsearch type, this includes information such as IndexPattern",
            "description_zh": "扩展属性（JSON 对象）。Elasticsearch 类型包含 IndexPattern 等信息",
            "example": "{\"IndexPattern\":\"my-index-*\"}",
            "title": "扩展属性",
            "type": "object"
          },
          "Provider": {
            "backendName": "provider",
            "description_en": "The data source provider. EventHouse indicates built-in storage. MySQL, PostgreSQL, Elasticsearch, OSS_TABLES, SLS, OTS, MaxCompute, MongoDB, Redis, SQLServer, ClickHouse, Oracle, Hive, and Iceberg indicate externally mounted sources",
            "description_zh": "数据源提供方。EventHouse 为内置存储，MySQL/PostgreSQL/Elasticsearch/OSS_TABLES/SLS/OTS/MaxCompute/MongoDB/Redis/SQLServer/ClickHouse/Oracle/Hive/Iceberg 为外部挂载",
            "example": "EventHouse",
            "title": "数据源提供方",
            "type": "string"
          },
          "Type": {
            "backendName": "type",
            "description_en": "The type of the data catalog, such as RELATIONAL",
            "description_zh": "数据目录类型，如 RELATIONAL",
            "example": "RELATIONAL",
            "title": "数据目录类型",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
