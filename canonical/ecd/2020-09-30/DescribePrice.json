                "example": "100",
                "format": "int64",
                "type": "integer"
              },
              "Price": {
                "backendName": "price",
                "description_en": "The price information",
                "description_zh": "价格信息",
                "nullToEmpty": true,
                "properties": {
                  "Currency": {
                    "backendName": "currency",
                    "description_en": "<props=\"china\">The currency unit (CNY).</props>\n<props=\"intl\">The currency unit (USD).</props>",
                    "description_zh": "<props=\"china\">货币单位（CNY）。</props>\n<props=\"intl\"> 货币单位（USD）。</props>",
                    "example": "CNY/USD",
