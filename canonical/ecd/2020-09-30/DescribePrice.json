                },
                "type": "object",
                "visibility": "Public"
              },
              "Rules": {
                "backendName": "rules",
                "description_en": "The promotion rule information",
                "description_zh": "活动规则信息",
                "itemName": "Rule",
                "items": {
                  "description_en": "The promotion rule information",
                  "description_zh": "活动规则信息",
                  "properties": {
                    "Description": {
                      "backendName": "description",
