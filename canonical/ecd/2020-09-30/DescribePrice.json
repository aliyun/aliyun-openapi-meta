                        "PromotionDesc": {
                          "backendName": "promotionDesc",
                          "description_en": "The promotion description",
                          "description_zh": "促销信息描述",
                          "example": "新品上市，立享优惠",
                          "nullToEmpty": true,
                          "type": "string",
                          "visibility": "Public"
                        },
                        "PromotionId": {
                          "backendName": "promotionId",
                          "description_en": "The promotion ID",
                          "description_zh": "促销活动ID",
                          "example": "123456",
                          "nullToEmpty": true,
                          "title_en": "优惠ID。",
                          "title_zh": "优惠ID。",
                          "type": "string",
                          "visibility": "Public"
                        },
                        "PromotionName": {
                          "backendName": "promotionName",
                          "description_en": "The promotion name",
                          "description_zh": "促销活动名称",
                          "example": "Featured deals",
                          "nullToEmpty": true,
                          "type": "string",
                          "visibility": "Public"
                        },
                        "Selected": {
                          "backendName": "selected",
                          "description_en": "Indicates whether the promotion is selected",
                          "description_zh": "是否被选中",
                          "example": "false",
                          "nullToEmpty": true,
                          "type": "boolean",
                          "visibility": "Public"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array",
                    "visibility": "Public"
                  },
                  "SpPrice": {
                    "backendName": "spPrice",
                    "description_en": "The price under the savings plan",
                    "description_zh": "节省计划下的价格",
                    "example": "50.00",
