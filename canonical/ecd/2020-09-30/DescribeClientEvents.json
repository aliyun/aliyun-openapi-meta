      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "28961708130834****",
      "help_en": "The logon user information, which is a Resource Access Management (RAM) user ID or AD username. If this parameter is not specified, events of all users in the region are queried",
      "help_zh": "登录用户信息，RAM用户ID或AD用户名。不指定时，表示查询该地域下所有用户的事件",
