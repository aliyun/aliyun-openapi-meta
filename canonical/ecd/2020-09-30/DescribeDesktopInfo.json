{
  "cmd_full_name": "ecd describe-desktop-info",
  "cmd_name": "describe-desktop-info",
  "deprecated": false,
  "description_en": "Queries the basic information of cloud computers",
  "description_zh": "查询云电脑的基础信息",
  "kebab_example": "aliyun ecd describe-desktop-info --business-channel Enterprise --biz-region-id cn-hangzhou --desktop-id ecd-gx2x1dhsmucyy0000 --need-extra-info true --api-version 2020-09-30 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "DescribeDesktopInfo",
  "operation": {
    "action": "DescribeDesktopInfo",
    "api_style": "RPC",
    "api_version": "2020-09-30",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": ""
  },
  "parameters": [
    {
      "enum": [
        "Enterprise",
        "Business",
        "Lincore_team",
        "AGENTIC_CLOUD_COMPUTER"
      ],
      "example": "Enterprise",
      "help_en": "The business channel. Valid values:\nEnterprise: Enterprise Edition.\nBusiness: Business Edition",
      "help_zh": "业务渠道, 取值：\nEnterprise：企业版\nBusiness：商业版",
      "location": "query",
      "name": "business_channel",
      "options": [
        "--business-channel"
      ],
      "raw_name": "BusinessChannel",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "cn-hangzhou",
      "help_en": "The region ID. You can call https://help.aliyun.com/document_detail/196646.html to query the regions supported by Elastic Desktop Service",
      "help_zh": "地域ID。可以调用https://help.aliyun.com/document_detail/196646.html获取无影云电脑支持的地域列表",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The cloud computer ID. You can specify 1 to 100 IDs",
      "help_zh": "云电脑ID。可设置1~100个",
      "location": "query",
      "name": "desktop_id",
      "options": [
        "--desktop-id"
      ],
      "param_style": "repeatList",
      "raw_name": "DesktopId",
      "required": false,
      "type": "array"
    },
    {
      "help_en": "Specifies whether to return the extended information of the cloud computer",
      "help_zh": "是否返回云电脑的扩展信息",
      "location": "query",
      "name": "need_extra_info",
      "options": [
        "--need-extra-info"
      ],
      "raw_name": "NeedExtraInfo",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "ecd",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Desktops": {
            "backendName": "data",
            "description_en": "The basic information of cloud computers",
            "description_zh": "云电脑基础信息",
            "itemName": "Desktop",
            "items": {
              "description_en": "The basic information of cloud computers",
              "description_zh": "云电脑基础信息",
              "properties": {
                "ConnectionStatus": {
                  "backendName": "connectionStatus",
                  "description_en": "The connection status of the user",
                  "description_zh": "用户的连接状态",
                  "example": "Disconnected",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "CurrentAppVersion": {
                  "backendName": "currentAppVersion",
                  "description_en": "The image version number of the cloud computer",
                  "description_zh": "云电脑镜像版本号",
                  "example": "1.4.0-R-***",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DesktopGroupId": {
                  "backendName": "desktopGroupId",
                  "description_en": "The cloud computer pool ID",
                  "description_zh": "云电脑池ID",
                  "example": "dg-3uiojcc0j4kh7****",
                  "type": "string"
                },
                "DesktopId": {
                  "backendName": "desktopId",
                  "description_en": "The cloud computer ID",
                  "description_zh": "云电脑ID",
                  "example": "ecd-gx2x1dhsmucyy****",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "DesktopStatus": {
                  "backendName": "status",
                  "description_en": "The status of the cloud computer",
                  "description_zh": "云电脑状态",
                  "example": "Running",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                },
                "ManagementFlag": {
                  "backendName": "mgtFlags",
                  "description_en": "The management flags",
                  "description_zh": "管理标识",
                  "itemName": "mgtFlag",
                  "items": {
                    "description_en": "The management flags",
                    "description_zh": "管理标识",
                    "example": "NoFlag",
                    "type": "string"
                  },
                  "type": "array"
                },
                "NewAppSize": {
                  "backendName": "size",
                  "description_en": "The size of the upgrade package, in KB",
                  "description_zh": "升级包大小，单位为KB",
                  "example": "568533470",
                  "format": "int64",
                  "type": "integer"
                },
                "NewAppVersion": {
                  "backendName": "newAppVersion",
                  "description_en": "The image version number to which the cloud computer can be upgraded",
                  "description_zh": "云电脑可升级的镜像版本号",
                  "example": "1.6.0-R-***",
                  "type": "string"
                },
                "ReleaseNote": {
                  "backendName": "releaseNote",
                  "description_en": "The description of the image version to which the cloud computer can be upgraded",
                  "description_zh": "可升级的镜像版本描述",
                  "example": "测试升级包03-07\n",
                  "type": "string"
                },
                "StartTime": {
                  "backendName": "startTime",
                  "description_en": "The time when the cloud computer was first started. The time is in the ISO 8601 standard (UTC)",
                  "description_zh": "云电脑首次启动时间。时间格式为 ISO 8601 标准（UTC 时间）",
                  "example": "2020-11-06T08:31Z",
                  "nullToEmpty": false,
                  "type": "string",
                  "visibility": "Public"
                }
              },
              "type": "object"
            },
            "nullToEmpty": false,
            "type": "array",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "062B1439-709A-580E-85DF-CE97A1560565",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
