                      },
                      "FixResult": {
                        "backendName": "fixResult",
                        "description_en": "The fix result",
                        "description_zh": "修复结果",
                        "enum": [
                          "SUCCEED",
                          "FAILED"
                        ],
                        "example": "SUCCEED",
                        "type": "string"
                      },
                      "FixTime": {
                        "backendName": "fixTime",
                        "description_en": "The timestamp when the fix task ended, in milliseconds",
                        "description_zh": "修复任务结束的时间戳，单位为毫秒",
                        "example": "2026-08-05 13:57:31",
                        "type": "string"
                      },
                      "FixType": {
                        "backendName": "fixType",
                        "description_en": "The fix type",
                        "description_zh": "修复类型",
                        "enum": [
                          "ManualTask",
                          "AppointmentTask",
                          "AutoTask"
                        ],
                        "example": "AutoTask",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "PatchIds": {
                  "backendName": "patchIds",
                  "description_en": "The list of patch IDs",
                  "description_zh": "补丁ID列表",
                  "itemName": "PatchId",
                  "items": {
                    "description_en": "The patch ID",
                    "description_zh": "补丁ID",
                    "example": "KB5082063",
                    "type": "string"
                  },
                  "type": "array"
                },
                "RegionId": {
                  "backendName": "regionId",
                  "description_en": "The region ID. You can call [DescribeRegions](~~DescribeRegions~~) to query the regions supported by WUYING Workspace",
                  "description_zh": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表",
                  "example": "cn-shenzhen",
                  "type": "string"
                },
                "ResourceGroupId": {
                  "backendName": "resourceGroupId",
                  "description_en": "The enterprise resource group ID",
                  "description_zh": "企业资源组ID",
                  "example": "rg-acfm2tswogr****",
                  "type": "string"
                },
