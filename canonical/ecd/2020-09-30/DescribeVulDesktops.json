                  "backendName": "status",
                  "description_en": "The fix status of the patch",
                  "description_zh": "补丁的修复状态",
                  "enum": [
                    "Fixed",
                    "Unfixed",
                    "PendingFix",
                    "Updating",
                    "Disable"
