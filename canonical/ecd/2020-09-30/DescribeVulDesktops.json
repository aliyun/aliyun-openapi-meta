                  "example": "Fixed",
                  "type": "string"
                },
                "VulLevel": {
                  "backendName": "vulLevel",
                  "description_en": "The patch level",
                  "description_zh": "补丁等级",
                  "enum": [
                    "critical",
                    "high",
                    "medium",
                    "low"
                  ],
                  "example": "high",
                  "type": "string"
