                    "description_zh": "实际付款价格。取值为原价减去折减的价格",
                    "example": "63.2",
                    "format": "float",
                    "nullToEmpty": true,
                    "type": "number",
                    "visibility": "Public"
                  }
                },
                "type": "object",
                "visibility": "Public"
              },
              "Rules": {
                "backendName": "rules",
                "description_en": "The promotion rule information",
                "description_zh": "活动规则信息",
