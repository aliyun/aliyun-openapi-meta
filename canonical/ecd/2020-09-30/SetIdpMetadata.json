{
  "cmd_full_name": "ecd set-idp-metadata",
  "cmd_name": "set-idp-metadata",
  "deprecated": false,
  "description_en": "Uploads metadata for a SAML 2.0-based identity provider (IdP)",
  "description_zh": "上传基于SAML 2.0的身份提供商IdP（Identity Provider）的元数据",
  "kebab_example": "aliyun ecd set-idp-metadata --biz-region-id cn-hangzhou --idp-metadata lt_EntityDescriptor_ID00000000Descriptor_gt --api-version 2020-09-30 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "SetIdpMetadata",
  "operation": {
    "action": "SetIdpMetadata",
    "api_style": "RPC",
    "api_version": "2020-09-30",
    "method": "POST",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "cn-hangzhou",
      "help_en": "The region ID. You can call [DescribeRegions](~~DescribeRegions~~) to query the regions supported by Elastic Desktop Service",
      "help_zh": "地域ID。可以调用[DescribeRegions](~~DescribeRegions~~)获取无影云电脑支持的地域列表",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "cn-hangzhou+dir-400695****",
      "help_en": "The office network ID, which has the same meaning as `OfficeSiteId`. We recommend that you stop using `DirectoryId` and use `OfficeSiteId` instead. You can specify only one of `DirectoryId` and `OfficeSiteId`, not both",
      "help_zh": "办公网络ID，与`OfficeSiteId`含义相同。建议停止使用`DirectoryId`，改为使用`OfficeSiteId`。`DirectoryId`和`OfficeSiteId`只能填写一个，不可同时填写",
      "location": "query",
      "name": "directory_id",
      "options": [
        "--directory-id"
      ],
      "raw_name": "DirectoryId",
      "required": false,
      "type": "string"
    },
    {
      "example": "cn-hangzhou+dir-400695****",
      "help_en": "The office network ID",
      "help_zh": "办公网络ID",
      "location": "query",
      "name": "office_site_id",
      "options": [
        "--office-site-id"
      ],
      "raw_name": "OfficeSiteId",
      "required": false,
      "type": "string"
    },
    {
      "example": "&lt;EntityDescriptor ID********Descriptor&gt;",
      "help_en": "The metadata of the identity provider (IdP)",
      "help_zh": "身份提供商IdP的元数据",
      "location": "query",
      "name": "idp_metadata",
      "options": [
        "--idp-metadata"
      ],
      "raw_name": "IdpMetadata",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ecd",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回信息集合",
        "properties": {
          "IdpEntityId": {
            "backendName": "data",
            "description_en": "The entityID value obtained after parsing the IdP metadata file",
            "description_zh": "IdP元数据文件解析后获得的entityID值",
            "example": "http://test****.cn/adfs/services/trust",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "1CBAFFAB-B697-4049-A9B1-67E1FC5F****",
            "nullToEmpty": false,
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
