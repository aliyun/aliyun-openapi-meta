{
  "apis": {
    "DescribeBenefits": {
      "cmd_name": "describe-benefits",
      "deprecated": false,
      "description_en": "Queries information about the privilege quota specifications and quantities associated with a channel. The returned information can be used to distribute channel privileges",
      "description_zh": "查询渠道关联的权益规格、权益数量等信息，相关信息可用于渠道权益的发放"
    },
    "GetRedeemCodes": {
      "cmd_name": "get-redeem-codes",
      "deprecated": false,
      "description_en": "Retrieves redemption codes for channel privileges. Channel privileges are distributed and transferred in the form of redemption codes. After redemption codes are generated, the corresponding privilege quota is deducted",
      "description_zh": "获取权益兑换码。渠道权益，将以兑换码的形式进行发放和流转。生成兑换码后，相应的权益数量将会扣减"
    },
    "GetRequestToken": {
      "cmd_name": "get-request-token",
      "deprecated": false,
      "description_en": "Retrieves a one-time credential for a channel service request. The credential can be used for authentication in channel-related API operations and becomes invalid after use",
      "description_zh": "获取渠道服务请求一次性凭证，该凭证可用于渠道相关接口的鉴权，使用后失效"
    }
  },
