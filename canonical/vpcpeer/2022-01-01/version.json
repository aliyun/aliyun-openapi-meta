    },
    "MoveResourceGroup": {
      "cmd_name": "move-resource-group",
      "deprecated": false,
      "description_en": "Modifies the resource group of a VPC peering connection",
      "description_zh": "调用MoveResourceGroup接口修改对等连接所属的资源组"
    },
    "RejectVpcPeerConnection": {
      "cmd_name": "reject-vpc-peer-connection",
      "deprecated": false,
      "description_en": "Rejects a request for a VPC peering connection",
      "description_zh": "调用RejectVpcPeerConnection接口拒绝VPC对等连接实例的请求"
    },
    "TagResources": {
      "cmd_name": "tag-resources",
      "deprecated": false,
      "description_en": "Creates and attaches tags to one or more specified VPC peering connections",
      "description_zh": "调用TagResources接口为指定的VPC对等连接统一创建并绑定标签"
    },
    "UnTagResources": {
      "cmd_name": "un-tag-resources",
      "deprecated": false,
      "description_en": "Removes tags from specified VPC peering connections",
      "description_zh": "调用UnTagResources接口为指定的VPC对等连接统一解绑标签"
    }
