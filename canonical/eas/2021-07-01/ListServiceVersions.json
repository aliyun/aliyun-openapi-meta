{
  "camel_example": "aliyun eas GET /api/v2/services/cn-hangzhou/test_oss/versions --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "eas list-service-versions",
  "cmd_name": "list-service-versions",
  "deprecated": false,
  "description_en": "Queries the historical versions of a service",
  "description_zh": "查询服务历史版本",
  "kebab_example": "aliyun eas list-service-versions --cluster-id cn-hangzhou --service-name test_oss --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListServiceVersions",
  "operation": {
    "action": "ListServiceVersions",
    "api_style": "ROA",
    "api_version": "2021-07-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/api/v2/services/{ClusterId}/{ServiceName}/versions"
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The ID of the region where the service is deployed",
      "help_zh": "服务所在地域ID",
      "location": "path",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "test_oss",
      "help_en": "The name of the service. For information about how to obtain the service name, see https://help.aliyun.com/document_detail/412109.html",
      "help_zh": "服务名称。如何获取服务名称，请参见https://help.aliyun.com/document_detail/412109.html",
      "location": "path",
      "name": "service_name",
      "options": [
        "--service-name"
      ],
      "raw_name": "ServiceName",
      "required": true,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number. Default value: 1",
      "help_zh": "请求的页码，默认为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of versions to return on each page in the paging Settings for a paged query. Default value: 100",
      "help_zh": "分页查询时设置的每页显示的版本数量，默认为100",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/versions",
  "product_code": "eas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "PageNumber": {
            "description_en": "The current page number of the returned historical versions",
            "description_zh": "返回查询的历史版本的当前页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageSize": {
            "description_en": "The number of historical versions returned on each page",
            "description_zh": "返回每页显示的历史版本数量",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "E089D584-B6F4-50C4-9902-DA2295B7****",
            "type": "string"
          },
          "TotalCount": {
            "description_en": "The total number of versions",
            "description_zh": "总计数量",
            "example": "166",
            "format": "int64",
            "type": "integer"
          },
          "Versions": {
            "description_en": "The list of versions",
            "description_zh": "版本信息列表",
            "itemName": "versions",
            "items": {
              "description_en": "The version details",
              "description_zh": "版本信息集合",
              "properties": {
                "BuildTime": {
                  "description_en": "The UTC time when the version was created",
                  "description_zh": "版本创建UTC时间",
                  "example": "2022-08-29T22:02:14Z",
                  "type": "string"
                },
                "ImageAvailable": {
                  "description_en": "The availability of the image. Valid values:\ntrue: Available.\nfalse: Unavailable.\nunknown: Unknown",
                  "description_zh": "镜像可用性。可能值：\ntrue：可用。\nfalse：不可用。\nunknown：未知",
                  "example": "true",
                  "type": "string"
                },
                "ImageId": {
                  "description_en": "The image ID",
                  "description_zh": "镜像ID",
                  "example": "4",
                  "format": "int32",
                  "type": "integer"
                },
                "Message": {
                  "description_en": "The summary of the service",
                  "description_zh": "服务的摘要信息",
                  "example": "Service is Running",
                  "type": "string"
                },
                "Remark": {
                  "description_en": "The remarks",
                  "description_zh": "备注信息",
                  "example": "new version.",
                  "type": "string"
                },
                "ServiceConfig": {
                  "description_en": "The deployment configuration of the service. This field is returned only for custom image deployments",
                  "description_zh": "服务部署配置。只有自定义镜像部署才会返回此字段",
                  "example": "{\n    \"metadata\": {\n        \"cpu\": 1,\n        \"instance\": 1,\n        \"memory\": 1024\n    },\n    \"name\": \"echo\"\n}",
                  "type": "string"
                },
                "ServiceRunnable": {
                  "description_en": "Indicates whether the EAS service is enabled. Valid values:\ntrue: Enabled.\nfalse: Disabled.\nunknown: Unknown",
                  "description_zh": "eas服务是否启用，可能值：\ntrue：启用。\nfalse：未启用。\nunknown：未知",
                  "example": "true",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  }
}
