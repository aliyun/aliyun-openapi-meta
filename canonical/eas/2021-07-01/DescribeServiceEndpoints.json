{
  "camel_example": "aliyun eas GET /api/v2/services/{ClusterId}/service_name/endpoints --region cn-hangzhou --header \"Content-Type=application/json\"",
  "cmd_full_name": "eas describe-service-endpoints",
  "cmd_name": "describe-service-endpoints",
  "deprecated": false,
  "description_en": "Retrieves a list of service endpoints",
  "description_zh": "获取服务端点列表",
  "kebab_example": "aliyun eas describe-service-endpoints --service-name service_name --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "DescribeServiceEndpoints",
  "operation": {
    "action": "DescribeServiceEndpoints",
    "api_style": "ROA",
    "api_version": "2021-07-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/api/v2/services/{ClusterId}/{ServiceName}/endpoints"
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID",
      "help_zh": "区域ID",
      "location": "path",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "ClusterId",
      "required": true,
      "type": "string"
    },
    {
      "example": "service_name",
      "help_en": "The service name. For more information, see https://help.aliyun.com/document_detail/412109.html",
      "help_zh": "服务名称。如何获取服务名称，请参见https://help.aliyun.com/document_detail/412109.html",
      "location": "path",
      "name": "service_name",
      "options": [
        "--service-name"
      ],
      "raw_name": "ServiceName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/endpoints",
  "product_code": "eas",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "返回结果",
        "properties": {
          "AccessToken": {
            "description_en": "The service token",
            "description_zh": "服务Token",
            "example": "Nzc5N2FhN****TQ0YzBmYTIyN2MxZTUxN2NkYjg4MTJmMWQxZmY1****",
            "type": "string"
          },
          "Endpoints": {
            "description_en": "The list of service endpoints",
            "description_zh": "服务端点列表",
            "itemName": "Endpoints",
            "items": {
              "properties": {
                "BackendId": {
                  "description_en": "The ID of the backend service. The value of this parameter varies based on the value of EndpointType:\n\nIf EndpointType is DefaultGateway, this parameter is set to default.\n\nIf EndpointType is PrivateGateway, this parameter is the ID of the dedicated gateway.\n\nIf EndpointType is Nlb, this parameter is the ID of the NLB instance.\n\nIf EndpointType is Nacos, this parameter is the ID of the Nacos instance",
                  "description_zh": "后端接入 ID，取决于 EndpointType：\n\nDefaultGateway：为 default。\nPrivateGateway：为专属网关 ID。\nNlb：为 NLB 实例 ID。\nNacos：为 Nacos 实例 ID",
                  "example": "nlb-5q4sp7u6oorkha****",
                  "type": "string"
                },
                "EndpointType": {
                  "description_en": "The connection type of the service endpoint. Valid values:\n\nDefaultGateway: The service is connected using a shared gateway.\n\nPrivateGateway: The service is connected using a dedicated gateway.\n\nNlb: The service is attached to a Network Load Balancer (NLB) instance.\n\nNacos: The service is attached to a Nacos instance",
                  "description_zh": "服务端点接入方式，可能值为：\n\nDefaultGateway：共享网关。\nPrivateGateway：专属网关。\nNlb：挂载 NLB。\nNacos：挂载 Nacos",
                  "example": "Nlb",
                  "type": "string"
                },
                "InternetEndpoints": {
                  "description_en": "The list of internet-facing endpoints",
                  "description_zh": "公网地址列表",
                  "itemName": "InternetEndpoints",
                  "items": {
                    "description_en": "The internet-facing endpoint",
                    "description_zh": "完整的访问地址",
                    "example": "null",
                    "type": "string"
                  },
                  "type": "array"
                },
                "IntranetEndpoints": {
                  "description_en": "The list of internal endpoints",
                  "description_zh": "内网地址列表",
                  "itemName": "IntranetEndpoints",
                  "items": {
                    "description_en": "The internal endpoint",
                    "description_zh": "完整的访问地址",
                    "example": "nlb-5q4sp7u6oor****jvv.cn-hangzhou.nlb.aliyuncs.com",
                    "type": "string"
                  },
                  "type": "array"
                },
                "PathType": {
                  "description_en": "The type of the endpoint. Valid values:\n\nGroup: The endpoint of an audience group.\n\nService: The endpoint of a service",
                  "description_zh": "地址类型，可能值为：\n\nGroup：服务群组地址。\nService：服务地址",
                  "example": "Service",
                  "type": "string"
                },
                "Port": {
                  "description_en": "The port number. This parameter is returned only when the service is attached to an NLB or Nacos instance",
                  "description_zh": "端口。仅挂载 NlB 和 Nacos 时，Port 才有值",
                  "example": "9090",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "Message": {
            "description_en": "The message returned",
            "description_zh": "返回结果说明",
            "example": "Execution succeeded.",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "739998B5-FB39-12A3-8323-0FA340317298",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  },
  "v1_parameters": [
    {
      "help_en": "The region ID",
      "help_zh": "区域ID",
      "name": "ClusterId",
      "position": "path",
      "required": false,
      "type": "string"
    },
    {
      "help_en": "The service name. For more information, see https://help.aliyun.com/document_detail/412109.html",
      "help_zh": "服务名称。如何获取服务名称，请参见https://help.aliyun.com/document_detail/412109.html",
      "name": "ServiceName",
      "position": "path",
      "required": true,
      "type": "string"
    }
  ]
}
