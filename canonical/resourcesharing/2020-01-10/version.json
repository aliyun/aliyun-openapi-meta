    },
    "ListResourceShareInvitations": {
      "cmd_name": "list-resource-share-invitations",
      "deprecated": false,
      "description_en": "Queries the resource sharing invitations that you have received",
      "description_zh": "资源使用者调用ListResourceShareInvitations查询自己收到的资源共享邀请信息"
    },
    "ListResourceSharePermissions": {
      "cmd_name": "list-resource-share-permissions",
      "deprecated": false,
      "description_en": "Queries the permissions that are associated with a resource share",
