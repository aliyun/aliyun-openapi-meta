{
  "apis": {
    "AcceptResourceShareInvitation": {
      "cmd_name": "accept-resource-share-invitation",
      "deprecated": false,
      "description_en": "Accepts a resource sharing invitation",
      "description_zh": "资源使用者调用AcceptResourceShareInvitation接受资源共享邀请"
    },
    "AssociateResourceShare": {
      "cmd_name": "associate-resource-share",
      "deprecated": false,
      "description_en": "Associates shared resources or principals with a resource share",
      "description_zh": "为共享单元关联共享资源或资源使用者"
    },
    "AssociateResourceSharePermission": {
      "cmd_name": "associate-resource-share-permission",
      "deprecated": false,
      "description_en": "Associates permissions with a resource share",
      "description_zh": "调用AssociateResourceSharePermission为共享单元关联共享权限"
    },
    "ChangeResourceGroup": {
      "cmd_name": "change-resource-group",
      "deprecated": false,
      "description_en": "Transfers a resource share from one resource group to another",
      "description_zh": "将共享单元从一个资源组转移到另外一个资源组"
    },
    "CheckSharingWithResourceDirectoryStatus": {
      "cmd_name": "check-sharing-with-resource-directory-status",
      "deprecated": false,
      "description_en": "Checks the status of resource sharing within a resource directory",
      "description_zh": "检查基于组织共享的状态"
    },
    "CreateResourceShare": {
      "cmd_name": "create-resource-share",
      "deprecated": false,
      "description_en": "Creates a resource share",
      "description_zh": "创建共享单元"
    },
    "DeleteResourceShare": {
      "cmd_name": "delete-resource-share",
      "deprecated": false,
      "description_en": "Deletes a resource share",
      "description_zh": "删除共享单元"
    },
    "DescribeRegions": {
      "cmd_name": "describe-regions",
      "deprecated": false,
      "description_en": "Queries the regions where the Resource Sharing service is available",
      "description_zh": "查询支持资源共享的地域"
    },
    "DisassociateResourceShare": {
      "cmd_name": "disassociate-resource-share",
      "deprecated": false,
      "description_en": "Disassociates shared resources or principals from a resource share",
      "description_zh": "为共享单元移除共享资源或资源使用者"
    },
    "DisassociateResourceSharePermission": {
      "cmd_name": "disassociate-resource-share-permission",
      "deprecated": false,
      "description_en": "Disassociates a permission from a resource share. You can disassociate a permission from a resource share only if the resource share does not contain resources of the type indicated by the permission",
      "description_zh": "调用DisassociateResourceSharePermission为共享单元解除共享权限。当共享单元下权限对应的资源类型没有关联具体资源时，才允许从共享单元中删除权限"
    },
    "EnableSharingWithResourceDirectory": {
      "cmd_name": "enable-sharing-with-resource-directory",
      "deprecated": false,
      "description_en": "Enables resource sharing for a resource directory",
      "description_zh": "启用资源目录组织共享"
    },
    "GetPermission": {
      "cmd_name": "get-permission",
      "deprecated": false,
      "description_en": "Queries the information about a permission",
      "description_zh": "调用GetPermission查询共享权限信息"
    },
    "ListPermissionVersions": {
      "cmd_name": "list-permission-versions",
      "deprecated": false,
      "description_en": "Queries the versions of a permission",
      "description_zh": "调用ListPermissionVersions查询指定共享权限名称的版本信息"
    },
    "ListPermissions": {
      "cmd_name": "list-permissions",
      "deprecated": false,
      "description_en": "Queries the information about the default permission",
      "description_zh": "调用ListPermissions查询默认共享权限信息"
    },
    "ListResourceShareAssociations": {
      "cmd_name": "list-resource-share-associations",
      "deprecated": false,
