    },
    "ListSharedTargets": {
      "cmd_name": "list-shared-targets",
      "deprecated": false,
      "description_en": "Queries a list of principals",
      "description_zh": "查询资源使用者列表"
    },
    "ListTagResources": {
      "cmd_name": "list-tag-resources",
