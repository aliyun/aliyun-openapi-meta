{
  "camel_example": "aliyun fc PUT /2023-03-30/functions/my-func/scaling-config --region cn-hangzhou --qualifier LATEST --header \"Content-Type=application/json\" --body \"example-string\"",
  "cmd_full_name": "fc put-scaling-config",
  "cmd_name": "put-scaling-config",
  "components": {
    "schemas": {
      "ScalingConfigStatus": {
        "description_en": "The elastic scaling configuration of the function",
        "description_zh": "函数弹性配置信息",
        "properties": {
          "currentError": {
            "backendName": "currentError",
            "description_en": "The error message that is returned when an instance fails to be created",
            "description_zh": "实例创建失败时的错误信息",
            "example": "image not found",
            "type": "string"
          },
          "currentInstances": {
            "backendName": "currentInstances",
            "description_en": "The current number of instances",
            "description_zh": "当前实例数",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "enableMixMode": {
            "backendName": "enableMixMode",
            "description_en": "Specifies whether mix mode is enabled",
            "description_zh": "mix模式开关",
            "example": "False",
            "type": "boolean"
          },
          "enableOnDemandScaling": {
            "backendName": "enableOnDemandScaling",
            "description_en": "Specifies whether on-demand scaling is enabled",
            "description_zh": "开关",
            "example": "True",
            "type": "boolean"
          },
          "functionArn": {
            "backendName": "functionArn",
            "description_en": "The resource identifier of the function",
            "description_zh": "函数资源标识",
            "example": "acs:fc:cn-shanghai:124:functions/myFunction/prod",
            "type": "string"
          },
          "horizontalScalingPolicies": {
            "backendName": "horizontalScalingPolicies",
            "description_en": "The horizontal scaling policies",
            "description_zh": "水平弹性策略",
            "items": {
              "$ref": "#/components/schemas/ScalingPolicy",
              "description_en": "The horizontal scaling policy",
              "description_zh": "水平弹性策略"
            },
            "type": "array"
          },
          "minInstances": {
            "backendName": "qualifier",
            "description_en": "The minimum number of instances",
            "description_zh": "最小实例数",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "requestDispatchPolicy": {
            "backendName": "requestDispatchPolicy",
            "description_en": "The request dispatch policy",
            "description_zh": "策略",
            "example": "Balanced",
            "type": "string"
          },
          "residentPoolId": {
            "backendName": "residentPoolId",
            "description_en": "The ID of the resident resource pool",
            "description_zh": "常驻资源池id",
            "example": "fc-pool-a2b664c1f87171j4******",
            "type": "string"
          },
          "scheduledPolicies": {
            "backendName": "residentConfig",
            "description_en": "The scheduled scaling policies",
            "description_zh": "定时弹性策略",
            "items": {
              "$ref": "#/components/schemas/ScheduledPolicy",
              "description_en": "The scheduled scaling policy",
              "description_zh": "定时弹性策略"
            },
            "type": "array"
          },
          "targetInstances": {
            "backendName": "targetInstances",
            "description_en": "The target number of instances",
            "description_zh": "目标实例数",
            "example": "10",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ScalingPolicy": {
        "description_en": "A horizontal scaling policy",
        "description_zh": "水平弹性策略",
        "properties": {
          "endTime": {
            "backendName": "endTime",
            "description_en": "The time when the policy expires",
            "description_zh": "策略失效时间",
            "example": "2024-03-10T10:10:10Z",
            "type": "string"
          },
          "maxInstances": {
            "backendName": "maxInstances",
            "description_en": "The maximum number of instances",
            "description_zh": "最大实例数",
            "example": "10",
            "format": "int64",
            "type": "integer"
          },
          "metricTarget": {
            "backendName": "metricTarget",
            "description_en": "The target value for the metric",
            "description_zh": "指标的追踪值",
            "example": "0.6",
            "format": "float",
            "type": "number"
          },
          "metricType": {
            "backendName": "metricType",
            "description_en": "The type of metric to track. ProvisionedConcurrencyUtilization is the concurrency utilization of provisioned instances. CPUUtilization is the CPU utilization. GPUMemUtilization is the GPU memory utilization",
            "description_zh": "跟踪的指标类型：ProvisionedConcurrencyUtilization：预留模式实例并发度利用率。CPUUtilization：CPU利用率。GPUMemUtilization：GPU利用率",
            "example": "CPUUtilization",
            "type": "string"
          },
          "minInstances": {
            "backendName": "minInstances",
            "description_en": "The minimum number of instances",
            "description_zh": "最小实例数",
            "example": "1",
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "backendName": "name",
            "description_en": "The name of the policy",
            "description_zh": "策略名称",
            "example": "test",
            "type": "string"
          },
          "startTime": {
            "backendName": "startTime",
            "description_en": "The time when the policy takes effect",
            "description_zh": "策略生效时间",
            "example": "2023-03-10T10:10:10Z",
            "type": "string"
          },
          "timeZone": {
            "backendName": "timeZone",
            "description_en": "The time zone. If this parameter is empty, the times for startTime, endTime, and scheduleExpression must be in Coordinated Universal Time (UTC)",
            "description_zh": "时区。时区参数为空时，startTime、endTime和scheduleExpression的时间需为UTC格式",
            "example": "Asia/Shanghai",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ScheduledPolicy": {
        "description_en": "The policy",
        "description_zh": "策略",
        "properties": {
          "endTime": {
            "backendName": "endTime",
            "description_en": "The end time",
            "description_zh": "结束时间",
            "example": "1633449590000",
            "type": "string"
          },
          "name": {
            "backendName": "name",
            "description_en": "The policy name",
            "description_zh": "策略名称",
            "example": "student_app_shop_analyzer",
            "type": "string"
          },
          "scheduleExpression": {
            "backendName": "scheduleExpression",
            "description_en": "The schedule configuration",
            "description_zh": "定时配置",
            "example": "。",
            "type": "string"
          },
          "startTime": {
            "backendName": "startTime",
            "description_en": "The start time",
            "description_zh": "开始时间",
            "example": "1764432000000",
            "type": "string"
          },
          "target": {
            "backendName": "target",
            "description_en": "The current number of target resources. If a metric-based auto scaling policy or a scheduled policy is in effect, this parameter specifies the number of resources calculated by the policy. Otherwise, this parameter specifies the default number of provisioned instances.\n\nHow is this different from defaultTarget?<br>\nAssume that you set the number of provisioned instances to 1 and then add a scheduled auto scaling policy to set the number to 5 for a specific time period.<br>\n\nWhen the scheduled policy is active, target is 5 and defaultTarget is 1.\n\nWhen the scheduled policy is inactive, both target and defaultTarget are 1",
            "description_zh": "当前目标资源个数，如果存在指标追踪伸缩策略或定时策略，为策略计算的资源个数，否则为默认预留实例数。\n\n\n与 defaultTarget 有什么区别？\\\n假设配置预留实例数为1后，新增了定时伸缩策略，设置某个时间段内的预留实例数为5。\n在定时伸缩策略生效期间，target 与 defaultTarget 分别为 5 和 1。\n在定时伸缩策略失效期间，target 与 defaultTarget 都为 1",
            "example": "5",
            "format": "int64",
            "type": "integer"
          },
          "timeZone": {
            "backendName": "timeZone",
            "description_en": "The time zone. If this parameter is left empty, the times for startTime, endTime, and scheduleExpression must be in UTC format",
            "description_zh": "时区。时区参数为空时，startTime、endTime和scheduleExpression的时间需为UTC格式",
            "example": "。",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
