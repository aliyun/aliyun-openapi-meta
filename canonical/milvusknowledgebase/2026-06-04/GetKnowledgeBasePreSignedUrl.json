  "cmd_full_name": "milvusknowledgebase get-knowledge-base-pre-signed-url",
  "cmd_name": "get-knowledge-base-pre-signed-url",
  "deprecated": false,
  "description_en": "Generates an OSS pre-signed PUT URL pointing to the knowledge base dedicated storage for each file in `Documents`. The caller uses the URL to upload file content directly to Object Storage Service (OSS), and then calls `AddDocuments` to register the files. A maximum of 100 files can be processed per request",
  "description_zh": "为 `Documents` 中的每个文件生成一个指向知识库专属存储的 OSS 预签名 PUT URL，调用方用该 URL 直接把文件内容上传到对象存储，随后调用 `AddDocuments` 完成注册。单次最多 100 个文件",
  "kebab_example": "aliyun milvusknowledgebase get-knowledge-base-pre-signed-url --knowledge-base-id kb-3bd02617e9be335f --documents Path=contract-2026.md Size=1024 Name=CHANGELOG.md --expires-in 3600 --dataset-id kb-3bd02617e9be335f --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "GetKnowledgeBasePreSignedUrl",
