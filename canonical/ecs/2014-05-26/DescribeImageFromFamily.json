{
  "camel_example": "aliyun ecs DescribeImageFromFamily --region cn-hangzhou --ImageFamily 'hangzhou-daily-update' --RegionId 'cn-hangzhou'",
  "cmd_full_name": "ecs describe-image-from-family",
  "cmd_name": "describe-image-from-family",
  "deprecated": false,
  "description_en": "Queries the latest available custom image in a specified image family",
  "description_zh": "查询指定镜像族系内最新创建的可用自定义镜像",
  "kebab_example": "aliyun ecs describe-image-from-family --biz-region-id cn-hangzhou --image-family hangzhou-daily-update --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeImageFromFamily",
  "operation": {
    "action": "DescribeImageFromFamily",
    "api_style": "RPC",
    "api_version": "2014-05-26",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The region ID of the image. You can call https://help.aliyun.com/document_detail/25609.html to query the most recent region list",
      "help_zh": "镜像所在的地域ID。您可以调用https://help.aliyun.com/document_detail/25609.html查看最新的阿里云地域列表",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "hangzhou-daily-update",
      "help_en": "The name of the image family.\n\nImage families are supported for custom images, public images, community images, and shared images. For more information, see https://help.aliyun.com/document_detail/174241.html",
      "help_zh": "镜像族系名称。\n\n自定义镜像、公共镜像、社区镜像、共享镜像均已支持镜像族系，使用方法及介绍请参见https://help.aliyun.com/document_detail/174241.html",
      "location": "query",
      "name": "image_family",
      "options": [
        "--image-family"
      ],
      "raw_name": "ImageFamily",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
