                "nullToEmpty": true,
                "type": "string"
              },
              "OSType": {
                "backendName": "osType",
                "description_en": "The type of the operating system. Valid values:\nwindows\nlinux",
                "description_zh": "操作系统类型。可能值：\nwindows\nlinux",
                "example": "linux",
                "nullToEmpty": true,
                "type": "string"
              },
              "Platform": {
                "backendName": "platform",
                "description_en": "The operating system platform",
                "description_zh": "操作系统平台",
                "example": "Aliyun",
                "nullToEmpty": true,
                "type": "string"
              },
              "ProductCode": {
                "backendName": "productCode",
                "description_en": "The product code of the Alibaba Cloud Marketplace image",
                "description_zh": "镜像市场的镜像商品标示",
                "example": "jxsc00****",
                "nullToEmpty": true,
                "type": "string"
              },
              "Progress": {
                "backendName": "progress",
                "description_en": "The image creation progress, in percent",
                "description_zh": "镜像完成的进度，单位为百分比",
                "example": "100",
                "nullToEmpty": true,
                "type": "string"
              },
              "Size": {
                "backendName": "imageSize",
                "description_en": "The size of the image. Unit: GiB",
                "description_zh": "镜像大小，单位GiB",
                "example": "80",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer"
              },
              "Status": {
                "backendName": "status",
                "description_en": "The status of the image. Valid values:\nUnAvailable: unavailable\nAvailable: available\nCreating: being created\nCreateFailed: failed to be created",
                "description_zh": "镜像的状态。可能值：\nUnAvailable：不可用\nAvailable：可用\nCreating：创建中\nCreateFailed：创建失败",
                "example": "Available",
                "nullToEmpty": true,
                "type": "string"
              },
              "Tags": {
                "backendName": "tags",
                "itemName": "Tag",
                "items": {
                  "properties": {
                    "TagKey": {
                      "backendName": "tagKey",
                      "nullToEmpty": true,
                      "type": "string"
                    },
                    "TagValue": {
                      "backendName": "tagValue",
