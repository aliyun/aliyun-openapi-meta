{
  "camel_example": "aliyun ecs DescribeLaunchTemplateVersions --region cn-hangzhou --MinVersion 1 --LaunchTemplateName testLaunchTemplateName --PageSize 10 --PageNumber 1 --DefaultVersion true --LaunchTemplateId 'lt-bp168lnahrdwl39p0000' --RegionId 'cn-hangzhou' --MaxVersion 10 --DetailFlag true --LaunchTemplateVersion.1 1",
