  "description_zh": "根据地域ID、计费方式等参数查询可用区信息列表",
  "kebab_example": "aliyun ecs describe-zones --biz-region-id cn-hangzhou --verbose false --instance-charge-type PostPaid --spot-strategy NoSpot --accept-language zh-CN --region cn-hangzhou",
  "method": "GET|POST",
