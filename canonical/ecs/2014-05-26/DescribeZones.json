{
  "camel_example": "aliyun ecs DescribeZones --region cn-hangzhou --Verbose false --InstanceChargeType PostPaid --AcceptLanguage 'zh-CN' --RegionId 'cn-hangzhou' --SpotStrategy NoSpot",
