{
  "camel_example": "aliyun ecs DescribeDedicatedHosts --region cn-hangzhou --Status Available --QueryInventory true --Tag.1.Key TestKey --ZoneId 'cn-hangzhou-g' --PageSize 10 --ResourceGroupId 'rg-aek3b6jzp660000' --NextToken e71d8a535bd9cc11 --MaxResults 10 --DedicatedHostType 'ddh.g5' --SocketDetails true --DedicatedHostName MyDDHTestName --PageNumber 1 --Tag.1.Value TestValue --RegionId 'cn-hangzhou' --LockReason financial --DedicatedHostIds 'dh-bp165p6xk2tlw61e0000_,_dh-bp1f9vxmno7emy960000' --DedicatedHostClusterId 'dc-bp12wlf6am0vz9v20000'",
  "cmd_full_name": "ecs describe-dedicated-hosts",
  "cmd_name": "describe-dedicated-hosts",
  "deprecated": false,
  "description_en": "Queries the details of one or more dedicated hosts. You can retrieve information such as the physical performance metrics, machine codes, usage status, and lists of created ECS instances on dedicated hosts. You can filter results by specifying parameters such as dedicated host IDs, dedicated host cluster ID, hostname, and status to precisely query the details you need, providing strong support for efficient management and optimization of cloud computing compute resources",
  "description_zh": "本接口用于查询一台或多台专有宿主机的详细信息。通过该接口，您可以获取包括专有宿主机的物理性能指标、机器码、使用状态以及已创建的ECS实例列表等信息。您能够根据具体需求，通过指定相关参数，如专有宿主机ID列表、专有宿主机集群ID、宿主机名称、状态等，精准地查询所需的专有宿主机详细信息，为高效管理和优化云计算资源提供有力支持",
  "kebab_example": "aliyun ecs describe-dedicated-hosts --biz-region-id cn-hangzhou --zone-id cn-hangzhou-g --dedicated-host-ids dh-bp165p6xk2tlw61e0000_,_dh-bp1f9vxmno7emy960000 --dedicated-host-name MyDDHTestName --status Available --dedicated-host-type ddh.g5 --lock-reason financial --page-number 1 --page-size 10 --resource-group-id rg-aek3b6jzp660000 --tag Value=TestValue Key=TestKey --dedicated-host-cluster-id dc-bp12wlf6am0vz9v20000 --socket-details true --next-token e71d8a535bd9cc11 --max-results 10 --query-inventory true --region cn-hangzhou",
