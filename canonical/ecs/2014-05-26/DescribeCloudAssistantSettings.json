                  "backendName": "prefix",
                  "nullToEmpty": true,
                  "type": "string"
                }
              },
              "type": "object"
            },
            "nullToEmpty": true,
            "type": "array"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "473469C7-AA6F-4DC5-B3DB-A3DC0DE3****",
            "type": "string"
          },
          "ResourceUsageConfig": {
            "backendName": "data.resourceUsageConfig",
            "description_en": "The Cloud Assistant resource usage configuration",
            "description_zh": "云助手资源占用配置",
            "properties": {
              "CpuLimit": {
                "backendName": "cpuLimit",
                "description_en": "The maximum CPU usage allowed for the Cloud Assistant Agent main process",
                "description_zh": "云助手Agent主进程最大允许的CPU占用限制",
                "example": "20",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer"
              },
              "KeepScriptFile": {
                "backendName": "keepScriptFile",
                "description_en": "Indicates whether the script file is retained in the Cloud Assistant directory after command execution is complete",
                "description_zh": "命令执行完成后，是否保留脚本文件到云助手目录",
                "example": "false",
                "nullToEmpty": true,
                "type": "boolean"
              },
              "LogFileCountLimit": {
                "backendName": "logFileCountLimit",
                "description_en": "The maximum number of Cloud Assistant log files to retain",
                "description_zh": "云助手日志文件的最大保存数量",
                "example": "30",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer"
              },
              "LogSizeLimit": {
                "backendName": "logSizeLimit",
                "description_en": "The size limit of Cloud Assistant log files",
                "description_zh": "云助手日志文件的大小限制",
                "example": "100MB",
                "nullToEmpty": true,
                "type": "string"
              },
              "MemoryLimit": {
                "backendName": "memoryLimit",
                "description_en": "The maximum memory usage allowed for the Cloud Assistant Agent main process",
                "description_zh": "云助手Agent主进程最大允许的内存占用限制",
                "example": "35MB",
                "nullToEmpty": true,
                "type": "string"
              },
              "OverloadLimit": {
                "backendName": "overloadLimit",
                "description_en": "The maximum number of consecutive times that CPU or memory resources usage can exceed the limit. When this limit is reached, Cloud Assistant Agent automatically stops running",
                "description_zh": "CPU或内存资源占用连续超限次数上限，达到上限后云助手Agent自动终止运行",
                "example": "3",
                "format": "int32",
                "nullToEmpty": true,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "SessionManagerConfig": {
            "backendName": "data.sessionManagerConfig",
            "description_en": "The Cloud Assistant session feature configuration",
            "description_zh": "云助手会话功能配置",
            "properties": {
              "SessionManagerEnabled": {
                "backendName": "sessionManagerEnabled",
                "description_en": "Specifies whether the Cloud Assistant session feature is enabled. Valid values:\ntrue: Enabled.\nfalse: Disabled.\n\nNote:\nEnabling or disabling the session feature takes effect across all regions",
                "description_zh": "云助手会话功能开关。取值范围：\ntrue: 开启；\nfalse: 关闭。\n\n注意事项：\n会话功能开启/关闭对全部地域生效",
                "example": "true",
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "SlsDeliveryConfigs": {
            "backendName": "data.slsDeliveryConfigs",
            "itemName": "SlsDeliveryConfig",
            "items": {
              "properties": {
                "DeliveryType": {
                  "backendName": "deliveryType",
                  "nullToEmpty": true,
                  "type": "string"
                },
                "Enabled": {
                  "backendName": "enabled",
                  "nullToEmpty": true,
                  "type": "boolean"
