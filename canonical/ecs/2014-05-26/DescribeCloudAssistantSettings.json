            "backendName": "data.agentUpgradeConfig",
            "description_en": "The Cloud Assistant Agent upgrade configuration",
            "description_zh": "云助手Agent升级配置",
            "properties": {
              "AllowedUpgradeWindows": {
                "backendName": "allowedUpgradeWindows",
                "itemName": "AllowedUpgradeWindow",
                "items": {
                  "backendName": "allowedUpgradeWindows",
                  "nullToEmpty": true,
                  "type": "string"
                },
                "nullToEmpty": true,
                "type": "array"
              },
              "BootstrapUpgrade": {
                "backendName": "bootstrapUpgrade",
                "description_en": "Indicates whether Cloud Assistant Agent checks for and performs updates immediately upon startup",
                "description_zh": "是否在云助手 Agent 启动时立即检查和进行更新",
                "example": "true",
                "nullToEmpty": true,
                "type": "boolean"
              },
              "DisableUpgrade": {
                "backendName": "disableUpgrade",
                "description_en": "Indicates whether Cloud Assistant Agent is prohibited from checking for and performing updates",
                "description_zh": "是否禁止云助手 Agent 检查和进行更新",
                "example": "true",
                "nullToEmpty": true,
                "type": "boolean"
              },
              "Enabled": {
                "backendName": "enabled",
                "description_en": "Indicates whether the custom Agent upgrade configuration is enabled. If the value is false or empty, the default behavior is to attempt an upgrade every 30 minutes",
                "description_zh": "是否开启自定义Agent升级配置。如查询结果为false或空，默认保持每30分钟尝试升级一次",
                "example": "true",
                "nullToEmpty": true,
                "type": "boolean"
              },
              "TimeZone": {
                "backendName": "timeZone",
                "description_en": "The time zone of the allowed upgrade time windows",
                "description_zh": "允许升级时间段的时区",
                "example": "Asia/Shanghai",
                "nullToEmpty": true,
                "type": "string"
              }
