{
  "camel_example": "",
  "cmd_full_name": "agentcore get-external-agent",
  "cmd_name": "get-external-agent",
  "deprecated": false,
  "description_en": "Queries the details of a specified external agent",
  "description_zh": "查询指定外部智能体的详细信息",
  "kebab_example": "aliyun agentcore get-external-agent --workspace-id ws-1 --agent-id agent-1 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetExternalAgent",
  "operation": {
    "action": "GetExternalAgent",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/external-agents/{agentId}"
  },
  "parameters": [
    {
      "example": "ws-1",
      "help_en": "The workspace ID",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "agent-1",
      "help_en": "The external agent ID",
      "help_zh": "外部智能体 ID",
      "location": "path",
      "name": "agent_id",
      "options": [
        "--agent-id"
      ],
      "raw_name": "agentId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/external-agents/[agentId]",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The successful response for querying an external agent",
        "description_zh": "查询外部智能体的成功响应",
        "properties": {
          "code": {
            "backendName": "code",
            "description_en": "The business status code. The value SUCCESS indicates success",
            "description_zh": "业务状态码。成功时为 SUCCESS",
            "example": "SUCCESS",
            "type": "string"
          },
          "data": {
            "backendName": "data",
            "description_en": "The external agent details",
            "description_zh": "外部智能体详情信息",
            "properties": {
              "agentId": {
                "backendName": "agentId",
                "description_en": "The external agent ID",
                "description_zh": "外部智能体 ID",
                "example": "agent-1",
                "type": "string"
              },
              "createMode": {
                "backendName": "createMode",
                "description_en": "The creation mode",
                "description_zh": "创建模式",
                "example": "CUSTOM",
                "type": "string"
              },
              "createdAt": {
                "backendName": "createdAt",
                "description_en": "The creation time in RFC 3339 format",
                "description_zh": "创建时间，RFC 3339 格式",
                "example": "2026-01-01T00:00:00Z",
                "type": "string"
              },
              "deployType": {
                "backendName": "deployType",
                "description_en": "The deployment type",
                "description_zh": "部署类型",
                "example": "SELF_HOSTED",
                "type": "string"
              },
              "description": {
                "backendName": "description",
                "description_en": "The external agent description",
                "description_zh": "外部智能体描述",
                "example": "运行在用户环境中的代码评审智能体",
                "type": "string"
              },
              "effectiveResult": {
                "backendName": "effectiveResult",
                "description_en": "The runtime result corresponding to the currently effective specification",
                "description_zh": "当前生效规格对应的运行时结果",
                "properties": {
                  "matrixUserId": {
                    "backendName": "matrixUserId",
                    "description_en": "The user ID of the agent in Matrix",
                    "description_zh": "智能体在 Matrix 中的用户 ID",
                    "example": "@agent-1:matrix.example.com",
                    "type": "string"
                  },
                  "personalRoomId": {
                    "backendName": "personalRoomId",
                    "description_en": "The Matrix personal room ID of the agent",
                    "description_zh": "智能体的 Matrix 个人房间 ID",
                    "example": "!room:matrix.example.com",
                    "type": "string"
                  },
                  "runtimeAcceptStatus": {
                    "backendName": "runtimeAcceptStatus",
                    "description_en": "The acceptance status of the runtime for the current request version",
                    "description_zh": "运行时对当前请求版本的接收状态",
                    "example": "ACCEPTED",
                    "type": "string"
                  },
                  "runtimeId": {
                    "backendName": "runtimeId",
                    "description_en": "The runtime instance ID",
                    "description_zh": "运行时实例 ID",
                    "example": "runtime-123",
                    "type": "string"
                  },
                  "runtimeRequestVersion": {
                    "backendName": "runtimeRequestVersion",
                    "description_en": "The runtime request version number",
                    "description_zh": "运行时请求版本号",
                    "example": "5",
                    "format": "int64",
                    "type": "integer"
                  },
                  "workspacePrefix": {
                    "backendName": "workspacePrefix",
                    "description_en": "The storage prefix of the agent in the workspace",
                    "description_zh": "智能体在工作空间中的存储前缀",
                    "example": "agents/agent-1",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "effectiveSpecVersion": {
                "backendName": "effectiveSpecVersion",
                "description_en": "The currently effective specification version number",
                "description_zh": "当前生效的规格版本号",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "externalAgentStatus": {
                "backendName": "externalAgentStatus",
                "description_en": "The runtime status information reported by the external agent",
                "description_zh": "外部智能体上报的运行状态信息",
                "properties": {
                  "heartbeatStatus": {
                    "backendName": "heartbeatStatus",
                    "description_en": "The heartbeat status. Valid values:\nONLINE: The latest heartbeat has not exceeded the configured timeout threshold.\nSTALE: The heartbeat has timed out.\nUNKNOWN: The heartbeat is missing or has an invalid format",
                    "description_zh": "心跳状态。ONLINE 表示最近心跳未超过配置的超时阈值；STALE 表示心跳已超时；UNKNOWN 表示心跳缺失或格式无效。枚举值：ONLINE（在线）、STALE（心跳过期）、UNKNOWN（未知）",
                    "enum": [
                      "ONLINE",
                      "STALE",
                      "UNKNOWN"
                    ],
                    "example": "ONLINE",
                    "type": "string"
                  },
                  "lastActiveAt": {
                    "backendName": "lastActiveAt",
                    "description_en": "The time when the external agent was last active in RFC 3339 format",
                    "description_zh": "外部智能体最近一次活跃时间，RFC 3339 格式",
                    "example": "2026-01-01T00:00:00Z",
                    "type": "string"
                  },
                  "lastHeartbeat": {
                    "backendName": "lastHeartbeat",
                    "description_en": "The time of the last heartbeat from the external agent in RFC 3339 format",
                    "description_zh": "外部智能体最近一次心跳时间，RFC 3339 格式",
                    "example": "2026-01-01T00:00:00Z",
                    "type": "string"
                  },
                  "localIP": {
                    "backendName": "localIP",
                    "description_en": "The local IP address reported by the external agent",
                    "description_zh": "外部智能体上报的本地 IP 地址",
                    "example": "10.0.0.42",
                    "type": "string"
                  },
                  "runtime": {
                    "backendName": "runtime",
                    "description_en": "The runtime type reported by the external agent",
                    "description_zh": "外部智能体上报的运行时类型",
                    "example": "qwenpaw",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "instruction": {
                "backendName": "instruction",
                "description_en": "The agent instruction that guides the behavior of the agent",
                "description_zh": "智能体指令，用于指导智能体的行为",
                "example": "你是一个代码评审助手",
                "type": "string"
              },
              "latestSpecVersion": {
                "backendName": "latestSpecVersion",
                "description_en": "The latest specification version number",
                "description_zh": "最新规格版本号",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "latestVersionStatus": {
                "backendName": "latestVersionStatus",
                "description_en": "The processing status of the latest specification version. Valid values:\npending: Pending processing.\nprocessing: Being processed.\nwaiting_retry: Waiting for retry.\nsucceeded: Succeeded.\nfailed: Failed.\nsuperseded: Superseded by a newer version",
                "description_zh": "最新规格版本的处理状态。枚举值：pending（待处理）、processing（处理中）、waiting_retry（等待重试）、succeeded（成功）、failed（失败）、superseded（已被新版本取代）",
                "enum": [
                  "pending",
                  "processing",
                  "waiting_retry",
                  "succeeded",
                  "failed",
                  "superseded"
                ],
                "example": "pending",
                "type": "string"
              },
              "model": {
                "backendName": "model",
                "description_en": "The model configuration. Available only when modelSource is set to PLATFORM",
                "description_zh": "模型配置。仅 modelSource 为 PLATFORM 时可用",
                "properties": {
                  "modelConnectionId": {
                    "backendName": "modelConnectionId",
                    "description_en": "The model connection ID",
                    "description_zh": "模型连接 ID",
                    "example": "mc-1",
                    "required": true,
                    "type": "string"
                  },
                  "modelName": {
                    "backendName": "modelName",
                    "description_en": "The upstream model name",
                    "description_zh": "上游模型名称",
                    "example": "qwen-max",
                    "required": true,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "modelSource": {
                "backendName": "modelSource",
                "description_en": "The model configuration source. Valid values:\nPLATFORM: The model configuration is parsed and delivered by the platform.\nRUNTIME: The model is managed by the external runtime. The model parameter cannot be specified at the same time",
                "description_zh": "模型配置来源。PLATFORM 表示由平台解析并下发 model 配置；RUNTIME 表示由外部运行时自行管理模型，不能同时传入 model。枚举值：PLATFORM（平台模型）、RUNTIME（运行时模型）",
                "enum": [
                  "PLATFORM",
                  "RUNTIME"
                ],
                "example": "PLATFORM",
                "type": "string"
              },
              "name": {
                "backendName": "name",
                "description_en": "The external agent name",
                "description_zh": "外部智能体名称",
                "example": "my-external-agent",
                "type": "string"
              },
              "regionId": {
                "backendName": "regionId",
                "description_en": "The region ID",
                "description_zh": "地域 ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "runtime": {
                "backendName": "runtime",
                "description_en": "The runtime type reported by the external agent",
                "description_zh": "外部智能体上报的运行时类型",
                "example": "qwenpaw",
                "type": "string"
              },
              "skills": {
                "backendName": "skills",
                "description_en": "The list of skill configurations",
                "description_zh": "技能配置列表",
                "items": {
                  "description_en": "The list of skill configurations",
                  "description_zh": "技能配置列表",
                  "properties": {
                    "name": {
                      "backendName": "name",
                      "description_en": "The skill name",
                      "description_zh": "技能名称",
                      "example": "code-analysis",
                      "required": true,
                      "type": "string"
                    },
                    "version": {
                      "backendName": "version",
                      "description_en": "The skill version",
                      "description_zh": "技能版本",
                      "example": "1.0.0",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "status": {
                "backendName": "status",
                "description_en": "The external agent status. Valid values:\nCreating: The agent is being created.\nRunning: The agent is running.\nFailed: The agent has failed.\nUpdating: The agent is being updated.\nDeleting: The agent is being deleted.\nDeleted: The agent has been deleted",
                "description_zh": "外部智能体状态。枚举值：Creating（创建中）、Running（运行中）、Failed（失败）、Updating（更新中）、Deleting（删除中）、Deleted（已删除）",
                "enum": [
                  "Creating",
                  "Running",
                  "Failed",
                  "Updating",
                  "Deleting",
                  "Deleted"
                ],
                "example": "Running",
                "type": "string"
              },
              "template": {
                "backendName": "template",
                "description_en": "The agent template configuration",
                "description_zh": "智能体模板配置",
                "properties": {
                  "aiRegistry": {
                    "backendName": "aiRegistry",
                    "description_en": "The AI Registry template configuration",
                    "description_zh": "AI Registry 模板配置",
                    "properties": {
                      "name": {
                        "backendName": "name",
                        "description_en": "The name of the template in AI Registry",
                        "description_zh": "AI Registry 中模板的名称",
                        "example": "code-review-template",
                        "required": true,
                        "type": "string"
                      },
                      "version": {
                        "backendName": "version",
                        "description_en": "The version of the template in AI Registry",
                        "description_zh": "AI Registry 中模板的版本",
                        "example": "1.0.0",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "tools": {
                "backendName": "tools",
                "description_en": "The list of tool configurations",
                "description_zh": "工具配置列表",
                "items": {
                  "description_en": "The list of tool configurations",
                  "description_zh": "工具配置列表",
                  "properties": {
                    "name": {
                      "backendName": "name",
                      "description_en": "The tool name",
                      "description_zh": "工具名称",
                      "example": "code-reviewer",
                      "required": true,
                      "type": "string"
                    },
                    "type": {
                      "backendName": "type",
                      "description_en": "The tool type. Valid values:\nMCP: MCP tool",
                      "description_zh": "工具类型。枚举值：MCP（MCP 工具）",
                      "enum": [
                        "MCP"
                      ],
                      "example": "MCP",
                      "required": true,
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "updatedAt": {
                "backendName": "updatedAt",
                "description_en": "The update time in RFC 3339 format",
                "description_zh": "更新时间，RFC 3339 格式",
                "example": "2026-01-01T00:00:00Z",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_en": "The workspace ID",
                "description_zh": "工作空间 ID",
                "example": "ws-1",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code. The value 200 indicates success",
            "description_zh": "HTTP 状态码。成功时为 200",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_en": "The request processing result message",
            "description_zh": "请求处理结果消息",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "1a2b3c4d-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
