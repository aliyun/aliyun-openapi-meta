      "name": "agent_id",
      "options": [
        "--agent-id"
      ],
      "raw_name": "agentId",
      "required": true,
      "type": "string"
    },
    {
      "example": "01a1b56a-b00f-7aa3-bacf-cc9d04b0****",
      "help_en": "The sandboxId",
      "help_zh": "Sandbox ID。使用 ListSandboxes 返回的实例标识，且须属于指定智能体和服务接入点对应的运行范围",
      "location": "path",
      "name": "sandbox_id",
      "options": [
        "--sandbox-id"
      ],
      "raw_name": "sandboxId",
      "required": true,
      "type": "string"
    },
    {
      "example": "01a1be92-7fa4-76b2-a871-b376d6d0****",
      "help_en": "RebuildSandbox 返回的 operationId，必须与当前 Workspace、Agent 和 Sandbox 属于同一运行身份",
