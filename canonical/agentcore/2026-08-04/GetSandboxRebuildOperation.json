  "deprecated": false,
  "description_en": "查询 Sandbox 重建任务",
  "description_zh": "查询指定 Sandbox 重建任务的整体结果。始终使用 RebuildSandbox 返回的首次 operationId，无需分别跟踪重建任务和后续创建任务。只有 status 为 SUCCEEDED 才表示完成；UNKNOWN、状态缺失或查询异常不能按成功处理，也不要自动重新提交重建",
  "kebab_example": "",
  "method": "GET",
  "multi_version": false,
  "name": "GetSandboxRebuildOperation",
  "operation": {
    "action": "GetSandboxRebuildOperation",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/managed-agents/{agentId}/sandboxes/{sandboxId}/rebuild-operations/{operationId}"
  },
  "parameters": [
    {
      "example": "se-7f3a92c1",
