                    "type": "string"
                  }
                },
                "title_en": "可公开的失败信息",
                "title_zh": "可公开的失败信息",
                "type": "object"
              },
              "operationId": {
                "backendName": "operationId",
                "description_zh": "首次重建任务 ID。使用 RebuildSandbox 返回的 operationId，后续始终使用该 ID 查询整体结果，无需改用后续创建任务的 ID",
                "example": "01a1be92-7fa4-76b2-a871-b376d6d0****",
                "title_en": "首次重建任务 ID",
                "title_zh": "首次重建任务 ID",
                "type": "string"
              },
              "sandboxId": {
                "backendName": "sandboxId",
                "description_zh": "本次重建对应的逻辑 Sandbox ID。重建后逻辑 ID 保持不变",
                "example": "01a1b56a-b00f-7aa3-bacf-cc9d04b0****",
                "title_en": "Sandbox 标识",
                "title_zh": "Sandbox 标识",
                "type": "string"
              },
              "status": {
                "backendName": "status",
                "description_en": "PENDING 等待执行；RUNNING 执行中；SUCCEEDED 整体完成；FAILED 失败；CANCELED 已取消；SUPERSEDED 已被后续重建替代；UNKNOWN 无法确认。只有 SUCCEEDED 表示整体完成",
                "description_zh": "重建整体状态。PENDING：等待处理；RUNNING：执行中；SUCCEEDED：整体成功；FAILED：失败；CANCELED：已取消；SUPERSEDED：已被后续操作替代；UNKNOWN：无法确认。只有 SUCCEEDED 表示完成。UNKNOWN、状态缺失或查询异常不得按成功处理，也不得自动重新提交重建",
                "enum": [
                  "PENDING",
                  "RUNNING",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELED",
                  "SUPERSEDED",
                  "UNKNOWN"
                ],
                "enumValueTitles": {
                  "CANCELED": "已取消",
                  "FAILED": "失败",
                  "PENDING": "等待处理",
                  "RUNNING": "执行中",
                  "SUCCEEDED": "整体成功",
                  "SUPERSEDED": "已被后续操作替代",
                  "UNKNOWN": "无法确认"
                },
                "example": "RUNNING",
                "title_en": "重建整体状态",
                "title_zh": "重建整体状态",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_zh": "本次接口请求对应的 HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_zh": "本次接口请求的结果说明，不表示异步重建任务已完成",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID，用于定位本次接口调用",
            "example": "01A1BE93-46A7-1A2A-BD62-159FCDAA****",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "本次接口请求是否成功。为 true 不代表 Sandbox 重建已完成",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
