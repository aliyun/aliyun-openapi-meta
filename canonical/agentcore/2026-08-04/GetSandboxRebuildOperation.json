            "properties": {
              "error": {
                "backendName": "error",
                "description_en": "正常或无法确认时为空；失败、取消或被替代时返回可展示的错误信息，不透出下游内部资源和凭证",
                "description_zh": "可公开展示的任务错误。失败、取消或被后续操作替代时返回；其他状态下可为空",
                "properties": {
                  "code": {
                    "backendName": "code",
                    "description_zh": "任务错误码，用于区分重建失败、后续实例创建失败、取消或被替代等情况",
                    "example": "SandboxRebuild.Failed",
                    "type": "string"
                  },
                  "message": {
                    "backendName": "message",
                    "description_zh": "可公开展示的任务错误说明。请保留任务 ID 以便排查",
