{
  "camel_example": "",
  "cmd_full_name": "agentcore list-users",
  "cmd_name": "list-users",
  "deprecated": false,
  "description_en": "查询用户列表",
  "description_zh": "分页查询指定工作空间内的用户。通过 nameLike 按用户名称模糊过滤，通过 maxResults 指定单页最大记录数，通过 nextToken 获取下一页。未指定 maxResults 时服务端默认返回 10 条",
  "kebab_example": "aliyun agentcore list-users --workspace-id ws-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListUsers",
  "operation": {
    "action": "ListUsers",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/workspaces/{workspaceId}/users"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspaceId",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "user-01",
      "help_en": "The name",
      "help_zh": "按用户名称精确匹配的过滤条件",
      "location": "query",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "name",
      "required": false,
      "type": "string"
    },
    {
      "example": "user",
      "help_en": "The nameLike",
      "help_zh": "按用户名称模糊匹配的过滤条件，长度不超过 128 个字符",
      "location": "query",
      "name": "name_like",
      "options": [
        "--name-like"
      ],
      "raw_name": "nameLike",
      "required": false,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The maxResults",
      "help_zh": "单页返回的最大记录数，取值范围为 1~100。不指定该参数时默认返回 10 条",
      "location": "query",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "maxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "dXNlci1vZmZzZXQ6MTA",
      "help_en": "The nextToken",
      "help_zh": "查询下一页的游标。首次调用不指定该参数，后续调用指定上一次返回的 nextToken",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "nextToken",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/users",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "type": "string"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "items": {
            "backendName": "items",
            "description_zh": "用户列表",
            "items": {
              "properties": {
                "agentCoreUserId": {
                  "backendName": "userId",
                  "description_zh": "用户 ID",
                  "example": "usr-123456",
                  "type": "string"
                },
                "authMethod": {
                  "backendName": "authMethod",
                  "description_zh": "用户的认证方式。password 表示使用工作空间本地密码认证，dingtalk 和 feishu 表示由对应的外部身份提供商同步并认证",
                  "example": "password",
                  "type": "string"
                },
                "createdAt": {
                  "backendName": "createdAt",
                  "description_zh": "创建时间，采用 RFC 3339 格式的 UTC 时间",
                  "example": "2026-08-12T03:04:05Z",
                  "type": "string"
                },
                "displayName": {
                  "backendName": "displayName",
                  "description_zh": "用户显示名称，长度为 1~32 个字符",
                  "example": "张三",
                  "type": "string"
                },
                "email": {
                  "backendName": "email",
                  "description_zh": "用户邮箱地址，长度不超过 256 个字符",
                  "example": "user-01@example.com",
                  "sensitive": true,
                  "type": "string"
                },
                "name": {
                  "backendName": "name",
                  "description_zh": "用户名称。在工作空间内唯一，只能包含小写字母、数字和连字符，必须以小写字母或数字开头和结尾，长度为 1~32 个字符",
                  "example": "user-01",
                  "type": "string"
                },
                "note": {
                  "backendName": "note",
                  "description_zh": "用户备注，长度不超过 1024 个字符",
                  "example": "智能体运营组成员",
                  "type": "string"
                },
                "regionId": {
                  "backendName": "regionId",
                  "description_zh": "资源所在的地域 ID",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "status": {
                  "backendName": "status",
                  "description_zh": "用户状态。可选值：Creating、Active、Updating、Deleting、Failed、DeleteFailed",
                  "enum": [
                    "Creating",
                    "Active",
                    "Updating",
                    "Deleting",
                    "Failed",
                    "DeleteFailed"
                  ],
                  "example": "Active",
                  "type": "string"
                },
                "updatedAt": {
                  "backendName": "updatedAt",
                  "description_zh": "最近一次修改的时间，采用 RFC 3339 格式的 UTC 时间",
                  "example": "2026-08-12T03:04:05Z",
                  "type": "string"
                },
                "workspaceId": {
                  "backendName": "workspaceId",
                  "description_zh": "工作空间 ID",
                  "example": "ws-123456",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "maxResults": {
            "backendName": "maxResults",
            "description_zh": "本次查询生效的单页最大记录数",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_zh": "响应消息。请求失败时返回错误描述",
            "example": "success",
            "type": "string"
          },
          "nextToken": {
            "backendName": "nextToken",
            "description_zh": "下一页游标。没有下一页时为空",
            "example": "dXNlci1vZmZzZXQ6MTA",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "请求是否成功",
            "type": "boolean"
          },
          "totalCount": {
            "backendName": "totalCount",
            "description_zh": "符合查询条件的用户总数",
            "example": "42",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
