{
  "camel_example": "aliyun agentcore GET /workspaces/ws-2f5f9c5a8d0e4c3b/memorystores/customer-memory/events --region cn-hangzhou --sessionId 'session-001' --header \"Content-Type=application/json\" --version 2026-08-04 --force",
  "cmd_full_name": "agentcore list-events",
  "cmd_name": "list-events",
  "deprecated": false,
  "description_en": "Performs a paged query on the events of a specified session in chronological order from oldest to newest, including the parent session history referenced when a session branch is created. The sessionId parameter is required, and other scope dimensions must match those used during write operations. Write or delete operations during paging may affect the results of subsequent pages",
  "description_zh": "按事件发生时间从旧到新分页查询指定会话的事件，包括创建会话分支时引用的父会话历史。必须提供 sessionId，其余范围维度需与写入时一致。分页期间写入或删除事件可能影响后续页的结果",
  "kebab_example": "aliyun agentcore list-events --workspace-id ws-2f5f9c5a8d0e4c3b --memory-store-name customer-memory --session-id session-001 --region cn-hangzhou",
