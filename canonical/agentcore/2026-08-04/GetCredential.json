{
  "camel_example": "aliyun agentcore GET /workspaces/ws-123456/credentials/cred-123456 --region cn-hangzhou --header \"Content-Type=application/json\" --version 2026-08-04 --force",
  "cmd_full_name": "agentcore get-credential",
  "cmd_name": "get-credential",
  "deprecated": false,
  "description_en": "Queries the details of a specified credential and returns a list of agents bound to the credential. The credential content is returned in a masked format",
  "description_zh": "查询指定凭证的详细信息，并返回已绑定该凭证的智能体列表。凭证内容以脱敏形式返回",
  "kebab_example": "aliyun agentcore get-credential --workspace-id ws-123456 --credential-id cred-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetCredential",
  "operation": {
    "action": "GetCredential",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/credentials/{credentialId}"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspace ID",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "cred-123456",
      "help_en": "The credential ID",
      "help_zh": "凭证 ID",
      "location": "path",
      "name": "credential_id",
      "options": [
        "--credential-id"
      ],
      "raw_name": "credentialId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/credentials/[credentialId]",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_en": "The business status code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "type": "string"
          },
          "data": {
            "backendName": "data",
            "description_en": "The credential details",
            "description_zh": "凭证详情",
            "properties": {
              "boundAgents": {
                "backendName": "boundAgents",
                "description_en": "The list of agents bound to the credential",
                "description_zh": "已绑定该凭证的智能体列表",
                "items": {
                  "properties": {
                    "agentId": {
                      "backendName": "agentId",
                      "description_en": "The agent ID",
                      "description_zh": "智能体 ID",
                      "example": "agent-123456",
                      "type": "string"
                    },
                    "agentName": {
                      "backendName": "agentName",
                      "description_en": "The agent name",
                      "description_zh": "智能体名称",
                      "example": "agent-01",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "createdAt": {
                "backendName": "createdAt",
                "description_en": "The creation time in UTC format based on RFC 3339",
                "description_zh": "创建时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "credentialId": {
                "backendName": "credentialId",
                "description_en": "The credential ID",
                "description_zh": "凭证 ID",
                "example": "cred-123456",
                "type": "string"
              },
              "credentialMetadata": {
                "backendName": "credentialMetadata",
                "description_en": "The masked credential content. For the apiKey type, the masked key is returned. For the mcpHeader type, only the header name is returned, and the value is not returned",
                "description_zh": "凭证内容的脱敏结果。apiKey 类型返回密钥掩码；mcpHeader 类型仅返回 Header 名称，不返回值",
                "example": "{\"apiKey\":\"REDACTED_API_KEY\"}",
                "sensitive": true,
                "type": "string"
              },
              "credentialType": {
                "backendName": "credentialType",
                "description_en": "The credential type. Valid values: apiKey (API key) and mcpHeader (MCP request header)",
                "description_zh": "凭证类型，支持 apiKey（API 密钥）和 mcpHeader（MCP 请求头）",
                "example": "apiKey",
                "type": "string"
              },
              "description": {
                "backendName": "description",
                "description_en": "The credential description. It can be up to 256 characters in length",
                "description_zh": "凭证描述，长度不超过 256 个字符",
                "example": "线上环境调用模型服务使用的 API Key",
                "type": "string"
              },
              "name": {
                "backendName": "name",
                "description_en": "The credential name. It must be unique within the workspace, contain only letters, digits, periods, underscores, and hyphens, and be 3 to 99 characters in length. Runtime reserved names are not allowed",
                "description_zh": "凭证名称。在工作空间内唯一，只能包含字母、数字、点、下划线和连字符，长度为 3~99 个字符，且不能使用运行时保留名称",
                "example": "model-api-key",
                "type": "string"
              },
              "regionId": {
                "backendName": "regionId",
                "description_en": "The region ID of the resource",
                "description_zh": "资源所在的地域 ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "resourceRefs": {
                "backendName": "resourceRefs",
                "description_en": "The list of MCP services applicable to the credential",
                "description_zh": "凭证适用的 MCP 服务列表",
                "items": {
                  "properties": {
                    "resourceId": {
                      "backendName": "resourceId",
                      "description_en": "The ID of the applicable MCP service",
                      "description_zh": "适用的 MCP 服务 ID",
                      "example": "mcp-example",
                      "title_en": "资源 ID",
                      "title_zh": "资源 ID",
                      "type": "string"
                    },
                    "resourceName": {
                      "backendName": "resourceName",
                      "description_en": "The resource name. This field is empty if the resource has been deleted",
                      "description_zh": "资源名称，资源已删除时为空",
                      "example": "my-mcp-service",
                      "title_en": "资源名称",
                      "title_zh": "资源名称",
                      "type": "string"
                    },
                    "resourceType": {
                      "backendName": "resourceType",
                      "description_en": "The resource type. Currently, the value is mcpServer, which indicates an MCP service",
                      "description_zh": "资源类型，当前为 mcpServer，表示 MCP 服务",
                      "example": "mcpServer",
                      "title_en": "资源类型",
                      "title_zh": "资源类型",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "title_en": "凭证可应用的资源列表",
                "title_zh": "凭证可应用的资源列表",
                "type": "array"
              },
              "resourceScope": {
                "backendName": "resourceScope",
                "description_en": "The application scope of the credential. ALL indicates all scopes, and SPECIFIED indicates specific MCP services",
                "description_zh": "凭证适用范围。ALL 表示全部范围，SPECIFIED 表示指定的 MCP 服务",
                "enum": [
                  "ALL",
                  "SPECIFIED"
                ],
                "enumValueTitles": {
                  "ALL": "全部范围",
                  "SPECIFIED": "指定范围"
                },
                "example": "ALL",
                "title_en": "凭证资源应用范围",
                "title_zh": "凭证资源应用范围",
                "type": "string"
              },
              "updatedAt": {
                "backendName": "updatedAt",
                "description_en": "The last modification time in UTC format based on RFC 3339",
                "description_zh": "最近一次修改的时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_en": "The workspace ID",
                "description_zh": "工作空间 ID",
                "example": "ws-123456",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_en": "The response message. An error description is returned if the request fails",
            "description_zh": "响应消息。请求失败时返回错误描述",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_en": "Indicates whether the request is successful",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
