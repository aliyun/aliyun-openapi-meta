{
  "camel_example": "aliyun agentcore GET /workspaces/ws-123456/plugins/collaboration --region cn-hangzhou --header \"Content-Type=application/json\" --version 2026-08-04 --force",
  "cmd_full_name": "agentcore get-workspace-plugin",
  "cmd_name": "get-workspace-plugin",
  "deprecated": false,
  "description_en": "Queries the activation status and configuration of a specified component in a workspace. The collaboration value corresponds to the Collaboration component displayed in the console",
  "description_zh": "查询工作空间指定组件的开通状态和配置；collaboration 对应控制台展示的“协作组件”",
  "kebab_example": "aliyun agentcore get-workspace-plugin --workspace-id ws-123456 --plugin-name collaboration --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetWorkspacePlugin",
  "operation": {
    "action": "GetWorkspacePlugin",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/plugins/{pluginName}"
  },
  "parameters": [
    {
