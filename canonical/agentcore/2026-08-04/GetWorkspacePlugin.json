                        "description_zh": "AgentSpace 创建时间，采用 RFC 3339 格式的 UTC 时间",
                        "example": "2026-08-12T03:04:05Z",
                        "title_en": "创建时间",
                        "title_zh": "创建时间",
                        "type": "string"
                      },
                      "regionId": {
