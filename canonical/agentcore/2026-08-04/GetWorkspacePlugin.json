    {
      "enum": [
        "collaboration",
        "agentloop",
        "mcp_outbound"
      ],
      "example": "collaboration",
      "help_en": "The identifier of the workspace component. The value collaboration corresponds to the Collaboration component in the console. Other component identifiers retain their original values from the API parameter enumeration",
      "help_zh": "工作空间组件标识。collaboration 对应控制台的协作组件；其他组件标识保持 API 参数枚举中的原值",
      "location": "path",
      "name": "plugin_name",
      "options": [
        "--plugin-name"
      ],
      "raw_name": "pluginName",
      "required": true,
      "type": "string"
    }
