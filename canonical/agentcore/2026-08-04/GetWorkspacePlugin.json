{
  "camel_example": "",
  "cmd_full_name": "agentcore get-workspace-plugin",
  "cmd_name": "get-workspace-plugin",
  "deprecated": false,
  "description_en": "Queries the plug-in status of a specified workspace",
  "description_zh": "查询指定工作空间的插件状态",
  "kebab_example": "aliyun agentcore get-workspace-plugin --workspace-id ws-123456 --plugin-name collaboration --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetWorkspacePlugin",
  "operation": {
    "action": "GetWorkspacePlugin",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/plugins/{pluginName}"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspace ID",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "enum": [
        "collaboration",
        "agentloop"
      ],
      "example": "collaboration",
      "help_en": "The plug-in name. Valid values: collaboration, agentloop",
      "help_zh": "插件名称。可选值：collaboration、agentloop",
      "location": "path",
      "name": "plugin_name",
      "options": [
        "--plugin-name"
      ],
      "raw_name": "pluginName",
      "required": true,
      "type": "string"
    }
  ],
