                            "title_en": "交换机 ID 列表",
                            "title_zh": "交换机 ID 列表",
                            "type": "array"
                          },
                          "vpcId": {
                            "backendName": "vpcId",
                            "description_en": "The VPC ID used for plug-in deployment",
                            "description_zh": "插件部署使用的 VPC ID",
                            "example": "vpc-bp1example",
                            "title_en": "VPC ID",
                            "title_zh": "VPC ID",
                            "type": "string"
                          }
                        },
                        "title_en": "用户 VPC 配置",
                        "title_zh": "用户 VPC 配置",
                        "type": "object"
                      }
                    },
                    "title_en": "网络配置",
                    "title_zh": "网络配置",
                    "type": "object"
                  }
                },
                "title_en": "插件配置",
                "title_zh": "插件配置",
                "type": "object"
              },
              "enabled": {
                "backendName": "enabled",
                "description_en": "Indicates whether the plug-in is enabled. The value is true when the status is ENABLED",
