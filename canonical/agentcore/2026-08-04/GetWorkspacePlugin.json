                  "collaboration",
                  "agentloop"
                ],
                "example": "collaboration",
                "type": "string"
              },
              "status": {
                "backendName": "status",
                "description_en": "The plug-in status. Valid values: DISABLED, ENABLING, ENABLED, ENABLE_FAILED, DISABLING, DISABLE_FAILED",
                "description_zh": "插件状态。可选值：DISABLED、ENABLING、ENABLED、ENABLE_FAILED、DISABLING、DISABLE_FAILED",
                "enum": [
                  "DISABLED",
                  "ENABLING",
                  "ENABLED",
                  "ENABLE_FAILED",
                  "DISABLING",
                  "DISABLE_FAILED"
                ],
                "example": "ENABLED",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_en": "The workspace ID",
                "description_zh": "工作空间 ID",
                "example": "ws-123456",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_en": "The response message. An error description is returned if the request fails",
