                "example": "ADMIN",
                "help_en": "The role of the user in the team. Valid values: ADMIN, MEMBER. Each team must have exactly one ADMIN",
                "help_zh": "用户在团队中的角色。可选值：ADMIN、MEMBER。每个团队必须且只能有一个 ADMIN",
                "name": "team_role",
                "options": [
                  "--team-role"
                ],
                "raw_name": "teamRole",
