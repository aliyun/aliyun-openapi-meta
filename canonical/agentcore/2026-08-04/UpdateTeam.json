  "cmd_full_name": "agentcore update-team",
  "cmd_name": "update-team",
  "deprecated": false,
  "description_en": "Updates the description and members of a specified team. When users or agents are passed in, the corresponding member list is replaced using full overwrite semantics. Member lists that are not passed in remain unchanged. The team name cannot be modified after creation",
  "description_zh": "更新指定团队的描述和成员。传入 users 或 agents 时按全量覆盖语义替换对应的成员列表，未传入的成员列表保持不变。团队名称创建后不可修改",
  "kebab_example": "aliyun agentcore update-team --workspace-id ws-123456 --team-id tm-123456 --region cn-hangzhou",
  "method": "PUT",
  "multi_version": false,
  "name": "UpdateTeam",
  "operation": {
    "action": "UpdateTeam",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "content_type": "application/x-www-form-urlencoded",
    "method": "PUT",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "system_operation_type": "update",
    "url": "/workspaces/{workspaceId}/teams/{teamId}"
  },
