{
  "camel_example": "aliyun agentcore GET /workspaces/ws-123456/teams --region cn-hangzhou --header \"Content-Type=application/json\" --version 2026-08-04 --force",
  "cmd_full_name": "agentcore list-teams",
  "cmd_name": "list-teams",
  "deprecated": false,
  "description_en": "Queries teams in a specified workspace by paging. Use nameLike to filter by team name with fuzzy match, maxResults to specify the maximum number of records per page, and nextToken to retrieve the next page. If maxResults is not specified, the server returns 10 records by default. Member information in the list includes only the member identity, name, and team role",
  "description_zh": "分页查询指定工作空间内的团队。通过 nameLike 按团队名称模糊过滤，通过 maxResults 指定单页最大记录数，通过 nextToken 获取下一页。未指定 maxResults 时服务端默认返回 10 条。列表中的成员信息只包含成员标识、名称和团队角色",
  "kebab_example": "aliyun agentcore list-teams --workspace-id ws-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListTeams",
  "operation": {
    "action": "ListTeams",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/workspaces/{workspaceId}/teams"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspace ID",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "team",
      "help_en": "The filter condition for fuzzy match by team name",
      "help_zh": "按团队名称模糊匹配的过滤条件",
      "location": "query",
      "name": "name_like",
      "options": [
        "--name-like"
      ],
      "raw_name": "nameLike",
      "required": false,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The maximum number of records to return per page. Valid values: 1 to 100. Default value: 10",
      "help_zh": "单页返回的最大记录数，取值范围为 1~100。不指定该参数时默认返回 10 条",
      "location": "query",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "maxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "dGVhbS1vZmZzZXQ6MTA",
