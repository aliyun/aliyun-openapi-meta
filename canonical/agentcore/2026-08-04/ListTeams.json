      "help_zh": "查询下一页的游标。首次调用不指定该参数，后续调用指定上一次返回的 nextToken",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "nextToken",
      "required": false,
      "type": "string"
    }
  ],
