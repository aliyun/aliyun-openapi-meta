    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": "/workspaces/{workspaceId}/managed-agents/{agentId}/sandboxes/{sandboxId}/rebuild"
  },
  "parameters": [
