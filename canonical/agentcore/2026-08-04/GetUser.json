{
  "camel_example": "aliyun agentcore GET /workspaces/ws-123456/users/usr-123456 --region cn-hangzhou --header \"Content-Type=application/json\" --version 2026-08-04 --force",
  "cmd_full_name": "agentcore get-user",
  "cmd_name": "get-user",
  "deprecated": false,
  "description_en": "Queries the details of a specified user in a workspace. Returns an error if the user does not exist",
  "description_zh": "查询指定工作空间内某个用户的详细信息。用户不存在时返回错误",
  "kebab_example": "aliyun agentcore get-user --workspace-id ws-123456 --agent-core-user-id usr-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetUser",
  "operation": {
    "action": "GetUser",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/users/{agentCoreUserId}"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspace ID",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "usr-123456",
      "help_en": "The user ID",
      "help_zh": "用户 ID",
      "location": "path",
      "name": "agent_core_user_id",
      "options": [
        "--agent-core-user-id"
      ],
      "raw_name": "agentCoreUserId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/users/[agentCoreUserId]",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_en": "The business status code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "type": "string"
          },
          "data": {
            "backendName": "data",
            "description_en": "The user details",
            "description_zh": "用户详情",
            "properties": {
              "agentCoreUserId": {
                "backendName": "userId",
                "description_en": "The user ID",
                "description_zh": "用户 ID",
                "example": "usr-123456",
                "type": "string"
              },
              "authMethod": {
                "backendName": "authMethod",
                "description_en": "The authentication method of the user. password indicates local password authentication in the workspace. dingtalk and feishu indicate that the user is synchronized and authenticated by the corresponding external identity provider",
                "description_zh": "用户的认证方式。password 表示使用工作空间本地密码认证，dingtalk 和 feishu 表示由对应的外部身份提供商同步并认证",
                "example": "password",
                "type": "string"
              },
              "createdAt": {
                "backendName": "createdAt",
                "description_en": "The creation time in UTC, formatted in RFC 3339",
                "description_zh": "创建时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "displayName": {
                "backendName": "displayName",
                "description_en": "The display name of the user. The display name must be 1 to 32 characters in length",
                "description_zh": "用户显示名称，长度为 1~32 个字符",
                "example": "张三",
                "type": "string"
              },
              "email": {
                "backendName": "email",
                "description_en": "The email address of the user. The email address can be up to 256 characters in length",
                "description_zh": "用户邮箱地址，长度不超过 256 个字符",
                "example": "user-01@example.com",
                "sensitive": true,
                "type": "string"
              },
              "name": {
                "backendName": "name",
                "description_en": "The username. The username must be unique within the workspace and can contain only lowercase letters, digits, and hyphens (-). It must start and end with a lowercase letter or digit. The username must be 1 to 32 characters in length",
                "description_zh": "用户名称。在工作空间内唯一，只能包含小写字母、数字和连字符，必须以小写字母或数字开头和结尾，长度为 1~32 个字符",
                "example": "user-01",
                "type": "string"
              },
              "note": {
                "backendName": "note",
                "description_en": "The remarks of the user. The remarks can be up to 1024 characters in length",
                "description_zh": "用户备注，长度不超过 1024 个字符",
                "example": "智能体运营组成员",
                "type": "string"
              },
              "regionId": {
                "backendName": "regionId",
                "description_en": "The region ID of the resource",
                "description_zh": "资源所在的地域 ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "status": {
                "backendName": "status",
                "description_en": "The user status. Valid values: Creating, Active, Updating, Deleting, Failed, DeleteFailed",
                "description_zh": "用户状态。可选值：Creating、Active、Updating、Deleting、Failed、DeleteFailed",
                "enum": [
                  "Creating",
                  "Active",
                  "Updating",
                  "Deleting",
                  "Failed",
                  "DeleteFailed"
                ],
                "example": "Active",
                "type": "string"
              },
              "updatedAt": {
                "backendName": "updatedAt",
                "description_en": "The last modification time in UTC, formatted in RFC 3339",
                "description_zh": "最近一次修改的时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_en": "The workspace ID",
                "description_zh": "工作空间 ID",
                "example": "ws-123456",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_en": "The response message. An error description is returned if the request fails",
            "description_zh": "响应消息。请求失败时返回错误描述",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
