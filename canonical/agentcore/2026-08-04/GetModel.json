      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "model-1",
      "help_en": "The model ID",
      "help_zh": "模型 ID",
      "location": "path",
      "name": "model_id",
      "options": [
        "--model-id"
      ],
      "raw_name": "modelId",
      "required": true,
      "type": "string"
    }
  ],
