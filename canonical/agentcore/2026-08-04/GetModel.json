                "description_zh": "模型单次生成支持的最大输出 Token 数",
                "example": "131072",
                "format": "int64",
                "title_en": "模型单次生成支持的最大输出 Token 数",
                "title_zh": "模型单次生成支持的最大输出 Token 数",
                "type": "integer"
              },
              "modelId": {
                "backendName": "modelId",
                "description_en": "The model ID",
                "description_zh": "模型 ID",
                "example": "model-1",
                "type": "string"
              },
              "modelName": {
                "backendName": "modelName",
                "description_en": "The upstream model name",
