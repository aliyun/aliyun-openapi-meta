                "type": "string"
              },
              "updatedAt": {
                "backendName": "updatedAt",
                "description_en": "The time when the resource was last updated, in RFC 3339 UTC format",
                "description_zh": "资源最后更新时间，采用 RFC 3339 UTC 格式",
                "example": "2026-08-09T00:00:00Z",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_en": "The workspace ID",
                "description_zh": "工作空间 ID",
                "example": "ws-1",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code. A value of 200 indicates success",
            "description_zh": "HTTP 状态码。成功时为 200",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_en": "The request processing result message",
            "description_zh": "请求处理结果消息",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "request-1",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
