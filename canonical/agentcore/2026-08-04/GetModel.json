  "kebab_example": "aliyun agentcore get-model --workspace-id ws-1 --model-id model-1 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetModel",
  "operation": {
    "action": "GetModel",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/models/{modelId}"
  },
  "parameters": [
    {
      "example": "ws-1",
      "help_en": "The workspace ID",
