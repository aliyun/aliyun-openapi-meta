{
  "camel_example": "",
  "cmd_full_name": "agentcore list-predefined-models",
  "cmd_name": "list-predefined-models",
  "deprecated": false,
  "description_en": "Queries the models and their capability information for a specified provider in the AgentCore built-in model catalog",
  "description_zh": "查询指定供应商在 AgentCore 内置模型目录中的模型及其能力信息",
  "kebab_example": "aliyun agentcore list-predefined-models --provider-type qwen --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListPredefinedModels",
  "operation": {
    "action": "ListPredefinedModels",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/model-catalog/providers/{providerType}/models"
  },
  "parameters": [
    {
      "example": "qwen",
      "help_en": "The model provider type",
      "help_zh": "模型供应商类型",
      "location": "path",
      "name": "provider_type",
      "options": [
        "--provider-type"
      ],
      "raw_name": "providerType",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/model-catalog/providers/[providerType]/models",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The model text response returned when model debugging succeeds. This field is empty when debugging fails",
        "description_zh": "模型调试成功时返回的模型文本响应；调试失败时为空",
        "properties": {
          "code": {
            "backendName": "code",
            "description_en": "The business status code. The value SUCCESS indicates success",
            "description_zh": "业务状态码。成功时为 SUCCESS",
            "example": "SUCCESS",
            "type": "string"
          },
          "data": {
            "backendName": "data",
            "description_en": "The list of predefined models",
            "description_zh": "预定义模型列表",
            "items": {
              "description_en": "The business value of this field",
              "description_zh": "该字段的业务值",
              "properties": {
                "capabilities": {
                  "backendName": "capabilities",
                  "description_en": "The model capability configuration",
                  "description_zh": "模型能力配置",
                  "properties": {
                    "audio": {
                      "backendName": "audio",
                      "description_en": "Indicates whether the model supports audio input or output",
                      "description_zh": "模型是否支持音频输入或输出",
                      "type": "boolean"
                    },
                    "document": {
                      "backendName": "document",
                      "description_en": "Indicates whether the model supports document input",
                      "description_zh": "模型是否支持文档输入",
                      "type": "boolean"
                    },
                    "multiToolCall": {
                      "backendName": "multiToolCall",
                      "description_en": "Indicates whether the model is able to invoke multiple tool calling requests in a single response",
                      "description_zh": "模型是否支持在一次响应中发起多个工具调用",
                      "type": "boolean"
                    },
                    "reasoning": {
                      "backendName": "reasoning",
                      "description_en": "Indicates whether the model supports reasoning capabilities",
                      "description_zh": "模型是否支持推理能力",
                      "type": "boolean"
                    },
                    "streamToolCall": {
                      "backendName": "streamToolCall",
                      "description_en": "Indicates whether the model supports streaming tool calling",
                      "description_zh": "模型是否支持流式工具调用",
                      "type": "boolean"
                    },
                    "toolCall": {
                      "backendName": "toolCall",
                      "description_en": "Indicates whether the model supports tool calling",
                      "description_zh": "模型是否支持工具调用",
                      "type": "boolean"
                    },
                    "video": {
                      "backendName": "video",
                      "description_en": "Indicates whether the model supports video input",
                      "description_zh": "模型是否支持视频输入",
                      "type": "boolean"
                    },
                    "vision": {
                      "backendName": "vision",
                      "description_en": "Indicates whether the model supports image input",
                      "description_zh": "模型是否支持图像输入",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "contextSize": {
                  "backendName": "contextSize",
                  "description_en": "The model context window size in tokens. The value must be a positive integer",
                  "description_zh": "模型上下文窗口大小，单位为 Token，必须为正整数",
                  "example": "128000",
                  "format": "int64",
                  "type": "integer"
                },
                "maxTokens": {
                  "backendName": "maxTokens",
                  "description_en": "The maximum number of output tokens supported by the model in a single generation",
                  "description_zh": "模型单次生成支持的最大输出 Token 数",
                  "example": "131072",
                  "format": "int64",
                  "title_en": "模型单次生成支持的最大输出 Token 数",
                  "title_zh": "模型单次生成支持的最大输出 Token 数",
                  "type": "integer"
                },
                "modelName": {
                  "backendName": "modelName",
                  "description_en": "The upstream model name",
                  "description_zh": "上游模型名称",
                  "example": "qwen-max",
                  "type": "string"
                },
                "releaseDate": {
                  "backendName": "releaseDate",
                  "description_en": "The model release date in the format of YYYY-MM-DD",
                  "description_zh": "模型发布日期，格式为 YYYY-MM-DD",
                  "example": "2025-02-01",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_en": "The HTTP status code. The value 200 indicates success",
            "description_zh": "HTTP 状态码。成功时为 200",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_en": "The request processing result message",
            "description_zh": "请求处理结果消息",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "request-1",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
