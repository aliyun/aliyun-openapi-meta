{
  "name": "GetIngestProcessor",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/ingestprocessors/[processorName]",
  "parameters": [
    {
      "name": "processorName",
      "description": "The identity of the ingest processor.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-ingest-processor --project ali-test-project --processor-name parse-nginx-log --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /ingestprocessors/parse-nginx-log --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
