{
  "name": "GetAsyncSql",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/asyncsql/[queryId]",
  "parameters": [
    {
      "name": "line",
      "description": "The number of results to return per page. The maximum value is 1000.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "offset",
      "description": "The offset for paginated results.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": false
    },
    {
      "name": "queryId",
      "description": "The ID of the asynchronous SQL query. This ID is fixed throughout the SQL lifecycle.",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-async-sql --project sls-demo-project --query-id 690C4F2A16FBD65C40000484_14 --offset 0 --line 100 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /asyncsql/690C4F2A16FBD65C40000484_14 --project sls-demo-project --region cn-hangzhou --offset 0 --line 100 --header \"Content-Type=application/json\""
  }
}
