{
  "name": "DeleteDomain",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/domains/[domainName]",
  "parameters": [
    {
      "name": "domainName",
      "description": "The domain name to be deleted.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls delete-domain --project ali-test-project --domain-name example.com --region cn-hangzhou",
    "legacyCli": "aliyun sls DELETE /domains/example.com --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
