{
  "name": "GetETL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/etls/[etlName]",
  "parameters": [
    {
      "name": "etlName",
      "description": "The name of the ETL job.",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-etl --project ali-test-project --etl-name etl-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /etls/etl-123456 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
