{
  "name": "UpdateStoreView",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/storeviews/[name]",
  "parameters": [
    {
      "name": "body",
      "description": "The configurations of the dataset.",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "name",
      "description": "The name of the dataset.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-store-view --project example-project --name my_storeview --store-type logstore --stores example-string --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /storeviews/my_storeview --project example-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"storeType\":\"logstore\",\"stores\":[\"example-string\"]}"
  }
}
