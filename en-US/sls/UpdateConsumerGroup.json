{
  "name": "UpdateConsumerGroup",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/logstores/[logstore]/consumergroups/[consumerGroup]",
  "parameters": [
    {
      "name": "body",
      "description": "The request body. At least one of order and timeout has a value.",
      "position": "Body",
      "type": "String",
      "required": true
    },
    {
      "name": "consumerGroup",
      "description": "The name of the consumer group.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "logstore",
      "description": "The name of the Logstore.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls update-consumer-group --project ali-test-project --logstore logstore-test --consumer-group consumer-group-1 --order true --timeout 300 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /logstores/logstore-test/consumergroups/consumer-group-1 --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\" --body {\"timeout\":300,\"order\":true}"
  }
}
