      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls delete-config --project ali-test-project --config-name logtail-config-sample --region cn-hangzhou",
    "legacyCli": "aliyun sls DELETE /configs/logtail-config-sample --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
