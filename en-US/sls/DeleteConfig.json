{
  "name": "DeleteConfig",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "DELETE",
  "pathPattern": "/configs/[configName]",
  "parameters": [
    {
      "name": "configName",
      "description": "The name of the Logtail configuration.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
