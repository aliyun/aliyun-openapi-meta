{
  "name": "StartMaxComputeExport",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/maxcomputeexports/[mcExportName]?action=START",
  "parameters": [
    {
      "name": "mcExportName",
      "description": "The unique name of the job. Make sure that the job exists.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls start-max-compute-export --project my-project --mc-export-name export-mc-1234567890-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /maxcomputeexports/export-mc-1234567890-123456?action=START --project my-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
