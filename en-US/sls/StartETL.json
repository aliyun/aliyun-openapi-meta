{
  "name": "StartETL",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/etls/[etlName]?action=START",
  "parameters": [
    {
      "name": "etlName",
      "description": "The name of the data transformation task.",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls start-etl --project ali-test-project --etl-name etl-123456 --region cn-hangzhou",
    "legacyCli": "aliyun sls PUT /etls/etl-123456?action=START --project ali-test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
