{
  "name": "GetLogtailPipelineConfig",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/pipelineconfigs/[configName]",
  "parameters": [
    {
      "name": "configName",
      "description": "The name of the Logtail pipeline configuration.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "project",
      "description": "The name of the project.",
      "position": "Host",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun sls get-logtail-pipeline-config --project test-project --config-name test-config --region cn-hangzhou",
    "legacyCli": "aliyun sls GET /pipelineconfigs/test-config --project test-project --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
