{
  "name": "GetContainerConfiguration",
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/pop/v5/app/container_config",
  "parameters": [
    {
      "name": "AppId",
      "description": "The ID of the application.",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "GroupId",
      "description": "The ID of the instance group.\n\n*   If this parameter is specified, this operation queries the Tomcat configuration of the instance group.\n*   If this parameter is not specified, this operation queries the Tomcat configuration of the application.",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun edas get-container-configuration --app-id 3616cdca-4f92-00000000000000 --group-id 8123db90-880f-00000000000000 --region cn-hangzhou",
    "legacyCli": "aliyun edas GET /pop/v5/app/container_config --region cn-hangzhou --AppId '3616cdca-4f92-00000000000000' --GroupId '8123db90-880f-00000000000000' --header \"Content-Type=application/json\""
  }
}
