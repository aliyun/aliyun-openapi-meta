  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/aliases/[aliasName]",
  "parameters": [
    {
      "name": "aliasName",
      "description": "The function alias.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "functionName",
      "description": "The function name.",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc get-alias --function-name my-func --alias-name my-alias --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/my-func/aliases/my-alias --region cn-hangzhou --header \"Content-Type=application/json\""
  }
}
