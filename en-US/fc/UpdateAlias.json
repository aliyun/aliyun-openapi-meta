{
  "name": "UpdateAlias",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/functions/[functionName]/aliases/[aliasName]",
  "parameters": [
    {
      "name": "aliasName",
      "description": "The function alias name.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "The alias information to be updated.",
      "position": "Body",
      "type": "Json",
      "required": true
    },
    {
      "name": "functionName",
      "description": "The function name.",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc update-alias --function-name my-func --alias-name my-alias --region cn-hangzhou",
    "legacyCli": "aliyun fc PUT /2023-03-30/functions/my-func/aliases/my-alias --region cn-hangzhou --header \"Content-Type=application/json\" --body \"example-string\""
  }
}
