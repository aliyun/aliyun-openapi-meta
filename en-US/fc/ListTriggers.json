{
  "name": "ListTriggers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/functions/[functionName]/triggers",
  "parameters": [
    {
      "name": "functionName",
      "description": "The function name.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "limit",
      "description": "The number of triggers returned.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "description": "The token for the next page.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "prefix",
      "description": "The trigger name prefix.",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ],
  "example": {
    "unifiedCli": "aliyun fc list-triggers --function-name my-func --prefix my-trigger --next-token MTIzNCNhYmM= --limit 10 --region cn-hangzhou",
    "legacyCli": "aliyun fc GET /2023-03-30/functions/my-func/triggers --region cn-hangzhou --prefix 'my-trigger' --nextToken 'MTIzNCNhYmM=' --limit 10 --header \"Content-Type=application/json\""
  }
}
