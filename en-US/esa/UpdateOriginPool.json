{
  "name": "UpdateOriginPool",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "Enabled",
      "description": "Whether the origin pool is enabled:\n\n- true: Enabled;\n- false: Disabled.",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "Id",
      "description": "The ID of the origin pool, which can be obtained by calling the [ListOriginPools](~~2863947~~) interface.",
      "position": "Query",
      "type": "Long",
      "required": true
    },
    {
      "name": "Origins",
      "description": "Information about the origins added to the origin pool. Multiple origins are passed as an array.",
      "position": "Query",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "Address",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "AuthConf",
          "position": "Query",
          "type": "Struct",
          "required": false
        },
        {
          "name": "Enabled",
          "position": "Query",
          "type": "Boolean",
          "required": false
        },
        {
          "name": "Header",
          "position": "Query",
          "type": "Any",
          "required": false
        },
        {
          "name": "IpVersionPolicy",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Name",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Type",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Weight",
          "position": "Query",
          "type": "Integer",
          "required": false
        }
      ]
    },
    {
      "name": "SiteId",
      "description": "The site ID, which can be obtained by calling the [ListSites](~~ListSites~~) interface.",
      "position": "Query",
      "type": "Long",
      "required": true
    }
  ],
  "example": {
    "unifiedCli": "aliyun esa update-origin-pool --id 1038520525196928 --enabled true --origins '[{\"Type\":\"OSS\",\"Address\":\"www.example.com\",\"Header\":\"Host_:_example.com\",\"Enabled\":true,\"AuthConf\":{\"SecretKey\":\"yourAccessKeySecret\",\"Version\":\"v2\",\"Region\":\"us-east-1\",\"AuthType\":\"public\",\"AccessKey\":\"yourAccessKeyID\"},\"Weight\":50,\"IpVersionPolicy\":\"round_robin\",\"Name\":\"origin1\"}]' --site-id 216558609793952 --region cn-hangzhou",
    "legacyCli": "aliyun esa UpdateOriginPool --region cn-hangzhou --Origins '[{\"Type\":\"OSS\",\"Address\":\"www.example.com\",\"Header\":\"Host_:_example.com\",\"Enabled\":true,\"AuthConf\":{\"SecretKey\":\"yourAccessKeySecret\",\"Version\":\"v2\",\"Region\":\"us-east-1\",\"AuthType\":\"public\",\"AccessKey\":\"yourAccessKeyID\"},\"Weight\":50,\"IpVersionPolicy\":\"round_robin\",\"Name\":\"origin1\"}]' --SiteId 216558609793952 --Enabled true --Id 1038520525196928"
  }
